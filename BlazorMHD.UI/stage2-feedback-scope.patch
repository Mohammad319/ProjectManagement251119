+@using System.Globalization
+@using BlazorMHD.UI.Core.DesignSystem
+@using BlazorMHD.UI.Core.Services
+@using Microsoft.AspNetCore.Components.Web
+@inject DialogService DialogService
+@inject IDesignSystemService Design
+@implements IDisposable
+
+@if (_dialogs.Count > 0)
+{
+    @for (var i = 0; i < _dialogs.Count; i++)
+    {
+        var model = _dialogs[i];
+        var z = 1000 + i;
+
+        <div class="mhd-dialog-overlay dialog-overlay-animate-in"
+             style="@GetOverlayStyle(model, z)"
+             @onmousedown="(e => OnOverlayMouseDown(e, model))"
+             @onmousemove="OnMouseMove"
+             @onmouseup="OnMouseUp"
+             @onmouseleave="OnMouseUp">
+
+            <div class="mhd-dialog-stage">
+                <div class="@GetDialogClass(model) dialog-animate-in @GetThemeClass()"
+                     role="dialog"
+                     aria-modal="true"
+                     aria-labelledby="@GetTitleId(model)"
+                     aria-describedby="@GetDescriptionId(model)"
+                     tabindex="0"
+                     style="@($"transform: translate({model.OffsetX}px, {model.OffsetY}px);")"
+                     @onclick:stopPropagation="true"
+                     @onmousedown:stopPropagation="true"
+                     @onkeydown="(e => OnDialogKeyDown(e, model))">
+
+                    <div class="@GetHeaderClass(model)"
+                         @onmousedown="(e => OnHeaderMouseDown(model, e))"
+                         title="Drag dialog">
+                        <div class="mhd-dialog-heading">
+                            @if (!string.IsNullOrWhiteSpace(model.Icon))
+                            {
+                                <span class="mhd-dialog-icon" aria-hidden="true">@((MarkupString)model.Icon!)</span>
+                            }
+
+                            <div class="mhd-dialog-heading-text">
+                                <h3 id="@GetTitleId(model)" class="mhd-dialog-title">
+                                    @model.Title
+                                </h3>
+
+                                @if (!string.IsNullOrWhiteSpace(model.Description))
+                                {
+                                    <p id="@GetDescriptionId(model)" class="mhd-dialog-description">
+                                        @model.Description
+                                    </p>
+                                }
+                            </div>
+                        </div>
+
+                        <button type="button"
+                                class="mhd-dialog-close"
+                                aria-label="Close"
+                                @onclick="() => DialogService.CloseAsync(model)">
+                            ✕
+                        </button>
+                    </div>
+
+                    <div class="mhd-dialog-body-host">
+                        @if (model.Content is not null)
+                        {
+                            @model.Content
+                        }
+                    </div>
+
+                    @if (model.Buttons?.Any() == true)
+                    {
+                        <div class="mhd-scope mhd-dialog-footer">
+                            @foreach (var btn in model.Buttons)
+                            {
+                                if (string.Equals(btn.Type, "submit", StringComparison.OrdinalIgnoreCase))
+                                {
+                                    <button type="submit"
+                                            form="@btn.FormId"
+                                            class="@Design.GetButtonClass(btn.State, btn.IsPrimary ? MhdVariant.Filled : MhdVariant.Outline, btn.Size)">
+                                        @btn.Text
+                                    </button>
+                                }
+                                else
+                                {
+                                    <button type="button"
+                                            class="@Design.GetButtonClass(btn.State, btn.IsPrimary ? MhdVariant.Filled : MhdVariant.Outline, btn.Size)"
+                                            @onclick="() => OnButtonClick(model, btn)">
+                                        @btn.Text
+                                    </button>
+                                }
+                            }
+                        </div>
+                    }
+                </div>
+            </div>
+        </div>
+    }
+}
+
+@code {
+    [CascadingParameter(Name = "MhdTheme")]
+    public string? ThemeMode { get; set; }
+
+    private IReadOnlyList<DialogModel> _dialogs = Array.Empty<DialogModel>();
+
+    private bool _isDragging;
+    private DialogModel? _dragDialog;
+    private double _startMouseX;
+    private double _startMouseY;
+    private double _startOffsetX;
+    private double _startOffsetY;
+
+    protected override void OnInitialized()
+    {
+        DialogService.OnChange += OnDialogChanged;
+        _dialogs = DialogService.Dialogs;
+    }
+
+    private void OnDialogChanged()
+    {
+        _dialogs = DialogService.Dialogs;
+        _ = InvokeAsync(StateHasChanged);
+    }
+
+    private async Task OnOverlayMouseDown(MouseEventArgs e, DialogModel model)
+    {
+        if (e.Button != 0)
+            return;
+
+        if (!model.CloseOnOverlayClick)
+            return;
+
+        if (_isDragging)
+            return;
+
+        await DialogService.CloseAsync(model);
+    }
+
+    private async Task OnButtonClick(DialogModel model, DialogButtonModel btn)
+    {
+        if (btn.OnClick.HasValue)
+            await btn.OnClick.Value.InvokeAsync();
+
+        if (btn.AutoClose)
+            await DialogService.CloseAsync(model);
+    }
+
+    private void OnHeaderMouseDown(DialogModel model, MouseEventArgs e)
+    {
+        if (!model.IsDraggable)
+            return;
+
+        if (e.Button != 0)
+            return;
+
+        _isDragging = true;
+        _dragDialog = model;
+        _startMouseX = e.ClientX;
+        _startMouseY = e.ClientY;
+        _startOffsetX = model.OffsetX;
+        _startOffsetY = model.OffsetY;
+    }
+
+    private void OnMouseMove(MouseEventArgs e)
+    {
+        if (!_isDragging || _dragDialog is null)
+            return;
+
+        var dx = e.ClientX - _startMouseX;
+        var dy = e.ClientY - _startMouseY;
+
+        _dragDialog.OffsetX = _startOffsetX + dx;
+        _dragDialog.OffsetY = _startOffsetY + dy;
+
+        StateHasChanged();
+    }
+
+    private void OnMouseUp(MouseEventArgs _)
+    {
+        _isDragging = false;
+        _dragDialog = null;
+    }
+
+    private async Task OnDialogKeyDown(KeyboardEventArgs e, DialogModel model)
+    {
+        if (e.Key == "Escape")
+        {
+            await DialogService.CloseAsync(model);
+        }
+    }
+
+    private string GetOverlayStyle(DialogModel model, int z)
+    {
+        if (!model.UseOverlay)
+            return $"z-index:{z}; background: transparent;";
+
+        var opacity = Math.Clamp(model.OverlayOpacity, 0d, 1d);
+        return $"z-index:{z}; background-color: rgba(0, 0, 0, {opacity.ToString(CultureInfo.InvariantCulture)});";
+    }
+
+    private string GetDialogClass(DialogModel model)
+    {
+        var size = model.Size switch
+        {
+            DialogSize.Small => "mhd-dialog-size-sm",
+            DialogSize.Medium => "mhd-dialog-size-md",
+            DialogSize.Large => "mhd-dialog-size-lg",
+            DialogSize.ExtraLarge => "mhd-dialog-size-xl",
+            DialogSize.FullScreen => "mhd-dialog-size-full",
+            _ => "mhd-dialog-size-md"
+        };
+
+        return $"mhd-dialog-panel {size}";
+    }
+
+    private string GetThemeClass()
+        => string.Equals(ThemeMode, "dark", StringComparison.OrdinalIgnoreCase)
+            ? "mhd-dialog-theme-dark"
+            : "mhd-dialog-theme-light";
+
+    private static string GetHeaderClass(DialogModel model)
+        => model.IsDraggable ? "mhd-dialog-header" : "mhd-dialog-header mhd-dialog-header-static";
+
+    private static string GetTitleId(DialogModel model)
+        => $"mhd-dialog-title-{model.Id}";
+
+    private static string GetDescriptionId(DialogModel model)
+        => $"mhd-dialog-desc-{model.Id}";
+
+    public void Dispose()
+    {
+        DialogService.OnChange -= OnDialogChanged;
+    }
+}
