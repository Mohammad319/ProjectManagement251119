@using BlazorMHD.UI.Core.Services
@using BlazorMHD.UI.Shared
@inject LoadingService Loading

@if (Loading.IsBusy)
{
    <div class="fixed inset-0 bg-black/25 flex items-center justify-center"
         style="z-index:9999;">
        <div class="px-3 py-2 rounded-md bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100 border border-slate-200 dark:border-slate-700 shadow-sm text-xs flex items-center gap-2">
            <MhdLoading />
            <span>@Localiztion.Status_Processing ...</span>
        </div>
    </div>


@*     <div class="fixed inset-0 flex items-center justify-center bg-black/40 backdrop-blur-sm transition-opacity duration-200"
         style="z-index:9999;">
        <div class="px-4 py-3 rounded-lg bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100 border border-slate-200 dark:border-slate-700 shadow-lg text-xs flex items-center gap-3">
            <MhdLoading />
            <span class="font-medium tracking-wide">Processing...</span>
        </div>
    </div> *@
}

@code {
    protected override void OnInitialized()
    {
        Loading.OnChange += OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Loading.OnChange -= OnChanged;
    }
}
