@using BlazorMHD.UI.Core.Services
@using BlazorMHD.UI.Shared
@inject LoadingService Loading
@implements IDisposable

@if (Loading.IsBusy)
{
    <div class="mhd-scope mhd-loading-overlay"
         style="z-index:9999;"
         role="status"
         aria-live="polite"
         aria-busy="true">
        <div class="mhd-loading-overlay-surface">
            <MhdLoading />
            <span>@Localiztion.Status_Processing ...</span>
        </div>
    </div>
}

@code {
    protected override void OnInitialized() => Loading.OnChange += OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Loading.OnChange -= OnChanged;
}
