<div class="@GetSkeletonClass()"></div>

@code {
    [Parameter] public string Width { get; set; } = "w-full";
    [Parameter] public string Height { get; set; } = "h-3";
    [Parameter] public bool Rounded { get; set; } = true;
    [Parameter] public string? Class { get; set; }

    private string GetSkeletonClass()
    {
        var cls = new List<string>
        {
            "mhd-skeleton-base",
            Rounded ? "mhd-skeleton-rounded" : "mhd-skeleton-square",
            Width,
            Height
        };

        if (!string.IsNullOrWhiteSpace(Class))
            cls.Add(Class);

        return string.Join(" ", cls);
    }
}
