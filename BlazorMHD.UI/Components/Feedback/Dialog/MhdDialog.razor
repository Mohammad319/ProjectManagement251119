@using BlazorMHD.UI.Core.DesignSystem
@using BlazorMHD.UI.Core.Services
@using Microsoft.AspNetCore.Components.Web
@inject DialogService DialogService
@inject IDesignSystemService Design
@implements IDisposable

@if (_dialogs.Count > 0)
{
    @for (var i = 0; i < _dialogs.Count; i++)
    {
        var model = _dialogs[i];
        var z = 1000 + i;

        <div class="fixed inset-0 z-50 bg-black/45 backdrop-blur-sm dialog-overlay-animate-in overflow-hidden overscroll-none p-3 sm:p-6"
             style="z-index:@z;"
             @onclick="() => OnOverlayClick(model)"
             @onmousemove="OnMouseMove"
             @onmouseup="OnMouseUp"
             @onmouseleave="OnMouseUp">

            <div class="h-full w-full flex items-center justify-center">
                <div class="@GetDialogClass(model) dialog-animate-in"
                     role="dialog"
                     aria-modal="true"
                     aria-labelledby="@GetTitleId(model)"
                     aria-describedby="@GetDescriptionId(model)"
                     tabindex="0"
                     style="@($"transform: translate({model.OffsetX}px, {model.OffsetY}px);")"
                     @onclick:stopPropagation="true"
                     @onkeydown="(e => OnDialogKeyDown(e, model))">

                    <div class="@GetHeaderClass(model)"
                         @onmousedown="(e => OnHeaderMouseDown(model, e))">
                        <div class="flex items-start gap-2 min-w-0">
                            @if (!string.IsNullOrWhiteSpace(model.Icon))
                            {
                                <span class="text-sm mt-0.5" aria-hidden="true">@((MarkupString)model.Icon!)</span>
                            }

                            <div class="min-w-0">
                                <h3 id="@GetTitleId(model)" class="text-sm font-semibold text-slate-900 dark:text-slate-100 truncate">
                                    @model.Title
                                </h3>

                                @if (!string.IsNullOrWhiteSpace(model.Description))
                                {
                                    <p id="@GetDescriptionId(model)" class="text-xs text-slate-500 dark:text-slate-400 mt-0.5 leading-relaxed">
                                        @model.Description
                                    </p>
                                }
                            </div>
                        </div>

                        <button type="button"
                                class="ml-2 text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 transition-colors"
                                aria-label="Close"
                                @onclick="() => DialogService.Close(model)">
                            ✕
                        </button>
                    </div>

                    <!-- Scroll هنا داخل جسم النافذة فقط -->
                    <div class="mhd-dialog-body flex-1 min-h-0 overflow-y-auto overscroll-contain px-4 py-3 text-sm text-slate-700 dark:text-slate-200">
                        @if (model.Content is not null)
                        {
                            @model.Content
                        }
                    </div>

                    @if (model.Buttons?.Any() == true)
                    {
                        <div class="shrink-0 px-4 py-3 border-t border-slate-200 bg-white dark:bg-slate-900 dark:border-slate-700 flex items-center justify-end gap-2">
                            @foreach (var btn in model.Buttons)
                            {
                                if (string.Equals(btn.Type, "submit", StringComparison.OrdinalIgnoreCase))
                                {
                                    <button type="submit"
                                            form="@btn.FormId"
                                            class="@Design.GetButtonClass(btn.State, btn.IsPrimary ? MhdVariant.Filled : MhdVariant.Outline, btn.Size)">
                                        @btn.Text
                                    </button>
                                }
                                else
                                {
                                    <button type="button"
                                            class="@Design.GetButtonClass(btn.State, btn.IsPrimary ? MhdVariant.Filled : MhdVariant.Outline, btn.Size)"
                                            @onclick="() => OnButtonClick(model, btn)">
                                        @btn.Text
                                    </button>
                                }
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
}

@code {
    private IReadOnlyList<DialogModel> _dialogs = Array.Empty<DialogModel>();

    private bool _isDragging;
    private DialogModel? _dragDialog;
    private double _startMouseX;
    private double _startMouseY;
    private double _startOffsetX;
    private double _startOffsetY;

    protected override void OnInitialized()
    {
        DialogService.OnChange += OnDialogChanged;
        _dialogs = DialogService.Dialogs;
    }

    private void OnDialogChanged()
    {
        _dialogs = DialogService.Dialogs;
        InvokeAsync(StateHasChanged);
    }

    private async Task OnOverlayClick(DialogModel model)
    {
        if (model.CloseOnOverlayClick)
        {
            DialogService.Close(model);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnButtonClick(DialogModel model, DialogButtonModel btn)
    {
        if (btn.OnClick.HasValue)
            await btn.OnClick.Value.InvokeAsync();

        DialogService.Close(model);
    }

    private void OnHeaderMouseDown(DialogModel model, MouseEventArgs e)
    {
        if (!model.IsDraggable)
            return;

        _isDragging = true;
        _dragDialog = model;

        _startMouseX = e.ClientX;
        _startMouseY = e.ClientY;
        _startOffsetX = model.OffsetX;
        _startOffsetY = model.OffsetY;
    }

    private void OnMouseMove(MouseEventArgs e)
    {
        if (!_isDragging || _dragDialog is null)
            return;

        var dx = e.ClientX - _startMouseX;
        var dy = e.ClientY - _startMouseY;

        _dragDialog.OffsetX = _startOffsetX + dx;
        _dragDialog.OffsetY = _startOffsetY + dy;

        StateHasChanged();
    }

    private void OnMouseUp(MouseEventArgs _)
    {
        _isDragging = false;
        _dragDialog = null;
    }

    private Task OnDialogKeyDown(KeyboardEventArgs e, DialogModel model)
    {
        if (e.Key == "Escape")
        {
            DialogService.Close(model);
            return InvokeAsync(StateHasChanged);
        }

        var step = e.ShiftKey ? 24d : 12d;

        switch (e.Key)
        {
            case "ArrowRight":
                model.OffsetX += step;
                break;
            case "ArrowLeft":
                model.OffsetX -= step;
                break;
            case "ArrowDown":
                model.OffsetY += step;
                break;
            case "ArrowUp":
                model.OffsetY -= step;
                break;
            default:
                return Task.CompletedTask;
        }

        return InvokeAsync(StateHasChanged);
    }

    private string GetDialogClass(DialogModel model)
    {
        var size = model.Size switch
        {
            DialogSize.Small => "w-[24rem] max-h-[calc(100dvh-2rem)]",
            DialogSize.Medium => "w-[32rem] max-h-[calc(100dvh-2rem)]",
            DialogSize.Large => "w-[42rem] max-h-[calc(100dvh-2rem)]",
            DialogSize.ExtraLarge => "w-[64rem] max-h-[calc(100dvh-2rem)]",
            DialogSize.FullScreen => "w-[95vw] h-[92dvh] max-h-[92dvh]",
            _ => "w-[32rem] max-h-[calc(100dvh-2rem)]"
        };

        return string.Join(" ", new[]
        {
            "relative mx-auto my-2 flex flex-col min-h-0 max-w-[95vw] overflow-hidden",
            "rounded-lg border border-slate-200 bg-white shadow-xl",
            "dark:border-slate-700 dark:bg-slate-900",
            size
        });
    }

    private string GetHeaderClass(DialogModel model)
    {
        var dragCursor = model.IsDraggable ? "cursor-move select-none" : "cursor-default";

        return string.Join(" ", new[]
        {
            "shrink-0 px-4 py-3 border-b border-slate-200 bg-white",
            "dark:border-slate-700 dark:bg-slate-800/95",
            "flex items-start justify-between",
            dragCursor
        });
    }

    private string GetTitleId(DialogModel model) => $"mhd-dialog-title-{model.GetHashCode()}";
    private string GetDescriptionId(DialogModel model) => $"mhd-dialog-desc-{model.GetHashCode()}";

    public void Dispose()
    {
        DialogService.OnChange -= OnDialogChanged;
    }
}
