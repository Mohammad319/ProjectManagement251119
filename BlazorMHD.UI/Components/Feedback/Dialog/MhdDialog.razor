@using System.Linq
@using BlazorMHD.UI.Core.Services
@using BlazorMHD.UI.Core.DesignSystem
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@inject IDesignSystemService DesignSystemService
@inject DialogService DialogService
@implements IDisposable

@if (DialogService.Dialogs?.Any() == true)
{
    var dialogs = DialogService.Dialogs;

    <div @onkeydown="OnKeyDown">
        <div class="fixed inset-0 z-40 bg-slate-950/60 backdrop-blur-[2px] dialog-overlay-animate-in"
             @onclick="OnOverlayClick">
        </div>

        @foreach (var item in dialogs.Select((m, i) => new { Model = m, Index = i }))
        {
            var model = item.Model;
            var zIndex = 50 + item.Index * 10;

            <div class="fixed inset-0 overflow-y-auto px-3 py-4 sm:px-6 sm:py-8"
                 style="z-index:@zIndex;">
                <div class="flex min-h-full items-start justify-center">
                    <div class="relative dialog-animate-in"
                         style="@GetDialogStyle(model)"
                         @onmousemove="e => OnMouseMove(model, e)"
                         @onmouseup="e => OnMouseUp(model, e)"
                         @onmouseleave="e => OnMouseUp(model, e)">

                        <div class="@($"{DialogStyles.GetPanelClasses(model)} flex flex-col overflow-hidden border border-slate-200/80 bg-white shadow-2xl ring-1 ring-black/5 dark:border-slate-700/80 dark:bg-slate-900 dark:ring-white/10")"
                             style="@GetPanelStyle(model)"
                             role="dialog"
                             aria-modal="true"
                             aria-label="@model.Title">

                            <div class="flex items-start justify-between gap-4 border-b border-slate-200/80 bg-slate-50/90 px-4 py-3 backdrop-blur-sm dark:border-slate-700/80 dark:bg-slate-900/90 sm:px-5"
                                 @onmousedown="e => OnHeaderMouseDown(model, e)">
                                <div class="min-w-0 select-none @(model.IsDraggable ? "cursor-move" : string.Empty)">
                                    <div class="flex items-center gap-2">
                                        <span class="inline-flex h-2.5 w-2.5 shrink-0 rounded-full shadow-sm @DialogStyles.GetHeaderAccent(model.State)"></span>
                                        @if (!string.IsNullOrWhiteSpace(model.Icon))
                                        {
                                            <span class="text-slate-500 dark:text-slate-300">@((MarkupString)model.Icon)</span>
                                        }
                                        <span class="truncate text-sm font-semibold text-slate-900 dark:text-slate-50">
                                            @model.Title
                                        </span>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(model.Description))
                                    {
                                        <p class="mt-1 truncate text-xs text-slate-500 dark:text-slate-400">
                                            @model.Description
                                        </p>
                                    }
                                </div>

                                <button type="button"
                                        class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-transparent text-slate-500 transition hover:border-slate-200 hover:bg-white hover:text-slate-900 dark:text-slate-400 dark:hover:border-slate-700 dark:hover:bg-slate-800 dark:hover:text-slate-100"
                                        aria-label="Close"
                                        @onclick="@(() => Close(model))">
                                    ✕
                                </button>
                            </div>

                            <div class="flex-1 overflow-auto px-4 py-4 sm:px-5 sm:py-5">
                                @model.Content
                            </div>

                            @if (model.Buttons?.Any() == true)
                            {
                                <div class="flex flex-wrap items-center justify-end gap-2 border-t border-slate-200 bg-slate-50 px-4 py-3 dark:border-slate-700 dark:bg-slate-900 sm:px-5">
                                    @foreach (var btn in model.Buttons)
                                    {
                                        <button type="button"
                                                class="@GetButtonClasses(btn)"
                                                @onclick="() => OnButtonClick(btn, model)">
                                            @btn.Text
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private string GetPanelStyle(DialogModel model)
    {
        if (model.Size == DialogSize.FullScreen)
            return "width: 100vw; height: 100vh; max-width: 100vw; max-height: 100vh; border-radius: 0;";

        return model.Size switch
        {
            DialogSize.Small => "width: min(100%, 26rem); max-height: min(88vh, 52rem);",
            DialogSize.Medium => "width: min(100%, 34rem); max-height: min(88vh, 56rem);",
            DialogSize.Large => "width: min(100%, 48rem); max-height: min(88vh, 60rem);",
            DialogSize.ExtraLarge => "width: min(96vw, 72rem); max-height: min(90vh, 64rem);",
            _ => "width: min(100%, 34rem); max-height: min(88vh, 56rem);"
        };
    }

    protected override void OnInitialized()
    {
        DialogService.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        DialogService.OnChange -= StateHasChanged;
    }

    private void Close()
    {
        DialogService.Close();
    }

    private void Close(DialogModel model)
    {
        DialogService.Close(model);
    }

    private async Task OnButtonClick(DialogButtonModel button, DialogModel model)
    {
        if (button.OnClick is { HasDelegate: true })
        {
            await button.OnClick.Value.InvokeAsync();
        }

        DialogService.Close(model);
    }

    private string GetButtonClasses(DialogButtonModel button)
    {
        return DesignSystemService.GetButtonClass(button.State, MhdVariant.Outline, MhdSize.Md);
    }

    private bool _isDragging;
    private DialogModel? _draggingModel;
    private double _dragStartMouseX;
    private double _dragStartMouseY;
    private double _startOffsetX;
    private double _startOffsetY;

    private void OnHeaderMouseDown(DialogModel model, MouseEventArgs e)
    {
        if (!model.IsDraggable)
            return;

        _isDragging = true;
        _draggingModel = model;
        _dragStartMouseX = e.ClientX;
        _dragStartMouseY = e.ClientY;
        _startOffsetX = model.OffsetX;
        _startOffsetY = model.OffsetY;
    }

    private void OnMouseMove(DialogModel model, MouseEventArgs e)
    {
        if (!_isDragging || _draggingModel != model)
            return;

        var deltaX = e.ClientX - _dragStartMouseX;
        var deltaY = e.ClientY - _dragStartMouseY;

        model.OffsetX = _startOffsetX + deltaX;
        model.OffsetY = _startOffsetY + deltaY;

        StateHasChanged();
    }

    private void OnMouseUp(DialogModel model, MouseEventArgs e)
    {
        if (_draggingModel == model)
        {
            _isDragging = false;
            _draggingModel = null;
        }
    }

    private string GetDialogStyle(DialogModel model)
    {
        return $"transform: translate({model.OffsetX}px, {model.OffsetY}px);";
    }

    private void OnOverlayClick(MouseEventArgs e)
    {
        var top = DialogService.Dialogs.LastOrDefault();
        if (top is not null && top.CloseOnOverlayClick)
        {
            DialogService.Close(top);
        }
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" || e.Key == "Esc")
        {
            var top = DialogService.Dialogs?.LastOrDefault();
            if (top is not null)
            {
                DialogService.Close(top);
            }
        }
    }
}
