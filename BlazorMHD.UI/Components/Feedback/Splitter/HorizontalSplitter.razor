@* Components/HorizontalSplitter.razor *@
@using BlazorMHD.UI.Shared
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using System.Globalization
@implements IDisposable
@inject IJSRuntime JS

<div @ref="_containerRef"
     class="mhd-scope mhd-splitter-root @Class"
     style="--left-w:@($"{LeftWidth.ToString(CultureInfo.InvariantCulture)}px"); --splitter-w:@($"{SplitterThickness}px");">
    <div class="mhd-splitter-pane-fixed" style="width:var(--left-w);">
        @LeftContent
    </div>

    <div class="mhd-splitter-track"
         @ref="_splitterRef"
         style="width:var(--splitter-w);"
         @onmousedown="StartResize"
         title="@Localiztion.Instruction_DragToResize">
        <div class="mhd-splitter-handle-x"></div>
        <div class="mhd-splitter-grip-x"></div>
    </div>

    <div class="mhd-splitter-pane-fluid">
        @RightContent
    </div>
</div>

@code {
    [Parameter] public RenderFragment? LeftContent { get; set; }
    [Parameter] public RenderFragment? RightContent { get; set; }

    [Parameter] public double InitialPaneWidth { get; set; } = 360;
    [Parameter] public bool InitialWidthForRightPane { get; set; } = false;
    [Parameter] public double MinLeftWidth { get; set; } = 180;
    [Parameter] public double MinRightWidth { get; set; } = 220;
    [Parameter] public double? MaxLeftWidth { get; set; } = null;
    [Parameter] public int SplitterThickness { get; set; } = 6;
    [Parameter] public bool LiveResize { get; set; } = true;
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? StorageKey { get; set; }

    private double LeftWidth;
    private bool _initialized;
    private ElementReference _containerRef;
    private ElementReference _splitterRef;
    private DotNetObjectReference<HorizontalSplitter>? _objRef;

    protected override void OnInitialized()
    {
        LeftWidth = Math.Max(InitialPaneWidth, MinLeftWidth);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialized)
            return;

        _initialized = true;

        var containerWidth = await JS.InvokeAsync<double>("BlazorMHDUI.resizableDiv.getWidth", _containerRef);

        var targetLeftWidth = InitialWidthForRightPane
            ? containerWidth - SplitterThickness - InitialPaneWidth
            : InitialPaneWidth;

        LeftWidth = ClampLeftWidth(targetLeftWidth, containerWidth);
        StateHasChanged();
    }

    private double ClampLeftWidth(double leftWidth, double containerWidth)
    {
        var maxLeftByContainer = Math.Max(MinLeftWidth, containerWidth - SplitterThickness - MinRightWidth);
        var effectiveMaxLeft = MaxLeftWidth.HasValue
            ? Math.Min(MaxLeftWidth.Value, maxLeftByContainer)
            : maxLeftByContainer;

        return Math.Clamp(leftWidth, MinLeftWidth, effectiveMaxLeft);
    }

    private async Task StartResize(MouseEventArgs e)
    {
        var containerWidth = await JS.InvokeAsync<double>("BlazorMHDUI.resizableDiv.getWidth", _containerRef);

        var maxLeftByContainer = Math.Max(MinLeftWidth, containerWidth - SplitterThickness - MinRightWidth);
        var effectiveMaxLeft = MaxLeftWidth.HasValue
            ? Math.Min(MaxLeftWidth.Value, maxLeftByContainer)
            : maxLeftByContainer;

        LeftWidth = Math.Clamp(LeftWidth, MinLeftWidth, effectiveMaxLeft);
        _objRef ??= DotNetObjectReference.Create(this);

        await JS.InvokeVoidAsync(
            "BlazorMHDUI.resizableDiv.startHorizontalGhostDrag",
            _containerRef,
            _splitterRef,
            _objRef,
            new
            {
                startX = e.ClientX,
                initialLeft = LeftWidth,
                minLeft = MinLeftWidth,
                maxLeft = effectiveMaxLeft,
                splitterWidth = SplitterThickness,
                live = LiveResize
            });
    }

    [JSInvokable]
    public async Task OnHorizontalDragEnd(double finalLeftWidth)
    {
        var containerWidth = await JS.InvokeAsync<double>("BlazorMHDUI.resizableDiv.getWidth", _containerRef);
        LeftWidth = ClampLeftWidth(finalLeftWidth, containerWidth);

        if (!string.IsNullOrWhiteSpace(StorageKey))
        {
            try
            {
                await JS.InvokeVoidAsync("localStorage.setItem", StorageKey, LeftWidth.ToString(CultureInfo.InvariantCulture));
            }
            catch
            {
            }
        }

        StateHasChanged();
    }

    public void Dispose() => _objRef?.Dispose();
}
