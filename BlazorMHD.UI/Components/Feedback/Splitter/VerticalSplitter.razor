@* Components/VerticalSplitter.razor *@
@using BlazorMHD.UI.Shared
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using System.Globalization
@inject IJSRuntime JS
@implements IDisposable

<div @ref="_containerRef"
     class="mhd-scope mhd-splitter-root mhd-splitter-root-vertical @Class"
     style="--top-h:@($"{TopHeight.ToString(CultureInfo.InvariantCulture)}px"); --splitter-h:@($"{SplitterThickness}px");">
    <div class="mhd-splitter-pane-fixed-vertical" style="height:var(--top-h);">
        @TopContent
    </div>

    <div class="mhd-splitter-track mhd-splitter-track-vertical"
         @ref="_splitterRef"
         style="height:var(--splitter-h);"
         @onmousedown="StartResize"
         @onkeydown="OnSplitterKeyDown"
         role="separator"
         aria-orientation="horizontal"
         aria-valuemin="@MinTopHeight"
         aria-valuemax="@GetEffectiveMaxTop()"
         aria-valuenow="@TopHeight"
         tabindex="0"
         title="@Localiztion.Instruction_DragUpDownToResize">
        <div class="mhd-splitter-handle-y"></div>
        <div class="mhd-splitter-grip-y"></div>
    </div>

    <div class="mhd-splitter-pane-fluid-vertical">
        @BottomContent
    </div>
</div>

@code {
    [Parameter] public RenderFragment? TopContent { get; set; }
    [Parameter] public RenderFragment? BottomContent { get; set; }
    [Parameter] public double InitialPaneHeight { get; set; } = 300;
    [Parameter] public bool InitialHeightForBottomPane { get; set; } = false;
    [Parameter] public double MinTopHeight { get; set; } = 120;
    [Parameter] public double MinBottomHeight { get; set; } = 180;
    [Parameter] public double? MaxTopHeight { get; set; }
    [Parameter] public int SplitterThickness { get; set; } = 6;
    [Parameter] public bool LiveResize { get; set; } = true;
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? StorageKey { get; set; }
    [Parameter] public double KeyboardStep { get; set; } = 24;

    private double TopHeight;
    private bool _initialized;
    private ElementReference _containerRef;
    private ElementReference _splitterRef;
    private DotNetObjectReference<VerticalSplitter>? _objRef;

    protected override void OnInitialized()
    {
        TopHeight = Math.Max(InitialPaneHeight, MinTopHeight);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialized)
            return;

        _initialized = true;

        var containerHeight = await JS.InvokeAsync<double>("BlazorMHDUI.resizableDiv.getHeight", _containerRef);

        if (!string.IsNullOrWhiteSpace(StorageKey))
        {
            try
            {
                var stored = await JS.InvokeAsync<string?>("localStorage.getItem", StorageKey);
                if (!string.IsNullOrWhiteSpace(stored) &&
                    double.TryParse(stored, NumberStyles.Any, CultureInfo.InvariantCulture, out var saved))
                {
                    TopHeight = ClampTopHeight(saved, containerHeight);
                    StateHasChanged();
                    return;
                }
            }
            catch
            {
            }
        }

        var targetTopHeight = InitialHeightForBottomPane
            ? containerHeight - SplitterThickness - InitialPaneHeight
            : InitialPaneHeight;

        TopHeight = ClampTopHeight(targetTopHeight, containerHeight);
        StateHasChanged();
    }

    private double ClampTopHeight(double topHeight, double containerHeight)
    {
        var maxTopByContainer = Math.Max(MinTopHeight, containerHeight - SplitterThickness - MinBottomHeight);
        var effectiveMaxTop = MaxTopHeight.HasValue
            ? Math.Min(MaxTopHeight.Value, maxTopByContainer)
            : maxTopByContainer;

        return Math.Clamp(topHeight, MinTopHeight, effectiveMaxTop);
    }

    private async Task StartResize(MouseEventArgs e)
    {
        var containerHeight = await JS.InvokeAsync<double>("BlazorMHDUI.resizableDiv.getHeight", _containerRef);

        var maxTopByContainer = Math.Max(MinTopHeight, containerHeight - SplitterThickness - MinBottomHeight);
        var effectiveMaxTop = MaxTopHeight.HasValue
            ? Math.Min(MaxTopHeight.Value, maxTopByContainer)
            : maxTopByContainer;

        TopHeight = Math.Clamp(TopHeight, MinTopHeight, effectiveMaxTop);
        _objRef ??= DotNetObjectReference.Create(this);

        await JS.InvokeVoidAsync(
            "BlazorMHDUI.resizableDiv.startVerticalGhostDrag",
            _containerRef,
            _splitterRef,
            _objRef,
            new
            {
                startY = e.ClientY,
                initialTop = TopHeight,
                minTop = MinTopHeight,
                maxTop = effectiveMaxTop,
                splitterHeight = SplitterThickness,
                live = LiveResize
            });
    }

    private async Task OnSplitterKeyDown(KeyboardEventArgs e)
    {
        var containerHeight = await JS.InvokeAsync<double>("BlazorMHDUI.resizableDiv.getHeight", _containerRef);
        var max = ClampTopHeight(double.MaxValue, containerHeight);

        if (e.Key == "ArrowUp")
        {
            TopHeight = Math.Clamp(TopHeight - KeyboardStep, MinTopHeight, max);
            await PersistHeightAsync();
            StateHasChanged();
        }
        else if (e.Key == "ArrowDown")
        {
            TopHeight = Math.Clamp(TopHeight + KeyboardStep, MinTopHeight, max);
            await PersistHeightAsync();
            StateHasChanged();
        }
    }

    private double GetEffectiveMaxTop()
    {
        var fallback = Math.Max(MinTopHeight, TopHeight + 5000);
        return MaxTopHeight.HasValue ? Math.Min(MaxTopHeight.Value, fallback) : fallback;
    }

    [JSInvokable]
    public async Task OnVerticalDragEnd(double finalTopHeight)
    {
        var containerHeight = await JS.InvokeAsync<double>("BlazorMHDUI.resizableDiv.getHeight", _containerRef);
        TopHeight = ClampTopHeight(finalTopHeight, containerHeight);
        await PersistHeightAsync();
        StateHasChanged();
    }

    private async Task PersistHeightAsync()
    {
        if (string.IsNullOrWhiteSpace(StorageKey))
            return;

        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", StorageKey, TopHeight.ToString(CultureInfo.InvariantCulture));
        }
        catch
        {
        }
    }

    public void Dispose() => _objRef?.Dispose();
}
