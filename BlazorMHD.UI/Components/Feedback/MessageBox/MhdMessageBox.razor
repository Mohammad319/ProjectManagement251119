@using BlazorMHD.UI.Core.DesignSystem
@using BlazorMHD.UI.Core.Services
@inject MessageBoxService MessageBox
@implements IDisposable

@if (MessageBox.Current is not null)
{
    <div class="fixed top-4 left-1/2 -translate-x-1/2 z-[9999] w-[min(92vw,34rem)]">
        <div class="rounded-md border shadow-sm px-3 py-2 flex items-start gap-2 @GetStateClass(MessageBox.Current.State)"
             role="alert"
             aria-live="assertive"
             aria-atomic="true">
            <span class="text-sm leading-none mt-0.5" aria-hidden="true">@GetIcon(MessageBox.Current.State)</span>
            <div class="text-[0.75rem] flex-1 leading-relaxed">@MessageBox.Current.Message</div>

            <button type="button"
                    class="text-[0.75rem] opacity-70 hover:opacity-100 transition"
                    aria-label="Close"
                    @onclick="() => MessageBox.Clear()">
                ✕
            </button>
        </div>
    </div>
}

@code {
    private System.Timers.Timer? _timer;

    protected override void OnInitialized()
    {
        MessageBox.OnChange += OnChanged;

        _timer = new System.Timers.Timer(250);
        _timer.AutoReset = true;
        _timer.Elapsed += (_, _) => MessageBox.Tick();
        _timer.Start();
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        MessageBox.OnChange -= OnChanged;

        if (_timer is not null)
        {
            _timer.Stop();
            _timer.Dispose();
            _timer = null;
        }
    }

    private static string GetIcon(MhdState state) => state switch
    {
        MhdState.Success => "✅",
        MhdState.Danger => "⛔",
        MhdState.Warning => "⚠️",
        MhdState.Info => "ℹ️",
        MhdState.Primary => "🔵",
        MhdState.Secondary => "🟣",
        _ => "💬"
    };

    private static string GetStateClass(MhdState state) => state switch
    {
        MhdState.Success =>
            "bg-emerald-50 text-emerald-900 border-emerald-200 dark:bg-emerald-900/30 dark:text-emerald-100 dark:border-emerald-700",

        MhdState.Danger =>
            "bg-red-50 text-red-900 border-red-200 dark:bg-red-900/30 dark:text-red-100 dark:border-red-700",

        MhdState.Warning =>
            "bg-amber-50 text-amber-900 border-amber-200 dark:bg-amber-900/30 dark:text-amber-100 dark:border-amber-700",

        MhdState.Info =>
            "bg-sky-50 text-sky-900 border-sky-200 dark:bg-sky-900/30 dark:text-sky-100 dark:border-sky-700",

        MhdState.Primary =>
            "bg-blue-50 text-blue-900 border-blue-200 dark:bg-blue-900/30 dark:text-blue-100 dark:border-blue-700",

        MhdState.Secondary =>
            "bg-violet-50 text-violet-900 border-violet-200 dark:bg-violet-900/30 dark:text-violet-100 dark:border-violet-700",

        _ =>
            "bg-slate-50 text-slate-900 border-slate-200 dark:bg-slate-900/30 dark:text-slate-100 dark:border-slate-700"
    };
}
