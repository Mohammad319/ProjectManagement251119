@using BlazorMHD.UI.Core.DesignSystem
@using BlazorMHD.UI.Core.Services
@inject ToastService Toast
@implements IDisposable

<div class="fixed right-4 bottom-4 z-[9999] flex flex-col gap-2 w-[20rem] pointer-events-none"
     aria-live="polite"
     aria-atomic="false">

    @foreach (var t in Toast.GetToasts())
    {
        var totalMs = Math.Max(1, (t.ExpireAt - DateTimeOffset.UtcNow).TotalMilliseconds);

        <div class="pointer-events-auto rounded-lg border shadow-lg overflow-hidden animate-slide-in @GetStateClass(t.State)"
             role="status"
             aria-label="Notification">

            <div class="px-3 py-2">
                <div class="flex items-start gap-2">
                    <div class="text-sm leading-none mt-0.5" aria-hidden="true">@GetIcon(t.State)</div>

                    <div class="flex-1 min-w-0">
                        <div class="text-xs font-semibold truncate">@t.Title</div>
                        @if (!string.IsNullOrWhiteSpace(t.Message))
                        {
                            <div class="text-[0.70rem] mt-0.5 opacity-90 break-words">@t.Message</div>
                        }
                    </div>

                    <button type="button"
                            class="text-[0.75rem] opacity-70 hover:opacity-100 transition"
                            aria-label="Close"
                            @onclick="() => Toast.Dismiss(t.Id)">
                        ✕
                    </button>
                </div>
            </div>

            <div class="h-0.5 w-full bg-black/10 dark:bg-white/10">
                <div class="h-full animate-toast-progress"
                     style="animation-duration:@($"{totalMs:0}ms"); background: currentColor; opacity:.35;"></div>
            </div>
        </div>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        Toast.OnChange += OnChanged;
    }

    private void OnChanged()
        => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Toast.OnChange -= OnChanged;
    }

    private static string GetIcon(MhdState state) => state switch
    {
        MhdState.Success => "✅",
        MhdState.Danger => "⛔",
        MhdState.Warning => "⚠️",
        MhdState.Info => "ℹ️",
        MhdState.Primary => "🔵",
        MhdState.Secondary => "🟣",
        _ => "💬"
    };

    private static string GetStateClass(MhdState state) => state switch
    {
        MhdState.Success =>
            "bg-emerald-50 text-emerald-900 border-emerald-200 dark:bg-emerald-900/30 dark:text-emerald-100 dark:border-emerald-700",

        MhdState.Danger =>
            "bg-red-50 text-red-900 border-red-200 dark:bg-red-900/30 dark:text-red-100 dark:border-red-700",

        MhdState.Warning =>
            "bg-amber-50 text-amber-900 border-amber-200 dark:bg-amber-900/30 dark:text-amber-100 dark:border-amber-700",

        MhdState.Info =>
            "bg-sky-50 text-sky-900 border-sky-200 dark:bg-sky-900/30 dark:text-sky-100 dark:border-sky-700",

        MhdState.Primary =>
            "bg-blue-50 text-blue-900 border-blue-200 dark:bg-blue-900/30 dark:text-blue-100 dark:border-blue-700",

        MhdState.Secondary =>
            "bg-violet-50 text-violet-900 border-violet-200 dark:bg-violet-900/30 dark:text-violet-100 dark:border-violet-700",

        _ =>
            "bg-slate-50 text-slate-900 border-slate-200 dark:bg-slate-900/30 dark:text-slate-100 dark:border-slate-700"
    };
}
