@using BlazorMHD.UI.Core.DesignSystem
@using BlazorMHD.UI.Core.Services
@inject ToastService Toast
@implements IDisposable

<div class="mhd-scope mhd-toast-host"
     aria-live="polite"
     aria-atomic="false">

    @foreach (var t in Toast.GetToasts())
    {
        var totalMs = Math.Max(1, (t.ExpireAt - DateTimeOffset.UtcNow).TotalMilliseconds);

        <div class="@GetStateClass(t.State)"
             role="status"
             aria-label="Notification">

            <div class="mhd-toast-main">
                <div class="mhd-toast-icon" aria-hidden="true">@GetIcon(t.State)</div>

                <div class="mhd-toast-content">
                    <div class="mhd-toast-title">@t.Title</div>
                    @if (!string.IsNullOrWhiteSpace(t.Message))
                    {
                        <div class="mhd-toast-message">@t.Message</div>
                    }
                </div>

                <button type="button"
                        class="mhd-toast-close"
                        aria-label="Close"
                        @onclick="() => Toast.Dismiss(t.Id)">
                    ✕
                </button>
            </div>

            <div class="mhd-toast-progress-track">
                <div class="mhd-toast-progress-bar"
                     style="animation-duration:@($"{totalMs:0}ms");"></div>
            </div>
        </div>
    }
</div>

@code {
    protected override void OnInitialized() => Toast.OnChange += OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Toast.OnChange -= OnChanged;

    private static string GetIcon(MhdState state) => state switch
    {
        MhdState.Success => "✅",
        MhdState.Danger => "⛔",
        MhdState.Warning => "⚠️",
        MhdState.Info => "ℹ️",
        MhdState.Primary => "🔵",
        MhdState.Secondary => "🟣",
        _ => "💬"
    };

    private static string GetStateClass(MhdState state) => state switch
    {
        MhdState.Success => "mhd-toast-surface mhd-toast-tone-success",
        MhdState.Danger => "mhd-toast-surface mhd-toast-tone-danger",
        MhdState.Warning => "mhd-toast-surface mhd-toast-tone-warning",
        MhdState.Info => "mhd-toast-surface mhd-toast-tone-info",
        MhdState.Primary => "mhd-toast-surface mhd-toast-tone-primary",
        MhdState.Secondary => "mhd-toast-surface mhd-toast-tone-secondary",
        _ => "mhd-toast-surface mhd-toast-tone-neutral"
    };
}
