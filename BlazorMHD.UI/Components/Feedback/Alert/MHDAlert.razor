@using Microsoft.AspNetCore.Components
@using System.Linq
@using System.Collections.Generic

@if (Visible && HasContent)
{
    <div class="mhd-scope">
    <div class="@ContainerClass"
         role="@Role"
         aria-live="@AriaLive"
         aria-atomic="true"
         @attributes="AdditionalAttributes">

        <div class="min-w-0 flex-1">
            @if (!string.IsNullOrWhiteSpace(Title))
            {
                <div class="text-sm font-semibold leading-5">@Title</div>
            }

            @if (ChildContent is not null)
            {
                <div class="@BodyClass">@ChildContent</div>
            }
            else if (!string.IsNullOrWhiteSpace(Message))
            {
                <div class="@BodyClass">@Message</div>
            }
        </div>

        @if (Dismissible)
        {
            <button type="button"
                    class="@CloseButtonClass"
                    aria-label="@CloseButtonAriaLabel"
                    @onclick="DismissAsync">
                <span aria-hidden="true" class="text-base leading-none">✕</span>
                <span class="sr-only">@CloseButtonAriaLabel</span>
            </button>
        }
        </div>
    </div>
}

@code {
    [Parameter] public MhdNoticeKind Kind { get; set; } = MhdNoticeKind.Info;
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Message { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public bool Dismissible { get; set; } = false;
    [Parameter] public bool Visible { get; set; } = true;
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public EventCallback OnDismiss { get; set; }

    // Tailwind behavior options
    [Parameter] public bool Dense { get; set; } = false;
    [Parameter] public string? Class { get; set; }
    [Parameter] public string CloseButtonAriaLabel { get; set; } = "Close";

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private bool HasContent =>
        !string.IsNullOrWhiteSpace(Title) ||
        !string.IsNullOrWhiteSpace(Message) ||
        ChildContent is not null;

    private string Role =>
        Kind is MhdNoticeKind.Warning or MhdNoticeKind.Error ? "alert" : "status";

    private string AriaLive =>
        Kind is MhdNoticeKind.Warning or MhdNoticeKind.Error ? "assertive" : "polite";

    private string ToneClass => Kind switch
    {
        MhdNoticeKind.Success =>
            "border-emerald-300 bg-emerald-50 text-emerald-900 " +
            "dark:border-emerald-500/60 dark:bg-emerald-950/60 dark:text-emerald-100",

        MhdNoticeKind.Warning =>
            "border-amber-300 bg-amber-50 text-amber-950 " +
            "dark:border-amber-500/60 dark:bg-amber-950/60 dark:text-amber-100",

        MhdNoticeKind.Error =>
            "border-rose-300 bg-rose-50 text-rose-950 " +
            "dark:border-rose-500/60 dark:bg-rose-950/60 dark:text-rose-100",

        _ =>
            "border-sky-300 bg-sky-50 text-sky-950 " +
            "dark:border-sky-500/60 dark:bg-sky-950/60 dark:text-sky-100"
    };

    private string ContainerClass => Join(
        "relative isolate w-full flex items-start gap-2 rounded-xl border border-l-4 shadow-sm",
        Dense ? "px-3 py-2" : "px-3.5 py-2.5",
        ToneClass,
        Class
    );

    private string BodyClass => Dense
        ? "mt-0.5 text-sm leading-5 text-current"
        : "mt-1 text-sm leading-6 text-current";

    private string CloseButtonClass => Join(
        "ml-1 inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-md text-current",
        "opacity-90 transition hover:opacity-100",
        "hover:bg-black/5 dark:hover:bg-white/10",
        "focus:outline-none focus:ring-2 focus:ring-current/40"
    );

    private static string Join(params string?[] parts) =>
        string.Join(" ", parts.Where(p => !string.IsNullOrWhiteSpace(p)));

    private async Task DismissAsync()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(false);
        await OnDismiss.InvokeAsync();
    }
}
