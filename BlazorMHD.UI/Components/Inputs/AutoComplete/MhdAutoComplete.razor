@using Microsoft.AspNetCore.Components.Web
@using System.Globalization
@typeparam TItem
@implements IDisposable

<div class="relative text-[0.75rem]" @onclick:stopPropagation="true" dir="@EffectiveDirection">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="text-[0.70rem] text-slate-500 dark:text-slate-400 mb-0.5 block" for="@_inputId">
            @Label
        </label>
    }

    <div class="inline-flex items-center w-full border border-slate-200 dark:border-slate-700 rounded-md bg-white dark:bg-slate-950 px-2 py-0.5 focus-within:ring-1 focus-within:ring-blue-500">
        <input id="@_inputId"
               class="flex-1 bg-transparent focus:outline-none text-slate-900 dark:text-slate-100 placeholder:text-slate-400 dark:placeholder:text-slate-500 text-[0.75rem]"
               value="@_searchText"
               @oninput="OnInputChanged"
               placeholder="@Placeholder"
               @onkeydown="OnKeyDown"
               @onblur="OnBlur"
               @onfocus="OnFocus"
               role="combobox"
               autocomplete="off"
               aria-autocomplete="list"
               aria-expanded="@_isOpen"
               aria-controls="@_listboxId"
               aria-activedescendant="@GetActiveDescendant()"
               aria-label="@EffectiveAriaLabel" />

        @if (IsBusy)
        {
            <span class="ml-1 text-[0.65rem] text-slate-400 dark:text-slate-500" aria-hidden="true">…</span>
        }
    </div>

    @if (_isOpen && _results.Any())
    {
        <div id="@_listboxId"
             class="absolute mt-1 left-0 right-0 bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-md shadow-sm max-h-48 overflow-auto text-[0.75rem] animate-slide-in"
             style="z-index:9999;"
             role="listbox"
             aria-label="@EffectiveAriaLabel">
            @foreach (var (item, index) in _results.Select((v, i) => (v, i)))
            {
                <div id="@GetOptionId(index)"
                     class="@GetItemClass(index)"
                     role="option"
                     aria-selected="@(index == _highlightIndex)"
                     @onmousedown="() => SelectItem(item)">
                    @if (ItemTemplate != null)
                    {
                        @ItemTemplate(item)
                    }
                    else
                    {
                        @GetItemText(item)
                    }
                </div>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(HelperText))
    {
        <div class="mt-0.5 text-[0.65rem] text-slate-500 dark:text-slate-400">
            @HelperText
        </div>
    }
</div>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Placeholder { get; set; } = "Search...";
    [Parameter] public string? HelperText { get; set; }

    [Parameter] public Func<string, Task<IEnumerable<TItem>>>? SearchMethod { get; set; }

    [Parameter] public RenderFragment<TItem>? ItemTemplate { get; set; }
    [Parameter] public Func<TItem, string>? ItemTextSelector { get; set; }

    [Parameter] public TItem? SelectedItem { get; set; }
    [Parameter] public EventCallback<TItem?> SelectedItemChanged { get; set; }

    [Parameter] public int MinSearchLength { get; set; } = 2;
    [Parameter] public int DebounceMilliseconds { get; set; } = 250;
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public bool UseCurrentCultureDirection { get; set; } = true;

    private string _searchText = string.Empty;
    private bool _isOpen;
    private bool IsBusy;
    private List<TItem> _results = new();
    private int _highlightIndex = -1;

    private CancellationTokenSource? _debounceCts;
    private CancellationTokenSource? _blurCts;
    private int _searchVersion;

    private readonly string _inputId = $"mhd-ac-input-{Guid.NewGuid():N}";
    private readonly string _listboxId = $"mhd-ac-listbox-{Guid.NewGuid():N}";

    private string EffectiveAriaLabel =>
        !string.IsNullOrWhiteSpace(AriaLabel)
            ? AriaLabel!
            : !string.IsNullOrWhiteSpace(Label)
                ? Label!
                : "Autocomplete";

    private string EffectiveDirection =>
        UseCurrentCultureDirection && CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "rtl" : "ltr";

    private async Task OnInputChanged(ChangeEventArgs e)
    {
        _searchText = e.Value?.ToString() ?? string.Empty;

        if (_searchText.Length < MinSearchLength)
        {
            _results.Clear();
            _isOpen = false;
            _highlightIndex = -1;
            CancelDebounce();
            return;
        }

        await RestartDebounceAsync(_searchText);
    }

    private async Task RestartDebounceAsync(string query)
    {
        CancelDebounce();

        var cts = new CancellationTokenSource();
        _debounceCts = cts;
        var currentVersion = ++_searchVersion;

        try
        {
            await Task.Delay(DebounceMilliseconds, cts.Token);
            await SearchNowAsync(query, currentVersion, cts.Token);
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task SearchNowAsync(string query, int version, CancellationToken token)
    {
        if (SearchMethod == null || query.Length < MinSearchLength)
            return;

        IsBusy = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var result = await SearchMethod(query);

            if (token.IsCancellationRequested || version != _searchVersion)
                return;

            _results = result?.ToList() ?? new List<TItem>();
            _isOpen = _results.Count > 0;
            _highlightIndex = _results.Count > 0 ? 0 : -1;
        }
        finally
        {
            IsBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SelectItem(TItem item)
    {
        SelectedItem = item;
        _searchText = GetItemText(item);
        _isOpen = false;
        _results.Clear();
        _highlightIndex = -1;
        await SelectedItemChanged.InvokeAsync(SelectedItem);
    }

    private void OnFocus(FocusEventArgs _)
    {
        if (_results.Any())
            _isOpen = true;
    }

    private string GetItemText(TItem item)
    {
        if (ItemTextSelector != null)
            return ItemTextSelector(item);

        return item?.ToString() ?? string.Empty;
    }

    private string GetItemClass(int index)
    {
        var baseCls = "px-2 py-1 cursor-pointer hover:bg-slate-50 dark:hover:bg-slate-800";
        var active = index == _highlightIndex ? "bg-slate-50 dark:bg-slate-800" : string.Empty;
        return $"{baseCls} {active}";
    }

    private string GetOptionId(int index) => $"{_listboxId}-opt-{index}";

    private string? GetActiveDescendant()
    {
        if (!_isOpen || _highlightIndex < 0 || _highlightIndex >= _results.Count)
            return null;

        return GetOptionId(_highlightIndex);
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (!_isOpen && (e.Key == "ArrowDown" || e.Key == "Enter"))
        {
            if (_searchText.Length >= MinSearchLength)
                await RestartDebounceAsync(_searchText);

            return;
        }

        if (e.Key == "Escape")
        {
            _isOpen = false;
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (e.Key == "ArrowDown" && _results.Any())
        {
            _highlightIndex = Math.Min(_highlightIndex + 1, _results.Count - 1);
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (e.Key == "ArrowUp" && _results.Any())
        {
            _highlightIndex = Math.Max(_highlightIndex - 1, 0);
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (e.Key == "Enter" && _isOpen && _highlightIndex >= 0 && _highlightIndex < _results.Count)
        {
            await SelectItem(_results[_highlightIndex]);
        }
    }

    private void OnBlur(FocusEventArgs _)
    {
        _blurCts?.Cancel();
        _blurCts?.Dispose();

        var cts = new CancellationTokenSource();
        _blurCts = cts;

        Task.Run(async () =>
        {
            try
            {
                await Task.Delay(150, cts.Token);
                _isOpen = false;
                await InvokeAsync(StateHasChanged);
            }
            catch (OperationCanceledException) { }
        });

    }

    private void CancelDebounce()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
        _debounceCts = null;
    }

    public void Dispose()
    {
        CancelDebounce();

        _blurCts?.Cancel();
        _blurCts?.Dispose();
        _blurCts = null;
    }
}
