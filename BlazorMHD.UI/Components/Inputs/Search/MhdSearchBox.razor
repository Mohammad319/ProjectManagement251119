@using BlazorMHD.UI.Core.DesignSystem
@using Microsoft.AspNetCore.Components.Web

<div class="@BuildShellClass()"
     dir="@Direction">
    <span class="mhd-search-icon" aria-hidden="true">🔍</span>
    <input value="@Value"
           @oninput="OnInput"
           class="@BuildInputClass()"
           placeholder="@Placeholder"
           aria-label="@EffectiveAriaLabel"
           disabled="@Disabled"
           @onkeydown="OnKeyDown"
           @attributes="FilteredAttributes" />
</div>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Search...";
    [Parameter] public EventCallback<KeyboardEventArgs> OnKeyDown { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public string Direction { get; set; } = "auto";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public MhdSize Size { get; set; } = MhdSize.Sm;

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string EffectiveAriaLabel => !string.IsNullOrWhiteSpace(AriaLabel) ? AriaLabel! : "Search";

    private async Task OnInput(ChangeEventArgs e)
    {
        var next = e.Value?.ToString();
        if (next == Value)
            return;

        Value = next;
        await ValueChanged.InvokeAsync(Value);
    }

    private IReadOnlyDictionary<string, object>? FilteredAttributes =>
        AdditionalAttributes?
            .Where(kv => !string.Equals(kv.Key, "class", StringComparison.OrdinalIgnoreCase))
            .ToDictionary(kv => kv.Key, kv => kv.Value);

    private string BuildShellClass()
    {
        var cls = InputCss.Shell(Size, Disabled, false);
        if (AdditionalAttributes is not null &&
            AdditionalAttributes.TryGetValue("class", out var c) && c is string extra && !string.IsNullOrWhiteSpace(extra))
        {
            cls += " " + extra;
        }
        return cls;
    }

    private string BuildInputClass() => InputCss.SearchInput(Size);
}
