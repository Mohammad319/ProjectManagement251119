@using BlazorMHD.UI.Core.DesignSystem
@using Microsoft.AspNetCore.Components.Web

<button type="button"
        class="@BuildClass()"
        role="switch"
        aria-checked="@Value"
        aria-label="@EffectiveAriaLabel"
        disabled="@Disabled"
        @onclick="Toggle"
        @onkeydown="OnKeyDown">
    <span class="@ThumbClass"></span>
</button>

@code {
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public MhdSize Size { get; set; } = MhdSize.Sm;

    private string EffectiveAriaLabel => string.IsNullOrWhiteSpace(AriaLabel) ? "Toggle" : AriaLabel!;

    private async Task Toggle()
    {
        if (Disabled)
            return;

        Value = !Value;
        await ValueChanged.InvokeAsync(Value);
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (Disabled)
            return;

        if (e.Key is " " or "Enter")
        {
            await Toggle();
        }
    }

    private string BuildClass() => InputCss.ToggleTrack(Size, Value, Disabled);

    private string ThumbClass => InputCss.ToggleThumb(Size, Value);
}
