@using BlazorMHD.UI.Core.DesignSystem
@using Microsoft.AspNetCore.Components.Web

<div class="@InputCss.Stack" dir="@Direction">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label for="@_inputId" class="@InputCss.Label">
            @Label
        </label>
    }

    <input id="@_inputId"
           value="@Value"
           @oninput="OnInput"
           type="@InputType"
           class="@BuildInputClass()"
           placeholder="@Placeholder"
           aria-label="@EffectiveAriaLabel"
           disabled="@Disabled"
           readonly="@ReadOnly"
           @onkeydown="OnKeyDown"
           @attributes="FilteredAttributes" />

    @if (!string.IsNullOrEmpty(HelperText))
    {
        <span class="@InputCss.Helper">
            @HelperText
        </span>
    }
</div>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public string InputType { get; set; } = "text";

    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ReadOnly { get; set; }

    [Parameter] public MhdSize Size { get; set; } = MhdSize.Sm;
    [Parameter] public string Direction { get; set; } = "auto";
    [Parameter] public string? AriaLabel { get; set; }

    [Parameter] public EventCallback<KeyboardEventArgs> OnKeyDown { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private readonly string _inputId = $"mhd-text-{Guid.NewGuid():N}";

    private string EffectiveAriaLabel =>
        !string.IsNullOrWhiteSpace(AriaLabel)
            ? AriaLabel!
            : !string.IsNullOrWhiteSpace(Label)
                ? Label!
                : "Text input";

    private IReadOnlyDictionary<string, object>? FilteredAttributes =>
        AdditionalAttributes?
            .Where(kv => !string.Equals(kv.Key, "class", StringComparison.OrdinalIgnoreCase))
            .ToDictionary(kv => kv.Key, kv => kv.Value);

    private async Task OnInput(ChangeEventArgs e)
    {
        var next = e.Value?.ToString();
        if (next == Value)
            return;

        Value = next;
        await ValueChanged.InvokeAsync(Value);
    }

    private string BuildInputClass()
    {
        var cls = InputCss.Field(Size, Disabled, ReadOnly);

        if (AdditionalAttributes != null &&
            AdditionalAttributes.TryGetValue("class", out var clsObj) &&
            clsObj is string extra &&
            !string.IsNullOrWhiteSpace(extra))
        {
            cls += " " + extra;
        }

        return cls;
    }
}
