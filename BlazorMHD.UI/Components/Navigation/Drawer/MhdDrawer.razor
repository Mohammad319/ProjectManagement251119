@using BlazorMHD.UI.Core.Navigation

<div class="flex h-full">
    <nav class="@BuildDrawerClass()">
        <div class="flex items-center justify-between px-2 py-2">
            @if (!Collapsed && Brand != null)
            {
                <div class="text-xs font-semibold text-slate-900 dark:text-slate-100">
                    @Brand
                </div>
            }
            <button type="button"
                    class="text-[0.70rem] text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100"
                    @onclick="Toggle">
                @(Collapsed ? "»" : "«")
            </button>
        </div>

        <div class="mt-1 flex-1 overflow-y-auto">
            @foreach (var item in Items)
            {
                <button type="button"
                        class="@BuildItemClass(item)"
                        @onclick="() => OnItemClicked(item)">
                    @if (!string.IsNullOrEmpty(item.Icon))
                    {
                        <span class="text-[0.9rem] mr-1.5">@((MarkupString)item.Icon)</span>
                    }
                    @if (!Collapsed)
                    {
                        <span class="text-[0.75rem] truncate">@item.Text</span>
                    }
                </button>
            }
        </div>
    </nav>

    <div class="flex-1 min-w-0">
        @ChildContent
    </div>
</div>

@code {
    [Parameter] public List<DrawerItem> Items { get; set; } = new();
    [Parameter] public RenderFragment? Brand { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public bool Collapsed { get; set; }
    [Parameter] public EventCallback<bool> CollapsedChanged { get; set; }

    private async Task Toggle()
    {
        Collapsed = !Collapsed;
        await CollapsedChanged.InvokeAsync(Collapsed);
    }

    private async Task OnItemClicked(DrawerItem item)
    {
        foreach (var it in Items)
            it.IsActive = false;

        item.IsActive = true;

        if (item.OnClick.HasDelegate)
            await item.OnClick.InvokeAsync();
    }

    private string BuildDrawerClass()
    {
        var width = Collapsed ? "w-12" : "w-44";

        return string.Join(" ", new[]
        {
            "h-full border-r border-slate-200 dark:border-slate-800",
            "bg-white dark:bg-slate-950",
            "text-slate-900 dark:text-slate-100",
            "flex flex-col text-[0.75rem]",
            width
        });
    }

    private string BuildItemClass(DrawerItem item)
    {
        var activeCls = item.IsActive
            ? "bg-blue-50 text-blue-700 dark:bg-slate-700 dark:text-slate-100"
            : "text-slate-500 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-slate-100";

        return string.Join(" ", new[]
        {
            "w-full flex items-center px-2 py-1 rounded-md mb-0.5",
            "text-left transition-colors duration-150",
            activeCls
        });
    }
}
