@using BlazorMHD.UI.Core.Navigation

<div class="mhd-drawer-layout">
    <nav class="@BuildDrawerClass()">
        <div class="mhd-drawer-nav">
            <div class="mhd-drawer-header">
                @if (!Collapsed && Brand != null)
                {
                    <div class="mhd-drawer-brand">
                        @Brand
                    </div>
                }
                <button type="button"
                        class="mhd-drawer-toggle"
                        @onclick="Toggle">
                    @(Collapsed ? "»" : "«")
                </button>
            </div>

            <div class="mhd-drawer-items">
                @foreach (var item in Items)
                {
                    <button type="button"
                            class="@BuildItemClass(item)"
                            @onclick="() => OnItemClicked(item)">
                        @if (!string.IsNullOrEmpty(item.Icon))
                        {
                            <span class="mhd-drawer-icon">@((MarkupString)item.Icon)</span>
                        }
                        @if (!Collapsed)
                        {
                            <span class="mhd-drawer-text">@item.Text</span>
                        }
                    </button>
                }
            </div>
        </div>
    </nav>

    <div class="mhd-drawer-content">
        @ChildContent
    </div>
</div>

@code {
    [Parameter] public List<DrawerItem> Items { get; set; } = new();
    [Parameter] public RenderFragment? Brand { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public bool Collapsed { get; set; }
    [Parameter] public EventCallback<bool> CollapsedChanged { get; set; }

    private async Task Toggle()
    {
        Collapsed = !Collapsed;
        await CollapsedChanged.InvokeAsync(Collapsed);
    }

    private async Task OnItemClicked(DrawerItem item)
    {
        foreach (var it in Items)
            it.IsActive = false;

        item.IsActive = true;

        if (item.OnClick.HasDelegate)
            await item.OnClick.InvokeAsync();
    }

    private string BuildDrawerClass()
    {
        var width = Collapsed ? "mhd-drawer-shell-collapsed" : "mhd-drawer-shell-expanded";
        return $"mhd-drawer-shell {width}";
    }

    private static string BuildItemClass(DrawerItem item)
        => item.IsActive
            ? "mhd-drawer-item mhd-drawer-item-active"
            : "mhd-drawer-item mhd-drawer-item-inactive";
}
