@using BlazorMHD.UI.Core.Navigation

<nav class="@BuildNavClass()" aria-label="Breadcrumb">
    @for (int i = 0; i < Items.Count; i++)
    {
        var item = Items[i];

        if (i > 0)
        {
            <span class="mhd-breadcrumb-separator">/</span>
        }

        if (!string.IsNullOrEmpty(item.Href) && !item.IsCurrent)
        {
            <a href="@item.Href" class="mhd-breadcrumb-link">
                @item.Text
            </a>
        }
        else
        {
            <span class="mhd-breadcrumb-current">
                @item.Text
            </span>
        }
    }
</nav>

@code {
    [Parameter] public List<BreadcrumbItem> Items { get; set; } = new();
    [Parameter] public string? Class { get; set; }

    private string BuildNavClass()
        => string.IsNullOrWhiteSpace(Class) ? "mhd-breadcrumb" : $"mhd-breadcrumb {Class}";
}
