@using BlazorMHD.UI.Core.Navigation

<nav class="flex items-center text-[0.70rem] text-slate-500 dark:text-slate-400 mb-1" aria-label="Breadcrumb">
    @for (int i = 0; i < Items.Count; i++)
    {
        var item = Items[i];

        if (i > 0)
        {
            <span class="mx-1 text-slate-500 dark:text-slate-400">/</span>
        }

        if (!string.IsNullOrEmpty(item.Href) && !item.IsCurrent)
        {
            <a href="@item.Href"
               class="hover:text-slate-900 dark:hover:text-slate-100">
                @item.Text
            </a>
        }
        else
        {
            <span class="text-slate-900 dark:text-slate-100 font-medium">
                @item.Text
            </span>
        }
    }
</nav>

@code {
    [Parameter] public List<BreadcrumbItem> Items { get; set; } = new();
}
