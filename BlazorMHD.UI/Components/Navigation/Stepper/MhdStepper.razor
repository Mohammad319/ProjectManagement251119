@using BlazorMHD.UI.Core.Navigation

<div class="mhd-stepper">
    @for (int i = 0; i < Steps.Count; i++)
    {
        var step = Steps[i];
        var index = i + 1;
        var isActive = step.Key == ActiveKey;
        var isCompleted = i < GetActiveIndex();

        <div class="mhd-stepper-item">
            <div class="@BuildCircleClass(isActive, isCompleted)">
                @index
            </div>
            <div class="mhd-stepper-copy">
                <span class="@BuildTitleClass(isActive, isCompleted)">
                    @step.Title
                </span>
                @if (!string.IsNullOrEmpty(step.Description))
                {
                    <span class="mhd-stepper-description">
                        @step.Description
                    </span>
                }
            </div>

            @if (i < Steps.Count - 1)
            {
                <div class="mhd-stepper-connector"></div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public List<StepItem> Steps { get; set; } = new();
    [Parameter] public string? ActiveKey { get; set; }
    [Parameter] public EventCallback<string?> ActiveKeyChanged { get; set; }

    protected override void OnInitialized()
    {
        if (string.IsNullOrEmpty(ActiveKey) && Steps.Any())
        {
            ActiveKey = Steps.First().Key;
        }
    }

    private int GetActiveIndex()
    {
        if (string.IsNullOrEmpty(ActiveKey)) return 0;
        var idx = Steps.FindIndex(s => s.Key == ActiveKey);
        return idx < 0 ? 0 : idx;
    }

    private static string BuildCircleClass(bool isActive, bool isCompleted)
    {
        if (isCompleted)
            return "mhd-stepper-circle mhd-stepper-circle-completed";

        if (isActive)
            return "mhd-stepper-circle mhd-stepper-circle-active";

        return "mhd-stepper-circle mhd-stepper-circle-inactive";
    }

    private static string BuildTitleClass(bool isActive, bool isCompleted)
    {
        if (isCompleted) return "mhd-stepper-title-completed";
        if (isActive) return "mhd-stepper-title-active";
        return "mhd-stepper-title-inactive";
    }
}
