<div class="mhd-status-root" @attributes="AdditionalAttributes">
    <span class="@BuildDotClass()"></span>

    @if (!string.IsNullOrEmpty(Text))
    {
        <span class="mhd-status-text">@Text</span>
    }
</div>

@code {
    [Parameter] public MhdState State { get; set; } = MhdState.Success;
    [Parameter] public string? Text { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string BuildDotClass() => State switch
    {
        MhdState.Success => "mhd-status-dot mhd-status-dot-success",
        MhdState.Danger => "mhd-status-dot mhd-status-dot-danger",
        MhdState.Warning => "mhd-status-dot mhd-status-dot-warning",
        MhdState.Info => "mhd-status-dot mhd-status-dot-info",
        MhdState.Primary => "mhd-status-dot mhd-status-dot-primary",
        _ => "mhd-status-dot mhd-status-dot-neutral"
    };
}
