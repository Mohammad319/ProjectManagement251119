@inherits LayoutComponentBase

<div class="@BuildClasses()">
    @if (!string.IsNullOrWhiteSpace(Title))
    {
        <div class="@($"{BasePadding} border-b border-gray-200 dark:border-gray-700 text-sm font-medium text-gray-800 dark:text-gray-200")">
            @Title
        </div>
    }

    @if (Header is not null)
    {
        <div class="@($"{BasePadding} border-b border-gray-200 dark:border-gray-700")">
            @Header
        </div>
    }

    <div class="@BasePadding">
        @ChildContent
    </div>

    @if (Footer is not null)
    {
        <div class="@($"{BasePadding} border-t border-gray-200 dark:border-gray-700")">
            @Footer
        </div>
    }
</div>

@code {
    public enum CardInteractionMode
    {
        None,
        HoverOnly,
        RippleOnly,
        HoverAndRipple
    }

    [Parameter] public string? Title { get; set; }
    [Parameter] public RenderFragment? Header { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public string? Class { get; set; }

    // لم نعد نحتاج OnClick هنا داخل الفورم
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public CardInteractionMode Interaction { get; set; } = CardInteractionMode.None;
    [Parameter] public bool Elevated { get; set; } = false;
    [Parameter] public bool Compact { get; set; } = false;

    private string BasePadding => Compact ? "px-2 py-1.5" : "px-3 py-2";

    private string BuildClasses()
    {
        var cls = new List<string>
        {
            "rounded-lg border border-gray-200 dark:border-gray-700",
            "bg-white dark:bg-gray-800",
            "transition-all duration-150",
            "overflow-hidden"
        };

        if (Elevated)
            cls.Add("shadow-sm");

        if (Interaction == CardInteractionMode.HoverOnly ||
            Interaction == CardInteractionMode.HoverAndRipple)
        {
            cls.Add("hover:shadow-md");
            cls.Add("hover:border-slate-300 dark:hover:border-slate-600");
            cls.Add("hover:bg-slate-50 dark:hover:bg-slate-800/80");
            cls.Add("hover:-translate-y-[1px]");
            cls.Add("transition-all duration-150 ease-in-out");
        }


        if (!string.IsNullOrWhiteSpace(Class))
            cls.Add(Class);

        return string.Join(" ", cls);
    }
}
