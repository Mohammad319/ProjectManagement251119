@using BlazorMHD.UI.Core.DesignSystem
@inject IDesignSystemService Design

<span class="@BuildClass()"
      @attributes="FilteredAttributes">
    @if (Icon != null)
    {
        <span class="mhd-tag-icon">
            @Icon
        </span>
    }
    @ChildContent
</span>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Icon { get; set; }

    [Parameter] public MhdState State { get; set; } = MhdState.Neutral;
    [Parameter] public MhdSize Size { get; set; } = MhdSize.Xs;

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private IReadOnlyDictionary<string, object>? FilteredAttributes =>
        AdditionalAttributes?
            .Where(kv => !string.Equals(kv.Key, "class", StringComparison.OrdinalIgnoreCase))
            .ToDictionary(kv => kv.Key, kv => kv.Value);

    private string BuildClass()
    {
        var cls = Design.GetTagClass(State, Size);

        if (AdditionalAttributes != null &&
            AdditionalAttributes.TryGetValue("class", out var clsObj) &&
            clsObj is string extra &&
            !string.IsNullOrWhiteSpace(extra))
        {
            cls += " " + extra;
        }

        return cls;
    }
}
