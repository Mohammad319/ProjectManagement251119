@using BlazorMHD.UI.Shared
@using Microsoft.AspNetCore.Components.Web.Virtualization
@attribute [CascadingTypeParameter(nameof(TItem))]
@typeparam TItem

@if (ShowFilter)
{
    <input value="@filterText"
           @oninput="OnFilterChanged"
           placeholder="@Localization.Get("SearchPlaceholder")"
           aria-label="@Localization.Get("SearchPlaceholder")"
           class="block w-full px-2 py-1 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 bg-white text-gray-800 dark:bg-gray-800 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 mb-2" />
}

<CascadingValue Value="this">
    @ChildContent
</CascadingValue>

<table class="@TableClass"
       aria-label="@EffectiveAriaLabel"
       dir="@EffectiveDirection">
    <thead class="@Thead">
        <tr>
            @if (HeaderTemplate != null)
            {
                @HeaderTemplate
            }
            else
            {
                @foreach (var col in _visibleColumns)
                {
                    <th class="@($"{TH} {col.HeaderClass}")" scope="col" aria-sort="@GetAriaSort(col)">
                        @if (col.Sortable)
                        {
                            <button type="button"
                                    class="inline-flex items-center gap-1 hover:text-slate-900 dark:hover:text-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded px-0.5"
                                    @onclick="() => ToggleSort(col)"
                                    aria-label="@GetSortAriaLabel(col)">
                                <span class="truncate">@col.Title</span>
                                @if (_currentSortColumn == col)
                                {
                                    <span aria-hidden="true">@(_sortAscending ? "↑" : "↓")</span>
                                }
                            </button>
                        }
                        else
                        {
                            <span class="truncate">@col.Title</span>
                        }
                    </th>
                }
            }
        </tr>
    </thead>

    <tbody class="@TBody">
        @if (IsLoading)
        {
            <tr>
                <td colspan="@Math.Max(1, _visibleColumns.Count)">
                    <div class="py-2 text-sm text-slate-500 dark:text-slate-400">@Localization.Get("Loading")...</div>
                </td>
            </tr>
        }
        else if (!_filteredAndSorted.Any())
        {
            <tr>
                <td colspan="@Math.Max(1, _visibleColumns.Count)">
                    <div class="py-2 text-sm text-slate-500 dark:text-slate-400">@Localization.Get("NoData")</div>
                </td>
            </tr>
        }
        else
        {
            @if (EnableVirtualization)
            {
                <Virtualize Items="_filteredAndSorted" Context="item" ItemSize="34">
                    <tr @onclick="() => OnRowClick.InvokeAsync(item)"
                        @key="GetRowKey(item)"
                        class="@GetRowClass(item)">
                        @foreach (var col in _visibleColumns)
                        {
                            <td class="@GetCellClass(item, col)">
                                @if (col.Template != null)
                                {
                                    @col.Template(item)
                                }
                                else if (col.ValueSelector != null)
                                {
                                    @col.ValueSelector(item)
                                }
                            </td>
                        }
                    </tr>
                </Virtualize>
            }
            else
            {
                @foreach (var item in _pagedItems)
                {
                    <tr @onclick="() => OnRowClick.InvokeAsync(item)"
                        @key="GetRowKey(item)"
                        class="@GetRowClass(item)">
                        @foreach (var col in _visibleColumns)
                        {
                            <td class="@GetCellClass(item, col)">
                                @if (col.Template != null)
                                {
                                    @col.Template(item)
                                }
                                else if (col.ValueSelector != null)
                                {
                                    @col.ValueSelector(item)
                                }
                            </td>
                        }
                    </tr>
                }
            }
        }
    </tbody>
</table>

@if (FooterTemplate != null)
{
    @FooterTemplate
}

@if (EnablePaging && !EnableVirtualization && _filteredAndSorted.Any())
{
    <div class="flex items-center justify-between gap-2 mt-2 text-xs text-slate-600 dark:text-slate-300">
        <div class="flex items-center gap-1">
            <button class="inline-flex items-center px-2 py-1 rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-950 hover:bg-slate-50 dark:hover:bg-slate-800 disabled:opacity-50 disabled:cursor-not-allowed"
                    @onclick="PrevPage"
                    disabled="@(_currentPage == 1)">
                @Localization.Get("Prev")
            </button>
            <button class="inline-flex items-center px-2 py-1 rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-950 hover:bg-slate-50 dark:hover:bg-slate-800 disabled:opacity-50 disabled:cursor-not-allowed"
                    @onclick="NextPage"
                    disabled="@(_currentPage >= TotalPages)">
                @Localization.Get("Next")
            </button>
        </div>

        <div>
            @Localization.Get("Page") @_currentPage @Localization.Get("Of") @TotalPages
        </div>

        <div class="flex items-center gap-1">
            <span class="text-slate-500 dark:text-slate-400">@Localization.Get("RowsPerPage")</span>
            <select value="@PageSize"
                    @onchange="OnPageSizeChanged"
                    class="bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-md px-1.5 py-0.5">
                @foreach (var size in PageSizes)
                {
                    <option value="@size">@size</option>
                }
            </select>
        </div>
    </div>
}

@code {
    [Parameter] public IEnumerable<TItem>? Items { get; set; }
    [Parameter] public EventCallback<TItem> OnRowClick { get; set; }
    [Parameter] public string TableClass { get; set; } = "min-w-full divide-y divide-gray-200 dark:divide-gray-600";
    public const string Thead = "bg-gray-100 dark:bg-gray-700";
    public const string TH = "p-1 text-left text-sm font-semibold text-gray-700 dark:text-gray-200";
    public const string TBody = "divide-y divide-gray-100 hover:divide-gray-200 dark:divide-gray-700";

    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool ShowFilter { get; set; }
    [Parameter] public bool EnablePaging { get; set; }
    [Parameter] public bool EnableVirtualization { get; set; }
    [Parameter] public int InitialPageSize { get; set; } = 10;
    [Parameter] public RenderFragment? HeaderTemplate { get; set; }
    [Parameter] public RenderFragment? FooterTemplate { get; set; }
    [Parameter] public bool UseCurrentCultureDirection { get; set; } = true;
    [Parameter] public string? TableAriaLabel { get; set; }

    [Parameter]
    public Dictionary<string, string> Localization { get; set; } = new()
    {
        ["SearchPlaceholder"] = "Search...",
        ["NoData"] = "No data available.",
        ["Loading"] = "Loading",
        ["Prev"] = "Prev",
        ["Next"] = "Next",
        ["Page"] = "Page",
        ["Of"] = "of",
        ["RowsPerPage"] = "Rows per page",
        ["SortAsc"] = "Sort ascending",
        ["SortDesc"] = "Sort descending",
        ["Table"] = "Table"
    };

    [Parameter] public Func<TItem, string>? RowClassSelector { get; set; }
    [Parameter] public Func<TItem, ColumnDefinition<TItem>, string>? CellClassSelector { get; set; }
    [Parameter] public Func<TItem, object?>? RowKeySelector { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public List<int> PageSizes { get; set; } = new() { 10, 25, 50 };

    private string filterText = string.Empty;
    private bool _sortAscending = true;
    private ColumnDefinition<TItem>? _currentSortColumn;
    private int _currentPage = 1;
    private int PageSize;

    private List<TItem> _filteredAndSorted = new();
    private List<TItem> _pagedItems = new();
    private List<ColumnDefinition<TItem>> _visibleColumns = new();

    internal List<ColumnDefinition<TItem>> Columns { get; set; } = new();

    private string EffectiveDirection => LocaliztionExtensions.GetDirection(UseCurrentCultureDirection);
    private string EffectiveAriaLabel => TableAriaLabel ?? Localization.Get("Table");

    protected override void OnInitialized()
    {
        PageSize = InitialPageSize;
    }

    protected override void OnParametersSet()
    {
        RebuildView();
    }

    internal void RegisterColumn(ColumnDefinition<TItem> column)
    {
        column.SortKeySelector ??= column.ValueSelector;
        Columns.Add(column);
        RebuildView();
    }

    private void OnFilterChanged(ChangeEventArgs e)
    {
        filterText = e.Value?.ToString() ?? string.Empty;
        _currentPage = 1;
        RebuildView();
    }

    private void ToggleSort(ColumnDefinition<TItem> col)
    {
        if (!col.Sortable || col.SortKeySelector == null)
            return;

        if (_currentSortColumn == col)
            _sortAscending = !_sortAscending;
        else
        {
            _currentSortColumn = col;
            _sortAscending = true;
        }

        RebuildView();
    }

    private void RebuildView()
    {
        _visibleColumns = Columns
            .Where(c => c.Visible)
            .OrderBy(c => c.Order)
            .ToList();

        var query = Items ?? Enumerable.Empty<TItem>();

        if (!string.IsNullOrWhiteSpace(filterText))
        {
            var needle = filterText.Trim();
            var searchableColumns = _visibleColumns.Where(c => c.Searchable && c.ValueSelector != null).ToList();

            if (searchableColumns.Any())
            {
                query = query.Where(item =>
                    searchableColumns.Any(col =>
                        col.ValueSelector?.Invoke(item)?.ToString()?.Contains(needle, StringComparison.OrdinalIgnoreCase) == true));
            }
        }

        if (_currentSortColumn?.SortKeySelector != null)
        {
            query = _sortAscending
                ? query.OrderBy(_currentSortColumn.SortKeySelector)
                : query.OrderByDescending(_currentSortColumn.SortKeySelector);
        }

        _filteredAndSorted = query.ToList();

        if (!EnablePaging || EnableVirtualization)
        {
            _pagedItems = _filteredAndSorted;
            return;
        }

        var totalPages = TotalPages;
        _currentPage = Math.Clamp(_currentPage, 1, Math.Max(1, totalPages));

        _pagedItems = _filteredAndSorted
            .Skip((_currentPage - 1) * PageSize)
            .Take(PageSize)
            .ToList();
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var newSize) && newSize > 0)
        {
            PageSize = newSize;
            _currentPage = 1;
            RebuildView();
            await InvokeAsync(StateHasChanged);
        }
    }

    private int TotalPages
    {
        get
        {
            if (_filteredAndSorted.Count == 0)
                return 1;

            return (int)Math.Ceiling(_filteredAndSorted.Count / (double)Math.Max(PageSize, 1));
        }
    }

    private void PrevPage()
    {
        if (_currentPage <= 1)
            return;

        _currentPage--;
        RebuildView();
    }

    private void NextPage()
    {
        if (_currentPage >= TotalPages)
            return;

        _currentPage++;
        RebuildView();
    }

    private string GetAriaSort(ColumnDefinition<TItem> col)
    {
        if (!col.Sortable)
            return "none";

        if (_currentSortColumn != col)
            return "none";

        return _sortAscending ? "ascending" : "descending";
    }

    private string GetSortAriaLabel(ColumnDefinition<TItem> col)
    {
        var action = _currentSortColumn == col && _sortAscending
            ? Localization.Get("SortDesc")
            : Localization.Get("SortAsc");

        return $"{col.Title}. {action}";
    }

    private object? GetRowKey(TItem item) => RowKeySelector?.Invoke(item) ?? item;

    private string GetRowClass(TItem item)
        => RowClassSelector?.Invoke(item)
           ?? "p-1 hover:bg-gray-100 dark:hover:bg-gray-800";

    private string GetCellClass(TItem item, ColumnDefinition<TItem> col)
    {
        var byParam = CellClassSelector?.Invoke(item, col);
        if (!string.IsNullOrWhiteSpace(byParam))
            return byParam!;

        if (!string.IsNullOrWhiteSpace(col.CellClass))
            return col.CellClass!;

        return "p-1 text-sm text-gray-800 dark:text-gray-300";
    }

    public class ColumnDefinition<T>
    {
        public string? Title { get; set; }
        public Func<T, object?>? ValueSelector { get; set; }
        public RenderFragment<T>? Template { get; set; }
        public bool Sortable { get; set; }
        public Func<T, object?>? SortKeySelector { get; set; }
        public bool Visible { get; set; } = true;
        public bool Searchable { get; set; } = true;
        public int Order { get; set; } = int.MaxValue;
        public string? HeaderClass { get; set; }
        public string? CellClass { get; set; }
    }
}
