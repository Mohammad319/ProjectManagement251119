@typeparam TItem

@code {
    [CascadingParameter] public MhdTable<TItem>? ParentGrid { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public Func<TItem, object?>? ValueSelector { get; set; }
    [Parameter] public RenderFragment<TItem>? Template { get; set; }
    [Parameter] public bool Sortable { get; set; } = false;
    [Parameter] public Func<TItem, object?>? SortKeySelector { get; set; }
    [Parameter] public bool Visible { get; set; } = true;
    [Parameter] public int Order { get; set; } = int.MaxValue;

    protected override void OnInitialized()
    {
        if (ParentGrid == null)
        {
            throw new InvalidOperationException("Column must be used inside MHDGrid.");
        }

        ParentGrid.RegisterColumn(new MhdTable<TItem>.ColumnDefinition<TItem>
        {
            Title = Title,
            ValueSelector = ValueSelector,
            Template = Template,
            Sortable = Sortable,
            SortKeySelector = SortKeySelector,
            Visible = Visible,
            Order = Order
        });
    }
}
