@* FilterPanel.razor *@

<div class="@BuildWrapperClass()">
    <div class="mhd-filter-panel-header">
        <h3 class="mhd-filter-panel-title">
            @Title
        </h3>
        <button type="button"
                class="mhd-filter-panel-toggle"
                @onclick="Toggle">
            @(Collapsed ? "Show" : "Hide")
        </button>
    </div>

    @if (!Collapsed)
    {
        <div class="mhd-filter-panel-content">
            @ChildContent
        </div>

        @if (ShowFooter)
        {
            <div class="mhd-filter-panel-footer">
                <button type="button"
                        class="mhd-filter-panel-btn-secondary"
                        @onclick="OnResetClicked">
                    Reset
                </button>
                <button type="button"
                        class="mhd-filter-panel-btn-primary"
                        @onclick="OnApplyClicked">
                    Apply
                </button>
            </div>
        }
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = "Filters";
    [Parameter] public bool Collapsed { get; set; }
    [Parameter] public EventCallback<bool> CollapsedChanged { get; set; }
    [Parameter] public string? Class { get; set; }

    [Parameter] public bool ShowFooter { get; set; } = true;

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public EventCallback OnApply { get; set; }
    [Parameter] public EventCallback OnReset { get; set; }

    private async Task Toggle()
    {
        Collapsed = !Collapsed;
        await CollapsedChanged.InvokeAsync(Collapsed);
    }

    private Task OnApplyClicked() =>
        OnApply.HasDelegate ? OnApply.InvokeAsync() : Task.CompletedTask;

    private Task OnResetClicked() =>
        OnReset.HasDelegate ? OnReset.InvokeAsync() : Task.CompletedTask;

    private string BuildWrapperClass()
        => string.IsNullOrWhiteSpace(Class) ? "mhd-filter-panel" : $"mhd-filter-panel {Class}";
}
