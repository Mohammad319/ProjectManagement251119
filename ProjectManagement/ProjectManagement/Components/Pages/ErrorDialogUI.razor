@using Microsoft.AspNetCore.Components
@using ProjectManagement.Shared
@inject DialogService DialogService

<div class="p-4">
    <h3 class="text-lg font-semibold mb-2 dark:text-white">@DialogTitle</h3>

    <p class="text-sm text-slate-700 dark:text-slate-200 whitespace-pre-line">
        @DialogMessage
    </p>

    @if (!string.IsNullOrWhiteSpace(TraceId))
    {
        <div class="mt-3 text-xs text-slate-500 dark:text-slate-400">
            @PMWebResource.TraceIdLabel: <span class="font-mono">@TraceId</span>
        </div>
    }

    <div class="mt-5 flex justify-end gap-2">
        <button class="px-4 py-2 rounded bg-slate-200 dark:bg-slate-700 dark:text-white"
                @onclick="Close">
            @PMWebResource.Close
        </button>
    </div>
</div>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Message { get; set; }
    [Parameter] public string? TraceId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string DialogTitle => string.IsNullOrWhiteSpace(Title) ? PMWebResource.UiErrorTitle : Title;
    private string DialogMessage => string.IsNullOrWhiteSpace(Message) ? PMWebResource.UiErrorMessage : Message;

    private async Task Close()
    {
        if (OnClose.HasDelegate)
            await OnClose.InvokeAsync();

        DialogService.Close();
    }
}
