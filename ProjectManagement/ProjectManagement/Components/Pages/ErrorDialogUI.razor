@using Microsoft.AspNetCore.Components

<div class="p-4">
    <h3 class="text-lg font-semibold mb-2 dark:text-white">@Title</h3>

    <p class="text-sm text-slate-700 dark:text-slate-200 whitespace-pre-line">
        @Message
    </p>

    @if (!string.IsNullOrWhiteSpace(TraceId))
    {
        <div class="mt-3 text-xs text-slate-500 dark:text-slate-400">
            TraceId: <span class="font-mono">@TraceId</span>
        </div>
    }

    <div class="mt-5 flex justify-end gap-2">
        <button class="px-4 py-2 rounded bg-slate-200 dark:bg-slate-700 dark:text-white"
                @onclick="Close">
            إغلاق
        </button>
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "حدث خطأ";
    [Parameter] public string Message { get; set; } = "حدث خطأ غير متوقع.";
    [Parameter] public string? TraceId { get; set; }

    // إذا DialogService عندك يحتاج طريقة إغلاق معينة (مثل CascadingParameter/DialogRef)
    // عدّل Close حسب مكتبتك.
    [Parameter] public EventCallback OnClose { get; set; }

    private async Task Close()
    {
        if (OnClose.HasDelegate)
            await OnClose.InvokeAsync();
    }
}
