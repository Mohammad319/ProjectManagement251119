@page "/not-found"
@layout MainLayout
@using ProjectManagement.Shared

<div class="mx-auto max-w-3xl px-6 py-12">
    <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm dark:border-slate-700 dark:bg-slate-800">
        <h1 class="text-2xl font-semibold text-slate-900 dark:text-slate-100">@PMWebResource.PageNotFoundTitle</h1>
        <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">@PMWebResource.PageNotFoundMessage</p>
    </div>
</div>
