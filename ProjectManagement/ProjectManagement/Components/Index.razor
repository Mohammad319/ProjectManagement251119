@page "/"
@using ContextMenuMHD
@using Microsoft.AspNetCore.Authorization
@using ProjectManagement.Client.Pages.Folder
@attribute [Authorize]
@using ProjectManagement.Components.Layout
<style>
    .mainContainer {
    }

    .sidebar2 {
        height: 100%;
        z-index: 1;
        overflow-x: hidden;
        margin-top: 50px;
        width: 20px;
    }

    .flex-container {
        display: flex;
        height: calc(100vh - 37px);
        overflow: auto;
    }

    .sidebar1 {
        flex-grow: 0;
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
    }

    .b {
        flex-grow: 0;
        flex-shrink: 0;
        flex-basis: 3px;
        background-color: lightgray;
        cursor: ew-resize;
        transition: background-color 1s,width 2s;
    }

        .b:hover {
            background-color: darkgray;
        }

    .contentContainer {
        overflow: auto;
        width: 100%;
        height: 100%;
    }
</style>

