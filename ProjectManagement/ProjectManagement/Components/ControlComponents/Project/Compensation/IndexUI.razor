@using BlazorMHD.UI.Components.Data.Table
@using Domain.Entities.Project
@using ProjectManagement.Client.Shared.Model.Project
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject ICommandDispatcher MicroBus
@inject ContextMenuService ContextService
@inject MhdServices MHD
@inject IStringLocalizer<ResourceApp> AppLoc

@if (IsLoading)
{
    <BlazorMHD.UI.Components.Feedback.Loading.MhdLoading />
}
else
{
    <div class="space-y-3">
        <div class="pm-toolbar">
            <div class="flex items-center gap-2">
                <button @onclick="CreateForm"
                        class="pm-btn pm-btn-success"
                        title="@AppLoc[LocalizerConst.New, CalcResource.projectCompensation]"
                        aria-label="@AppLoc[LocalizerConst.New, CalcResource.projectCompensation]">
                    <span class="flex items-center gap-1.5">
                        @Icons.Plus2
                        <span>@AppLoc[LocalizerConst.New, CalcResource.projectCompensation]</span>
                    </span>
                </button>
                <button @onclick="ToggleVisibleFilter"
                        class="pm-icon-btn"
                        title="@AppLoc[nameof(ResourceApp.isVisible)]"
                        aria-label="@AppLoc[nameof(ResourceApp.isVisible)]">
                    @((MarkupString)Icons.GetVisibleIcon(IsVisible))
                </button>
            </div>
            @if (FilteredCompensationList.Count > 0)
            {
                <span class="pm-subtitle">@FilteredCompensationList.Count</span>
            }
        </div>

        @if (FilteredCompensationList.Count > 0)
        {
            <div class="pm-table-wrap">
                <MhdTable Items="FilteredCompensationList" ShowFilter="false">
                    <HeaderTemplate>
                        <th style="width:80px;"></th>
                        <th></th>
                    </HeaderTemplate>
                    <ChildContent>
                        <MhdTableColumn>
                            <Template Context="item">
                                <div class="flex items-center gap-2 py-2">
                                    <button @onclick="() => UpdateForm(item)"
                                            class="inline-flex h-7 w-7 items-center justify-center rounded-md border border-amber-300 bg-amber-50 text-amber-600 transition hover:bg-amber-100 dark:border-amber-700 dark:bg-amber-900/30 dark:text-amber-300 dark:hover:bg-amber-900/50"
                                            title="@AppLoc[LocalizerConst.Update, item.Name]"
                                            aria-label="@AppLoc[LocalizerConst.Update, item.Name]">
                                        @Icons.Edit
                                    </button>
                                    <button @onclick="() => Remove(item)"
                                            class="inline-flex h-7 w-7 items-center justify-center rounded-md border border-red-300 bg-red-50 text-red-600 transition hover:bg-red-100 dark:border-red-700 dark:bg-red-900/30 dark:text-red-300 dark:hover:bg-red-900/50"
                                            title="@AppLoc[nameof(ResourceApp.delete)]"
                                            aria-label="@AppLoc[nameof(ResourceApp.delete)]">
                                        @((MarkupString)Icons.DeleteSVG)
                                    </button>
                                </div>
                            </Template>
                        </MhdTableColumn>
                        <MhdTableColumn Title="@CalcResource.name">
                            <Template Context="item">
                                <div class="flex items-center gap-2 py-2">
                                    <span style="background-color:@item.Color"
                                          class="inline-block h-3.5 w-3.5 shrink-0 rounded-full border border-slate-200 dark:border-slate-700"></span>
                                    <span class="text-sm text-slate-800 dark:text-slate-100">@item.Name</span>
                                </div>
                            </Template>
                        </MhdTableColumn>
                    </ChildContent>
                </MhdTable>
            </div>
        }
        else
        {
            <div class="pm-empty">@AppLoc[nameof(ResourceApp.ThereAreNoItemsToDisplay)]</div>
        }
    </div>
}
