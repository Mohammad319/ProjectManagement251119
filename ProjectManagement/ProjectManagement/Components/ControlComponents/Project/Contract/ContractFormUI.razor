@using ProjectManagement.Client.Shared.Model.Project
@using ProjectManagement.Shared.DTO.Project
@using ProjectManagement.Shared.Base.Project
@inject ICommandDispatcher MicroBus
@inject ContextMenuService ContextService
@inject MhdServices MHD
@inject IStringLocalizer<ResourceApp> AppLoc

<EditForm id="contractForm"
          class="px-3 pt-3 pb-1"
          Model="@UpdateObj"
          OnValidSubmit="HandleSubmitAsync">
    <DataAnnotationsValidator />

    <div class="flex flex-wrap items-end gap-3">
        <div class="flex min-w-[180px] flex-1 flex-col gap-1">
            <label class="pm-label">@CalcResource.name</label>
            <InputText class="pm-input" @bind-Value="@UpdateObj.Name" />
            <ValidationMessage For="@(() => UpdateObj.Name)" class="text-xs text-rose-600 dark:text-rose-400" />
        </div>

        <div class="flex w-20 flex-col gap-1">
            <label class="pm-label">@ResourceLoc.color</label>
            <InputText type="color"
                       class="h-9 w-full rounded-lg border border-slate-300 bg-white p-1 shadow-sm dark:border-slate-700 dark:bg-slate-950"
                       @bind-Value="@UpdateObj.Color" />
        </div>

        <label for="contractVisible"
               class="flex h-9 cursor-pointer items-center gap-2 rounded-lg border border-slate-200 bg-slate-50 px-3 dark:border-slate-700 dark:bg-slate-800/50">
            <InputCheckbox id="contractVisible"
                           class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 dark:border-slate-600 dark:bg-slate-900"
                           @bind-Value="@UpdateObj.IsVisible" />
            <span class="pm-label">@ResourceApp.isVisible</span>
        </label>
    </div>
</EditForm>

<div class="flex items-center justify-end gap-2 border-t border-slate-200 px-3 py-2 dark:border-slate-700">
    <button type="button" class="pm-btn pm-btn-neutral" @onclick="Close">@ResourceApp.cancel</button>
    <button type="submit" class="pm-btn pm-btn-success" form="contractForm" disabled="@IsLoading">@ResourceApp.save</button>
</div>
