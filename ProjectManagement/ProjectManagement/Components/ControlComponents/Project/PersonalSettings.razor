@using ProjectManagement.Components.Account.Pages
@using ProjectManagement.Components.Account.Pages.Manage
@using ProjectManagement.Components.Account.Pages.Manage.Legal
@using ProjectManagement.Shared
@inject ICommandDispatcher MicroBus
@inject ContextMenuService ContextService
@inject MhdServices MHD
@inject IStringLocalizer<ResourceApp> AppLoc
<div class="@CssClasses.Modal.Body">
    <div class="max-h-[90vh] flex flex-row bg-gray-50 dark:bg-gray-900">
        <nav class="w-64 h-full bg-gray-100 dark:bg-gray-800 p-0 shadow-md" aria-label="Settings menu">
        <ul class="flex flex-col space-y-1 m-0 p-0 list-none">
            <li role="button" @onclick="() => SelectedPage = PageSetting.ChangePassword" class="@GetItemClass(PageSetting.ChangePassword)">
                    <span>@PMResourceIdentity.changePassword</span>
            </li>
            <li role="button" @onclick="() => SelectedPage = PageSetting.Impressum" class="@GetItemClass(PageSetting.Impressum)">
                <span>Impressum</span>
            </li>
            <li role="button" @onclick="() => SelectedPage = PageSetting.Privacy" class="@GetItemClass(PageSetting.Privacy)">
                    <span>@PMAppFormatResource.TabPrivacy</span>
            </li>
            <li role="button" @onclick="() => SelectedPage = PageSetting.Terms" class="@GetItemClass(PageSetting.Terms)">
                    <span>@PMAppFormatResource.TabTerms</span>
            </li>
            <li role="button" @onclick="() => SelectedPage = PageSetting.Licenses" class="@GetItemClass(PageSetting.Licenses)">
                    <span>@PMAppFormatResource.TabLicenses</span>
            </li>
        </ul>
    </nav>

    <div class="flex-1 p-1 overflow-auto">
        @if (SelectedPage == PageSetting.ChangePassword)
        {
             <ChangePassword></ChangePassword>  
        }
        else if (SelectedPage == PageSetting.Language)
        {
            @* <CultureSelector></CultureSelector> *@
        }
        else if (SelectedPage == PageSetting.Impressum)
        {
            <div>
                <ProjectManagement.Components.Account.Pages.Manage.Legal.ImpressumUI></ProjectManagement.Components.Account.Pages.Manage.Legal.ImpressumUI>
            </div>
        }
        else if (SelectedPage == PageSetting.Privacy)
        {
            <div>
                    <h2>@PMAppFormatResource.TabPrivacy</h2>
                    <p>@PMAppFormatResource.PrivacyContent</p>
            </div>
        }
        else if (SelectedPage == PageSetting.Terms)
        {
            <div>
                    <p>@((MarkupString)PMAppFormatResource.TermsContent.Replace("\n", "<br />"))</p>
            </div>
        }
        else if (SelectedPage == PageSetting.Licenses)
        {
            <div>
                <ThirdPartyLicenses></ThirdPartyLicenses>
            </div>
        }
    </div>
</div>
</div>
@code {
    private string GetItemClass(PageSetting page)
    {
        if (SelectedPage == page)
        {
            return "px-4 py-2 rounded text-left transition cursor-pointer bg-blue-500 text-white";
        }
        else
        {
            return "px-4 py-2 rounded text-left transition cursor-pointer bg-white dark:bg-gray-700 text-gray-800 dark:text-gray-100 hover:bg-gray-200 dark:hover:bg-gray-700";
        }
    }
}

@code {
    [Parameter] public EventCallback CallBack { get; set; }
    PageSetting SelectedPage;


    enum PageSetting
    {
        ChangePassword, Language, Impressum,
        Privacy, Terms, Licenses
    }
}