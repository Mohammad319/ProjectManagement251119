@using ProjectManagement.Components.Account.Pages.Manage
@using ProjectManagement.Components.Account.Pages.Manage.Legal
@using ProjectManagement.Shared

<div class="@CssClasses.Modal.Body">
    <div class="flex max-h-[90vh] flex-col overflow-hidden rounded-2xl border border-slate-200 bg-slate-50 shadow-sm dark:border-slate-700 dark:bg-slate-900 md:flex-row">
        <nav class="w-full border-b border-slate-200 bg-white p-2 dark:border-slate-700 dark:bg-slate-800 md:w-64 md:border-b-0 md:border-r"
             aria-label="@PMWebResource.SettingsMenu">
            <ul class="m-0 flex list-none flex-col gap-1 p-0">
                <li role="button" @onclick="() => SelectedPage = PageSetting.ChangePassword" class="@GetItemClass(PageSetting.ChangePassword)">
                    <span>@PMResourceIdentity.changePassword</span>
                </li>
                <li role="button" @onclick="() => SelectedPage = PageSetting.Impressum" class="@GetItemClass(PageSetting.Impressum)">
                    <span>Impressum</span>
                </li>
                <li role="button" @onclick="() => SelectedPage = PageSetting.Privacy" class="@GetItemClass(PageSetting.Privacy)">
                    <span>@PMAppFormatResource.TabPrivacy</span>
                </li>
                <li role="button" @onclick="() => SelectedPage = PageSetting.Terms" class="@GetItemClass(PageSetting.Terms)">
                    <span>@PMAppFormatResource.TabTerms</span>
                </li>
                <li role="button" @onclick="() => SelectedPage = PageSetting.Licenses" class="@GetItemClass(PageSetting.Licenses)">
                    <span>@PMAppFormatResource.TabLicenses</span>
                </li>
            </ul>
        </nav>

        <div class="flex-1 overflow-auto p-4 md:p-6">
            @if (SelectedPage == PageSetting.ChangePassword)
            {
                <ChangePassword />
            }
            else if (SelectedPage == PageSetting.Impressum)
            {
                <div class="rounded-xl bg-white p-4 shadow-sm dark:bg-slate-800">
                    <ImpressumUI />
                </div>
            }
            else if (SelectedPage == PageSetting.Privacy)
            {
                <div class="rounded-xl bg-white p-4 shadow-sm dark:bg-slate-800">
                    <h2 class="text-lg font-semibold">@PMAppFormatResource.TabPrivacy</h2>
                    <p class="mt-3 whitespace-pre-line text-sm text-slate-700 dark:text-slate-200">@PMAppFormatResource.PrivacyContent</p>
                </div>
            }
            else if (SelectedPage == PageSetting.Terms)
            {
                <div class="rounded-xl bg-white p-4 shadow-sm dark:bg-slate-800">
                    <h2 class="text-lg font-semibold">@PMAppFormatResource.TabTerms</h2>
                    <p class="mt-3 whitespace-pre-line text-sm text-slate-700 dark:text-slate-200">@PMAppFormatResource.TermsContent</p>
                </div>
            }
            else if (SelectedPage == PageSetting.Licenses)
            {
                <div class="rounded-xl bg-white p-4 shadow-sm dark:bg-slate-800">
                    <ThirdPartyLicenses />
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback CallBack { get; set; }

    private PageSetting SelectedPage { get; set; } = PageSetting.ChangePassword;

    private string GetItemClass(PageSetting page)
    {
        return SelectedPage == page
            ? "rounded-lg px-4 py-2 text-left transition cursor-pointer bg-blue-600 text-white"
            : "rounded-lg px-4 py-2 text-left transition cursor-pointer text-slate-800 hover:bg-slate-100 dark:text-slate-100 dark:hover:bg-slate-700";
    }

    private enum PageSetting
    {
        ChangePassword,
        Impressum,
        Privacy,
        Terms,
        Licenses
    }
}
