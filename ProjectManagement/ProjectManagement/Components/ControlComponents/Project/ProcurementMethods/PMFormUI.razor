@using ProjectManagement.Client.Shared.Model.Project
@using ProjectManagement.Shared.DTO.Project
@using ProjectManagement.Shared.Base.Project
@inject ICommandDispatcher MicroBus
@inject ContextMenuService ContextService
@inject MhdServices MHD
@inject IStringLocalizer<ResourceApp> AppLoc

<EditForm id="procurementForm"
          class="@CssClasses.Modal.Body"
          Model="@ProcurementUpdate"
          OnValidSubmit="HandleSubmitAsync">
    <DataAnnotationsValidator />

    <div class="flex flex-wrap items-center gap-4">
        <div class="flex flex-col">
            <label class="@CssClasses.Form.Label">@CalcResource.name:</label>
            <InputText class="@CssClasses.Input.Text" @bind-Value="@ProcurementUpdate.Name" />
            <ValidationMessage For="@(() => ProcurementUpdate.Name)" />
        </div>

        <div class="@CssClasses.Form.CheckWrapperM">
            <InputCheckbox class="@CssClasses.Input.Check" type="checkbox" @bind-Value="@ProcurementUpdate.IsVisible" />
            <label class="@CssClasses.Form.Label">
                @ResourceApp.isVisible
            </label>
        </div>

        <div class="flex flex-col">
            <label class="@CssClasses.Form.Label">@ResourceLoc.color:</label>
            <InputText type="color" class="@CssClasses.Input.Color" @bind-Value="@ProcurementUpdate.Color" />
            <ValidationMessage For="@(() => ProcurementUpdate.Color)" />
        </div>
    </div>
</EditForm>

<div class="@CssClasses.Modal.Footer">
    <button type="submit" class="@CssClasses.Btn.Outline.Success" form="procurementForm" disabled="@IsLoading">
        @ResourceApp.save
    </button>
    <button type="button" class="@CssClasses.Btn.Outline.Secondary" @onclick="Close">
        @ResourceApp.cancel
    </button>
</div>
