@using BlazorMHD.UI.Components.Navigation.Tabs
@using BlazorMHD.UI.Core.Navigation

<MhdTabs Items="@Tabs" @bind-ActiveKey="activeKey" Size="MhdSize.Sm" />

@code {
    private string? activeKey;
    private List<MhdTabItem> Tabs = new();

    protected override void OnInitialized()
    {
        Tabs =
        [
            new MhdTabItem
            {
                Key = "type",
                Text = "Projekttyp",
                Content = @<ProjectManagement.Components.ControlComponents.Project.Type.IndexUI />
            },
            new MhdTabItem
            {
                Key = "contract",
                Text = "Entreprenadform",
                Content = @<ProjectManagement.Components.ControlComponents.Project.Contract.IndexUI />
            },
            new MhdTabItem
            {
                Key = "compensation",
                Text = "Ersättningsform",
                Content = @<ProjectManagement.Components.ControlComponents.Project.Compensation.IndexUI />
            },
            new MhdTabItem
            {
                Key = "procurement",
                Text = "Upphandlingsform",
                Content = @<ProjectManagement.Components.ControlComponents.Project.ProcurementMethods.IndexUI />
            },
            new MhdTabItem
            {
                Key = "procurement-procedure",
                Text = "Upphandlingsförfarande",
                Content = @<ProjectManagement.Components.ControlComponents.Project.ProcurementProcedure.IndexUI />
            },
            new MhdTabItem
            {
                Key = "project-status",
                Text = "Projektstatus / Upphandlingsstatus",
                Content = @<ProjectManagement.Components.ControlComponents.Project.ProjectStatus.IndexUI />
            },
            new MhdTabItem
            {
                Key = "calculation-status",
                Text = CalcResource.calculationStatus,
                Content = @<ProjectManagement.Components.ControlComponents.Project.Status.IndexUI />
            },
            new MhdTabItem
            {
                Key = "task-status",
                Text = ResourceLoc.taskStatus,
                Content = @<ProjectManagement.Components.ControlComponents.TaskStatus.IndexUI />
            },
            new MhdTabItem
            {
                Key = "resource-status",
                Text = CalcResource.resourcesStatus,
                Content = @<ProjectManagement.Components.ControlComponents.ResourceStatus.IndexUI />
            }
        ];

        if (string.IsNullOrWhiteSpace(activeKey) && Tabs.Count > 0)
            activeKey = Tabs[0].Key;
    }
}
