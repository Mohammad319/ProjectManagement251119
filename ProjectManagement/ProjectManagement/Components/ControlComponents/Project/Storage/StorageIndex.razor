@using Application.Feature.Calculation.Storage.Commands
@using ProjectManagement.Client.Pages.Project.Storage.Row
@using ProjectManagement.Services.UI
@using ProjectManagement.Shared.DTO.Calculation
@using ProjectManagement.Shared.DTO.Project;
@using ProjectManagement.Shared.Enums
@inherits AppComponentBase
@inject ICommandDispatcher MicroBus
@inject IStorageViewService StorageViewService
<div class="flex items-center gap-2 pb-1">
    <select class="form-select w-auto min-w-[140px] px-3 py-2 rounded-md border border-gray-300 dark:border-gray-600 dark:bg-gray-800 dark:text-white"
            @onchange="GetAuthorityStorage">
        <option value="@(AuthorityStorage._private)" selected>@ResourceApp._private</option>
        <option value="@(AuthorityStorage.department)">@ResourceApp.department</option>
        <option value="@(AuthorityStorage._public)">@ResourceApp._public</option>
    </select>

    <select class="form-select w-auto min-w-[140px] px-3 py-2 rounded-md border border-gray-300 dark:border-gray-600 dark:bg-gray-800 dark:text-white"
            @onchange="GetStorageSort">
        @foreach (StorageSort level in Enum.GetValues(typeof(StorageSort)))
        {
            <option value="@level">@ResourceLocalize.GetStorageSort(level)</option>
        }
    </select>

    <select class="form-select w-auto min-w-[140px] px-3 py-2 rounded-md border border-gray-300 dark:border-gray-600 dark:bg-gray-800 dark:text-white"
            @onchange="StorageTypeSet">
        <option value="@(CalculationItemType.task)">@ResourceLoc.task</option>
        <option value="@(CalculationItemType.resource)">@ResourceLoc.resource</option>
    </select>

    @if (BtnImportIsVisible)
    {
        <button class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-sky-300 bg-sky-50 text-sky-600 transition hover:bg-sky-100 dark:border-sky-700 dark:bg-sky-900/30 dark:text-sky-300 dark:hover:bg-sky-900/50"
                @onclick="GetAsync">
            @((MarkupString)Icons.ImportFromCloud)
        </button>
    }
</div>

<table class="min-w-full divide-y divide-slate-200 overflow-hidden rounded-lg border border-slate-200 text-sm dark:divide-slate-700 dark:border-slate-700">
    <HeaderStorageUI></HeaderStorageUI>
    <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
        @if (Post.Type == CalculationItemType.task && Tasks != null)
        {
            foreach (var storage in Tasks)
            {
                <TaskStorage Task="storage.StorageValue" WithContent="true">
                    <span role="button" @onclick="() => Remove(storage.Id, storage.StorageValue.Name)" class="text-red-600 hover:text-red-700 dark:text-red-300 dark:hover:text-red-200">@((MarkupString)Icons.Delete)</span>
                </TaskStorage>
            }
        }

        @if (Post.Type == CalculationItemType.resource && Resources != null)
        {
            foreach (var storage in Resources)
            {
                <ResourcesStorage Resource="storage.StorageValue">
                    <span role="button" @onclick="() => Remove(storage.Id, storage.StorageValue.Name)" class="text-red-600 hover:text-red-700 dark:text-red-300 dark:hover:text-red-200">@((MarkupString)Icons.Delete)</span>
                </ResourcesStorage>
            }
        }
    </tbody>
</table>

@code {
    private bool BtnImportIsVisible = true;
    private List<StorageDTO<TaskPostDTO>>? Tasks;
    private List<StorageDTO<ResourcePostDTO>>? Resources;
    private GetFilterDTO Post = new()
    {
        AuthoritySelected = AuthorityStorage._private,
        Type = CalculationItemType.task
    };

    protected override async Task OnInitializedAsync()
    {
        await GetAsync();
    }

    private void Remove(int id, string name) => MHD.DeleteMessage(name, EventCallback.Factory.Create(this, () => ConfirmRemoveAsync(id)));

    private async Task ConfirmRemoveAsync(int id)
    {
        var result = await MicroBus.Send(new DeleteStorageCommand(id));
        if (result)
        {
            if (Post.Type == CalculationItemType.task)
                Tasks?.RemoveAll(x => x.Id == id);
            else if (Post.Type == CalculationItemType.resource)
                Resources?.RemoveAll(x => x.Id == id);

            StateHasChanged();
        }

        MHD.Notifications(ToastType.Delete, result);
    }

    private async Task StorageTypeSet(ChangeEventArgs e)
    {
        Reset();
        if (Enum.TryParse<CalculationItemType>(e.Value?.ToString(), out var calculationItemType))
            Post.Type = calculationItemType;

        await GetAsync();
    }

    private void Reset()
    {
        Resources = null;
        Tasks = null;
    }

    private async Task GetAsync()
    {
        BtnImportIsVisible = false;

        if (Post.Type == CalculationItemType.task)
            Tasks = await StorageViewService.GetTasksAsync(Post);
        else if (Post.Type == CalculationItemType.resource)
            Resources = await StorageViewService.GetResourcesAsync(Post);
    }

    private async Task GetStorageSort(ChangeEventArgs e)
    {
        Reset();
        if (Enum.TryParse<StorageSort>(e.Value?.ToString(), out var storageSort))
            Post.SortSelected = storageSort;

        await GetAsync();
    }

    private async Task GetAuthorityStorage(ChangeEventArgs e)
    {
        Reset();
        if (Enum.TryParse<AuthorityStorage>(e.Value?.ToString(), out var authorityStorage))
            Post.AuthoritySelected = authorityStorage;

        await GetAsync();
    }
}
