@inherits AppComponentBase

<EditForm id="projectTypeForm" class="@CssClasses.Modal.Body" Model="@UpdateObj" OnValidSubmit="HandleSubmitAsync">
    <DataAnnotationsValidator />

    <div class="flex flex-wrap items-center gap-4">
        <div class="flex flex-col">
            <label class="@CssClasses.Form.Label">@CalcLoc[nameof(CalcResource.name)]</label>
            <InputText class="@CssClasses.Input.Text" @bind-Value="@UpdateObj.Name" />
            <ValidationMessage For="@(() => UpdateObj.Name)" />
        </div>

        <div class="@CssClasses.Form.CheckWrapperM">
            <InputCheckbox id="projectTypeVisible" class="@CssClasses.Input.Check" @bind-Value="@UpdateObj.IsVisible" />
            <label class="@CssClasses.Form.Label" for="projectTypeVisible">@AppLoc[nameof(ResourceApp.isVisible)]</label>
        </div>
    </div>
</EditForm>

<div class="@CssClasses.Modal.Footer">
    <button type="submit" class="@CssClasses.Btn.Outline.Success" form="projectTypeForm" disabled="@IsLoading">
        @AppLoc[nameof(ResourceApp.save)]
    </button>
    <button type="button" class="@CssClasses.Btn.Outline.Secondary" @onclick="CloseModal" disabled="@IsLoading">
        @AppLoc[nameof(ResourceApp.cancel)]
    </button>
</div>
