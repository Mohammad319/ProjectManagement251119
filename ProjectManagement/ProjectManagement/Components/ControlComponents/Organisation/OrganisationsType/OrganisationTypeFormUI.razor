@using Domain.DTO.Category

@inject MhdServices MHD

<EditForm id="orgTypeForm"
          class="@CssClasses.Modal.Body"
          Model="@EditModel"
          OnValidSubmit="SubmitAsync">

    <DataAnnotationsValidator />

    <div class="flex flex-wrap items-center gap-4">
        <div class="flex flex-col">
            <label class="@CssClasses.Form.Label">@CalcResource.name:</label>
            <InputText class="@CssClasses.Input.Text" @bind-Value="EditModel.Name" />
            <ValidationMessage For="@(() => EditModel.Name)" />
        </div>

        <div class="@CssClasses.Form.CheckWrapperM">
            <InputCheckbox class="@CssClasses.Input.Check" @bind-Value="EditModel.IsVisible" />
            <label class="@CssClasses.Form.CheckLabel">
                @ResourceApp.isVisible
            </label>
        </div>
    </div>
</EditForm>

<div class="@CssClasses.Modal.Footer">
    <button type="submit"
            class="@CssClasses.Btn.Outline.Success"
            form="orgTypeForm"
            disabled="@IsLoading">
        @ResourceApp.save
    </button>

    <button type="button"
            class="@CssClasses.Btn.Outline.Secondary"
            @onclick="Close">
        @ResourceApp.cancel
    </button>
</div>

@code {
    [Parameter] public bool IsLoading { get; set; }

    // الاسم بقي كما هو لتوافق استدعاء المودال عندك
    [Parameter] public ListOrganisationTypeDTO? CustomerGroup { get; set; }

    [Parameter] public EventCallback<ListOrganisationTypeDTO> OnValidSubmit { get; set; }

    private ListOrganisationTypeDTO EditModel = new();

    protected override void OnInitialized()
    {
        // OnParametersSet أفضل من OnInitialized لأن المودال ممكن يعيد تمرير باراميترات
        EditModel = new ListOrganisationTypeDTO();
        if (CustomerGroup is not null)
            PropertyCopier.CopyPropertiesTo(CustomerGroup, EditModel);
    }

    private async Task SubmitAsync()
    {
        if (IsLoading) return;
        await OnValidSubmit.InvokeAsync(EditModel);
    }

    private void Close()
        => MHD.Modal.Close();
}
