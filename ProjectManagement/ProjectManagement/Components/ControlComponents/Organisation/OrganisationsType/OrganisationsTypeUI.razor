@using BlazorMHD.UI.Components.Data.Table
@using ProjectManagement.Shared
@inherits OrganisationsTypeUiBase
@inject IStringLocalizer<PMWebResource> WebLoc

<div>
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-2">
            <button class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-emerald-300 bg-emerald-50 text-emerald-600 transition hover:bg-emerald-100 dark:border-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-300 dark:hover:bg-emerald-900/50"
                    @onclick="NewOrganisationType"
                    title="@WebLoc[nameof(PMWebResource.NewOrganisationType)]"
                    disabled="@IsLoading">
                @((MarkupString)Icons.Plus)
            </button>

            <button class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-slate-300 bg-white text-slate-600 transition hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
                    @onclick="ToggleVisibilityAsync"
                    title="@WebLoc[nameof(PMWebResource.ToggleVisibility)]"
                    disabled="@IsLoading">
                @((MarkupString)Icons.GetVisibleIcon(IsVisible))
            </button>
        </div>
    </div>

    @if (IsLoading)
    {
        <div class="py-2">
            <MhdLoading />
        </div>
    }
    else if (OrganisationTypes is null || OrganisationTypes.Count == 0)
    {
        <div class="rounded-xl border border-dashed border-slate-300 px-4 py-6 text-sm text-slate-600 dark:border-slate-700 dark:text-slate-300">
            @WebLoc[nameof(PMWebResource.NoOrganisationTypesFound)]
        </div>
    }
    else
    {
        <MhdTable Items="OrganisationTypes" ShowFilter="false">
            <HeaderTemplate>
                <th style="width:200px;" class="px-3 py-2 text-right text-sm font-semibold text-slate-600 dark:text-slate-200">@WebLoc[nameof(PMWebResource.Actions)]</th>
                <th class="px-3 py-2 text-right text-sm font-semibold text-slate-600 dark:text-slate-200">@CalcResource.name</th>
            </HeaderTemplate>
            <ChildContent>
                <MhdTableColumn>
                    <Template Context="status">
                        <div class="flex items-center gap-2">
                            <button @onclick="() => OpenEditModal(status)"
                                    class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-amber-300 bg-amber-50 text-amber-600 transition hover:bg-amber-100 dark:border-amber-700 dark:bg-amber-900/30 dark:text-amber-300 dark:hover:bg-amber-900/50"
                                    title="@AppLoc[nameof(ResourceApp.edit)]">
                                @Icons.Edit
                            </button>
                            <button @onclick="() => AskDelete(status)"
                                    class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-red-300 bg-red-50 text-red-600 transition hover:bg-red-100 dark:border-red-700 dark:bg-red-900/30 dark:text-red-300 dark:hover:bg-red-900/50"
                                    title="@AppLoc[nameof(ResourceApp.delete)]">
                                @((MarkupString)Icons.DeleteSVG)
                            </button>
                        </div>
                    </Template>
                </MhdTableColumn>
                <MhdTableColumn Title="" ValueSelector="c => c.Name"></MhdTableColumn>
            </ChildContent>
        </MhdTable>
    }
</div>
