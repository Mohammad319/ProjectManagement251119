@using BlazorMHD.UI.Components.Data.Table
@using ProjectManagement.Shared
@inherits OrganisationsTypeUiBase
@inject IStringLocalizer<PMWebResource> WebLoc

<div>
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
        <div>
            <div class="text-sm font-medium text-slate-900 dark:text-slate-100">@WebLoc[nameof(PMWebResource.OrganisationTypesTitle)]</div>
            <div class="text-sm text-slate-600 dark:text-slate-300">@WebLoc[nameof(PMWebResource.OrganisationTypesDescription)]</div>
        </div>

        <div class="flex items-center gap-2">
            <button class="@CssClasses.Btn.IconButton.Success"
                    @onclick="NewOrganisationType"
                    title="@WebLoc[nameof(PMWebResource.NewOrganisationType)]"
                    disabled="@IsLoading">
                @((MarkupString)Icons.Plus)
            </button>

            <button class="@CssClasses.Btn.IconButton.Secondary"
                    @onclick="ToggleVisibilityAsync"
                    title="@WebLoc[nameof(PMWebResource.ToggleVisibility)]"
                    disabled="@IsLoading">
                @((MarkupString)Icons.GetVisibleIcon(IsVisible))
            </button>
        </div>
    </div>

    @if (IsLoading)
    {
        <div class="py-2">
            <BlazorMHD.UI.Components.Feedback.Loading.MhdLoading />
        </div>
    }
    else if (OrganisationTypes is null || OrganisationTypes.Count == 0)
    {
        <div class="rounded-xl border border-dashed border-slate-300 px-4 py-6 text-sm text-slate-600 dark:border-slate-700 dark:text-slate-300">
            @WebLoc[nameof(PMWebResource.NoOrganisationTypesFound)]
        </div>
    }
    else
    {
        <MhdTable Items="OrganisationTypes" ShowFilter="false">
            <HeaderTemplate>
                <th style="width:200px;" class="@CssClasses.Table.TH">@WebLoc[nameof(PMWebResource.Actions)]</th>
                <th class="@CssClasses.Table.TH">@CalcResource.name</th>
            </HeaderTemplate>
            <ChildContent>
                <MhdTableColumn>
                    <Template Context="status">
                        <div class="@CssClasses.Layout.FlexItemsCenter">
                            <button @onclick="() => OpenEditModal(status)"
                                    class="@CssClasses.Btn.IconButton.Warning"
                                    title="@AppLoc[nameof(ResourceApp.edit)]">
                                @Icons.Edit
                            </button>
                            <button @onclick="() => AskDelete(status)"
                                    class="@CssClasses.Btn.IconButton.Danger"
                                    title="@AppLoc[nameof(ResourceApp.delete)]">
                                @((MarkupString)Icons.DeleteSVG)
                            </button>
                        </div>
                    </Template>
                </MhdTableColumn>
                <MhdTableColumn Title="" ValueSelector="c => c.Name"></MhdTableColumn>
            </ChildContent>
        </MhdTable>
    }
</div>
