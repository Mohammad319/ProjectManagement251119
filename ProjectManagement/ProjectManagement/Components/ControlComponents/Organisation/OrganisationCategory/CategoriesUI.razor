@using Domain.DTO.Category
@using Domain.Entities.Organisation
@using Microsoft.AspNetCore.Components.Authorization
@using ProjectManagement.Components.ControlComponents.Organisation.OrganisationsType
@using ProjectManagement.Shared
@inherits AppComponentBase
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IStringLocalizer<PMWebResource> WebLoc

<div class="grid gap-4 lg:grid-cols-[320px_minmax(0,1fr)]">
    <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
        <div class="mb-4 flex flex-wrap items-center gap-2">
            <AuthorizeView Roles="@PMRolesConst.Tenant.AdminSuperManger">
                <button @onclick="() => ModalForm(new ListOrganisationCategoryDTO())"
                        class="@CssClasses.Btn.IconButton.Success"
                        title="@WebLoc[nameof(PMWebResource.NewCategory)]">
                    @((MarkupString)Icons.Plus)
                </button>

                <button @onclick="OpenTypePage"
                        class="@CssClasses.Btn.Outline.Secondary"
                        title="@WebLoc[nameof(PMWebResource.OpenOrganisationTypes)]">
                    @FormatLoc[nameof(PMAppFormatResource.categoryType)]
                </button>
            </AuthorizeView>
        </div>

        @if (Categories.Count == 0)
        {
            <div class="rounded-xl border border-dashed border-slate-300 px-4 py-6 text-sm text-slate-600 dark:border-slate-700 dark:text-slate-300">
                @WebLoc[nameof(PMWebResource.NoOrganisationCategories)]
            </div>
        }
        else
        {
            <CategoryTree Categories="Categories"
                          SelectedId="SelectedCategory?.Id"
                          OnSelect="OnTreeSelect"
                          OnContext="OnTreeContext" />
        }
    </section>

    <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
        @if (PageNr == 1)
        {
            <div class="mb-4">
                <h3 class="text-base font-semibold text-slate-900 dark:text-slate-100">@WebLoc[nameof(PMWebResource.OrganisationTypesTitle)]</h3>
                <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">@WebLoc[nameof(PMWebResource.OrganisationTypesDescription)]</p>
            </div>
            <OrganisationsTypeUI />
        }
        else if (SelectedCategory is not null)
        {
            <div class="mb-4">
                <h3 class="text-base font-semibold text-slate-900 dark:text-slate-100">@SelectedCategory.Name</h3>
                <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">@WebLoc[nameof(PMWebResource.OrganisationsInCategoryDescription)]</p>
            </div>

            <OrganisationsUI Callback="OnOrganisationsClosed" Category="SelectedCategory" />
        }
        else
        {
            <div class="rounded-xl border border-dashed border-slate-300 px-4 py-8 text-sm text-slate-600 dark:border-slate-700 dark:text-slate-300">
                <div class="font-medium text-slate-900 dark:text-slate-100">@WebLoc[nameof(PMWebResource.OrganisationOverviewTitle)]</div>
                <div class="mt-1">@WebLoc[nameof(PMWebResource.SelectOrganisationCategoryHint)]</div>
            </div>
        }
    </section>
</div>
