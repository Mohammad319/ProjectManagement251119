@using Microsoft.AspNetCore.Components.Authorization
@using ProjectManagement.Components.ControlComponents.Department
@using ProjectManagement.Shared.Constant
@using ProjectManagement.Shared.DTO.Organisation
@inherits AppComponentBase

@* "Kunder & leverantörer" — fixed toolbar + sticky table header, only the rows scroll. *@
<div class="pm-admin-panel">

    <!-- Toolbar (ligger fast). relative: kolumnmenyn förankras i verktygsradens högerkant —
         knappens egen position varierar med radbrytning och kan hamna vid båda kanterna,
         så en knappförankrad meny kläms utanför innehållsytan (bakom sidomenyn/dialogkanten). -->
    <div class="relative shrink-0 rounded-xl border border-slate-200 bg-white px-2.5 py-1.5 shadow-sm dark:border-slate-800 dark:bg-slate-900">

        @* No overflow-x-auto here: the absolutely positioned dropdowns (filters, column menu)
           would turn it into a scroll container and show stray scrollbars. Wrap instead. *@
        <div class="flex w-full flex-wrap items-center gap-1.5">
            <AuthorizeView Roles="@PMRolesConst.Tenant.AdminManger">
                <button type="button"
                        class="inline-flex shrink-0 items-center justify-center gap-1.5 whitespace-nowrap rounded-lg bg-emerald-600 px-2.5 py-1.5 text-xs font-semibold text-white shadow-sm transition hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-500/40 dark:bg-emerald-500 dark:hover:bg-emerald-400"
                        title="Skapa en ny kund eller leverantör"
                        @onclick="OpenCreate">
                    @((MarkupString)Icons.PlusSVG)
                    <span>Ny kund/leverantör</span>
                </button>

                <button type="button"
                        class="inline-flex shrink-0 items-center justify-center gap-1.5 whitespace-nowrap rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs font-medium text-slate-700 shadow-sm transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-400/30 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-200 dark:hover:bg-slate-800"
                        title="Lägg till, ändra eller arkivera grupper"
                        @onclick="OpenCategoryManager">
                    Hantera grupper
                </button>
            </AuthorizeView>

            <div class="relative min-w-[200px] max-w-xs flex-1">
                <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-slate-400">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
                </span>
                <input type="search"
                       placeholder="Sök namn, org.nr, e-post, telefon, stad…"
                       value="@_search"
                       @oninput="OnSearchInput"
                       class="w-full rounded-lg border border-slate-300 bg-white py-1.5 pl-9 pr-2.5 text-xs text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" />
            </div>

            <div class="w-52 shrink-0">
                <FilterMultiSelect TValue="int"
                                   Options="MainGroupOptions"
                                   Selected="_mainGroupFilters"
                                   Placeholder="Alla huvudgrupper"
                                   OnChanged="OnMainGroupFiltersChanged" />
            </div>

            <div class="w-52 shrink-0">
                <FilterMultiSelect TValue="int"
                                   Options="SubCategoryOptions"
                                   Selected="_subCategoryFilters"
                                   Placeholder="Alla undergrupper"
                                   OnChanged="OnFilterChanged" />
            </div>

            <div class="w-52 shrink-0">
                <FilterMultiSelect TValue="string"
                                   Options="StatusFilterOptions"
                                   Selected="_statusFilters"
                                   Placeholder="Alla statusar"
                                   OnChanged="OnFilterChanged" />
            </div>

            <span class="shrink-0 whitespace-nowrap text-xs text-slate-500 dark:text-slate-400">@ResultCountText</span>

            <!-- Visa/dölj kolumner -->
            <div class="shrink-0">
                <button type="button"
                        @onclick="() => _columnMenuOpen = !_columnMenuOpen"
                        title="Visa eller dölj kolumner"
                        class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs font-medium text-slate-700 shadow-sm transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-200 dark:hover:bg-slate-800">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
                    Kolumner
                </button>

                @if (_columnMenuOpen)
                {
                    <button type="button" class="fixed inset-0 z-40 cursor-default" @onclick="() => _columnMenuOpen = false" aria-hidden="true"></button>
                    <div class="absolute right-0 top-full z-50 mt-1 w-56 rounded-xl border border-slate-200 bg-white p-1.5 shadow-lg dark:border-slate-700 dark:bg-slate-900">
                        <div class="px-2 py-1 text-[10px] font-semibold uppercase tracking-wide text-slate-400">Visa kolumner</div>
                        @foreach (var (col, label) in HideableColumns)
                        {
                            <label class="flex cursor-pointer items-center gap-2 rounded-lg px-2 py-1.5 text-xs text-slate-700 transition hover:bg-slate-50 dark:text-slate-200 dark:hover:bg-slate-800">
                                <input type="checkbox" checked="@IsColumnVisible(col)" @onchange="() => ToggleColumn(col)"
                                       class="h-3.5 w-3.5 rounded border-slate-300 text-blue-600 focus:ring-blue-500 dark:border-slate-600 dark:bg-slate-800" />
                                <span>@label</span>
                            </label>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    @if (_loading)
    {
        <div class="shrink-0 rounded-xl border border-slate-200 bg-white p-3 shadow-sm dark:border-slate-800 dark:bg-slate-900">
            <MhdLoading />
        </div>
    }
    else
    {
        var rows = PagedRows();

        <!-- Tabell: sticky rubrik + endast rader scrollar + sticky pager längst ner -->
        <section class="flex min-h-0 flex-1 flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
            <div class="min-h-0 flex-1 overflow-auto">
                <table class="w-full border-separate border-spacing-0 text-sm">
                    <thead class="sticky top-0 z-10">
                        <tr>
                            <th class="@ThClass">Åtgärder</th>
                            <th class="@ThClass">
                                <button type="button" class="inline-flex items-center gap-1 hover:text-slate-700 dark:hover:text-slate-200" @onclick="() => SortBy(OrgSortColumn.Name)">
                                    Namn @(SortIcon(OrgSortColumn.Name))
                                </button>
                            </th>
                            <th class="@ThClass">
                                <button type="button" class="inline-flex items-center gap-1 hover:text-slate-700 dark:hover:text-slate-200" @onclick="() => SortBy(OrgSortColumn.MainGroup)">
                                    Huvudgrupp @(SortIcon(OrgSortColumn.MainGroup))
                                </button>
                            </th>
                            <th class="@ThClass">
                                <button type="button" class="inline-flex items-center gap-1 hover:text-slate-700 dark:hover:text-slate-200" @onclick="() => SortBy(OrgSortColumn.SubCategory)">
                                    Undergrupp @(SortIcon(OrgSortColumn.SubCategory))
                                </button>
                            </th>
                            @if (IsColumnVisible(OrgColumn.OrgNr))
                            {
                                <th class="@ThClass">Organisationsnummer</th>
                            }
                            @if (IsColumnVisible(OrgColumn.Email))
                            {
                                <th class="@ThClass">E-post</th>
                            }
                            @if (IsColumnVisible(OrgColumn.Phone))
                            {
                                <th class="@ThClass">Telefon</th>
                            }
                            @if (IsColumnVisible(OrgColumn.City))
                            {
                                <th class="@ThClass">
                                    <button type="button" class="inline-flex items-center gap-1 hover:text-slate-700 dark:hover:text-slate-200" @onclick="() => SortBy(OrgSortColumn.City)">
                                        Stad @(SortIcon(OrgSortColumn.City))
                                    </button>
                                </th>
                            }
                            @if (IsColumnVisible(OrgColumn.Country))
                            {
                                <th class="@ThClass">Land</th>
                            }
                            @if (IsColumnVisible(OrgColumn.Status))
                            {
                                <th class="@ThClass">
                                    <button type="button" class="inline-flex items-center gap-1 hover:text-slate-700 dark:hover:text-slate-200" @onclick="() => SortBy(OrgSortColumn.Status)">
                                        Status @(SortIcon(OrgSortColumn.Status))
                                    </button>
                                </th>
                            }
                            @if (IsColumnVisible(OrgColumn.UpdatedAt))
                            {
                                <th class="@ThClass">
                                    <button type="button" class="inline-flex items-center gap-1 hover:text-slate-700 dark:hover:text-slate-200" @onclick="() => SortBy(OrgSortColumn.UpdatedAt)">
                                        Senast ändrad @(SortIcon(OrgSortColumn.UpdatedAt))
                                    </button>
                                </th>
                            }
                        </tr>
                    </thead>

                    <tbody>
                        @if (rows.Count == 0)
                        {
                            <tr>
                                <td colspan="20" class="px-3 py-8 text-center text-xs text-slate-500 dark:text-slate-400">
                                    Inga kunder eller leverantörer matchar filtret.
                                </td>
                            </tr>
                        }
                        @foreach (var row in rows)
                        {
                            <tr class="transition hover:bg-slate-50 dark:hover:bg-slate-800/40 @(row.IsVisible ? "" : "opacity-60")">
                                <td class="@TdClass">
                                    <div class="flex items-center gap-1">
                                        @* No separate info button — the company name link opens the details window. *@
                                        @if (_canManage)
                                        {
                                            <button type="button"
                                                    class="inline-flex h-7 w-7 items-center justify-center rounded-lg border border-amber-200 bg-amber-50 text-amber-700 transition hover:bg-amber-100 dark:border-amber-900/60 dark:bg-amber-950/30 dark:text-amber-300 dark:hover:bg-amber-950/50"
                                                    title="Ändra"
                                                    @onclick="() => OpenEdit(row)">
                                                @((MarkupString)Icons.Edit)
                                            </button>

                                            @if (row.IsVisible)
                                            {
                                                <button type="button"
                                                        class="inline-flex h-7 w-7 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-600 transition hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-300 dark:hover:bg-slate-800"
                                                        title="Arkivera"
                                                        @onclick="() => ArchiveAsync(row, true)">
                                                    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M5 7l1 12a2 2 0 002 2h8a2 2 0 002-2l1-12M9 7V5a2 2 0 012-2h2a2 2 0 012 2v2" /></svg>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                        class="inline-flex h-7 w-7 items-center justify-center rounded-lg border border-emerald-200 bg-emerald-50 text-emerald-700 transition hover:bg-emerald-100 dark:border-emerald-900/60 dark:bg-emerald-950/30 dark:text-emerald-300 dark:hover:bg-emerald-950/50"
                                                        title="Återställ"
                                                        @onclick="() => ArchiveAsync(row, false)">
                                                    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12a9 9 0 019-9 9 9 0 016.7 3M21 12a9 9 0 01-9 9 9 9 0 01-6.7-3M21 3v6h-6" /></svg>
                                                </button>
                                            }

                                            @if (row.IsUsed)
                                            {
                                                <span class="group relative inline-flex">
                                                    <button type="button" disabled
                                                            class="inline-flex h-7 w-7 cursor-not-allowed items-center justify-center rounded-lg border border-slate-200 bg-slate-50 text-slate-300 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-600">
                                                        @((MarkupString)Icons.DeleteSVG)
                                                    </button>
                                                    <span role="tooltip" class="pointer-events-none absolute bottom-full right-0 z-[80] mb-1 w-52 rounded-md bg-slate-800 px-2.5 py-1.5 text-xs font-normal leading-snug text-white opacity-0 shadow-lg transition-opacity duration-150 group-hover:opacity-100 dark:bg-slate-700">
                                                        Används i projekt/kalkyl/anbud – arkivera istället.
                                                    </span>
                                                </span>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                        class="inline-flex h-7 w-7 items-center justify-center rounded-lg border border-rose-200 bg-rose-50 text-rose-700 transition hover:bg-rose-100 dark:border-rose-900/60 dark:bg-rose-950/30 dark:text-rose-300 dark:hover:bg-rose-950/50"
                                                        title="Ta bort"
                                                        @onclick="() => ConfirmDelete(row)">
                                                    @((MarkupString)Icons.DeleteSVG)
                                                </button>
                                            }
                                        }
                                    </div>
                                </td>

                                <td class="@TdClass">
                                    <button type="button"
                                            class="text-left font-medium text-sky-600 underline-offset-2 transition hover:text-sky-700 hover:underline dark:text-sky-300 dark:hover:text-sky-200"
                                            @onclick="() => OpenDetails(row)">
                                        @row.Name
                                    </button>
                                    @if (!row.IsVisible)
                                    {
                                        <span class="ml-1.5 rounded-full bg-slate-100 px-1.5 py-0.5 text-[10px] font-medium text-slate-500 dark:bg-slate-800 dark:text-slate-400">Arkiverad post</span>
                                    }
                                </td>

                                <td class="@TdClass">@Dash(row.MainGroup)</td>
                                <td class="@TdClass">@Dash(row.SubCategory)</td>

                                @if (IsColumnVisible(OrgColumn.OrgNr))
                                {
                                    <td class="@TdClass">@Dash(row.OrganisationNumber)</td>
                                }
                                @if (IsColumnVisible(OrgColumn.Email))
                                {
                                    <td class="@TdClass">@Dash(row.Email)</td>
                                }
                                @if (IsColumnVisible(OrgColumn.Phone))
                                {
                                    <td class="@TdClass">@Dash(row.Phone)</td>
                                }
                                @if (IsColumnVisible(OrgColumn.City))
                                {
                                    <td class="@TdClass">@Dash(row.City)</td>
                                }
                                @if (IsColumnVisible(OrgColumn.Country))
                                {
                                    <td class="@TdClass">@Dash(row.Country)</td>
                                }
                                @if (IsColumnVisible(OrgColumn.Status))
                                {
                                    <td class="@TdClass">@StatusBadge(row.Status)</td>
                                }
                                @if (IsColumnVisible(OrgColumn.UpdatedAt))
                                {
                                    <td class="@TdClass">@(row.UpdatedAt?.ToString("yyyy-MM-dd") ?? "—")</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Sticky pager -->
            <div class="flex shrink-0 flex-wrap items-center gap-3 border-t border-slate-200 bg-slate-50 px-3 py-1.5 text-xs text-slate-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300">
                <button type="button"
                        class="inline-flex h-7 items-center rounded-lg border border-slate-300 px-2.5 font-medium text-slate-700 transition hover:bg-white disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-900"
                        disabled="@(_page <= 1)" @onclick="() => GoToPage(_page - 1)">Föregående</button>
                <button type="button"
                        class="inline-flex h-7 items-center rounded-lg border border-slate-300 px-2.5 font-medium text-slate-700 transition hover:bg-white disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-900"
                        disabled="@(_page >= TotalPages)" @onclick="() => GoToPage(_page + 1)">Nästa</button>
                <span>Sida @Math.Min(_page, TotalPages) av @TotalPages</span>
                <span class="text-slate-400 dark:text-slate-500">·</span>
                <span>@_totalRows poster</span>
                <div class="ml-auto flex items-center gap-2">
                    <span class="text-slate-500 dark:text-slate-400">Rader per sida</span>
                    <select @onchange="@(e => SetPageSize(int.TryParse(e.Value?.ToString(), out var v) ? v : 25))"
                            class="h-7 rounded-lg border border-slate-300 bg-white px-2 text-xs text-slate-700 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-200">
                        @foreach (var size in PageSizeOptions)
                        {
                            <option value="@size" selected="@(_pageSize == size)">@size</option>
                        }
                    </select>
                </div>
            </div>
        </section>
    }
</div>

@code {
    private const string ThClass = "whitespace-nowrap border-b border-slate-200 bg-slate-50 px-3 py-1.5 text-left text-[11px] font-semibold text-slate-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-400";
    private const string TdClass = "whitespace-nowrap border-b border-slate-100 px-3 py-1.5 text-slate-700 dark:border-slate-800 dark:text-slate-200";

    private static string Dash(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value!;

    private static MarkupString StatusBadge(string? status)
    {
        var label = string.IsNullOrWhiteSpace(status) ? OrganisationStatusCatalog.NotSpecified : OrganisationStatusCatalog.Normalize(status);
        return (MarkupString)$"<span class=\"inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-semibold ring-1 ring-inset {OrganisationStatusCatalog.BadgeClasses(label)}\">{System.Net.WebUtility.HtmlEncode(label)}</span>";
    }

    private MarkupString SortIcon(OrgSortColumn column)
        => _sort == column
            ? (MarkupString)(_sortDesc ? "<span class=\"text-slate-400\">▼</span>" : "<span class=\"text-slate-400\">▲</span>")
            : (MarkupString)string.Empty;
}
