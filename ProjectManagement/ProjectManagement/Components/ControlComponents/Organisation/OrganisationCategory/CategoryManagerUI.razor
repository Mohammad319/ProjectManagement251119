@using Application.Feature.Organisation.OrganisationCategory.Commands
@using Application.Feature.Organisation.OrganisationCategory.Queries
@using Domain.DTO.Category
@using ProjectManagement.Shared.DTO.Organisation
@inherits AppComponentBase

@* "Hantera grupper": huvudgrupper (top-level) med sina undergrupper. Inline-redigering,
   inga nästlade dialoger. Grupper som används kan inte tas bort (blockeras i backend). *@
<div class="space-y-2 p-1 text-sm">

    <div class="flex flex-wrap items-center justify-between gap-2">
        <p class="text-xs text-slate-500 dark:text-slate-400">
            Lägg till, ändra eller ta bort grupper. Grupper som redan används kan inte tas bort.
        </p>
        <button type="button"
                class="inline-flex items-center gap-1.5 rounded-lg bg-emerald-600 px-2.5 py-1.5 text-xs font-semibold text-white shadow-sm transition hover:bg-emerald-700 dark:bg-emerald-500 dark:hover:bg-emerald-400"
                @onclick="() => StartCreate(null, null)">
            @((MarkupString)Icons.PlusSVG)
            <span>Ny huvudgrupp</span>
        </button>
    </div>

    @if (_editing is not null)
    {
        <div class="rounded-xl border border-sky-200 bg-sky-50 p-2.5 dark:border-sky-900/60 dark:bg-sky-950/30">
            <div class="mb-1.5 text-xs font-semibold text-sky-800 dark:text-sky-200">
                @(_editing.Id == 0
                    ? (_editing.ParentId is null ? "Ny huvudgrupp" : $"Ny undergrupp i {_editing.ParentName}")
                    : "Ändra grupp")
            </div>
            <div class="flex flex-wrap items-end gap-2">
                <div class="min-w-[220px] flex-1">
                    <label class="mb-1 block text-[11px] font-medium text-slate-600 dark:text-slate-300">Namn</label>
                    <input @bind="_editing.Name" @bind:event="oninput"
                           placeholder="Gruppens namn"
                           class="w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs text-slate-900 shadow-sm outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" />
                </div>
                <button type="button"
                        class="inline-flex items-center rounded-lg bg-sky-600 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-sky-700 disabled:opacity-50 dark:bg-sky-500 dark:hover:bg-sky-400"
                        disabled="@(_saving || string.IsNullOrWhiteSpace(_editing.Name))"
                        @onclick="SaveAsync">Spara</button>
                <button type="button"
                        class="inline-flex items-center rounded-lg border border-slate-300 px-3 py-1.5 text-xs font-medium text-slate-700 transition hover:bg-slate-50 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-800"
                        @onclick="() => _editing = null">Avbryt</button>
            </div>
        </div>
    }

    @if (_loading)
    {
        <MhdLoading />
    }
    else if (_groups.Count == 0)
    {
        <div class="rounded-xl border border-dashed border-slate-300 px-3 py-6 text-center text-xs text-slate-500 dark:border-slate-700 dark:text-slate-400">
            Inga grupper ännu. Skapa en huvudgrupp för att komma igång.
        </div>
    }
    else
    {
        <div class="max-h-[52vh] space-y-1.5 overflow-y-auto pr-0.5">
            @foreach (var group in _groups)
            {
                <div class="rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900">
                    <div class="flex items-center justify-between gap-2 border-b border-slate-100 px-2.5 py-1.5 dark:border-slate-800">
                        <div class="flex items-center gap-2 font-medium text-slate-800 dark:text-slate-100">
                            <span class="inline-block h-2 w-2 rounded-full bg-violet-500"></span>
                            @group.Name
                            <span class="rounded-full bg-slate-100 px-1.5 py-0.5 text-[10px] font-medium text-slate-500 dark:bg-slate-800 dark:text-slate-400">
                                @Children(group.Id).Count()
                            </span>
                        </div>
                        <div class="flex items-center gap-1">
                            <button type="button" title="Ny undergrupp"
                                    class="inline-flex h-7 w-7 items-center justify-center rounded-lg border border-emerald-200 bg-emerald-50 text-emerald-700 transition hover:bg-emerald-100 dark:border-emerald-900/60 dark:bg-emerald-950/30 dark:text-emerald-300"
                                    @onclick="() => StartCreate(group.Id, group.Name)">
                                @((MarkupString)Icons.PlusSVG)
                            </button>
                            <button type="button" title="Ändra"
                                    class="inline-flex h-7 w-7 items-center justify-center rounded-lg border border-amber-200 bg-amber-50 text-amber-700 transition hover:bg-amber-100 dark:border-amber-900/60 dark:bg-amber-950/30 dark:text-amber-300"
                                    @onclick="() => StartEdit(group)">
                                @((MarkupString)Icons.Edit)
                            </button>
                            <button type="button" title="Ta bort"
                                    class="inline-flex h-7 w-7 items-center justify-center rounded-lg border border-rose-200 bg-rose-50 text-rose-700 transition hover:bg-rose-100 dark:border-rose-900/60 dark:bg-rose-950/30 dark:text-rose-300"
                                    @onclick="() => ConfirmDelete(group)">
                                @((MarkupString)Icons.DeleteSVG)
                            </button>
                        </div>
                    </div>

                    @if (Children(group.Id).Any())
                    {
                        <div class="divide-y divide-slate-50 dark:divide-slate-800/60">
                            @foreach (var child in Children(group.Id))
                            {
                                <div class="flex items-center justify-between gap-2 px-2.5 py-1.5">
                                    <span class="text-slate-700 dark:text-slate-200">@child.Name</span>
                                    <div class="flex items-center gap-1">
                                        <button type="button" title="Ändra"
                                                class="inline-flex h-7 w-7 items-center justify-center rounded-lg border border-amber-200 bg-amber-50 text-amber-700 transition hover:bg-amber-100 dark:border-amber-900/60 dark:bg-amber-950/30 dark:text-amber-300"
                                                @onclick="() => StartEdit(child)">
                                            @((MarkupString)Icons.Edit)
                                        </button>
                                        <button type="button" title="Ta bort"
                                                class="inline-flex h-7 w-7 items-center justify-center rounded-lg border border-rose-200 bg-rose-50 text-rose-700 transition hover:bg-rose-100 dark:border-rose-900/60 dark:bg-rose-950/30 dark:text-rose-300"
                                                @onclick="() => ConfirmDelete(child)">
                                            @((MarkupString)Icons.DeleteSVG)
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public EventCallback OnChanged { get; set; }

    private bool _loading = true;
    private bool _saving;
    private List<ListOrganisationCategoryDTO> _all = [];
    private List<ListOrganisationCategoryDTO> _groups = [];
    private EditModel? _editing;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        await InvokeAsync(StateHasChanged);

        _all = await Dispatcher.Send(new GetOrganisationCategoryQuery()) ?? [];
        _groups = _all.Where(x => x.ParentCategoryId is null).OrderBy(x => x.Name).ToList();

        _loading = false;
        await InvokeAsync(StateHasChanged);
    }

    private IEnumerable<ListOrganisationCategoryDTO> Children(int parentId)
        => _all.Where(x => x.ParentCategoryId == parentId).OrderBy(x => x.Name);

    private void StartCreate(int? parentId, string? parentName)
        => _editing = new EditModel { Id = 0, Name = string.Empty, ParentId = parentId, ParentName = parentName };

    private void StartEdit(ListOrganisationCategoryDTO category)
        => _editing = new EditModel { Id = category.Id, Name = category.Name, ParentId = category.ParentCategoryId };

    private async Task SaveAsync()
    {
        if (_saving || _editing is null || string.IsNullOrWhiteSpace(_editing.Name))
            return;

        _saving = true;
        try
        {
            bool result;
            if (_editing.Id == 0)
            {
                result = await Dispatcher.Send(new CreateOrganisationCategoryCommand(
                    new PostOrganisationCategoryDTO { Name = _editing.Name.Trim(), CategoryId = _editing.ParentId })) > 0;
                MHD.Notifications(ToastType.Add, result);
            }
            else
            {
                result = await Dispatcher.Send(new UpdateOrganisationCategoryCommand(
                    new PutOrganisationCategoryDTO { Id = _editing.Id, Name = _editing.Name.Trim() }));
                MHD.Notifications(ToastType.Update, result);
            }

            if (result)
            {
                _editing = null;
                await LoadAsync();
                if (OnChanged.HasDelegate)
                    await OnChanged.InvokeAsync();
            }
        }
        finally
        {
            _saving = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ConfirmDelete(ListOrganisationCategoryDTO category)
        => MHD.DeleteMessage(category.Name, EventCallback.Factory.Create(this, () => DeleteAsync(category)));

    private async Task DeleteAsync(ListOrganisationCategoryDTO category)
    {
        var result = await Dispatcher.Send(new DeleteOrganisationCategoryCommand(category.Id));
        MHD.Notifications(ToastType.Delete, result);

        if (result)
        {
            await LoadAsync();
            if (OnChanged.HasDelegate)
                await OnChanged.InvokeAsync();
        }
    }

    private sealed class EditModel
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public int? ParentId { get; set; }
        public string? ParentName { get; set; }
    }
}
