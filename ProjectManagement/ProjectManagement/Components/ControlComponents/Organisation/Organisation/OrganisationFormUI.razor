@using Application.Feature.Organisation.Organisation.Commands
@using Application.Feature.Organisation.Organisation.Queries
@using Application.Feature.Organisation.OrganisationCategory.Queries
@using Application.Feature.Organisation.OrganisationType.Queries
@using Domain.DTO.Category
@using Domain.Entities.Organisation
@using ProjectManagement.Client.Shared.Model.Project
@using ProjectManagement.Client.Shared.SharedComponent
@using ProjectManagement.Client.Shared.SharedComponent.Contact
@using ProjectManagement.Shared.DTO.App
@using ProjectManagement.Shared.DTO.App.List
@using ProjectManagement.Shared.DTO.General
@using ProjectManagement.Shared.DTO.Offer
@using Microsoft.AspNetCore.Authorization
@using ProjectManagement.Shared.DTO.Organisation
@using ProjectManagement.Shared.Base.Organisation
@using System.Text.Json
@using ProjectManagement.Shared

@attribute [Authorize(Roles = PMRolesConst.Tenant.AdminSuperManger)]

@if (PostCompany is not null)
{
    <div class="space-y-1 px-2 text-sm">
        <EditForm Model="@PostCompany" OnSubmit="HandleSubmitAsync" id="organisationForm">

            <div class="flex justify-between">
                <ul class="mb-2 flex flex-wrap gap-1 border-b border-slate-200 pb-2 dark:border-slate-700" role="tablist">
                    @foreach (var tab in Tabs)
                    {
                        <li class="mr-2" role="presentation">
                            <button type="button"
                                    class="@(Part == tab.Id ? "rounded-md px-3 py-1.5 text-sm font-medium transition bg-sky-600 text-white dark:bg-sky-500" : "rounded-md px-3 py-1.5 text-sm font-medium transition bg-slate-100 text-slate-700 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700")"
                                    @onclick="() => Part = tab.Id">
                                @tab.Label
                            </button>
                        </li>
                    }
                </ul>
            </div>

            @if (Part == 1)
            {
                <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                    <div class="md:col-span-2">
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@CalcResource.name</label>
                        <InputText class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind-Value="PostCompany.Name" />
                        @if (!string.IsNullOrWhiteSpace(NameValidationError))
                        {
                            <div class="mt-1 text-sm text-red-600 dark:text-red-400">@NameValidationError</div>
                        }
                    </div>

                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceIdentity.IDNumber</label>
                        <InputText class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind-Value="PostCompany.IDNumber" />
                        <ValidationMessage For="@(() => PostCompany.IDNumber)" />
                    </div>

                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceIdentity.PersonOrganisationNr</label>
                        <InputText class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind-Value="PostCompany.PIDNumber" />
                        <ValidationMessage For="@(() => PostCompany.PIDNumber)" />
                    </div>

                    @if (CustomerGroups is not null)
                    {
                        <div>
                            <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceIdentity.PersonOrganisationType</label>
                            <InputSelect class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind-Value="PostCompany.OrganisationTypeID">
                                <option value="0"></option>
                                @foreach (var group in CustomerGroups)
                                {
                                    <option value="@group.Id">@group.Name</option>
                                }
                            </InputSelect>
                        </div>
                    }

                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@CalcResource.status</label>
                        <InputText class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind-Value="PostCompany.Status" />
                        <ValidationMessage For="@(() => PostCompany.Status)" />
                    </div>

                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceIdentity.website</label>
                        <InputText class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind-Value="PostCompany.URL" />
                        <ValidationMessage For="@(() => PostCompany.URL)" />
                    </div>

                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceIdentity.email</label>
                        <InputText class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind-Value="PostCompany.Email" />
                        <ValidationMessage For="@(() => PostCompany.Email)" />
                    </div>

                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceIdentity.phone</label>
                        <InputText class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind-Value="PostCompany.Phone" />
                        <ValidationMessage For="@(() => PostCompany.Phone)" />
                    </div>

                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceIdentity.mobile</label>
                        <InputText class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind-Value="PostCompany.Mobile" />
                        <ValidationMessage For="@(() => PostCompany.Mobile)" />
                    </div>
                </div>

                <div class="mt-4 rounded-xl border border-slate-200 p-4 dark:border-slate-700">
                    <div class="mb-3 flex items-center justify-between gap-2">
                        <div>
                            <div class="text-sm font-medium text-slate-900 dark:text-slate-100">@WebLoc[nameof(PMWebResource.Notes)]</div>
                            <div class="text-sm text-slate-600 dark:text-slate-300">@WebLoc[nameof(PMWebResource.OrganisationNotesHint)]</div>
                        </div>
                        <button type="button"
                                class="inline-flex items-center justify-center rounded-md bg-sky-600 px-3 py-1.5 text-sm font-medium text-white transition hover:bg-sky-700 dark:bg-sky-500 dark:hover:bg-sky-400"
                                @onclick="AddNote">
                            @AppLoc[LocalizerConst.New, CalcResource.note]
                        </button>
                    </div>

                    @if (PostCompany.Notes.Count == 0)
                    {
                        <div class="text-sm text-slate-500 dark:text-slate-400">@WebLoc[nameof(PMWebResource.NoNotesAdded)]</div>
                    }
                    else
                    {
                        @for (int o = 0; o < PostCompany.Notes.Count; o++)
                        {
                            var noteIndex = o;
                            <div class="mb-3 flex items-start gap-2">
                                <div class="flex-1">
                                    <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@CalcResource.note @(noteIndex + 1)</label>
                                    <InputText class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind-Value="PostCompany.Notes[noteIndex]" />
                                </div>
                                <button type="button"
                                        class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-red-300 bg-red-50 text-red-600 transition hover:bg-red-100 dark:border-red-700 dark:bg-red-900/30 dark:text-red-300 dark:hover:bg-red-900/50 mt-6"
                                        title="@WebLoc[nameof(PMWebResource.RemoveNote)]"
                                        @onclick="() => RemoveNote(noteIndex)">
                                    @((MarkupString)Icons.DeleteSVG)
                                </button>
                            </div>
                        }
                    }
                </div>
            }
            else if (Part == 2)
            {
                <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceLoc.rating</label>
                        <InputNumber class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind-Value="PostCompany.Rating" />
                        <ValidationMessage For="@(() => PostCompany.Rating)" />
                    </div>

                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceIdentity.numberIDCards</label>
                        <InputNumber class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind-Value="PostCompany.NumberOfWorkersCards" />
                        <ValidationMessage For="@(() => PostCompany.NumberOfWorkersCards)" />
                    </div>

                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceLoc.collectiveLabourAgreement</label>
                        <InputSelect @bind-Value="PostCompany.SocialLaborAgreement" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900">
                            <option value="@YesNoUnkown.yes">@ResourceApp.yes</option>
                            <option value="@YesNoUnkown.no">@ResourceApp.no</option>
                            <option value="@YesNoUnkown.unkown">@ResourceApp.unkown</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => PostCompany.SocialLaborAgreement)" />
                    </div>

                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceLoc.dateInvoiceControl</label>
                        <InputDate class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind-Value="PostCompany.InvoiceVerificationDate" />
                        <ValidationMessage For="@(() => PostCompany.InvoiceVerificationDate)" />
                    </div>

                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceLoc.dateOfControl</label>
                        <InputDate class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind-Value="PostCompany.VerificationDate" />
                        <ValidationMessage For="@(() => PostCompany.VerificationDate)" />
                    </div>

                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceApp.qualitySystems</label>
                        <InputSelect @bind-Value="PostCompany.QualitySystems" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900">
                            <option value="@YesNoUnkown.yes">@ResourceApp.yes</option>
                            <option value="@YesNoUnkown.no">@ResourceApp.no</option>
                            <option value="@YesNoUnkown.unkown">@ResourceApp.unkown</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => PostCompany.QualitySystems)" />
                    </div>

                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceApp.environmentalSystems</label>
                        <InputSelect @bind-Value="PostCompany.EnvironmentalSystems" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900">
                            <option value="@YesNoUnkown.yes">@ResourceApp.yes</option>
                            <option value="@YesNoUnkown.no">@ResourceApp.no</option>
                            <option value="@YesNoUnkown.unkown">@ResourceApp.unkown</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => PostCompany.EnvironmentalSystems)" />
                    </div>
                </div>
            }
            else if (Part == 3)
            {
                <div class="mb-1 grid grid-cols-1 gap-4 md:grid-cols-2">
                    <div class="flex items-center gap-2 py-1 md:col-span-2">
                        <InputCheckbox class="h-4 w-4 rounded border-slate-300 text-sky-600 focus:ring-sky-500 dark:border-slate-600 dark:bg-slate-800" @bind-Value="PostCompany.IsVisible" />
                        <label class="text-sm text-slate-700 dark:text-slate-200">@ResourceApp.isVisible</label>
                    </div>

                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceLoc.baseCategory</label>
                        <select class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @onchange="CategoryChange">
                            <option value="0"></option>
                            @if (Categories is not null)
                            {
                                foreach (var category in Categories.Where(x => x.ParentCategoryId == null))
                                {
                                    <option value="@category.Id" selected="@(CategorySelected?.Id == category.Id)">@category.Name</option>
                                }
                            }
                        </select>
                    </div>

                    @if (CategorySelected is not null)
                    {
                        <div>
                            <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceLoc.category</label>
                            <InputSelect class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind-Value="PostCompany.CategoryId">
                                <option value="0"></option>
                                @foreach (var category in (Categories?.Where(x => x.ParentCategoryId == CategorySelected.Id) ?? Enumerable.Empty<ListOrganisationCategoryDTO>()))
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => PostCompany.CategoryId)" />
                        </div>
                    }
                </div>

                @if (PostCompany.Address is not null)
                {
                    <SharedAddressUI Address="PostCompany.Address" />
                }
            }
        </EditForm>

        @if (Part == 4)
        {
            <ContactsUI Contacts="PostCompany.Contacts" />
        }
    </div>

    <div class="mt-3 flex items-center justify-end gap-2 border-t border-slate-200 pt-3 dark:border-slate-700">
        <button type="submit" class="inline-flex items-center justify-center rounded-md border border-emerald-400 px-3 py-1.5 text-sm font-medium text-emerald-600 transition hover:bg-emerald-50 dark:border-emerald-700 dark:text-emerald-300 dark:hover:bg-emerald-900/30" form="organisationForm" disabled="@IsLoading">
            @ResourceApp.save
        </button>
        <button type="button" class="inline-flex items-center justify-center rounded-md border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-700 transition hover:bg-slate-50 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-800" @onclick="async () => await Callback.InvokeAsync(false)">
            @ResourceApp.cancel
        </button>
    </div>
}
