@using Application.Feature.Organisation.Organisation.Commands
@using Application.Feature.Organisation.Organisation.Queries
@using Application.Feature.Organisation.OrganisationCategory.Queries
@using Application.Feature.Organisation.OrganisationType.Queries
@using Domain.DTO.Category
@using Domain.Entities.Organisation
@using ProjectManagement.Client.Shared.Model.Project
@using ProjectManagement.Client.Shared.SharedComponent
@using ProjectManagement.Client.Shared.SharedComponent.Contact
@using ProjectManagement.Shared.DTO.App
@using ProjectManagement.Shared.DTO.App.List
@using ProjectManagement.Shared.DTO.General
@using ProjectManagement.Shared.DTO.Offer
@using Microsoft.AspNetCore.Authorization
@using ProjectManagement.Shared.DTO.Organisation
@using ProjectManagement.Shared.Base.Organisation
@using System.Text.Json

@attribute [Authorize(Roles = PMRolesConst.Tenant.AdminSuperManger)]

@if (PostCompany is not null)
{
    <div class="@CssClasses.Modal.Body">
        <EditForm Model="@PostCompany" OnValidSubmit="HandleSubmitAsync" id="custForm">
            <DataAnnotationsValidator />

            <div class="flex justify-between">
                <ul class="@CssClasses.Tabs.UL" role="tablist">
                    @foreach (var tab in Tabs)
                    {
                        <li class="mr-2" role="presentation">
                            <button type="button"
                                    class="@(CssClasses.Tabs.Btn(Part == tab.Id))"
                                    @onclick="() => Part = tab.Id">
                                @tab.Label
                            </button>
                        </li>
                    }
                </ul>
            </div>

            @if (Part == 1)
            {
                <div class="@CssClasses.Grid.Col.MD4">
                    <div class="@CssClasses.Grid.Span.MD2">
                        <label class="@CssClasses.Form.Label">@CalcResource.name</label>
                        <InputText class="@CssClasses.Input.Text" @bind-Value="PostCompany.Name" />
                        <ValidationMessage For="@(() => PostCompany.Name)" />
                    </div>

                    <div>
                        <label class="@CssClasses.Form.Label">@ResourceIdentity.IDNumber</label>
                        <InputText class="@CssClasses.Input.Text" @bind-Value="PostCompany.IDNumber" />
                        <ValidationMessage For="@(() => PostCompany.IDNumber)" />
                    </div>

                    <div>
                        <label class="@CssClasses.Form.Label">@ResourceIdentity.PersonOrganisationNr</label>
                        <InputText class="@CssClasses.Input.Text" @bind-Value="PostCompany.PIDNumber" />
                        <ValidationMessage For="@(() => PostCompany.PIDNumber)" />
                    </div>

                    @if (CustomerGroups is not null)
                    {
                        <div>
                            <label class="@CssClasses.Form.Label">@ResourceIdentity.PersonOrganisationType</label>
                            <InputSelect class="@CssClasses.Input.Text" @bind-Value="PostCompany.OrganisationTypeID">
                                <option value="0"></option>
                                @foreach (var group in CustomerGroups)
                                {
                                    <option value="@group.Id">@group.Name</option>
                                }
                            </InputSelect>
                        </div>
                    }

                    <div>
                        <label class="@CssClasses.Form.Label">@CalcResource.status</label>
                        <InputText class="@CssClasses.Input.Text" @bind-Value="PostCompany.Status" />
                        <ValidationMessage For="@(() => PostCompany.Status)" />
                    </div>

                    <div>
                        <label class="@CssClasses.Form.Label">@ResourceIdentity.website</label>
                        <InputText class="@CssClasses.Input.Text" @bind-Value="PostCompany.URL" />
                        <ValidationMessage For="@(() => PostCompany.URL)" />
                    </div>

                    <div>
                        <label class="@CssClasses.Form.Label">@ResourceIdentity.email</label>
                        <InputText class="@CssClasses.Input.Text" @bind-Value="PostCompany.Email" />
                        <ValidationMessage For="@(() => PostCompany.Email)" />
                    </div>

                    <div>
                        <label class="@CssClasses.Form.Label">@ResourceIdentity.phone</label>
                        <InputText class="@CssClasses.Input.Text" @bind-Value="PostCompany.Phone" />
                        <ValidationMessage For="@(() => PostCompany.Phone)" />
                    </div>

                    <div>
                        <label class="@CssClasses.Form.Label">@ResourceIdentity.mobile</label>
                        <InputText class="@CssClasses.Input.Text" @bind-Value="PostCompany.Mobile" />
                        <ValidationMessage For="@(() => PostCompany.Mobile)" />
                    </div>

                    <div>
                        <button type="button"
                                class="@CssClasses.Btn.Solid.Primary mt-6"
                                @onclick="() => PostCompany.Notes.Add(string.Empty)">
                            New Note
                        </button>
                    </div>
                </div>

                <div>
                    @for (int o = 0; o < PostCompany.Notes.Count; o++)
                    {
                        <div>
                            <label class="@CssClasses.Form.Label">@CalcResource.note @(o + 1)</label>
                            <input type="text" class="@CssClasses.Input.Text" @bind="PostCompany.Notes[o]" />
                        </div>
                    }
                </div>
            }
            else if (Part == 2)
            {
                <div class="@CssClasses.Grid.Col.MD4">
                    <div>
                        <label class="@CssClasses.Form.Label">@ResourceLoc.rating</label>
                        <InputNumber class="@CssClasses.Input.Text" @bind-Value="PostCompany.Rating" />
                        <ValidationMessage For="@(() => PostCompany.Rating)" />
                    </div>

                    <div>
                        <label class="@CssClasses.Form.Label">@ResourceIdentity.numberIDCards</label>
                        <InputNumber class="@CssClasses.Input.Text" @bind-Value="PostCompany.NumberOfWorkersCards" />
                        <ValidationMessage For="@(() => PostCompany.NumberOfWorkersCards)" />
                    </div>

                    <div>
                        <label class="@CssClasses.Form.Label">@ResourceLoc.collectiveLabourAgreement</label>
                        <InputSelect @bind-Value="PostCompany.SocialLaborAgreement" class="@CssClasses.Input.Text">
                            <option value="@YesNoUnkown.yes">@ResourceApp.yes</option>
                            <option value="@YesNoUnkown.no">@ResourceApp.no</option>
                            <option value="@YesNoUnkown.unkown">@ResourceApp.unkown</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => PostCompany.SocialLaborAgreement)" />
                    </div>

                    <div>
                        <label class="@CssClasses.Form.Label">@ResourceLoc.dateInvoiceControl</label>
                        <InputDate class="@CssClasses.Input.Date" @bind-Value="PostCompany.InvoiceVerificationDate" />
                        <ValidationMessage For="@(() => PostCompany.InvoiceVerificationDate)" />
                    </div>

                    <div>
                        <label class="@CssClasses.Form.Label">@ResourceLoc.dateOfControl</label>
                        <InputDate class="@CssClasses.Input.Date" @bind-Value="PostCompany.VerificationDate" />
                        <ValidationMessage For="@(() => PostCompany.VerificationDate)" />
                    </div>

                    <div>
                        <label class="@CssClasses.Form.Label">Quality systems</label>
                        <InputSelect @bind-Value="PostCompany.QualitySystems" class="@CssClasses.Input.Text">
                            <option value="@YesNoUnkown.yes">@ResourceApp.yes</option>
                            <option value="@YesNoUnkown.no">@ResourceApp.no</option>
                            <option value="@YesNoUnkown.unkown">@ResourceApp.unkown</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => PostCompany.QualitySystems)" />
                    </div>

                    <div>
                        <label class="@CssClasses.Form.Label">Environmental systems</label>
                        <InputSelect @bind-Value="PostCompany.EnvironmentalSystems" class="@CssClasses.Input.Text">
                            <option value="@YesNoUnkown.yes">@ResourceApp.yes</option>
                            <option value="@YesNoUnkown.no">@ResourceApp.no</option>
                            <option value="@YesNoUnkown.unkown">@ResourceApp.unkown</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => PostCompany.EnvironmentalSystems)" />
                    </div>
                </div>
            }
            else if (Part == 3)
            {
                <div class="@CssClasses.Grid.Col.MD4 mb-1">
                    <div class="@CssClasses.Form.CheckWrapperM">
                        <InputCheckbox class="@CssClasses.Input.Check" @bind-Value="PostCompany.IsVisible" />
                        <label class="@CssClasses.Form.CheckLabel">@ResourceApp.isVisible</label>
                    </div>

                    <div>
                        <label class="@CssClasses.Form.Label">@ResourceLoc.baseCategory</label>
                        <select class="@CssClasses.Input.Text" @onchange="CategoryChange">
                            <option value="0"></option>
                            @if (Categories is not null)
                            {
                                foreach (var category in Categories.Where(x => x.ParentCategoryId == null))
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            }
                        </select>
                    </div>

                    @if (CategorySelected is not null)
                    {
                        <div>
                            <label class="@CssClasses.Form.Label">@ResourceLoc.category</label>
                            <InputSelect class="@CssClasses.Input.Text" @bind-Value="PostCompany.CategoryId">
                                <option value="0"></option>
                                @foreach (var category in Categories.Where(x => x.ParentCategoryId == CategorySelected.Id))
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => PostCompany.CategoryId)" />
                        </div>
                    }
                </div>

                @if (PostCompany.Address is not null)
                {
                    <SharedAddressUI Address="PostCompany.Address" />
                }
            }
        </EditForm>

        @if (Part == 4)
        {
            <ContactsUI Contacts="PostCompany.Contacts" />
        }
    </div>

    <div class="@CssClasses.Modal.Footer">
        <button type="submit" class="@CssClasses.Btn.Outline.Success" form="custForm" disabled="@IsLoading">
            @ResourceApp.save
        </button>
        <button type="button" class="@CssClasses.Btn.Outline.Secondary" @onclick="async () => await Callback.InvokeAsync(false)">
            @ResourceApp.cancel
        </button>
    </div>
}
