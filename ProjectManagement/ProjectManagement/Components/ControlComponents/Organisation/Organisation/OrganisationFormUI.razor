@using Domain.DTO.Category
@using ProjectManagement.Client.Shared.SharedComponent
@using ProjectManagement.Client.Shared.SharedComponent.Contact
@using Microsoft.AspNetCore.Authorization
@using ProjectManagement.Shared.Base.Organisation
@using ProjectManagement.Shared

@attribute [Authorize(Roles = PMRolesConst.Tenant.AdminManger)]

@if (PostCompany is not null)
{
    <div class="flex flex-col text-sm">

        @if (SimilarOrganisations is { Count: > 0 })
        {
            <div class="mb-2 rounded-lg border border-amber-300 bg-amber-50 px-3 py-2 text-amber-800 dark:border-amber-800/60 dark:bg-amber-950/30 dark:text-amber-200">
                <div class="font-semibold">Det finns redan ett liknande företag. Vill du ändå skapa ett nytt?</div>
                <ul class="mt-1 list-disc pl-5 text-xs">
                    @foreach (var similar in SimilarOrganisations)
                    {
                        <li>@similar.Name</li>
                    }
                </ul>
                <div class="mt-2 flex flex-wrap gap-2">
                    <button type="button"
                            class="rounded-md bg-amber-600 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-amber-700"
                            @onclick="CreateAnywayAsync">
                        Skapa ändå
                    </button>
                    <button type="button"
                            class="rounded-md border border-amber-400 px-3 py-1.5 text-xs font-medium text-amber-800 transition hover:bg-amber-100 dark:text-amber-200 dark:hover:bg-amber-900/30"
                            @onclick="() => SimilarOrganisations = null">
                        Avbryt
                    </button>
                </div>
            </div>
        }

        <div class="shrink-0">
            <ul class="mb-2 flex flex-wrap gap-1 border-b border-slate-200 pb-2 dark:border-slate-700" role="tablist">
                @foreach (var tab in Tabs)
                {
                    <li class="mr-2" role="presentation">
                        <button type="button"
                                class="@(Part == tab.Id ? "inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-sm font-medium transition bg-sky-600 text-white dark:bg-sky-500" : "inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-sm font-medium transition bg-slate-100 text-slate-700 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700")"
                                @onclick="() => Part = tab.Id">
                            @tab.Label
                            @if (TabHasError(tab.Id))
                            {
                                <span class="inline-flex h-4 w-4 items-center justify-center rounded-full bg-red-500 text-[10px] font-bold text-white"
                                      title="Fliken har obligatoriska fält som saknas">!</span>
                            }
                        </button>
                    </li>
                }
            </ul>

            @if (!string.IsNullOrWhiteSpace(SaveError))
            {
                <div class="mb-2 rounded-md border border-red-300 bg-red-50 px-3 py-2 text-sm text-red-700 dark:border-red-800/60 dark:bg-red-950/30 dark:text-red-300">
                    @SaveError
                </div>
            }
        </div>

        <div class="org-form-content overflow-y-auto pr-1">
            @if (Part == 3)
            {
                @* Internal tabs inside "Kontakt & adress". *@
                <div class="mb-3 flex flex-wrap items-center gap-1 border-b border-slate-200 pb-2 dark:border-slate-700" role="tablist">
                    <button type="button" class="@SubTabClass(ContactAddressTab.Contacts)" @onclick="() => _contactAddressTab = ContactAddressTab.Contacts">
                        Kontaktpersoner
                    </button>
                    <button type="button" class="@SubTabClass(ContactAddressTab.Addresses)" @onclick="() => _contactAddressTab = ContactAddressTab.Addresses">
                        Adresser
                    </button>
                </div>
            }

            @* ContactsUI hosts its own EditForm, so it must stay a sibling of this EditForm
               — nesting <form> elements is invalid HTML. The footer Save button submits via form=id. *@
            <EditForm Model="@PostCompany" OnSubmit="HandleSubmitAsync" id="@DialogFormId">
                <DataAnnotationsValidator />

            @if (Part == 1)
            {
                @* Compact, logical row layout:
                   1: Namn | Person-/orgnr   2: Typ | Status | ID-nummer
                   3: Huvudgrupp | Undergrupp | Visa i listor   4: Email | Telefon | Mobil   5: Webbplats *@
                <div class="grid grid-cols-1 gap-3 md:grid-cols-6">
                    <div class="md:col-span-3">
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@CalcResource.name <span class="text-red-500">*</span></label>
                        <InputText class="@FieldCls" @bind-Value="PostCompany.Name" @ref="NameInputRef" />
                        @if (!string.IsNullOrWhiteSpace(NameValidationError))
                        {
                            <div class="mt-1 text-sm text-red-600 dark:text-red-400">@NameValidationError</div>
                        }
                    </div>

                    <div class="md:col-span-3">
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceIdentity.PersonOrganisationNr</label>
                        <InputText class="@FieldCls" @bind-Value="PostCompany.PIDNumber" />
                        <ValidationMessage For="@(() => PostCompany.PIDNumber)" />
                    </div>

                    <div class="md:col-span-2">
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceIdentity.PersonOrganisationType</label>
                        <MhdFormSelect TValue="string"
                                       @bind-Value="PostCompany.OrganisationType"
                                       Options="OrganisationTypeOptions"
                                       Placeholder="Välj person-/organisationstyp"
                                       FixedPopup="true" />
                    </div>

                    <div class="md:col-span-2">
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@CalcResource.status <span class="text-red-500">*</span></label>
                        <MhdFormSelect TValue="string"
                                       Value="PostCompany.Status"
                                       ValueChanged="OnStatusChanged"
                                       Options="StatusOptions"
                                       Placeholder="Välj status"
                                       ShowColorDot="true"
                                       FixedPopup="true" />
                        @if (!string.IsNullOrWhiteSpace(StatusValidationError))
                        {
                            <div class="mt-1 text-sm text-red-600 dark:text-red-400">@StatusValidationError</div>
                        }
                    </div>

                    <div class="md:col-span-2">
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceIdentity.IDNumber</label>
                        <InputText class="@FieldCls" @bind-Value="PostCompany.IDNumber" />
                        <ValidationMessage For="@(() => PostCompany.IDNumber)" />
                    </div>

                    @if (IsWarningStatus)
                    {
                        <div class="md:col-span-6">
                            <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">Orsak till varning <span class="text-red-500">*</span></label>
                            <InputTextArea class="@FieldCls"
                                           @bind-Value="PostCompany.WarningReason"
                                           placeholder="Skriv varför denna kund/leverantör har varning..." />
                            @if (!string.IsNullOrWhiteSpace(WarningReasonValidationError))
                            {
                                <div class="mt-1 text-sm text-red-600 dark:text-red-400">@WarningReasonValidationError</div>
                            }
                        </div>
                    }

                    <div class="md:col-span-2">
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">Huvudgrupp <span class="text-red-500">*</span></label>
                        <MhdFormSelect TValue="int?"
                                       @bind-Value="SelectedMainGroupId"
                                       Options="MainGroupOptions"
                                       Placeholder="Välj huvudgrupp"
                                       FixedPopup="true" />
                        @if (!string.IsNullOrWhiteSpace(GroupValidationError))
                        {
                            <div class="mt-1 text-sm text-red-600 dark:text-red-400">@GroupValidationError</div>
                        }
                    </div>

                    <div class="md:col-span-2">
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">Undergrupp</label>
                        <MhdFormSelect TValue="int"
                                       @bind-Value="PostCompany.CategoryId"
                                       Options="SubGroupOptions"
                                       Placeholder="@(CategorySelected is null ? "Välj huvudgrupp först" : "Välj undergrupp")"
                                       Disabled="@(CategorySelected is null)"
                                       FixedPopup="true" />
                    </div>

                    <div class="flex items-center gap-2 pt-6 md:col-span-2">
                        <InputCheckbox class="h-4 w-4 rounded border-slate-300 text-sky-600 focus:ring-sky-500 dark:border-slate-600 dark:bg-slate-800" @bind-Value="PostCompany.IsVisible" />
                        <label class="text-sm text-slate-700 dark:text-slate-200">Visa i listor</label>
                    </div>

                    <div class="md:col-span-2">
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceIdentity.email</label>
                        <InputText class="@FieldCls" @bind-Value="PostCompany.Email" />
                        @if (!string.IsNullOrWhiteSpace(EmailValidationError))
                        {
                            <div class="mt-1 text-sm text-red-600 dark:text-red-400">@EmailValidationError</div>
                        }
                        <ValidationMessage For="@(() => PostCompany.Email)" />
                    </div>

                    <div class="md:col-span-2">
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceIdentity.phone</label>
                        <InputText class="@FieldCls" @bind-Value="PostCompany.Phone" />
                        <ValidationMessage For="@(() => PostCompany.Phone)" />
                    </div>

                    <div class="md:col-span-2">
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceIdentity.mobile</label>
                        <InputText class="@FieldCls" @bind-Value="PostCompany.Mobile" />
                        <ValidationMessage For="@(() => PostCompany.Mobile)" />
                    </div>

                    <div class="md:col-span-3">
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceIdentity.website</label>
                        <InputText class="@FieldCls" @bind-Value="PostCompany.URL" />
                        <ValidationMessage For="@(() => PostCompany.URL)" />
                    </div>
                </div>

                <div class="mt-4 rounded-xl border border-slate-200 p-4 dark:border-slate-700">
                    <div class="mb-3 flex items-center justify-between gap-2">
                        <div>
                            <div class="text-sm font-medium text-slate-900 dark:text-slate-100">@WebLoc[nameof(PMWebResource.Notes)]</div>
                            <div class="text-sm text-slate-600 dark:text-slate-300">@WebLoc[nameof(PMWebResource.OrganisationNotesHint)]</div>
                        </div>
                        <button type="button"
                                class="inline-flex items-center justify-center rounded-md bg-sky-600 px-3 py-1.5 text-sm font-medium text-white transition hover:bg-sky-700 dark:bg-sky-500 dark:hover:bg-sky-400"
                                @onclick="AddNote">
                            @AppLoc[LocalizerConst.New, CalcResource.note]
                        </button>
                    </div>

                    @if (PostCompany.Notes.Count == 0)
                    {
                        <div class="text-sm text-slate-500 dark:text-slate-400">@WebLoc[nameof(PMWebResource.NoNotesAdded)]</div>
                    }
                    else
                    {
                        @for (int o = 0; o < PostCompany.Notes.Count; o++)
                        {
                            var noteIndex = o;
                            <div class="mb-3 flex items-start gap-2">
                                <div class="flex-1">
                                    <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@CalcResource.note @(noteIndex + 1)</label>
                                    <InputText class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind-Value="PostCompany.Notes[noteIndex]" />
                                </div>
                                <button type="button"
                                        class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-red-300 bg-red-50 text-red-600 transition hover:bg-red-100 dark:border-red-700 dark:bg-red-900/30 dark:text-red-300 dark:hover:bg-red-900/50 mt-6"
                                        title="@WebLoc[nameof(PMWebResource.RemoveNote)]"
                                        @onclick="() => RemoveNote(noteIndex)">
                                    @((MarkupString)Icons.DeleteSVG)
                                </button>
                            </div>
                        }
                    }
                </div>
            }
            else if (Part == 2)
            {
                <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceLoc.rating</label>
                        <InputNumber class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind-Value="PostCompany.Rating" />
                        <ValidationMessage For="@(() => PostCompany.Rating)" />
                    </div>

                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceIdentity.numberIDCards</label>
                        <InputNumber class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind-Value="PostCompany.NumberOfWorkersCards" />
                        <ValidationMessage For="@(() => PostCompany.NumberOfWorkersCards)" />
                    </div>

                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceLoc.collectiveLabourAgreement</label>
                        <MhdFormSelect TValue="YesNoUnkown"
                                       @bind-Value="PostCompany.SocialLaborAgreement"
                                       Options="ReviewOptions"
                                       Placeholder="Ej angivet" />
                        <ValidationMessage For="@(() => PostCompany.SocialLaborAgreement)" />
                    </div>

                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceLoc.dateOfControl</label>
                        <InputDate class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind-Value="PostCompany.VerificationDate" />
                        <ValidationMessage For="@(() => PostCompany.VerificationDate)" />
                    </div>

                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceApp.qualitySystems</label>
                        <MhdFormSelect TValue="YesNoUnkown"
                                       @bind-Value="PostCompany.QualitySystems"
                                       Options="ReviewOptions"
                                       Placeholder="Ej angivet" />
                        <ValidationMessage For="@(() => PostCompany.QualitySystems)" />
                    </div>

                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceApp.environmentalSystems</label>
                        <MhdFormSelect TValue="YesNoUnkown"
                                       @bind-Value="PostCompany.EnvironmentalSystems"
                                       Options="ReviewOptions"
                                       Placeholder="Ej angivet" />
                        <ValidationMessage For="@(() => PostCompany.EnvironmentalSystems)" />
                    </div>
                </div>
            }
            else if (Part == 3 && _contactAddressTab == ContactAddressTab.Addresses)
            {
                <div class="mb-2 flex items-center justify-between gap-2">
                    <p class="text-sm text-slate-500 dark:text-slate-400">Adresser för kunden/leverantören.</p>
                    <button type="button"
                            class="inline-flex items-center gap-1.5 rounded-md bg-sky-600 px-3 py-1.5 text-sm font-medium text-white transition hover:bg-sky-700 dark:bg-sky-500 dark:hover:bg-sky-400"
                            @onclick="AddAddress">
                        + Lägg till adress
                    </button>
                </div>

                @if (PostCompany.Address.Count == 0)
                {
                    <div class="rounded-lg border border-dashed border-slate-300 px-4 py-6 text-center text-sm text-slate-500 dark:border-slate-700 dark:text-slate-400">
                        Inga adresser tillagda ännu.
                    </div>
                }
                else
                {
                    @for (int a = 0; a < PostCompany.Address.Count; a++)
                    {
                        var addrIndex = a;
                        var addr = PostCompany.Address[addrIndex];
                        <div class="mb-2 grid grid-cols-1 gap-3 rounded-lg border border-slate-200 p-3 dark:border-slate-700 md:grid-cols-[220px_minmax(0,1fr)_auto]">
                            <div>
                                <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">Beskrivning</label>
                                <InputText class="@FieldCls" placeholder="T.ex. Huvudkontor" @bind-Value="addr.Description" />
                            </div>
                            <div>
                                <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">Adress</label>
                                <InputText class="@FieldCls" placeholder="T.ex. Exempelgatan 12, 123 45 Stockholm" @bind-Value="addr.Street" />
                            </div>
                            <div class="flex items-end">
                                <button type="button"
                                        class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-red-300 bg-red-50 text-red-600 transition hover:bg-red-100 dark:border-red-700 dark:bg-red-900/30 dark:text-red-300 dark:hover:bg-red-900/50"
                                        title="Ta bort adressen"
                                        @onclick="() => RemoveAddress(addrIndex)">
                                    @((MarkupString)Icons.DeleteSVG)
                                </button>
                            </div>
                        </div>
                    }
                }
            }
            </EditForm>

            @if (Part == 3 && _contactAddressTab == ContactAddressTab.Contacts)
            {
                <ContactsUI Contacts="PostCompany.Contacts" />
            }
        </div>
    </div>

}
