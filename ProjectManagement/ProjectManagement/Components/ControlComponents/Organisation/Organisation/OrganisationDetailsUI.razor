@using Microsoft.AspNetCore.Authorization
@using ProjectManagement.Shared.DTO.App.List
@using ProjectManagement.Shared.DTO.Organisation
@using ProjectManagement.Shared
@attribute [Authorize]

<div class="space-y-3 p-4 text-sm">
    @if (Company is null)
    {
        <div class="rounded-xl border border-dashed border-slate-300 px-4 py-6 text-sm text-slate-600 dark:border-slate-700 dark:text-slate-300">
            @WebLoc[nameof(PMWebResource.LoadingOrganisationDetails)]
        </div>
    }
    else
    {
        <div class="flex justify-between">
            <ul class="mb-2 flex flex-wrap gap-1 border-b border-slate-200 pb-2 dark:border-slate-700" role="tablist">
                @foreach (var tab in Tabs)
                {
                    <li class="mr-2" role="presentation">
                        <button type="button" class="@(Part == tab.Id ? "rounded-md px-3 py-1.5 text-sm font-medium transition bg-sky-600 text-white dark:bg-sky-500" : "rounded-md px-3 py-1.5 text-sm font-medium transition bg-slate-100 text-slate-700 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700")"
                                @onclick="() => Part = tab.Id">
                            @tab.Label
                        </button>
                    </li>
                }
            </ul>
        </div>

        @if (Part == 1)
        {
            <dl class="grid grid-cols-2 gap-x-4 gap-y-2 p-2 text-sm md:grid-cols-4">
                <dt class="font-medium text-gray-700 dark:text-gray-300">@CalcResource.name</dt>
                <dd class="text-gray-900 dark:text-gray-100">@Company.Name</dd>

                <dt class="font-medium text-gray-700 dark:text-gray-300">@ResourceIdentity.IDNumber</dt>
                <dd class="text-gray-900 dark:text-gray-100">@Company.IDNumber</dd>

                <dt class="font-medium text-gray-700 dark:text-gray-300">@ResourceIdentity.PersonOrganisationNr</dt>
                <dd class="text-gray-900 dark:text-gray-100">@Company.PIDNumber</dd>

                <dt class="font-medium text-gray-700 dark:text-gray-300">@ResourceIdentity.PersonOrganisationType</dt>
                <dd class="text-gray-900 dark:text-gray-100">@Company.Type</dd>

                <dt class="font-medium text-gray-700 dark:text-gray-300">@CalcResource.status</dt>
                <dd class="text-gray-900 dark:text-gray-100">@Company.Status</dd>

                <dt class="font-medium text-gray-700 dark:text-gray-300">@ResourceIdentity.website</dt>
                <dd class="text-gray-900 dark:text-gray-100">@Company.URL</dd>

                <dt class="font-medium text-gray-700 dark:text-gray-300">@ResourceIdentity.email</dt>
                <dd class="text-gray-900 dark:text-gray-100">@Company.Email</dd>

                <dt class="font-medium text-gray-700 dark:text-gray-300">@ResourceIdentity.mobile</dt>
                <dd class="text-gray-900 dark:text-gray-100">@Company.Mobile</dd>

                <dt class="font-medium text-gray-700 dark:text-gray-300">@ResourceIdentity.phone</dt>
                <dd class="text-gray-900 dark:text-gray-100">@Company.Phone</dd>

                @if (Company.Notes is not null)
                {
                    foreach (var note in Company.Notes.Where(x => !string.IsNullOrWhiteSpace(x)))
                    {
                        <dt class="font-medium text-gray-700 dark:text-gray-300">@CalcResource.note</dt>
                        <dd class="text-gray-900 dark:text-gray-100">@note</dd>
                    }
                }
            </dl>
        }
        else if (Part == 2)
        {
            <dl class="grid grid-cols-2 gap-x-4 gap-y-2 p-2 text-sm md:grid-cols-4">
                <dt class="font-medium text-gray-700 dark:text-gray-300">@ResourceLoc.rating</dt>
                <dd class="text-gray-900 dark:text-gray-100">@Company.Rating</dd>

                <dt class="font-medium text-gray-700 dark:text-gray-300">@ResourceIdentity.numberIDCards</dt>
                <dd class="text-gray-900 dark:text-gray-100">@Company.NumberOfWorkersCards</dd>

                <dt class="font-medium text-gray-700 dark:text-gray-300">@ResourceLoc.collectiveLabourAgreement</dt>
                <dd class="text-gray-900 dark:text-gray-100">@Company.SocialLaborAgreement</dd>

                <dt class="font-medium text-gray-700 dark:text-gray-300">@ResourceLoc.InvoiceVerificationDate</dt>
                <dd class="text-gray-900 dark:text-gray-100">@Company.InvoiceVerificationDate</dd>

                <dt class="font-medium text-gray-700 dark:text-gray-300">@ResourceLoc.dateOfControl</dt>
                <dd class="text-gray-900 dark:text-gray-100">@Company.VerificationDate</dd>

                <dt class="font-medium text-gray-700 dark:text-gray-300">@ResourceApp.qualitySystems</dt>
                <dd class="text-gray-900 dark:text-gray-100">@Company.QualitySystems</dd>

                <dt class="font-medium text-gray-700 dark:text-gray-300">@ResourceApp.environmentalSystems</dt>
                <dd class="text-gray-900 dark:text-gray-100">@Company.EnvironmentalSystems</dd>
            </dl>
        }
        else if (Part == 3)
        {
            <dl class="grid grid-cols-1 gap-y-2 p-2 text-sm md:grid-cols-4">
                <dt class="font-medium text-gray-700 dark:text-gray-300">@ResourceLoc.baseCategory</dt>
                <dd class="text-gray-900 dark:text-gray-100 md:col-span-3">@Company.Category</dd>
            </dl>
        }
        else if (Part == 4)
        {
            @if (Company.Contacts?.Any() == true)
            {
                <table class="min-w-full divide-y divide-slate-200 overflow-hidden rounded-lg border border-slate-200 text-sm dark:divide-slate-700 dark:border-slate-700">
                    <thead>
                        <tr>
                            <th class="px-3 py-2 text-right text-sm font-semibold text-slate-600 dark:text-slate-200">@CalcResource.name</th>
                            <th class="px-3 py-2 text-right text-sm font-semibold text-slate-600 dark:text-slate-200">@ResourceIdentity.mobile / @ResourceIdentity.telefon</th>
                            <th class="px-3 py-2 text-right text-sm font-semibold text-slate-600 dark:text-slate-200">@CalcResource.status</th>
                            <th class="px-3 py-2 text-right text-sm font-semibold text-slate-600 dark:text-slate-200">@ResourceIdentity.email</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Company.Contacts)
                        {
                            <tr class="border-b border-slate-100 text-slate-700 dark:border-slate-800 dark:text-slate-200">
                                <th class="px-3 py-2 text-right font-medium">
                                    @if (!string.IsNullOrEmpty(item.Note))
                                    {
                                        <span @onclick="() => item.CommentIsVisible = !item.CommentIsVisible">
                                            @((MarkupString)Icons.TopBottom(item.CommentIsVisible))
                                        </span>
                                    }
                                    @item.GetFullName()
                                </th>
                                <td class="px-3 py-2 text-right">@item.Mobile / @item.Telefone</td>
                                <td class="px-3 py-2 text-right">@item.Status</td>
                                <td class="px-3 py-2 text-right">@item.Email</td>
                            </tr>

                            @if (item.CommentIsVisible)
                            {
                                <tr class="bg-slate-50 text-slate-600 dark:bg-slate-800/60 dark:text-slate-300">
                                    <td colspan="5" class="px-3 py-2 text-right">@CalcResource.note: @item.Note</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="rounded-xl border border-dashed border-slate-300 px-4 py-6 text-sm text-slate-600 dark:border-slate-700 dark:text-slate-300">
                    @WebLoc[nameof(PMWebResource.NoContactsAvailable)]
                </div>
            }
        }
    }
</div>

<div class="mt-3 flex items-center justify-end gap-2 border-t border-slate-200 pt-3 dark:border-slate-700">
    <button type="button" class="inline-flex items-center justify-center rounded-md border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-700 transition hover:bg-slate-50 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-800" @onclick="Close">
        @WebLoc[nameof(PMWebResource.Close)]
    </button>
</div>
