@using Application.Feature.Calculation.TemplateTable.Commands
@using Application.Feature.Calculation.TemplateTable.Queries
@using Application.Feature.Identity.Department.Queries
@using ProjectManagement.Client.Constant
@using ProjectManagement.Client.Shared.Model.Project.Calculation
@using ProjectManagement.Shared.DTO.Calculation.Template
@using ProjectManagement.Shared.DTO.General
@using System.Security.Claims
@inherits AppComponentBase
@inject AuthenticationStateProvider AuthenticationStateProvider

@if (Form is not null)
{
    <TemplateForm @key="Form"
                  TempForm="Form"
                  DepartmentId="FormDepartmentId"
                  Callback="CallBack"></TemplateForm>
}
else if (ColumnForm is not null)
{
    <TemplateColumnForm @key="ColumnForm"
                        TempForm="ColumnForm"
                        DepartmentId="ColumnFormDepartmentId"
                        Callback="ColumnCallBack"></TemplateColumnForm>
}
else
{
    <section class="pm-admin-panel">
        <div class="shrink-0 rounded-2xl border border-slate-200 bg-white p-2 shadow-sm dark:border-slate-700 dark:bg-slate-900">
            <!-- Fixed sub-tab row: Utseendemallar / Kolumnmallar -->
            <div class="flex items-center gap-1 border-b border-slate-200 pb-2 dark:border-slate-700">
                <button type="button" @onclick="() => SetTab(TemplateTab.Appearance)" class="@TabClass(TemplateTab.Appearance)">
                    Utseendemallar
                </button>
                <button type="button" @onclick="() => SetTab(TemplateTab.Column)" class="@TabClass(TemplateTab.Column)">
                    Kolumnmallar
                </button>
            </div>

            <!-- Fixed toolbar -->
            <div class="mt-2 flex flex-wrap items-center gap-2">
                @if (ActiveTab == TemplateTab.Appearance)
                {
                    <button @onclick="OpenCreate"
                            class="inline-flex items-center justify-center gap-2 rounded-xl bg-slate-900 px-3 py-2 text-sm font-medium text-white transition hover:bg-slate-800 disabled:cursor-not-allowed disabled:opacity-50 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-slate-200"
                            disabled="@(!CanCreateTemplate || Loading)">
                        <span class="text-base leading-none">+</span>
                        <span>Ny utseendemall</span>
                    </button>
                }
                else
                {
                    <button @onclick="OpenCreateColumn"
                            class="inline-flex items-center justify-center gap-2 rounded-xl bg-slate-900 px-3 py-2 text-sm font-medium text-white transition hover:bg-slate-800 disabled:cursor-not-allowed disabled:opacity-50 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-slate-200"
                            disabled="@(!CanCreateTemplate || Loading)">
                        <span class="text-base leading-none">+</span>
                        <span>Ny kolumnmall</span>
                    </button>
                }

                @if (CanChooseDepartment && Departments.Any())
                {
                    <select @onchange="ChangeDepartmentAsync"
                            class="min-w-[200px] rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-500/20 dark:border-slate-600 dark:bg-slate-950 dark:text-slate-100">
                        <option value="">Alla avdelningar</option>
                        @foreach (var department in Departments)
                        {
                            <option value="@department.Id" selected="@(department.Id == SelectedDepartmentId)">@department.Name</option>
                        }
                    </select>
                }

                <div class="relative ml-auto">
                    <input type="search"
                           @bind="SearchText"
                           @bind:event="oninput"
                           placeholder="Sök mall…"
                           class="h-9 w-56 rounded-xl border border-slate-300 bg-white px-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-500/20 dark:border-slate-600 dark:bg-slate-950 dark:text-slate-100" />
                </div>
            </div>
        </div>

        <div class="pm-admin-scroll">
            @if (Loading)
            {
                <div class="rounded-2xl border border-slate-200 bg-white p-2 shadow-sm dark:border-slate-700 dark:bg-slate-900">
                    <div class="animate-pulse space-y-3">
                        <div class="h-10 rounded-xl bg-slate-200 dark:bg-slate-800"></div>
                        <div class="h-10 rounded-xl bg-slate-200 dark:bg-slate-800"></div>
                        <div class="h-10 rounded-xl bg-slate-200 dark:bg-slate-800"></div>
                    </div>
                </div>
            }
            else if (ActiveTab == TemplateTab.Appearance)
            {
                @if (!AppearanceRows.Any())
                {
                    <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-center shadow-sm dark:border-slate-700 dark:bg-slate-900">
                        <h3 class="text-base font-semibold text-slate-900 dark:text-slate-100">@ResourceApp.notFoundData</h3>
                        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Utseendemallar</p>
                    </div>
                }
                else
                {
                    <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">
                        <table class="min-w-full text-sm">
                            <thead class="sticky top-0 z-10 bg-slate-50 dark:bg-slate-800/80">
                                <tr class="text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
                                    <th class="px-3 py-2">@CalcResource.name</th>
                                    <th class="px-3 py-2">Visas för</th>
                                    <th class="px-3 py-2 text-right">Åtgärder</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in AppearanceRows)
                                {
                                    <tr class="border-t border-slate-100 hover:bg-slate-50 dark:border-slate-800 dark:hover:bg-slate-800/40">
                                        <td class="px-3 py-2 font-medium text-slate-800 dark:text-slate-100">@item.Name</td>
                                        <td class="px-3 py-2 text-slate-500 dark:text-slate-400">@DepartmentLabel(item.DepartmentId)</td>
                                        <td class="px-3 py-2">
                                            <div class="flex items-center justify-end gap-1.5">
                                                <button @onclick="() => CopyAppearanceAsync(item)" disabled="@Loading" type="button"
                                                        class="inline-flex h-8 items-center justify-center gap-1 rounded-md border border-sky-300 bg-sky-50 px-2 text-xs font-medium text-sky-700 transition hover:bg-sky-100 disabled:opacity-50 dark:border-sky-700 dark:bg-sky-950/50 dark:text-sky-300 dark:hover:bg-sky-900/60"
                                                        title="Kopiera mallen till en redigerbar kopia">
                                                    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                                                    <span>Kopiera</span>
                                                </button>
                                                @if (CanEditTemplate(item.DepartmentId))
                                                {
                                                    <button @onclick="() => FormUI(item)" disabled="@Loading" type="button"
                                                            class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-amber-300 bg-amber-50 text-amber-700 transition hover:bg-amber-100 disabled:opacity-50 dark:border-amber-700 dark:bg-amber-950/50 dark:text-amber-200 dark:hover:bg-amber-900/60"
                                                            title="@ResourceApp.update">
                                                        @Icons.Edit
                                                    </button>
                                                    <button @onclick="() => Remove(item)" disabled="@Loading" type="button"
                                                            class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-rose-300 bg-rose-50 text-rose-700 transition hover:bg-rose-100 disabled:opacity-50 dark:border-rose-700 dark:bg-rose-950/50 dark:text-rose-200 dark:hover:bg-rose-900/60"
                                                            title="@ResourceApp.delete">
                                                        @((MarkupString)Icons.DeleteSVG)
                                                    </button>
                                                }
                                                else
                                                {
                                                    <span class="rounded-md border border-slate-200 bg-white px-2 py-1 text-xs text-slate-400 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-500"
                                                          title="Standardmallar kan inte redigeras direkt. Kopiera mallen för att skapa en egen version.">
                                                        @PMWebResource.ReadOnly
                                                    </span>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
            else
            {
                @if (!ColumnRows.Any())
                {
                    <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-center shadow-sm dark:border-slate-700 dark:bg-slate-900">
                        <h3 class="text-base font-semibold text-slate-900 dark:text-slate-100">@ResourceApp.notFoundData</h3>
                        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Kolumnmallar</p>
                    </div>
                }
                else
                {
                    <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">
                        <table class="min-w-full text-sm">
                            <thead class="sticky top-0 z-10 bg-slate-50 dark:bg-slate-800/80">
                                <tr class="text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
                                    <th class="px-3 py-2">@CalcResource.name</th>
                                    <th class="px-3 py-2">Visas för</th>
                                    <th class="px-3 py-2 text-right">Åtgärder</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in ColumnRows)
                                {
                                    <tr class="border-t border-slate-100 hover:bg-slate-50 dark:border-slate-800 dark:hover:bg-slate-800/40">
                                        <td class="px-3 py-2 font-medium text-slate-800 dark:text-slate-100">@item.Name</td>
                                        <td class="px-3 py-2 text-slate-500 dark:text-slate-400">@DepartmentLabel(item.DepartmentId)</td>
                                        <td class="px-3 py-2">
                                            <div class="flex items-center justify-end gap-1.5">
                                                <button @onclick="() => CopyColumnAsync(item)" disabled="@Loading" type="button"
                                                        class="inline-flex h-8 items-center justify-center gap-1 rounded-md border border-sky-300 bg-sky-50 px-2 text-xs font-medium text-sky-700 transition hover:bg-sky-100 disabled:opacity-50 dark:border-sky-700 dark:bg-sky-950/50 dark:text-sky-300 dark:hover:bg-sky-900/60"
                                                        title="Kopiera mallen till en redigerbar kopia">
                                                    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                                                    <span>Kopiera</span>
                                                </button>
                                                @if (CanEditTemplate(item.DepartmentId))
                                                {
                                                    <button @onclick="() => ColumnFormUI(item)" disabled="@Loading" type="button"
                                                            class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-amber-300 bg-amber-50 text-amber-700 transition hover:bg-amber-100 disabled:opacity-50 dark:border-amber-700 dark:bg-amber-950/50 dark:text-amber-200 dark:hover:bg-amber-900/60"
                                                            title="@ResourceApp.update">
                                                        @Icons.Edit
                                                    </button>
                                                    <button @onclick="() => RemoveColumn(item)" disabled="@Loading" type="button"
                                                            class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-rose-300 bg-rose-50 text-rose-700 transition hover:bg-rose-100 disabled:opacity-50 dark:border-rose-700 dark:bg-rose-950/50 dark:text-rose-200 dark:hover:bg-rose-900/60"
                                                            title="@ResourceApp.delete">
                                                        @((MarkupString)Icons.DeleteSVG)
                                                    </button>
                                                }
                                                else
                                                {
                                                    <span class="rounded-md border border-slate-200 bg-white px-2 py-1 text-xs text-slate-400 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-500"
                                                          title="Standardmallar kan inte redigeras direkt. Kopiera mallen för att skapa en egen version.">
                                                        @PMWebResource.ReadOnly
                                                    </span>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>
    </section>
}

@code {
    private enum TemplateTab { Appearance, Column }

    private List<TemplateListDTO> List = [];
    private List<TemplateColumnListDTO> ColumnList = [];
    private TemplateModelDTO? Form;
    private TemplateColumnModelDTO? ColumnForm;
    private bool Loading = true;
    private List<ListDTO> Departments = [];
    private bool CanChooseDepartment;
    private int? SelectedDepartmentId;
    private int? CurrentDepartmentId;
    private int? FormDepartmentId;
    private int? ColumnFormDepartmentId;

    private TemplateTab ActiveTab = TemplateTab.Appearance;
    private string SearchText = string.Empty;

    private bool CanCreateTemplate => CanChooseDepartment || CurrentDepartmentId.HasValue;
    private bool CanEditGlobalTemplates => CanChooseDepartment && !SelectedDepartmentId.HasValue;
    private bool ShowDepartmentTemplates => !CanChooseDepartment || SelectedDepartmentId.HasValue;
    private IEnumerable<TemplateListDTO> VisibleTemplates => ShowDepartmentTemplates ? List : List.Where(x => !x.DepartmentId.HasValue);
    private IEnumerable<TemplateColumnListDTO> VisibleColumnTemplates => ShowDepartmentTemplates ? ColumnList : ColumnList.Where(x => !x.DepartmentId.HasValue);

    private IEnumerable<TemplateListDTO> AppearanceRows => VisibleTemplates.Where(x => MatchesSearch(x.Name));
    private IEnumerable<TemplateColumnListDTO> ColumnRows => VisibleColumnTemplates.Where(x => MatchesSearch(x.Name));

    private bool MatchesSearch(string name)
        => string.IsNullOrWhiteSpace(SearchText) || (name?.Contains(SearchText.Trim(), StringComparison.OrdinalIgnoreCase) ?? false);

    private void SetTab(TemplateTab tab) => ActiveTab = tab;

    private string TabClass(TemplateTab tab)
        => ActiveTab == tab
            ? "rounded-lg px-3 py-1.5 text-sm font-semibold text-slate-900 bg-slate-100 dark:bg-slate-800 dark:text-slate-100"
            : "rounded-lg px-3 py-1.5 text-sm font-medium text-slate-500 transition hover:bg-slate-50 hover:text-slate-700 dark:text-slate-400 dark:hover:bg-slate-800/60 dark:hover:text-slate-200";

    // A department template is always editable by whoever sees it; common (global) templates
    // are only editable by an admin working in the "Alla avdelningar" scope.
    private bool CanEditTemplate(int? departmentId) => departmentId.HasValue || CanEditGlobalTemplates;

    private string DepartmentLabel(int? departmentId)
        => departmentId.HasValue
            ? (Departments.FirstOrDefault(d => d.Id == departmentId)?.Name ?? "Avdelning")
            : "Alla avdelningar";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        CanChooseDepartment = user.IsInRole(PMRolesConst.Tenant.Admin);
        CurrentDepartmentId = ParseNullableInt(user.FindFirst(PMClaimsConst.DepartmentId)?.Value);

        if (CanChooseDepartment)
            Departments = await Dispatcher.Send(new GetDepartmentsAsListQuery()) ?? [];
        else
            SelectedDepartmentId = CurrentDepartmentId;

        await LoadTemplatesAsync();
    }

    private async Task FormUI(TemplateListDTO template)
    {
        if (Loading)
            return;

        Loading = true;
        Form = null;
        ColumnForm = null;
        FormDepartmentId = template.DepartmentId;
        ColumnFormDepartmentId = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            Form = await Dispatcher.Send(new GetTemplateByIdQuery(template.Id, template.DepartmentId));
            if (Form is not null)
                Form.Id = template.Id;
        }
        finally
        {
            Loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ColumnFormUI(TemplateColumnListDTO templateColumn)
    {
        if (Loading)
            return;

        Loading = true;
        Form = null;
        ColumnForm = null;
        FormDepartmentId = null;
        ColumnFormDepartmentId = templateColumn.DepartmentId;
        await InvokeAsync(StateHasChanged);

        try
        {
            ColumnForm = await Dispatcher.Send(new GetTemplateColumnByIdQuery(templateColumn.Id, templateColumn.DepartmentId));
            if (ColumnForm is not null)
                ColumnForm.Id = templateColumn.Id;
        }
        finally
        {
            Loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ChangeDepartmentAsync(ChangeEventArgs e)
    {
        SelectedDepartmentId = ParseNullableInt(e.Value?.ToString());
        await LoadTemplatesAsync();
    }

    private async Task LoadTemplatesAsync()
    {
        Loading = true;
        await InvokeAsync(StateHasChanged);
        List = await Dispatcher.Send(new GetTemplatesByUserQuery(EffectiveDepartmentId)) ?? [];
        ColumnList = await Dispatcher.Send(new GetTemplateColumnsByUserQuery(EffectiveDepartmentId)) ?? [];
        Loading = false;
        await InvokeAsync(StateHasChanged);
    }

    private void OpenCreate()
    {
        if (!CanCreateTemplate)
            return;

        ColumnForm = null;
        ColumnFormDepartmentId = null;
        FormDepartmentId = EffectiveDepartmentId;
        Form = new TemplateModelDTO();
    }

    private void OpenCreateColumn()
    {
        if (!CanCreateTemplate)
            return;

        Form = null;
        FormDepartmentId = null;
        ColumnFormDepartmentId = EffectiveDepartmentId;
        ColumnForm = new TemplateColumnModelDTO();
    }

    private void Remove(TemplateListDTO template)
        => MHD.DeleteMessage(template.Name, EventCallback.Factory.Create(this, () => ConfirmRemoveAsync(template)));

    private void RemoveColumn(TemplateColumnListDTO templateColumn)
        => MHD.DeleteMessage(templateColumn.Name, EventCallback.Factory.Create(this, () => ConfirmRemoveColumnAsync(templateColumn)));

    private async Task ConfirmRemoveAsync(TemplateListDTO template)
    {
        var deleted = await Dispatcher.Send(new DeleteTemplateCommand(template.Id, template.DepartmentId));
        if (deleted)
        {
            List.Remove(template);
            await InvokeAsync(StateHasChanged);
        }

        MHD.Notifications(ToastType.Delete, deleted);
    }

    private async Task ConfirmRemoveColumnAsync(TemplateColumnListDTO templateColumn)
    {
        var deleted = await Dispatcher.Send(new DeleteTemplateColumnCommand(templateColumn.Id, templateColumn.DepartmentId));
        if (deleted)
        {
            ColumnList.Remove(templateColumn);
            await InvokeAsync(StateHasChanged);
        }

        MHD.Notifications(ToastType.Delete, deleted);
    }

    private async Task CopyAppearanceAsync(TemplateListDTO item)
    {
        if (Loading)
            return;

        var created = await Dispatcher.Send(new CopyTemplateCommand(item.Id, item.DepartmentId, EffectiveDepartmentId));
        var ok = created is not null && created.Id > 0;
        MHD.Notifications(ToastType.Add, ok);

        if (ok)
            await LoadTemplatesAsync();
    }

    private async Task CopyColumnAsync(TemplateColumnListDTO item)
    {
        if (Loading)
            return;

        var created = await Dispatcher.Send(new CopyTemplateColumnCommand(item.Id, item.DepartmentId, EffectiveDepartmentId));
        var ok = created is not null && created.Id > 0;
        MHD.Notifications(ToastType.Add, ok);

        if (ok)
            await LoadTemplatesAsync();
    }

    private async Task CallBack(bool refresh)
    {
        if (refresh)
            await LoadTemplatesAsync();

        Form = null;
        FormDepartmentId = null;
        Loading = false;
    }

    private async Task ColumnCallBack(bool refresh)
    {
        if (refresh)
            await LoadTemplatesAsync();

        ColumnForm = null;
        ColumnFormDepartmentId = null;
        Loading = false;
    }

    private int? EffectiveDepartmentId => CanChooseDepartment ? SelectedDepartmentId : CurrentDepartmentId;

    private static int? ParseNullableInt(string? value)
        => int.TryParse(value, out var parsed) ? parsed : null;
}
