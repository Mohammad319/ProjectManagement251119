@using Application.Feature.Calculation.TemplateTable.Commands
@using Application.Feature.Calculation.TemplateTable.Queries
@using Application.Feature.Identity.Department.Queries
@using ProjectManagement.Client.Constant
@using ProjectManagement.Client.Shared.Model.Project.Calculation
@using ProjectManagement.Shared.DTO.Calculation.Template
@using ProjectManagement.Shared.DTO.General
@using System.Security.Claims
@inherits AppComponentBase
@inject AuthenticationStateProvider AuthenticationStateProvider

@if (Form is not null)
{
    <TemplateForm @key="Form"
                  TempForm="Form"
                  DepartmentId="FormDepartmentId"
                  Callback="CallBack"></TemplateForm>
}
else if (ColumnForm is not null)
{
    <TemplateColumnForm @key="ColumnForm"
                        TempForm="ColumnForm"
                        DepartmentId="ColumnFormDepartmentId"
                        Callback="ColumnCallBack"></TemplateColumnForm>
}
else
{
    <section class="space-y-4">
        <div class="rounded-2xl border border-slate-200 bg-white p-2 shadow-sm dark:border-slate-700 dark:bg-slate-900">
            <div class="flex flex-col gap-2 lg:flex-row lg:items-center lg:justify-between">
       
                <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
                    @if (CanChooseDepartment && Departments.Any())
                    {
                        <div class="min-w-[240px]">
                            <select @onchange="ChangeDepartmentAsync"
                                    class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-500/20 dark:border-slate-600 dark:bg-slate-950 dark:text-slate-100">
                                <option value="">@PMWebResource.GlobalTemplates</option>
                                @foreach (var department in Departments)
                                {
                                    <option value="@department.Id" selected="@(department.Id == SelectedDepartmentId)">@department.Name</option>
                                }
                            </select>
                        </div>
                    }

                    <button @onclick="OpenCreate"
                            class="inline-flex items-center justify-center gap-2 rounded-xl bg-slate-900 px-3 py-2 text-sm font-medium text-white transition hover:bg-slate-800 disabled:cursor-not-allowed disabled:opacity-50 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-slate-200"
                            disabled="@(!CanCreateTemplate || Loading)">
                        <span class="text-base leading-none">+</span>
                        <span>@PMWebResource.NewTemplate</span>
                    </button>

                    <button @onclick="OpenCreateColumn"
                            class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-800 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-600 dark:bg-slate-950 dark:text-slate-100 dark:hover:bg-slate-800"
                            disabled="@(!CanCreateTemplate || Loading)">
                        <span class="text-base leading-none">+</span>
                        <span>New column template</span>
                    </button>
                </div>
            </div>
        </div>

        @if (Loading)
        {
            <div class="rounded-2xl border border-slate-200 bg-white p-2 shadow-sm dark:border-slate-700 dark:bg-slate-900">
                <div class="animate-pulse space-y-3">
                    <div class="h-10 rounded-xl bg-slate-200 dark:bg-slate-800"></div>
                    <div class="h-10 rounded-xl bg-slate-200 dark:bg-slate-800"></div>
                    <div class="h-10 rounded-xl bg-slate-200 dark:bg-slate-800"></div>
                </div>
            </div>
        }
        else if (!VisibleTemplates.Any() && !VisibleColumnTemplates.Any())
        {
            <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-center shadow-sm dark:border-slate-700 dark:bg-slate-900">
                <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-slate-100 text-slate-500 dark:bg-slate-800 dark:text-slate-300">T</div>
                <h3 class="text-base font-semibold text-slate-900 dark:text-slate-100">@ResourceApp.notFoundData</h3>
                <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">@ResourceLoc.templates</p>
            </div>
        }
        else
        {
            @if (ShowDepartmentTemplates && List.Any(x => x.DepartmentId.HasValue))
            {
                <div class="grid grid-cols-1 gap-2 md:grid-cols-2 lg:grid-cols-3">
                    @foreach (var item in List.Where(x => x.DepartmentId.HasValue))
                    {
                        <article class="rounded-xl border border-slate-200 bg-white p-3 shadow-sm transition hover:border-slate-300 dark:border-slate-700 dark:bg-slate-900 dark:hover:border-slate-600">
                            <div class="flex items-start justify-between gap-2">
                                <h4 class="truncate text-sm font-semibold text-slate-800 dark:text-slate-100">@item.Name</h4>

                                <div class="flex items-center gap-1.5">
                                    <button @onclick="() => FormUI(item)"
                                            class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-amber-300 bg-amber-50 text-amber-700 transition hover:bg-amber-100 disabled:cursor-not-allowed disabled:opacity-50 dark:border-amber-700 dark:bg-amber-950/50 dark:text-amber-200 dark:hover:bg-amber-900/60"
                                            disabled="@Loading"
                                            type="button">
                                        @Icons.Edit
                                    </button>

                                    <button @onclick="() => Remove(item)"
                                            class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-rose-300 bg-rose-50 text-rose-700 transition hover:bg-rose-100 disabled:cursor-not-allowed disabled:opacity-50 dark:border-rose-700 dark:bg-rose-950/50 dark:text-rose-200 dark:hover:bg-rose-900/60"
                                            disabled="@Loading"
                                            type="button">
                                        @((MarkupString)Icons.DeleteSVG)
                                    </button>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }

            @if (ShowDepartmentTemplates && ColumnList.Any(x => x.DepartmentId.HasValue))
            {
                <div class="space-y-2">
                    <div class="flex items-center gap-2 px-1">
                        <h3 class="text-sm font-semibold text-slate-700 dark:text-slate-200">Column templates</h3>
                    </div>

                    <div class="grid grid-cols-1 gap-2 md:grid-cols-2 lg:grid-cols-3">
                        @foreach (var item in ColumnList.Where(x => x.DepartmentId.HasValue))
                        {
                            <article class="rounded-xl border border-slate-200 bg-white p-3 shadow-sm transition hover:border-slate-300 dark:border-slate-700 dark:bg-slate-900 dark:hover:border-slate-600">
                                <div class="flex items-start justify-between gap-2">
                                    <h4 class="truncate text-sm font-semibold text-slate-800 dark:text-slate-100">@item.Name</h4>

                                    <div class="flex items-center gap-1.5">
                                        <button @onclick="() => ColumnFormUI(item)"
                                                class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-amber-300 bg-amber-50 text-amber-700 transition hover:bg-amber-100 disabled:cursor-not-allowed disabled:opacity-50 dark:border-amber-700 dark:bg-amber-950/50 dark:text-amber-200 dark:hover:bg-amber-900/60"
                                                disabled="@Loading"
                                                type="button">
                                            @Icons.Edit
                                        </button>

                                        <button @onclick="() => RemoveColumn(item)"
                                                class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-rose-300 bg-rose-50 text-rose-700 transition hover:bg-rose-100 disabled:cursor-not-allowed disabled:opacity-50 dark:border-rose-700 dark:bg-rose-950/50 dark:text-rose-200 dark:hover:bg-rose-900/60"
                                                disabled="@Loading"
                                                type="button">
                                            @((MarkupString)Icons.DeleteSVG)
                                        </button>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                </div>
            }

            @if (List.Any(x => !x.DepartmentId.HasValue))
            {
                <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
                    <div class="mb-3 flex items-center gap-2">
                        <h3 class="text-sm font-semibold text-slate-700 dark:text-slate-200">@PMWebResource.GlobalTemplates</h3>
                        @if (!CanEditGlobalTemplates)
                        {
                            <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-500 dark:bg-slate-800 dark:text-slate-400">@PMWebResource.ReadOnly</span>
                        }
                    </div>
                    <div class="grid grid-cols-1 gap-2 md:grid-cols-2 lg:grid-cols-3">
                        @foreach (var item in List.Where(x => !x.DepartmentId.HasValue))
                        {
                            <article class="rounded-xl border border-slate-200 bg-slate-50 p-3 shadow-sm dark:border-slate-700 dark:bg-slate-800/50">
                                <div class="flex items-start justify-between gap-2">
                                    <h4 class="truncate text-sm font-semibold text-slate-600 dark:text-slate-300">@item.Name</h4>
                                    @if (CanEditGlobalTemplates)
                                    {
                                        <div class="flex items-center gap-1.5">
                                            <button @onclick="() => FormUI(item)"
                                                    class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-amber-300 bg-amber-50 text-amber-700 transition hover:bg-amber-100 disabled:cursor-not-allowed disabled:opacity-50 dark:border-amber-700 dark:bg-amber-950/50 dark:text-amber-200 dark:hover:bg-amber-900/60"
                                                    disabled="@Loading"
                                                    type="button">
                                                @Icons.Edit
                                            </button>

                                            <button @onclick="() => Remove(item)"
                                                    class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-rose-300 bg-rose-50 text-rose-700 transition hover:bg-rose-100 disabled:cursor-not-allowed disabled:opacity-50 dark:border-rose-700 dark:bg-rose-950/50 dark:text-rose-200 dark:hover:bg-rose-900/60"
                                                    disabled="@Loading"
                                                    type="button">
                                                @((MarkupString)Icons.DeleteSVG)
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="shrink-0 rounded-md border border-slate-200 bg-white px-2 py-1 text-xs text-slate-400 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-500">
                                            @PMWebResource.CannotEdit
                                        </span>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                </div>
            }

            @if (ColumnList.Any(x => !x.DepartmentId.HasValue))
            {
                <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
                    <div class="mb-3 flex items-center gap-2">
                        <h3 class="text-sm font-semibold text-slate-700 dark:text-slate-200">Global column templates</h3>
                        @if (!CanEditGlobalTemplates)
                        {
                            <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-500 dark:bg-slate-800 dark:text-slate-400">@PMWebResource.ReadOnly</span>
                        }
                    </div>
                    <div class="grid grid-cols-1 gap-2 md:grid-cols-2 lg:grid-cols-3">
                        @foreach (var item in ColumnList.Where(x => !x.DepartmentId.HasValue))
                        {
                            <article class="rounded-xl border border-slate-200 bg-slate-50 p-3 shadow-sm dark:border-slate-700 dark:bg-slate-800/50">
                                <div class="flex items-start justify-between gap-2">
                                    <h4 class="truncate text-sm font-semibold text-slate-600 dark:text-slate-300">@item.Name</h4>
                                    @if (CanEditGlobalTemplates)
                                    {
                                        <div class="flex items-center gap-1.5">
                                            <button @onclick="() => ColumnFormUI(item)"
                                                    class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-amber-300 bg-amber-50 text-amber-700 transition hover:bg-amber-100 disabled:cursor-not-allowed disabled:opacity-50 dark:border-amber-700 dark:bg-amber-950/50 dark:text-amber-200 dark:hover:bg-amber-900/60"
                                                    disabled="@Loading"
                                                    type="button">
                                                @Icons.Edit
                                            </button>

                                            <button @onclick="() => RemoveColumn(item)"
                                                    class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-rose-300 bg-rose-50 text-rose-700 transition hover:bg-rose-100 disabled:cursor-not-allowed disabled:opacity-50 dark:border-rose-700 dark:bg-rose-950/50 dark:text-rose-200 dark:hover:bg-rose-900/60"
                                                    disabled="@Loading"
                                                    type="button">
                                                @((MarkupString)Icons.DeleteSVG)
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="shrink-0 rounded-md border border-slate-200 bg-white px-2 py-1 text-xs text-slate-400 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-500">
                                            @PMWebResource.CannotEdit
                                        </span>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                </div>
            }
        }
    </section>
}

@code {
    private List<TemplateListDTO> List = [];
    private List<TemplateColumnListDTO> ColumnList = [];
    private TemplateModelDTO? Form;
    private TemplateColumnModelDTO? ColumnForm;
    private bool Loading = true;
    private List<ListDTO> Departments = [];
    private bool CanChooseDepartment;
    private int? SelectedDepartmentId;
    private int? CurrentDepartmentId;
    private int? FormDepartmentId;
    private int? ColumnFormDepartmentId;

    private bool CanCreateTemplate => CanChooseDepartment || CurrentDepartmentId.HasValue;
    private bool CanEditGlobalTemplates => CanChooseDepartment && !SelectedDepartmentId.HasValue;
    private bool ShowDepartmentTemplates => !CanChooseDepartment || SelectedDepartmentId.HasValue;
    private IEnumerable<TemplateListDTO> VisibleTemplates => ShowDepartmentTemplates ? List : List.Where(x => !x.DepartmentId.HasValue);
    private IEnumerable<TemplateColumnListDTO> VisibleColumnTemplates => ShowDepartmentTemplates ? ColumnList : ColumnList.Where(x => !x.DepartmentId.HasValue);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        CanChooseDepartment = user.IsInRole(PMRolesConst.Tenant.Admin);
        CurrentDepartmentId = ParseNullableInt(user.FindFirst(PMClaimsConst.DepartmentId)?.Value);

        if (CanChooseDepartment)
            Departments = await Dispatcher.Send(new GetDepartmentsAsListQuery()) ?? [];
        else
            SelectedDepartmentId = CurrentDepartmentId;

        await LoadTemplatesAsync();
    }

    private async Task FormUI(TemplateListDTO template)
    {
        if (Loading)
            return;

        Loading = true;
        Form = null;
        ColumnForm = null;
        FormDepartmentId = template.DepartmentId;
        ColumnFormDepartmentId = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            Form = await Dispatcher.Send(new GetTemplateByIdQuery(template.Id, template.DepartmentId));
            if (Form is not null)
                Form.Id = template.Id;
        }
        finally
        {
            Loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ColumnFormUI(TemplateColumnListDTO templateColumn)
    {
        if (Loading)
            return;

        Loading = true;
        Form = null;
        ColumnForm = null;
        FormDepartmentId = null;
        ColumnFormDepartmentId = templateColumn.DepartmentId;
        await InvokeAsync(StateHasChanged);

        try
        {
            ColumnForm = await Dispatcher.Send(new GetTemplateColumnByIdQuery(templateColumn.Id, templateColumn.DepartmentId));
            if (ColumnForm is not null)
                ColumnForm.Id = templateColumn.Id;
        }
        finally
        {
            Loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ChangeDepartmentAsync(ChangeEventArgs e)
    {
        SelectedDepartmentId = ParseNullableInt(e.Value?.ToString());
        await LoadTemplatesAsync();
    }

    private async Task LoadTemplatesAsync()
    {
        Loading = true;
        await InvokeAsync(StateHasChanged);
        List = await Dispatcher.Send(new GetTemplatesByUserQuery(EffectiveDepartmentId)) ?? [];
        ColumnList = await Dispatcher.Send(new GetTemplateColumnsByUserQuery(EffectiveDepartmentId)) ?? [];
        Loading = false;
        await InvokeAsync(StateHasChanged);
    }

    private void OpenCreate()
    {
        if (!CanCreateTemplate)
            return;

        ColumnForm = null;
        ColumnFormDepartmentId = null;
        FormDepartmentId = EffectiveDepartmentId;
        Form = new TemplateModelDTO();
    }

    private void OpenCreateColumn()
    {
        if (!CanCreateTemplate)
            return;

        Form = null;
        FormDepartmentId = null;
        ColumnFormDepartmentId = EffectiveDepartmentId;
        ColumnForm = new TemplateColumnModelDTO();
    }

    private void Remove(TemplateListDTO template)
        => MHD.DeleteMessage(template.Name, EventCallback.Factory.Create(this, () => ConfirmRemoveAsync(template)));

    private void RemoveColumn(TemplateColumnListDTO templateColumn)
        => MHD.DeleteMessage(templateColumn.Name, EventCallback.Factory.Create(this, () => ConfirmRemoveColumnAsync(templateColumn)));

    private async Task ConfirmRemoveAsync(TemplateListDTO template)
    {
        var deleted = await Dispatcher.Send(new DeleteTemplateCommand(template.Id, template.DepartmentId));
        if (deleted)
        {
            List.Remove(template);
            await InvokeAsync(StateHasChanged);
        }

        MHD.Notifications(ToastType.Delete, deleted);
    }

    private async Task ConfirmRemoveColumnAsync(TemplateColumnListDTO templateColumn)
    {
        var deleted = await Dispatcher.Send(new DeleteTemplateColumnCommand(templateColumn.Id, templateColumn.DepartmentId));
        if (deleted)
        {
            ColumnList.Remove(templateColumn);
            await InvokeAsync(StateHasChanged);
        }

        MHD.Notifications(ToastType.Delete, deleted);
    }

    private async Task CallBack(bool refresh)
    {
        if (refresh)
            await LoadTemplatesAsync();

        Form = null;
        FormDepartmentId = null;
        Loading = false;
    }

    private async Task ColumnCallBack(bool refresh)
    {
        if (refresh)
            await LoadTemplatesAsync();

        ColumnForm = null;
        ColumnFormDepartmentId = null;
        Loading = false;
    }

    private int? EffectiveDepartmentId => CanChooseDepartment ? SelectedDepartmentId : CurrentDepartmentId;

    private static int? ParseNullableInt(string? value)
        => int.TryParse(value, out var parsed) ? parsed : null;
}
