@using Application.Feature.Calculation.TemplateTable.Commands
@using Application.Feature.Calculation.TemplateTable.Queries
@using Application.Feature.Identity.Department.Queries
@using ProjectManagement.Client.Constant
@using ProjectManagement.Client.Shared.Model.Project.Calculation
@using ProjectManagement.Shared.DTO.Calculation.Template
@using ProjectManagement.Shared.DTO.General
@using System.Security.Claims
@inherits AppComponentBase
@inject AuthenticationStateProvider AuthenticationStateProvider

@if (Form is not null)
{
    <TemplateForm TempForm="Form" Callback="CallBack"></TemplateForm>

}
else
{
    <section class="space-y-4">
        <div class="rounded-2xl border border-slate-200 bg-white p-1 shadow-sm dark:border-slate-700 dark:bg-slate-900">
            <div class="flex flex-col gap-2 lg:flex-row lg:items-end lg:justify-between">
       
                <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
                    @if (CanChooseDepartment && Departments.Any())
                    {
                        <div class="min-w-[240px]">
                            <select @onchange="ChangeDepartmentAsync"
                                    class="w-full rounded-xl border border-slate-300 bg-white px-1.5 py-1 text-sm text-slate-900 shadow-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-500/20 dark:border-slate-600 dark:bg-slate-950 dark:text-slate-100">
                                <option value="">@ResourceApp.department</option>
                                @foreach (var department in Departments)
                                {
                                    <option value="@department.Id" selected="@(department.Id == SelectedDepartmentId)">@department.Name</option>
                                }
                            </select>
                        </div>
                    }

                    <button @onclick="OpenCreate"
                            class="inline-flex items-center justify-center gap-2 rounded-xl bg-slate-900 px-1.5 py-1 text-sm font-medium text-white transition hover:bg-slate-800 disabled:cursor-not-allowed disabled:opacity-50 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-slate-200"
                            disabled="@(!CanCreateTemplate)">
                        <span class="text-base leading-none">+</span>
                        <span>New template</span>
                    </button>
                </div>
            </div>
        </div>

        @if (Loading)
        {
            <div class="rounded-2xl border border-slate-200 bg-white p-1 shadow-sm dark:border-slate-700 dark:bg-slate-900">
                <div class="animate-pulse space-y-3">
                    <div class="h-10 rounded-xl bg-slate-200 dark:bg-slate-800"></div>
                    <div class="h-10 rounded-xl bg-slate-200 dark:bg-slate-800"></div>
                    <div class="h-10 rounded-xl bg-slate-200 dark:bg-slate-800"></div>
                </div>
            </div>
        }
        else if (List.Count == 0)
        {
            <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-center shadow-sm dark:border-slate-700 dark:bg-slate-900">
                <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-slate-100 text-slate-500 dark:bg-slate-800 dark:text-slate-300">T</div>
                <h3 class="text-base font-semibold text-slate-900 dark:text-slate-100">@ResourceApp.notFoundData</h3>
                <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">@ResourceLoc.templates</p>
            </div>
        }
        else
        {
            <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-slate-200 text-sm dark:divide-slate-700">
                        <thead class="bg-slate-50 dark:bg-slate-800/70">
                            <tr>
                                <th class="w-40 px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Actions</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">@CalcResource.name</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                            @foreach (var item in List)
                            {
                                <tr class="transition hover:bg-slate-50 dark:hover:bg-slate-800/60">
                                    <td class="px-4 py-3 align-top">
                                        <div class="flex flex-wrap items-center gap-2">
                                            <button @onclick="() => FormUI(item.Id)"
                                                    class="inline-flex items-center rounded-lg border border-amber-300 bg-amber-50 px-3 py-1.5 text-xs font-medium text-amber-700 transition hover:bg-amber-100 disabled:cursor-not-allowed disabled:opacity-50 dark:border-amber-700 dark:bg-amber-950/50 dark:text-amber-200 dark:hover:bg-amber-900/60"
                                                    disabled="@Loading"
                                                    type="button">
                                                @Icons.Edit
                                            </button>

                                            <button @onclick="() => Remove(item)"
                                                    class="inline-flex items-center rounded-lg border border-rose-300 bg-rose-50 px-3 py-1.5 text-xs font-medium text-rose-700 transition hover:bg-rose-100 disabled:cursor-not-allowed disabled:opacity-50 dark:border-rose-700 dark:bg-rose-950/50 dark:text-rose-200 dark:hover:bg-rose-900/60"
                                                    disabled="@Loading"
                                                    type="button">
                                                @((MarkupString)Icons.DeleteSVG)
                                            </button>
                                        </div>
                                    </td>
                                    <td class="px-4 py-3 font-medium text-slate-800 dark:text-slate-100">@item.Name</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </section>
}

@code {
    private List<TemplateListDTO> List = [];
    private TemplateModelDTO? Form;
    private bool Loading = true;
    private List<ListDTO> Departments = [];
    private bool CanChooseDepartment;
    private int? SelectedDepartmentId;
    private int? CurrentDepartmentId;

    private bool CanCreateTemplate => true|| !CanChooseDepartment || SelectedDepartmentId.HasValue;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        CanChooseDepartment = user.IsInRole(PMRolesConst.Tenant.Admin);
        CurrentDepartmentId = ParseNullableInt(user.FindFirst(PMClaimsConst.DepartmentId)?.Value);

        if (CanChooseDepartment)
            Departments = await Dispatcher.Send(new GetDepartmentsAsListQuery()) ?? [];
        else
            SelectedDepartmentId = CurrentDepartmentId;

        await LoadTemplatesAsync();
    }

    private async Task FormUI(int id)
    {
        Form = await Dispatcher.Send(new GetTemplateByIdQuery(id, EffectiveDepartmentId));
        if (Form is not null)
            Form.Id = id;
    }

    private async Task ChangeDepartmentAsync(ChangeEventArgs e)
    {
        SelectedDepartmentId = ParseNullableInt(e.Value?.ToString());
        await LoadTemplatesAsync();
    }

    private async Task LoadTemplatesAsync()
    {
        Loading = true;
        await InvokeAsync(StateHasChanged);
        List = await Dispatcher.Send(new GetTemplatesByUserQuery(EffectiveDepartmentId)) ?? [];
        Loading = false;
        await InvokeAsync(StateHasChanged);
    }

    private void OpenCreate()
    {
        if (!CanCreateTemplate)
            return;

        Form = new TemplateModelDTO();
    }

    private void Remove(TemplateListDTO template)
        => MHD.DeleteMessage(template.Name, EventCallback.Factory.Create(this, () => ConfirmRemoveAsync(template)));

    private async Task ConfirmRemoveAsync(TemplateListDTO template)
    {
        var deleted = await Dispatcher.Send(new DeleteTemplateCommand(template.Id, EffectiveDepartmentId));
        if (deleted)
        {
            List.Remove(template);
            await InvokeAsync(StateHasChanged);
        }

        MHD.Notifications(ToastType.Delete, deleted);
    }

    private async Task CallBack(bool refresh)
    {
        if (refresh)
            await LoadTemplatesAsync();

        Form = null;
        Loading = false;
    }

    private int? EffectiveDepartmentId => CanChooseDepartment ? SelectedDepartmentId : CurrentDepartmentId;

    private static int? ParseNullableInt(string? value)
        => int.TryParse(value, out var parsed) ? parsed : null;
}
