    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        CanChooseDepartment = user.IsInRole(PMRolesConst.Tenant.Admin);
        CurrentDepartmentId = ParseNullableInt(user.FindFirst(PMClaimsConst.DepartmentId)?.Value);

        if (CanChooseDepartment)
            Departments = await Dispatcher.Send(new GetDepartmentsAsListQuery()) ?? [];
        else
            SelectedDepartmentId = CurrentDepartmentId;

        await LoadTemplatesAsync();
    }

    private async Task FormUI(TemplateListDTO template)
    {
        if (Loading || IsStandardAppearance(template) || !CanEditTemplate(template.DepartmentId))
            return;

        Loading = true;
        Form = null;
        ColumnForm = null;
        FormDepartmentId = template.DepartmentId;
        ColumnFormDepartmentId = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            Form = await Dispatcher.Send(new GetTemplateByIdQuery(template.Id, template.DepartmentId));
            if (Form is not null)
                Form.Id = template.Id;
        }
        finally
        {
            Loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ColumnFormUI(TemplateColumnListDTO templateColumn)
    {
        if (Loading || IsStandardColumn(templateColumn) || !CanEditTemplate(templateColumn.DepartmentId))
            return;

        Loading = true;
        Form = null;
        ColumnForm = null;
        FormDepartmentId = null;
        ColumnFormDepartmentId = templateColumn.DepartmentId;
        await InvokeAsync(StateHasChanged);

        try
        {
            ColumnForm = await Dispatcher.Send(new GetTemplateColumnByIdQuery(templateColumn.Id, templateColumn.DepartmentId));
            if (ColumnForm is not null)
                ColumnForm.Id = templateColumn.Id;
        }
        finally
        {
            Loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadTemplatesAsync()
    {
        Loading = true;
        await InvokeAsync(StateHasChanged);
        List = await Dispatcher.Send(new GetTemplatesByUserQuery(EffectiveDepartmentId)) ?? [];
        ColumnList = await Dispatcher.Send(new GetTemplateColumnsByUserQuery(EffectiveDepartmentId)) ?? [];
        Loading = false;
        await InvokeAsync(StateHasChanged);
    }

    private void OpenCreate()
    {
        if (!CanCreateTemplate)
            return;

        ColumnForm = null;
        ColumnFormDepartmentId = null;
        FormDepartmentId = EffectiveDepartmentId;
        Form = new TemplateModelDTO { IsVisible = true };
    }

    private void OpenCreateColumn()
    {
        if (!CanCreateTemplate)
            return;

        Form = null;
        FormDepartmentId = null;
        ColumnFormDepartmentId = EffectiveDepartmentId;
        ColumnForm = new TemplateColumnModelDTO { IsVisible = true };
    }

    private void Remove(TemplateListDTO template)
    {
        if (IsStandardAppearance(template) || !CanEditTemplate(template.DepartmentId))
            return;

        MHD.DeleteMessage(DisplayName(template.Name, TemplateTab.Appearance), EventCallback.Factory.Create(this, () => ConfirmRemoveAsync(template)));
    }

    private void RemoveColumn(TemplateColumnListDTO templateColumn)
    {
        if (IsStandardColumn(templateColumn) || !CanEditTemplate(templateColumn.DepartmentId))
            return;

        MHD.DeleteMessage(DisplayName(templateColumn.Name, TemplateTab.Column), EventCallback.Factory.Create(this, () => ConfirmRemoveColumnAsync(templateColumn)));
    }

    private async Task ConfirmRemoveAsync(TemplateListDTO template)
    {
        var deleted = await Dispatcher.Send(new DeleteTemplateCommand(template.Id, template.DepartmentId));
        if (deleted)
        {
            List.Remove(template);
            await InvokeAsync(StateHasChanged);
        }

        MHD.Notifications(ToastType.Delete, deleted);
    }

    private async Task ConfirmRemoveColumnAsync(TemplateColumnListDTO templateColumn)
    {
        var deleted = await Dispatcher.Send(new DeleteTemplateColumnCommand(templateColumn.Id, templateColumn.DepartmentId));
        if (deleted)
        {
            ColumnList.Remove(templateColumn);
            await InvokeAsync(StateHasChanged);
        }

        MHD.Notifications(ToastType.Delete, deleted);
    }

    private async Task ToggleAppearanceVisibilityAsync(TemplateListDTO item)
    {
        if (Loading || IsStandardAppearance(item) || !CanEditTemplate(item.DepartmentId))
            return;

        var model = await Dispatcher.Send(new GetTemplateByIdQuery(item.Id, item.DepartmentId));
        if (model is null)
        {
            MHD.Notifications(ToastType.Update, false);
            return;
        }

        var update = new TemplateListPostDTO();
        model.CopyPropertiesTo(update);
        update.Active = !item.IsVisible;

        var ok = await Dispatcher.Send(new UpdateTemplateCommand(update, item.Id, item.DepartmentId));
        if (ok)
        {
            MHD.ToastInfo(item.IsVisible ? "Mallen har dolts." : "Mallen visas igen.", string.Empty, true);
            await LoadTemplatesAsync();
        }
        else
        {
            MHD.Notifications(ToastType.Update, false);
        }
    }

    private async Task ToggleColumnVisibilityAsync(TemplateColumnListDTO item)
    {
        if (Loading || IsStandardColumn(item) || !CanEditTemplate(item.DepartmentId))
            return;

        var model = await Dispatcher.Send(new GetTemplateColumnByIdQuery(item.Id, item.DepartmentId));
        if (model is null)
        {
            MHD.Notifications(ToastType.Update, false);
            return;
        }

        var update = new TemplateColumnPostDTO
        {
            Name = model.Name,
            Active = !item.IsVisible,
            Columns = TemplateDefaults.EnsureNetCalcColumns(model.Columns)
        };

        var ok = await Dispatcher.Send(new UpdateTemplateColumnCommand(update, item.Id, item.DepartmentId));
        if (ok)
        {
            MHD.ToastInfo(item.IsVisible ? "Mallen har dolts." : "Mallen visas igen.", string.Empty, true);
            await LoadTemplatesAsync();
        }
        else
        {
            MHD.Notifications(ToastType.Update, false);
        }
    }

    private async Task CopyAppearanceAsync(TemplateListDTO item)
    {
        if (Loading)
            return;

        var created = await Dispatcher.Send(new CopyTemplateCommand(item.Id, item.DepartmentId, EffectiveDepartmentId));
        var ok = created is not null && created.Id > 0;
        if (ok)
        {
            MHD.ToastInfo("Mallen har kopierats.", string.Empty, true);
            await LoadTemplatesAsync();
        }
        else
        {
            MHD.Notifications(ToastType.Add, false);
        }
    }

    private async Task CopyColumnAsync(TemplateColumnListDTO item)
    {
        if (Loading)
            return;

        var created = await Dispatcher.Send(new CopyTemplateColumnCommand(item.Id, item.DepartmentId, EffectiveDepartmentId));
        var ok = created is not null && created.Id > 0;
        if (ok)
        {
            MHD.ToastInfo("Mallen har kopierats.", string.Empty, true);
            await LoadTemplatesAsync();
        }
        else
        {
            MHD.Notifications(ToastType.Add, false);
        }
    }

    // Admin marks a template as the standardval for its scope (company when DepartmentId is null, else the
    // department). The tab decides whether it is an appearance or a column template.
    private async Task SetDefaultAsync(int id, int? departmentId)
    {
        if (Loading || !CanChooseDepartment)
            return;

        var ok = ActiveTab == TemplateTab.Appearance
            ? await Dispatcher.Send(new SetScopeDefaultTemplateCommand(id, departmentId))
            : await Dispatcher.Send(new SetScopeDefaultTemplateColumnCommand(id, departmentId));

        if (ok)
        {
            MHD.ToastInfo("Standardvalet har uppdaterats.", string.Empty, true);
            await LoadTemplatesAsync();
        }
        else
        {
            MHD.Notifications(ToastType.Update, false);
        }
    }

    private async Task CallBack(bool refresh)
    {
        if (refresh)
            await LoadTemplatesAsync();

        Form = null;
        FormDepartmentId = null;
        Loading = false;
    }

    private async Task ColumnCallBack(bool refresh)
    {
        if (refresh)
            await LoadTemplatesAsync();

        ColumnForm = null;
        ColumnFormDepartmentId = null;
        Loading = false;
    }

    private int? EffectiveDepartmentId => CanChooseDepartment ? SelectedDepartmentId : CurrentDepartmentId;

    private static int? ParseNullableInt(string? value)
        => int.TryParse(value, out var parsed) ? parsed : null;
}
