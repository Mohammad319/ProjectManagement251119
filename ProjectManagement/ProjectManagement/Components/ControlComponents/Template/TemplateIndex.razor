@using Application.Feature.Calculation.TemplateTable.Commands
@using Application.Feature.Calculation.TemplateTable.Queries
@using Application.Feature.Identity.Department.Queries
@using ProjectManagement.Client.Constant
@using ProjectManagement.Client.Shared.Model.Project.Calculation
@using ProjectManagement.Components.ControlComponents.Department
@using ProjectManagement.Shared.Constants
@using ProjectManagement.Shared.DTO.Calculation.Template
@using ProjectManagement.Shared.DTO.General
@using System.Security.Claims
@inherits AppComponentBase
@inject AuthenticationStateProvider AuthenticationStateProvider

@if (Form is not null)
{
    <TemplateForm @key="Form"
                  TempForm="Form"
                  DepartmentId="FormDepartmentId"
                  Callback="CallBack"></TemplateForm>
}
else if (ColumnForm is not null)
{
    <TemplateColumnForm @key="ColumnForm"
                        TempForm="ColumnForm"
                        DepartmentId="ColumnFormDepartmentId"
                        Callback="ColumnCallBack"></TemplateColumnForm>
}
else
{
    var rowsCount = ActiveTab == TemplateTab.Appearance ? AppearanceRows.Count() : ColumnRows.Count();
    var totalCount = ActiveTab == TemplateTab.Appearance ? VisibleTemplates.Count() : VisibleColumnTemplates.Count();

    <section class="pm-admin-panel overflow-hidden">
        <div class="sticky top-0 z-30 shrink-0 rounded-2xl border border-slate-200 bg-white p-2 shadow-sm dark:border-slate-700 dark:bg-slate-900">
            <div class="flex items-center gap-1 border-b border-slate-200 pb-2 dark:border-slate-700">
                <button type="button" @onclick="() => SetTab(TemplateTab.Appearance)" class="@TabClass(TemplateTab.Appearance)">
                    Utseendemallar
                </button>
                <button type="button" @onclick="() => SetTab(TemplateTab.Column)" class="@TabClass(TemplateTab.Column)">
                    Kolumnmallar
                </button>
            </div>

            <p class="px-1 py-2 text-sm text-slate-500 dark:text-slate-400">@ActiveTabDescription</p>

            <div class="flex flex-wrap items-center gap-2">
                @if (ActiveTab == TemplateTab.Appearance)
                {
                    <button @onclick="OpenCreate"
                            class="inline-flex items-center justify-center gap-2 rounded-xl bg-slate-900 px-3 py-2 text-sm font-medium text-white transition hover:bg-slate-800 disabled:cursor-not-allowed disabled:opacity-50 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-slate-200"
                            disabled="@(!CanCreateTemplate || Loading)">
                        <span class="text-base leading-none">+</span>
                        <span>Ny utseendemall</span>
                    </button>
                }
                else
                {
                    <button @onclick="OpenCreateColumn"
                            class="inline-flex items-center justify-center gap-2 rounded-xl bg-slate-900 px-3 py-2 text-sm font-medium text-white transition hover:bg-slate-800 disabled:cursor-not-allowed disabled:opacity-50 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-slate-200"
                            disabled="@(!CanCreateTemplate || Loading)">
                        <span class="text-base leading-none">+</span>
                        <span>Ny kolumnmall</span>
                    </button>
                }

                @if (CanChooseDepartment && Departments.Any())
                {
                    <AppSelect TValue="int?"
                               Placeholder="Alla avdelningar"
                               Options="DepartmentOptions"
                               Value="SelectedDepartmentId"
                               ValueChanged="ChangeDepartmentAsync"
                               Disabled="@Loading" />
                }

                <AppSelect TValue="TemplateKindFilter"
                           Placeholder="Alla typer"
                           Options="KindFilterOptions"
                           Value="KindFilter"
                           ValueChanged="ChangeKindFilter"
                           Disabled="@Loading" />

                <AppSelect TValue="TemplateStatusFilter"
                           Placeholder="Alla statusar"
                           Options="StatusFilterOptions"
                           Value="StatusFilter"
                           ValueChanged="ChangeStatusFilter"
                           Disabled="@Loading" />

                <span class="rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1.5 text-xs font-medium text-slate-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300">
                    Visar @rowsCount av @totalCount
                </span>

                <div class="relative ml-auto">
                    <input type="search"
                           @bind="SearchText"
                           @bind:event="oninput"
                           placeholder="Sök mall..."
                           class="h-9 w-56 rounded-xl border border-slate-300 bg-white px-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-500/20 dark:border-slate-600 dark:bg-slate-950 dark:text-slate-100" />
                </div>
            </div>
        </div>

        <div class="min-h-0 flex-1 overflow-hidden">
            @if (Loading)
            {
                <div class="rounded-2xl border border-slate-200 bg-white p-2 shadow-sm dark:border-slate-700 dark:bg-slate-900">
                    <div class="animate-pulse space-y-3">
                        <div class="h-10 rounded-xl bg-slate-200 dark:bg-slate-800"></div>
                        <div class="h-10 rounded-xl bg-slate-200 dark:bg-slate-800"></div>
                        <div class="h-10 rounded-xl bg-slate-200 dark:bg-slate-800"></div>
                    </div>
                </div>
            }
            else if (ActiveTab == TemplateTab.Appearance)
            {
                var appearanceRows = AppearanceRows.ToList();
                if (!appearanceRows.Any())
                {
                    <TemplateEmptyState Title="Utseendemallar" />
                }
                else
                {
                    <div class="flex h-full min-h-0 flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">
                        <div class="min-h-0 flex-1 overflow-auto">
                            <table class="min-w-full border-separate border-spacing-0 text-sm">
                                <thead class="sticky top-0 z-20 bg-slate-50 shadow-sm dark:bg-slate-800">
                                    <tr class="text-left text-xs font-semibold text-slate-500 dark:text-slate-400">
                                        <th class="border-b border-slate-200 px-3 py-2 dark:border-slate-700">Namn</th>
                                        <th class="border-b border-slate-200 px-3 py-2 dark:border-slate-700">Visas för</th>
                                        <th class="border-b border-slate-200 px-3 py-2 dark:border-slate-700">Typ</th>
                                        <th class="border-b border-slate-200 px-3 py-2 dark:border-slate-700">Status</th>
                                        <th class="border-b border-slate-200 px-3 py-2 dark:border-slate-700" title="Den mall som används automatiskt när en ny kalkyl skapas.">Standardval</th>
                                        <th class="border-b border-slate-200 px-3 py-2 dark:border-slate-700">Förhandsvisning</th>
                                        <th class="border-b border-slate-200 px-3 py-2 text-right dark:border-slate-700">Åtgärder</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in appearanceRows)
                                    {
                                        var isStandard = IsStandardAppearance(item);
                                        <tr class="border-t border-slate-100 hover:bg-slate-50 dark:border-slate-800 dark:hover:bg-slate-800/40">
                                            <td class="max-w-[18rem] px-3 py-2">
                                                <div class="truncate font-medium text-slate-800 dark:text-slate-100" title="@DisplayName(item.Name, TemplateTab.Appearance)">@DisplayName(item.Name, TemplateTab.Appearance)</div>
                                            </td>
                                            <td class="px-3 py-2 text-slate-600 dark:text-slate-300">
                                                <span title="@DepartmentLabel(item.DepartmentId)">@DepartmentLabel(item.DepartmentId)</span>
                                            </td>
                                            <td class="px-3 py-2"><TemplateBadge Text="@TemplateTypeLabel(item.DepartmentId, isStandard)" Tone="blue" /></td>
                                            <td class="px-3 py-2">
                                                <div class="flex flex-wrap items-center gap-1">
                                                    <TemplateBadge Text="@(item.IsVisible ? "Synlig" : "Dold")" Tone="@(item.IsVisible ? "emerald" : "rose")" />
                                                    @if (isStandard)
                                                    {
                                                        <TemplateBadge Text="Skrivskyddad" Tone="amber" />
                                                    }
                                                </div>
                                            </td>
                                            <td class="px-3 py-2">
                                                @if (item.IsDefault)
                                                {
                                                    <span class="inline-flex items-center gap-1 text-xs font-semibold text-emerald-600 dark:text-emerald-400" title="Den mall som används automatiskt när en ny kalkyl skapas.">★ Standard</span>
                                                }
                                                else if (CanChooseDepartment)
                                                {
                                                    <button type="button" @onclick="() => SetDefaultAsync(item.Id, item.DepartmentId)" disabled="@Loading"
                                                            class="inline-flex items-center gap-1 rounded-md border border-slate-300 bg-white px-2 py-0.5 text-xs font-medium text-slate-600 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-600 dark:bg-slate-950 dark:text-slate-200 dark:hover:bg-slate-800"
                                                            title="Använd som standardval — används automatiskt för nya kalkyler i denna avdelning/företag.">
                                                        Välj som standard
                                                    </button>
                                                }
                                                else
                                                {
                                                    <span class="text-xs text-slate-400">Nej</span>
                                                }
                                            </td>
                                            <td class="px-3 py-2">
                                                <AppearancePreview Dark="@IsDarkAppearance(item)" />
                                            </td>
                                            <td class="px-3 py-2">
                                                <div class="flex items-center justify-end gap-1.5">
                                                    <button @onclick="() => CopyAppearanceAsync(item)" disabled="@Loading" type="button"
                                                            class="@ActionButtonClass("sky")"
                                                            title="Skapa en redigerbar kopia av mallen.">
                                                        @((MarkupString)CopyIcon)
                                                        <span>Kopiera</span>
                                                    </button>
                                                    <button @onclick="() => FormUI(item)" disabled="@(Loading || isStandard || !CanEditTemplate(item.DepartmentId))" type="button"
                                                            class="@IconActionButtonClass("amber")"
                                                            title="@(isStandard ? "Standardmallar kan inte redigeras direkt. Kopiera mallen för att skapa en egen version." : "Redigera mallen.")">
                                                        @Icons.Edit
                                                    </button>
                                                    <button @onclick="() => ToggleAppearanceVisibilityAsync(item)" disabled="@(Loading || isStandard || !CanEditTemplate(item.DepartmentId))" type="button"
                                                            class="@IconActionButtonClass(item.IsVisible ? "slate" : "emerald")"
                                                            title="@(item.IsVisible ? "Dölj mallen för användare." : "Gör mallen synlig för användare.")">
                                                        @((MarkupString)Icons.GetVisibleIcon(!item.IsVisible))
                                                    </button>
                                                    <button @onclick="() => Remove(item)" disabled="@(Loading || isStandard || !CanEditTemplate(item.DepartmentId))" type="button"
                                                            class="@IconActionButtonClass("rose")"
                                                            title="@(isStandard ? "Standardmallar kan inte tas bort." : "Ta bort mallen.")">
                                                        @((MarkupString)Icons.DeleteSVG)
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            }
            else
            {
                var columnRows = ColumnRows.ToList();
                if (!columnRows.Any())
                {
                    <TemplateEmptyState Title="Kolumnmallar" />
                }
                else
                {
                    <div class="flex h-full min-h-0 flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">
                        <div class="min-h-0 flex-1 overflow-auto">
                            <table class="min-w-full border-separate border-spacing-0 text-sm">
                                <thead class="sticky top-0 z-20 bg-slate-50 shadow-sm dark:bg-slate-800">
                                    <tr class="text-left text-xs font-semibold text-slate-500 dark:text-slate-400">
                                        <th class="border-b border-slate-200 px-3 py-2 dark:border-slate-700">Namn</th>
                                        <th class="border-b border-slate-200 px-3 py-2 dark:border-slate-700">Visas för</th>
                                        <th class="border-b border-slate-200 px-3 py-2 dark:border-slate-700">Typ</th>
                                        <th class="border-b border-slate-200 px-3 py-2 dark:border-slate-700">Status</th>
                                        <th class="border-b border-slate-200 px-3 py-2 dark:border-slate-700" title="Den mall som används automatiskt när en ny kalkyl skapas.">Standardval</th>
                                        <th class="border-b border-slate-200 px-3 py-2 dark:border-slate-700">Förhandsvisning</th>
                                        <th class="border-b border-slate-200 px-3 py-2 text-right dark:border-slate-700">Åtgärder</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in columnRows)
                                    {
                                        var isStandard = IsStandardColumn(item);
                                        <tr class="border-t border-slate-100 hover:bg-slate-50 dark:border-slate-800 dark:hover:bg-slate-800/40">
                                            <td class="max-w-[18rem] px-3 py-2">
                                                <div class="truncate font-medium text-slate-800 dark:text-slate-100" title="@DisplayName(item.Name, TemplateTab.Column)">@DisplayName(item.Name, TemplateTab.Column)</div>
                                            </td>
                                            <td class="px-3 py-2 text-slate-600 dark:text-slate-300">
                                                <span title="@DepartmentLabel(item.DepartmentId)">@DepartmentLabel(item.DepartmentId)</span>
                                            </td>
                                            <td class="px-3 py-2"><TemplateBadge Text="@TemplateTypeLabel(item.DepartmentId, isStandard)" Tone="blue" /></td>
                                            <td class="px-3 py-2">
                                                <div class="flex flex-wrap items-center gap-1">
                                                    <TemplateBadge Text="@(item.IsVisible ? "Synlig" : "Dold")" Tone="@(item.IsVisible ? "emerald" : "rose")" />
                                                    @if (isStandard)
                                                    {
                                                        <TemplateBadge Text="Skrivskyddad" Tone="amber" />
                                                    }
                                                </div>
                                            </td>
                                            <td class="px-3 py-2">
                                                @if (item.IsDefault)
                                                {
                                                    <span class="inline-flex items-center gap-1 text-xs font-semibold text-emerald-600 dark:text-emerald-400" title="Den mall som används automatiskt när en ny kalkyl skapas.">★ Standard</span>
                                                }
                                                else if (CanChooseDepartment)
                                                {
                                                    <button type="button" @onclick="() => SetDefaultAsync(item.Id, item.DepartmentId)" disabled="@Loading"
                                                            class="inline-flex items-center gap-1 rounded-md border border-slate-300 bg-white px-2 py-0.5 text-xs font-medium text-slate-600 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-600 dark:bg-slate-950 dark:text-slate-200 dark:hover:bg-slate-800"
                                                            title="Använd som standardval — används automatiskt för nya kalkyler i denna avdelning/företag.">
                                                        Välj som standard
                                                    </button>
                                                }
                                                else
                                                {
                                                    <span class="text-xs text-slate-400">Nej</span>
                                                }
                                            </td>
                                            <td class="px-3 py-2">
                                                <ColumnPreview />
                                            </td>
                                            <td class="px-3 py-2">
                                                <div class="flex items-center justify-end gap-1.5">
                                                    <button @onclick="() => CopyColumnAsync(item)" disabled="@Loading" type="button"
                                                            class="@ActionButtonClass("sky")"
                                                            title="Skapa en redigerbar kopia av mallen.">
                                                        @((MarkupString)CopyIcon)
                                                        <span>Kopiera</span>
                                                    </button>
                                                    <button @onclick="() => ColumnFormUI(item)" disabled="@(Loading || isStandard || !CanEditTemplate(item.DepartmentId))" type="button"
                                                            class="@IconActionButtonClass("amber")"
                                                            title="@(isStandard ? "Standardmallar kan inte redigeras direkt. Kopiera mallen för att skapa en egen version." : "Redigera mallen.")">
                                                        @Icons.Edit
                                                    </button>
                                                    <button @onclick="() => ToggleColumnVisibilityAsync(item)" disabled="@(Loading || isStandard || !CanEditTemplate(item.DepartmentId))" type="button"
                                                            class="@IconActionButtonClass(item.IsVisible ? "slate" : "emerald")"
                                                            title="@(item.IsVisible ? "Dölj mallen för användare." : "Gör mallen synlig för användare.")">
                                                        @((MarkupString)Icons.GetVisibleIcon(!item.IsVisible))
                                                    </button>
                                                    <button @onclick="() => RemoveColumn(item)" disabled="@(Loading || isStandard || !CanEditTemplate(item.DepartmentId))" type="button"
                                                            class="@IconActionButtonClass("rose")"
                                                            title="@(isStandard ? "Standardmallar kan inte tas bort." : "Ta bort mallen.")">
                                                        @((MarkupString)Icons.DeleteSVG)
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            }
        </div>
    </section>
}

@code {
    public enum TemplateTab { Appearance, Column }
    public enum TemplateKindFilter { All, Standard, Company, Own }
    public enum TemplateStatusFilter { All, Visible, Hidden, Default }

    private static readonly string[] LegacyAppearanceNames = ["Mall01", "Mall02", "Mall03"];
    private static readonly string[] AppearanceStandardNames = ["Standard ljus", "Standard mörk", "Utskrift / PDF"];
    private static readonly string[] LegacyColumnNames = ["Mall C01", "Mall C02", "Mall C03", "Mall C04", "Mall C05"];
    // Display names for the legacy Mall C0x rows (index-aligned to LegacyColumnNames).
    private static readonly string[] LegacyColumnDisplayNames = ["Kompakt nettokalkyl", "Kalkyl ekonomi", "Anbud", "Produktion", "Resurs & CO2"];
    // The seeded, read-only standard column templates (must match TenantSeedCatalog.StandardColumnTemplates names).
    private static readonly string[] ColumnStandardNames =
    [
        "Kompakt nettokalkyl", "Standard nettokalkyl", "Ekonomi", "Anbud",
        "Produktion", "CO2 / miljö", "Granskning / uppföljning", "Import / avstämning"
    ];

    private const string CopyIcon = """<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>""";

    private List<TemplateListDTO> List = [];
    private List<TemplateColumnListDTO> ColumnList = [];
    private TemplateModelDTO? Form;
    private TemplateColumnModelDTO? ColumnForm;
    private bool Loading = true;
    private List<ListDTO> Departments = [];
    private bool CanChooseDepartment;
    private int? SelectedDepartmentId;
    private int? CurrentDepartmentId;
    private int? FormDepartmentId;
    private int? ColumnFormDepartmentId;

    private TemplateTab ActiveTab = TemplateTab.Appearance;
    private TemplateKindFilter KindFilter = TemplateKindFilter.All;
    private TemplateStatusFilter StatusFilter = TemplateStatusFilter.All;
    private string SearchText = string.Empty;

    private bool CanCreateTemplate => CanChooseDepartment || CurrentDepartmentId.HasValue;
    private bool CanEditGlobalTemplates => CanChooseDepartment && !SelectedDepartmentId.HasValue;
    private bool ShowDepartmentTemplates => !CanChooseDepartment || SelectedDepartmentId.HasValue;
    private IEnumerable<TemplateListDTO> VisibleTemplates => ShowDepartmentTemplates ? List : List.Where(x => !x.DepartmentId.HasValue);
    private IEnumerable<TemplateColumnListDTO> VisibleColumnTemplates => ShowDepartmentTemplates ? ColumnList : ColumnList.Where(x => !x.DepartmentId.HasValue);

    private IEnumerable<TemplateListDTO> AppearanceRows => VisibleTemplates
        .Where(x => MatchesSearch(DisplayName(x.Name, TemplateTab.Appearance)))
        .Where(x => MatchesKind(x.DepartmentId, IsStandardAppearance(x)))
        .Where(x => MatchesStatus(x.IsVisible, x.IsDefault));

    private IEnumerable<TemplateColumnListDTO> ColumnRows => VisibleColumnTemplates
        .Where(x => MatchesSearch(DisplayName(x.Name, TemplateTab.Column)))
        .Where(x => MatchesKind(x.DepartmentId, IsStandardColumn(x)))
        .Where(x => MatchesStatus(x.IsVisible, x.IsDefault));

    private string ActiveTabDescription => ActiveTab == TemplateTab.Appearance
        ? "Styr färger, linjer och tabellutseende i kalkyl, slutsida och export."
        : "Styr vilka kolumner som visas, deras ordning och bredd i kalkylvyn.";

    private IReadOnlyList<AppSelect<int?>.Option> DepartmentOptions
    {
        get
        {
            var options = new List<AppSelect<int?>.Option> { new(null, "Alla avdelningar") };
            options.AddRange(Departments.Select(d => new AppSelect<int?>.Option(d.Id, d.Name)));
            return options;
        }
    }

    private static readonly IReadOnlyList<AppSelect<TemplateKindFilter>.Option> KindFilterOptions =
    [
        new(TemplateKindFilter.All, "Alla typer"),
        new(TemplateKindFilter.Standard, "Standardmall"),
        new(TemplateKindFilter.Company, "Företagsmall"),
        new(TemplateKindFilter.Own, "Egen mall")
    ];

    private static readonly IReadOnlyList<AppSelect<TemplateStatusFilter>.Option> StatusFilterOptions =
    [
        new(TemplateStatusFilter.All, "Alla statusar"),
        new(TemplateStatusFilter.Visible, "Synlig"),
        new(TemplateStatusFilter.Hidden, "Dold"),
        new(TemplateStatusFilter.Default, "Standardval")
    ];

    private bool MatchesSearch(string name)
        => string.IsNullOrWhiteSpace(SearchText) || name.Contains(SearchText.Trim(), StringComparison.OrdinalIgnoreCase);

    private bool MatchesKind(int? departmentId, bool isStandard)
        => KindFilter switch
        {
            TemplateKindFilter.Standard => isStandard,
            TemplateKindFilter.Company => !isStandard && (CanChooseDepartment || !departmentId.HasValue),
            TemplateKindFilter.Own => !isStandard && !CanChooseDepartment && departmentId.HasValue,
            _ => true
        };

    private bool MatchesStatus(bool isVisible, bool isDefault)
        => StatusFilter switch
        {
            TemplateStatusFilter.Visible => isVisible,
            TemplateStatusFilter.Hidden => !isVisible,
            TemplateStatusFilter.Default => isDefault,
            _ => true
        };

    private void SetTab(TemplateTab tab)
    {
        ActiveTab = tab;
        SearchText = string.Empty;
        KindFilter = TemplateKindFilter.All;
        StatusFilter = TemplateStatusFilter.All;
    }

    private Task ChangeDepartmentAsync(int? departmentId)
    {
        SelectedDepartmentId = departmentId;
        return LoadTemplatesAsync();
    }

    private Task ChangeKindFilter(TemplateKindFilter filter)
    {
        KindFilter = filter;
        return Task.CompletedTask;
    }

    private Task ChangeStatusFilter(TemplateStatusFilter filter)
    {
        StatusFilter = filter;
        return Task.CompletedTask;
    }

    private string TabClass(TemplateTab tab)
        => ActiveTab == tab
            ? "rounded-lg px-3 py-1.5 text-sm font-semibold text-slate-900 bg-slate-100 dark:bg-slate-800 dark:text-slate-100"
            : "rounded-lg px-3 py-1.5 text-sm font-medium text-slate-500 transition hover:bg-slate-50 hover:text-slate-700 dark:text-slate-400 dark:hover:bg-slate-800/60 dark:hover:text-slate-200";

    private bool CanEditTemplate(int? departmentId) => departmentId.HasValue || CanEditGlobalTemplates;

    private string DepartmentLabel(int? departmentId)
        => departmentId.HasValue
            ? (Departments.FirstOrDefault(d => d.Id == departmentId)?.Name ?? "Avdelning")
            : "Alla avdelningar";

    private string TemplateTypeLabel(int? departmentId, bool isStandard)
    {
        if (isStandard)
            return "Standardmall";

        return CanChooseDepartment || !departmentId.HasValue
            ? "Företagsmall"
            : "Egen mall";
    }

    private static bool IsStandardAppearance(TemplateListDTO item)
        => IsKnownStandardName(item.Name, LegacyAppearanceNames, AppearanceStandardNames);

    // "Standard mörk" (and copies of it) get the dark list preview so ljus/mörk differ visually.
    private static bool IsDarkAppearance(TemplateListDTO item)
        => DisplayName(item.Name, TemplateTab.Appearance).Contains("mörk", StringComparison.OrdinalIgnoreCase);

    private static bool IsStandardColumn(TemplateColumnListDTO item)
        => IsKnownStandardName(item.Name, LegacyColumnNames, ColumnStandardNames);

    private static bool IsKnownStandardName(string name, IReadOnlyList<string> legacyNames, IReadOnlyList<string> standardNames)
    {
        var normalized = name.Trim();
        return legacyNames.Any(x => string.Equals(x, normalized, StringComparison.OrdinalIgnoreCase))
            || standardNames.Any(x => string.Equals(x, normalized, StringComparison.OrdinalIgnoreCase));
    }

    private static string DisplayName(string name, TemplateTab tab)
    {
        if (name.StartsWith("Kopia av ", StringComparison.OrdinalIgnoreCase))
        {
            var sourceName = name["Kopia av ".Length..];
            return $"Kopia av {DisplayName(sourceName, tab)}";
        }

        var legacy = tab == TemplateTab.Appearance ? LegacyAppearanceNames : LegacyColumnNames;
        var replacement = tab == TemplateTab.Appearance ? AppearanceStandardNames : LegacyColumnDisplayNames;
        var index = Array.FindIndex(legacy, x => string.Equals(x, name.Trim(), StringComparison.OrdinalIgnoreCase));
        return index >= 0 ? replacement[index] : name;
    }

    private static string ActionButtonClass(string tone) => tone switch
    {
        "sky" => "inline-flex h-8 items-center justify-center gap-1 rounded-md border border-sky-300 bg-sky-50 px-2 text-xs font-medium text-sky-700 transition hover:bg-sky-100 disabled:cursor-not-allowed disabled:opacity-50 dark:border-sky-700 dark:bg-sky-950/50 dark:text-sky-300 dark:hover:bg-sky-900/60",
