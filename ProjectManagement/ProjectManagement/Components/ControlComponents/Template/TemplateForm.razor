@using Application.Feature.Calculation.TemplateTable.Commands
@using ProjectManagement.Client.Constant
@using ProjectManagement.Client.Pages.Calculation.Template
@using ProjectManagement.Client.Shared.Model.Project.Calculation
@using ProjectManagement.Shared.DTO.Calculation.Template
@inherits AppComponentBase

@if (TemplateUpdate is not null)
{
    <section class="space-y-2">
        <EditForm Model="@TemplateUpdate"
                  id="@FormId"
                  FormName="@FormId"
                  OnValidSubmit="HandleSubmitAsync"
                  OnInvalidSubmit="HandleInvalidSubmit">
            <DataAnnotationsValidator />
            <FormValidationSummary />

            <div class="sticky top-0 z-20 rounded-xl border border-slate-200 bg-white p-2 shadow-sm dark:border-slate-700 dark:bg-slate-900">
                <div class="flex flex-wrap items-center justify-between gap-2">
                    <button type="button"
                            @onclick="BackAsync"
                            class="inline-flex items-center gap-1 rounded-md px-2 py-1 text-sm font-medium text-slate-600 transition hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-slate-100"
                            title="Tillbaka till mallistan"
                            disabled="@btnSubmitDisabled">
                        ← Tillbaka till mallar
                    </button>

                    <div class="flex items-center gap-1">
                        <button type="button" @onclick="() => _editorTab = EditorTab.General" class="@EditorTabClass(EditorTab.General)">Allmänt</button>
                        <button type="button" @onclick="() => _editorTab = EditorTab.NetCalc" class="@EditorTabClass(EditorTab.NetCalc)">Nettokalkyl</button>
                        <button type="button" @onclick="() => _editorTab = EditorTab.Summary" class="@EditorTabClass(EditorTab.Summary)">Slutsida</button>
                    </div>

                    <div class="flex items-center gap-1">
                        <button type="submit"
                                form="@FormId"
                                class="inline-flex h-8 items-center justify-center rounded-md bg-emerald-600 px-3 text-sm font-medium text-white transition hover:bg-emerald-700 disabled:cursor-not-allowed disabled:opacity-50"
                                disabled="@btnSubmitDisabled">
                            @ResourceApp.save
                        </button>

                        <button type="button"
                                @onclick="BackAsync"
                                class="inline-flex h-8 items-center justify-center rounded-md border border-slate-300 bg-white px-3 text-sm font-medium text-slate-700 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-600 dark:bg-slate-950 dark:text-slate-200 dark:hover:bg-slate-800"
                                title="Tillbaka till mallistan"
                                disabled="@btnSubmitDisabled">
                            Avbryt
                        </button>
                    </div>
                </div>
            </div>

            @* Allmänt — always rendered (kept in the DOM so its bound fields stay in the form); other tabs
               are display-toggled so switching never loses edits. *@
            <div class="@(_editorTab == EditorTab.General ? "" : "hidden")">
                <div class="rounded-xl border border-slate-200 bg-white p-3 shadow-sm dark:border-slate-700 dark:bg-slate-900">
                    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-4">
                        <div class="min-w-0">
                            <label class="mb-1 block text-xs font-medium text-slate-700 dark:text-slate-200">@CalcResource.name</label>
                            <InputText class="h-8 w-full rounded-md border border-slate-300 bg-white px-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-500/20 dark:border-slate-600 dark:bg-slate-950 dark:text-slate-100" @bind-Value="TemplateUpdate.Name" />
                        </div>

                        <div class="min-w-0">
                            <label class="mb-1 block text-xs font-medium text-slate-700 dark:text-slate-200">@ResourceApp.date</label>
                            <InputSelect @bind-Value="TemplateUpdate.DateFormat" class="h-8 w-full rounded-md border border-slate-300 bg-white px-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-500/20 dark:border-slate-600 dark:bg-slate-950 dark:text-slate-100">
                                @foreach (var dateFormat in DateFormats)
                                {
                                    <option value="@dateFormat">@dateFormat</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="min-w-0">
                            <label class="mb-1 block text-xs font-medium text-slate-700 dark:text-slate-200">@PMWebResource.NumberFormat</label>
                            <InputSelect @bind-Value="TemplateUpdate.MathRound" class="h-8 w-full rounded-md border border-slate-300 bg-white px-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-500/20 dark:border-slate-600 dark:bg-slate-950 dark:text-slate-100">
                                @foreach (var numberFormat in NumberFormats)
                                {
                                    <option value="@numberFormat.Value">@numberFormat.Label</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="min-w-0">
                            <label class="mb-1 block text-xs font-medium text-slate-700 dark:text-slate-200">@CalcResource.Currency</label>
                            <InputText class="h-8 w-full rounded-md border border-slate-300 bg-white px-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-500/20 dark:border-slate-600 dark:bg-slate-950 dark:text-slate-100" @bind-Value="TemplateUpdate.Currency" />
                        </div>

                        <div class="min-w-0 sm:col-span-2 xl:col-span-4">
                            <label class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-800/50">
                                <InputCheckbox class="h-4 w-4 rounded border-slate-300 text-sky-600 focus:ring-sky-500 dark:border-slate-600 dark:bg-slate-800" @bind-Value="TemplateUpdate.Active" />
                                <span>Synlig för användare</span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="@(_editorTab == EditorTab.NetCalc ? "" : "hidden")">
                <NelCalculationTemplate2 Temp="TemplateUpdate" ShowColumnSettings="false"></NelCalculationTemplate2>
            </div>

            <div class="@(_editorTab == EditorTab.Summary ? "" : "hidden")">
                <SummarySheetTemplate Temp="TemplateUpdate"></SummarySheetTemplate>
            </div>
        </EditForm>
    </section>
}

@code {
    private static readonly string[] DateFormats =
    [
        "dd.MM.yyyy",
        "dd/MM/yyyy",
        "dd-MM-yyyy",
        "yyyy.MM.dd",
        "yyyy/MM/dd",
        "yyyy-MM-dd"
    ];

    private static readonly (int Value, string Label)[] NumberFormats =
    [
        (0, "0"),
        (1, "0.0"),
        (2, "0.00"),
        (3, "0.000"),
        (4, "0.0000"),
        (5, "0.00000")
    ];

    private TemplateListPostDTO TemplateUpdate = new();

    private enum EditorTab { General, NetCalc, Summary }
    private EditorTab _editorTab = EditorTab.General;

    private string EditorTabClass(EditorTab tab)
        => _editorTab == tab
            ? "rounded-lg px-3 py-1.5 text-sm font-semibold text-slate-900 bg-slate-100 dark:bg-slate-800 dark:text-slate-100"
            : "rounded-lg px-3 py-1.5 text-sm font-medium text-slate-500 transition hover:bg-slate-50 hover:text-slate-700 dark:text-slate-400 dark:hover:bg-slate-800/60 dark:hover:text-slate-200";

    [Parameter] public TemplateModelDTO TempForm { get; set; } = new();
    [Parameter] public int? DepartmentId { get; set; }
    [Parameter] public EventCallback<bool> Callback { get; set; }

    private readonly string FormId = $"template-control-form-{Guid.NewGuid():N}";
    private bool btnSubmitDisabled;

    protected override void OnParametersSet()
    {
        TemplateUpdate = new TemplateListPostDTO();
        TempForm.CopyPropertiesTo(TemplateUpdate);

        TemplateUpdate.Name ??= string.Empty;
        TemplateUpdate.Currency ??= "€";
        TemplateUpdate.Active = TempForm.IsVisible;

        if (string.IsNullOrWhiteSpace(TemplateUpdate.DateFormat))
            TemplateUpdate.DateFormat = DateFormats[0];
    }

    private async Task HandleSubmitAsync()
    {
        if (btnSubmitDisabled)
            return;

        btnSubmitDisabled = true;
        var refresh = false;

        try
        {
            if (TempForm.Id > 0)
            {
                refresh = await Dispatcher.Send(new UpdateTemplateCommand(TemplateUpdate, TempForm.Id, DepartmentId));
                if (refresh) MHD.ToastInfo("Mallen har sparats.", string.Empty, true);
                else MHD.Notifications(ToastType.Update, false);
            }
            else
            {
                var created = await Dispatcher.Send(new CreateTemplateCommand(TemplateUpdate, DepartmentId));
                refresh = created is not null && created.Id > 0;
                if (refresh) MHD.ToastInfo("Mallen har sparats.", string.Empty, true);
                else MHD.Notifications(ToastType.Add, false);
            }
        }
        catch
        {
            MHD.Notifications(TempForm.Id > 0 ? ToastType.Update : ToastType.Add, false);
        }
        finally
        {
            btnSubmitDisabled = false;
        }

        await Callback.InvokeAsync(refresh);
    }

    private void HandleInvalidSubmit(EditContext _)
        => MHD.Notifications(TempForm.Id > 0 ? ToastType.Update : ToastType.Add, false);

    private Task BackAsync() => Callback.InvokeAsync(false);
}
