@using Microsoft.Extensions.Localization
@using ProjectManagement.Client.Pages.Calculation.Template
@using ProjectManagement.Client.Shared.MVVM.Calculation
@using ProjectManagement.Shared.Constant
@using ProjectManagement.Shared.Constants
@using ProjectManagement.Shared.DTO.Calculation.Template
@inherits AppComponentBase

<div class="overflow-x-auto">
    <div class="flex min-w-[760px] items-start gap-1">
        <section class="w-[500px] flex-none overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">
            <div class="border-b border-slate-200 px-3 py-1 dark:border-slate-700">
                <div class="flex items-center justify-between gap-3">
                    <div>
                        <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">@ResourceApp.visibleItems</h3>
                        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">@AppLoc["visibleColumnsCount", Columns.Count]</p>
                    </div>

                    <div class="rounded-full bg-slate-100 px-2.5 py-1 text-[11px] font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-300">
                        @AppLoc["dragAndReorder"]
                    </div>
                </div>
            </div>

            <div class="max-h-[65vh] overflow-auto">
                <table class="min-w-[480px] table-fixed border-collapse text-[12px]">
                    <colgroup>
                        <col style="width:42px;" />
                        <col style="width:290px;" />
                        <col style="width:148px;" />
                    </colgroup>
                    <thead class="sticky top-0 z-10">
                        <tr class="bg-slate-100 text-[11px] font-semibold text-slate-800 dark:bg-slate-800 dark:text-slate-100">
                            <th class="border border-slate-200 px-1 py-0.5 text-center dark:border-slate-700">#</th>
                            <th class="border border-slate-200 px-1 py-0.5 text-start dark:border-slate-700">@CalcResource.name</th>
                            <th class="border border-slate-200 px-1 py-0.5 text-center dark:border-slate-700">@AppLoc["settings"]</th>
                        </tr>
                    </thead>

                    <DragReorderTBody TItem="NetColumnState"
                                      Items="Columns"
                                      RowClass="bg-white transition-colors hover:bg-slate-50 dark:bg-slate-900 dark:hover:bg-slate-800/70">
                        <RowTemplate Context="col">
                            @{
                                var row = Columns.IndexOf(col);
                                var isFirst = row <= 0;
                                var isLast = row >= Columns.Count - 1;
                                var title = CalcLoc[NetColumnLoc.Key[col.Id]];
                            }

                            <td class="border border-slate-200 px-1 py-0.5 text-center align-middle dark:border-slate-700">
                                <div class="flex items-center justify-center gap-1">
                                    <span class="cursor-grab select-none text-slate-400 dark:text-slate-500">::</span>
                                    <span class="tabular-nums text-slate-700 dark:text-slate-200">@(row + 1)</span>
                                </div>
                            </td>

                            <td class="border border-slate-200 px-1 py-0.5 align-middle dark:border-slate-700">
                                <div class="flex items-center gap-2">
                                    <div class="flex shrink-0 items-center gap-1">
                                        <button type="button" class="@IconButtonSecondaryClass" disabled="@isFirst" title="@AppLoc["moveToTop"]" @onclick="() => MoveToTop(col)">T</button>
                                        <button type="button" class="@IconButtonSecondaryClass" disabled="@isFirst" title="@AppLoc["moveUp"]" @onclick="() => MoveUp(col)">^</button>
                                    </div>

                                    <div class="min-w-0 flex-1">
                                        <div class="truncate font-medium text-slate-800 dark:text-slate-100" title="@title">@title</div>
                                        <div class="mt-0.5 text-[11px] text-slate-500 dark:text-slate-400">@col.Id</div>
                                    </div>

                                    <div class="flex shrink-0 items-center gap-1">
                                        <button type="button" class="@IconButtonSecondaryClass" disabled="@isLast" title="@AppLoc["moveDown"]" @onclick="() => MoveDown(col)">v</button>
                                        <button type="button" class="@IconButtonSecondaryClass" disabled="@isLast" title="@AppLoc["moveToBottom"]" @onclick="() => MoveToBottom(col)">B</button>
                                    </div>
                                </div>
                            </td>

                            <td class="border border-slate-200 px-0.5 py-0.5 align-middle dark:border-slate-700">
                                <div class="flex items-center justify-center gap-1 whitespace-nowrap">
                                    <input class="w-[50px] rounded-lg border border-slate-300 bg-white px-1.5 py-1 text-center text-[11px] text-slate-800 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-white"
                                           type="number"
                                           title="@AppLoc["width"]"
                                           @bind="col.Width" />

                                    <button type="button"
                                            class="@(col.Frozen ? IconButtonWarningActiveClass : IconButtonWarningClass)"
                                            title="@AppLoc["freezeColumn"]"
                                            @onclick="() => col.Frozen = !col.Frozen">
                                        F
                                    </button>

                                    <button type="button"
                                            class="@IconButtonPrimaryClass"
                                            title="@AppLoc["hideColumn"]"
                                            @onclick="async () => await RemoveAsync(col)">
                                        <span>@((MarkupString)Icons.ChevronRight)</span>
                                    </button>
                                </div>
                            </td>
                        </RowTemplate>
                    </DragReorderTBody>
                </table>
            </div>
        </section>

        <section class="w-[260px] flex-none overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">
            <div class="border-b border-slate-200 px-3 py-1 dark:border-slate-700">
                <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">@ResourceApp.hiddenItems</h3>
                <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">@AppLoc["hiddenColumnsCount", HiddenIds.Count()]</p>
            </div>

            <div class="max-h-[65vh] overflow-auto">
                <table class="w-full text-[12px]">
                    <thead class="sticky top-0 z-10 bg-slate-50 dark:bg-slate-900">
                        <tr class="text-[11px] text-slate-700 dark:text-slate-200">
                            <th class="w-[56px] px-1 py-0.5 text-center"></th>
                            <th class="px-1 py-0.5 text-start font-medium">@CalcResource.name</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (TableVisible)
                        {
                            @foreach (var id in HiddenIds)
                            {
                                <tr class="border-t border-slate-200 transition-colors hover:bg-slate-50 dark:border-slate-700 dark:hover:bg-slate-800/70">
                                    <td class="px-1 py-0.5 text-center align-middle">
                                        <button type="button"
                                                class="@IconButtonPrimaryClass"
                                                title="@AppLoc["showColumn"]"
                                                @onclick="async () => await AddAsync(id)">
                                            <span>@((MarkupString)Icons.ChevronLeft)</span>
                                        </button>
                                    </td>
                                    <td class="px-1 py-0.5 align-middle">
                                        <div class="font-medium text-slate-800 dark:text-slate-100">@CalcLoc[NetColumnLoc.Key[id]]</div>
                                        <div class="mt-0.5 text-[11px] text-slate-500 dark:text-slate-400">@id</div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>

@code {
    private const string IconButtonBaseClass =
        "inline-flex h-7 w-7 items-center justify-center rounded-lg border text-[11px] transition duration-150 hover:scale-[1.03] active:scale-95";

    private const string IconButtonSecondaryClass =
        IconButtonBaseClass + " border-slate-300 bg-white text-slate-600 hover:bg-slate-100 hover:border-slate-400 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800";

    private const string IconButtonPrimaryClass =
        IconButtonBaseClass + " border-blue-300 bg-blue-50 text-blue-700 hover:bg-blue-100 hover:border-blue-400 dark:border-blue-500/60 dark:bg-blue-950/40 dark:text-blue-300 dark:hover:bg-blue-900/50";

    private const string IconButtonWarningClass =
        IconButtonBaseClass + " border-amber-300 bg-amber-50 text-amber-700 hover:bg-amber-100 hover:border-amber-400 dark:border-amber-500/60 dark:bg-amber-950/40 dark:text-amber-300 dark:hover:bg-amber-900/50";

    private const string IconButtonWarningActiveClass =
        IconButtonBaseClass + " border-emerald-300 bg-emerald-50 text-emerald-700 hover:bg-emerald-100 hover:border-emerald-400 dark:border-emerald-500/60 dark:bg-emerald-950/40 dark:text-emerald-300 dark:hover:bg-emerald-900/50";

    [Parameter] public List<NetColumnState> Columns { get; set; } = TemplateDefaults.NetCalc();

    private bool TableVisible = true;

    private static readonly IReadOnlyDictionary<NetColumnId, NetColumnState> Defaults =
        TemplateDefaults.NetCalc().ToDictionary(x => x.Id, x => x);

    private IEnumerable<NetColumnId> HiddenIds =>
        Enum.GetValues<NetColumnId>()
            .Where(id => !Columns.Any(c => c.Id == id));

    private async Task AddAsync(NetColumnId id)
    {
        TableVisible = false;
        await Task.Delay(1);

        if (Defaults.TryGetValue(id, out var def))
        {
            Columns.Add(new NetColumnState
            {
                Id = def.Id,
                Width = def.Width,
                Frozen = def.Frozen
            });
        }
        else
        {
            Columns.Add(new NetColumnState
            {
                Id = id,
                Width = 80,
                Frozen = false
            });
        }

        TableVisible = true;
    }

    private async Task RemoveAsync(NetColumnState col)
    {
        TableVisible = false;
        await Task.Delay(1);

        col.Frozen = false;
        Columns.Remove(col);

        await Task.Delay(1);
        TableVisible = true;
    }

    private void MoveUp(NetColumnState col)
    {
        var index = Columns.IndexOf(col);
        if (index <= 0) return;
        Columns.RemoveAt(index);
        Columns.Insert(index - 1, col);
    }

    private void MoveDown(NetColumnState col)
    {
        var index = Columns.IndexOf(col);
        if (index < 0 || index >= Columns.Count - 1) return;
        Columns.RemoveAt(index);
        Columns.Insert(index + 1, col);
    }

    private void MoveToTop(NetColumnState col)
    {
        var index = Columns.IndexOf(col);
        if (index <= 0) return;
        Columns.RemoveAt(index);
        Columns.Insert(0, col);
    }

    private void MoveToBottom(NetColumnState col)
    {
        var index = Columns.IndexOf(col);
        if (index < 0 || index >= Columns.Count - 1) return;
        Columns.RemoveAt(index);
        Columns.Add(col);
    }
}
