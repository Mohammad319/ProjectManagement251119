@using ProjectManagement.Shared.DTO.Account

<div class="flex-1 p-1 overflow-auto">
    @if (GroupSelected > 0)
    {
        <div class="@CssClasses.Layout.FlexItemsCenter pb-1 gap-2">
            <button class="@CssClasses.Btn.IconButton.Success mt-1 flex items-center gap-2"
                    @onclick="CreateForm"
                    title="@ResourceApp.newItem"
                    aria-label="@ResourceApp.newItem">
                @((MarkupString)Icons.Plus2)
            </button>

            <button class="@CssClasses.Btn.IconButton.Secondary mt-1"
                    @onclick="ToggleVisibleFilter"
                    title="@ResourceApp.isVisible"
                    aria-label="@ResourceApp.isVisible">
                @((MarkupString)Icons.GetVisibleIcon(IsVisibleOnly))
            </button>
        </div>

        @if (IsLoading)
        {
            <BlazorMHD.UI.Components.Feedback.Loading.MhdLoading></BlazorMHD.UI.Components.Feedback.Loading.MhdLoading>
        }
        else if (Accounts is { Count: > 0 })
        {
            <table class="@CssClasses.Table.Tab">
                <thead class="@CssClasses.Table.Thead">
                    <tr>
                        <th class="@CssClasses.Table.TH" style="width:105px;">@CalcResource.account</th>
                        <th class="@CssClasses.Table.TH" style="width:105px;">@ResourceApp.isVisible</th>
                        <th class="@CssClasses.Table.TH">@CalcResource.name</th>
                        <th class="@CssClasses.Table.TH">@CalcResource.comment</th>
                    </tr>
                </thead>

                <tbody class="@CssClasses.Table.TBody">
                    @foreach (var account in Accounts)
                    {
                        <tr class="@CssClasses.Table.Tr"
                            @oncontextmenu:preventDefault
                            @oncontextmenu="() => AccountContextM(account)">

                            <td class="@CssClasses.Table.Td">@account.Account</td>

                            <td class="@CssClasses.Table.Td">
                                @* <input type="checkbox" disabled checked="@account.IsVisible" /> *@
                            </td>

                            <td class="@CssClasses.Table.Td">@account.Name</td>

                            <td class="@CssClasses.Table.Td">
                                @* إذا عندك Comments ضمن Metadata/Data عدّل حسب DTO *@
                   @*              @if (account.Metadata?.Comments is { Count: > 0 })
                                {
                                    @foreach (var comm in account.Metadata.Comments)
                                    {
                                        <div class="truncate">@comm</div>
                                    }
                                } *@
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="p-3 text-sm text-slate-400">
                @ResourceApp.ThereAreNoItemsToDisplay
            </div>
        }
    }
</div>
