@using ProjectManagement.Shared.DTO.Account
@using ProjectManagement.Components.Shared
@inherits AppComponentBase

<div class="space-y-1.5 overflow-auto">
    @if (GroupSelected > 0)
    {
        <div class="flex flex-col gap-1 rounded-xl border border-slate-200 bg-white px-2.5 py-1.5 shadow-sm dark:border-slate-700 dark:bg-slate-900 lg:flex-row lg:items-center lg:justify-between">
            <div>
                <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100">@CalcLoc[nameof(CalcResource.account)]</h3>
                <p class="text-sm text-slate-500 dark:text-slate-400">@AppLoc[nameof(ResourceApp.selectAccountGroupHint)]</p>
            </div>

            <div class="flex items-center gap-1">
                <button type="button"
                        class="inline-flex items-center justify-center rounded-xl border border-emerald-300 bg-emerald-50 px-3 py-2 text-sm font-medium text-emerald-700 transition hover:bg-emerald-100 dark:border-emerald-900/60 dark:bg-emerald-950/30 dark:text-emerald-300 dark:hover:bg-emerald-950/50"
                        @onclick="CreateForm"
                        title="@AppLoc[nameof(ResourceApp.newItem)]"
                        aria-label="@AppLoc[nameof(ResourceApp.newItem)]">
                    @((MarkupString)Icons.Plus2)
                </button>

                <button type="button"
                        class="inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
                        @onclick="ToggleVisibleFilter"
                        title="@AppLoc[nameof(ResourceApp.isVisible)]"
                        aria-label="@AppLoc[nameof(ResourceApp.isVisible)]">
                    @((MarkupString)Icons.GetVisibleIcon(IsVisibleOnly))
                </button>
            </div>
        </div>

        @if (IsLoading)
        {
            <div class="rounded-xl border border-slate-200 bg-white p-1.5 shadow-sm dark:border-slate-700 dark:bg-slate-900">
                <BlazorMHD.UI.Components.Feedback.Loading.MhdLoading />
            </div>
        }
        else if (Accounts is { Count: > 0 })
        {
            <div class="hidden xl:block overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-slate-200 dark:divide-slate-700">
                        <thead class="bg-slate-50/80 dark:bg-slate-800/60">
                            <tr>
                                <th class="px-2 py-1 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-300">@CalcLoc[nameof(CalcResource.account)]</th>
                                <th class="px-2 py-1 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-300">@AppLoc[nameof(ResourceApp.isVisible)]</th>
                                <th class="px-2 py-1 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-300">@CalcLoc[nameof(CalcResource.name)]</th>
                                <th class="px-2 py-1 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-300">@CalcLoc[nameof(CalcResource.comment)]</th>
                            </tr>
                        </thead>

                        <tbody class="divide-y divide-slate-200 dark:divide-slate-800">
                            @foreach (var account in Accounts)
                            {
                                <tr class="cursor-context-menu transition hover:bg-slate-50 dark:hover:bg-slate-800/60"
                                    @oncontextmenu:preventDefault
                                    @oncontextmenu="() => AccountContextM(account)">
                                    <td class="px-1.5 py-1 text-sm font-medium text-slate-700 dark:text-slate-200">@account.Code</td>
                                    <td class="px-1.5 py-1 text-sm text-slate-600 dark:text-slate-300">
                                        <span class="inline-flex rounded-full px-2 py-1 text-xs font-medium @(account.IsVisible ? "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300" : "bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300")">
                                            @(account.IsVisible ? AppLoc[nameof(ResourceApp.visible)] : AppLoc[nameof(ResourceApp.hiddenItems)])
                                        </span>
                                    </td>
                                    <td class="px-1.5 py-1 text-sm text-slate-700 dark:text-slate-200">@account.Name</td>
                                    <td class="px-1.5 py-1 text-sm text-slate-600 dark:text-slate-300">
                                        @if (account.Metadata?.Comments is { Count: > 0 })
                                        {
                                            <div class="space-y-1">
                                                @foreach (var comm in account.Metadata.Comments)
                                                {
                                                    <div class="max-w-xl truncate">@comm</div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-slate-400 dark:text-slate-500">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="grid gap-2 md:grid-cols-2 lg:grid-cols-3 xl:hidden">
                @foreach (var account in Accounts)
                {
                    <div class="h-full rounded-xl border border-slate-200 bg-white p-3 shadow-sm dark:border-slate-700 dark:bg-slate-900"
                         @oncontextmenu:preventDefault
                         @oncontextmenu="() => AccountContextM(account)">
                        <div class="flex items-start justify-between gap-2">
                            <div class="text-sm font-semibold text-slate-900 dark:text-slate-100">@account.Code</div>
                            <span class="inline-flex rounded-full px-2 py-0.5 text-xs font-medium @(account.IsVisible ? "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300" : "bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300")">
                                @(account.IsVisible ? AppLoc[nameof(ResourceApp.visible)] : AppLoc[nameof(ResourceApp.hiddenItems)])
                            </span>
                        </div>

                        <div class="mt-1.5 text-sm text-slate-700 dark:text-slate-200">@account.Name</div>

                        <div class="mt-2 space-y-1 text-xs text-slate-500 dark:text-slate-400">
                            @if (account.Metadata?.Comments is { Count: > 0 })
                            {
                                @{ var commentIndex = 0; }
                                @foreach (var comm in account.Metadata.Comments)
                                {
                                    if (commentIndex >= 2)
                                    {
                                        break;
                                    }
                                    <div class="truncate">@comm</div>
                                    commentIndex++;
                                }
                            }
                            else
                            {
                                <div>—</div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="rounded-xl border border-dashed border-slate-300 bg-slate-50 px-4 py-8 text-center text-sm text-slate-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-400">
                @AppLoc[nameof(ResourceApp.ThereAreNoItemsToDisplay)]
            </div>
        }
    }
</div>
