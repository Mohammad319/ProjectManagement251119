@using Application.Feature.Account.Commands
@using Application.Feature.Account.Queries.AccountGroup
@using Domain.Entities.Calculation
@using ProjectManagement.Shared.Constant
@inject ICommandDispatcher MicroBus
@inject ContextMenuService ContextService
@inject MhdServices MHD
@inject IStringLocalizer<ResourceApp> AppLoc
<div class="flex-1 p-1 overflow-auto">
    @if (GroupSelected != null)
    {
        <div class="@CssClasses.Layout.FlexItemsCenter pb-1">
            <button class="@CssClasses.Btn.IconButton.Success mt-1 flex items-center gap-2" @onclick="(e) => UpdateForm(new AccountEntity() { AccountGroupId = GroupSelected })"> @((MarkupString)Icons.Plus2)</button>
            <button class="@CssClasses.Btn.IconButton.Secondary mt-1" @onclick="() => IsVisible = !IsVisible">@((MarkupString)Icons.GetVisibleIcon(IsVisible))</button>
        </div>
        <table class="@CssClasses.Table.Tab">
            <thead class="@CssClasses.Table.Thead">
                <tr>
                    <th class="@CssClasses.Table.TH" style="width:105px;">@CalcResource.account</th>
                    <th class="@CssClasses.Table.TH" style="width:105px;">@ResourceApp.isVisible</th>
                    <th class="@CssClasses.Table.TH">@CalcResource.name</th>
                    <th class="@CssClasses.Table.TH">@CalcResource.comment</th>
                </tr>
            </thead>
            <tbody class="@CssClasses.Table.TBody">
                @if (Accounts != null) foreach (var account in Accounts?.Where(x => x.IsVisible == IsVisible))
                {
                    <tr class="@CssClasses.Table.Tr" @oncontextmenu:preventDefault @oncontextmenu="() => AccountContextM(account)">
                        <td class="@CssClasses.Table.Td">@account.Code</td>
                        <td class="@CssClasses.Table.Td"><input type="checkbox" disabled checked="@account.IsVisible" /></td>
                        <td class="@CssClasses.Table.Td">@account.Name</td>
                        <td class="@CssClasses.Table.Td">
                            @if (account.Data != null && account.Data.Comments != null)
                                foreach (var comm in account.Data.Comments)
                                {
                                    <label>@comm</label>

                                    <br />
                                }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
@code {
    [Parameter] public int GroupSelected { get; set; }
    bool IsVisible = true;
    public List<AccountEntity>? Accounts { get; set; }
    async Task AccountContextM(AccountEntity item)
    {
        await ContextService.ShowMenuAsync(new()
            {
                    new MenuItem { Label = $"✏️ {ResourceApp.update}", OnClickAsync = () => {UpdateForm(item);
            return Task.CompletedTask;
    }
},
                    new MenuItem { Label = $"🗑️ {ResourceApp.delete}", OnClickAsync = () => {Remove(item);
            return Task.CompletedTask;
    }
}
            });
    }
    void UpdateForm(AccountEntity model)
    {
@*         if (model.AccountGroupId == 0) model.AccountGroupId = GroupSelected;
        var ModalRecord = dialog.NewModal<AccountsFormUI>(model.Id > 0 ? AppLoc[LocalizerConst.Update, model.Name] : AppLoc[LocalizerConst.New, CalcResource.account],
            new Dictionary<string, object> { 
                [nameof(AccountsFormUI.Account)] = model,
                [nameof(AccountsFormUI.Callback)] = EventCallback.Factory.Create<bool>(this, Callback)
});
        MHD.Modal.AddModal(ModalRecord); *@
    }
    async Task Callback(bool refresh)
    {
        if (refresh)
        {
            Accounts = null;
            Accounts = await MicroBus.Send(new GetAccountQuery(GroupSelected));
        }
    }
    protected async override Task OnInitializedAsync()
    {
        Accounts = await MicroBus.Send(new GetAccountQuery(GroupSelected));
    }
    void Remove(AccountEntity Organisation) => MHD.DeleteMessage(Organisation.Name, EventCallback.Factory.Create(this,() => ConfirmRemoveAsync(Organisation)));
    async Task ConfirmRemoveAsync(AccountEntity account)
    {
        var reault = await MicroBus.Send(new DeleteAccountCommand(account.Id));
        if (reault)
        {
            Accounts.Remove(account);
            StateHasChanged();
        }
        MHD.Notifications(ToastType.Delete, reault);
    }
}
