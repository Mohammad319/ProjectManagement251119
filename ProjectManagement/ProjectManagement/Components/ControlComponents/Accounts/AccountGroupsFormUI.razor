@inherits AppComponentBase

<EditForm id="accountGroupForm"
          class="@CssClasses.Modal.Body"
          Model="@EditModel"
          OnValidSubmit="HandleSubmitAsync">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label class="@CssClasses.Form.Label">@CalcResource.name</label>
        <InputText class="@CssClasses.Input.Text" @bind-Value="EditModel.Name" />
        <ValidationMessage For="@(() => EditModel.Name)" />
    </div>
</EditForm>

<div class="@CssClasses.Modal.Footer">
    <button type="submit"
            form="accountGroupForm"
            class="@CssClasses.Btn.Outline.Success"
            disabled="@IsLoading"
            aria-busy="@IsLoading">
        @AppLoc[nameof(ResourceApp.save)]
    </button>

    <button type="button"
            class="@CssClasses.Btn.Outline.Secondary"
            @onclick="CloseModal"
            disabled="@IsLoading">
        @AppLoc[nameof(ResourceApp.cancel)]
    </button>
</div>
