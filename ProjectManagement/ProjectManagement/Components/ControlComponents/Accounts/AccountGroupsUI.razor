@using ContextMenuMHD
@using Domain.Entities.Calculation
@using ProjectManagement.Client.Services.MHDBlazor
@using ProjectManagement.Client.Shared.Model.Project.Calculation

<div class="flex h-full gap-4">
    <!-- Sidebar / Vertical Tabs -->
    <div class="w-64 bg-white/80 dark:bg-slate-900 border-r border-slate-200 dark:border-slate-700 shadow-sm rounded-xl">
        <div class="flex flex-col h-full">
            <!-- Header + Actions -->
            <div class="flex items-center justify-between px-3 py-2 border-b border-slate-200 dark:border-slate-700">

                <div class="flex items-center gap-1">
                    <button class="@CssClasses.Btn.IconButton.Success"
                            @onclick="CreateForm"
                            title="@ResourceApp.newItem">
                        @((MarkupString)Icons.Plus)
                    </button>

                    <button class="@CssClasses.Btn.IconButton.Primary"
                            @onclick="ImportForm"
                            title="@ResourceApp.importFromFile">
                        @((MarkupString)Icons.ImportFromFile)
                    </button>
                </div>
            </div>

            <!-- Tabs (Groups) -->
            <nav class="flex-1 overflow-y-auto px-2 py-2 space-y-1">
                @if (Groups is { Count: > 0 })
                {
                    @foreach (var item in Groups)
                    {
                        var isSelected = GroupSelected.HasValue && GroupSelected.Value == item.Id;

                        var baseClasses = "group flex w-full items-center justify-between rounded-lg px-3 py-2 text-sm font-medium transition-colors cursor-pointer";
                        var selectedClasses = "bg-blue-600 text-white shadow-sm";
                        var defaultClasses = "bg-transparent text-slate-700 hover:bg-slate-100 dark:text-slate-100 dark:hover:bg-slate-800";
                        var finalClass = $"{baseClasses} {(isSelected ? selectedClasses : defaultClasses)}";

                        <button class="@finalClass"
                                @onclick="() => ChangeAccountGroupSelectedAsync(item)"
                                @oncontextmenu="() => GroupContextM(item)"
                                @oncontextmenu:preventDefault
                                aria-current="@(isSelected ? "page" : null)">
                            <span class="truncate">@item.Name</span>

                            @if (isSelected)
                            {
                                <span class="ml-2 h-2 w-2 rounded-full bg-white/90"></span>
                            }
                        </button>
                    }
                }
                else
                {
                    <p class="px-2 py-4 text-xs text-slate-400">
                        @ResourceApp.ThereAreNoItemsToDisplay
                        @ResourceApp.useTheButtonAboveToAddNewItem
                    </p>
                }
            </nav>
        </div>
    </div>

    <!-- Content -->
    <div class="flex-1">
        @if (GroupSelected.HasValue)
        {
            <AccountUI GroupSelected="GroupSelected.Value" />
        }
        else
        {
            <div class="flex h-full items-center justify-center text-slate-400 text-sm">
                @ResourceApp.selectAccountGroupHint
            </div>
        }
    </div>
</div>
