@inherits AppComponentBase

<div class="grid h-full min-h-0 grid-cols-[minmax(0,1fr)_minmax(240px,280px)] gap-2">
    <aside class="order-2 w-full min-w-0 overflow-hidden rounded-2xl border border-slate-200/90 bg-white/95 shadow-sm dark:border-slate-800 dark:bg-slate-950/90">
        <div class="flex h-full flex-col">
            <div class="flex items-center justify-between gap-1 border-b border-slate-200/80 bg-slate-50/80 px-2.5 py-2.5 dark:border-slate-800 dark:bg-slate-900/80">
                <div>
                    <div class="text-sm font-semibold text-slate-900 dark:text-slate-100">@CalcResource.accountGroups</div>
                    <div class="text-xs text-slate-500 dark:text-slate-400">@AppLoc[nameof(ResourceApp.selectAccountGroupHint)]</div>
                </div>

                <div class="flex items-center gap-1">
                    <button type="button"
                            class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-emerald-300 bg-emerald-50 text-emerald-700 transition hover:bg-emerald-100 dark:border-emerald-800/70 dark:bg-emerald-950/60 dark:text-emerald-300 dark:hover:bg-emerald-950/80"
                            @onclick="CreateForm"
                            title="@AppLoc[nameof(ResourceApp.newItem)]"
                            aria-label="@AppLoc[nameof(ResourceApp.newItem)]">
                        @((MarkupString)Icons.Plus)
                    </button>

                    <button type="button"
                            class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-blue-300 bg-blue-50 text-blue-700 transition hover:bg-blue-100 dark:border-blue-800/70 dark:bg-blue-950/60 dark:text-blue-300 dark:hover:bg-blue-950/80"
                            @onclick="ImportForm"
                            title="@AppLoc[nameof(ResourceApp.importFromFile)]"
                            aria-label="@AppLoc[nameof(ResourceApp.importFromFile)]">
                        @((MarkupString)Icons.ImportFromFile)
                    </button>
                </div>
            </div>

            <nav class="flex-1 space-y-1 overflow-y-auto bg-slate-50/40 px-1.5 py-1.5 dark:bg-slate-950/40">
                @if (Groups is { Count: > 0 })
                {
                    @foreach (var item in Groups)
                    {
                        var isSelected = GroupSelected.HasValue && GroupSelected.Value == item.Id;
                        var finalClass = isSelected
                        ? "group flex w-full items-center justify-between rounded-xl bg-blue-600 px-2.5 py-2 text-sm font-medium text-white shadow-sm ring-1 ring-blue-500/30 transition dark:bg-blue-500/20 dark:text-blue-100 dark:ring-blue-400/30"
                            : "group flex w-full items-center justify-between rounded-xl px-2.5 py-2 text-sm font-medium text-slate-700 transition hover:bg-white active:bg-slate-100 dark:text-slate-100 dark:hover:bg-slate-900/80 dark:active:bg-slate-900";

                        <button class="@finalClass"
                                @onclick="() => ChangeAccountGroupSelectedAsync(item)"
                                @oncontextmenu="() => GroupContextM(item)"
                                @oncontextmenu:preventDefault
                                aria-current="@(isSelected ? "page" : null)">
                            <span class="flex items-center gap-1 truncate">
                                <span class="h-2 w-2 rounded-full @(isSelected ? "bg-white" : "bg-slate-300 dark:bg-slate-600")"></span>
                                <span class="truncate">@item.Name</span>
                            </span>

                            <span class="opacity-70 group-hover:opacity-100">
                                @((MarkupString)Icons.DotsVertical)
                            </span>
                        </button>
                    }
                }
                else
                {
                    <div class="px-1 py-2 text-center">
                        <div class="mx-auto mb-1 flex h-10 w-10 items-center justify-center rounded-full bg-slate-100 dark:bg-slate-800">
                            @((MarkupString)Icons.Folder)
                        </div>

                        <div class="text-sm font-semibold text-slate-700 dark:text-slate-100">
                            @AppLoc[nameof(ResourceApp.ThereAreNoItemsToDisplay)]
                        </div>

                        <div class="mt-1 text-xs text-slate-500 dark:text-slate-400">
                            @AppLoc[nameof(ResourceApp.useTheButtonAboveToAddNewItem)]
                        </div>

                        <button type="button"
                                class="mt-1 inline-flex h-8 items-center justify-center rounded-lg border border-blue-300 bg-blue-50 px-3 text-sm font-medium text-blue-700 transition hover:bg-blue-100 dark:border-blue-800/70 dark:bg-blue-950/60 dark:text-blue-300 dark:hover:bg-blue-950/80"
                                @onclick="CreateForm">
                            @AppLoc[nameof(ResourceApp.newItem)]
                        </button>
                    </div>
                }
            </nav>
        </div>
    </aside>

    <section class="order-1 min-w-0">
        @if (GroupSelected.HasValue)
        {
            <AccountUI GroupSelected="GroupSelected.Value" />
        }
        else
        {
            <div class="flex h-full items-center justify-center rounded-2xl border border-dashed border-slate-200 bg-white/80 px-1 text-sm text-slate-500 shadow-sm dark:border-slate-800 dark:bg-slate-950/70 dark:text-slate-400">
                <div class="text-center">
                    <div class="mx-auto mb-1 flex h-10 w-10 items-center justify-center rounded-full bg-slate-100 dark:bg-slate-800">
                        @((MarkupString)Icons.Mouse)
                    </div>
                    <div class="font-medium text-slate-700 dark:text-slate-100">
                        @AppLoc[nameof(ResourceApp.selectAccountGroupHint)]
                    </div>
                </div>
            </div>
        }
    </section>
</div>
