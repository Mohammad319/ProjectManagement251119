@inherits AppComponentBase

<div class="space-y-3 p-4 text-sm">
    <div class="col-span-12 md:col-span-4">
        <div>
            <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@AppLoc[nameof(ResourceApp.StartFromRow)]</label>
            <input type="number" min="1" step="1" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900"
                   placeholder="@AppLoc[nameof(ResourceApp.StartFromRow)]" @bind="RowStart" />
        </div>

        <div>
            <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@CalcLoc[nameof(CalcResource.accountGroups)]</label>
            <input type="number" min="1" step="1" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind="GroupCol" />
        </div>

        <div>
            <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@CalcLoc[nameof(CalcResource.name)]</label>
            <input type="number" min="1" step="1" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind="NameCol" />
        </div>

        <div>
            <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@CalcLoc[nameof(CalcResource.code)]</label>
            <input type="number" min="1" step="1" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind="CodeCol" />
        </div>

        <div>
            <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@CalcLoc[nameof(CalcResource.comment)]</label>
            <input type="number" min="1" step="1" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind="Comment1Col" />
        </div>

        <div>
            <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@CalcLoc[nameof(CalcResource.comment)] 2</label>
            <input type="number" min="1" step="1" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind="Comment2Col" />
        </div>

        <div>
            <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@FormatLoc[nameof(PMAppFormatResource.separator)]</label>
            <input type="text" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900"
                   placeholder="," @bind="Separator" />
        </div>
    </div>

    <div class="mt-5 flex flex-wrap items-center gap-2">
        <InputFile OnChange="OnFileSelection" disabled="@IsBusy" />

        <button class="inline-flex items-center justify-center rounded-md bg-sky-600 px-3 py-1.5 text-sm font-medium text-white transition hover:bg-sky-700 dark:bg-sky-500 dark:hover:bg-sky-400"
                @onclick="ImportByFormatAsync"
                disabled="@(!CanImport)">
            @AppLoc[nameof(ResourceApp.import)]
        </button>

        <button class="inline-flex items-center justify-center rounded-md bg-emerald-600 px-3 py-1.5 text-sm font-medium text-white transition hover:bg-emerald-700 dark:bg-emerald-500 dark:hover:bg-emerald-400"
                @onclick="Save"
                disabled="@(CanSave == false)">
            @AppLoc[nameof(ResourceApp.save)]
        </button>

        <button class="inline-flex items-center justify-center rounded-md border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-700 transition hover:bg-slate-50 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-800"
                @onclick="CloseModal"
                disabled="@IsBusy">
            @AppLoc[nameof(ResourceApp.cancel)]
        </button>

        @if (IsBusy)
        {
            <BlazorMHD.UI.Components.Feedback.Loading.MhdLoading />
        }
    </div>

    @if (Groups.Count > 0)
    {
        <div class="mt-4 rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300">
            @Groups.Count @CalcLoc[nameof(CalcResource.accountGroups)] /
            @Groups.Sum(x => x.Accounts.Count) @CalcLoc[nameof(CalcResource.account)]
        </div>
    }

    <table class="min-w-full divide-y divide-slate-200 overflow-hidden rounded-lg border border-slate-200 text-sm dark:divide-slate-700 dark:border-slate-700 mt-4">
        <thead class="bg-slate-50 dark:bg-slate-800/80">
            <tr>
                <th class="px-3 py-2 text-right text-sm font-semibold text-slate-600 dark:text-slate-200" style="width:52px;"></th>
                <th class="px-3 py-2 text-right text-sm font-semibold text-slate-600 dark:text-slate-200">@CalcLoc[nameof(CalcResource.accountGroups)]</th>
                <th class="px-3 py-2 text-right text-sm font-semibold text-slate-600 dark:text-slate-200">@CalcLoc[nameof(CalcResource.name)]</th>
                <th class="px-3 py-2 text-right text-sm font-semibold text-slate-600 dark:text-slate-200" style="width:140px;">@CalcLoc[nameof(CalcResource.code)]</th>
                <th class="px-3 py-2 text-right text-sm font-semibold text-slate-600 dark:text-slate-200">@CalcLoc[nameof(CalcResource.comment)]</th>
            </tr>
        </thead>

        <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
            @if (Groups.Count == 0)
            {
                <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/60">
                    <td class="px-3 py-2 text-sm text-slate-700 dark:text-slate-200" colspan="5">
                        <div class="p-4 text-sm text-slate-400">
                            @AppLoc[nameof(ResourceApp.ThereAreNoItemsToDisplay)]
                        </div>
                    </td>
                </tr>
            }
            else
            {
                @foreach (var group in Groups)
                {
                    <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/60">
                        <td class="px-3 py-2 text-sm text-slate-700 dark:text-slate-200">
                            <button class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-red-300 bg-red-50 text-red-600 transition hover:bg-red-100 dark:border-red-700 dark:bg-red-900/30 dark:text-red-300 dark:hover:bg-red-900/50"
                                    title="@AppLoc[nameof(ResourceApp.delete)]"
                                    @onclick="() => RemoveGroup(group)">
                                @((MarkupString)Icons.DeleteSVG)
                            </button>
                        </td>

                        <td class="px-3 py-2 text-sm text-slate-700 dark:text-slate-200 font-semibold">@group.Name</td>
                        <td class="px-3 py-2 text-sm text-slate-700 dark:text-slate-200"></td>
                        <td class="px-3 py-2 text-sm text-slate-700 dark:text-slate-200"></td>
                        <td class="px-3 py-2 text-sm text-slate-700 dark:text-slate-200"></td>
                    </tr>

                    @foreach (var account in group.Accounts)
                    {
                        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/60">
                            <td class="px-3 py-2 text-sm text-slate-700 dark:text-slate-200">
                                <button class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-red-300 bg-red-50 text-red-600 transition hover:bg-red-100 dark:border-red-700 dark:bg-red-900/30 dark:text-red-300 dark:hover:bg-red-900/50"
                                        title="@AppLoc[nameof(ResourceApp.delete)]"
                                        @onclick="() => RemoveAccount(group, account)">
                                    @((MarkupString)Icons.DeleteSVG)
                                </button>
                            </td>

                            <td class="px-3 py-2 text-sm text-slate-700 dark:text-slate-200"></td>
                            <td class="px-3 py-2 text-sm text-slate-700 dark:text-slate-200">@account.Name</td>
                            <td class="px-3 py-2 text-sm text-slate-700 dark:text-slate-200">@account.Account</td>
                            <td class="px-3 py-2 text-sm text-slate-700 dark:text-slate-200">
                                @if (account.Data?.Comments is { Count: > 0 })
                                {
                                    @foreach (var c in account.Data.Comments)
                                    {
                                        <div class="truncate">@c</div>
                                    }
                                }
                            </td>
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
</div>
