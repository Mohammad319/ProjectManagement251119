@using Application.Feature.Account.Commands
@using BlazorMHD.UI.Core.DesignSystem
@using ProjectManagement.Shared
@using ProjectManagement.Shared.DTO.Account
@using System.IO

<div class="@CssClasses.Modal.Body">
    <div class="@CssClasses.Grid.Col.MD4">
        <div>
            <label class="@CssClasses.Form.Label">@ResourceApp.StartFromRow</label>
            <input type="number" min="1" step="1" class="@CssClasses.Input.Text"
                   placeholder="@ResourceApp.StartFromRow" @bind="RowStart" />
        </div>

        <div>
            <label class="@CssClasses.Form.Label">@CalcResource.accountGroups</label>
            <input type="number" min="1" step="1" class="@CssClasses.Input.Text" @bind="GroupCol" />
        </div>

        <div>
            <label class="@CssClasses.Form.Label">@CalcResource.name</label>
            <input type="number" min="1" step="1" class="@CssClasses.Input.Text" @bind="NameCol" />
        </div>

        <div>
            <label class="@CssClasses.Form.Label">@CalcResource.code</label>
            <input type="number" min="1" step="1" class="@CssClasses.Input.Text" @bind="CodeCol" />
        </div>

        <div>
            <label class="@CssClasses.Form.Label">@CalcResource.comment</label>
            <input type="number" min="1" step="1" class="@CssClasses.Input.Text" @bind="Comment1Col" />
        </div>

        <div>
            <label class="@CssClasses.Form.Label">@CalcResource.comment 2</label>
            <input type="number" min="1" step="1" class="@CssClasses.Input.Text" @bind="Comment2Col" />
        </div>

        <div>
            <label class="@CssClasses.Form.Label">@PMAppFormatResource.separator</label>
            <input type="text" class="@CssClasses.Input.Text"
                   placeholder="," @bind="Separator" />
        </div>

        <div class="mt-5 flex flex-wrap gap-2 items-center">
            <InputFile OnChange="OnFileSelection" disabled="@IsBusy" />

            <button class="@CssClasses.Btn.Solid.Primary"
                    @onclick="ImportByFormatAsync"
                    disabled="@(!CanImport)">
                @ResourceApp.import
            </button>

            <button class="@CssClasses.Btn.Solid.Success"
                    @onclick="Save"
                    disabled="@(CanSave == false)">
                @ResourceApp.save
            </button>

            @if (IsBusy)
            {
                <BlazorMHD.UI.Components.Feedback.Loading.MhdLoading></BlazorMHD.UI.Components.Feedback.Loading.MhdLoading>
            }
        </div>
    </div>

    <table class="@CssClasses.Table.Tab mt-4">
        <thead class="@CssClasses.Table.Thead">
            <tr>
                <th class="@CssClasses.Table.TH" style="width:52px;"></th>
                <th class="@CssClasses.Table.TH">@CalcResource.accountGroups</th>
                <th class="@CssClasses.Table.TH">@CalcResource.name</th>
                <th class="@CssClasses.Table.TH" style="width:140px;">@CalcResource.code</th>
                <th class="@CssClasses.Table.TH">@CalcResource.comment</th>
            </tr>
        </thead>

        <tbody class="@CssClasses.Table.TBody">
            @if (Groups.Count == 0)
            {
                <tr class="@CssClasses.Table.Tr">
                    <td class="@CssClasses.Table.Td" colspan="5">
                        <div class="p-4 text-sm text-slate-400">
                            @ResourceApp.ThereAreNoItemsToDisplay
                        </div>
                    </td>
                </tr>
            }
            else
            {
                @foreach (var group in Groups)
                {
                    <tr class="@CssClasses.Table.Tr">
                        <td class="@CssClasses.Table.Td">
                            <button class="@CssClasses.Btn.IconButton.Danger"
                                    title="@ResourceApp.delete"
                                    @onclick="() => RemoveGroup(group)">
                                @((MarkupString)Icons.DeleteSVG)
                            </button>
                        </td>

                        <td class="@CssClasses.Table.Td font-semibold">@group.Name</td>
                        <td class="@CssClasses.Table.Td"></td>
                        <td class="@CssClasses.Table.Td"></td>
                        <td class="@CssClasses.Table.Td"></td>
                    </tr>

                    @foreach (var account in group.Accounts)
                    {
                        <tr class="@CssClasses.Table.Tr">
                            <td class="@CssClasses.Table.Td">
                                <button class="@CssClasses.Btn.IconButton.Danger"
                                        title="@ResourceApp.delete"
                                        @onclick="() => RemoveAccount(group, account)">
                                    @((MarkupString)Icons.DeleteSVG)
                                </button>
                            </td>

                            <td class="@CssClasses.Table.Td"></td>
                            <td class="@CssClasses.Table.Td">@account.Name</td>
                            <td class="@CssClasses.Table.Td">@account.Account</td>
                            <td class="@CssClasses.Table.Td">
                                @if (account.Data?.Comments is { Count: > 0 })
                                {
                                    @foreach (var c in account.Data.Comments)
                                    {
                                        <div class="truncate">@c</div>
                                    }
                                }
                            </td>
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
</div>
