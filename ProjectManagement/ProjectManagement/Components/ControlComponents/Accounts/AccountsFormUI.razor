@inherits AppComponentBase

<div class="space-y-4">
    <EditForm id="accountForm"
              Model="@EditModel"
              OnValidSubmit="HandleSubmitAsync"
              class="space-y-4">

        <DataAnnotationsValidator />
        <ValidationSummary class="rounded-xl border border-rose-200 bg-rose-50 p-3 text-xs text-rose-700 dark:border-rose-900/60 dark:bg-rose-950/30 dark:text-rose-300" />

        <div class="grid gap-4 md:grid-cols-2">
            <div>
                <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">
                    @CalcLoc[nameof(CalcResource.name)]
                </label>
                <InputText class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
                           @bind-Value="EditModel.Name" />
            </div>

            <div>
                <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">
                    @CalcLoc[nameof(CalcResource.code)]
                </label>
                <InputText class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
                           @bind-Value="EditModel.Account" />
            </div>

            <div class="md:col-span-2">
                <div class="flex items-center gap-2 rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 dark:border-slate-700 dark:bg-slate-800/60">
                    <InputCheckbox class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 dark:border-slate-600 dark:bg-slate-900"
                                   @bind-Value="EditModel.IsVisible" />
                    <label class="text-sm text-slate-700 dark:text-slate-200">
                        @AppLoc[nameof(ResourceApp.visible)]
                    </label>
                </div>
            </div>

            <div class="md:col-span-2">
                <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">
                    @CalcLoc[nameof(CalcResource.comment)]
                </label>

                <div class="space-y-2 rounded-2xl border border-slate-200 bg-slate-50 p-3 dark:border-slate-700 dark:bg-slate-800/60">
                    @if (EditModel.Data?.Comments is { Count: > 0 })
                    {
                        @for (int i = 0; i < EditModel.Data.Comments.Count; i++)
                        {
                            <div class="flex gap-2">
                                <InputText class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
                                           @bind-Value="EditModel.Data.Comments[i]" />

                                <button type="button"
                                        class="inline-flex items-center justify-center rounded-xl border border-rose-300 bg-rose-50 px-3 py-2 text-sm font-medium text-rose-700 transition hover:bg-rose-100 dark:border-rose-900/60 dark:bg-rose-950/30 dark:text-rose-300 dark:hover:bg-rose-950/50"
                                        title="@AppLoc[nameof(ResourceApp.delete)]"
                                        @onclick="() => RemoveComment(i)">
                                    @((MarkupString)Icons.DeleteSVG)
                                </button>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-sm text-slate-500 dark:text-slate-400">@AppLoc[nameof(ResourceApp.ThereAreNoItemsToDisplay)]</div>
                    }

                    <div>
                        <button type="button"
                                class="inline-flex items-center justify-center rounded-xl border border-blue-300 bg-blue-50 px-3 py-2 text-sm font-medium text-blue-700 transition hover:bg-blue-100 dark:border-blue-900/60 dark:bg-blue-950/30 dark:text-blue-300 dark:hover:bg-blue-950/50"
                                @onclick="AddComment">
                            @AppLoc[LocalizerConst.New,""]
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </EditForm>

    <div class="flex flex-wrap items-center justify-end gap-2 border-t border-slate-200 pt-4 dark:border-slate-700">
        <button type="submit"
                form="accountForm"
                class="inline-flex items-center justify-center rounded-xl border border-emerald-300 bg-emerald-50 px-4 py-2 text-sm font-medium text-emerald-700 transition hover:bg-emerald-100 disabled:cursor-not-allowed disabled:opacity-60 dark:border-emerald-900/60 dark:bg-emerald-950/30 dark:text-emerald-300 dark:hover:bg-emerald-950/50"
                disabled="@IsLoading">
            @AppLoc[nameof(ResourceApp.save)]
        </button>

        <button type="button"
                class="inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
                @onclick="CloseModal"
                disabled="@IsLoading">
            @AppLoc[nameof(ResourceApp.cancel)]
        </button>
    </div>
</div>
