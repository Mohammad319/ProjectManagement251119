@using Application.Interfaces
@using ProjectManagement.Shared

<EditForm id="accountForm"
          Model="@EditModel"
          OnValidSubmit="HandleSubmitAsync">

    <DataAnnotationsValidator />

    <!-- BODY (scroll) -->
    <div class="flex-1 overflow-y-auto">

        <ValidationSummary class="text-xs text-rose-600 bg-rose-50 dark:bg-rose-900/20 p-2 rounded-md" />

        <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-3 space-y-3">

            <!-- Toolbar (compact) -->
            <div class="flex items-center justify-between gap-2">
                <div class="text-sm font-semibold text-gray-800 dark:text-gray-100">
                    @CalcResource.account
                </div>

                <div class="flex items-center gap-2">
                    <label class="inline-flex items-center gap-2 text-xs text-gray-700 dark:text-gray-200 select-none">
                        <InputCheckbox class="h-4 w-4 text-blue-600 rounded focus:ring-blue-500 dark:text-blue-400"
                                       @bind-Value="EditModel.IsVisible" />
                        <span>@ResourceApp.isVisible</span>
                    </label>

                    <button type="button"
                            class="inline-flex items-center gap-2 px-2 py-1 text-xs rounded-md
                                   bg-blue-600 text-white hover:bg-blue-700
                                   dark:bg-blue-500 dark:hover:bg-blue-600 transition"
                            @onclick="AddComment">
                        @((MarkupString)Icons.Plus)
                        <span>@CalcResource.comment</span>
                    </button>
                </div>
            </div>

            <!-- Fields (compact) -->
            <div class="grid grid-cols-1 md:grid-cols-4 gap-2">

                <div class="md:col-span-2 space-y-1">
                    <label class="block text-xs text-gray-700 dark:text-gray-300 text-right">
                        @CalcResource.account
                    </label>
                    <InputText class="w-full border border-gray-300 rounded px-2 py-1 text-sm
                                      focus:outline-none focus:ring-2 focus:ring-blue-500
                                      dark:bg-gray-800 dark:border-gray-600 dark:text-white"
                               @bind-Value="EditModel.Account" />
                    <ValidationMessage For="@(() => EditModel.Account)" class="text-xs text-rose-600" />
                </div>

                <div class="md:col-span-2 space-y-1">
                    <label class="block text-xs text-gray-700 dark:text-gray-300 text-right">
                        @CalcResource.name
                    </label>
                    <InputText class="w-full border border-gray-300 rounded px-2 py-1 text-sm
                                      focus:outline-none focus:ring-2 focus:ring-blue-500
                                      dark:bg-gray-800 dark:border-gray-600 dark:text-white"
                               @bind-Value="EditModel.Name" />
                    <ValidationMessage For="@(() => EditModel.Name)" class="text-xs text-rose-600" />
                </div>
            </div>

            <!-- Comments (scrollable area inside body if needed) -->
            <div class="space-y-2">
                <div class="flex items-center justify-between">
                    <div class="text-sm font-semibold text-gray-800 dark:text-gray-100">
                        @CalcResource.comment
                    </div>

                    @if (EditModel?.Data?.Comments is not null)
                    {
                        <div class="text-xs text-gray-500 dark:text-gray-400">
                            @EditModel.Data.Comments.Count
                        </div>
                    }
                </div>

                @if (EditModel?.Data?.Comments is not null && EditModel.Data.Comments.Count > 0)
                {
                    <div class="space-y-2 max-h-[260px] overflow-y-auto pr-1">
                        @for (var i = 0; i < EditModel.Data.Comments.Count; i++)
                        {
                            var idx = i;

                            <div class="flex items-center gap-2">

                                <!-- Comment Input -->
                                <InputText class="flex-1 border border-gray-300 rounded px-2 py-1 text-sm
                                          focus:outline-none focus:ring-2 focus:ring-blue-500
                                          dark:bg-gray-800 dark:border-gray-600 dark:text-white"
                                           @bind-Value="EditModel.Data.Comments[idx]" />

                                <!-- Delete Button -->
                                <button type="button"
                                        class="inline-flex items-center justify-center w-8 h-8 rounded-md
                                       border border-red-300 text-red-600
                                       hover:bg-red-100 hover:ring-1 hover:ring-red-300
                                       dark:border-red-400 dark:text-red-300 dark:hover:bg-red-900/40
                                       transition-all duration-150"
                                        title="@ResourceApp.delete"
                                        @onclick="() => RemoveComment(idx)">
                                    @((MarkupString)Icons.DeleteSVG)
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>

        </div>
    </div>

    <!-- FOOTER (sticky) -->
    <div class="shrink-0 border-t border-gray-200 dark:border-gray-700 bg-white/80 dark:bg-gray-800/80
                backdrop-blur px-3 py-2 flex justify-end gap-2">

        <button type="submit"
                form="accountForm"
                class="px-3 py-1.5 text-sm rounded-md border border-green-600 text-green-600
                       hover:bg-green-600 hover:text-white
                       dark:border-green-400 dark:text-green-400 dark:hover:bg-green-400 dark:hover:text-white
                       transition"
                disabled="@IsLoading"
                aria-busy="@IsLoading">
            @ResourceApp.save
        </button>

        <button type="button"
                class="px-3 py-1.5 text-sm rounded-md border border-gray-500 text-gray-600
                       hover:bg-gray-500 hover:text-white
                       dark:border-gray-400 dark:text-gray-300 dark:hover:bg-gray-400 dark:hover:text-white
                       transition"
                data-bs-dismiss="modal"
                @onclick="CloseModal"
                disabled="@IsLoading">
            @ResourceApp.cancel
        </button>
    </div>
</EditForm>