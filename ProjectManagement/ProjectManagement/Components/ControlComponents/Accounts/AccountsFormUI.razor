@inherits AppComponentBase

<EditForm id="accountForm"
          Model="@EditModel"
          OnValidSubmit="HandleSubmitAsync"
          class="@CssClasses.Modal.Body">

    <DataAnnotationsValidator />

    <div class="@CssClasses.Grid.Col.MD3">

        <div>
            <label class="@CssClasses.Form.Label">
                @CalcLoc[nameof(CalcResource.name)]
            </label>
            <InputText class="@CssClasses.Input.Text"
                       @bind-Value="EditModel.Name" />
        </div>

        <div>
            <label class="@CssClasses.Form.Label">
                @CalcLoc[nameof(CalcResource.code)]
            </label>
            <InputText class="@CssClasses.Input.Text"
                       @bind-Value="EditModel.Account" />
        </div>

        <div class="flex items-center gap-2 mt-2">
            <InputCheckbox @bind-Value="EditModel.IsVisible" />
            <label class="text-sm">
                @AppLoc[nameof(ResourceApp.visible)]
            </label>
        </div>

        <!-- Comments -->
        <div class="mt-4">
            <label class="@CssClasses.Form.Label">
                @CalcLoc[nameof(CalcResource.comment)]
            </label>

            @if (EditModel.Data?.Comments is { Count: > 0 })
            {
                @for (int i = 0; i < EditModel.Data.Comments.Count; i++)
                {
                    <div class="flex gap-2 mb-2">
                        <InputText class="@CssClasses.Input.Text"
                                   @bind-Value="EditModel.Data.Comments[i]" />

                        <button type="button"
                                class="@CssClasses.Btn.IconButton.Danger"
                                title="@AppLoc[nameof(ResourceApp.delete)]"
                                @onclick="() => RemoveComment(i)">
                            @((MarkupString)Icons.DeleteSVG)
                        </button>
                    </div>
                }
            }

            <button type="button"
                    class="@CssClasses.Btn.Outline.Primary mt-2"
                    @onclick="AddComment">
                @AppLoc[LocalizerConst.New,""]
            </button>
        </div>
    </div>
</EditForm>

<div class="@CssClasses.Modal.Footer">
    <button type="submit"
            form="accountForm"
            class="@CssClasses.Btn.Outline.Success"
            disabled="@IsLoading">
        @AppLoc[nameof(ResourceApp.save)]
    </button>

    <button type="button"
            class="@CssClasses.Btn.Outline.Secondary"
            @onclick="CloseModal"
            disabled="@IsLoading">
        @AppLoc[nameof(ResourceApp.cancel)]
    </button>
</div>
