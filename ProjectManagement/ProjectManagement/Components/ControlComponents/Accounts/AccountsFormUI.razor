@using ProjectManagement.Components.ControlComponents.Department
@using ProjectManagement.Shared.DTO.General
@inherits AppComponentBase

<div class="w-full min-w-0 space-y-2 text-slate-800 dark:text-slate-100">
    <EditForm id="@DialogFormId"
              Model="@EditModel"
              OnSubmit="HandleSubmitAsync"
              class="w-full min-w-0 space-y-2">

        @if (!string.IsNullOrWhiteSpace(_saveError))
        {
            <div class="rounded-lg border border-rose-200 bg-rose-50 p-2 text-sm text-rose-700 dark:border-rose-900/60 dark:bg-rose-950/30 dark:text-rose-300" role="alert">
                @_saveError
            </div>
        }

        <div class="grid grid-cols-1 gap-2 md:grid-cols-2 xl:grid-cols-3">
            <!-- Code -->
            <div class="min-w-0">
                <label class="mb-1 block text-xs font-medium text-slate-700 dark:text-slate-200">
                    @CalcLoc[nameof(CalcResource.code)] <span class="text-rose-500">*</span>
                </label>
                <InputText class="h-9 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-900 shadow-sm outline-none transition
                focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20
                dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
                           @bind-Value="EditModel.Account" />
                @if (!string.IsNullOrWhiteSpace(_codeError))
                {
                    <div class="mt-1 text-xs text-rose-600 dark:text-rose-400">@_codeError</div>
                }
            </div>

            <!-- Name -->
            <div class="min-w-0">
                <label class="mb-1 block text-xs font-medium text-slate-700 dark:text-slate-200">
                    @CalcLoc[nameof(CalcResource.name)] <span class="text-rose-500">*</span>
                </label>
                <InputText class="h-9 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-900 shadow-sm outline-none transition
                focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20
                dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
                           @bind-Value="EditModel.Name" />
                @if (!string.IsNullOrWhiteSpace(_nameError))
                {
                    <div class="mt-1 text-xs text-rose-600 dark:text-rose-400">@_nameError</div>
                }
            </div>

            <!-- Account group -->
            <div class="min-w-0">
                <label class="mb-1 block text-xs font-medium text-slate-700 dark:text-slate-200">
                    @CalcLoc[nameof(CalcResource.accountGroups)] <span class="text-rose-500">*</span>
                </label>
                <AppSelect TValue="int"
                           FullWidth="true"
                           Placeholder="@CalcLoc[nameof(CalcResource.accountGroups)]"
                           Options="GroupOptions"
                           @bind-Value="EditModel.AccountGroupId" />
                @if (!string.IsNullOrWhiteSpace(_groupError))
                {
                    <div class="mt-1 text-xs text-rose-600 dark:text-rose-400">@_groupError</div>
                }
            </div>

            <!-- Visible -->
            <div class="md:col-span-2 xl:col-span-3">
                <div class="flex min-h-9 items-center gap-2 rounded-lg border border-slate-200 bg-slate-50 px-3 py-2
                    dark:border-slate-700 dark:bg-slate-800/60">
                    <InputCheckbox class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500
                    dark:border-slate-600 dark:bg-slate-900"
                                   @bind-Value="EditModel.IsVisible" />
                    <label class="text-sm text-slate-700 dark:text-slate-200">
                        Synlig i kalkyl
                    </label>
                </div>
            </div>

            <!-- Comment 1 -->
            <div class="md:col-span-1 xl:col-span-3 min-w-0">
                <label class="mb-1 block text-xs font-medium text-slate-700 dark:text-slate-200">Kommentar 1</label>
                <InputText class="h-9 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-900 shadow-sm outline-none transition
                focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20
                dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
                           @bind-Value="EditModel.Data.Comments[0]" />
            </div>

            <!-- Comment 2 -->
            <div class="md:col-span-1 xl:col-span-3 min-w-0">
                <label class="mb-1 block text-xs font-medium text-slate-700 dark:text-slate-200">Kommentar 2</label>
                <InputText class="h-9 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-900 shadow-sm outline-none transition
                focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20
                dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
                           @bind-Value="EditModel.Data.Comments[1]" />
            </div>
        </div>
    </EditForm>

</div>
