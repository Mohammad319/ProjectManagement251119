@using ProjectManagement.Components.ControlComponents.Department
@using ProjectManagement.Shared.DTO.General
@inherits AppComponentBase

<div class="w-full min-w-0 space-y-2 text-slate-800 dark:text-slate-100">
    <EditForm id="@DialogFormId"
              Model="@EditModel"
              OnValidSubmit="HandleSubmitAsync"
              class="w-full min-w-0 space-y-2">

        <DataAnnotationsValidator />

        <ValidationSummary class="rounded-lg border border-rose-200 bg-rose-50 p-2 text-xs text-rose-700 dark:border-rose-900/60 dark:bg-rose-950/30 dark:text-rose-300" />

        <div class="grid grid-cols-1 gap-2 md:grid-cols-2 xl:grid-cols-3">
            <!-- Name -->
            <div class="min-w-0">
                <label class="mb-1 block text-xs font-medium text-slate-700 dark:text-slate-200">
                    @CalcLoc[nameof(CalcResource.name)]
                </label>
                <InputText class="h-9 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-900 shadow-sm outline-none transition
                focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20
                dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
                           @bind-Value="EditModel.Name" />
            </div>

            <!-- Code -->
            <div class="min-w-0">
                <label class="mb-1 block text-xs font-medium text-slate-700 dark:text-slate-200">
                    @CalcLoc[nameof(CalcResource.code)]
                </label>
                <InputText class="h-9 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-900 shadow-sm outline-none transition
                focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20
                dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
                           @bind-Value="EditModel.Account" />
            </div>

            <!-- Account group -->
            <div class="min-w-0">
                <label class="mb-1 block text-xs font-medium text-slate-700 dark:text-slate-200">
                    @CalcLoc[nameof(CalcResource.accountGroups)]
                </label>
                <AppSelect TValue="int"
                           FullWidth="true"
                           Placeholder="@CalcLoc[nameof(CalcResource.accountGroups)]"
                           Options="GroupOptions"
                           @bind-Value="EditModel.AccountGroupId" />
            </div>

            <!-- Visible -->
            <div class="md:col-span-2 xl:col-span-3">
                <div class="flex min-h-9 items-center gap-2 rounded-lg border border-slate-200 bg-slate-50 px-3 py-2
                    dark:border-slate-700 dark:bg-slate-800/60">
                    <InputCheckbox class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500
                    dark:border-slate-600 dark:bg-slate-900"
                                   @bind-Value="EditModel.IsVisible" />
                    <label class="text-sm text-slate-700 dark:text-slate-200">
                        @AppLoc[nameof(ResourceApp.visible)]
                    </label>
                </div>
            </div>

            <!-- Comments -->
            <div class="md:col-span-2 xl:col-span-3 min-w-0">
                <label class="mb-1 block text-xs font-medium text-slate-700 dark:text-slate-200">
                    @CalcLoc[nameof(CalcResource.comment)]
                </label>

                <div class="space-y-1.5 rounded-lg border border-slate-200 bg-slate-50 p-2 dark:border-slate-700 dark:bg-slate-800/60">
                    @if (EditModel.Data?.Comments is { Count: > 0 })
                    {
                        @for (int i = 0; i < EditModel.Data.Comments.Count; i++)
                        {
                            <div class="flex min-w-0 items-center gap-2">
                                <InputText class="h-9 min-w-0 flex-1 rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-900 shadow-sm outline-none transition
                                focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20
                                dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
                                           @bind-Value="EditModel.Data.Comments[i]" />

                                <button type="button"
                                        class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-rose-300 bg-rose-50
                                    text-rose-700 transition hover:bg-rose-100
                                    dark:border-rose-900/60 dark:bg-rose-950/30 dark:text-rose-300 dark:hover:bg-rose-950/50"
                                        title="@AppLoc[nameof(ResourceApp.delete)]"
                                        @onclick="() => RemoveComment(i)">
                                    @((MarkupString)Icons.DeleteSVG)
                                </button>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="rounded-lg border border-dashed border-slate-300 bg-white/70 px-3 py-2 text-sm text-slate-500
                            dark:border-slate-700 dark:bg-slate-900/40 dark:text-slate-400">
                            @AppLoc[nameof(ResourceApp.ThereAreNoItemsToDisplay)]
                        </div>
                    }

                    <div class="pt-1">
                        <button type="button"
                                class="inline-flex h-9 items-center justify-center rounded-lg border border-blue-300 bg-blue-50 px-3
                            text-sm font-medium text-blue-700 transition hover:bg-blue-100
                            dark:border-blue-900/60 dark:bg-blue-950/30 dark:text-blue-300 dark:hover:bg-blue-950/50"
                                @onclick="AddComment">
                            @AppLoc[LocalizerConst.New, ""]
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </EditForm>

</div>
