@using ProjectManagement.Shared.Enums
@inherits AppComponentBase

<EditForm id="@DialogFormId" EditContext="editContext" OnValidSubmit="HandleSubmitAsync" class="space-y-4 px-1 py-1">
    <DataAnnotationsValidator />

    <div class="grid gap-3 md:grid-cols-2 lg:grid-cols-3">
        <div class="space-y-2">
            <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">@CalcLoc[nameof(CalcResource.name)]</label>
            <InputText class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100" @bind-Value="@ResourceTypeUpdate.Name" />
            <ValidationMessage For="@(() => ResourceTypeUpdate.Name)" class="text-sm text-rose-600 dark:text-rose-400" />
        </div>

        @if (AccountGroups is not null)
        {
            <div class="space-y-2">
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">@CalcLoc[nameof(CalcResource.accountGroups)]</label>
                <select @onchange="ChangeGroupAccount" class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100">
                    <option value="0"></option>
                    @foreach (var item in AccountGroups)
                    {
                        <option value="@item.Id" selected="@(AccountGroupSelected is not null && AccountGroupSelected.Id == item.Id)">@item.Name</option>
                    }
                </select>
            </div>

            @if (AccountGroupSelected?.Accounts is { Count: > 0 })
            {
                <div class="space-y-2">
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">@CalcLoc[nameof(CalcResource.account)]</label>
                    <InputSelect @bind-Value="ResourceTypeUpdate.AccountId" class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100">
                        <option></option>
                        @foreach (var item in AccountGroupSelected.Accounts)
                        {
                            <option value="@item.Id">@item.Name</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => ResourceTypeUpdate.AccountId)" class="text-sm text-rose-600 dark:text-rose-400" />
                </div>
            }
        }

        <div class="space-y-2">
            <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">@CalcLoc[nameof(CalcResource.resourceType)]</label>
            <InputSelect @bind-Value="@ResourceTypeUpdate.Type" class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100">
                @foreach (ResourceTypesEnum level in Enum.GetValues(typeof(ResourceTypesEnum)))
                {
                    <option value="@level">@ResourceLocalize.GetResourceType(level)</option>
                }
            </InputSelect>
            <ValidationMessage For="@(() => ResourceTypeUpdate.Type)" class="text-sm text-rose-600 dark:text-rose-400" />
        </div>

        <div class="space-y-2">
            <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">@CalcLoc[nameof(CalcResource.unit)]</label>
            <InputText @bind-Value="ResourceTypeUpdate.Unit" class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100" />
            <ValidationMessage For="@(() => ResourceTypeUpdate.Unit)" class="text-sm text-rose-600 dark:text-rose-400" />
        </div>

        <div class="space-y-2">
            <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">@CalcLoc[nameof(CalcResource.cost)]</label>
            <InputNumber @bind-Value="ResourceTypeUpdate.Cost" class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100" />
            <ValidationMessage For="@(() => ResourceTypeUpdate.Cost)" class="text-sm text-rose-600 dark:text-rose-400" />
        </div>

        <div class="space-y-2">
            <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">@CalcLoc[nameof(CalcResource.fixedQ)]</label>
            <InputNumber @bind-Value="ResourceTypeUpdate.FixedQ" class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100" />
            <ValidationMessage For="@(() => ResourceTypeUpdate.FixedQ)" class="text-sm text-rose-600 dark:text-rose-400" />
        </div>

        <div class="space-y-2">
            <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">@CalcLoc[nameof(CalcResource.changeFactor1)]</label>
            <InputNumber @bind-Value="ResourceTypeUpdate.ChangeFactor1" class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100" />
            <ValidationMessage For="@(() => ResourceTypeUpdate.ChangeFactor1)" class="text-sm text-rose-600 dark:text-rose-400" />
        </div>

        <div class="space-y-2">
            <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">@CalcLoc[nameof(CalcResource.changeFactor2)]</label>
            <InputNumber @bind-Value="ResourceTypeUpdate.ChangeFactor2" class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100" />
            <ValidationMessage For="@(() => ResourceTypeUpdate.ChangeFactor2)" class="text-sm text-rose-600 dark:text-rose-400" />
        </div>

        <div class="space-y-2">
            <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">@CalcLoc[nameof(CalcResource.co2)]</label>
            <InputNumber @bind-Value="ResourceTypeUpdate.CO2" class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100" />
            <ValidationMessage For="@(() => ResourceTypeUpdate.CO2)" class="text-sm text-rose-600 dark:text-rose-400" />
        </div>

        <div class="space-y-2">
            <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">@CalcLoc[nameof(CalcResource.baseCost)]</label>
            <InputNumber @bind-Value="ResourceTypeUpdate.BaseCost" class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100" />
            <ValidationMessage For="@(() => ResourceTypeUpdate.BaseCost)" class="text-sm text-rose-600 dark:text-rose-400" />
        </div>

        @if (ResourceTypeUpdate.Type is ResourceTypesEnum.Materials or ResourceTypesEnum.Worker or ResourceTypesEnum.MachinesAndEquipments)
        {
            <div class="space-y-2">
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">@(ResourceTypeUpdate.Type == ResourceTypesEnum.Materials ? CalcResource.waste : CalcResource.cap)</label>
                <InputNumber @bind-Value="ResourceTypeUpdate.CapWaste" class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100" />
                <ValidationMessage For="@(() => ResourceTypeUpdate.CapWaste)" class="text-sm text-rose-600 dark:text-rose-400" />
            </div>
        }

        <div class="flex items-center gap-3 rounded-xl border border-slate-200 bg-slate-50 px-3 py-3 dark:border-slate-700 dark:bg-slate-900 lg:col-span-3">
            <InputCheckbox id="resourceTypeVisible" class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 dark:border-slate-600 dark:bg-slate-950" @bind-Value="@ResourceTypeUpdate.IsVisible" />
            <label class="text-sm font-medium text-slate-700 dark:text-slate-200" for="resourceTypeVisible">@AppLoc[nameof(ResourceApp.isVisible)]</label>
        </div>
    </div>
</EditForm>
