@using Application.Feature.Account.Queries
@using Application.Feature.Calculation.ResourceType.Commands
@using ProjectManagement.Components.ControlComponents.Department
@using ProjectManagement.Shared.DTO.Account
@using ProjectManagement.Shared.DTO.ResourceType
@inherits AppComponentBase

<EditForm id="@DialogFormId" Model="EditModel" OnValidSubmit="HandleSubmitAsync" class="space-y-4 px-1 py-1">
    <DataAnnotationsValidator />

    <div class="grid gap-3 md:grid-cols-2 lg:grid-cols-3">
        <div class="space-y-2 lg:col-span-3">
            <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">Namn</label>
            <InputText class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100" @bind-Value="@EditModel.Name" />
            <ValidationMessage For="@(() => EditModel.Name)" class="text-sm text-rose-600 dark:text-rose-400" />
        </div>

        @if (AccountGroups is not null)
        {
            @if (HasParentAllowedAccounts)
            {
                <label class="flex cursor-pointer items-center gap-2 rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-900 lg:col-span-3"
                       title="Om detta är av använder resurssorten resurstypens tillåtna konton.">
                    <InputCheckbox class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 dark:border-slate-600 dark:bg-slate-950"
                                   @bind-Value:get="EditModel.UseOwnAccountSettings"
                                   @bind-Value:set="OnUseOwnChanged" />
                    <span class="font-medium text-slate-700 dark:text-slate-200">Använd egna kontoinställningar för denna resurssort</span>
                </label>
            }

            @if (EditModel.UseOwnAccountSettings || !HasParentAllowedAccounts)
            {
                <AllowedAccountsSelect Groups="AccountGroups"
                                       Selected="EditModel.AllowedAccountIds"
                                       SelectedChanged="OnAllowedAccountsChanged"
                                       RestrictToIds="ParentRestrictIds" />
            }
            else
            {
                <div class="space-y-2 lg:col-span-2">
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">Tillåtna konton</label>
                    <div class="flex h-9 items-center rounded-xl border border-slate-200 bg-slate-50 px-3 text-sm text-slate-500 dark:border-slate-700 dark:bg-slate-800/50 dark:text-slate-400">
                        Ärver från resurstypen (@ParentAllowedAccountIds.Count konton)
                    </div>
                </div>
            }

            @if (EffectiveAllowedOptions.Count > 0)
            {
                <div class="space-y-2">
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">Standardkonto</label>
                    <AppSelect TValue="int?"
                               FullWidth="true"
                               Placeholder="Välj standardkonto"
                               Options="EffectiveAllowedOptions"
                               @bind-Value="EditModel.AccountId" />
                    <ValidationMessage For="@(() => EditModel.AccountId)" class="text-sm text-rose-600 dark:text-rose-400" />
                </div>
            }
        }

        <div class="flex flex-wrap items-center gap-4 rounded-xl border border-slate-200 bg-slate-50 px-3 py-3 dark:border-slate-700 dark:bg-slate-900 lg:col-span-3">
            <div class="flex items-center gap-2">
                <InputCheckbox id="resourceSortVisible" class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 dark:border-slate-600 dark:bg-slate-950" @bind-Value="@EditModel.IsVisible" />
                <label class="text-sm font-medium text-slate-700 dark:text-slate-200" for="resourceSortVisible">@AppLoc[nameof(ResourceApp.isVisible)]</label>
            </div>
            <div class="flex items-center gap-2">
                <InputCheckbox id="resourceSortDefault" class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 dark:border-slate-600 dark:bg-slate-950" @bind-Value="@EditModel.IsDefault" />
                <label class="text-sm font-medium text-slate-700 dark:text-slate-200" for="resourceSortDefault">Standard</label>
            </div>
        </div>
    </div>
</EditForm>

@code {
    public const string DialogFormId = "resourceSortForm";
    [Parameter] public EventCallback<bool> Callback { get; set; }
    [Parameter] public ResourceSortModel ResourceSort { get; set; } = new();

    /// <summary>Allowed account ids inherited from the parent resource type (empty = unrestricted).</summary>
    [Parameter] public List<int> ParentAllowedAccountIds { get; set; } = [];

    private bool IsLoading;
    private readonly PostResourceSortDTO EditModel = new();
    private List<ListAccountGroupIncludeAccountDTO>? AccountGroups;
    private ResourceSortModel? PreviousResourceSort;

    private bool HasParentAllowedAccounts => ParentAllowedAccountIds is { Count: > 0 };
    private IReadOnlyCollection<int>? ParentRestrictIds => HasParentAllowedAccounts ? ParentAllowedAccountIds : null;

    // The set of accounts the calculation user will be able to pick for this sort.
    private List<int> EffectiveAllowedIds =>
        EditModel.UseOwnAccountSettings ? EditModel.AllowedAccountIds : (ParentAllowedAccountIds ?? []);

    private IReadOnlyList<AppSelect<int?>.Option> EffectiveAllowedOptions =>
        (AccountGroups ?? [])
            .SelectMany(g => g.Accounts ?? [])
            .Where(a => EffectiveAllowedIds.Contains(a.Id))
            .Select(a => new AppSelect<int?>.Option(
                a.Id,
                string.IsNullOrWhiteSpace(a.Account) ? a.Name : $"{a.Account} ({a.Name})"))
            .ToList();

    protected override async Task OnParametersSetAsync()
    {
        AccountGroups ??= await Dispatcher.Send(new GetAccountGroupsAsListQuery());

        if (!ReferenceEquals(PreviousResourceSort, ResourceSort))
        {
            PropertyCopier.CopyPropertiesTo(ResourceSort, EditModel);
            PreviousResourceSort = ResourceSort;
        }
    }

    private void OnUseOwnChanged(bool value)
    {
        EditModel.UseOwnAccountSettings = value;
        PruneDefaultAccount();
    }

    private void OnAllowedAccountsChanged(List<int> allowed)
    {
        EditModel.AllowedAccountIds = allowed;
        PruneDefaultAccount();
    }

    private void PruneDefaultAccount()
    {
        if (EditModel.AccountId is > 0 && !EffectiveAllowedIds.Contains(EditModel.AccountId.Value))
            EditModel.AccountId = null;
    }

    private void CloseModal() => MHD.Modal.CloseAsync();

    private async Task HandleSubmitAsync()
    {
        if (IsLoading)
            return;

        IsLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            bool result;

            if (ResourceSort.Id == 0)
                result = await Dispatcher.Send(new CreateResourceSortCommand(ResourceSort.ResourceTypeId, EditModel)) > 0;
            else
                result = await Dispatcher.Send(new UpdateResourceSortCommand(ResourceSort.Id, EditModel));

            MHD.Notifications(ResourceSort.Id == 0 ? ToastType.Add : ToastType.Update, result);
            await Callback.InvokeAsync(result);
        }
        finally
        {
            IsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}
