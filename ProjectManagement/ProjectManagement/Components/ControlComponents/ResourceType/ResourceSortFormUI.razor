@using Application.Feature.Account.Queries
@using Application.Feature.Calculation.ResourceType.Commands
@using ProjectManagement.Shared.DTO.Account
@using ProjectManagement.Shared.DTO.ResourceType
@inherits AppComponentBase

<EditForm id="@DialogFormId" Model="EditModel" OnValidSubmit="HandleSubmitAsync" class="space-y-6 px-1 py-1">
    <DataAnnotationsValidator />

    <div class="grid gap-4 md:grid-cols-4">
        <div class="space-y-2 md:col-span-2">
            <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">@CalcLoc[nameof(CalcResource.name)]</label>
            <InputText class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100" @bind-Value="@EditModel.Name" />
            <ValidationMessage For="@(() => EditModel.Name)" class="text-sm text-rose-600 dark:text-rose-400" />
        </div>

        @if (AccountGroups is not null)
        {
            <div class="space-y-2">
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">@CalcLoc[nameof(CalcResource.accountGroups)]</label>
                <select @onchange="ChangeGroupAccount" class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100">
                    <option value="0"></option>
                    @foreach (var item in AccountGroups)
                    {
                        <option value="@item.Id" selected="@(AccountGroupSelected is not null && AccountGroupSelected.Id == item.Id)">@item.Name</option>
                    }
                </select>
            </div>

            @if (AccountGroupSelected?.Accounts is { Count: > 0 })
            {
                <div class="space-y-2">
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">@CalcLoc[nameof(CalcResource.account)]</label>
                    <InputSelect @bind-Value="EditModel.AccountId" class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100">
                        <option></option>
                        @foreach (var item in AccountGroupSelected.Accounts)
                        {
                            <option value="@item.Id">@item.Name</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => EditModel.AccountId)" class="text-sm text-rose-600 dark:text-rose-400" />
                </div>
            }
        }

        <div class="space-y-2">
            <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">@CalcLoc[nameof(CalcResource.unit)]</label>
            <InputText @bind-Value="EditModel.Unit" class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100" />
            <ValidationMessage For="@(() => EditModel.Unit)" class="text-sm text-rose-600 dark:text-rose-400" />
        </div>

        <div class="space-y-2">
            <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">@CalcLoc[nameof(CalcResource.cost)]</label>
            <InputNumber @bind-Value="EditModel.Cost" class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100" />
            <ValidationMessage For="@(() => EditModel.Cost)" class="text-sm text-rose-600 dark:text-rose-400" />
        </div>

        <div class="space-y-2">
            <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">@CalcLoc[nameof(CalcResource.fixedQ)]</label>
            <InputNumber @bind-Value="EditModel.FixedQ" class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100" />
            <ValidationMessage For="@(() => EditModel.FixedQ)" class="text-sm text-rose-600 dark:text-rose-400" />
        </div>

        <div class="space-y-2">
            <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">@CalcLoc[nameof(CalcResource.changeFactor1)]</label>
            <InputNumber @bind-Value="EditModel.ChangeFactor1" class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100" />
            <ValidationMessage For="@(() => EditModel.ChangeFactor1)" class="text-sm text-rose-600 dark:text-rose-400" />
        </div>

        <div class="space-y-2">
            <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">@CalcLoc[nameof(CalcResource.changeFactor2)]</label>
            <InputNumber @bind-Value="EditModel.ChangeFactor2" class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100" />
            <ValidationMessage For="@(() => EditModel.ChangeFactor2)" class="text-sm text-rose-600 dark:text-rose-400" />
        </div>

        <div class="space-y-2">
            <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">@CalcLoc[nameof(CalcResource.co2)]</label>
            <InputNumber @bind-Value="EditModel.CO2" class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100" />
            <ValidationMessage For="@(() => EditModel.CO2)" class="text-sm text-rose-600 dark:text-rose-400" />
        </div>

        <div class="space-y-2">
            <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">@CalcLoc[nameof(CalcResource.baseCost)]</label>
            <InputNumber @bind-Value="EditModel.BaseCost" class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100" />
            <ValidationMessage For="@(() => EditModel.BaseCost)" class="text-sm text-rose-600 dark:text-rose-400" />
        </div>

        <div class="flex items-center gap-3 rounded-xl border border-slate-200 bg-slate-50 px-3 py-3 dark:border-slate-700 dark:bg-slate-900 md:col-span-4">
            <InputCheckbox id="resourceSortVisible" class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 dark:border-slate-600 dark:bg-slate-950" @bind-Value="@EditModel.IsVisible" />
            <label class="text-sm font-medium text-slate-700 dark:text-slate-200" for="resourceSortVisible">@AppLoc[nameof(ResourceApp.isVisible)]</label>
        </div>
    </div>
</EditForm>

@code {
    public const string DialogFormId = "resourceSortForm";
    [Parameter] public EventCallback<bool> Callback { get; set; }
    [Parameter] public ResourceSortModel ResourceSort { get; set; } = new();

    private bool IsLoading;
    private readonly PostResourceSortDTO EditModel = new();
    private List<ListAccountGroupIncludeAccountDTO>? AccountGroups;
    private ListAccountGroupIncludeAccountDTO? AccountGroupSelected;
    private ResourceSortModel? PreviousResourceSort;

    protected override async Task OnParametersSetAsync()
    {
        AccountGroups ??= await Dispatcher.Send(new GetAccountGroupsAsListQuery());

        if (!ReferenceEquals(PreviousResourceSort, ResourceSort))
        {
            PropertyCopier.CopyPropertiesTo(ResourceSort, EditModel);
            PreviousResourceSort = ResourceSort;
        }

        if (ResourceSort.Id > 0)
            AccountGroupSelected = AccountGroups?.FirstOrDefault(x => x.Accounts?.Any(a => a.Id == EditModel.AccountId) == true);
    }

    private async Task ChangeGroupAccount(ChangeEventArgs e)
    {
        AccountGroupSelected = null;
        EditModel.AccountId = null;

        if (!int.TryParse(e.Value?.ToString(), out var id) || id == 0)
            return;

        await Task.Yield();
        AccountGroupSelected = AccountGroups?.FirstOrDefault(x => x.Id == id);
    }

    private void CloseModal() => MHD.Modal.Close();

    private async Task HandleSubmitAsync()
    {
        if (IsLoading)
            return;

        IsLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            bool result;

            if (ResourceSort.Id == 0)
                result = await Dispatcher.Send(new CreateResourceSortCommand(ResourceSort.ResourceTypeId, EditModel)) > 0;
            else
                result = await Dispatcher.Send(new UpdateResourceSortCommand(ResourceSort.Id, EditModel));

            MHD.Notifications(ResourceSort.Id == 0 ? ToastType.Add : ToastType.Update, result);
            await Callback.InvokeAsync(result);
        }
        finally
        {
            IsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}
