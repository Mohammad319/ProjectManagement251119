@using Application.Feature.Account.Queries
@using Application.Feature.Calculation.ResourceType.Commands
@using ProjectManagement.Shared.DTO.Account
@using ProjectManagement.Shared.DTO.ResourceType
@inherits AppComponentBase

<EditForm id="resourceSortForm" class="@CssClasses.Modal.Body" Model="EditModel" OnValidSubmit="HandleSubmitAsync">
    <DataAnnotationsValidator />

    <div class="@CssClasses.Grid.Col.MD4">
        <div class="@CssClasses.Grid.Span.MD2">
            <label class="@CssClasses.Form.Label">@CalcLoc[nameof(CalcResource.name)]</label>
            <InputText class="@CssClasses.Input.Text" @bind-Value="@EditModel.Name" />
            <ValidationMessage For="@(() => EditModel.Name)" />
        </div>

        @if (AccountGroups is not null)
        {
            <div>
                <label class="@CssClasses.Form.Label">@CalcLoc[nameof(CalcResource.accountGroups)]</label>
                <select @onchange="ChangeGroupAccount" class="@CssClasses.Input.Text">
                    <option value="0"></option>
                    @foreach (var item in AccountGroups)
                    {
                        <option value="@item.Id" selected="@(AccountGroupSelected is not null && AccountGroupSelected.Id == item.Id)">@item.Name</option>
                    }
                </select>
            </div>

            @if (AccountGroupSelected?.Accounts is { Count: > 0 })
            {
                <div>
                    <label class="@CssClasses.Form.Label">@CalcLoc[nameof(CalcResource.account)]</label>
                    <InputSelect @bind-Value="EditModel.AccountId" class="@CssClasses.Input.Text">
                        <option></option>
                        @foreach (var item in AccountGroupSelected.Accounts)
                        {
                            <option value="@item.Id">@item.Name</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => EditModel.AccountId)" />
                </div>
            }
        }

        <div>
            <label class="@CssClasses.Form.Label">@CalcLoc[nameof(CalcResource.unit)]</label>
            <InputText @bind-Value="EditModel.Unit" class="@CssClasses.Input.Text" />
            <ValidationMessage For="@(() => EditModel.Unit)" />
        </div>

        <div>
            <label class="@CssClasses.Form.Label">@CalcLoc[nameof(CalcResource.cost)]</label>
            <InputNumber @bind-Value="EditModel.Cost" class="@CssClasses.Input.Text" />
            <ValidationMessage For="@(() => EditModel.Cost)" />
        </div>

        <div>
            <label class="@CssClasses.Form.Label">@CalcLoc[nameof(CalcResource.fixedQ)]</label>
            <InputNumber @bind-Value="EditModel.FixedQ" class="@CssClasses.Input.Text" />
            <ValidationMessage For="@(() => EditModel.FixedQ)" />
        </div>

        <div>
            <label class="@CssClasses.Form.Label">@CalcLoc[nameof(CalcResource.changeFactor1)]</label>
            <InputNumber @bind-Value="EditModel.ChangeFactor1" class="@CssClasses.Input.Text" />
            <ValidationMessage For="@(() => EditModel.ChangeFactor1)" />
        </div>

        <div>
            <label class="@CssClasses.Form.Label">@CalcLoc[nameof(CalcResource.changeFactor2)]</label>
            <InputNumber @bind-Value="EditModel.ChangeFactor2" class="@CssClasses.Input.Text" />
            <ValidationMessage For="@(() => EditModel.ChangeFactor2)" />
        </div>

        <div>
            <label class="@CssClasses.Form.Label">@CalcLoc[nameof(CalcResource.co2)]</label>
            <InputNumber @bind-Value="EditModel.CO2" class="@CssClasses.Input.Text" />
            <ValidationMessage For="@(() => EditModel.CO2)" />
        </div>

        <div>
            <label class="@CssClasses.Form.Label">@CalcLoc[nameof(CalcResource.baseCost)]</label>
            <InputNumber @bind-Value="EditModel.BaseCost" class="@CssClasses.Input.Text" />
            <ValidationMessage For="@(() => EditModel.BaseCost)" />
        </div>

        <div class="@CssClasses.Form.CheckWrapperM">
            <InputCheckbox id="resourceSortVisible" class="@CssClasses.Input.Check" @bind-Value="@EditModel.IsVisible" />
            <label class="@CssClasses.Form.CheckLabel" for="resourceSortVisible">@AppLoc[nameof(ResourceApp.isVisible)]</label>
        </div>
    </div>
</EditForm>

<div class="@CssClasses.Modal.Footer">
    <button type="submit" form="resourceSortForm" class="@CssClasses.Btn.Outline.Success" disabled="@IsLoading">
        @AppLoc[nameof(ResourceApp.save)]
    </button>
    <button type="button" class="@CssClasses.Btn.Outline.Secondary" @onclick="CloseModal" disabled="@IsLoading">
        @AppLoc[nameof(ResourceApp.cancel)]
    </button>
</div>

@code {
    [Parameter] public EventCallback<bool> Callback { get; set; }
    [Parameter] public ResourceSortModel ResourceSort { get; set; } = new();

    private bool IsLoading;
    private readonly PostResourceSortDTO EditModel = new();
    private List<ListAccountGroupIncludeAccountDTO>? AccountGroups;
    private ListAccountGroupIncludeAccountDTO? AccountGroupSelected;

    protected override async Task OnParametersSetAsync()
    {
        PropertyCopier.CopyPropertiesTo(ResourceSort, EditModel);
        AccountGroups ??= await Dispatcher.Send(new GetAccountGroupsAsListQuery());

        if (ResourceSort.Id > 0)
            AccountGroupSelected = AccountGroups?.FirstOrDefault(x => x.Accounts?.Any(a => a.Id == EditModel.AccountId) == true);
    }

    private async Task ChangeGroupAccount(ChangeEventArgs e)
    {
        AccountGroupSelected = null;
        EditModel.AccountId = null;

        if (!int.TryParse(e.Value?.ToString(), out var id) || id == 0)
            return;

        await Task.Yield();
        AccountGroupSelected = AccountGroups?.FirstOrDefault(x => x.Id == id);
    }

    private void CloseModal() => MHD.Modal.Close();

    private async Task HandleSubmitAsync()
    {
        if (IsLoading)
            return;

        IsLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            bool result;

            if (ResourceSort.Id == 0)
                result = await Dispatcher.Send(new CreateResourceSortCommand(ResourceSort.ResourceTypeId, EditModel)) > 0;
            else
                result = await Dispatcher.Send(new UpdateResourceSortCommand(ResourceSort.Id, EditModel));

            MHD.Notifications(ResourceSort.Id == 0 ? ToastType.Add : ToastType.Update, result);
            await Callback.InvokeAsync(result);
        }
        finally
        {
            IsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}
