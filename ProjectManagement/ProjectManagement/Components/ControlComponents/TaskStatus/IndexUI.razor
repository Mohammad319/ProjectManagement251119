@using BlazorMHD.UI.Components.Data.Table
@using Domain.Entities.Calculation
@inherits AppComponentBase

<div class="space-y-4">
    <div class="flex flex-col gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-950 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">@Loc[nameof(ResourceLoc.taskStatus)]</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">@VisibleStatuses.Count() @Loc[nameof(ResourceLoc.taskStatus)]</p>
        </div>

        <div class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-slate-50 p-2 dark:border-slate-800 dark:bg-slate-900/70">
            <button @onclick="CreateNewAsync"
                    class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-600 text-white shadow-sm transition hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-500/40"
                    title="@AppLoc[nameof(ResourceApp.newItem)]">
                @((MarkupString)Icons.Plus2)
            </button>
            <button @onclick="ToggleVisibleAsync"
                    class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-slate-300 bg-white text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-400/30 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-200 dark:hover:bg-slate-800"
                    title="@AppLoc[nameof(ResourceApp.isVisible)]">
                @((MarkupString)Icons.GetVisibleIcon(IsVisible))
            </button>
        </div>
    </div>

    @if (IsLoading)
    {
        <BlazorMHD.UI.Components.Feedback.Loading.MhdLoading />
    }
    else if (VisibleStatuses.Any())
    {
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-950">
            <MhdTable TItem="TaskStatusEntity" Items="VisibleStatuses.ToList()" ShowFilter="false">
                <HeaderTemplate>
                    <th class="w-40 px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-600 dark:text-slate-300"></th>
                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-600 dark:text-slate-300">@CalcLoc[nameof(CalcResource.name)]</th>
                </HeaderTemplate>
                <ChildContent>
                    <MhdTableColumn>
                        <Template Context="status">
                            <div class="flex items-center gap-2">
                                <button @onclick="() => UpdateForm(status)"
                                        class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-amber-300 bg-amber-50 text-amber-700 transition hover:bg-amber-100 dark:border-amber-900 dark:bg-amber-950/30 dark:text-amber-300 dark:hover:bg-amber-950/50"
                                        title="@AppLoc[nameof(ResourceApp.update)]">
                                    @Icons.Edit
                                </button>
                                <button @onclick="() => Remove(status)"
                                        class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-red-300 bg-red-50 text-red-700 transition hover:bg-red-100 dark:border-red-900 dark:bg-red-950/30 dark:text-red-300 dark:hover:bg-red-950/50"
                                        title="@AppLoc[nameof(ResourceApp.delete)]">
                                    @((MarkupString)Icons.DeleteSVG)
                                </button>
                            </div>
                        </Template>
                    </MhdTableColumn>
                    <MhdTableColumn Title="@CalcLoc[nameof(CalcResource.name)]">
                        <Template Context="status">
                            <div class="flex items-center gap-3">
                                <span style="width: 22px; height: 22px; background-color:@status.Color" class="inline-block rounded-md border border-slate-200 dark:border-slate-700"></span>
                                <span class="text-sm text-slate-800 dark:text-slate-100">@status.Name</span>
                            </div>
                        </Template>
                    </MhdTableColumn>
                </ChildContent>
            </MhdTable>
        </div>
    }
    else
    {
        <div class="rounded-2xl border border-dashed border-slate-200 bg-white/50 px-6 py-8 text-center text-sm text-slate-500 dark:border-slate-700 dark:bg-slate-900/40 dark:text-slate-400">
            @AppLoc[nameof(ResourceApp.ThereAreNoItemsToDisplay)]
        </div>
    }
</div>
