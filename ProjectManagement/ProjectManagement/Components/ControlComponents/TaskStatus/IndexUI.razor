@using BlazorMHD.UI.Components.Data.Table
@using Domain.Entities.Calculation
@using ProjectManagement.Client.Shared.Model.Project
@using ProjectManagement.Client.Shared.Repositories.Calculation
@inject ICommandDispatcher MicroBus
@inject ContextMenuService ContextService
@inject MhdServices MHD
@inject IStringLocalizer<ResourceApp> AppLoc
@if (Status != null && Status.Any(x => x.IsVisible == IsVisible)){
    <MhdTable TItem="TaskStatusEntity" Items="Status?.Where(x => x.IsVisible == IsVisible)?.OrderByDescending(x => x.SortOrder)" ShowFilter="false">
         <HeaderTemplate>
            <th style="width:200px;" class="@CssClasses.Table.TH">
                <div class="@CssClasses.Layout.FlexItemsCenter">
                        <button @onclick="() => UpdateForm(new TaskStatusEntity())" class="@CssClasses.Btn.IconButton.Success">@Icons.Plus2</button>
                    <button @onclick="() => IsVisible = !IsVisible" class="@CssClasses.Btn.IconButton.Secondary">@((MarkupString)Icons.GetVisibleIcon(IsVisible))</button>
                </div>
            </th>
            <th class="@CssClasses.Table.TH">@CalcResource.name</th>
        </HeaderTemplate> 
        <ChildContent>
            <MhdTableColumn Order="1" Visible="true" Sortable="false" Title="">
        <Template Context="status">
                <div class="@CssClasses.Layout.FlexItemsCenter">
                <button @onclick="() => UpdateForm(status)" class="@CssClasses.Btn.IconButton.Warning">@Icons.Edit</button>
                <button @onclick="() => Remove(status)" class="@CssClasses.Btn.IconButton.Danger">@((MarkupString)Icons.DeleteSVG)</button>
            </div>
        </Template>
    </MhdTableColumn>
            <MhdTableColumn Order="2" Sortable="true" Title="@(CalcResource.name + " " + (IsVisible ? @ResourceApp.visibleItems : @ResourceApp.hiddenItems))">
        <Template Context="status">
            <span style="width:25px; height:25px; background-color:@status.Color; display:inline-block; margin-right:5px;"></span>
            @status.Name
        </Template>
    </MhdTableColumn>
              </ChildContent> 
</MhdTable> 
} 