@inherits AppComponentBase

<EditForm id="taskStatusForm" class="@CssClasses.Modal.Body" Model="@PostStatus" OnValidSubmit="HandleSubmitAsync">
    <DataAnnotationsValidator />

    <div class="flex flex-wrap items-center gap-4">
        <div class="flex flex-col">
            <label class="@CssClasses.Form.Label">@CalcLoc[nameof(CalcResource.name)]</label>
            <InputText class="@CssClasses.Input.Text" @bind-Value="@PostStatus.Name" />
            <ValidationMessage For="@(() => PostStatus.Name)" />
        </div>

        <div class="@CssClasses.Form.CheckWrapperM">
            <InputCheckbox id="taskStatusVisible" class="@CssClasses.Input.Check" @bind-Value="@PostStatus.IsVisible" />
            <label class="@CssClasses.Form.CheckLabel" for="taskStatusVisible">@AppLoc[nameof(ResourceApp.isVisible)]</label>
        </div>

        <div class="flex flex-col">
            <label class="@CssClasses.Form.Label">@Loc[nameof(ResourceLoc.color)]</label>
            <InputText type="color" class="@CssClasses.Input.Color" @bind-Value="@PostStatus.Color" />
        </div>
    </div>
</EditForm>

<div class="@CssClasses.Modal.Footer">
    <button type="submit" class="@CssClasses.Btn.Outline.Success" form="taskStatusForm" disabled="@IsLoading">
        @AppLoc[nameof(ResourceApp.save)]
    </button>
    <button type="button" class="@CssClasses.Btn.Outline.Secondary" @onclick="CloseModal" disabled="@IsLoading">
        @AppLoc[nameof(ResourceApp.cancel)]
    </button>
</div>
