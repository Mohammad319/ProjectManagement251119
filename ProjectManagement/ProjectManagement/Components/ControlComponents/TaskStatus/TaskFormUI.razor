@inherits AppComponentBase

<EditForm id="taskStatusForm" class="space-y-3 p-1" Model="@PostStatus" OnValidSubmit="HandleSubmitAsync">
    <DataAnnotationsValidator />

    <div class="rounded-2xl border border-slate-200 bg-white p-3 shadow-sm dark:border-slate-800 dark:bg-slate-950">
        <div class="grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-3">
            <div class="space-y-2">
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">@CalcLoc[nameof(CalcResource.name)]</label>
                <InputText class="block w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-4 focus:ring-sky-500/10 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100" @bind-Value="@PostStatus.Name" />
                <ValidationMessage For="@(() => PostStatus.Name)" class="text-sm text-red-600 dark:text-red-400" />
            </div>

            <div class="space-y-2">
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">@Loc[nameof(ResourceLoc.color)]</label>
                <InputText type="color" class="block h-11 w-full rounded-xl border border-slate-300 bg-white p-1 shadow-sm outline-none transition focus:border-sky-500 focus:ring-4 focus:ring-sky-500/10 dark:border-slate-700 dark:bg-slate-900" @bind-Value="@PostStatus.Color" />
            </div>

            <div class="flex items-end">
                <label class="flex w-full items-center gap-3 rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm text-slate-700 dark:border-slate-800 dark:bg-slate-900/60 dark:text-slate-200">
                    <InputCheckbox id="taskStatusVisible" class="h-4 w-4 rounded border-slate-300 text-sky-600 focus:ring-sky-500 dark:border-slate-600 dark:bg-slate-900" @bind-Value="@PostStatus.IsVisible" />
                    <span>@AppLoc[nameof(ResourceApp.isVisible)]</span>
                </label>
            </div>
        </div>
    </div>
</EditForm>

<div class="flex items-center justify-end gap-2 border-t border-slate-200 pt-3 dark:border-slate-800">
    <button type="button" class="inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-400/30 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800" @onclick="CloseModal" disabled="@IsLoading">
        @AppLoc[nameof(ResourceApp.cancel)]
    </button>
    <button type="submit" class="inline-flex items-center justify-center rounded-xl bg-emerald-600 px-4 py-2 text-sm font-medium text-white shadow-sm transition hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-500/40 disabled:cursor-not-allowed disabled:opacity-60" form="taskStatusForm" disabled="@IsLoading">
        @AppLoc[nameof(ResourceApp.save)]
    </button>
</div>
