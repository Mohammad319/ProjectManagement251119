@page "/price-import"
@using BlazorMHD.UI.Components.Navigation.Tabs
@using BlazorMHD.UI.Core.Navigation
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = PMRolesConst.Tenant.Users)]
@rendermode InteractiveServer

<div class="h-[calc(100vh-37px)] overflow-hidden bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100">
    <MhdTabs Items="@_tabs" @bind-ActiveKey="_activeKey" Size="MhdSize.Sm" />
</div>

@code {
    private string? _activeKey;
    private List<MhdTabItem> _tabs = [];

    protected override void OnInitialized()
    {
        _tabs =
        [
            new MhdTabItem
            {
                Key = "jobs",
                Text = "Import Jobs",
                Content = @<PriceImportJobsTabUI />
            },
            new MhdTabItem
            {
                Key = "price-lists",
                Text = "Price Lists",
                Content = @<PriceListsTabUI />
            }
        ];
        _activeKey = "jobs";
    }
}
