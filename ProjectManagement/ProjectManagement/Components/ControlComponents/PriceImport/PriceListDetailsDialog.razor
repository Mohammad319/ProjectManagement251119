@using Microsoft.AspNetCore.Authorization
@using ProjectManagement.Shared.Helper.Text

@inject IPriceImportService PriceImportService
@inject MhdServices MHD

<div class="flex flex-col gap-2 bg-slate-50 p-2 text-slate-900 dark:bg-slate-950 dark:text-slate-100">
    <div class="flex shrink-0 flex-wrap items-center justify-between gap-2 border-b border-slate-200 bg-white px-3 py-2 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <div class="min-w-0">
            <h1 class="truncate text-base font-semibold">@PriceList?.Name</h1>
            <div class="mt-1 flex flex-wrap gap-1 text-[11px] text-slate-500 dark:text-slate-400">
                <span>@PriceList?.SupplierName</span>
                <span>|</span>
                <span>@PriceList?.Currency</span>
                <span>|</span>
                <span>@(PriceList?.IsActive == true ? "Active" : "Inactive")</span>
            </div>
        </div>

        @if (PriceList is not null)
        {
            <div class="flex gap-1">
                <button type="button" class="h-8 rounded-md border border-slate-300 bg-white px-3 text-xs font-semibold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200" @onclick="OpenPriceListEdit">Edit list</button>
                <button type="button" class="@ToggleListButtonClass(PriceList.IsActive)" @onclick="TogglePriceListActiveAsync">
                    @(PriceList.IsActive ? "Deactivate list" : "Activate list")
                </button>
                <button type="button"
                        class="@DeleteListButtonClass(ConfirmDeleteList)"
                        disabled="@IsBusy"
                        @onclick="DeletePriceListAsync">
                    @(ConfirmDeleteList ? "Confirm delete list" : "Delete list")
                </button>
            </div>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <div class="@MessageClass">@Message</div>
    }

    @if (IsBusy && PriceList is null)
    {
        <div class="rounded-md border border-slate-200 bg-white px-3 py-2 text-sm text-slate-600 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300">Loading price list...</div>
    }
    else if (PriceList is null)
    {
        <div class="rounded-md border border-dashed border-slate-300 bg-white px-3 py-8 text-center text-sm text-slate-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-400">
            Price list was not found.
        </div>
    }
    else
    {
        <div class="flex flex-col gap-2">
            <div class="grid shrink-0 grid-cols-2 gap-2 text-xs md:grid-cols-5">
                @foreach (var metric in Metrics)
                {
                    <div class="border border-slate-200 bg-white px-3 py-1.5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
                        <div class="text-[10px] uppercase leading-4 text-slate-500 dark:text-slate-400">@metric.Label</div>
                        <div class="truncate text-base font-semibold leading-5 text-slate-900 dark:text-slate-100">@metric.Value</div>
                    </div>
                }
            </div>

            <div class="shrink-0 border border-slate-200 bg-white p-2 shadow-sm dark:border-slate-800 dark:bg-slate-900">
                <div class="flex flex-wrap items-center gap-2">
                    <input class="h-8 w-full max-w-md rounded-md border border-slate-300 bg-white px-2 text-xs outline-none focus:border-sky-500 dark:border-slate-700 dark:bg-slate-950"
                           placeholder="Search name, article, product code, category..."
                           value="@_searchText"
                           @oninput="OnSearchInput" />
                    <span class="text-[11px] text-slate-500 dark:text-slate-400">
                        @_visibleCount / @_scoredItems.Count
                        @if (_scoredItems.Count != (PriceList?.Items.Count ?? 0))
                        {
                            <span> (total: @PriceList?.Items.Count)</span>
                        }
                        items
                    </span>
                </div>
            </div>

            <div class="max-h-[62vh] overflow-hidden border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
                <div class="h-full overflow-auto">
                    <table class="min-w-[1660px] table-fixed text-left text-xs">
                        <thead class="sticky top-0 z-20 border-b border-slate-200 bg-slate-100 text-[11px] uppercase text-slate-600 shadow-sm dark:border-slate-800 dark:bg-slate-900 dark:text-slate-400">
                            <tr>
                                <th class="w-32 px-2 py-2">Article</th>
                                <th class="w-32 px-2 py-2">Product</th>
                                <th class="w-72 px-2 py-2">Name</th>
                                <th class="w-44 px-2 py-2">Category</th>
                                <th class="w-24 px-2 py-2 text-right">Base</th>
                                <th class="w-24 px-2 py-2 text-right">Discount</th>
                                <th class="w-24 px-2 py-2 text-right">Net</th>
                                <th class="w-20 px-2 py-2">Unit</th>
                                <th class="w-20 px-2 py-2">Currency</th>
                                <th class="w-44 px-2 py-2">Supplier</th>
                                <th class="w-24 px-2 py-2">Status</th>
                                <th class="w-24 px-2 py-2">Source</th>
                                <th class="sticky right-0 z-30 w-60 bg-slate-100 px-2 py-2 text-right dark:bg-slate-900">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                            @if (_scoredItems.Count == 0)
                            {
                                <tr>
                                    <td colspan="13" class="px-3 py-8 text-center text-sm text-slate-500 dark:text-slate-400">No price items found.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var (item, score) in _scoredItems.Take(_visibleCount))
                                {
                                    <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/60">
                                        <td class="truncate px-2 py-2">@item.ArticleNumber</td>
                                        <td class="truncate px-2 py-2">@item.ProductCode</td>
                                        <td class="px-2 py-2 font-medium">
                                            <div class="flex min-w-0 items-center gap-1" title="@item.Description">
                                                @if (!string.IsNullOrWhiteSpace(_searchText) && score < 1.0)
                                                {
                                                    <div class="h-1 w-8 shrink-0 overflow-hidden rounded-full bg-slate-200 dark:bg-slate-700" title="@score.ToString("0%")">
                                                        <div class="h-full rounded-full @FuzzySearchHelper.BarColorClass(score)"
                                                             style="width:@((score * 100).ToString("0", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                                                    </div>
                                                }
                                                <span class="truncate">@item.Name</span>
                                            </div>
                                        </td>
                                        <td class="truncate px-2 py-2">@item.CategoryName</td>
                                        <td class="px-2 py-2 text-right">@Money(item.BasePrice)</td>
                                        <td class="px-2 py-2 text-right">@Percent(item.DiscountPercent)</td>
                                        <td class="px-2 py-2 text-right">@Money(item.NetPrice)</td>
                                        <td class="px-2 py-2">@item.Unit</td>
                                        <td class="px-2 py-2">@item.Currency</td>
                                        <td class="truncate px-2 py-2">@item.SupplierName</td>
                                        <td class="px-2 py-2"><span class="@ActiveClass(item.IsActive)">@(item.IsActive ? "Active" : "Inactive")</span></td>
                                        <td class="truncate px-2 py-2" title="@item.SourceText">@SourceLabel(item)</td>
                                        <td class="sticky right-0 bg-white px-2 py-2 text-right shadow-[-8px_0_12px_-12px_rgba(15,23,42,0.45)] dark:bg-slate-900">
                                            <div class="flex justify-end gap-1">
                                                <button type="button" class="h-7 rounded-md border border-sky-300 bg-sky-50 px-2 text-xs font-semibold text-sky-700 hover:bg-sky-100 dark:border-sky-900 dark:bg-sky-950/50 dark:text-sky-300" @onclick="() => OpenItemEdit(item)">Edit</button>
                                                <button type="button" class="@ToggleItemButtonClass(item.IsActive)" @onclick="() => ToggleItemActiveAsync(item)">
                                                    @(item.IsActive ? "Off" : "On")
                                                </button>
                                                <button type="button"
                                                        class="@DeleteItemButtonClass(DeleteItemTargetId == item.Id)"
                                                        disabled="@IsBusy"
                                                        @onclick="() => DeletePriceListItemAsync(item)">
                                                    @(DeleteItemTargetId == item.Id ? "Confirm" : "Delete")
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @if (_visibleCount < _scoredItems.Count)
            {
                <div class="shrink-0 flex items-center justify-between gap-3 border border-t-0 border-slate-200 bg-white px-3 py-2 dark:border-slate-800 dark:bg-slate-900">
                    <span class="text-[11px] text-slate-500 dark:text-slate-400">
                        Showing @_visibleCount of @_scoredItems.Count items
                    </span>
                    <button type="button"
                            class="inline-flex h-8 items-center rounded-md border border-slate-300 bg-white px-4 text-xs font-semibold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
                            @onclick="LoadMore">
                        Load 200 more &nbsp;<span class="font-normal text-slate-500">(@(_scoredItems.Count - _visibleCount) remaining)</span>
                    </button>
                </div>
            }
        </div>
    }
</div>

@if (ListEditModel is not null)
{
    <div class="fixed inset-0 z-[60] flex items-center justify-center bg-slate-950/60 p-4">
        <div class="w-full max-w-3xl rounded-lg border border-slate-200 bg-white shadow-xl dark:border-slate-800 dark:bg-slate-900">
            <div class="flex items-center justify-between border-b border-slate-200 px-4 py-3 dark:border-slate-800">
                <h2 class="text-sm font-semibold">Edit price list</h2>
                <button type="button" class="text-sm text-slate-500 hover:text-slate-900 dark:hover:text-slate-100" @onclick="CloseListEdit">Close</button>
            </div>
            <div class="grid gap-3 p-4 text-xs md:grid-cols-2">
                <label class="space-y-1 md:col-span-2"><span class="text-slate-500 dark:text-slate-400">Name</span><input class="h-8 w-full rounded-md border border-slate-300 bg-white px-2 dark:border-slate-700 dark:bg-slate-950" @bind="ListEditModel.Name" /></label>
                <label class="space-y-1"><span class="text-slate-500 dark:text-slate-400">SupplierName</span><input class="h-8 w-full rounded-md border border-slate-300 bg-white px-2 dark:border-slate-700 dark:bg-slate-950" @bind="ListEditModel.SupplierName" /></label>
                <label class="space-y-1"><span class="text-slate-500 dark:text-slate-400">Currency</span><input class="h-8 w-full rounded-md border border-slate-300 bg-white px-2 dark:border-slate-700 dark:bg-slate-950" @bind="ListEditModel.Currency" /></label>
                <label class="space-y-1"><span class="text-slate-500 dark:text-slate-400">ValidFrom</span><InputDate class="h-8 w-full rounded-md border border-slate-300 bg-white px-2 dark:border-slate-700 dark:bg-slate-950" @bind-Value="ListEditModel.ValidFrom" /></label>
                <label class="space-y-1"><span class="text-slate-500 dark:text-slate-400">ValidTo</span><InputDate class="h-8 w-full rounded-md border border-slate-300 bg-white px-2 dark:border-slate-700 dark:bg-slate-950" @bind-Value="ListEditModel.ValidTo" /></label>
                <label class="flex items-center gap-2 md:col-span-2"><input type="checkbox" class="h-4 w-4 rounded border-slate-300 text-sky-600 dark:border-slate-700 dark:bg-slate-950" @bind="ListEditModel.IsActive" /><span>Active</span></label>
                <label class="space-y-1 md:col-span-2"><span class="text-slate-500 dark:text-slate-400">Note</span><textarea class="h-24 w-full rounded-md border border-slate-300 bg-white p-2 text-xs dark:border-slate-700 dark:bg-slate-950" @bind="ListEditModel.Note"></textarea></label>
            </div>
            <div class="flex justify-end gap-2 border-t border-slate-200 px-4 py-3 dark:border-slate-800">
                <button type="button" class="h-8 rounded-md border border-slate-300 px-3 text-xs font-semibold dark:border-slate-700" @onclick="CloseListEdit">Cancel</button>
                <button type="button" class="h-8 rounded-md bg-blue-600 px-3 text-xs font-semibold text-white disabled:opacity-50" disabled="@IsBusy" @onclick="SaveListEditAsync">Save</button>
            </div>
        </div>
    </div>
}

@if (ItemEditModel is not null)
{
    <div class="fixed inset-0 z-[60] flex items-center justify-center bg-slate-950/60 p-4">
        <div class="max-h-[90vh] w-full max-w-5xl overflow-auto rounded-lg border border-slate-200 bg-white shadow-xl dark:border-slate-800 dark:bg-slate-900">
            <div class="flex items-center justify-between border-b border-slate-200 px-4 py-3 dark:border-slate-800">
                <h2 class="text-sm font-semibold">Edit price item</h2>
                <button type="button" class="text-sm text-slate-500 hover:text-slate-900 dark:hover:text-slate-100" @onclick="CloseItemEdit">Close</button>
            </div>
            <div class="grid gap-3 p-4 text-xs md:grid-cols-4">
                <label class="space-y-1"><span class="text-slate-500 dark:text-slate-400">ArticleNumber</span><input class="h-8 w-full rounded-md border border-slate-300 bg-white px-2 dark:border-slate-700 dark:bg-slate-950" @bind="ItemEditModel.ArticleNumber" /></label>
                <label class="space-y-1"><span class="text-slate-500 dark:text-slate-400">ProductCode</span><input class="h-8 w-full rounded-md border border-slate-300 bg-white px-2 dark:border-slate-700 dark:bg-slate-950" @bind="ItemEditModel.ProductCode" /></label>
                <label class="space-y-1 md:col-span-2"><span class="text-slate-500 dark:text-slate-400">Name</span><input class="h-8 w-full rounded-md border border-slate-300 bg-white px-2 dark:border-slate-700 dark:bg-slate-950" @bind="ItemEditModel.Name" /></label>
                <label class="space-y-1 md:col-span-2"><span class="text-slate-500 dark:text-slate-400">Description</span><input class="h-8 w-full rounded-md border border-slate-300 bg-white px-2 dark:border-slate-700 dark:bg-slate-950" @bind="ItemEditModel.Description" /></label>
                <label class="space-y-1"><span class="text-slate-500 dark:text-slate-400">CategoryName</span><input class="h-8 w-full rounded-md border border-slate-300 bg-white px-2 dark:border-slate-700 dark:bg-slate-950" @bind="ItemEditModel.CategoryName" /></label>
                <label class="space-y-1"><span class="text-slate-500 dark:text-slate-400">SupplierName</span><input class="h-8 w-full rounded-md border border-slate-300 bg-white px-2 dark:border-slate-700 dark:bg-slate-950" @bind="ItemEditModel.SupplierName" /></label>
                <label class="space-y-1"><span class="text-slate-500 dark:text-slate-400">BasePrice</span><input type="number" step="0.0001" class="h-8 w-full rounded-md border border-slate-300 bg-white px-2 dark:border-slate-700 dark:bg-slate-950" @bind="ItemEditModel.BasePrice" /></label>
                <label class="space-y-1"><span class="text-slate-500 dark:text-slate-400">DiscountPercent</span><input type="number" step="0.0001" class="h-8 w-full rounded-md border border-slate-300 bg-white px-2 dark:border-slate-700 dark:bg-slate-950" @bind="ItemEditModel.DiscountPercent" /></label>
                <label class="space-y-1"><span class="text-slate-500 dark:text-slate-400">NetPrice</span><input type="number" step="0.0001" class="h-8 w-full rounded-md border border-slate-300 bg-white px-2 dark:border-slate-700 dark:bg-slate-950" @bind="ItemEditModel.NetPrice" /></label>
                <label class="space-y-1"><span class="text-slate-500 dark:text-slate-400">Unit</span><input class="h-8 w-full rounded-md border border-slate-300 bg-white px-2 dark:border-slate-700 dark:bg-slate-950" @bind="ItemEditModel.Unit" /></label>
                <label class="space-y-1"><span class="text-slate-500 dark:text-slate-400">Currency</span><input class="h-8 w-full rounded-md border border-slate-300 bg-white px-2 dark:border-slate-700 dark:bg-slate-950" @bind="ItemEditModel.Currency" /></label>
                <label class="space-y-1"><span class="text-slate-500 dark:text-slate-400">ConsumptionFactor</span><input type="number" step="0.000001" class="h-8 w-full rounded-md border border-slate-300 bg-white px-2 dark:border-slate-700 dark:bg-slate-950" @bind="ItemEditModel.ConsumptionFactor" /></label>
                <label class="space-y-1"><span class="text-slate-500 dark:text-slate-400">WastePercent</span><input type="number" step="0.0001" class="h-8 w-full rounded-md border border-slate-300 bg-white px-2 dark:border-slate-700 dark:bg-slate-950" @bind="ItemEditModel.WastePercent" /></label>
                <label class="flex items-center gap-2"><input type="checkbox" class="h-4 w-4 rounded border-slate-300 text-sky-600 dark:border-slate-700 dark:bg-slate-950" @bind="ItemEditModel.IsActive" /><span>Active</span></label>
                <label class="space-y-1 md:col-span-4"><span class="text-slate-500 dark:text-slate-400">UserNote</span><textarea class="h-20 w-full rounded-md border border-slate-300 bg-white p-2 text-xs dark:border-slate-700 dark:bg-slate-950" @bind="ItemEditModel.UserNote"></textarea></label>
            </div>
            <div class="flex justify-end gap-2 border-t border-slate-200 px-4 py-3 dark:border-slate-800">
                <button type="button" class="h-8 rounded-md border border-slate-300 px-3 text-xs font-semibold dark:border-slate-700" @onclick="CloseItemEdit">Cancel</button>
                <button type="button" class="h-8 rounded-md bg-blue-600 px-3 text-xs font-semibold text-white disabled:opacity-50" disabled="@IsBusy" @onclick="SaveItemEditAsync">Save</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid PriceListId { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }

    private PriceListDetailsDto? PriceList;
    private PriceListUpdateDto? ListEditModel;
    private PriceListItemUpdateDto? ItemEditModel;
    private Guid? DeleteItemTargetId;
    private bool ConfirmDeleteList;
    private bool IsBusy;
    private bool MessageIsError;
    private string? Message;

    private const int WindowSize = 200;
    private string _searchText = "";
    private List<(PriceListItemDto Item, double Score)> _scoredItems = [];
    private int _visibleCount = WindowSize;
    private Timer? _debounceTimer;

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchText = e.Value?.ToString() ?? "";
        _debounceTimer?.Dispose();
        _debounceTimer = new Timer(_ => InvokeAsync(() => { RebuildScored(); StateHasChanged(); }),
            null, 350, Timeout.Infinite);
    }

    private void RebuildScored()
    {
        _visibleCount = WindowSize;
        var q = _searchText.Trim();
        if (string.IsNullOrWhiteSpace(q))
        {
            _scoredItems = PriceList?.Items.Select(i => (i, 1.0)).ToList() ?? [];
            return;
        }
        _scoredItems = PriceList?.Items
            .Select(i => (Item: i, Score: FuzzySearchHelper.Score(q,
                $"{i.Name} {i.ArticleNumber} {i.ProductCode} {i.CategoryName} {i.SupplierName}")))
            .Where(x => x.Score >= FuzzySearchHelper.Threshold)
            .OrderByDescending(x => x.Score)
            .ToList() ?? [];
    }

    private void LoadMore() => _visibleCount += WindowSize;

    private string MessageClass => MessageIsError
        ? "shrink-0 rounded-md border border-rose-200 bg-rose-50 px-3 py-2 text-xs text-rose-800 dark:border-rose-900 dark:bg-rose-950/50 dark:text-rose-200"
        : "shrink-0 rounded-md border border-sky-200 bg-sky-50 px-3 py-2 text-xs text-sky-800 dark:border-sky-900 dark:bg-sky-950/50 dark:text-sky-200";

    private IReadOnlyList<(string Label, string Value)> Metrics =>
        PriceList is null
            ? []
            :
            [
                ("Items", PriceList.Items.Count.ToString()),
                ("Active", PriceList.Items.Count(x => x.IsActive).ToString()),
                ("ImportedAt", FormatDate(PriceList.ImportedAt)),
                ("Source", PriceList.SourceFileName ?? "-"),
                ("Currency", PriceList.Currency)
            ];

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        IsBusy = true;
        try
        {
            PriceList = await PriceImportService.GetPriceListDetailsAsync(PriceListId);
            RebuildScored();
        }
        finally
        {
            IsBusy = false;
        }
    }

    private void OpenPriceListEdit()
    {
        if (PriceList is null)
            return;

        ListEditModel = new PriceListUpdateDto
        {
            Id = PriceList.Id,
            Name = PriceList.Name,
            SupplierName = PriceList.SupplierName,
            Currency = PriceList.Currency,
            ValidFrom = PriceList.ValidFrom,
            ValidTo = PriceList.ValidTo,
            IsActive = PriceList.IsActive,
            Note = PriceList.Note
        };
    }

    private void OpenItemEdit(PriceListItemDto item)
    {
        ItemEditModel = new PriceListItemUpdateDto
        {
            Id = item.Id,
            ArticleNumber = item.ArticleNumber,
            ProductCode = item.ProductCode,
            Name = item.Name,
            Description = item.Description,
            CategoryName = item.CategoryName,
            ClassificationPath = item.ClassificationPath,
            BasePrice = item.BasePrice,
            DiscountPercent = item.DiscountPercent,
            NetPrice = item.NetPrice,
            Unit = item.Unit,
            Currency = item.Currency,
            SupplierName = item.SupplierName,
            ConsumptionFactor = item.ConsumptionFactor,
            WastePercent = item.WastePercent,
            IsActive = item.IsActive,
            UserNote = item.UserNote
        };
    }

    private async Task SaveListEditAsync()
    {
        if (ListEditModel is null)
            return;

        var ok = await PriceImportService.UpdatePriceListAsync(ListEditModel);
        MessageIsError = !ok;
        Message = ok ? "Price list updated." : "Price list could not be updated.";
        ListEditModel = null;
        await LoadAsync();
    }

    private async Task SaveItemEditAsync()
    {
        if (ItemEditModel is null)
            return;

        if (string.IsNullOrWhiteSpace(ItemEditModel.Name))
        {
            MessageIsError = true;
            Message = "Name is required.";
            return;
        }

        var ok = await PriceImportService.UpdatePriceListItemAsync(ItemEditModel);
        MessageIsError = !ok;
        Message = ok ? "Price item updated." : "Price item could not be updated.";
        ItemEditModel = null;
        await LoadAsync();
    }

    private async Task TogglePriceListActiveAsync()
    {
        if (PriceList is null)
            return;

        ConfirmDeleteList = false;
        var ok = await PriceImportService.SetPriceListActiveAsync(PriceList.Id, !PriceList.IsActive);
        MessageIsError = !ok;
        Message = ok ? "Price list status updated." : "Price list could not be updated.";
        await LoadAsync();
    }

    private async Task ToggleItemActiveAsync(PriceListItemDto item)
    {
        DeleteItemTargetId = null;
        var ok = await PriceImportService.SetPriceListItemActiveAsync(item.Id, !item.IsActive);
        MessageIsError = !ok;
        Message = ok ? "Price item status updated." : "Price item could not be updated.";
        await LoadAsync();
    }

    private async Task DeletePriceListAsync()
    {
        if (PriceList is null)
            return;

        if (!ConfirmDeleteList)
        {
            ConfirmDeleteList = true;
            MessageIsError = true;
            Message = $"Click Confirm delete list to permanently delete '{PriceList.Name}' and its {PriceList.Items.Count} item(s).";
            return;
        }

        IsBusy = true;
        try
        {
            var result = await PriceImportService.DeletePriceListAsync(PriceList.Id);
            MessageIsError = !result.Ok;
            Message = result.Message;

            if (result.Ok)
            {
                await OnClosed.InvokeAsync();
                MHD.Modal.Close();
                return;
            }

            ConfirmDeleteList = false;
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task DeletePriceListItemAsync(PriceListItemDto item)
    {
        if (DeleteItemTargetId != item.Id)
        {
            DeleteItemTargetId = item.Id;
            MessageIsError = true;
            Message = $"Click Confirm to permanently delete '{item.Name}'.";
            return;
        }

        IsBusy = true;
        try
        {
            var result = await PriceImportService.DeletePriceListItemAsync(item.Id);
            MessageIsError = !result.Ok;
            Message = result.Message;
            DeleteItemTargetId = null;
            await LoadAsync();
        }
        finally
        {
            IsBusy = false;
        }
    }

    private void CloseListEdit() => ListEditModel = null;

    private void CloseItemEdit() => ItemEditModel = null;

    private static string FormatDate(DateTime? value)
        => value.HasValue ? value.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : "-";

    private static string Money(decimal? value) => value.HasValue ? value.Value.ToString("0.####") : "-";

    private static string Percent(decimal? value) => value.HasValue ? value.Value.ToString("0.####") : "-";

    private static string SourceLabel(PriceListItemDto item)
    {
        if (!string.IsNullOrWhiteSpace(item.SourceSheetName))
            return $"{item.SourceSheetName} {item.SourceCellRange}";

        if (item.SourcePageNumber.HasValue)
            return $"Page {item.SourcePageNumber.Value}";

        return item.SourceFileName ?? "-";
    }

