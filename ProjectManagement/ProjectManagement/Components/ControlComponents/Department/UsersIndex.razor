@using BlazorMHD.UI.Components.Data.Table
@using Domain.DTO.User
@using ProjectManagement.Client.Shared.Constants
@using ProjectManagement.Shared
@using ProjectManagement.Services.UI

@inherits AppComponentBase

<div class="flex h-full min-h-0 flex-col gap-1.5">
    <!-- Header: title left, actions right -->
    <div class="flex shrink-0 flex-wrap items-center gap-1.5 rounded-xl border border-slate-200 bg-white px-2.5 py-1.5 shadow-sm dark:border-slate-700 dark:bg-slate-900">
        <div class="flex min-w-0 items-center gap-1.5">
            <h3 class="truncate text-sm font-semibold text-slate-900 dark:text-slate-100">@PageTitle</h3>
            <span class="group relative inline-flex shrink-0" @onclick:stopPropagation="true">
                <svg tabindex="0" role="img" aria-label='@WebLoc["DepartmentUsersDescription"]'
                     class="h-4 w-4 cursor-help text-slate-400 outline-none transition-colors hover:text-sky-600 focus-visible:text-sky-600 dark:hover:text-sky-400"
                     viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span role="tooltip"
                      class="pointer-events-none absolute left-0 top-full z-[80] mt-1 w-72 rounded-md bg-slate-800 px-2.5 py-1.5 text-left text-xs font-normal leading-snug text-white opacity-0 shadow-lg transition-opacity duration-150 group-hover:opacity-100 group-focus-within:opacity-100 dark:bg-slate-700">
                    @WebLoc["DepartmentUsersDescription"]
                </span>
            </span>
        </div>

        <div class="ml-auto flex shrink-0 flex-wrap items-center gap-1.5">
            <button class="inline-flex items-center justify-center gap-1.5 whitespace-nowrap rounded-lg bg-blue-600 px-2.5 py-1.5 text-xs font-semibold text-white shadow-sm transition hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500/40 disabled:cursor-not-allowed disabled:opacity-60 dark:bg-blue-500 dark:hover:bg-blue-400"
                    disabled="@IsBusy"
                    @onclick="OpenRegisterUser">
                @((MarkupString)Icons.PlusSVG)
                <span>Ny användare</span>
            </button>

            @if (Users?.Any() == true)
            {
                <button class="inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs font-medium text-slate-700 shadow-sm transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-600 dark:bg-slate-950 dark:text-slate-200 dark:hover:bg-slate-800"
                        disabled="@IsBusy"
                        @onclick="ExportUsersAsync">
                    @WebLoc["ExportExcel"]
                </button>
            }

            @* Back button only when opened from a department row; embedded in the Användare tab there is nothing to go back to. *@
            @if (OnClickCallback.HasDelegate)
            {
                <button class="inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs font-medium text-slate-700 shadow-sm transition hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-950 dark:text-slate-200 dark:hover:bg-slate-800"
                        disabled="@IsBusy"
                        @onclick="Back">
                    @((MarkupString)Icons.Back)
                    <span class="ml-1">@WebLoc["BackToDepartments"]</span>
                </button>
            }
        </div>
    </div>

    @* Fixed upper part (summary + filters) and a table container that owns the scrolling;
       the settings window itself must not move when the user list scrolls. *@
    <div class="flex min-h-0 flex-1 flex-col gap-1.5 overflow-hidden">
    @if (IsLoading)
    {
        <div class="rounded-xl border border-slate-200 bg-white p-3 shadow-sm dark:border-slate-700 dark:bg-slate-900">
            <MhdLoading />
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(LoadError))
    {
        <div class="rounded-xl border border-red-200 bg-red-50 p-3 text-xs text-red-700 shadow-sm dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-300" role="alert">
            <div class="font-semibold">@PageTitle</div>
            <div class="mt-1 break-words">@LoadError</div>
            <button type="button"
                    class="mt-2 inline-flex items-center rounded-lg border border-red-300 bg-white px-2.5 py-1 font-medium hover:bg-red-100 dark:border-red-800 dark:bg-slate-900 dark:hover:bg-red-950/50"
                    @onclick="LoadAsync">
                @WebLoc["Retry"]
            </button>
        </div>
    }
    else if (Users?.Any() == true)
    {
        <section class="shrink-0" aria-label='@WebLoc["UserSummary"]'>
            <div class="mb-1 px-1 text-[11px] text-slate-400 dark:text-slate-500">@WebLoc["FilterByStatusHint"]</div>
            @* Compact summary cards (roughly half the previous height). *@
            <div class="grid gap-1.5 sm:grid-cols-2 xl:grid-cols-4">
                <button type="button" aria-pressed="@(StatusFilters.Count == 0)"
                        class="flex items-center justify-between gap-2 rounded-xl border px-2.5 py-1.5 text-left shadow-sm transition focus:outline-none focus:ring-2 focus:ring-blue-500/30 @(StatusFilters.Count == 0 ? "border-blue-400 bg-blue-50/60 ring-1 ring-blue-300 dark:border-blue-600 dark:bg-blue-950/30" : "border-slate-200 bg-white hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:hover:bg-slate-800/60")"
                        @onclick='() => SetStatusFilter("")'>
                    <span class="flex items-center gap-1 text-[11px] font-semibold tracking-wide text-slate-500 dark:text-slate-400">
                        @WebLoc["TotalUsers"]
                        @if (ShowCapacity)
                        {
                            <span class="group relative inline-flex" @onclick:stopPropagation="true">
                                <svg tabindex="0" role="img" aria-label="Antal skapade / max antal användare i abonnemanget"
                                     title="Visar skapade användare och max antal användare i abonnemanget."
                                     class="h-3.5 w-3.5 cursor-help text-slate-400 outline-none transition-colors hover:text-sky-600 focus-visible:text-sky-600 dark:hover:text-sky-400"
                                     viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                <span role="tooltip"
                                      class="pointer-events-none absolute left-0 top-full z-[120] mt-1 w-72 rounded-md bg-slate-800 px-2.5 py-1.5 text-left text-xs font-normal leading-snug text-white opacity-0 shadow-lg transition-opacity duration-150 group-hover:opacity-100 group-focus-within:opacity-100 dark:bg-slate-700">
                                    @TotalCount skapade användare av @TenantMaxUsers tillgängliga användare i nuvarande abonnemang/licens.
                                </span>
                            </span>
                        }
                    </span>
                    <span class="flex items-baseline gap-1">
                        <span class="text-lg font-bold leading-none text-slate-900 dark:text-slate-100">@FilteredCount</span>
                        @if (ShowCapacity)
                        {
                            <span class="text-[11px] font-medium @(CapacityReached ? "text-rose-600 dark:text-rose-400" : CapacityNearLimit ? "text-amber-600 dark:text-amber-400" : "text-slate-400 dark:text-slate-500")">/ @TenantMaxUsers</span>
                        }
                    </span>
                </button>

                <button type="button" aria-pressed="@StatusFilters.Contains("active")"
                        class="flex items-center justify-between gap-2 rounded-xl border px-2.5 py-1.5 text-left shadow-sm transition focus:outline-none focus:ring-2 focus:ring-emerald-500/30 @(StatusFilters.Contains("active") ? "border-emerald-400 bg-emerald-50 ring-1 ring-emerald-300 dark:border-emerald-600 dark:bg-emerald-950/40" : "border-emerald-200 bg-emerald-50/40 hover:bg-emerald-50 dark:border-emerald-900/60 dark:bg-emerald-950/20")"
                        @onclick='() => SetStatusFilter("active")'>
                    <span class="text-[11px] font-semibold tracking-wide text-emerald-700 dark:text-emerald-300">@WebLoc["StatusActive"]</span>
                    <span class="text-lg font-bold leading-none text-emerald-800 dark:text-emerald-200">@ActiveCount</span>
                </button>

                <button type="button" aria-pressed="@StatusFilters.Contains("pending")"
                        class="flex items-center justify-between gap-2 rounded-xl border px-2.5 py-1.5 text-left shadow-sm transition focus:outline-none focus:ring-2 focus:ring-blue-500/30 @(StatusFilters.Contains("pending") ? "border-blue-400 bg-blue-50 ring-1 ring-blue-300 dark:border-blue-600 dark:bg-blue-950/40" : "border-blue-200 bg-blue-50/40 hover:bg-blue-50 dark:border-blue-900/60 dark:bg-blue-950/20")"
                        @onclick='() => SetStatusFilter("pending")'>
                    <span class="text-[11px] font-semibold tracking-wide text-blue-700 dark:text-blue-300">@WebLoc["InvitePending"]</span>
                    <span class="text-lg font-bold leading-none text-blue-800 dark:text-blue-200">@PendingCount</span>
                </button>

                <button type="button" aria-pressed="@StatusFilters.Contains("locked")"
                        class="flex items-center justify-between gap-2 rounded-xl border px-2.5 py-1.5 text-left shadow-sm transition focus:outline-none focus:ring-2 focus:ring-rose-500/30 @(StatusFilters.Contains("locked") ? "border-rose-400 bg-rose-50 ring-1 ring-rose-300 dark:border-rose-600 dark:bg-rose-950/40" : "border-rose-200 bg-rose-50/40 hover:bg-rose-50 dark:border-rose-900/60 dark:bg-rose-950/20")"
                        @onclick='() => SetStatusFilter("locked")'>
                    <span class="text-[11px] font-semibold tracking-wide text-rose-700 dark:text-rose-300">Inloggningsspärr</span>
                    <span class="text-lg font-bold leading-none text-rose-800 dark:text-rose-200">@LockedCount</span>
                </button>
            </div>

            <div class="mt-1.5 flex flex-wrap items-center gap-1.5 px-1 text-[11px] text-slate-500 dark:text-slate-400">
                <span class="font-semibold tracking-wide">Behörigheter:</span>
                <span class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-2 py-0.5 dark:bg-slate-800" title="@PermissionDisplay.AdministratorDescription">@PermissionDisplay.Administrators <b class="text-slate-700 dark:text-slate-200">@ManagerCount</b></span>
                <span class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-2 py-0.5 dark:bg-slate-800" title="@PermissionDisplay.CalculationUserDescription">@PermissionDisplay.CalculationUsers <b class="text-slate-700 dark:text-slate-200">@MemberCount</b></span>
                <span class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-2 py-0.5 dark:bg-slate-800" title="@PermissionDisplay.ReaderDescription">@PermissionDisplay.Readers <b class="text-slate-700 dark:text-slate-200">@GuestCount</b></span>
            </div>
        </section>

        <!-- Search / filter toolbar -->
        <div class="shrink-0 rounded-xl border border-slate-200 bg-white p-2.5 shadow-sm dark:border-slate-700 dark:bg-slate-900">
            <div class="flex flex-wrap items-center gap-2">
                <div class="relative min-w-[16rem] flex-1">
                    <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-slate-400">
                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                    </span>
                    <input type="search"
                           placeholder='@WebLoc["SearchUsersPlaceholder"]'
                           value="@SearchInput"
                           @oninput="HandleSearchInput"
                           class="h-9 w-full rounded-lg border border-slate-300 bg-white pl-9 pr-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" />
                </div>

                <div class="min-w-[11rem] flex-1 sm:max-w-48">
                    <FilterMultiSelect TValue="string"
                                       Placeholder="@PermissionDisplay.AllPermissionsLabel"
                                       Options="RoleFilterOptions"
                                       Selected="RoleFilters"
                                       OnChanged="OnFilterChangedAsync" />
                </div>

                <div class="min-w-[11rem] flex-1 sm:max-w-48">
                    <FilterMultiSelect TValue="string"
                                       Placeholder='@WebLoc["AllStatuses"]'
                                       Options="StatusFilterOptions"
                                       Selected="StatusFilters"
                                       OnChanged="OnFilterChangedAsync" />
                </div>

                <div class="min-w-[11rem] flex-1 sm:max-w-48">
                    <FilterMultiSelect TValue="int"
                                       Placeholder="Alla avdelningar"
                                       Options="DepartmentFilterOptions"
                                       Selected="DepartmentFilters"
                                       OnChanged="OnFilterChangedAsync" />
                </div>

                <span class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700 dark:bg-slate-800 dark:text-slate-200">
                    @(string.Format(WebLoc["ShowingCountFormat"].Value, FilteredUsers.Count, TotalCount))
                </span>

                <button type="button"
                        disabled="@(!HasActiveFilters)"
                        class="inline-flex h-8 items-center rounded-lg border border-slate-300 px-3 text-xs font-medium text-slate-600 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-600 dark:text-slate-300 dark:hover:bg-slate-800"
                        @onclick="ClearFilters">
                    @WebLoc["ClearFilters"]
                </button>
            </div>
        </div>

        @if (FilteredUsers.Count == 0)
        {
            <div class="rounded-xl border border-dashed border-slate-300 bg-slate-50 px-4 py-6 text-center text-xs text-slate-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-400">
                @WebLoc["NoResultsMatch"]
            </div>
        }
        else
        {
        @* The rows scroll inside this container; the sticky thead and the sticky pager
           (see .department-users-table in app.tailwind.css) stay pinned top/bottom. *@
        <div class="department-users-table min-h-0 flex-1 overflow-auto rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">
            <MhdTable TItem="TenantUserDto"
                      Items="FilteredUsers"
                      EnablePaging="true"
                      InitialPageSize="10"
                      PageSizes="@(new List<int> { 10, 25, 50 })"
                      RowKeySelector="u => u.Id"
                      EnableColumnResize="true"
                      ColumnWidths="_userColumnWidths"
                      Localization="TableLocalization"
                      OnColumnResized="OnUserColumnResized">
                <MhdTableColumn Title='@WebLoc["Actions"]' ColumnKey="actions" Frozen="true"
                                HeaderClass="bg-white dark:bg-slate-900"
                                CellClass="mhd-table-cell bg-white dark:bg-slate-900">
                    <Template Context="user">
                        <button type="button"
                                class="inline-flex items-center gap-1 rounded-md border border-slate-300 px-2.5 py-1 text-xs font-medium text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-blue-500/20 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-800"
                                aria-expanded="@IsActionMenuOpen(user)"
                                @onclick="args => ToggleActionMenu(user, args)">
                            @WebLoc["Actions"]
                            <svg class="h-3 w-3 text-slate-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
                        </button>
                    </Template>
                </MhdTableColumn>

                <MhdTableColumn Title="@ResourceIdentity.email" ColumnKey="email" ValueSelector="u => u.Email" Sortable="true" />
                <MhdTableColumn Title="@CalcResource.name" ColumnKey="name" ValueSelector="u => GetDisplayName(u)" Sortable="true" />
                <MhdTableColumn Title="@PermissionDisplay.PermissionLabel" ColumnKey="role" ValueSelector='u => GetRoleName(u)' Sortable="true">
                    <Template Context="user">
                        <span class="inline-flex rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-medium text-slate-700 dark:bg-slate-800 dark:text-slate-200"
                              title="@GetRoleTooltip(user)">
                            @GetRoleName(user)
                        </span>
                    </Template>
                </MhdTableColumn>
                <MhdTableColumn Title="Avdelningar" ColumnKey="departments" ValueSelector='u => GetDepartmentDisplayText(u)' Sortable="true">
                    <Template Context="user">
                        <span title="@GetDepartmentName(user)">@GetDepartmentDisplayText(user)</span>
                    </Template>
                </MhdTableColumn>
                <MhdTableColumn Title="Kontostatus" ColumnKey="accountStatus" Sortable="true" SortKeySelector='u => GetAccountStatusLabel(u)'>
                    <Template Context="user">
                        @if (IsDeactivated(user))
                        {
                            <span class="inline-flex rounded-full bg-slate-200 px-2 py-0.5 text-[11px] font-medium text-slate-700 dark:bg-slate-700 dark:text-slate-200">
                                @WebLoc["StatusInactive"]
                            </span>
                        }
                        else if (IsPending(user))
                        {
                            <span class="inline-flex rounded-full bg-blue-100 px-2 py-0.5 text-[11px] font-medium text-blue-700 dark:bg-blue-900/40 dark:text-blue-300">
                                @WebLoc["InvitePending"]
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex rounded-full bg-emerald-100 px-2 py-0.5 text-[11px] font-medium text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300">
                                @WebLoc["StatusActive"]
                            </span>
                        }
                    </Template>
                </MhdTableColumn>
                <MhdTableColumn Title="Inloggningsspärr" ColumnKey="lockout" Sortable="true" SortKeySelector='u => GetLockoutStatus(u)'>
                    <Template Context="user">
                        @if (IsLocked(user))
                        {
                            <span class="inline-flex rounded-full bg-rose-100 px-2 py-0.5 text-[11px] font-semibold text-rose-700 dark:bg-rose-900/40 dark:text-rose-300">
                                @GetLockoutStatus(user)
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-300">
                                @GetLockoutStatus(user)
                            </span>
                        }
                    </Template>
                </MhdTableColumn>
                <MhdTableColumn Title='@WebLoc["LastLogin"]' ColumnKey="lastLogin" Sortable="true" SortKeySelector='u => u.LastLoginAt' ValueSelector='u => FormatDateTime(u.LastLoginAt)' />
                <MhdTableColumn Title='@WebLoc["LockoutStart"]' ColumnKey="lockoutStart" Sortable="true" SortKeySelector='u => u.LockoutStart' ValueSelector='u => FormatDate(u.LockoutStart)' />
                <MhdTableColumn Title='@WebLoc["LockoutEnd"]' ColumnKey="lockoutEnd" Sortable="true" SortKeySelector='u => u.LockoutEnd' ValueSelector='u => FormatDate(u.LockoutEnd)' />
            </MhdTable>
        </div>

        @if (ActionMenuUser is not null)
        {
            var actionUser = ActionMenuUser;
            <div class="fixed inset-0 z-[70]" aria-hidden="true" @onclick="CloseActionMenu"></div>
            <section class="fixed z-[71] w-64 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-2xl ring-1 ring-slate-900/5 dark:border-slate-700 dark:bg-slate-900"
                     style="@ActionMenuStyle"
                     role="menu"
                     aria-label='@WebLoc["Actions"]'
                     @onclick:stopPropagation="true">
                <div class="max-h-[calc(100vh-12rem)] overflow-y-auto p-1">
                    <button class="@ActionMenuItemClass" disabled="@(!CanEdit(actionUser))" title='@ActionDisabledTitle(actionUser, CanEdit(actionUser), "Redigera användaren.", "Användaren saknar inloggning.")' @onclick="() => RunUserAction(actionUser, EditUser)">
                        <span class="inline-flex h-3.5 w-3.5 shrink-0 items-center justify-center text-slate-400 [&>svg]:h-3.5 [&>svg]:w-3.5" aria-hidden="true">@((MarkupString)Icons.Edit)</span>
                        <span>Redigera</span>
                    </button>

                    <button class="@ActionMenuItemClass" disabled="@(!CanSendConfirmation(actionUser))" title='@ActionDisabledTitle(actionUser, CanSendConfirmation(actionUser), "Skickar bekräftelsemail till användaren.", "Användaren saknar e-post eller inloggning.")' @onclick="() => RunUserAction(actionUser, AskSendConfirmation)">
                        <svg class="h-3.5 w-3.5 shrink-0 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
                        <span>Skicka bekräftelsemail</span>
                    </button>

                    <button class="@ActionMenuItemClass" disabled="@(!CanResetPassword(actionUser))" title='@ActionDisabledTitle(actionUser, CanResetPassword(actionUser), "Skickar ett nytt tillfälligt lösenord till användaren.", "Användaren saknar inloggning.")' @onclick="() => RunUserAction(actionUser, AskResetPassword)">
                        <svg class="h-3.5 w-3.5 shrink-0 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="8" cy="15" r="4" /><path d="m10.9 12.1 9.1-9.1M15 4l3 3M18 7l3-3" /></svg>
                        <span>Återställ lösenord</span>
                    </button>

                    <button class="@ActionMenuDangerClass" disabled="@(!CanLock(actionUser))" title='@ActionDisabledTitle(actionUser, CanLock(actionUser), "Spärrar användaren så att inloggning inte längre är möjlig.", LockDisabledTitle(actionUser), "Den sista administratören kan inte spärras.")' @onclick="() => RunUserAction(actionUser, AskToggleLock)">
                        <span class="inline-flex h-3.5 w-3.5 shrink-0 items-center justify-center [&>svg]:h-3.5 [&>svg]:w-3.5" aria-hidden="true">@((MarkupString)Icons.IsLocked(true))</span>
                        <span>Spärra inloggning</span>
                    </button>

                    <button class="@ActionMenuItemClass" disabled="@(!CanUnlock(actionUser))" title='@ActionDisabledTitle(actionUser, CanUnlock(actionUser), "Tar bort spärren så att användaren kan logga in igen.", UnlockDisabledTitle(actionUser))' @onclick="() => RunUserAction(actionUser, AskToggleLock)">
                        <span class="inline-flex h-3.5 w-3.5 shrink-0 items-center justify-center [&>svg]:h-3.5 [&>svg]:w-3.5" aria-hidden="true">@((MarkupString)Icons.IsLocked(false))</span>
                        <span>Ta bort spärr</span>
                    </button>

                    <div class="my-1 border-t border-slate-200 dark:border-slate-700"></div>

                    <button class="@ActionMenuDangerClass" disabled="@(!CanDeactivate(actionUser))" title='@ActionDisabledTitle(actionUser, CanDeactivate(actionUser), "Inaktiverar kontot utan att ta bort användaren.", DeactivateDisabledTitle(actionUser))' @onclick="() => RunUserAction(actionUser, AskToggleActive)">
                        <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18.36 6.64a9 9 0 1 1-12.73 0M12 2v10" /></svg>
                        <span>Inaktivera</span>
                    </button>

                    <button class="@ActionMenuDangerClass" disabled="@(!CanRemoveAuth(actionUser))" title='@ActionDisabledTitle(actionUser, CanRemoveAuth(actionUser), "Tar bort användarens inloggningskonto.", "Användaren saknar inloggning.")' @onclick="() => RunUserAction(actionUser, AskRemoveOnlyFromRegister)">
                        <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M16 17l5-5-5-5M21 12H9M12 19H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h7" /></svg>
                        <span>Ta bort inloggning</span>
                    </button>

                    <button class="@ActionMenuDangerClass" disabled="@(!CanDelete(actionUser))" title='@ActionDisabledTitle(actionUser, CanDelete(actionUser), "Tar bort användaren om det är tillåtet.")' @onclick="() => RunUserAction(actionUser, AskDeleteUser)">
                        <span class="inline-flex h-3.5 w-3.5 shrink-0 items-center justify-center [&>svg]:h-3.5 [&>svg]:w-3.5" aria-hidden="true">@((MarkupString)Icons.DeleteSVG)</span>
                        <span>@AppLoc[nameof(ResourceApp.delete)]</span>
                    </button>
                </div>
            </section>
        }
        }

        @if (DetailsUser is not null)
        {
            <div class="fixed inset-0 z-[75] bg-slate-900/40" aria-hidden="true" @onclick="CloseDetails"></div>
            <aside class="fixed inset-y-0 right-0 z-[76] flex w-full max-w-md flex-col border-l border-slate-200 bg-white shadow-2xl dark:border-slate-700 dark:bg-slate-900"
                   role="dialog" aria-modal="true" aria-label='@WebLoc["UserDetails"]'>
                <div class="flex items-start justify-between gap-2 border-b border-slate-200 bg-slate-50/80 px-3 py-2.5 dark:border-slate-700 dark:bg-slate-800/50">
                    <div class="min-w-0">
                        <div class="text-xs font-semibold tracking-wide text-blue-600 dark:text-blue-300">@WebLoc["UserDetails"]</div>
                        <h4 class="truncate text-lg font-semibold text-slate-900 dark:text-slate-100">@GetDisplayName(DetailsUser)</h4>
                        <span class="mt-1 inline-flex rounded-full bg-emerald-100 px-2 py-0.5 text-[11px] font-medium text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300">
                            @GetAccountStatusLabel(DetailsUser)
                        </span>
                    </div>
                     <button type="button"
                            class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-slate-500 transition hover:bg-slate-100 hover:text-slate-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500/40 dark:text-slate-300 dark:hover:bg-slate-800"
                            title='@WebLoc["Close"]'
                            @onclick="CloseDetails">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
                    </button>
                </div>

                <dl class="grid flex-1 auto-rows-min grid-cols-1 gap-1.5 overflow-y-auto px-3 py-2.5 text-sm sm:grid-cols-2">
                    <div class="rounded-lg border border-slate-200 bg-white p-2.5 dark:border-slate-700 dark:bg-slate-950">
                        <dt class="text-xs text-slate-500 dark:text-slate-400">@CalcResource.name</dt>
                        <dd class="font-medium text-slate-900 dark:text-slate-100">@GetDisplayName(DetailsUser)</dd>
                    </div>
                    <div class="rounded-lg border border-slate-200 bg-white p-2.5 dark:border-slate-700 dark:bg-slate-950">
                        <dt class="text-xs text-slate-500 dark:text-slate-400">@ResourceIdentity.email</dt>
                        <dd class="break-all font-medium text-slate-900 dark:text-slate-100">@(DetailsUser.Email ?? "—")</dd>
                    </div>
                    <div class="rounded-lg border border-slate-200 bg-white p-2.5 dark:border-slate-700 dark:bg-slate-950">
                        <dt class="text-xs text-slate-500 dark:text-slate-400">@PermissionDisplay.PermissionLabel</dt>
                        <dd class="font-medium text-slate-900 dark:text-slate-100" title="@GetRoleTooltip(DetailsUser)">@GetRoleName(DetailsUser)</dd>
                    </div>
                    <div class="rounded-lg border border-slate-200 bg-white p-2.5 dark:border-slate-700 dark:bg-slate-950">
                        <dt class="text-xs text-slate-500 dark:text-slate-400">@ResourceIdentity.department</dt>
                        <dd class="font-medium text-slate-900 dark:text-slate-100">@GetDepartmentName(DetailsUser)</dd>
                    </div>
                    <div class="rounded-lg border border-slate-200 bg-white p-2.5 dark:border-slate-700 dark:bg-slate-950">
                        <dt class="text-xs text-slate-500 dark:text-slate-400">Kontostatus</dt>
                        <dd class="font-medium text-slate-900 dark:text-slate-100">@GetAccountStatusLabel(DetailsUser)</dd>
                    </div>
                    <div class="rounded-lg border border-slate-200 bg-white p-2.5 dark:border-slate-700 dark:bg-slate-950">
                        <dt class="text-xs text-slate-500 dark:text-slate-400">@WebLoc["LastLogin"]</dt>
                        <dd class="font-medium text-slate-900 dark:text-slate-100">@FormatDateTime(DetailsUser.LastLoginAt)</dd>
                    </div>
                    <div class="rounded-lg border border-slate-200 bg-white p-2.5 dark:border-slate-700 dark:bg-slate-950">
                        <dt class="text-xs text-slate-500 dark:text-slate-400">Inloggningsspärr</dt>
                        <dd class="font-medium text-slate-900 dark:text-slate-100">@GetLockoutStatus(DetailsUser)</dd>
                    </div>
                    <div class="rounded-lg border border-slate-200 bg-white p-2.5 dark:border-slate-700 dark:bg-slate-950">
                        <dt class="text-xs text-slate-500 dark:text-slate-400">@ResourceIdentity.phone</dt>
                        <dd class="font-medium text-slate-900 dark:text-slate-100">@(DetailsUser.PhoneNumber ?? "—")</dd>
                    </div>
                </dl>
            </aside>
        }
    }
    else
    {
        <div class="rounded-xl border border-dashed border-slate-300 bg-slate-50 px-4 py-6 text-center text-xs text-slate-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-400">
            @WebLoc["NoUsersFound"]
        </div>
    }
    </div>
</div>
