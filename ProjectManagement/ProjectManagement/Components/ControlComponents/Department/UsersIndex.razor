@using BlazorMHD.UI.Components.Data.Table
@using Domain.DTO.User
@using ProjectManagement.Client.Shared.Constants
@using ProjectManagement.Shared

@inherits AppComponentBase

<div class="space-y-2.5">
    <nav class="flex items-center gap-2 px-1 text-xs font-medium text-slate-500 dark:text-slate-400" aria-label="Breadcrumb">
        <span>@WebLoc["Settings"]</span>
        <span aria-hidden="true">/</span>
        <button type="button" class="hover:text-blue-600 dark:hover:text-blue-300" @onclick="Back">
            @WebLoc["DepartmentsTitle"]
        </button>
        <span aria-hidden="true">/</span>
        <span class="text-slate-800 dark:text-slate-200">@PageTitle</span>
    </nav>

    <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">
        <div class="flex flex-col gap-4 bg-gradient-to-r from-slate-50 via-white to-blue-50/70 px-5 py-4 dark:from-slate-900 dark:via-slate-900 dark:to-blue-950/20 sm:flex-row sm:items-center sm:justify-between">
            <div class="min-w-0">
                <div class="mb-1.5 inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wide text-blue-700 dark:border-blue-900/60 dark:bg-blue-950/40 dark:text-blue-300">
                    <span class="h-2 w-2 rounded-full bg-blue-500"></span>
                    @WebLoc["UsersLabel"]
                </div>
                <h3 class="truncate text-xl font-semibold text-slate-900 dark:text-slate-100">@PageTitle</h3>
                <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">@WebLoc["DepartmentUsersDescription"]</p>
            </div>

            <div class="flex shrink-0 flex-wrap items-center gap-2">
            @if (Users?.Any() == true)
            {
                <button class="inline-flex h-10 items-center justify-center rounded-lg border border-emerald-300 bg-white px-4 text-sm font-semibold text-emerald-700 shadow-sm transition hover:bg-emerald-50 disabled:cursor-not-allowed disabled:opacity-60 dark:border-emerald-700 dark:bg-slate-950 dark:text-emerald-300 dark:hover:bg-emerald-900/30"
                        disabled="@IsBusy"
                        @onclick="ExportUsersAsync">
                    @WebLoc["ExportExcel"]
                </button>
            }

            <button class="inline-flex h-10 items-center justify-center rounded-lg border border-slate-300 bg-white px-4 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-950 dark:text-slate-200 dark:hover:bg-slate-800"
                    disabled="@IsBusy"
                    @onclick="Back">
                @((MarkupString)Icons.Back)
                <span class="ml-1">@WebLoc["BackToDepartments"]</span>
            </button>
            </div>
        </div>
    </div>

    @if (IsLoading)
    {
        <div class="rounded-xl border border-slate-200 bg-white p-3 shadow-sm dark:border-slate-700 dark:bg-slate-900">
            <MhdLoading />
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(LoadError))
    {
        <div class="rounded-xl border border-red-200 bg-red-50 p-3 text-xs text-red-700 shadow-sm dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-300" role="alert">
            <div class="font-semibold">@PageTitle</div>
            <div class="mt-1 break-words">@LoadError</div>
            <button type="button"
                    class="mt-2 inline-flex items-center rounded-lg border border-red-300 bg-white px-2.5 py-1 font-medium hover:bg-red-100 dark:border-red-800 dark:bg-slate-900 dark:hover:bg-red-950/50"
                    @onclick="LoadAsync">
                @WebLoc["Retry"]
            </button>
        </div>
    }
    else if (Users?.Any() == true)
    {
        <section aria-label='@WebLoc["UserSummary"]'>
            <div class="mb-1.5 px-1 text-[11px] text-slate-400 dark:text-slate-500">@WebLoc["FilterByStatusHint"]</div>
            <div class="grid gap-2 sm:grid-cols-3 xl:grid-cols-5">
                <button type="button" aria-pressed="@(StatusFilter == "")"
                        class="rounded-xl border p-3 text-left shadow-sm transition focus:outline-none focus:ring-2 focus:ring-blue-500/30 @(StatusFilter == "" ? "border-blue-400 bg-blue-50/60 ring-1 ring-blue-300 dark:border-blue-600 dark:bg-blue-950/30" : "border-slate-200 bg-white hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:hover:bg-slate-800/60")"
                        @onclick='() => SetStatusFilter("")'>
                    <span class="text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">@WebLoc["TotalUsers"]</span>
                    <span class="mt-1 flex items-baseline gap-1">
                        <span class="text-xl font-bold text-slate-900 dark:text-slate-100">@TotalCount</span>
                        @if (ShowCapacity)
                        {
                            <span class="text-[11px] font-medium @(CapacityReached ? "text-rose-600 dark:text-rose-400" : CapacityNearLimit ? "text-amber-600 dark:text-amber-400" : "text-slate-400 dark:text-slate-500")">/ @TenantMaxUsers</span>
                        }
                    </span>
                    @if (CapacityReached)
                    {
                        <span class="mt-0.5 block text-[10px] font-medium text-rose-600 dark:text-rose-400">@WebLoc["CapacityReached"]</span>
                    }
                </button>

                <button type="button" aria-pressed="@(StatusFilter == "active")"
                        class="rounded-xl border p-3 text-left shadow-sm transition focus:outline-none focus:ring-2 focus:ring-emerald-500/30 @(StatusFilter == "active" ? "border-emerald-400 bg-emerald-50 ring-1 ring-emerald-300 dark:border-emerald-600 dark:bg-emerald-950/40" : "border-emerald-200 bg-emerald-50/40 hover:bg-emerald-50 dark:border-emerald-900/60 dark:bg-emerald-950/20")"
                        @onclick='() => SetStatusFilter("active")'>
                    <span class="text-[11px] font-semibold uppercase tracking-wide text-emerald-700 dark:text-emerald-300">@WebLoc["StatusActive"]</span>
                    <span class="mt-1 block text-xl font-bold text-emerald-800 dark:text-emerald-200">@ActiveCount</span>
                </button>

                <button type="button" aria-pressed="@(StatusFilter == "pending")"
                        class="rounded-xl border p-3 text-left shadow-sm transition focus:outline-none focus:ring-2 focus:ring-blue-500/30 @(StatusFilter == "pending" ? "border-blue-400 bg-blue-50 ring-1 ring-blue-300 dark:border-blue-600 dark:bg-blue-950/40" : "border-blue-200 bg-blue-50/40 hover:bg-blue-50 dark:border-blue-900/60 dark:bg-blue-950/20")"
                        @onclick='() => SetStatusFilter("pending")'>
                    <span class="text-[11px] font-semibold uppercase tracking-wide text-blue-700 dark:text-blue-300">@WebLoc["InvitePending"]</span>
                    <span class="mt-1 block text-xl font-bold text-blue-800 dark:text-blue-200">@PendingCount</span>
                </button>

                <button type="button" aria-pressed="@(StatusFilter == "locked")"
                        class="rounded-xl border p-3 text-left shadow-sm transition focus:outline-none focus:ring-2 focus:ring-rose-500/30 @(StatusFilter == "locked" ? "border-rose-400 bg-rose-50 ring-1 ring-rose-300 dark:border-rose-600 dark:bg-rose-950/40" : "border-rose-200 bg-rose-50/40 hover:bg-rose-50 dark:border-rose-900/60 dark:bg-rose-950/20")"
                        @onclick='() => SetStatusFilter("locked")'>
                    <span class="text-[11px] font-semibold uppercase tracking-wide text-rose-700 dark:text-rose-300">@WebLoc["Lockout"]</span>
                    <span class="mt-1 block text-xl font-bold text-rose-800 dark:text-rose-200">@LockedCount</span>
                </button>

                <button type="button" aria-pressed="@(StatusFilter == "nodept")"
                        class="rounded-xl border p-3 text-left shadow-sm transition focus:outline-none focus:ring-2 focus:ring-amber-500/30 @(StatusFilter == "nodept" ? "border-amber-400 bg-amber-50 ring-1 ring-amber-300 dark:border-amber-600 dark:bg-amber-950/40" : "border-amber-200 bg-amber-50/40 hover:bg-amber-50 dark:border-amber-900/60 dark:bg-amber-950/20")"
                        @onclick='() => SetStatusFilter("nodept")'>
                    <span class="text-[11px] font-semibold uppercase tracking-wide text-amber-700 dark:text-amber-300">@WebLoc["UsersWithoutDepartmentLabel"]</span>
                    <span class="mt-1 block text-xl font-bold text-amber-800 dark:text-amber-200">@WithoutDepartmentCount</span>
                </button>
            </div>

            <div class="mt-2 flex flex-wrap items-center gap-2 px-1 text-[11px] text-slate-500 dark:text-slate-400">
                <span class="font-semibold uppercase tracking-wide">@WebLoc["RoleDistribution"]:</span>
                <span class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-2 py-0.5 dark:bg-slate-800">@WebLoc["LevelManager"] <b class="text-slate-700 dark:text-slate-200">@ManagerCount</b></span>
                <span class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-2 py-0.5 dark:bg-slate-800">@WebLoc["LevelUser"] <b class="text-slate-700 dark:text-slate-200">@MemberCount</b></span>
                <span class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-2 py-0.5 dark:bg-slate-800">@WebLoc["LevelGuest"] <b class="text-slate-700 dark:text-slate-200">@GuestCount</b></span>
                @if (StaleCount > 0)
                {
                    <button type="button" class="inline-flex items-center gap-1 rounded-full border border-amber-300 bg-amber-50 px-2 py-0.5 text-amber-700 transition hover:bg-amber-100 dark:border-amber-800 dark:bg-amber-950/30 dark:text-amber-300"
                            @onclick='() => SetStatusFilter("stale")'>
                        @WebLoc["StatusStale"] <b>@StaleCount</b>
                    </button>
                }
            </div>
        </section>

        <!-- Search / filter toolbar -->
        <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
            <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-[minmax(20rem,1fr)_13rem_13rem]">
                <div class="relative sm:col-span-2 lg:col-span-1">
                    <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-slate-400">
                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                    </span>
                    <input type="search"
                           placeholder='@WebLoc["SearchUsersPlaceholder"]'
                           value="@SearchInput"
                           @oninput="HandleSearchInput"
                           class="h-10 w-full rounded-lg border border-slate-300 bg-white pl-10 pr-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" />
                </div>

                <select @bind="RoleFilter" @bind:after="SaveFilterPreferencesAsync"
                        class="h-10 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100">
                    <option value="">@WebLoc["AllRoles"]</option>
                    <option value="@PMRolesConst.Tenant.Admin">@WebLoc["LevelManager"]</option>
                    <option value="@PMRolesConst.Tenant.Manger">@WebLoc["LevelUser"]</option>
                    <option value="@PMRolesConst.Tenant.User">@WebLoc["LevelGuest"]</option>
                </select>

                <select @bind="StatusFilter" @bind:after="SaveFilterPreferencesAsync"
                        class="h-10 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100">
                    <option value="">@WebLoc["AllStatuses"]</option>
                    <option value="active">@WebLoc["StatusActive"]</option>
                    <option value="pending">@WebLoc["InvitePending"]</option>
                    <option value="stale">@WebLoc["StatusStale"]</option>
                    <option value="inactive">@WebLoc["StatusInactive"]</option>
                    <option value="auth">@WebLoc["UserRegistered"]</option>
                    <option value="noauth">@WebLoc["UserMissingAuth"]</option>
                    <option value="locked">@WebLoc["Lockout"]</option>
                    <option value="nodept">@WebLoc["UsersWithoutDepartmentLabel"]</option>
                </select>
            </div>

            <div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 pt-3 dark:border-slate-800">
                <label class="inline-flex items-center gap-2 text-xs font-medium text-slate-600 dark:text-slate-300">
                    <input type="checkbox"
                           checked="@AllFilteredSelected"
                           @onchange="e => ToggleSelectAll((bool)(e.Value ?? false))"
                           class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 dark:border-slate-600 dark:bg-slate-900" />
                    @WebLoc["SelectAll"]
                </label>

                <div class="flex items-center gap-2">
                    <span class="inline-flex items-center rounded-full bg-slate-100 px-3 py-1.5 text-xs font-medium text-slate-700 dark:bg-slate-800 dark:text-slate-200">
                        @(string.Format(WebLoc["ShowingCountFormat"].Value, FilteredUsers.Count, TotalCount))
                    </span>

                    @if (HasActiveFilters)
                    {
                        <button type="button"
                                class="inline-flex h-8 items-center rounded-lg border border-slate-300 px-3 text-xs font-medium text-slate-600 transition hover:bg-slate-50 dark:border-slate-600 dark:text-slate-300 dark:hover:bg-slate-800"
                                @onclick="ClearFilters">
                            @WebLoc["ClearFilters"]
                        </button>
                    }
                </div>
            </div>
        </div>

        @if (SelectedIds.Count > 0)
        {
            <div class="department-user-bulk flex flex-row flex-wrap items-center gap-3 rounded-xl border border-blue-200 bg-blue-50 p-3.5 shadow-sm dark:border-blue-900/60 dark:bg-blue-950/30">
                <span class="inline-flex items-center rounded-full bg-blue-600 px-3 py-1.5 text-xs font-semibold text-white">
                    @(string.Format(WebLoc["SelectedCountFormat"].Value, SelectedIds.Count))
                </span>

                <div class="flex flex-wrap items-center gap-1.5">
                    <select @bind="BulkDepartmentId"
                            disabled="@IsBusy"
                            class="rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100">
                        <option value="">@WebLoc["UsersWithoutDepartmentLabel"]</option>
                        @if (DepartmentsList is not null)
                        {
                            @foreach (var dep in DepartmentsList)
                            {
                                <option value="@dep.Id">@dep.Name</option>
                            }
                        }
                    </select>
                    <button type="button"
                            disabled="@IsBusy"
                            class="inline-flex items-center justify-center rounded-md border border-slate-300 px-2.5 py-1 text-xs font-medium text-slate-700 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-800"
                            @onclick="BulkMoveAsync">
                        @WebLoc["BulkMoveToDepartment"]
                    </button>
                </div>

                <div class="flex flex-wrap items-center gap-1.5">
                    <select @bind="BulkRole"
                            disabled="@IsBusy"
                            class="rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100">
                        <option value="">@WebLoc["BulkChangeRole"]</option>
                        <option value="@PMRolesConst.Tenant.Admin">@WebLoc["LevelManager"]</option>
                        <option value="@PMRolesConst.Tenant.Manger">@WebLoc["LevelUser"]</option>
                        <option value="@PMRolesConst.Tenant.User">@WebLoc["LevelGuest"]</option>
                    </select>
                    <button type="button"
                            disabled="@(IsBusy || string.IsNullOrEmpty(BulkRole))"
                            class="inline-flex items-center justify-center rounded-md border border-slate-300 px-2.5 py-1 text-xs font-medium text-slate-700 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-800"
                            @onclick="AskBulkRole">
                        @WebLoc["Apply"]
                    </button>
                </div>

                <div class="flex flex-wrap items-center gap-1.5 md:ml-auto">
                    <button type="button"
                            disabled="@IsBusy"
                            class="inline-flex items-center justify-center rounded-md border border-emerald-400 px-2.5 py-1 text-xs font-medium text-emerald-700 transition hover:bg-emerald-50 disabled:opacity-60 dark:border-emerald-700 dark:text-emerald-300 dark:hover:bg-emerald-900/30"
                            @onclick="ExportSelectedUsersAsync">
                        @WebLoc["ExportSelected"]
                    </button>
                    <button type="button"
                            disabled="@IsBusy"
                            class="inline-flex items-center justify-center rounded-md border border-amber-400 px-2.5 py-1 text-xs font-medium text-amber-700 transition hover:bg-amber-50 disabled:cursor-not-allowed disabled:opacity-60 dark:border-amber-700 dark:text-amber-300 dark:hover:bg-amber-900/30"
                            @onclick="() => AskBulkLock(true)">
                        @WebLoc["BulkLock"]
                    </button>
                    <button type="button"
                            disabled="@IsBusy"
                            class="inline-flex items-center justify-center rounded-md border border-emerald-400 px-2.5 py-1 text-xs font-medium text-emerald-600 transition hover:bg-emerald-50 disabled:cursor-not-allowed disabled:opacity-60 dark:border-emerald-700 dark:text-emerald-300 dark:hover:bg-emerald-900/30"
                            @onclick="() => AskBulkLock(false)">
                        @WebLoc["BulkUnlock"]
                    </button>
                    <button type="button"
                            disabled="@IsBusy"
                            class="inline-flex items-center justify-center rounded-md border border-red-400 px-2.5 py-1 text-xs font-medium text-red-600 transition hover:bg-red-50 disabled:cursor-not-allowed disabled:opacity-60 dark:border-red-700 dark:text-red-300 dark:hover:bg-red-900/30"
                            @onclick="AskBulkDelete">
                        @WebLoc["BulkDelete"]
                    </button>
                    <button type="button"
                            disabled="@IsBusy"
                            class="inline-flex items-center justify-center rounded-md border border-slate-300 px-2.5 py-1 text-xs font-medium text-slate-600 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-600 dark:text-slate-300 dark:hover:bg-slate-800"
                            @onclick="ClearSelection">
                        @WebLoc["ClearSelection"]
                    </button>
                </div>
            </div>
        }

        @if (FilteredUsers.Count == 0)
        {
            <div class="rounded-xl border border-dashed border-slate-300 bg-slate-50 px-4 py-6 text-center text-xs text-slate-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-400">
                @WebLoc["NoResultsMatch"]
            </div>
        }
        else
        {
        <div class="department-users-table overflow-auto rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900" style="overflow:auto">
            <MhdTable TItem="TenantUserDto"
                      Items="FilteredUsers"
                      EnablePaging="true"
                      InitialPageSize="10"
                      PageSizes="@(new List<int> { 10, 25, 50 })"
                      RowKeySelector="u => u.Id"
                      EnableColumnResize="true"
                      ColumnWidths="_userColumnWidths"
                      OnColumnResized="OnUserColumnResized">
                <MhdTableColumn Title="" ColumnKey="select" Frozen="true"
                                HeaderClass="bg-white dark:bg-slate-900"
                                CellClass="mhd-table-cell bg-white dark:bg-slate-900">
                    <Template Context="user">
                        <input type="checkbox"
                               checked="@IsSelected(user.Id)"
                               @onchange="e => ToggleSelected(user.Id, (bool)(e.Value ?? false))"
                               class="h-3.5 w-3.5 rounded border-slate-300 text-blue-600 focus:ring-blue-500 dark:border-slate-600 dark:bg-slate-900" />
                    </Template>
                </MhdTableColumn>

                <MhdTableColumn Title='@WebLoc["Actions"]' ColumnKey="actions" Frozen="true"
                                HeaderClass="bg-white dark:bg-slate-900"
                                CellClass="mhd-table-cell bg-white dark:bg-slate-900">
                    <Template Context="user">
                        <div class="flex items-center gap-1.5">
                            <button class="inline-flex items-center justify-center rounded-md border border-slate-300 px-2.5 py-1 text-xs font-medium text-slate-700 transition hover:bg-slate-50 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-800"
                                    title='@WebLoc["UserDetails"]'
                                    @onclick="() => ShowDetails(user)">
                                @WebLoc["UserDetails"]
                            </button>
                            <details class="relative">
                                <summary class="cursor-pointer list-none rounded-md border border-slate-300 px-2.5 py-1 text-xs font-medium text-slate-700 hover:bg-slate-50 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-800">
                                    @WebLoc["Actions"]
                                </summary>
                                <div class="mt-1 flex min-w-48 flex-col gap-1 rounded-lg border border-slate-200 bg-white p-1.5 shadow-lg dark:border-slate-700 dark:bg-slate-900">
                            @if (user.IsInAuth)
                            {
                                <button class="inline-flex items-center justify-center rounded-md border border-amber-400 px-2.5 py-1 text-xs font-medium text-amber-700 transition hover:bg-amber-50 dark:border-amber-700 dark:text-amber-300 dark:hover:bg-amber-900/30"
                                        disabled="@IsBusy"
                                        title="@AppLoc[nameof(ResourceApp.edit)]"
                                        @onclick="() => EditUser(user)">
                                    @((MarkupString)Icons.Edit)
                                </button>
                            }
                            else
                            {
                                <button class="inline-flex items-center justify-center rounded-md border border-emerald-400 px-2.5 py-1 text-xs font-medium text-emerald-600 transition hover:bg-emerald-50 dark:border-emerald-700 dark:text-emerald-300 dark:hover:bg-emerald-900/30"
                                        disabled="@IsBusy"
                                        title='@WebLoc["RecreateAuthUser"]'
                                        @onclick="() => RecreateUserAsync(user)">
                                    @WebLoc["RecreateAuthUser"]
                                </button>
                            }

                            @if (IsPending(user))
                            {
                                <button class="inline-flex items-center justify-center rounded-md border border-blue-400 bg-blue-50 px-2.5 py-1 text-xs font-medium text-blue-700 transition hover:bg-blue-100 dark:border-blue-700 dark:bg-blue-950/30 dark:text-blue-300 dark:hover:bg-blue-900/40"
                                        disabled="@IsBusy"
                                        title='@WebLoc["ResendInvite"]'
                                        @onclick="() => AskResendInvitation(user)">
                                    @WebLoc["ResendInvite"]
                                </button>
                            }

                            @if (user.IsInAuth)
                            {
                                <button class="inline-flex items-center justify-center rounded-md border border-blue-400 px-2.5 py-1 text-xs font-medium text-blue-600 transition hover:bg-blue-50 dark:border-blue-700 dark:text-blue-300 dark:hover:bg-blue-900/30"
                                        disabled="@IsBusy"
                                        title='@WebLoc["ResetPassword"]'
                                        @onclick="() => AskResetPassword(user)">
                                    @WebLoc["ResetPassword"]
                                </button>
                            }

                            @if (user.IsInAuth)
                            {
                                @if (IsLocked(user))
                                {
                                    <button class="inline-flex items-center justify-center rounded-md border border-emerald-400 px-2.5 py-1 text-xs font-medium text-emerald-600 transition hover:bg-emerald-50 dark:border-emerald-700 dark:text-emerald-300 dark:hover:bg-emerald-900/30"
                                            disabled="@IsBusy"
                                            title='@WebLoc["UnlockUser"]'
                                            @onclick="() => AskToggleLock(user)">
                                        @WebLoc["UnlockUser"]
                                    </button>
                                }
                                else
                                {
                                    <button class="inline-flex items-center justify-center rounded-md border border-amber-400 px-2.5 py-1 text-xs font-medium text-amber-700 transition hover:bg-amber-50 dark:border-amber-700 dark:text-amber-300 dark:hover:bg-amber-900/30"
                                            disabled="@IsBusy"
                                            title='@WebLoc["LockUser"]'
                                            @onclick="() => AskToggleLock(user)">
                                        @WebLoc["LockUser"]
                                    </button>
                                }
                            }

                            @if (user.IsInAuth)
                            {
                                @if (IsDeactivated(user))
                                {
                                    <button class="inline-flex items-center justify-center rounded-md border border-emerald-400 px-2.5 py-1 text-xs font-medium text-emerald-600 transition hover:bg-emerald-50 dark:border-emerald-700 dark:text-emerald-300 dark:hover:bg-emerald-900/30"
                                            disabled="@IsBusy"
                                            title='@WebLoc["Activate"]'
                                            @onclick="() => AskToggleActive(user)">
                                        @WebLoc["Activate"]
                                    </button>
                                }
                                else
                                {
                                    <button class="inline-flex items-center justify-center rounded-md border border-slate-400 px-2.5 py-1 text-xs font-medium text-slate-600 transition hover:bg-slate-50 dark:border-slate-600 dark:text-slate-300 dark:hover:bg-slate-800"
                                            disabled="@IsBusy"
                                            title='@WebLoc["Deactivate"]'
                                            @onclick="() => AskToggleActive(user)">
                                        @WebLoc["Deactivate"]
                                    </button>
                                }
                            }

                            <button class="inline-flex items-center justify-center rounded-md border border-red-400 px-2.5 py-1 text-xs font-medium text-red-600 transition hover:bg-red-50 dark:border-red-700 dark:text-red-300 dark:hover:bg-red-900/30"
                                    disabled="@IsBusy"
                                    title="@AppLoc[nameof(ResourceApp.delete)]"
                                    @onclick="() => AskDeleteUser(user)">
                                @((MarkupString)Icons.DeleteSVG)
                            </button>

                            @if (user.IsInAuth || !string.IsNullOrWhiteSpace(user.IdAuth))
                            {
                                <button class="inline-flex items-center justify-center rounded-md border border-slate-300 px-2.5 py-1 text-xs font-medium text-slate-700 transition hover:bg-slate-50 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-800"
                                        disabled="@IsBusy"
                                        title='@WebLoc["RemoveFromRegisterOnly"]'
                                        @onclick="() => AskRemoveOnlyFromRegister(user)">
                                    @WebLoc["RemoveFromRegisterOnly"]
                                </button>
                            }
                                </div>
                            </details>
                        </div>
                    </Template>
                </MhdTableColumn>

                <MhdTableColumn Title="@ResourceIdentity.email" ColumnKey="email" ValueSelector="u => u.Email" Sortable="true" />
                <MhdTableColumn Title="@CalcResource.name" ColumnKey="name" ValueSelector="u => GetDisplayName(u)" Sortable="true" />
                <MhdTableColumn Title='@WebLoc["Role"]' ColumnKey="role" ValueSelector='u => GetRoleName(u)' />
                <MhdTableColumn Title='@WebLoc["AuthStatus"]' ColumnKey="authStatus">
                    <Template Context="user">
                        @if (!user.IsInAuth)
                        {
                            <span class="inline-flex rounded-full bg-amber-100 px-2 py-0.5 text-[11px] font-medium text-amber-700 dark:bg-amber-900/40 dark:text-amber-300">
                                @WebLoc["UserMissingAuth"]
                            </span>
                        }
                        else if (IsDeactivated(user))
                        {
                            <span class="inline-flex rounded-full bg-slate-200 px-2 py-0.5 text-[11px] font-medium text-slate-700 dark:bg-slate-700 dark:text-slate-200">
                                @WebLoc["StatusInactive"]
                            </span>
                        }
                        else if (IsLocked(user))
                        {
                            <span class="inline-flex rounded-full bg-rose-100 px-2 py-0.5 text-[11px] font-medium text-rose-700 dark:bg-rose-900/40 dark:text-rose-300">
                                @WebLoc["Lockout"]
                            </span>
                        }
                        else if (IsPending(user))
                        {
                            <span class="inline-flex rounded-full bg-blue-100 px-2 py-0.5 text-[11px] font-medium text-blue-700 dark:bg-blue-900/40 dark:text-blue-300">
                                @WebLoc["InvitePending"]
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex rounded-full bg-emerald-100 px-2 py-0.5 text-[11px] font-medium text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300">
                                @(IsStale(user) ? WebLoc["StatusStale"] : WebLoc["StatusActive"])
                            </span>
                        }
                    </Template>
                </MhdTableColumn>
                <MhdTableColumn Title='@WebLoc["LastLogin"]' ColumnKey="lastLogin" ValueSelector='u => FormatDateTime(u.LastLoginAt)' />
                <MhdTableColumn Title='@WebLoc["Lockout"]' ColumnKey="lockout" ValueSelector='u => u.LockoutEnabled ? WebLoc["Enabled"].Value : WebLoc["Disabled"].Value' />
                <MhdTableColumn Title='@WebLoc["LockoutStart"]' ColumnKey="lockoutStart" ValueSelector='u => FormatDate(u.LockoutStart)' />
                <MhdTableColumn Title='@WebLoc["LockoutEnd"]' ColumnKey="lockoutEnd" ValueSelector='u => FormatDate(u.LockoutEnd)' />
            </MhdTable>
        </div>
        }

        <details class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm open:ring-2 open:ring-blue-500/10 dark:border-slate-700 dark:bg-slate-900">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-3 bg-slate-50/80 px-4 py-3.5 dark:bg-slate-800/60">
                <div>
                    <div class="text-sm font-semibold text-slate-900 dark:text-slate-100">@WebLoc["UserAuditLog"]</div>
                    <div class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">@WebLoc["UserAuditLogDescription"]</div>
                </div>
                <span class="rounded-full bg-blue-100 px-2.5 py-1 text-xs font-semibold text-blue-700 dark:bg-blue-950/50 dark:text-blue-300">@AuditEntries.Count</span>
            </summary>
            <div class="border-t border-slate-200 p-3 dark:border-slate-700">
                <div class="mb-3 flex justify-end">
                    <button type="button" disabled="@IsLoadingAudit" class="h-9 rounded-lg border border-slate-300 px-3 text-sm font-medium text-slate-700 hover:bg-slate-50 disabled:opacity-60 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-800" @onclick="RefreshAuditAsync">
                        @WebLoc["Refresh"]
                    </button>
                </div>
                @if (!string.IsNullOrWhiteSpace(AuditLoadError))
                {
                    <div class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800 dark:border-amber-900/60 dark:bg-amber-950/30 dark:text-amber-200">
                        @WebLoc["AuditTemporarilyUnavailable"]
                    </div>
                }
                else if (AuditEntries.Count == 0)
                {
                    <div class="rounded-lg border border-dashed border-slate-300 px-4 py-6 text-center text-sm text-slate-500 dark:border-slate-700 dark:text-slate-400">@WebLoc["NoAuditEntries"]</div>
                }
                else
                {
                    <div class="max-h-80 overflow-auto rounded-lg border border-slate-200 dark:border-slate-700">
                        <table class="min-w-[820px] w-full text-sm">
                            <thead class="sticky top-0 bg-slate-50 dark:bg-slate-800">
                                <tr>
                                    <th class="px-3 py-2 text-left text-xs font-semibold text-slate-500">@WebLoc["AuditAction"]</th>
                                    <th class="px-3 py-2 text-left text-xs font-semibold text-slate-500">@WebLoc["AuditTarget"]</th>
                                    <th class="px-3 py-2 text-left text-xs font-semibold text-slate-500">@WebLoc["AuditActor"]</th>
                                    <th class="px-3 py-2 text-left text-xs font-semibold text-slate-500">@WebLoc["AuditDetails"]</th>
                                    <th class="px-3 py-2 text-left text-xs font-semibold text-slate-500">@WebLoc["CreatedLabel"]</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                                @foreach (var entry in AuditEntries)
                                {
                                    <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
                                        <td class="whitespace-nowrap px-3 py-2.5 font-medium text-slate-800 dark:text-slate-100">@GetAuditActionLabel(entry.Action)</td>
                                        <td class="px-3 py-2.5 text-slate-700 dark:text-slate-200">@entry.TargetDisplayName</td>
                                        <td class="px-3 py-2.5 text-slate-600 dark:text-slate-300">@entry.ActorDisplayName</td>
                                        <td class="max-w-sm truncate px-3 py-2.5 text-slate-500 dark:text-slate-400" title="@entry.Details">@(entry.Details ?? "—")</td>
                                        <td class="whitespace-nowrap px-3 py-2.5 text-slate-500 dark:text-slate-400">@entry.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </details>

        @if (DetailsUser is not null)
        {
            <aside class="rounded-xl border border-blue-200 bg-white p-4 shadow-sm dark:border-blue-900/60 dark:bg-slate-900" aria-label='@WebLoc["UserDetails"]'>
                <div class="flex items-start justify-between gap-3">
                    <div>
                        <div class="text-xs font-semibold uppercase tracking-wide text-blue-600 dark:text-blue-300">@WebLoc["UserDetails"]</div>
                        <h4 class="text-lg font-semibold text-slate-900 dark:text-slate-100">@GetDisplayName(DetailsUser)</h4>
                    </div>
                    <button type="button" class="h-9 rounded-lg border border-slate-300 px-3 text-sm dark:border-slate-700" @onclick="CloseDetails">@WebLoc["Close"]</button>
                </div>
                <dl class="mt-3 grid gap-3 text-sm sm:grid-cols-2 lg:grid-cols-4">
                    <div><dt class="text-slate-500">@ResourceIdentity.email</dt><dd class="font-medium text-slate-900 dark:text-slate-100">@(DetailsUser.Email ?? "—")</dd></div>
                    <div><dt class="text-slate-500">@WebLoc["Role"]</dt><dd class="font-medium text-slate-900 dark:text-slate-100">@GetRoleName(DetailsUser)</dd></div>
                    <div><dt class="text-slate-500">@ResourceIdentity.phone</dt><dd class="font-medium text-slate-900 dark:text-slate-100">@(DetailsUser.PhoneNumber ?? "—")</dd></div>
                    <div><dt class="text-slate-500">@WebLoc["LastLogin"]</dt><dd class="font-medium text-slate-900 dark:text-slate-100">@FormatDateTime(DetailsUser.LastLoginAt)</dd></div>
                </dl>
            </aside>
        }
    }
    else
    {
        <div class="rounded-xl border border-dashed border-slate-300 bg-slate-50 px-4 py-6 text-center text-xs text-slate-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-400">
            @WebLoc["NoUsersFound"]
        </div>
    }
</div>
