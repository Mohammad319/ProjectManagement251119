@using BlazorMHD.UI.Components.Data.Table
@using Domain.DTO.User
@using ProjectManagement.Shared.DTO.Identity
@using ProjectManagement.Client.Shared.Constants
@using ProjectManagement.Shared

@inherits AppComponentBase

<div class="d-flex justify-content-between align-items-center mb-2">
    <button class="@CssClasses.Btn.Outline.Secondary"
            disabled="@IsBusy"
            @onclick="Back">
        @((MarkupString)Icons.Back)
    </button>

    @if (IsLoading)
    {
        <BlazorMHD.UI.Components.Feedback.Loading.MhdLoading />
    }
</div>

@if (!IsLoading && Users is not null)
{
    <div class="overflow-auto" style="overflow:auto">
        <MhdTable TItem="TenantUserDto" Items="Users">
            <MhdTableColumn Title="">
                <Template Context="user">
                    <div class="@CssClasses.Layout.FlexItemsCenter" style="gap:8px; flex-wrap:wrap">
                        <button class="@CssClasses.Btn.Outline.Warning"
                                disabled="@IsBusy"
                                title="@AppLoc[nameof(ResourceApp.edit)]"
                                @onclick="() => EditUser(user)">
                            @((MarkupString)Icons.Edit)
                        </button>

                        <button class="@CssClasses.Btn.Outline.Danger"
                                disabled="@IsBusy"
                                title="@AppLoc[nameof(ResourceApp.delete)]"
                                @onclick="() => AskDeleteUser(user)">
                            @((MarkupString)Icons.DeleteSVG)
                        </button>

                        <button class="@CssClasses.Btn.Outline.Danger"
                                disabled="@IsBusy"
                                title="@AppLoc["removeOnlyFromRegister"]"
                                @onclick="() => AskRemoveOnlyFromRegister(user)">
                            @AppLoc["removeOnlyFromRegister"]
                        </button>
                    </div>
                </Template>
            </MhdTableColumn>

            <MhdTableColumn Title="@ResourceIdentity.email" ValueSelector="u => u.Email" Sortable="true" />
            <MhdTableColumn Title="@CalcResource.name" ValueSelector="@(u => (u.Firstname + " " + u.Lastname))" />
            <MhdTableColumn Title="Role" ValueSelector="u => u.Role" />
            <MhdTableColumn Title="LockoutStart" ValueSelector="u => u.LockoutStart" />
            <MhdTableColumn Title="LockoutEnd" ValueSelector="u => u.LockoutEnd" />
            <MhdTableColumn Title="Lockout" ValueSelector="u => u.LockoutEnabled" />
        </MhdTable>
    </div>
}
else if (!IsLoading)
{
    <div class="text-muted">@AppLoc[nameof(ResourceApp.notFoundData)]</div>
}
