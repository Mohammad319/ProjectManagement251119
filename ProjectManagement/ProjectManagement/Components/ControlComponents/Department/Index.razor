@using BlazorMHD.UI.Components.Navigation.Tabs
@using BlazorMHD.UI.Core.Navigation

@* "Avdelningar & användare": three sub-tabs (Avdelningar, Användare, Aktivitetslogg),
   same tab pattern as the Projekt/Kalkyl admin pages. *@
<MhdTabs Items="@Tabs"
         @bind-ActiveKey="activeKey"
         Size="MhdSize.Sm"
         Class="admin-subtabs flex min-h-0 flex-col"
         ContentClass="min-h-0 flex-1 overflow-y-auto" />

@code {
    private string? activeKey;
    private List<MhdTabItem> Tabs = new();

    protected override void OnInitialized()
    {
        Tabs =
        [
            new MhdTabItem
            {
                Key = "departments",
                Text = "Avdelningar",
                Content = @<DepartmentsTab OnOpenAllUsers="ShowUsersTab" />
            },
            new MhdTabItem
            {
                Key = "users",
                Text = "Användare",
                Content = @<UsersIndex />
            },
            new MhdTabItem
            {
                Key = "audit",
                Text = "Aktivitetslogg",
                Content = @<UserAuditLogUI />
            }
        ];

        if (string.IsNullOrWhiteSpace(activeKey) && Tabs.Count > 0)
            activeKey = Tabs[0].Key;
    }

    private void ShowUsersTab() => activeKey = "users";
}
