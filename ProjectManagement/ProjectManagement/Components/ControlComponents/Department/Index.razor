@inherits AppComponentBase

@using ProjectManagement.Client.Shared.Constants
@using ProjectManagement.Shared.DTO.Identity
@using ProjectManagement.Shared.Models.Account
@using ProjectManagement.Shared
@inject Microsoft.Extensions.Localization.IStringLocalizer<ProjectManagement.Shared.PMWebResource> WebLoc

@if (Mode == ViewMode.Details && SelectedDepartment is not null)
{
    <DepartmentDetailsUI DepartmentList="SelectedDepartment" OnClickCallback="BackToList" />
}
else if (Mode == ViewMode.Users)
{
    <UsersIndex DepartmentId="SelectedDepartmentIdForUsers"
                WithoutDepartmentOnly="WithoutDepartmentOnly"
                OnClickCallback="BackToList" />
}
else
{
    
    <div class="space-y-5">
        <!-- Header / Summary -->
        <section class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
            <div class="border-b border-slate-200 bg-gradient-to-r from-slate-50 via-white to-emerald-50/60 px-5 py-5 dark:border-slate-800 dark:from-slate-900 dark:via-slate-900 dark:to-emerald-950/20 sm:px-6">
                <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
                    <div class="min-w-0 p-1">
                        <div class="inline-flex items-center gap-2 rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1 text-xs font-semibold tracking-wide text-emerald-700 dark:border-emerald-900/70 dark:bg-emerald-950/40 dark:text-emerald-300">
                            <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
                            @WebLoc["DepartmentsTitle"]
                        </div>

                        <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600 dark:text-slate-400">
                            @WebLoc["DepartmentsDescription"]
                        </p>
                    </div>

                    <div class="flex flex-wrap items-center gap-3">
                        <button type="button"
                                class="inline-flex items-center justify-center rounded-xl border border-emerald-300 bg-white px-4 py-2.5 text-sm font-medium text-emerald-700 shadow-sm transition hover:border-emerald-400 hover:bg-emerald-50 focus:outline-none focus:ring-2 focus:ring-emerald-500/30 dark:border-emerald-800 dark:bg-slate-950 dark:text-emerald-300 dark:hover:bg-emerald-950/30"
                                @onclick="OpenRegisterUser">
                            @PMResourceIdentity.register
                        </button>

                        <button type="button"
                                class="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-500/40 dark:bg-emerald-500 dark:hover:bg-emerald-400"
                                @onclick="OpenCreateDepartment">
                            <span class="inline-flex h-5 w-5 items-center justify-center">
                                @((MarkupString)Icons.Plus2)
                            </span>
                            <span>@WebLoc["NewDepartment"]</span>
                        </button>
                    </div>
                </div>
            </div>

            <div class="grid gap-3 p-5 sm:grid-cols-2 lg:grid-cols-3 sm:p-6">
                <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-800 dark:bg-slate-800/50">
                    <div class="text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400">
                        @AppLoc[nameof(ResourceApp.department)]
                    </div>
                    <div class="mt-2 flex items-end justify-between">
                        <div class="text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100">
                            @(Departments?.Count ?? 0)
                        </div>
                        <div class="rounded-full bg-emerald-100 px-2.5 py-1 text-xs font-medium text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-300">
                            Active
                        </div>
                    </div>
                </div>

                <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-800 dark:bg-slate-800/50">
                    <div class="text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400">
                        @ResourceIdentity.Admin
                    </div>
                    <div class="mt-2 text-sm leading-6 text-slate-700 dark:text-slate-300">
                        @WebLoc["AllUsersHint"]
                    </div>
                </div>

                <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-800 dark:bg-slate-800/50 sm:col-span-2 lg:col-span-1">
                    <div class="text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400">
                        @WebLoc["QuickAction"]
                    </div>
                    <div class="mt-3">
                        <button type="button"
                                class="inline-flex items-center rounded-lg text-sm font-medium text-blue-700 transition hover:text-blue-800 hover:underline dark:text-blue-300 dark:hover:text-blue-200"
                                @onclick="OpenAllUsers">
                            @WebLoc["OpenAllUsers"]
                        </button>
                    </div>
                </div>
            </div>
        </section>

        @if (Departments?.Any() == true)
        {
            <!-- Desktop table -->
            <section class="hidden overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900 lg:block">
                <div class="border-b border-slate-200 px-6 py-4 dark:border-slate-800">
                    <h3 class="text-base font-semibold text-slate-900 dark:text-slate-100">
                        @WebLoc["DepartmentsTitle"]
                    </h3>
                </div>

                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-slate-200 dark:divide-slate-800">
                        <thead class="bg-slate-50 dark:bg-slate-800/70">
                            <tr>
                                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400">
                                    @CalcResource.name
                                </th>
                                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400">
                                    @AppLoc[nameof(ResourceLoc.description)]
                                </th>
                                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400">
                                    @WebLoc["UsersLabel"]
                                </th>
                                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400">
                                    @CalcResource.project
                                </th>
                                <th class="px-6 py-4 text-right text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400">
                                    @WebLoc["Actions"]
                                </th>
                            </tr>
                        </thead>

                        <tbody class="divide-y divide-slate-200 dark:divide-slate-800">
                            <!-- Admin row -->
                            <tr class="bg-slate-50/70 dark:bg-slate-800/30">
                                <td class="px-6 py-5 align-top">
                                    <div class="flex items-start gap-3">
                                        <div class="mt-0.5 flex h-10 w-10 items-center justify-center rounded-xl bg-violet-100 text-violet-700 dark:bg-violet-950/40 dark:text-violet-300">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
                                                <path d="M12 12a5 5 0 1 0-5-5 5 5 0 0 0 5 5Zm-7 9a7 7 0 1 1 14 0Z" />
                                            </svg>
                                        </div>
                                        <div>
                                            <div class="font-semibold text-slate-900 dark:text-slate-100">
                                                @ResourceIdentity.Admin
                                            </div>
                                            <div class="mt-1 text-xs leading-5 text-slate-500 dark:text-slate-400">
                                                @WebLoc["AdminUsersDescription"]
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <td class="px-6 py-5 text-sm text-slate-400 dark:text-slate-500">—</td>

                                <td class="px-6 py-5">
                                    <span class="inline-flex items-center rounded-full bg-blue-100 px-2.5 py-1 text-xs font-medium text-blue-700 dark:bg-blue-950/40 dark:text-blue-300">
                                        @WebLoc["UsersWithoutDepartmentLabel"]
                                    </span>
                                </td>

                                <td class="px-6 py-5 text-sm text-slate-400 dark:text-slate-500">—</td>

                                <td class="px-6 py-5">
                                    <div class="flex justify-end gap-2">
                                        <button type="button"
                                                disabled
                                                class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-300 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-600">
                                            @((MarkupString)Icons.Edit)
                                        </button>

                                        <button type="button"
                                                disabled
                                                class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-300 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-600">
                                            @((MarkupString)Icons.DeleteSVG)
                                        </button>

                                        <button type="button"
                                                class="inline-flex items-center rounded-lg px-3 py-2 text-sm font-medium text-blue-700 transition hover:bg-blue-50 hover:text-blue-800 dark:text-blue-300 dark:hover:bg-blue-950/30 dark:hover:text-blue-200"
                                                @onclick="OpenUsersWithoutDepartment">
                                            @WebLoc["OpenUsersWithoutDepartment"]
                                        </button>
                                    </div>
                                </td>
                            </tr>

                            @foreach (var department in Departments)
                            {
                                <tr class="transition hover:bg-slate-50 dark:hover:bg-slate-800/40">
                                    <td class="px-6 py-5 align-top">
                                        <div class="flex items-start gap-3">
                                            <div class="mt-0.5 flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-100 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-300">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
                                                    <path d="M3 21h18v-2H3Zm2-4h4V9H5Zm5 0h4V3h-4Zm5 0h4v-6h-4Z" />
                                                </svg>
                                            </div>

                                            <div class="min-w-0">
                                                <button type="button"
                                                        class="text-left text-sm font-semibold text-slate-900 transition hover:text-blue-700 dark:text-slate-100 dark:hover:text-blue-300"
                                                        @onclick="() => OpenDepartmentUsers(department.Id)">
                                                    @department.Name
                                                </button>
                                            </div>
                                        </div>
                                    </td>

                                    <td class="px-6 py-5 text-sm leading-6 text-slate-600 dark:text-slate-300">
                                        @(string.IsNullOrWhiteSpace(department.Description) ? "—" : department.Description)
                                    </td>

                                    <td class="px-6 py-5">
                                        <span class="inline-flex min-w-[44px] items-center justify-center rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-200">
                                            @department.UsersCount
                                        </span>
                                    </td>

                                    <td class="px-6 py-5">
                                        <span class="inline-flex min-w-[44px] items-center justify-center rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-200">
                                            @department.ProjectsCount
                                        </span>
                                    </td>

                                    <td class="px-6 py-5">
                                        <div class="flex justify-end gap-2">
                                            <button type="button"
                                                    title="@AppLoc[nameof(ResourceApp.update)]"
                                                    class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-amber-200 bg-amber-50 text-amber-700 transition hover:bg-amber-100 dark:border-amber-900/60 dark:bg-amber-950/30 dark:text-amber-300 dark:hover:bg-amber-950/50"
                                                    @onclick="() => OpenEditDepartment(department)">
                                                @((MarkupString)Icons.Edit)
                                            </button>

                                            <button type="button"
                                                    title="@AppLoc[nameof(ResourceApp.delete)]"
                                                    class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-rose-200 bg-rose-50 text-rose-700 transition hover:bg-rose-100 dark:border-rose-900/60 dark:bg-rose-950/30 dark:text-rose-300 dark:hover:bg-rose-950/50"
                                                    @onclick="() => AskRemoveDepartment(department)">
                                                @((MarkupString)Icons.DeleteSVG)
                                            </button>

                                            <button type="button"
                                                    class="inline-flex items-center rounded-lg px-3 py-2 text-sm font-medium text-blue-700 transition hover:bg-blue-50 hover:text-blue-800 dark:text-blue-300 dark:hover:bg-blue-950/30 dark:hover:text-blue-200"
                                                    @onclick="() => OpenDepartmentUsers(department.Id)">
                                                @WebLoc["OpenUsers"]
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- Mobile / tablet cards -->
            <section class="grid gap-2 md:grid-cols-2 lg:grid-cols-3 lg:hidden">
                <div class="rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
                    <div class="border-b border-slate-200 px-3 py-3 dark:border-slate-800">
                        <div class="font-semibold text-slate-900 dark:text-slate-100">
                            @ResourceIdentity.Admin
                        </div>
                        <div class="mt-1 text-sm text-slate-500 dark:text-slate-400">
                            @WebLoc["AdminUsersDescription"]
                        </div>
                    </div>

                    <div class="space-y-3 px-3 py-3">
                        <div class="flex items-center justify-between text-sm">
                            <span class="text-slate-500 dark:text-slate-400">@WebLoc["UsersLabel"]</span>
                            <span class="rounded-full bg-blue-100 px-2.5 py-1 text-xs font-medium text-blue-700 dark:bg-blue-950/40 dark:text-blue-300">
                                @WebLoc["UsersWithoutDepartmentLabel"]
                            </span>
                        </div>

                        <div class="flex flex-wrap gap-2">
                            <button type="button"
                                    class="inline-flex items-center rounded-lg px-3 py-2 text-sm font-medium text-blue-700 transition hover:bg-blue-50 dark:text-blue-300 dark:hover:bg-blue-950/30"
                                    @onclick="OpenUsersWithoutDepartment">
                                @WebLoc["OpenUsersWithoutDepartment"]
                            </button>
                        </div>
                    </div>
                </div>

                @foreach (var department in Departments)
                {
                    <div class="h-full rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
                        <div class="border-b border-slate-200 px-3 py-3 dark:border-slate-800">
                            <div class="flex items-start justify-between gap-3">
                                <div class="min-w-0">
                                    <button type="button"
                                            class="truncate text-left text-base font-semibold text-slate-900 transition hover:text-blue-700 dark:text-slate-100 dark:hover:text-blue-300"
                                            @onclick="() => OpenDepartmentUsers(department.Id)">
                                        @department.Name
                                    </button>
                                </div>

                                <div class="rounded-full bg-emerald-100 px-2.5 py-1 text-xs font-medium text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-300">
                                    Dept
                                </div>
                            </div>
                        </div>

                        <div class="space-y-3 px-3 py-3">
                            <div>
                                <div class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
                                    @AppLoc[nameof(ResourceLoc.description)]
                                </div>
                                <div class="mt-1 text-sm text-slate-700 dark:text-slate-300">
                                    @(string.IsNullOrWhiteSpace(department.Description) ? "—" : department.Description)
                                </div>
                            </div>

                            <div class="grid grid-cols-2 gap-2">
                                <div class="rounded-lg bg-slate-50 px-2.5 py-2.5 dark:bg-slate-800/60">
                                    <div class="text-xs text-slate-500 dark:text-slate-400">@WebLoc["UsersLabel"]</div>
                                    <div class="mt-1 text-lg font-semibold text-slate-900 dark:text-slate-100">
                                        @department.UsersCount
                                    </div>
                                </div>

                                <div class="rounded-lg bg-slate-50 px-2.5 py-2.5 dark:bg-slate-800/60">
                                    <div class="text-xs text-slate-500 dark:text-slate-400">@CalcResource.project</div>
                                    <div class="mt-1 text-lg font-semibold text-slate-900 dark:text-slate-100">
                                        @department.ProjectsCount
                                    </div>
                                </div>
                            </div>

                            <div class="flex flex-wrap gap-2">
                                <button type="button"
                                        class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-amber-200 bg-amber-50 text-amber-700 transition hover:bg-amber-100 dark:border-amber-900/60 dark:bg-amber-950/30 dark:text-amber-300 dark:hover:bg-amber-950/50"
                                        title="@AppLoc[nameof(ResourceApp.update)]"
                                        @onclick="() => OpenEditDepartment(department)">
                                    @((MarkupString)Icons.Edit)
                                </button>

                                <button type="button"
                                        class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-rose-200 bg-rose-50 text-rose-700 transition hover:bg-rose-100 dark:border-rose-900/60 dark:bg-rose-950/30 dark:text-rose-300 dark:hover:bg-rose-950/50"
                                        title="@AppLoc[nameof(ResourceApp.delete)]"
                                        @onclick="() => AskRemoveDepartment(department)">
                                    @((MarkupString)Icons.DeleteSVG)
                                </button>

                                <button type="button"
                                        class="inline-flex items-center rounded-lg px-3 py-2 text-sm font-medium text-blue-700 transition hover:bg-blue-50 dark:text-blue-300 dark:hover:bg-blue-950/30"
                                        @onclick="() => OpenDepartmentUsers(department.Id)">
                                    @WebLoc["OpenUsers"]
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </section>
        }
        else
        {
            <section class="rounded-3xl border border-dashed border-slate-300 bg-white px-6 py-14 text-center shadow-sm dark:border-slate-700 dark:bg-slate-900">
                <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-slate-100 dark:bg-slate-800">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-slate-500 dark:text-slate-400" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M3 21h18v-2H3Zm2-4h4V9H5Zm5 0h4V3h-4Zm5 0h4v-6h-4Z" />
                    </svg>
                </div>

                <h3 class="mt-4 text-base font-semibold text-slate-900 dark:text-slate-100">
                    @WebLoc["DepartmentsTitle"]
                </h3>

                <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-slate-500 dark:text-slate-400">
                    @WebLoc["NoDepartmentsMessage"]
                </p>

                <div class="mt-5">
                    <button type="button"
                            class="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-500/40 dark:bg-emerald-500 dark:hover:bg-emerald-400"
                            @onclick="OpenCreateDepartment">
                        <span class="inline-flex h-5 w-5 items-center justify-center">
                            @((MarkupString)Icons.Plus2)
                        </span>
                        <span>@WebLoc["NewDepartment"]</span>
                    </button>
                </div>
            </section>
        }
    </div>
}
