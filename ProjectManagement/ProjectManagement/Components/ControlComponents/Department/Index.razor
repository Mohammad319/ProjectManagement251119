@inherits AppComponentBase

@using ProjectManagement.Client.Shared.Constants
@using ProjectManagement.Shared.DTO.Identity
@using ProjectManagement.Shared.Models.Account
@using ProjectManagement.Shared
@inject Microsoft.Extensions.Localization.IStringLocalizer<ProjectManagement.Shared.PMWebResource> WebLoc

@if (Mode == ViewMode.Details && SelectedDepartment is not null)
{
    <DepartmentDetailsUI DepartmentList="SelectedDepartment" OnClickCallback="BackToList" />
}
else if (Mode == ViewMode.Users)
{
    <UsersIndex DepartmentId="SelectedDepartmentIdForUsers" OnClickCallback="BackToList" />
}
else
{
    <div class="space-y-4">
        <div class="flex flex-col gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
            <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
                <div>
                    <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100">
                        @WebLoc["DepartmentsTitle"]
                    </h3>
                    <p class="text-sm text-slate-500 dark:text-slate-400">
                        @WebLoc["DepartmentsDescription"]
                    </p>
                </div>

                <div class="flex flex-wrap items-center gap-2">
                    <button class="@CssClasses.Btn.Outline.Success" @onclick="OpenRegisterUser">
                        @PMResourceIdentity.register
                    </button>

                    <button class="@CssClasses.Btn.Outline.Success" @onclick="OpenCreateDepartment">
                        @((MarkupString)Icons.Plus2)
                        <span class="ml-1">@WebLoc["NewDepartment"]</span>
                    </button>
                </div>
            </div>

            <div class="grid gap-3 md:grid-cols-3">
                <div class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 dark:border-slate-700 dark:bg-slate-800/60">
                    <div class="text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400">@AppLoc[nameof(ResourceApp.department)]</div>
                    <div class="mt-1 text-2xl font-semibold text-slate-900 dark:text-slate-100">@(Departments?.Count ?? 0)</div>
                </div>
                <div class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 dark:border-slate-700 dark:bg-slate-800/60">
                    <div class="text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400">@PMResourceIdentity.Admin</div>
                    <div class="mt-1 text-sm text-slate-700 dark:text-slate-200">@WebLoc["AllUsersHint"]</div>
                </div>
                <div class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 dark:border-slate-700 dark:bg-slate-800/60">
                    <div class="text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400">@WebLoc["QuickAction"]</div>
                    <button class="mt-2 @CssClasses.Btn.Link" @onclick="OpenAdminUsers">
                        @WebLoc["OpenAllUsers"]
                    </button>
                </div>
            </div>
        </div>

        @if (Departments?.Any() == true)
        {
            <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">
                <table class="min-w-full divide-y divide-slate-200 dark:divide-slate-700">
                    <thead class="bg-slate-50 dark:bg-slate-800/70">
                        <tr>
                            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">@CalcResource.name</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">@AppLoc[nameof(ResourceLoc.description)]</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">@WebLoc["UsersLabel"]</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">@CalcResource.project</th>
                            <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">@WebLoc["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200 dark:divide-slate-700">
                        <tr>
                            <td class="px-4 py-4 align-top">
                                <div class="font-medium text-slate-900 dark:text-slate-100">@PMResourceIdentity.Admin</div>
                                <div class="mt-1 text-xs text-slate-500 dark:text-slate-400">@WebLoc["AdminUsersDescription"]</div>
                            </td>
                            <td class="px-4 py-4 text-sm text-slate-500 dark:text-slate-400">—</td>
                            <td class="px-4 py-4 text-sm text-slate-700 dark:text-slate-200">@WebLoc["AllUsersLabel"]</td>
                            <td class="px-4 py-4 text-sm text-slate-500 dark:text-slate-400">—</td>
                            <td class="px-4 py-4">
                                <div class="flex justify-end gap-2">
                                    <button class="@CssClasses.Btn.Outline.Secondary" disabled>
                                        @((MarkupString)Icons.Edit)
                                    </button>
                                    <button class="@CssClasses.Btn.Outline.Danger" disabled>
                                        @((MarkupString)Icons.DeleteSVG)
                                    </button>
                                    <button class="@CssClasses.Btn.Link" @onclick="OpenAdminUsers">
                                        @WebLoc["OpenAllUsers"]
                                    </button>
                                </div>
                            </td>
                        </tr>

                        @foreach (var department in Departments)
                        {
                            <tr>
                                <td class="px-4 py-4 align-top">
                                    <button class="text-left font-medium text-slate-900 hover:text-blue-700 dark:text-slate-100 dark:hover:text-blue-300"
                                            @onclick="() => OpenDepartmentUsers(department.Id)">
                                        @department.Name
                                    </button>
                                </td>
                                <td class="px-4 py-4 text-sm text-slate-600 dark:text-slate-300">
                                    @(string.IsNullOrWhiteSpace(department.Description) ? "—" : department.Description)
                                </td>
                                <td class="px-4 py-4 text-sm text-slate-700 dark:text-slate-200">
                                    @department.UsersCount
                                </td>
                                <td class="px-4 py-4 text-sm text-slate-700 dark:text-slate-200">
                                    @department.ProjectsCount
                                </td>
                                <td class="px-4 py-4">
                                    <div class="flex justify-end gap-2">
                                        <button class="@CssClasses.Btn.IconButton.Warning"
                                                title="@AppLoc[nameof(ResourceApp.update)]"
                                                @onclick="() => OpenEditDepartment(department)">
                                            @((MarkupString)Icons.Edit)
                                        </button>

                                        <button class="@CssClasses.Btn.IconButton.Danger"
                                                title="@AppLoc[nameof(ResourceApp.delete)]"
                                                @onclick="() => AskRemoveDepartment(department)">
                                            @((MarkupString)Icons.DeleteSVG)
                                        </button>

                                        <button class="@CssClasses.Btn.Link"
                                                @onclick="() => OpenDepartmentUsers(department.Id)">
                                            @WebLoc["OpenUsers"]
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-6 py-10 text-center text-sm text-slate-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-400">
                @WebLoc["NoDepartmentsMessage"]
            </div>
        }
    </div>
}
