@using Application.Feature.Identity.Department.Commands
@using Application.Feature.Identity.Department.Queries
@using BlazorMHD.UI.Core.Services
@using Domain.DTO.User
@using ProjectManagement.Client.Shared.Constants
@using ProjectManagement.Shared
@using ProjectManagement.Shared.DTO.Identity
@using ProjectManagement.Shared.Models.Account

@inject ICommandDispatcher MicroBus
@inject MhdServices MHD
@inject IStringLocalizer<ResourceApp> AppLoc


@if (Mode == ViewMode.Details && SelectedDepartment is not null)
{
    <DepartmentDetailsUI DepartmentList="SelectedDepartment" OnClickCallback="BackToList" />
}
else if (Mode == ViewMode.Users)
{
    <UsersIndex DepartmentId="SelectedDepartmentIdForUsers" OnClickCallback="BackToList" />
}
else
{
    <div class="@CssClasses.Layout.FlexItemsCenter pb-1">
        <button class="@CssClasses.Btn.Outline.Success" @onclick="OpenRegisterUser">
            @PMResourceIdentity.register
        </button>

        <button class="@CssClasses.Btn.Outline.Success" @onclick="OpenCreateDepartment">
            @Icons.Plus2
        </button>
    </div>

    <table class="@CssClasses.Table.Tab">
        <tbody class="@CssClasses.Table.TBody">
            <tr class="@CssClasses.Table.Tr">
                <td scope="row" class="@CssClasses.Table.Td">
                    <div>
                        <button class="@CssClasses.Btn.IconButton.Warning" disabled>
                            @((MarkupString)Icons.Edit)
                        </button>
                        <button class="@CssClasses.Btn.IconButton.Danger" disabled>
                            @((MarkupString)Icons.DeleteSVG)
                        </button>

                        <button class="@CssClasses.Btn.Link" @onclick="OpenAdminUsers">
                            @ResourceIdentity.Admin
                        </button>
                    </div>
                </td>
            </tr>

            @if (Departments is not null)
            {
                @foreach (var department in Departments)
                {
                    <tr class="@CssClasses.Table.Tr">
                        <td scope="row" class="@CssClasses.Table.Td">
                            <div>
                                <button class="@CssClasses.Btn.IconButton.Warning"
                                        @onclick="() => OpenEditDepartment(department)">
                                    @((MarkupString)Icons.Edit)
                                </button>

                                <button class="@CssClasses.Btn.IconButton.Danger"
                                        @onclick="() => AskRemoveDepartment(department)">
                                    @((MarkupString)Icons.DeleteSVG)
                                </button>

                                <button class="@CssClasses.Btn.Link"
                                        @onclick="() => OpenDepartmentUsers(department.Id)">
                                    @department.Name
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
}

@code {
    private enum ViewMode
    {
        List = 0,
        Details = 1,
        Users = 2
    }

    private List<DepartmentDetailsDTO>? Departments;
    private DepartmentDetailsDTO? SelectedDepartment;

    private int? SelectedDepartmentIdForUsers;
    private ViewMode Mode = ViewMode.List;

    protected override async Task OnInitializedAsync()
    {
        await ReloadDepartmentsAsync();
    }

    private async Task ReloadDepartmentsAsync()
    {
        Departments = await MicroBus.Send(new GetDepartmentsQuery());
        StateHasChanged();
    }

    private void BackToList(bool _ = false)
    {
        // reset selection
        SelectedDepartment = null;
        SelectedDepartmentIdForUsers = 0;
        Mode = ViewMode.List;

        MHD.Modal.Close();
        StateHasChanged();
    }

    private void OpenRegisterUser()
    {
        var user = new TenantUserDto();

       MHD.Modal.ShowComponent<UpdateUserUI>(
            PMResourceIdentity.register,
            new Dictionary<string, object>
            {
                [nameof(UpdateUserUI.UserForm)] = user,
                [nameof(UpdateUserUI.Callback)] = EventCallback.Factory.Create<bool>(this, OnModalResultAsync),
            }, DialogSize.ExtraLarge);
    }

    private void OpenCreateDepartment()
    {
        OpenDepartmentModal(new DepartmentDetailsDTO { Id = 0 });
    }

    private void OpenEditDepartment(DepartmentDetailsDTO department)
    {
        OpenDepartmentModal(department);
    }

    private void OpenDepartmentModal(DepartmentDetailsDTO department)
    {
        var title = department.Id > 0
            ? AppLoc[LocalizerConst.Update, department.Name]
            : AppLoc[LocalizerConst.New, ResourceApp.department];

       MHD.Modal.ShowComponent<CreateDepartment>(
            title,
            new Dictionary<string, object>
            {
                [nameof(CreateDepartment.DepartmentList)] = department,
                [nameof(CreateDepartment.OnClickCallback)] = EventCallback.Factory.Create<bool>(this, OnModalResultAsync),
            },
            DialogSize.ExtraLarge);
    }

    private void OpenAdminUsers()
    {
        SelectedDepartmentIdForUsers = null; // Admin department/users view in your current logic
        Mode = ViewMode.Users;
    }

    private void OpenDepartmentUsers(int departmentId)
    {
        SelectedDepartmentIdForUsers = departmentId;
        Mode = ViewMode.Users;
    }

    private void AskRemoveDepartment(DepartmentDetailsDTO department)
    {
        MHD.DeleteMessage(department.Name, EventCallback.Factory.Create(this, () => ConfirmRemoveAsync(department)));
    }

    private async Task ConfirmRemoveAsync(DepartmentDetailsDTO department)
    {
        var ok = await MicroBus.Send(new DeleteDepartmentCommand(department.Id));
        if (ok)
        {
            await ReloadDepartmentsAsync();
        }
        StateHasChanged();
    }

    private async Task OnModalResultAsync(bool isSuccess)
    {
        if (isSuccess)
            await ReloadDepartmentsAsync();

        BackToList();
    }
}
