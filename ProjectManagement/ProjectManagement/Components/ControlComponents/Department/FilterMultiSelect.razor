@typeparam TValue
@* Compact multi-choice dropdown used for the "Alla användare" filters (role, status, department). *@

<div class="relative">
    <button type="button"
            class="flex h-9 w-full items-center justify-between gap-2 rounded-lg border border-slate-300 bg-white px-3 text-left text-sm text-slate-900 shadow-sm outline-none transition hover:bg-slate-50 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100 dark:hover:bg-slate-800"
            @onclick="Toggle">
        <span class="truncate @(Selected.Count == 0 ? "text-slate-500 dark:text-slate-400" : "")">@TriggerLabel</span>
        <span class="flex shrink-0 items-center gap-1">
            @if (Selected.Count > 0)
            {
                <span class="inline-flex h-4 min-w-4 items-center justify-center rounded-full bg-blue-600 px-1 text-[10px] font-semibold text-white">@Selected.Count</span>
            }
            <svg class="h-3.5 w-3.5 text-slate-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
        </span>
    </button>

    @if (_open)
    {
        <div class="fixed inset-0 z-[60]" @onclick="Close"></div>
        <div class="absolute left-0 top-full z-[61] mt-1 max-h-64 w-full min-w-[13rem] overflow-auto rounded-lg border border-slate-200 bg-white p-1 shadow-xl ring-1 ring-slate-900/5 dark:border-slate-700 dark:bg-slate-900"
             @onclick:stopPropagation="true">
            @if (Selected.Count > 0)
            {
                <button type="button"
                        class="mb-1 w-full rounded-md px-2 py-1 text-left text-[11px] font-medium text-slate-500 transition hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-800"
                        @onclick="ClearAsync">
                    Rensa val
                </button>
            }
            @foreach (var opt in Options)
            {
                var selected = Selected.Contains(opt.Value);
                <label class="flex cursor-pointer items-center gap-2 rounded-md px-2 py-1.5 text-xs transition @(selected ? "bg-blue-50 font-medium text-blue-700 dark:bg-blue-950/40 dark:text-blue-300" : "text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800")">
                    <input type="checkbox"
                           class="h-3.5 w-3.5 rounded border-slate-300 text-blue-600 focus:ring-blue-500 dark:border-slate-600 dark:bg-slate-900"
                           checked="@selected"
                           @onchange="e => OnToggleAsync(opt.Value, (bool)(e.Value ?? false))" />
                    <span class="flex-1 truncate">@opt.Label</span>
                </label>
            }
        </div>
    }
</div>

@code {
    public sealed record Option(TValue Value, string Label);

    [Parameter, EditorRequired] public IReadOnlyList<Option> Options { get; set; } = [];
    [Parameter, EditorRequired] public HashSet<TValue> Selected { get; set; } = [];
    [Parameter] public string Placeholder { get; set; } = string.Empty;
    [Parameter] public EventCallback OnChanged { get; set; }

    private bool _open;

    private void Toggle() => _open = !_open;
    private void Close() => _open = false;

    private string TriggerLabel
    {
        get
        {
            if (Selected.Count == 0)
                return Placeholder;

            if (Selected.Count == 1)
                return Options.FirstOrDefault(o => Selected.Contains(o.Value))?.Label ?? Placeholder;

            return $"{Placeholder} ({Selected.Count})";
        }
    }

    private async Task OnToggleAsync(TValue value, bool on)
    {
        if (on)
            Selected.Add(value);
        else
            Selected.Remove(value);

        await OnChanged.InvokeAsync();
    }

    private async Task ClearAsync()
    {
        Selected.Clear();
        await OnChanged.InvokeAsync();
    }
}
