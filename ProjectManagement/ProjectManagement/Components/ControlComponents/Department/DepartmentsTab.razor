@inherits AppComponentBase

@using ProjectManagement.Client.Shared.Constants
@using ProjectManagement.Shared.DTO.Identity
@using ProjectManagement.Shared.Models.Account
@using ProjectManagement.Shared
@inject Microsoft.Extensions.Localization.IStringLocalizer<ProjectManagement.Shared.PMWebResource> WebLoc

@if (Mode == ViewMode.Details && SelectedDepartment is not null)
{
    <DepartmentDetailsUI DepartmentList="SelectedDepartment" OnClickCallback="BackToList" />
}
else if (Mode == ViewMode.Users)
{
    <UsersIndex DepartmentId="SelectedDepartmentIdForUsers"
                WithoutDepartmentOnly="WithoutDepartmentOnly"
                OnClickCallback="BackToList" />
}
else
{
    <div class="flex h-full min-h-0 flex-col gap-1.5">
        <!-- Toolbar: actions left, compact search pinned right -->
        <div class="flex shrink-0 flex-wrap items-center gap-1.5 rounded-xl border border-slate-200 bg-white px-2.5 py-1.5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
            @* Ny avdelning *@
            <button type="button"
                    class="inline-flex items-center justify-center gap-1.5 whitespace-nowrap rounded-lg bg-emerald-600 px-2.5 py-1.5 text-xs font-semibold text-white shadow-sm transition hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-500/40 dark:bg-emerald-500 dark:hover:bg-emerald-400"
                    @onclick="OpenCreateDepartment">
                @((MarkupString)Icons.PlusSVG)
                <span>@WebLoc["NewDepartment"]</span>
            </button>

            @* Exportera till Excel *@
            @if (Departments?.Any() == true)
            {
                <button type="button"
                        class="inline-flex items-center justify-center whitespace-nowrap rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs font-medium text-slate-700 shadow-sm transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-emerald-500/30 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-200 dark:hover:bg-slate-800"
                        @onclick="ExportDepartmentsAsync">
                    @WebLoc["ExportExcel"]
                </button>
            }

            <span class="group relative inline-flex">
                <svg tabindex="0" role="img"
                     aria-label='@WebLoc["DepartmentsDescription"]'
                     class="h-4 w-4 cursor-help text-slate-400 outline-none transition-colors hover:text-sky-600 focus-visible:text-sky-600 dark:hover:text-sky-400"
                     viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span role="tooltip"
                      class="pointer-events-none absolute left-1/2 top-full z-[80] mt-1 w-72 -translate-x-1/2 rounded-md bg-slate-800 px-2.5 py-1.5 text-xs font-normal leading-snug text-white opacity-0 shadow-lg transition-opacity duration-150 group-hover:opacity-100 group-focus-within:opacity-100 dark:bg-slate-700">
                    @WebLoc["DepartmentsDescription"]
                </span>
            </span>

            <div class="relative ml-auto w-full sm:w-56">
                <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-slate-400">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                </span>
                <input type="search"
                       placeholder='@WebLoc["SearchDepartmentsPlaceholder"]'
                       value="@DepartmentSearch"
                       @oninput="@(e => DepartmentSearch = e.Value?.ToString() ?? string.Empty)"
                       class="w-full rounded-lg border border-slate-300 bg-white py-1.5 pl-9 pr-2.5 text-xs text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" />
            </div>
        </div>

        @if (IsLoadingDepartments)
        {
            <div class="shrink-0 rounded-xl border border-slate-200 bg-white p-3 shadow-sm dark:border-slate-800 dark:bg-slate-900">
                <MhdLoading />
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(DepartmentLoadError))
        {
            <div class="shrink-0 rounded-xl border border-red-200 bg-red-50 p-3 text-xs text-red-700 shadow-sm dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-300" role="alert">
                <div class="font-semibold">@WebLoc["DepartmentsTitle"]</div>
                <div class="mt-1 break-words">@DepartmentLoadError</div>
                <button type="button" class="mt-2 rounded-lg border border-red-300 bg-white px-2.5 py-1 font-medium hover:bg-red-100 dark:border-red-800 dark:bg-slate-900" @onclick="ReloadDepartmentsAsync">
                    @WebLoc["Retry"]
                </button>
            </div>
        }

        <!-- Summary (compact, fixed above the scrolling table) -->
        <section class="shrink-0 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
            <div class="grid gap-1.5 p-1.5 sm:grid-cols-2 lg:grid-cols-4">
                <div class="flex items-center justify-between gap-2 rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 dark:border-slate-800 dark:bg-slate-800/50"
                     title="Baserat på aktuellt filter">
                    <div class="min-w-0">
                        <div class="text-[10px] font-semibold tracking-[0.12em] text-slate-500 dark:text-slate-400">
                            @WebLoc["DepartmentsTitle"]
                        </div>
                        <div class="text-base font-bold leading-tight tracking-tight text-slate-900 dark:text-slate-100">
                            @FilteredDepartments.Count <span class="text-xs font-medium text-slate-400 dark:text-slate-500">/ @(Departments?.Count ?? 0)</span>
                        </div>
                    </div>
                    <div class="shrink-0 rounded-full bg-emerald-100 px-2 py-0.5 text-[11px] font-medium text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-300">
                        Filter
                    </div>
                </div>

                <div class="flex items-center justify-between gap-2 rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 dark:border-slate-800 dark:bg-slate-800/50"
                     title="Baserat på aktuellt filter">
                    <div class="min-w-0">
                        <div class="text-[10px] font-semibold tracking-[0.12em] text-slate-500 dark:text-slate-400">
                            @WebLoc["TotalUsers"]
                        </div>
                        <button type="button"
                                class="text-base font-bold leading-tight tracking-tight text-slate-900 transition hover:text-blue-700 dark:text-slate-100 dark:hover:text-blue-300"
                                title='@WebLoc["OpenAllUsers"]'
                                @onclick="OpenAllUsers">
                            @FilteredUsersCount
                        </button>
                        <div class="truncate text-[11px] leading-4 text-slate-500 dark:text-slate-400">
                            Admin @FilteredAdminCount · Användare @FilteredMemberCount · Visare @FilteredViewerCount
                        </div>
                    </div>
                    <div class="shrink-0 rounded-full bg-blue-100 px-2 py-0.5 text-[11px] font-medium text-blue-700 dark:bg-blue-950/40 dark:text-blue-300">
                        Filter
                    </div>
                </div>

                <div class="flex items-center justify-between gap-2 rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 dark:border-slate-800 dark:bg-slate-800/50">
                    <div class="min-w-0">
                        <div class="text-[10px] font-semibold tracking-[0.12em] text-slate-500 dark:text-slate-400">
                            @WebLoc["TotalProjects"]
                        </div>
                        <div class="text-base font-bold leading-tight tracking-tight text-slate-900 dark:text-slate-100">
                            @FilteredProjectsCount
                        </div>
                    </div>
                    <div class="shrink-0 rounded-full bg-violet-100 px-2 py-0.5 text-[11px] font-medium text-violet-700 dark:bg-violet-950/40 dark:text-violet-300">
                        @CalcResource.project
                    </div>
                </div>

                <div class="flex items-center justify-between gap-2 rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 dark:border-slate-800 dark:bg-slate-800/50">
                    <div class="min-w-0">
                        <div class="text-[10px] font-semibold tracking-[0.12em] text-slate-500 dark:text-slate-400">
                            Totalt antal kalkyler
                        </div>
                        <div class="text-base font-bold leading-tight tracking-tight text-slate-900 dark:text-slate-100">
                            @FilteredCalculationsCount
                        </div>
                    </div>
                    <div class="shrink-0 rounded-full bg-amber-100 px-2 py-0.5 text-[11px] font-medium text-amber-700 dark:bg-amber-950/40 dark:text-amber-300">
                        @CalcResource.calculation
                    </div>
                </div>
            </div>
        </section>

        @if (Departments?.Any() == true)
        {
            @if (FilteredDepartments.Count == 0)
            {
                <div class="shrink-0 rounded-xl border border-dashed border-slate-300 bg-white px-4 py-6 text-center text-xs text-slate-500 shadow-sm dark:border-slate-700 dark:bg-slate-900 dark:text-slate-400">
                    @WebLoc["NoResultsMatch"]
                </div>
            }

            @* Desktop table: sticky header + only the rows scroll + sticky pager at the bottom.
               table-fixed with the column widths below keeps it inside the viewport (no horizontal scroll). *@
            <section class="hidden min-h-0 flex-1 flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900 lg:flex">
                <div class="min-h-32 flex-1 overflow-auto">
                    <table class="w-full table-fixed border-separate border-spacing-0">
                        <colgroup>
                            <col class="w-[24%]" />
                            <col />
                            <col class="w-[8%]" />
                            <col class="w-[8%]" />
                            <col class="w-[8%]" />
                            <col class="w-[9%]" />
                        </colgroup>
                        <thead class="sticky top-0 z-10">
                            <tr>
                                <th class="border-b border-slate-200 bg-slate-50 px-3 py-1.5 text-left text-[11px] font-semibold text-slate-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-400">
                                    <button type="button" class="inline-flex items-center gap-1 hover:text-slate-700 dark:hover:text-slate-200" @onclick="() => SortBy(DeptSortColumn.Name)">
                                        Namn
                                        <span class='text-[10px] @(SortColumn == DeptSortColumn.Name ? "text-slate-700 dark:text-slate-200" : "text-slate-300 dark:text-slate-500")'>@SortArrow(DeptSortColumn.Name)</span>
                                    </button>
                                </th>
                                <th class="border-b border-slate-200 bg-slate-50 px-3 py-1.5 text-left text-[11px] font-semibold text-slate-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-400">
                                    Intern notering
                                </th>
                                <th class="border-b border-slate-200 bg-slate-50 px-3 py-1.5 text-left text-[11px] font-semibold text-slate-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-400">
                                    <button type="button" class="inline-flex items-center gap-1 hover:text-slate-700 dark:hover:text-slate-200" @onclick="() => SortBy(DeptSortColumn.Users)">
                                        Användare
                                        <span class='text-[10px] @(SortColumn == DeptSortColumn.Users ? "text-slate-700 dark:text-slate-200" : "text-slate-300 dark:text-slate-500")'>@SortArrow(DeptSortColumn.Users)</span>
                                    </button>
                                </th>
                                <th class="border-b border-slate-200 bg-slate-50 px-3 py-1.5 text-left text-[11px] font-semibold text-slate-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-400">
                                    <button type="button" class="inline-flex items-center gap-1 hover:text-slate-700 dark:hover:text-slate-200" @onclick="() => SortBy(DeptSortColumn.Projects)">
                                        Projekt
                                        <span class='text-[10px] @(SortColumn == DeptSortColumn.Projects ? "text-slate-700 dark:text-slate-200" : "text-slate-300 dark:text-slate-500")'>@SortArrow(DeptSortColumn.Projects)</span>
                                    </button>
                                </th>
                                <th class="border-b border-slate-200 bg-slate-50 px-3 py-1.5 text-left text-[11px] font-semibold text-slate-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-400">
                                    <button type="button" class="inline-flex items-center gap-1 hover:text-slate-700 dark:hover:text-slate-200" @onclick="() => SortBy(DeptSortColumn.Calculations)">
                                        Kalkyl
                                        <span class='text-[10px] @(SortColumn == DeptSortColumn.Calculations ? "text-slate-700 dark:text-slate-200" : "text-slate-300 dark:text-slate-500")'>@SortArrow(DeptSortColumn.Calculations)</span>
                                    </button>
                                </th>
                                <th class="border-b border-slate-200 bg-slate-50 px-3 py-1.5 text-right text-[11px] font-semibold text-slate-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-400">
                                    Åtgärder
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            <!-- Admin row (system department) -->
                            <tr class="bg-slate-50/70 dark:bg-slate-800/30">
                                <td class="border-b border-slate-100 px-3 py-1.5 align-top dark:border-slate-800">
                                    <div class="flex items-start gap-2">
                                        <div class="flex h-6 w-6 shrink-0 items-center justify-center rounded-lg bg-violet-100 text-violet-700 dark:bg-violet-950/40 dark:text-violet-300">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor">
                                                <path d="M12 12a5 5 0 1 0-5-5 5 5 0 0 0 5 5Zm-7 9a7 7 0 1 1 14 0Z" />
                                            </svg>
                                        </div>
                                        <div class="min-w-0">
                                            <div class="text-sm font-semibold text-slate-900 dark:text-slate-100">
                                                @ResourceIdentity.Admin
                                            </div>
                                            <div class="line-clamp-2 text-[11px] leading-4 text-slate-500 dark:text-slate-400" title="@WebLoc["AdminUsersDescription"]">
                                                @WebLoc["AdminUsersDescription"]
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <td class="border-b border-slate-100 px-3 py-1.5 text-xs text-slate-400 dark:border-slate-800 dark:text-slate-500">—</td>

                                <td class="border-b border-slate-100 px-3 py-1.5 dark:border-slate-800">
                                    <span class="inline-flex items-center rounded-full bg-blue-100 px-2 py-0.5 text-[11px] font-medium text-blue-700 dark:bg-blue-950/40 dark:text-blue-300">
                                        Systemavdelning
                                    </span>
                                </td>

                                <td class="border-b border-slate-100 px-3 py-1.5 text-xs text-slate-400 dark:border-slate-800 dark:text-slate-500">—</td>

                                <td class="border-b border-slate-100 px-3 py-1.5 text-xs text-slate-400 dark:border-slate-800 dark:text-slate-500">—</td>

                                <td class="border-b border-slate-100 px-3 py-1.5 dark:border-slate-800">
                                    <div class="flex items-center justify-end gap-1.5">
                                        @* System department — cannot be edited or deleted. *@
                                        <span class="group relative inline-flex">
                                            <button type="button"
                                                    disabled
                                                    aria-label="Systemavdelning kan inte ändras."
                                                    class="inline-flex h-7 w-7 cursor-not-allowed items-center justify-center rounded-lg border border-slate-200 bg-slate-50 text-slate-300 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-600">
                                                @((MarkupString)Icons.Edit)
                                            </button>
                                            <span role="tooltip"
                                                  class="pointer-events-none absolute bottom-full right-0 z-[80] mb-1 w-56 rounded-md bg-slate-800 px-2.5 py-1.5 text-xs font-normal leading-snug text-white opacity-0 shadow-lg transition-opacity duration-150 group-hover:opacity-100 group-focus-within:opacity-100 dark:bg-slate-700">
                                                Systemavdelning kan inte ändras.
                                            </span>
                                        </span>

                                        <span class="group relative inline-flex">
                                            <button type="button"
                                                    disabled
                                                    aria-label="Systemavdelning kan inte ändras."
                                                    class="inline-flex h-7 w-7 cursor-not-allowed items-center justify-center rounded-lg border border-slate-200 bg-slate-50 text-slate-300 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-600">
                                                @((MarkupString)Icons.DeleteSVG)
                                            </button>
                                            <span role="tooltip"
                                                  class="pointer-events-none absolute bottom-full right-0 z-[80] mb-1 w-56 rounded-md bg-slate-800 px-2.5 py-1.5 text-xs font-normal leading-snug text-white opacity-0 shadow-lg transition-opacity duration-150 group-hover:opacity-100 group-focus-within:opacity-100 dark:bg-slate-700">
                                                Systemavdelning kan inte ändras.
                                            </span>
                                        </span>
                                    </div>
                                </td>
                            </tr>

                            @foreach (var department in PagedDepartments)
                            {
                                <tr class="transition hover:bg-slate-50 dark:hover:bg-slate-800/40">
                                    <td class="border-b border-slate-100 px-3 py-1.5 align-top dark:border-slate-800">
                                        <div class="flex items-start gap-2">
                                            <div class="flex h-6 w-6 shrink-0 items-center justify-center rounded-lg bg-emerald-100 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-300">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor">
                                                    <path d="M3 21h18v-2H3Zm2-4h4V9H5Zm5 0h4V3h-4Zm5 0h4v-6h-4Z" />
                                                </svg>
                                            </div>

                                            <div class="min-w-0">
                                                <button type="button"
                                                        class="inline-flex max-w-full items-center gap-1.5 text-left text-sm font-semibold text-slate-900 transition hover:text-blue-700 dark:text-slate-100 dark:hover:text-blue-300"
                                                        title="@department.Name"
                                                        @onclick="() => OpenDepartmentUsers(department.Id)">
                                                    @if (!string.IsNullOrWhiteSpace(department.Color))
                                                    {
                                                        <span class="inline-block h-2.5 w-2.5 shrink-0 rounded-full" style="background-color:@department.Color"></span>
                                                    }
                                                    <span class="truncate">@department.Name</span>
                                                </button>
                                                @if (!string.IsNullOrWhiteSpace(department.HeadUserName))
                                                {
                                                    <div class="truncate text-[11px] text-slate-500 dark:text-slate-400" title="@WebLoc["DepartmentHead"]: @department.HeadUserName">
                                                        @WebLoc["DepartmentHead"]: @department.HeadUserName
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </td>

                                    <td class="border-b border-slate-100 px-3 py-1.5 text-xs leading-5 text-slate-600 dark:border-slate-800 dark:text-slate-300">
                                        @if (string.IsNullOrWhiteSpace(department.Description))
                                        {
                                            <span>—</span>
                                        }
                                        else
                                        {
                                            <div class="truncate" title="@department.Description">@department.Description</div>
                                        }
                                    </td>

                                    <td class="border-b border-slate-100 px-3 py-1.5 dark:border-slate-800">
                                        <span class="inline-flex min-w-[32px] items-center justify-center rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-200">
                                            @department.UsersCount
                                        </span>
                                    </td>

                                    <td class="border-b border-slate-100 px-3 py-1.5 dark:border-slate-800">
                                        <span class="inline-flex min-w-[32px] items-center justify-center rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-200">
                                            @department.ProjectsCount
                                        </span>
                                    </td>

                                    <td class="border-b border-slate-100 px-3 py-1.5 dark:border-slate-800">
                                        <span class="inline-flex min-w-[32px] items-center justify-center rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-200">
                                            @department.CalculationsCount
                                        </span>
                                    </td>

                                    <td class="border-b border-slate-100 px-3 py-1.5 dark:border-slate-800">
                                        <div class="flex items-center justify-end gap-1.5">
                                            <button type="button"
                                                    title="@AppLoc[nameof(ResourceApp.update)]"
                                                    class="inline-flex h-7 w-7 items-center justify-center rounded-lg border border-amber-200 bg-amber-50 text-amber-700 transition hover:bg-amber-100 dark:border-amber-900/60 dark:bg-amber-950/30 dark:text-amber-300 dark:hover:bg-amber-950/50"
                                                    @onclick="() => OpenEditDepartment(department)">
                                                @((MarkupString)Icons.Edit)
                                            </button>

                                            <button type="button"
                                                    title="@AppLoc[nameof(ResourceApp.delete)]"
                                                    class="inline-flex h-7 w-7 items-center justify-center rounded-lg border border-rose-200 bg-rose-50 text-rose-700 transition hover:bg-rose-100 dark:border-rose-900/60 dark:bg-rose-950/30 dark:text-rose-300 dark:hover:bg-rose-950/50"
                                                    @onclick="() => AskRemoveDepartment(department)">
                                                @((MarkupString)Icons.DeleteSVG)
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @* Sticky pager pinned to the bottom of the table container. *@
                <div class="flex shrink-0 flex-wrap items-center gap-3 border-t border-slate-200 bg-slate-50 px-3 py-1.5 text-xs text-slate-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300">
                    <button type="button"
                            class="inline-flex h-7 items-center rounded-lg border border-slate-300 px-2.5 font-medium text-slate-700 transition hover:bg-white disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-900"
                            disabled="@(CurrentPage <= 1)"
                            @onclick="() => GoToPage(CurrentPage - 1)">
                        @WebLoc["Previous"]
                    </button>
                    <button type="button"
                            class="inline-flex h-7 items-center rounded-lg border border-slate-300 px-2.5 font-medium text-slate-700 transition hover:bg-white disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-900"
                            disabled="@(CurrentPage >= TotalPages)"
                            @onclick="() => GoToPage(CurrentPage + 1)">
                        @WebLoc["Next"]
                    </button>
                    <span>@(string.Format(WebLoc["PageOfFormat"].Value, Math.Min(CurrentPage, TotalPages), TotalPages))</span>
                    <div class="ml-auto flex items-center gap-2">
                        <span class="text-slate-500 dark:text-slate-400">Rader per sida</span>
                        <AppSelect TValue="int"
                                   Options="PageSizeOptions"
                                   Value="PageSize"
                                   ValueChanged="SetPageSize" />
                    </div>
                </div>
            </section>

            <!-- Mobile / tablet cards -->
            <section class="grid min-h-0 flex-1 auto-rows-min gap-1.5 overflow-y-auto md:grid-cols-2 lg:hidden">
                <div class="rounded-lg border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
                    <div class="border-b border-slate-200 px-2.5 py-2 dark:border-slate-800">
                        <div class="text-sm font-semibold text-slate-900 dark:text-slate-100">
                            @ResourceIdentity.Admin
                        </div>
                        <div class="text-xs text-slate-500 dark:text-slate-400">
                            @WebLoc["AdminUsersDescription"]
                        </div>
                    </div>

                    <div class="space-y-2 px-2.5 py-2">
                        <div class="flex items-center justify-between text-xs">
                            <span class="text-slate-500 dark:text-slate-400">@WebLoc["UsersLabel"]</span>
                            <span class="rounded-full bg-blue-100 px-2 py-0.5 text-[11px] font-medium text-blue-700 dark:bg-blue-950/40 dark:text-blue-300">
                                Systemavdelning
                            </span>
                        </div>

                        <div class="flex flex-wrap gap-1.5">
                            <button type="button"
                                    class="inline-flex items-center rounded-lg px-2 py-1 text-xs font-medium text-blue-700 transition hover:bg-blue-50 dark:text-blue-300 dark:hover:bg-blue-950/30"
                                    @onclick="OpenUsersWithoutDepartment">
                                @WebLoc["OpenUsersWithoutDepartment"]
                            </button>
                        </div>
                    </div>
                </div>

                @foreach (var department in PagedDepartments)
                {
                    <div class="h-full rounded-lg border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
                        <div class="border-b border-slate-200 px-2.5 py-2 dark:border-slate-800">
                            <div class="flex items-start justify-between gap-2">
                                <div class="min-w-0">
                                    <button type="button"
                                            class="inline-flex items-center gap-1.5 text-left text-sm font-semibold text-slate-900 transition hover:text-blue-700 dark:text-slate-100 dark:hover:text-blue-300"
                                            @onclick="() => OpenDepartmentUsers(department.Id)">
                                        @if (!string.IsNullOrWhiteSpace(department.Color))
                                        {
                                            <span class="inline-block h-2.5 w-2.5 shrink-0 rounded-full" style="background-color:@department.Color"></span>
                                        }
                                        <span class="truncate">@department.Name</span>
                                    </button>
                                    @if (!string.IsNullOrWhiteSpace(department.HeadUserName))
                                    {
                                        <div class="text-[11px] text-slate-500 dark:text-slate-400">
                                            @WebLoc["DepartmentHead"]: @department.HeadUserName
                                        </div>
                                    }
                                </div>

                                <div class="shrink-0 rounded-full bg-emerald-100 px-2 py-0.5 text-[11px] font-medium text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-300">
                                    @WebLoc["DepartmentBadge"]
                                </div>
                            </div>
                        </div>

                        <div class="space-y-2 px-2.5 py-2">
                            <div>
                                <div class="text-[10px] font-semibold tracking-wide text-slate-500 dark:text-slate-400">
                                    Intern notering
                                </div>
                                <div class="text-xs text-slate-700 dark:text-slate-300">
                                    @(string.IsNullOrWhiteSpace(department.Description) ? "—" : department.Description)
                                </div>
                            </div>

                            <div class="grid grid-cols-3 gap-1.5">
                                <div class="rounded-lg bg-slate-50 px-2 py-1.5 dark:bg-slate-800/60">
                                    <div class="text-[11px] text-slate-500 dark:text-slate-400">@WebLoc["UsersLabel"]</div>
                                    <div class="text-base font-semibold text-slate-900 dark:text-slate-100">
                                        @department.UsersCount
                                    </div>
                                </div>

                                <div class="rounded-lg bg-slate-50 px-2 py-1.5 dark:bg-slate-800/60">
                                    <div class="text-[11px] text-slate-500 dark:text-slate-400">@CalcResource.project</div>
                                    <div class="text-base font-semibold text-slate-900 dark:text-slate-100">
                                        @department.ProjectsCount
                                    </div>
                                </div>

                                <div class="rounded-lg bg-slate-50 px-2 py-1.5 dark:bg-slate-800/60">
                                    <div class="text-[11px] text-slate-500 dark:text-slate-400">@CalcResource.calculation</div>
                                    <div class="text-base font-semibold text-slate-900 dark:text-slate-100">
                                        @department.CalculationsCount
                                    </div>
                                </div>
                            </div>

                            <div class="flex flex-wrap items-center gap-1.5">
                                <button type="button"
                                        class="inline-flex h-7 w-7 items-center justify-center rounded-lg border border-amber-200 bg-amber-50 text-amber-700 transition hover:bg-amber-100 dark:border-amber-900/60 dark:bg-amber-950/30 dark:text-amber-300 dark:hover:bg-amber-950/50"
                                        title="@AppLoc[nameof(ResourceApp.update)]"
                                        @onclick="() => OpenEditDepartment(department)">
                                    @((MarkupString)Icons.Edit)
                                </button>

                                <button type="button"
                                        class="inline-flex h-7 w-7 items-center justify-center rounded-lg border border-rose-200 bg-rose-50 text-rose-700 transition hover:bg-rose-100 dark:border-rose-900/60 dark:bg-rose-950/30 dark:text-rose-300 dark:hover:bg-rose-950/50"
                                        title="@AppLoc[nameof(ResourceApp.delete)]"
                                        @onclick="() => AskRemoveDepartment(department)">
                                    @((MarkupString)Icons.DeleteSVG)
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </section>

            @* Mobile-only pager (the desktop table has its own sticky pager). *@
            <div class="flex shrink-0 flex-wrap items-center gap-3 rounded-xl border border-slate-200 bg-white px-3 py-1.5 text-xs shadow-sm dark:border-slate-800 dark:bg-slate-900 lg:hidden">
                <button type="button"
                        class="inline-flex h-7 items-center rounded-lg border border-slate-300 px-2.5 font-medium text-slate-700 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-800"
                        disabled="@(CurrentPage <= 1)"
                        @onclick="() => GoToPage(CurrentPage - 1)">
                    @WebLoc["Previous"]
                </button>
                <button type="button"
                        class="inline-flex h-7 items-center rounded-lg border border-slate-300 px-2.5 font-medium text-slate-700 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-800"
                        disabled="@(CurrentPage >= TotalPages)"
                        @onclick="() => GoToPage(CurrentPage + 1)">
                    @WebLoc["Next"]
                </button>
                <span class="text-slate-600 dark:text-slate-300">
                    @(string.Format(WebLoc["PageOfFormat"].Value, Math.Min(CurrentPage, TotalPages), TotalPages))
                </span>
                <div class="ml-auto flex items-center gap-2">
                    <span class="text-slate-500 dark:text-slate-400">Rader per sida</span>
                    <AppSelect TValue="int"
                               Options="PageSizeOptions"
                               Value="PageSize"
                               ValueChanged="SetPageSize" />
                </div>
            </div>
        }
        else
        {
            <section class="shrink-0 rounded-xl border border-dashed border-slate-300 bg-white px-4 py-8 text-center shadow-sm dark:border-slate-700 dark:bg-slate-900">
                <div class="mx-auto flex h-10 w-10 items-center justify-center rounded-xl bg-slate-100 dark:bg-slate-800">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-slate-500 dark:text-slate-400" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M3 21h18v-2H3Zm2-4h4V9H5Zm5 0h4V3h-4Zm5 0h4v-6h-4Z" />
                    </svg>
                </div>

                <h3 class="mt-2 text-sm font-semibold text-slate-900 dark:text-slate-100">
                    @WebLoc["DepartmentsTitle"]
                </h3>

                <p class="mx-auto mt-1 max-w-md text-xs leading-5 text-slate-500 dark:text-slate-400">
                    @WebLoc["NoDepartmentsMessage"]
                </p>

                <div class="mt-3">
                    <button type="button"
                            class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-emerald-600 px-3 py-1.5 text-xs font-semibold text-white shadow-sm transition hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-500/40 dark:bg-emerald-500 dark:hover:bg-emerald-400"
                            @onclick="OpenCreateDepartment">
                        @((MarkupString)Icons.PlusSVG)
                        <span>@WebLoc["NewDepartment"]</span>
                    </button>
                </div>
            </section>
        }
    </div>
}
