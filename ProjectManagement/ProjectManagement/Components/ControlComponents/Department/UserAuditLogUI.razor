@using Microsoft.Extensions.Localization
@using ProjectManagement.Services.UI
@using ProjectManagement.Shared
@using ProjectManagement.Shared.Constant
@using ProjectManagement.Shared.DTO.General
@using Application.Feature.Identity.Department.Queries
@inherits AppComponentBase
@implements IDisposable
@inject IUserManagementAuditService UserAuditService
@inject IStringLocalizer<PMWebResource> WebLoc

@* User activity log rendered as the Aktivitetslogg tab under "Avdelningar & användare". *@
<div class="flex h-full min-h-0 flex-col gap-2 p-0.5">
    <div class="relative flex shrink-0 flex-wrap items-center gap-3 rounded-xl border border-slate-200 bg-white px-3 py-2 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <div class="min-w-0">
            <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">Aktivitetslogg</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400">Senaste administrativa ändringar för företagsanvändare och företagsprofil.</p>
        </div>
        <div class="ml-auto flex min-w-[18rem] flex-1 items-center justify-end gap-2">
            <div class="relative min-w-0 flex-1 sm:max-w-sm">
                <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-slate-400">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                </span>
                <input type="search"
                       placeholder="Sök i aktivitetslogg..."
                       @bind="SearchTerm"
                       @bind:event="oninput"
                       class="h-8 w-full rounded-lg border border-slate-300 bg-white pl-9 pr-3 text-xs text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" />
            </div>
            <span class="hidden whitespace-nowrap rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-300 sm:inline-flex">
                Visar @FilteredEntries.Count av @Entries.Count
            </span>
            <button type="button"
                    disabled="@IsLoading"
                    title="Uppdatera aktivitetslogg"
                    aria-label="Uppdatera aktivitetslogg"
                    class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-slate-300 text-slate-700 transition hover:bg-slate-50 disabled:opacity-60 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-800"
                    @onclick="RefreshAsync">
                <svg class="h-4 w-4 @(IsLoading ? "animate-spin" : string.Empty)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12a9 9 0 0 1-15.5 6.2"/><path d="M3 12A9 9 0 0 1 18.5 5.8"/><path d="M18 2v4h4"/><path d="M6 22v-4H2"/></svg>
            </button>
        </div>
        @if (_justRefreshed)
        {
            <div class="pointer-events-none absolute right-3 top-full z-20 mt-1 inline-flex items-center gap-1 rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-[11px] font-medium text-emerald-700 shadow-sm dark:border-emerald-900/60 dark:bg-emerald-950 dark:text-emerald-300">
                <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                Uppdaterat!
            </div>
        }
    </div>

    @if (IsLoading)
    {
        <MhdLoading />
    }
    else if (!string.IsNullOrWhiteSpace(LoadError))
    {
        <div class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800 dark:border-amber-900/60 dark:bg-amber-950/30 dark:text-amber-200">
            @WebLoc["AuditTemporarilyUnavailable"]
        </div>
    }
    else if (Entries.Count == 0)
    {
        <div class="rounded-lg border border-dashed border-slate-300 px-4 py-6 text-center text-sm text-slate-500 dark:border-slate-700 dark:text-slate-400">
            @WebLoc["NoAuditEntries"]
        </div>
    }
    else if (FilteredEntries.Count == 0)
    {
        <div class="rounded-lg border border-dashed border-slate-300 px-4 py-6 text-center text-sm text-slate-500 dark:border-slate-700 dark:text-slate-400">
            Inga resultat matchar din sökning.
        </div>
    }
    else
    {
        @* Only the log rows scroll; the header stays pinned. *@
        <div class="min-h-0 flex-1 overflow-auto rounded-lg border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-900">
            <table class="w-full min-w-[720px] border-separate border-spacing-0 text-sm">
                <thead class="sticky top-0 z-10">
                    <tr>
                        <th class="@HeaderClass">
                            <button type="button" class="inline-flex items-center gap-1 hover:text-slate-700 dark:hover:text-slate-200" @onclick="() => SortBy(AuditSortColumn.Time)">
                                Tidpunkt @(SortArrow(AuditSortColumn.Time))
                            </button>
                        </th>
                        <th class="@HeaderClass">
                            <button type="button" class="inline-flex items-center gap-1 hover:text-slate-700 dark:hover:text-slate-200" @onclick="() => SortBy(AuditSortColumn.Action)">
                                Åtgärd @(SortArrow(AuditSortColumn.Action))
                            </button>
                        </th>
                        <th class="@HeaderClass">
                            <button type="button" class="inline-flex items-center gap-1 hover:text-slate-700 dark:hover:text-slate-200" @onclick="() => SortBy(AuditSortColumn.Target)">
                                Mål @(SortArrow(AuditSortColumn.Target))
                            </button>
                        </th>
                        <th class="@HeaderClass">
                            <button type="button" class="inline-flex items-center gap-1 hover:text-slate-700 dark:hover:text-slate-200" @onclick="() => SortBy(AuditSortColumn.Actor)">
                                Utförd av @(SortArrow(AuditSortColumn.Actor))
                            </button>
                        </th>
                        <th class="@HeaderClass">
                            <button type="button" class="inline-flex items-center gap-1 hover:text-slate-700 dark:hover:text-slate-200" @onclick="() => SortBy(AuditSortColumn.Change)">
                                Ändring @(SortArrow(AuditSortColumn.Change))
                            </button>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in SortedEntries)
                    {
                        var change = GetChangeText(entry);
                        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
                            <td class="whitespace-nowrap border-b border-slate-100 px-3 py-2 text-slate-500 dark:border-slate-800 dark:text-slate-400">@entry.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="whitespace-nowrap border-b border-slate-100 px-3 py-2 font-medium text-slate-800 dark:border-slate-800 dark:text-slate-100">@GetActionLabel(entry.Action)</td>
                            <td class="border-b border-slate-100 px-3 py-2 text-slate-700 dark:border-slate-800 dark:text-slate-200">@entry.TargetDisplayName</td>
                            <td class="border-b border-slate-100 px-3 py-2 text-slate-600 dark:border-slate-800 dark:text-slate-300">@entry.ActorDisplayName</td>
                            <td class="max-w-sm truncate border-b border-slate-100 px-3 py-2 text-slate-500 dark:border-slate-800 dark:text-slate-400" title="@change">@change</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private enum AuditSortColumn { Time, Action, Target, Actor, Change }

    private const string HeaderClass =
        "border-b border-slate-200 bg-slate-50 px-3 py-2 text-left text-xs font-semibold text-slate-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-400";

    private IReadOnlyList<UserManagementAuditItem> Entries { get; set; } = [];
    private Dictionary<int, string> DepartmentNames { get; set; } = [];
    private bool IsLoading = true;
    private string? LoadError;
    private string SearchTerm { get; set; } = string.Empty;

    private AuditSortColumn SortColumn = AuditSortColumn.Time;
    private bool SortDescending = true;

    private bool _justRefreshed;
    private CancellationTokenSource? _statusCts;

    protected override async Task OnInitializedAsync()
        => await LoadAsync();

    /// <summary>Reloads the log and shows a short "Uppdaterat!" confirmation next to the button.</summary>
    private async Task RefreshAsync()
    {
        await LoadAsync();

        if (!string.IsNullOrWhiteSpace(LoadError))
            return;

        // Show "Uppdaterat!" briefly, then fade it away. No modal for the happy path.
        _statusCts?.Cancel();
        _statusCts?.Dispose();
        _statusCts = new CancellationTokenSource();
        var token = _statusCts.Token;

        _justRefreshed = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            await Task.Delay(TimeSpan.FromSeconds(3), token);
            _justRefreshed = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException)
        {
        }
    }

    private async Task LoadAsync()
    {
        IsLoading = true;
        LoadError = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            // Department names are needed to translate legacy "Department: <id>" details.
            try
            {
                var departments = await Dispatcher.Send(new GetDepartmentsAsListQuery());
                DepartmentNames = (departments ?? [])
                    .Where(d => !string.IsNullOrWhiteSpace(d.Name))
                    .ToDictionary(d => d.Id, d => d.Name!);
            }
            catch
            {
                // The log itself is still useful without name resolution.
            }

            Entries = await UserAuditService.GetRecentAsync(50);
        }
        catch (Exception ex)
        {
            Entries = [];
            LoadError = ex.Message;
        }
        finally
        {
            IsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private IReadOnlyList<UserManagementAuditItem> FilteredEntries
    {
        get
        {
            if (string.IsNullOrWhiteSpace(SearchTerm))
                return Entries;

            var term = SearchTerm.Trim();
            return Entries.Where(e =>
                    e.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm").Contains(term, StringComparison.OrdinalIgnoreCase)
                    || GetActionLabel(e.Action).Contains(term, StringComparison.OrdinalIgnoreCase)
                    || (!string.IsNullOrWhiteSpace(e.TargetDisplayName) && e.TargetDisplayName.Contains(term, StringComparison.OrdinalIgnoreCase))
                    || (!string.IsNullOrWhiteSpace(e.ActorDisplayName) && e.ActorDisplayName.Contains(term, StringComparison.OrdinalIgnoreCase))
                    || GetChangeText(e).Contains(term, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private IReadOnlyList<UserManagementAuditItem> SortedEntries
    {
        get
        {
            IEnumerable<UserManagementAuditItem> ordered = SortColumn switch
            {
                AuditSortColumn.Action => Order(e => GetActionLabel(e.Action)),
                AuditSortColumn.Target => Order(e => e.TargetDisplayName ?? string.Empty),
                AuditSortColumn.Actor => Order(e => e.ActorDisplayName ?? string.Empty),
                AuditSortColumn.Change => Order(e => GetChangeText(e)),
                _ => SortDescending
                    ? FilteredEntries.OrderByDescending(e => e.CreatedAtUtc)
                    : FilteredEntries.OrderBy(e => e.CreatedAtUtc),
            };

            return ordered.ToList();
        }
    }

    private IEnumerable<UserManagementAuditItem> Order(Func<UserManagementAuditItem, string> key)
        => SortDescending
            ? FilteredEntries.OrderByDescending(key, StringComparer.CurrentCultureIgnoreCase)
            : FilteredEntries.OrderBy(key, StringComparer.CurrentCultureIgnoreCase);

    private void SortBy(AuditSortColumn column)
    {
        if (SortColumn == column)
        {
            SortDescending = !SortDescending;
        }
        else
        {
            SortColumn = column;
            // Time defaults to newest-first; text columns default to A→Z.
            SortDescending = column == AuditSortColumn.Time;
        }
    }

    private MarkupString SortArrow(AuditSortColumn column)
        => SortColumn == column
            ? (MarkupString)(SortDescending ? "↓" : "↑")
            : (MarkupString)"<span class=\"text-slate-300 dark:text-slate-500\">↕</span>";

    private string GetActionLabel(string action) => action switch
    {
        "user.created" => WebLoc["AuditUserCreated"].Value,
        "user.registered" => WebLoc["AuditUserRegistered"].Value,
        "user.auth-recreated" => WebLoc["AuditAuthRecreated"].Value,
        "user.updated" => WebLoc["AuditUserUpdated"].Value,
        "user.unregistered" => WebLoc["AuditUserUnregistered"].Value,
        "user.deleted" => WebLoc["AuditUserDeleted"].Value,
        "user.password-reset" => WebLoc["AuditPasswordReset"].Value,
        "user.locked" => WebLoc["AuditUserLocked"].Value,
        "user.unlocked" => WebLoc["AuditUserUnlocked"].Value,
        "user.deactivated" => WebLoc["AuditUserDeactivated"].Value,
        "user.activated" => WebLoc["AuditUserActivated"].Value,
        "user.department-changed" => WebLoc["AuditDepartmentChanged"].Value,
        "user.role-changed" => WebLoc["AuditRoleChanged"].Value,
        // Företagsprofil — skrivs alltid med svenska detaljer, så etiketterna hårdkodas här.
        "company.profile-created" => "Företagsprofil skapad",
        "company.name-changed" => "Företagsnamn ändrat",
        "company.name-change-blocked" => "Namnbyte stoppat",
        "company.orgnumber-set" => "Organisationsnummer registrerat",
        "company.orgnumber-change-blocked" => "Ändring av org.nr blockerad",
        "company.logo-updated" => "Logotyp uppdaterad",
        "company.logo-restored" => "Logotyp återställd",
        "company.logo-change-blocked" => "Logotypbyte stoppat",
        "company.contact-updated" => "Kontaktuppgifter ändrade",
        "company.report-texts-updated" => "Rapporttexter ändrade",
        _ => action
    };

    /// <summary>
    /// Human-readable Swedish change text. New entries are already written in Swedish with
    /// names; legacy entries such as "Role: TenantUser; Department: 3" are translated here so
    /// no technical role values or department ids ever reach the UI.
    /// </summary>
    private string GetChangeText(UserManagementAuditItem entry)
    {
        if (string.IsNullOrWhiteSpace(entry.Details))
            return entry.Action switch
            {
                "user.locked" => "Användaren spärrades tills vidare",
                "user.unlocked" => "Användaren kan logga in igen",
                "user.deleted" => "Användaren togs bort",
                "user.unregistered" => "Inloggningen togs bort",
                "user.auth-recreated" => "Ny inloggning skapades",
                "user.password-reset" => "Nytt tillfälligt lösenord skickades",
                "user.deactivated" => "Kontot inaktiverades",
                "user.activated" => "Kontot aktiverades",
                "user.registered" => "Bekräftelsemail skickades",
                _ => "—"
            };

        var parts = entry.Details
            .Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(part => HumanizePart(part, entry.Action))
            .Where(part => !string.IsNullOrWhiteSpace(part));

        var text = string.Join("; ", parts);
        return string.IsNullOrWhiteSpace(text) ? "—" : text;
    }

    private string HumanizePart(string part, string action)
    {
        // Both the current prefix ("Behörighet ändrad från …") and the legacy one ("Roll ändrad från …").
        foreach (var roleChangedPrefix in new[] { "Behörighet ändrad från ", "Roll ändrad från " })
        {
            if (!part.StartsWith(roleChangedPrefix, StringComparison.OrdinalIgnoreCase))
                continue;

            var value = part[roleChangedPrefix.Length..].Trim();
            var pieces = value.Split(" till ", 2, StringSplitOptions.TrimEntries);
            if (pieces.Length == 2)
                return $"Från: {RoleLabel(pieces[0])} → Till: {RoleLabel(pieces[1])}";
        }

        const string movedPrefix = "Flyttad från ";
        if (part.StartsWith(movedPrefix, StringComparison.OrdinalIgnoreCase))
        {
            var value = part[movedPrefix.Length..].Trim();
            var pieces = value.Split(" till ", 2, StringSplitOptions.TrimEntries);
            if (pieces.Length == 2)
                return $"Från: {pieces[0]} → Till: {pieces[1]}";
        }

        if (string.Equals(part, "Spärren togs bort", StringComparison.OrdinalIgnoreCase))
            return "Användaren kan logga in igen";

        if (string.Equals(part, "Användaren spärrades tills vidare", StringComparison.OrdinalIgnoreCase))
            return "Spärrad tills vidare";

        // Role — the English legacy prefix ("Role:") and the older Swedish ones ("Roll:", "Behörighet:").
        foreach (var prefix in new[] { "Role:", "Roll:", "Behörighet:" })
        {
            if (part.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
            {
                var label = RoleLabel(part[prefix.Length..].Trim());
                return action == "user.role-changed" ? $"Ny behörighet: {label}" : $"Behörighet: {label}";
            }
        }

        // Department id from the English legacy prefix ("Department: 3" / "Department: None").
        if (part.StartsWith("Department:", StringComparison.OrdinalIgnoreCase))
        {
            var value = part["Department:".Length..].Trim();

            if (string.Equals(value, "None", StringComparison.OrdinalIgnoreCase))
                return action == "user.department-changed"
                    ? "Flyttad till Användare utan avdelning"
                    : "Ingen avdelning";

            var name = int.TryParse(value, out var id) && DepartmentNames.TryGetValue(id, out var resolved)
                ? resolved
                : null;

            if (name is null)
                return "Avdelning ändrad";

            return action == "user.department-changed" ? $"Flyttad till {name}" : $"Ny avdelning: {name}";
        }

        // Swedish "Avdelning: Kalkyl" (no old value) → clearer "Ny avdelning: Kalkyl".
        if (part.StartsWith("Avdelning:", StringComparison.OrdinalIgnoreCase))
        {
            var value = part["Avdelning:".Length..].Trim();
            return string.IsNullOrWhiteSpace(value) ? part : $"Ny avdelning: {value}";
        }

        // Already-Swedish full sentences (e.g. "Flyttad från Ledning till Kalkyl") pass through.
        return part;
    }

    /// <summary>Swedish permission label for legacy technical role values, matching the rest of the UI.</summary>
    private static string RoleLabel(string role) => PermissionDisplay.Label(role);

    public void Dispose()
    {
        _statusCts?.Cancel();
        _statusCts?.Dispose();
    }
}
