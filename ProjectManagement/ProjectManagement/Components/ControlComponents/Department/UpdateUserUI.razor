@using Domain.DTO.User
@using ProjectManagement.Client.Shared.Constants
@using ProjectManagement.Shared
@inherits AppComponentBase

@if (IsLoading)
{
    <div class="rounded-xl border border-slate-200 bg-white p-3 shadow-sm dark:border-slate-700 dark:bg-slate-900">
        <MhdLoading />
    </div>
}
else if (Form is not null)
{
    <div class="space-y-2.5">
        <div class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-xs text-slate-600 dark:border-slate-700 dark:bg-slate-800/70 dark:text-slate-300">
            @if (UserForm.Id == 0)
            {
                <span>@WebLoc["RegisterUserHint"]</span>
            }
            else
            {
                <span>@WebLoc["EditUserHint"]</span>
            }
        </div>

        <EditForm Model="Form" OnValidSubmit="HandleSubmitAsync" id="@DialogFormId" class="space-y-2.5">
            <DataAnnotationsValidator />
            <ValidationSummary class="rounded-lg border border-rose-200 bg-rose-50 p-2 text-xs text-rose-700 dark:border-rose-900/60 dark:bg-rose-950/30 dark:text-rose-300" />

            <div class="grid gap-2.5 sm:grid-cols-2 lg:grid-cols-3">
                <div>
                    <label class="mb-0.5 block text-xs font-medium text-slate-700 dark:text-slate-200">@ResourceIdentity.firstname</label>
                    <InputText class="w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
                               @bind-Value="Form.Firstname"
                               disabled="@IsBusy" />
                    <ValidationMessage For="() => Form.Firstname" class="mt-0.5 block text-[11px] text-rose-600 dark:text-rose-300" />
                </div>

                <div>
                    <label class="mb-0.5 block text-xs font-medium text-slate-700 dark:text-slate-200">@ResourceIdentity.lastname</label>
                    <InputText class="w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
                               @bind-Value="Form.Lastname"
                               disabled="@IsBusy" />
                    <ValidationMessage For="() => Form.Lastname" class="mt-0.5 block text-[11px] text-rose-600 dark:text-rose-300" />
                </div>

                <div>
                    <label class="mb-0.5 block text-xs font-medium text-slate-700 dark:text-slate-200">@ResourceIdentity.email</label>
                    <InputText class="w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
                               @bind-Value="Form.Email"
                               disabled="@IsBusy" />
                    <ValidationMessage For="() => Form.Email" class="mt-0.5 block text-[11px] text-rose-600 dark:text-rose-300" />
                </div>

                <div>
                    <label class="mb-0.5 block text-xs font-medium text-slate-700 dark:text-slate-200">@ResourceIdentity.phone</label>
                    <InputText class="w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
                               @bind-Value="Form.PhoneNumber"
                               disabled="@IsBusy" />
                    <ValidationMessage For="() => Form.PhoneNumber" class="mt-0.5 block text-[11px] text-rose-600 dark:text-rose-300" />
                </div>

                <div>
                    <label class="mb-0.5 block text-xs font-medium text-slate-700 dark:text-slate-200">@PMResourceIdentity.role</label>
                    <InputSelect class="w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
                                 @bind-Value="Form.Role"
                                 disabled="@IsBusy">
                        <option value="@PMRolesConst.Tenant.Admin">@WebLoc["LevelManager"]</option>
                        <option value="@PMRolesConst.Tenant.Manger">@WebLoc["LevelUser"]</option>
                        <option value="@PMRolesConst.Tenant.User">@WebLoc["LevelGuest"]</option>
                    </InputSelect>
                </div>

                @if (Departments?.Any() == true && Form.Role != PMRolesConst.Tenant.Admin)
                {
                    <div>
                        <label class="mb-0.5 block text-xs font-medium text-slate-700 dark:text-slate-200">@ResourceIdentity.department</label>
                        <InputSelect class="w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
                                     @bind-Value="Form.DepartmentId"
                                     disabled="@IsBusy">
                            @foreach (var dep in Departments)
                            {
                                <option value="@dep.Id">@dep.Name</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => Form.DepartmentId" class="mt-0.5 block text-[11px] text-rose-600 dark:text-rose-300" />
                    </div>
                }

                <div>
                    <label class="mb-0.5 block text-xs font-medium text-slate-700 dark:text-slate-200">@PMResourceIdentity.lockoutStart</label>
                    <div class="flex items-center gap-1.5">
                        <InputDate class="w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
                                   @bind-Value="Form.LockoutStart"
                                   disabled="@IsBusy" />
                        <button class="inline-flex items-center justify-center rounded-lg border border-rose-300 bg-rose-50 px-2.5 py-1.5 text-xs font-medium text-rose-700 transition hover:bg-rose-100 disabled:cursor-not-allowed disabled:opacity-60 dark:border-rose-900/60 dark:bg-rose-950/30 dark:text-rose-300 dark:hover:bg-rose-950/50"
                                type="button"
                                disabled="@IsBusy"
                                @onclick="ClearLockoutStart">
                            @((MarkupString)Icons.DeleteSVG)
                        </button>
                    </div>
                    <ValidationMessage For="() => Form.LockoutStart" class="mt-0.5 block text-[11px] text-rose-600 dark:text-rose-300" />
                </div>

                <div>
                    <label class="mb-0.5 block text-xs font-medium text-slate-700 dark:text-slate-200">@PMResourceIdentity.lockoutEnd</label>
                    <div class="flex items-center gap-1.5">
                        <InputDate class="w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
                                   @bind-Value="Form.LockoutEnd"
                                   disabled="@IsBusy" />
                        <button class="inline-flex items-center justify-center rounded-lg border border-rose-300 bg-rose-50 px-2.5 py-1.5 text-xs font-medium text-rose-700 transition hover:bg-rose-100 disabled:cursor-not-allowed disabled:opacity-60 dark:border-rose-900/60 dark:bg-rose-950/30 dark:text-rose-300 dark:hover:bg-rose-950/50"
                                type="button"
                                disabled="@IsBusy"
                                @onclick="ClearLockoutEnd">
                            @((MarkupString)Icons.DeleteSVG)
                        </button>
                    </div>
                    <ValidationMessage For="() => Form.LockoutEnd" class="mt-0.5 block text-[11px] text-rose-600 dark:text-rose-300" />
                </div>

                <div class="flex items-center gap-1.5 rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1.5 dark:border-slate-700 dark:bg-slate-800/60">
                    <InputCheckbox class="h-3.5 w-3.5 rounded border-slate-300 text-blue-600 focus:ring-blue-500 dark:border-slate-600 dark:bg-slate-900"
                                   @bind-Value="Form.PhoneNumberConfirmed"
                                   disabled="@IsBusy" />
                    <label class="text-xs text-slate-700 dark:text-slate-200">@PMResourceIdentity.phoneNumberConfirmed</label>
                </div>

                <div class="flex items-center gap-1.5 rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1.5 dark:border-slate-700 dark:bg-slate-800/60">
                    <InputCheckbox class="h-3.5 w-3.5 rounded border-slate-300 text-blue-600 focus:ring-blue-500 dark:border-slate-600 dark:bg-slate-900"
                                   @bind-Value="Form.LockoutEnabled"
                                   disabled="@IsBusy" />
                    <label class="text-xs text-slate-700 dark:text-slate-200">@PMResourceIdentity.logout</label>
                </div>
            </div>
        </EditForm>

    </div>
}
