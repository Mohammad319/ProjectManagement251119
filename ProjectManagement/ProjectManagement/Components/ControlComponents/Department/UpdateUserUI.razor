@using Domain.DTO.User
@using ProjectManagement.Client.Shared.Constants
@using ProjectManagement.Client.Shared.SharedComponent
@using ProjectManagement.Shared
@inherits AppComponentBase

@if (IsLoading)
{
    <div class="rounded-xl border border-slate-200 bg-white p-3 shadow-sm dark:border-slate-700 dark:bg-slate-900">
        <MhdLoading />
    </div>
}
else if (Form is not null)
{
    <div class="space-y-2.5">
        <div class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-xs text-slate-600 dark:border-slate-700 dark:bg-slate-800/70 dark:text-slate-300">
            @if (UserForm.Id == 0)
            {
                <span>Skapa ett användarkonto och koppla användaren till rätt roll och avdelning.</span>
            }
            else
            {
                <span>@WebLoc["EditUserHint"]</span>
            }
        </div>

        @if (ValidationErrors.Count > 0)
        {
            <div class="rounded-lg border border-rose-200 bg-rose-50 p-2.5 text-xs text-rose-700 dark:border-rose-900/60 dark:bg-rose-950/30 dark:text-rose-300" role="alert">
                <ul class="list-inside list-disc space-y-0.5">
                    @foreach (var error in ValidationErrors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }

        <EditForm Model="Form" OnSubmit="HandleSubmitAsync" id="@DialogFormId" class="space-y-2.5">
            <div class="grid gap-2.5 sm:grid-cols-2 lg:grid-cols-3">
                <div>
                    <label class="mb-0.5 block text-xs font-medium text-slate-700 dark:text-slate-200">@ResourceIdentity.firstname <span class="text-rose-500">*</span></label>
                    <InputText class="w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
                               @bind-Value="Form.Firstname"
                               disabled="@IsBusy" />
                    @if (FieldError("firstname") is { } firstnameError)
                    {
                        <p class="mt-0.5 text-[11px] text-rose-600 dark:text-rose-300">@firstnameError</p>
                    }
                </div>

                <div>
                    <label class="mb-0.5 block text-xs font-medium text-slate-700 dark:text-slate-200">@ResourceIdentity.lastname <span class="text-rose-500">*</span></label>
                    <InputText class="w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
                               @bind-Value="Form.Lastname"
                               disabled="@IsBusy" />
                    @if (FieldError("lastname") is { } lastnameError)
                    {
                        <p class="mt-0.5 text-[11px] text-rose-600 dark:text-rose-300">@lastnameError</p>
                    }
                </div>

                <div>
                    <label class="mb-0.5 block text-xs font-medium text-slate-700 dark:text-slate-200">@ResourceIdentity.email <span class="text-rose-500">*</span></label>
                    <InputText class="w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
                               @bind-Value="Form.Email"
                               disabled="@IsBusy" />
                    @if (FieldError("email") is { } emailError)
                    {
                        <p class="mt-0.5 text-[11px] text-rose-600 dark:text-rose-300">@emailError</p>
                    }
                </div>

                <div>
                    <label class="mb-0.5 block text-xs font-medium text-slate-700 dark:text-slate-200">@ResourceIdentity.phone</label>
                    <InputText class="w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
                               @bind-Value="Form.PhoneNumber"
                               disabled="@IsBusy" />
                </div>

                <div>
                    <label class="mb-0.5 block text-xs font-medium text-slate-700 dark:text-slate-200">@PMResourceIdentity.role <span class="text-rose-500">*</span></label>
                    <MhdFormSelect TValue="string"
                                   Value="@Form.Role"
                                   ValueChanged="OnRoleChanged"
                                   Options="RoleOptions"
                                   Placeholder="Välj roll..."
                                   Disabled="@IsBusy" />
                    @if (FieldError("role") is { } roleError)
                    {
                        <p class="mt-0.5 text-[11px] text-rose-600 dark:text-rose-300">@roleError</p>
                    }
                </div>
            </div>

            @if (Departments?.Any() == true && Form.Role != PMRolesConst.Tenant.Admin)
            {
                <div>
                    <label class="mb-0.5 block text-xs font-medium text-slate-700 dark:text-slate-200">@ResourceIdentity.department <span class="text-rose-500">*</span></label>
                    <div class="max-h-44 overflow-y-auto rounded-lg border border-slate-300 bg-white p-1 dark:border-slate-700 dark:bg-slate-950">
                        @foreach (var dep in Departments)
                        {
                            var isChecked = SelectedDepartmentIds.Contains(dep.Id);
                            <label class="flex cursor-pointer items-center gap-2 rounded-md px-2 py-1.5 text-xs transition @(isChecked ? "bg-sky-50 font-medium text-sky-700 dark:bg-sky-950/40 dark:text-sky-300" : "text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800")">
                                <input type="checkbox"
                                       class="h-3.5 w-3.5 rounded border-slate-300 text-sky-600 focus:ring-sky-500 dark:border-slate-600 dark:bg-slate-900"
                                       checked="@isChecked"
                                       disabled="@IsBusy"
                                       @onchange="e => ToggleDepartment(dep.Id, (bool)(e.Value ?? false))" />
                                <span class="flex-1 truncate">@dep.Name</span>
                                @if (isChecked && PrimaryDepartmentId == dep.Id)
                                {
                                    <span class="shrink-0 rounded-full bg-sky-100 px-1.5 py-0.5 text-[10px] font-semibold text-sky-700 dark:bg-sky-900/50 dark:text-sky-300">Primär</span>
                                }
                            </label>
                        }
                    </div>
                    <p class="mt-0.5 text-[11px] text-slate-400 dark:text-slate-500">Välj en eller flera avdelningar. Den första valda blir användarens primära avdelning.</p>
                    @if (FieldError("department") is { } departmentError)
                    {
                        <p class="mt-0.5 text-[11px] text-rose-600 dark:text-rose-300">@departmentError</p>
                    }
                </div>
            }

            <!-- Lockout -->
            <div class="rounded-lg border border-slate-200 bg-slate-50/60 p-2.5 dark:border-slate-700 dark:bg-slate-800/40">
                <div class="mb-2 flex flex-wrap items-center gap-4">
                    <label class="inline-flex cursor-pointer items-center gap-1.5 text-xs font-medium text-slate-700 dark:text-slate-200">
                        <InputCheckbox class="h-3.5 w-3.5 rounded border-slate-300 text-blue-600 focus:ring-blue-500 dark:border-slate-600 dark:bg-slate-900"
                                       @bind-Value="Form.LockoutEnabled"
                                       disabled="@IsBusy" />
                        <span>@WebLoc["Lockout"]</span>
                    </label>

                    <label class="inline-flex cursor-pointer items-center gap-1.5 text-xs text-slate-700 dark:text-slate-200">
                        <input type="checkbox"
                               class="h-3.5 w-3.5 rounded border-slate-300 text-blue-600 focus:ring-blue-500 dark:border-slate-600 dark:bg-slate-900"
                               checked="@LockIndefinitely"
                               disabled="@IsBusy"
                               @onchange="e => ToggleIndefinite((bool)(e.Value ?? false))" />
                        <span>Tills vidare</span>
                    </label>
                </div>

                <div class="grid gap-2.5 sm:grid-cols-2">
                    <div>
                        <label class="mb-0.5 block text-xs font-medium text-slate-700 dark:text-slate-200">Spärr startar</label>
                        <div class="flex items-center gap-1.5">
                            <InputDate class="w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
                                       @bind-Value="Form.LockoutStart"
                                       disabled="@IsBusy" />
                            <button class="inline-flex items-center justify-center rounded-lg border border-rose-300 bg-rose-50 px-2.5 py-1.5 text-xs font-medium text-rose-700 transition hover:bg-rose-100 disabled:cursor-not-allowed disabled:opacity-60 dark:border-rose-900/60 dark:bg-rose-950/30 dark:text-rose-300 dark:hover:bg-rose-950/50"
                                    type="button"
                                    disabled="@IsBusy"
                                    title="@AppLoc[nameof(ResourceApp.delete)]"
                                    @onclick="ClearLockoutStart">
                                @((MarkupString)Icons.DeleteSVG)
                            </button>
                        </div>
                    </div>

                    @if (!LockIndefinitely)
                    {
                        <div>
                            <label class="mb-0.5 block text-xs font-medium text-slate-700 dark:text-slate-200">Spärr slutar</label>
                            <div class="flex items-center gap-1.5">
                                <InputDate class="w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
                                           @bind-Value="Form.LockoutEnd"
                                           disabled="@IsBusy" />
                                <button class="inline-flex items-center justify-center rounded-lg border border-rose-300 bg-rose-50 px-2.5 py-1.5 text-xs font-medium text-rose-700 transition hover:bg-rose-100 disabled:cursor-not-allowed disabled:opacity-60 dark:border-rose-900/60 dark:bg-rose-950/30 dark:text-rose-300 dark:hover:bg-rose-950/50"
                                        type="button"
                                        disabled="@IsBusy"
                                        title="@AppLoc[nameof(ResourceApp.delete)]"
                                        @onclick="ClearLockoutEnd">
                                    @((MarkupString)Icons.DeleteSVG)
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="flex items-end pb-1 text-[11px] text-slate-500 dark:text-slate-400">
                            Användaren är spärrad utan slutdatum.
                        </div>
                    }
                </div>
            </div>
        </EditForm>

    </div>
}
