@using Application.Feature.Identity.Department.Commands
@using Microsoft.AspNetCore.Components.Forms
@using ProjectManagement.Client.Shared.Constants
@using ProjectManagement.Client.Shared.ResourceFiles
@using ProjectManagement.Shared.DTO.Identity
@using ProjectManagement.Shared.Base.Users

@inject ICommandDispatcher MicroBus
@inject IStringLocalizer<ResourceApp> AppLoc

@if (editContext is not null)
{
    <EditForm EditContext="editContext"
              class="@CssClasses.Modal.Body"
              OnValidSubmit="HandleSubmitAsync">

        <div class="row g-3">
            <div class="col-12 col-md-6">
                <label class="@CssClasses.Form.Label">@CalcResource.name:</label>
                <InputText class="@CssClasses.Input.Text"
                           @bind-Value="departmentPost!.Name"
                           disabled="@IsSaving" />
                <ValidationMessage For="() => departmentPost!.Name" />
            </div>

            <div class="col-12 col-md-6">
                <label class="@CssClasses.Form.Label">@ResourceLoc.description:</label>
                <InputTextArea class="@CssClasses.Input.Text"
                               @bind-Value="departmentPost!.Description"
                               disabled="@IsSaving" />
                <ValidationMessage For="() => departmentPost!.Description" />
            </div>

            <div class="col-12 d-flex justify-content-end gap-2">
                <button type="submit" class="@CssClasses.Btn.Outline.Success" disabled="@IsSaving">
                    @ResourceApp.save
                </button>

                <button type="button" class="@CssClasses.Btn.Outline.Secondary" disabled="@IsSaving" @onclick="Close">
                    @ResourceApp.cancel
                </button>
            </div>
        </div>
    </EditForm>
}



@code {
    [Parameter] public EventCallback<bool> OnClickCallback { get; set; }
    [Parameter] public DepartmentDetailsDTO? DepartmentList { get; set; }

    private DepartmentBase? departmentPost;
    private EditContext? editContext;
    private bool IsSaving;

    private int _loadedId;
    private string? _loadedName;
    private string? _loadedDesc;

    protected override void OnParametersSet()
    {
        var id = DepartmentList?.Id ?? 0;
        var name = DepartmentList?.Name ?? string.Empty;
        var desc = DepartmentList?.Description;

        // لا تعيد تهيئة الموديل إذا نفس البيانات (حتى لا ينقطع/يرجع الإدخال)
        if (editContext is not null &&
            _loadedId == id &&
            _loadedName == name &&
            _loadedDesc == desc)
        {
            return;
        }

        _loadedId = id;
        _loadedName = name;
        _loadedDesc = desc;

        departmentPost = new DepartmentBase
        {
            Name = name,
            Description = desc
        };

        editContext = new EditContext(departmentPost);
    }

    private Task Close() => OnClickCallback.InvokeAsync(false);

    private async Task HandleSubmitAsync()
    {
        if (departmentPost is null) { await OnClickCallback.InvokeAsync(false); return; }
        if (IsSaving) return;

        IsSaving = true;
        try
        {
            departmentPost.Name = (departmentPost.Name ?? "").Trim();
            departmentPost.Description = departmentPost.Description?.Trim();

            if ((DepartmentList?.Id ?? 0) > 0)
            {
                var ok = await MicroBus.Send(new UpdateDepartmentCommand(DepartmentList!.Id, departmentPost));
                await OnClickCallback.InvokeAsync(ok);
                return;
            }

            var newId = await MicroBus.Send(new CreateDepartmentCommand(departmentPost));
            await OnClickCallback.InvokeAsync(newId > 0);
        }
        finally
        {
            IsSaving = false;
        }
    }
}
