@using Microsoft.AspNetCore.Components.Forms
@using ProjectManagement.Client.Shared.ResourceFiles
@inherits AppComponentBase

@if (editContext is not null)
{
    <div class="space-y-4">
        <div class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-600 dark:border-slate-700 dark:bg-slate-800/70 dark:text-slate-300">
            @if ((DepartmentList?.Id ?? 0) > 0)
            {
                <span>@WebLoc["EditDepartmentHint"]</span>
            }
            else
            {
                <span>@WebLoc["CreateDepartmentHint"]</span>
            }
        </div>

        <EditForm EditContext="editContext"
                  id="createDepartmentForm"
                  class="@CssClasses.Modal.Body"
                  OnValidSubmit="HandleSubmitAsync">
            <DataAnnotationsValidator />

            <div class="grid gap-4 md:grid-cols-2">
                <div>
                    <label class="@CssClasses.Form.Label">@CalcResource.name:</label>
                    <InputText class="@CssClasses.Input.Text"
                               @bind-Value="departmentPost!.Name"
                               disabled="@IsSaving" />
                    <ValidationMessage For="() => departmentPost!.Name" />
                </div>

                <div>
                    <label class="@CssClasses.Form.Label">@ResourceLoc.description:</label>
                    <InputTextArea class="@CssClasses.Input.Text"
                                   @bind-Value="departmentPost!.Description"
                                   disabled="@IsSaving" />
                    <ValidationMessage For="() => departmentPost!.Description" />
                </div>
            </div>
        </EditForm>
    </div>

    <div class="@CssClasses.Modal.Footer">
        <button type="submit" form="createDepartmentForm" class="@CssClasses.Btn.Outline.Success" disabled="@IsSaving">
            @AppLoc[nameof(ResourceApp.save)]
        </button>

        <button type="button" class="@CssClasses.Btn.Outline.Secondary" disabled="@IsSaving" @onclick="Close">
            @AppLoc[nameof(ResourceApp.cancel)]
        </button>
    </div>
}
