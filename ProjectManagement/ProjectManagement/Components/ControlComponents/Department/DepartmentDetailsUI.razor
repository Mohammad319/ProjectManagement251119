@inherits AppComponentBase

@using ProjectManagement.Shared.DTO.Identity
@using ProjectManagement.Client.Shared.Constants

@if (DepartmentList is null)
{
    <div class="@CssClasses.Modal.Body">
        <div class="text-muted">@ResourceApp.notFoundData</div>
        <div class="@CssClasses.Modal.Footer">
            <button type="button" class="@CssClasses.Btn.Outline.Secondary" @onclick="Back">
                @((MarkupString)Icons.Back)
            </button>
        </div>
    </div>
}
else
{
<div class="@CssClasses.Modal.Body">

    <div class="mb-3">
        <h5 class="mb-1">
            @AppLoc[nameof(ResourceApp.department)]
        </h5>
        <strong>@DepartmentList.Name</strong>
    </div>

    @if (!string.IsNullOrWhiteSpace(DepartmentList.Description))
    {
        <div class="mb-3">
            <label class="@CssClasses.Form.Label">
                @AppLoc[nameof(ResourceLoc.description)]
            </label>
            <div class="form-control bg-light">
                @DepartmentList.Description
            </div>
        </div>
    }

    <div class="d-flex justify-content-end gap-2 mt-3">
        <button class="@CssClasses.Btn.Outline.Secondary"
                @onclick="Back">
            @((MarkupString)Icons.Back)
        </button>
    </div>

</div>
}

@code {

    [Parameter, EditorRequired]
    public DepartmentDetailsDTO DepartmentList { get; set; } = default!;

    [Parameter]
    public EventCallback<bool> OnClickCallback { get; set; }

    private async Task Back()
    {
        if (OnClickCallback.HasDelegate)
            await OnClickCallback.InvokeAsync(false);
    }
}
