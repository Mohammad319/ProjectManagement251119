@inherits AppComponentBase

@using ProjectManagement.Shared.DTO.Identity
@using ProjectManagement.Client.Shared.Constants
@inject Microsoft.Extensions.Localization.IStringLocalizer<ProjectManagement.Shared.PMWebResource> WebLoc

@if (DepartmentList is null)
{
    <div class="space-y-2.5">
        <div class="rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-700 dark:border-amber-900/60 dark:bg-amber-950/30 dark:text-amber-300">
            @ResourceApp.notFoundData
        </div>

        <div class="flex justify-end">
            <button type="button"
                    class="inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
                    @onclick="Back">
                @((MarkupString)Icons.Back)
            </button>
        </div>
    </div>
}
else
{
    <div class="space-y-1.5">
        <div class="rounded-xl border border-slate-200 bg-white p-2.5 shadow-sm dark:border-slate-700 dark:bg-slate-900">
            <div class="mb-2">
                <div class="text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
                    @AppLoc[nameof(ResourceApp.department)]
                </div>
                <h3 class="text-base font-semibold text-slate-900 dark:text-slate-100">@DepartmentList.Name</h3>
            </div>

            @if (!string.IsNullOrWhiteSpace(DepartmentList.Description))
            {
                <div class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 dark:border-slate-700 dark:bg-slate-800/60">
                    <label class="mb-0.5 block text-xs font-medium text-slate-700 dark:text-slate-200">
                        @AppLoc[nameof(ResourceLoc.description)]
                    </label>
                    <div class="text-xs text-slate-600 dark:text-slate-300">
                        @DepartmentList.Description
                    </div>
                </div>
            }

            <dl class="mt-2 grid gap-1.5 sm:grid-cols-2 lg:grid-cols-4">
                <div class="rounded-lg bg-slate-50 px-3 py-2 dark:bg-slate-800/60">
                    <dt class="text-[11px] font-medium text-slate-500 dark:text-slate-400">@WebLoc["DepartmentHead"]</dt>
                    <dd class="font-semibold text-slate-900 dark:text-slate-100">@(DepartmentList.HeadUserName ?? WebLoc["NoHead"].Value)</dd>
                </div>
                <div class="rounded-lg bg-slate-50 px-3 py-2 dark:bg-slate-800/60">
                    <dt class="text-[11px] font-medium text-slate-500 dark:text-slate-400">@WebLoc["UsersLabel"]</dt>
                    <dd class="text-lg font-bold text-slate-900 dark:text-slate-100">@DepartmentList.UsersCount</dd>
                </div>
                <div class="rounded-lg bg-slate-50 px-3 py-2 dark:bg-slate-800/60">
                    <dt class="text-[11px] font-medium text-slate-500 dark:text-slate-400">@CalcResource.project</dt>
                    <dd class="text-lg font-bold text-slate-900 dark:text-slate-100">@DepartmentList.ProjectsCount</dd>
                </div>
                <div class="rounded-lg bg-slate-50 px-3 py-2 dark:bg-slate-800/60">
                    <dt class="text-[11px] font-medium text-slate-500 dark:text-slate-400">@WebLoc["FoldersLabel"]</dt>
                    <dd class="text-lg font-bold text-slate-900 dark:text-slate-100">@DepartmentList.FoldersCount</dd>
                </div>
            </dl>

            <div class="mt-2 text-[11px] text-slate-500 dark:text-slate-400">
                @WebLoc["CreatedLabel"]: @DepartmentList.Created.ToLocalTime().ToString("yyyy-MM-dd")
                @if (DepartmentList.LastModified.HasValue)
                {
                    <span class="mx-2">•</span>
                    <span>@WebLoc["UpdatedLabel"]: @DepartmentList.LastModified.Value.ToLocalTime().ToString("yyyy-MM-dd")</span>
                }
            </div>
        </div>

        <div class="flex justify-end">
            <button type="button"
                    class="inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
                    @onclick="Back">
                @((MarkupString)Icons.Back)
            </button>
        </div>
    </div>
}

@code {

    [Parameter, EditorRequired]
    public DepartmentDetailsDTO DepartmentList { get; set; } = default!;

    [Parameter]
    public EventCallback<bool> OnClickCallback { get; set; }

    private async Task Back()
    {
        if (OnClickCallback.HasDelegate)
            await OnClickCallback.InvokeAsync(false);
    }
}
