@inherits AppComponentBase

@using ProjectManagement.Shared.DTO.Identity
@using ProjectManagement.Client.Shared.Constants

@if (DepartmentList is null)
{
    <div class="space-y-4">
        <div class="rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-700 dark:border-amber-900/60 dark:bg-amber-950/30 dark:text-amber-300">
            @ResourceApp.notFoundData
        </div>

        <div class="flex justify-end">
            <button type="button"
                    class="inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
                    @onclick="Back">
                @((MarkupString)Icons.Back)
            </button>
        </div>
    </div>
}
else
{
    <div class="space-y-4">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-900">
            <div class="mb-4">
                <div class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
                    @AppLoc[nameof(ResourceApp.department)]
                </div>
                <h3 class="mt-1 text-lg font-semibold text-slate-900 dark:text-slate-100">@DepartmentList.Name</h3>
            </div>

            @if (!string.IsNullOrWhiteSpace(DepartmentList.Description))
            {
                <div class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 dark:border-slate-700 dark:bg-slate-800/60">
                    <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">
                        @AppLoc[nameof(ResourceLoc.description)]
                    </label>
                    <div class="text-sm text-slate-600 dark:text-slate-300">
                        @DepartmentList.Description
                    </div>
                </div>
            }
        </div>

        <div class="flex justify-end">
            <button type="button"
                    class="inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
                    @onclick="Back">
                @((MarkupString)Icons.Back)
            </button>
        </div>
    </div>
}

@code {

    [Parameter, EditorRequired]
    public DepartmentDetailsDTO DepartmentList { get; set; } = default!;

    [Parameter]
    public EventCallback<bool> OnClickCallback { get; set; }

    private async Task Back()
    {
        if (OnClickCallback.HasDelegate)
            await OnClickCallback.InvokeAsync(false);
    }
}
