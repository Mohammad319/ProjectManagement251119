@using Domain.Entities.Application
@using Microsoft.AspNetCore.Authorization
@using ProjectManagement.Client.Shared.Model.Application
@using ProjectManagement.Shared
@using ProjectManagement.Shared.Base.Application
@attribute [Authorize(Roles = PMRolesConst.Tenant.AdminManger)]
@using ProjectManagement.Client.Shared.ViewModel
@inherits AppComponentBase
@inject ICommandDispatcher MicroBus

<div class="space-y-4">
    @if (AttributeForm == null)
    {
        <nav class="overflow-x-auto">
            <div class="flex min-w-max space-x-2 border-b border-gray-300 pb-1 dark:border-gray-700" role="tablist">
                <button class="px-4 py-2 text-sm font-medium border-b-2 transition duration-150 ease-in-out
                       @(PartPage == 0 ? "border-blue-600 text-blue-600" : "border-transparent text-gray-500 hover:text-blue-600 hover:border-blue-300")"
                        @onclick="() => PartPage = 0">
                    @PMAppFormatResource.row
                </button>
                <button class="px-4 py-2 text-sm font-medium border-b-2 transition duration-150 ease-in-out
                       @(PartPage == 1 ? "border-blue-600 text-blue-600" : "border-transparent text-gray-500 hover:text-blue-600 hover:border-blue-300")"
                        @onclick="() => PartPage = 1">
                    @ResourceApp.text
                </button>
                <button class="px-4 py-2 text-sm font-medium border-b-2 transition duration-150 ease-in-out
                       @(PartPage == 2 ? "border-blue-600 text-blue-600" : "border-transparent text-gray-500 hover:text-blue-600 hover:border-blue-300")"
                        @onclick="() => PartPage = 2">
                    @PMAppFormatResource.cell
                </button>
                <button class="px-4 py-2 text-sm font-medium border-b-2 transition duration-150 ease-in-out
                       @(PartPage == 3 ? "border-blue-600 text-blue-600" : "border-transparent text-gray-500 hover:text-blue-600 hover:border-blue-300")"
                        @onclick="() => PartPage = 3">
                    @PMAppFormatResource.background
                </button>
                <button class="px-4 py-2 text-sm font-medium border-b-2 transition duration-150 ease-in-out
                       @(PartPage == 4 ? "border-blue-600 text-blue-600" : "border-transparent text-gray-500 hover:text-blue-600 hover:border-blue-300")"
                        @onclick="() => PartPage = 4">
                    @ResourceApp.parameter
                </button>
            </div>
        </nav>

        @if (Part == 0)
        {
            @if (PartPage == 0)
            {
                <EditForm id="rowForm" Model="@RowUpdate" OnValidSubmit="async () => await HandleSubmitAsync()">
                    <DataAnnotationsValidator />
                    <div class="col-span-12 md:col-span-3">
                        <div>
                            <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@CalcResource.name:</label>
                            <InputText class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind-Value="@RowUpdate.Name" />
                            <ValidationMessage For=@(() => RowUpdate.Name) />
                        </div>
                        <div>
                            <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceLoc.description:</label>
                            <InputText class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind-Value="@RowUpdate.Description" />
                            <ValidationMessage For=@(() => RowUpdate.Description) />
                        </div>
                        <div class="flex items-center gap-2 py-1">
                            <InputCheckbox class="h-4 w-4 rounded border-slate-300 text-sky-600 focus:ring-sky-500 dark:border-slate-600 dark:bg-slate-800" @bind-Value="RowUpdate.IsVisible" />
                                <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceApp.isVisible</label>
                                <ValidationMessage For=@(() => RowUpdate.IsVisible) />
                        </div>
                        <div>
                            <button type="submit" form="rowForm" disabled="@IsLoading" class="inline-flex items-center justify-center rounded-md border border-emerald-400 px-3 py-1.5 text-sm font-medium text-emerald-600 transition hover:bg-emerald-50 dark:border-emerald-700 dark:text-emerald-300 dark:hover:bg-emerald-900/30">@ResourceApp.save</button>
                            <button type="button" class="inline-flex items-center justify-center rounded-md border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-700 transition hover:bg-slate-50 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-800" @onclick="async ()=> await Callback.InvokeAsync(null)">@ResourceApp.cancel</button>
                        </div>
                    </div>
                </EditForm>
            }
            @if (PartPage == 1)
            {
                <div class="flex items-center gap-2">
                    <div>
                        <input type="color" class="h-10 w-full rounded-md border border-slate-300 bg-white p-1 dark:border-slate-600 dark:bg-slate-800" @bind="@Style.Color" @bind:after="updateStyle" />
                    </div>
                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@PMAppFormatResource.paddingTop</label>
                        <input type="number" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind="@Style.PaddingTop" @bind:after="updateStyle" />
                    </div>
                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@PMAppFormatResource.FontSize</label>
                        <input type="number" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind="@Style.FontSize" @bind:after="updateStyle" />
                    </div>
                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@PMAppFormatResource.alignItems </label>
                        <select @bind="@Style.TextAlign" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind:after="updateStyle">
                            <option value=""></option>
                            <option value="center">@PMAppFormatResource.center </option>
                            <option value="end">@PMAppFormatResource.right </option>
                            <option value="start">@ResourceApp.left </option>
                        </select>
                    </div>
                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@PMAppFormatResource.fontWeight </label>
                        <select @bind="@Style.FontWeight" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind:after="updateStyle">
                            <option value=""></option>
                            <option value="bold">@PMAppFormatResource.bold </option>
                            <option value="normal">@PMAppFormatResource.normal </option>
                            <option value="bolder">@AppFormatResource.bolder </option>
                        </select>
                    </div>
                </div>
            }
            else if (PartPage == 2)
            {
                <div class="flex items-center gap-2">
                    <div>
                        <input type="color" class="h-10 w-full rounded-md border border-slate-300 bg-white p-1 dark:border-slate-600 dark:bg-slate-800"
                        @bind="@Style.BackgroundColor" @bind:after="updateStyle" />
                    </div>
                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@PMAppFormatResource.width</label>
                        <input type="number" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind="Style.Width" @bind:after="updateStyle" />
                    </div>
                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceApp.height</label>
                        <input type="number" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind="@Style.Height" @bind:after="updateStyle" />
                    </div>
                </div>
            }
            else if (PartPage == 3)
            {
                <div class="flex items-center gap-2">
                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceApp.height:</label>
                        <input type="number" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind="@StyleRow.Height" @bind:after="updateStyle" />
                    </div>
                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceLoc.color:</label>
                        <input type="color" class="form-control form-control-color" @bind="StyleRow.BackgroundColor" @bind:after="updateStyle" />
                    </div>
                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@PMAppFormatResource.marginTop:</label>
                        <input type="number" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind="StyleRow.MarginTop" @bind:after="updateStyle" />
                    </div>
                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@PMAppFormatResource.marginBottom:</label>
                        <input type="number" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind="StyleRow.MarginBottom" @bind:after="updateStyle" />
                    </div>
                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@PMAppFormatResource.paddingLeft:</label>
                        <input type="number" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind="@StyleRow.PaddingLeft" @bind:after="updateStyle" />
                    </div>

                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@PMAppFormatResource.paddingTop:</label>
                        <input type="number" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind="@StyleRow.PaddingTop" @bind:after="updateStyle" />
                    </div>
                </div>

            }
            else if (PartPage == 4)
            {
                <div>
                    <button class="inline-flex items-center justify-center rounded-md bg-sky-600 px-3 py-1.5 text-sm font-medium text-white transition hover:bg-sky-700 dark:bg-sky-500 dark:hover:bg-sky-400" @onclick="()=> AttributeForm=new AttributeModel()">
                        @AppLoc[LocalizerConst.New, nameof(ResourceApp.attribute)]
                    </button>
                </div>
                <div>
                    <table class="min-w-full divide-y divide-slate-200 overflow-hidden rounded-lg border border-slate-200 text-sm dark:divide-slate-700 dark:border-slate-700 mt-1">
                        <thead class="bg-slate-50 dark:bg-slate-800/80">
                            <tr>
                                <th class="px-3 py-2 text-right text-sm font-semibold text-slate-600 dark:text-slate-200" style="width:100px;">@ResourceApp.attributeType</th>
                                <th class="px-3 py-2 text-right text-sm font-semibold text-slate-600 dark:text-slate-200" style="width:100px;">@ResourceApp.order </th>
                                <th class="px-3 py-2 text-right text-sm font-semibold text-slate-600 dark:text-slate-200" style="width:100px;">@ResourceApp.required</th>
                                <th class="px-3 py-2 text-right text-sm font-semibold text-slate-600 dark:text-slate-200"></th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                            @if (RowUpdate.Attributes != null)
                                foreach (var field in RowUpdate.Attributes)
                                {
                                    <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/60">
                                        <td scope="row" class="px-3 py-2 text-sm text-slate-700 dark:text-slate-200"><button @onclick="() => AttributeForm = field" class="text-sky-600 hover:text-sky-700 underline-offset-2 hover:underline dark:text-sky-300 dark:hover:text-sky-200">@field.AttributeType</button> </td>
                                        <td scope="row" class="px-3 py-2 text-sm text-slate-700 dark:text-slate-200">@field.Order</td>
                                        <td class ="px-3 py-2 text-sm text-slate-700 dark:text-slate-200"><input type="checkbox" disabled checked="@field.Required" /></td>
                                        <td class="px-3 py-2 text-sm text-slate-700 dark:text-slate-200">
                                            <button @onclick="()=>Remove(field)" class="inline-flex items-center justify-center rounded-md border border-red-400 px-3 py-1.5 text-sm font-medium text-red-600 transition hover:bg-red-50 dark:border-red-700 dark:text-red-300 dark:hover:bg-red-900/30">@((MarkupString)Icons.DeleteSVG)</button>
                                        </td>
                                    </tr>
                                }
                        </tbody>
                    </table>
                </div>
            }
        }
        @if (PartPage == 1 || PartPage == 2 || PartPage == 3)
        {
            <div style="padding-top:10px;">
                @if (Part == 1 || Part == 2)
                {
                    <button class="inline-flex items-center justify-center rounded-md border border-sky-400 px-3 py-1.5 text-sm font-medium text-sky-600 transition hover:bg-sky-50 dark:border-sky-700 dark:text-sky-300 dark:hover:bg-sky-900/30" @onclick="updateStyle">Preview Style</button>
                    <button class="inline-flex items-center justify-center rounded-md border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-700 transition hover:bg-slate-50 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-800" @onclick="() => Part = 0">@((MarkupString)Icons.Back)</button>
                }
                <div style="display:flex;@StyleRowStr">
                    <label style="@StyleStr z-index:100;">@RowUpdate.Name</label>
                    @if (RowUpdate.Attributes != null) foreach (var attr in RowUpdate.Attributes)
                        {
                            if (attr.AttributeType == AttributeType.Bool)
                            {
                                <input class="h-4 w-4 rounded border-slate-300 text-sky-600 focus:ring-sky-500 dark:border-slate-600 dark:bg-slate-800" type="checkbox" style="@attr.Style" />
                            }
                            else if (attr.AttributeType == AttributeType.Int || attr.AttributeType == AttributeType.Double)
                            {
                                <label style="@attr.Style">123</label>
                            }
                            else
                            {
                                <label style="@attr.Style">Attribute Value</label>
                            }
                        }
                </div>
            </div>
            <div style="padding-top:0px;">
                <div style="display:flex;@StyleRowStr">
                    <label style="@StyleStr">@RowUpdate.Name</label>
                    @if (RowUpdate.Attributes != null) foreach (var attr in RowParameter.Attributes)
                        {
                            @if (attr.AttributeType == AttributeType.Text)
                            {
                                <input type="text" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" style="@attr.Style" />
                            }
                            else if (attr.AttributeType == AttributeType.Char)
                            {
                                <input maxlength="1" type="text" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" style="@attr.Style" />
                            }
                            else if (attr.AttributeType == AttributeType.TextArea)
                            {
                                <textarea class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" style="@attr.Style"></textarea>
                            }
                            else if (attr.AttributeType == AttributeType.DateTime)
                            {
                                <input type="datetime-local" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" style="@attr.Style" />
                            }
                            else if (attr.AttributeType == AttributeType.Date)
                            {
                                <input type="date" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" style="@attr.Style" />
                            }
                            else if (attr.AttributeType == AttributeType.Time)
                            {
                                <input type="time" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" style="@attr.Style" />
                            }
                            else if (attr.AttributeType == AttributeType.Bool)
                            {
                                <input class="h-4 w-4 rounded border-slate-300 text-sky-600 focus:ring-sky-500 dark:border-slate-600 dark:bg-slate-800" type="checkbox" style="@attr.Style" />
                            }
                            else if (attr.AttributeType == AttributeType.Int || attr.AttributeType == AttributeType.Double)
                            {
                                <input type="number" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" style="@attr.Style" />
                            }
                            else if (attr.AttributeType == AttributeType.Select)
                            {
                                <select style="@attr.Style" class="form-select"></select>
                            }
                        }
                </div>
            </div>
        }
    }
    else
    {
        <AttributeFormUI Attribute="@AttributeForm" Callback="CallBackField"></AttributeFormUI>
    }
</div>
