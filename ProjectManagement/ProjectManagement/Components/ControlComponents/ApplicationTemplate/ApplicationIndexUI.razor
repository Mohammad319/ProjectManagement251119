@page "/Application"
@using Microsoft.AspNetCore.Authorization
@using ProjectManagement.Client.Shared.Model.Application
@attribute [Authorize(Roles = PMRolesConst.Tenant.Users)]
@inherits AppComponentBase
@inject ICommandDispatcher MicroBus

@if (ApplicationForm is not null)
{
    <ApplicationFormUI ApplicationUpdate="ApplicationForm" Callback="BtnUpdateAsync"></ApplicationFormUI>
}
else if (Loading)
{
    <div class="rounded-lg border border-slate-200 bg-slate-50 p-3 text-sm text-slate-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300">@PMWebResource.LoadingApplications</div>
}
else
{
    <div class="space-y-2">
        <div class="flex items-center justify-end gap-2 rounded-lg border border-slate-200 bg-slate-50 p-2 dark:border-slate-700 dark:bg-slate-800/50">
            <button @onclick="NewApp" class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-emerald-300 bg-emerald-50 text-emerald-600 transition hover:bg-emerald-100 dark:border-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-300 dark:hover:bg-emerald-900/50" type="button">
                @((MarkupString)Icons.Plus2)
            </button>

            <button @onclick="ToggleVisibility"
                    class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-slate-300 bg-white text-slate-600 transition hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
                    type="button"
                    title="@(IsVisible ? nameof(ResourceApp.isVisible) : nameof(ResourceApp.notFoundData))">
                @((MarkupString)Icons.GetVisibleIcon(IsVisible))
            </button>
        </div>

        @if (VisibleApplications.Count == 0)
        {
            <div class="rounded-lg border border-dashed border-slate-300 px-3 py-6 text-sm text-slate-600 dark:border-slate-700 dark:text-slate-300">@ResourceApp.notFoundData</div>
        }
        else
        {
            <div class="hidden lg:block">
                <table class="min-w-full divide-y divide-slate-200 overflow-hidden rounded-lg border border-slate-200 text-sm dark:divide-slate-700 dark:border-slate-700">
                    <thead class="bg-slate-50 dark:bg-slate-800/80">
                        <tr>
                            <th class="px-3 py-2 text-right text-sm font-semibold text-slate-600 dark:text-slate-200" style="width:250px;"></th>
                            <th class="px-3 py-2 text-right text-sm font-semibold text-slate-600 dark:text-slate-200" style="width:170px;">@ResourceApp.lastUpdate</th>
                            <th class="px-3 py-2 text-right text-sm font-semibold text-slate-600 dark:text-slate-200">@CalcResource.name</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                        @foreach (var application in VisibleApplications)
                        {
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/60">
                                <td class="px-3 py-2 text-sm text-slate-700 dark:text-slate-200">
                                    <div class="flex items-center gap-2">
                                        <button @onclick="() => OpenApplication(application)"
                                                class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-amber-300 bg-amber-50 text-amber-600 transition hover:bg-amber-100 dark:border-amber-700 dark:bg-amber-900/30 dark:text-amber-300 dark:hover:bg-amber-900/50"
                                                type="button">
                                            @Icons.Edit
                                        </button>
                                        <button @onclick="() => Remove(application)"
                                                class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-red-300 bg-red-50 text-red-600 transition hover:bg-red-100 dark:border-red-700 dark:bg-red-900/30 dark:text-red-300 dark:hover:bg-red-900/50"
                                                type="button">
                                            @((MarkupString)Icons.DeleteSVG)
                                        </button>
                                    </div>
                                </td>
                                <td class="px-3 py-2 text-sm text-slate-700 dark:text-slate-200">@application.LastUpdate.ToString("dd.MM.yyyy HH.mm")</td>
                                <td class="px-3 py-2 text-sm text-slate-700 dark:text-slate-200">@application.Name</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="grid gap-2 md:grid-cols-2 lg:grid-cols-3 lg:hidden">
                @foreach (var application in VisibleApplications)
                {
                    <div class="rounded-lg border border-slate-200 bg-white p-3 shadow-sm dark:border-slate-700 dark:bg-slate-900">
                        <div class="text-sm font-semibold text-slate-800 dark:text-slate-100">@application.Name</div>
                        <div class="mt-1 text-xs text-slate-500 dark:text-slate-400">@ResourceApp.lastUpdate: @application.LastUpdate.ToString("dd.MM.yyyy HH.mm")</div>
                        <div class="mt-2 flex items-center gap-2">
                            <button @onclick="() => OpenApplication(application)"
                                    class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-amber-300 bg-amber-50 text-amber-600 transition hover:bg-amber-100 dark:border-amber-700 dark:bg-amber-900/30 dark:text-amber-300 dark:hover:bg-amber-900/50"
                                    type="button">
                                @Icons.Edit
                            </button>
                            <button @onclick="() => Remove(application)"
                                    class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-red-300 bg-red-50 text-red-600 transition hover:bg-red-100 dark:border-red-700 dark:bg-red-900/30 dark:text-red-300 dark:hover:bg-red-900/50"
                                    type="button">
                                @((MarkupString)Icons.DeleteSVG)
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
}
