@using Microsoft.AspNetCore.Authorization
@using ProjectManagement.Client.Shared.Model.Application
@using ProjectManagement.Client.Shared.ViewModel
@using ProjectManagement.Shared
@using ProjectManagement.Shared.Base.Application
@inherits AppComponentBase
@attribute [Authorize(Roles = PMRolesConst.Tenant.AdminManger)]
@inject ICommandDispatcher MicroBus
@inject IStringLocalizer<AppFormatResource> FormatResource

<nav class="overflow-x-auto">
    <div class="flex min-w-max space-x-2 border-b border-gray-300 pb-1 dark:border-gray-700" role="tablist">
        <button type="button"
                class="px-4 py-2 font-medium text-sm rounded-t-md focus:outline-none transition-all duration-200
                       @(PartPage == 0 ? "border-b-2 border-blue-500 text-blue-600" : "text-gray-600 hover:text-blue-500")"
                @onclick="() => PartPage = 0">
            @ResourceApp.attribute
        </button>
        <button type="button"
                class="px-4 py-2 font-medium text-sm rounded-t-md focus:outline-none transition-all duration-200
                       @(PartPage == 1 ? "border-b-2 border-blue-500 text-blue-600" : "text-gray-600 hover:text-blue-500")"
                @onclick="() => PartPage = 1">
            @ResourceApp.text
        </button>
        <button type="button"
                class="px-4 py-2 font-medium text-sm rounded-t-md focus:outline-none transition-all duration-200
                       @(PartPage == 3 ? "border-b-2 border-blue-500 text-blue-600" : "text-gray-600 hover:text-blue-500")"
                @onclick="() => PartPage = 3">
            @PMAppFormatResource.background
        </button>
    </div>
</nav>

<div class="rounded-xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-700 dark:bg-slate-900" style="padding-top:20px;">
    <div>
        <label style="@StyleStr">Test</label>
    </div>
</div>
<EditForm Model="@AttributeUpdate" OnValidSubmit="async () => await HandleSubmitAsync()">
    <DataAnnotationsValidator />

        @if (PartPage == 0)
        {
    <div class="flex items-center gap-2">

            <div>
                <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceApp.attributeType: </label>
                <InputSelect @bind-Value="@AttributeUpdate.AttributeType" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900">
                    @foreach (var level in Enum.GetValues(typeof(AttributeType)))
                    {
                        <option value="@level">@level</option>
                    }
                </InputSelect>
                <ValidationMessage For=@(() => AttributeUpdate.AttributeType) />
            </div>
            
        <div>
            <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceApp.order</label>
            <InputNumber @bind-Value="@AttributeUpdate.Order" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900"></InputNumber>
        </div>
                <div class="flex items-center gap-2 py-1">
                    <InputCheckbox class="h-4 w-4 rounded border-slate-300 text-sky-600 focus:ring-sky-500 dark:border-slate-600 dark:bg-slate-800" type="checkbox" @bind-Value="@AttributeUpdate.Required" />
                    <label class="text-sm text-slate-700 dark:text-slate-200">@ResourceApp.required</label>
                </div>
                   </div>
        <div class="flex items-center gap-2">
            @if (AttributeUpdate.AttributeType == AttributeType.Select)
                {
                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceApp.newItem</label>
                        <input type="text" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind-value="@SelectV">
                    </div>

                    <div>
                        <div class="">
                        <span role="button" @onclick="() => { ValidSelectVM.Values.Add(SelectV); SelectV = string.Empty; }">@((MarkupString)Icons.Plus)</span>
                        </div>
                    </div>
                    <ul>
                @if (ShowSelect) for (var i = 0; i < ValidSelectVM.Values.Count; i++)
                    {
                        <li>
                            <span style="visibility:@(ValidSelectVM.DefaultIndex != i?"hidden":"visible")">
                                @Icons.List
                            </span>
                            <button class="btn" @onclick="() => RemoveSelect(i)">@((MarkupString)Icons.DeleteSVG)</button>
                            @ValidSelectVM.Values[i]
                        </li>
                    }
                    </ul>
                }
                else if (AttributeUpdate.AttributeType == AttributeType.Text || AttributeUpdate.AttributeType == AttributeType.TextArea)
                {
                <div class="flex items-center gap-2">
                    <div >
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceApp.minValue</label>
                        <input type="number" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind="@ValidTextVM.Min">
                    </div>
                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceApp.maxValue</label>
                        <input type="number" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind="@ValidTextVM.Max">
                    </div>
                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceApp.defaultValue</label>
                        <input type="text" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind="@ValidTextVM.Default">
                    </div>
                </div>
                }
                else if (AttributeUpdate.AttributeType == AttributeType.Int || AttributeUpdate.AttributeType == AttributeType.Double)
                {
                <div class="flex items-center gap-2">
                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceApp.minValue</label>
                        <input type="number" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind="@ValidNumberVM.Min">
                    </div>
                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceApp.maxValue</label>
                        <input type="number" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind="@ValidNumberVM.Max">
                    </div>
                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceApp.defaultValue</label>
                        <input type="number" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind="@ValidNumberVM.Default">
                    </div>
                </div>
                }
                else if (AttributeUpdate.AttributeType == AttributeType.Bool)
                {
                    <div>
                    <div class="text-sm font-medium text-slate-500 dark:text-slate-300">
                            <input class="h-4 w-4 rounded border-slate-300 text-sky-600 focus:ring-sky-500 dark:border-slate-600 dark:bg-slate-800" type="checkbox" @bind="@ValidBoolVM.Default" />
                            <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceApp.defaultValue</label>
                        </div>
                    </div>
                }
                else if (AttributeUpdate.AttributeType == AttributeType.DateTime || AttributeUpdate.AttributeType == AttributeType.Date
                || AttributeUpdate.AttributeType == AttributeType.Time)
                {
                <div class="flex items-center gap-2">
                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceApp.minValue</label>
                        <input type="@ValidDateVM.GetHTMLFormat(AttributeUpdate.AttributeType)" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind="@ValidDateVM.Min">
                    </div>
                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceApp.maxValue</label>
                        <input type="@ValidDateVM.GetHTMLFormat(AttributeUpdate.AttributeType)" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind="@ValidDateVM.Max">
                    </div>
                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceApp.defaultValue</label>
                        <input type="@ValidDateVM.GetHTMLFormat(AttributeUpdate.AttributeType)" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind="@ValidDateVM.Default">
                    </div>
                </div>
                }
            </div>

        }
        @if (PartPage == 1)
        {
        <div class="flex items-center gap-2">
                    <div>
            <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceLoc.color:</label>
            <input type="color"  class="h-10 w-full rounded-md border border-slate-300 bg-white p-1 dark:border-slate-600 dark:bg-slate-800" @bind="@Style.Color"
             @bind:after="Refresh"/>
        </div>
            @if (AttributeUpdate.AttributeType != AttributeType.Bool)
            {
                <div>
                    <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@PMAppFormatResource.fontWeight: </label>
                    <select @bind="@Style.FontWeight" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind:after="Refresh">
                        <option value=""></option>
                        <option value="bold">@PMAppFormatResource.bold </option>
                        <option value="normal">@PMAppFormatResource.normal </option>
                        <option value="bolder">@AppFormatResource.bolder </option>
                    </select>
                    <ValidationMessage For=@(() => Style.FontWeight) />
                </div>
                <div>
                    <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@PMAppFormatResource.alignItems: </label>
                <select @bind="@Style.TextAlign" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind:after="Refresh">
                        <option value=""></option>
                        <option value="center">@PMAppFormatResource.center </option>
                        <option value="right">@PMAppFormatResource.right </option>
                        <option value="left">@ResourceApp.left </option>
                    </select>
                    <ValidationMessage For=@(() => Style.TextAlign) />
                </div>
                <div>
                    <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@PMAppFormatResource.FontSize:</label>
                    <input type="number" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind="@Style.FontSize" @bind:after="Refresh" />
                    <ValidationMessage For=@(() => Style.FontSize) />
                </div>
            }
            <div>
                <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@PMAppFormatResource.paddingTop:</label>
                <input type="number" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind="@Style.PaddingTop" @bind:after="Refresh" />
                <ValidationMessage For=@(() => Style.PaddingTop) />
            </div>   </div>
        }
        else if (PartPage == 3)
        {
                        <div class="flex items-center gap-2">
            <div>
                <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@PMAppFormatResource.marginLeft:</label>
                <input type="number" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind="@Style.MarginLeft" @bind:after="Refresh" />
                <ValidationMessage For=@(() => Style.MarginLeft) />
            </div>
        <div>
                <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceLoc.color:</label>
                <input type="color" class="h-10 w-full rounded-md border border-slate-300 bg-white p-1 dark:border-slate-600 dark:bg-slate-800" @bind:after="Refresh" @bind="@Style.BackgroundColor" />
        </div>
        <div>
                <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@PMAppFormatResource.width:</label>
                <input type="number" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind="@Style.Width" @bind:after="Refresh" />
            <ValidationMessage For=@(() => Style.Width) />
        </div>
        <div>
                <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceApp.height:</label>
                <input type="number" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-sky-500 dark:focus:ring-sky-900" @bind="@Style.Height" @bind:after="Refresh" />

            <ValidationMessage For=@(() => Style.Height) />
        </div>
        </div>

        }

 
    <div class="mt-4 flex items-center gap-2">
        <button type="submit" disabled="@IsLoading" class="inline-flex items-center justify-center rounded-md border border-emerald-400 px-3 py-1.5 text-sm font-medium text-emerald-600 transition hover:bg-emerald-50 dark:border-emerald-700 dark:text-emerald-300 dark:hover:bg-emerald-900/30">@ResourceApp.save</button>
        <button type="button" class="inline-flex items-center justify-center rounded-md border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-700 transition hover:bg-slate-50 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-800" @onclick="CancelAsync">@ResourceApp.cancel</button>
    </div>
</EditForm>
