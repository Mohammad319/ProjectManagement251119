@using ProjectManagement.Services.UI
@inherits AppComponentBase
@inject ICompanyProfileService ProfileService
@inject AuthenticationStateProvider AuthStateProvider

@* Företagsprofil — företagets identitet (namn, org.nr, logotyp), kontaktuppgifter och
   rapporttexter som stämplas in i rapporter/PDF-exporter. Identitetsfälten är skyddade:
   org.nr låses efter registrering, namn/logotyp är frekvensbegränsade och allt loggas. *@

@if (IsLoading)
{
    <MhdLoading />
}
else
{
    <div class="flex h-full min-h-0 flex-col gap-3 overflow-auto p-1">

        @* Identitetsinformation *@
        <div class="shrink-0 rounded-xl border border-sky-200 bg-sky-50 px-4 py-3 text-xs leading-relaxed text-sky-800 dark:border-sky-900/60 dark:bg-sky-950/40 dark:text-sky-200">
            <div class="flex items-start gap-2">
                <svg class="mt-0.5 h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
                <div>
                    <p>Företagsuppgifterna används i rapporter, PDF-exporter och dokument. Ett konto är kopplat till ett företag. Ändringar av företagsnamn, organisationsnummer och logotyp loggas.</p>
                    <p class="mt-1 text-sky-700/80 dark:text-sky-300/80">Företagsnamn, organisationsnummer och logotyp används som företagets identitet i rapporter och export. För att skydda kontot är vissa ändringar begränsade och loggas.</p>
                </div>
            </div>
        </div>

        @if (!IsAdmin)
        {
            <div class="shrink-0 rounded-lg border border-slate-200 bg-slate-50 px-4 py-2 text-xs text-slate-600 dark:border-slate-700 dark:bg-slate-800/60 dark:text-slate-300">
                Endast administratörer kan ändra företagsprofilen. Du kan se uppgifterna men inte ändra dem.
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="shrink-0 rounded-lg border border-amber-300 bg-amber-50 px-4 py-2 text-sm text-amber-800 dark:border-amber-900/60 dark:bg-amber-950/40 dark:text-amber-200">
                @ErrorMessage
            </div>
        }

        @* ── Grunduppgifter ─────────────────────────────────────────── *@
        <section class="shrink-0 rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
            <h3 class="mb-3 text-sm font-semibold text-slate-900 dark:text-slate-100">Grunduppgifter</h3>

            <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
                <div>
                    <label class="@LabelClass" for="cp-name">Företagsnamn <span class="text-red-500">*</span></label>
                    <input id="cp-name" class="@InputClass" @bind="Form.CompanyName" disabled="@(!IsAdmin)" maxlength="200" />
                    @if (Profile.NextNameChangeAllowedAtUtc.HasValue)
                    {
                        <p class="mt-1 text-[11px] text-amber-600 dark:text-amber-400">
                            Företagsnamnet ändrades nyligen och kan ändras igen tidigast @Profile.NextNameChangeAllowedAtUtc.Value.ToLocalTime().ToString("yyyy-MM-dd").
                        </p>
                    }
                    else
                    {
                        <p class="mt-1 text-[11px] text-slate-400 dark:text-slate-500">Kan ändras max 1 gång per 30 dagar. Ändringen loggas.</p>
                    }
                </div>
                <div>
                    <label class="@LabelClass" for="cp-orgnr">Organisationsnummer</label>
                    @if (Profile.OrgNumberLocked)
                    {
                        <input id="cp-orgnr" class="@InputClass opacity-70" value="@Profile.OrgNumber" readonly disabled
                               title="Organisationsnummer är låst efter registrering. Kontakta support om det behöver ändras." />
                        <p class="mt-1 inline-flex items-center gap-1 text-[11px] text-slate-500 dark:text-slate-400">
                            <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                            Organisationsnummer är låst efter registrering. Kontakta support för att ändra organisationsnummer.
                        </p>
                    }
                    else
                    {
                        <input id="cp-orgnr" class="@InputClass" @bind="Form.OrgNumber" disabled="@(!IsAdmin)" maxlength="30" placeholder="t.ex. 556677-8899" />
                        <p class="mt-1 text-[11px] text-slate-400 dark:text-slate-500">Låses efter registrering och kan därefter bara ändras via support.</p>
                    }
                </div>
                <div>
                    <label class="@LabelClass" for="cp-vat">VAT-/momsnummer (valfritt)</label>
                    <input id="cp-vat" class="@InputClass" @bind="Form.VatNumber" disabled="@(!IsAdmin)" maxlength="30" />
                </div>
                <div>
                    <label class="@LabelClass" for="cp-phone">Telefonnummer</label>
                    <input id="cp-phone" class="@InputClass" @bind="Form.Phone" disabled="@(!IsAdmin)" maxlength="60" />
                </div>
                <div>
                    <label class="@LabelClass" for="cp-email">E-post</label>
                    <input id="cp-email" type="email" class="@InputClass" @bind="Form.Email" disabled="@(!IsAdmin)" maxlength="200" />
                </div>
                <div>
                    <label class="@LabelClass" for="cp-web">Webbplats</label>
                    <input id="cp-web" class="@InputClass" @bind="Form.Website" disabled="@(!IsAdmin)" maxlength="300" />
                </div>
                <div class="md:col-span-2">
                    <label class="@LabelClass" for="cp-address">Adress</label>
                    <input id="cp-address" class="@InputClass" @bind="Form.Address" disabled="@(!IsAdmin)" maxlength="300" />
                </div>
                <div>
                    <label class="@LabelClass" for="cp-zip">Postnummer</label>
                    <input id="cp-zip" class="@InputClass" @bind="Form.PostalCode" disabled="@(!IsAdmin)" maxlength="20" />
                </div>
                <div>
                    <label class="@LabelClass" for="cp-city">Stad</label>
                    <input id="cp-city" class="@InputClass" @bind="Form.City" disabled="@(!IsAdmin)" maxlength="100" />
                </div>
                <div>
                    <label class="@LabelClass" for="cp-country">Land</label>
                    <input id="cp-country" class="@InputClass" @bind="Form.Country" disabled="@(!IsAdmin)" maxlength="100" />
                </div>
            </div>

            @if (IsAdmin)
            {
                <div class="mt-4 flex items-center gap-3">
                    <button type="button" class="@PrimaryButtonClass" disabled="@IsSaving" @onclick="SaveBasicsRequestedAsync">
                        Spara grunduppgifter
                    </button>
                    <span class="text-[11px] text-slate-400 dark:text-slate-500">Kontaktuppgifter kan ändras fritt. Ändringar loggas.</span>
                </div>
            }
        </section>

        @* ── Logotyp ────────────────────────────────────────────────── *@
        <section class="shrink-0 rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
            <h3 class="mb-1 text-sm font-semibold text-slate-900 dark:text-slate-100">Logotyp</h3>
            <p class="mb-3 text-xs text-slate-500 dark:text-slate-400">
                Ladda upp en tydlig logotyp. Systemet anpassar storleken automatiskt i rapporter och PDF-exporter.
                PNG eller JPG, max 2 MB, rekommenderad bredd minst 600 px. Kan ändras max 3 gånger per 30 dagar.
            </p>

            <div class="flex flex-wrap items-start gap-6">
                <div>
                    <p class="@LabelClass">Nuvarande logotyp</p>
                    <div class="flex h-24 w-48 items-center justify-center overflow-hidden rounded-lg border border-slate-200 bg-slate-50 dark:border-slate-700 dark:bg-slate-800">
                        @if (!string.IsNullOrEmpty(Profile.LogoDataUrl))
                        {
                            <img src="@Profile.LogoDataUrl" alt="Företagslogotyp" class="max-h-full max-w-full object-contain" />
                        }
                        else
                        {
                            <span class="text-xs text-slate-400">Ingen logotyp uppladdad</span>
                        }
                    </div>
                </div>

                @if (Profile.HasPreviousLogo && !string.IsNullOrEmpty(Profile.PreviousLogoDataUrl))
                {
                    <div>
                        <p class="@LabelClass">Tidigare logotyp</p>
                        <div class="flex h-24 w-48 items-center justify-center overflow-hidden rounded-lg border border-dashed border-slate-300 bg-slate-50 dark:border-slate-600 dark:bg-slate-800">
                            <img src="@Profile.PreviousLogoDataUrl" alt="Tidigare företagslogotyp" class="max-h-full max-w-full object-contain opacity-80" />
                        </div>
                        @if (IsAdmin)
                        {
                            <button type="button" class="@SecondaryButtonClass mt-2" disabled="@IsSaving" @onclick="RestoreLogoRequested">
                                Återställ föregående logotyp
                            </button>
                        }
                    </div>
                }

                @if (PendingLogo is not null)
                {
                    <div>
                        <p class="@LabelClass">Förhandsvisning (ej sparad)</p>
                        <div class="flex h-24 w-48 items-center justify-center overflow-hidden rounded-lg border-2 border-blue-400 bg-slate-50 dark:bg-slate-800">
                            <img src="@PendingLogo.DataUrl" alt="Förhandsvisning av ny logotyp" class="max-h-full max-w-full object-contain" />
                        </div>
                        <div class="mt-2 flex gap-2">
                            <button type="button" class="@PrimaryButtonClass" disabled="@IsSaving" @onclick="ConfirmLogoRequested">Använd denna logotyp</button>
                            <button type="button" class="@SecondaryButtonClass" disabled="@IsSaving" @onclick="CancelPendingLogo">Avbryt</button>
                        </div>
                    </div>
                }
            </div>

            @if (IsAdmin)
            {
                <div class="mt-4">
                    <label class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-slate-300 px-3 py-1.5 text-xs font-medium text-slate-700 transition hover:bg-slate-50 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-800">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m17 8-5-5-5 5"/><path d="M12 3v12"/></svg>
                        Ladda upp ny logotyp
                        <InputFile OnChange="OnLogoSelectedAsync" accept=".png,.jpg,.jpeg,image/png,image/jpeg" class="hidden" />
                    </label>
                    @if (Profile.NextLogoChangeAllowedAtUtc.HasValue)
                    {
                        <p class="mt-2 text-[11px] text-amber-600 dark:text-amber-400">
                            Gränsen på 3 logotypbyten per 30 dagar är nådd. Nästa byte är möjligt @Profile.NextLogoChangeAllowedAtUtc.Value.ToLocalTime().ToString("yyyy-MM-dd").
                        </p>
                    }
                    else if (Profile.LogoChangesLast30Days > 0)
                    {
                        <p class="mt-2 text-[11px] text-slate-400 dark:text-slate-500">
                            @Profile.LogoChangesLast30Days av 3 logotypbyten använda de senaste 30 dagarna.
                        </p>
                    }
                </div>
            }
        </section>

        @* ── Rapporttexter ──────────────────────────────────────────── *@
        <section class="shrink-0 rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
            <h3 class="mb-1 text-sm font-semibold text-slate-900 dark:text-slate-100">Rapporttexter</h3>
            <p class="mb-3 text-xs text-slate-500 dark:text-slate-400">Valfria standardtexter som används i rapporter och PDF-exporter.</p>

            <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
                <div>
                    <label class="@LabelClass" for="cp-header">Sidhuvudstext (valfri)</label>
                    <input id="cp-header" class="@InputClass" @bind="Texts.ReportHeaderText" disabled="@(!IsAdmin)" maxlength="500" />
                </div>
                <div>
                    <label class="@LabelClass" for="cp-footer">Sidfotstext (valfri)</label>
                    <input id="cp-footer" class="@InputClass" @bind="Texts.ReportFooterText" disabled="@(!IsAdmin)" maxlength="500" />
                </div>
                <div>
                    <label class="@LabelClass" for="cp-calctext">Standardtext för kalkylrapport (valfri)</label>
                    <textarea id="cp-calctext" rows="3" class="@InputClass" @bind="Texts.CalcReportDefaultText" disabled="@(!IsAdmin)" maxlength="2000"></textarea>
                </div>
                <div>
                    <label class="@LabelClass" for="cp-tendertext">Standardtext för anbudsrapport (valfri)</label>
                    <textarea id="cp-tendertext" rows="3" class="@InputClass" @bind="Texts.TenderReportDefaultText" disabled="@(!IsAdmin)" maxlength="2000"></textarea>
                </div>
                <div>
                    <label class="@LabelClass" for="cp-selftext">Standardtext för egenkontrollrapport (valfri)</label>
                    <textarea id="cp-selftext" rows="3" class="@InputClass" @bind="Texts.SelfInspectionReportDefaultText" disabled="@(!IsAdmin)" maxlength="2000"></textarea>
                </div>
                <div>
                    <label class="@LabelClass" for="cp-disclaimer">Ansvarsfriskrivning/villkor (valfri)</label>
                    <textarea id="cp-disclaimer" rows="3" class="@InputClass" @bind="Texts.DisclaimerText" disabled="@(!IsAdmin)" maxlength="2000"></textarea>
                </div>
            </div>

            @if (IsAdmin)
            {
                <div class="mt-4">
                    <button type="button" class="@PrimaryButtonClass" disabled="@IsSaving" @onclick="SaveReportTextsAsync">
                        Spara rapporttexter
                    </button>
                </div>
            }
        </section>
    </div>
}

@code {
    private const string LabelClass = "mb-1 block text-xs font-medium text-slate-600 dark:text-slate-300";
    private const string InputClass = "w-full rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 disabled:cursor-not-allowed disabled:bg-slate-50 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100 dark:disabled:bg-slate-900";
    private const string PrimaryButtonClass = "inline-flex items-center gap-2 rounded-lg bg-blue-600 px-4 py-1.5 text-xs font-semibold text-white shadow-sm transition hover:bg-blue-700 disabled:opacity-60";
    private const string SecondaryButtonClass = "inline-flex items-center gap-2 rounded-lg border border-slate-300 px-3 py-1.5 text-xs font-medium text-slate-700 transition hover:bg-slate-50 disabled:opacity-60 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-800";

    private sealed class BasicsForm
    {
        public string CompanyName = string.Empty;
        public string? OrgNumber;
        public string? VatNumber;
        public string? Phone;
        public string? Email;
        public string? Website;
        public string? Address;
        public string? PostalCode;
        public string? City;
        public string? Country;
    }

    private sealed class TextsForm
    {
        public string? ReportHeaderText;
        public string? ReportFooterText;
        public string? CalcReportDefaultText;
        public string? TenderReportDefaultText;
        public string? SelfInspectionReportDefaultText;
        public string? DisclaimerText;
    }

    private sealed record PendingLogoFile(byte[] Data, string ContentType, string DataUrl);

    private CompanyProfileDto Profile = default!;
    private BasicsForm Form = new();
    private TextsForm Texts = new();
    private PendingLogoFile? PendingLogo;
    private bool IsAdmin;
    private bool IsLoading = true;
    private bool IsSaving;
    private string? ErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        IsAdmin = authState.User.IsInRole(PMRolesConst.Tenant.Admin);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        IsLoading = true;
        Profile = await ProfileService.GetAsync();
        Form = new BasicsForm
        {
            CompanyName = Profile.CompanyName,
            OrgNumber = Profile.OrgNumber,
            VatNumber = Profile.VatNumber,
            Phone = Profile.Phone,
            Email = Profile.Email,
            Website = Profile.Website,
            Address = Profile.Address,
            PostalCode = Profile.PostalCode,
            City = Profile.City,
            Country = Profile.Country
        };
        Texts = new TextsForm
        {
            ReportHeaderText = Profile.ReportHeaderText,
            ReportFooterText = Profile.ReportFooterText,
            CalcReportDefaultText = Profile.CalcReportDefaultText,
            TenderReportDefaultText = Profile.TenderReportDefaultText,
            SelfInspectionReportDefaultText = Profile.SelfInspectionReportDefaultText,
            DisclaimerText = Profile.DisclaimerText
        };
        PendingLogo = null;
        IsLoading = false;
    }

    // ── Grunduppgifter ─────────────────────────────────────────────

    private async Task SaveBasicsRequestedAsync()
    {
        ErrorMessage = null;

        var nameChanged = Profile.Exists
            && !string.IsNullOrWhiteSpace(Profile.CompanyName)
            && !string.Equals(Profile.CompanyName, Form.CompanyName?.Trim(), StringComparison.Ordinal);

        if (nameChanged)
        {
            ShowConfirmDialog(
                "Vill du ändra företagsnamnet?",
                "Detta namn används i framtida rapporter, PDF-exporter och dokument. Ändringen loggas.",
                "Bekräfta ändring",
                async () => await SaveBasicsAsync());
            return;
        }

        await SaveBasicsAsync();
    }

    private async Task SaveBasicsAsync()
    {
        IsSaving = true;
        try
        {
            var result = await ProfileService.SaveBasicsAsync(new CompanyBasicsInput(
                Form.CompanyName, Form.OrgNumber, Form.VatNumber, Form.Phone, Form.Email,
                Form.Website, Form.Address, Form.PostalCode, Form.City, Form.Country));

            if (result.Succeeded)
            {
                MHD.ToastInfo("Företagsprofilen har sparats.");
                await LoadAsync();
            }
            else
            {
                ErrorMessage = result.Error;
            }
        }
        finally
        {
            IsSaving = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // ── Rapporttexter ──────────────────────────────────────────────

    private async Task SaveReportTextsAsync()
    {
        ErrorMessage = null;
        IsSaving = true;
        try
        {
            var result = await ProfileService.SaveReportTextsAsync(new CompanyReportTextsInput(
                Texts.ReportHeaderText, Texts.ReportFooterText, Texts.CalcReportDefaultText,
                Texts.TenderReportDefaultText, Texts.SelfInspectionReportDefaultText, Texts.DisclaimerText));

            if (result.Succeeded)
            {
                MHD.ToastInfo("Rapporttexterna har sparats.");
                await LoadAsync();
            }
            else
            {
                ErrorMessage = result.Error;
            }
        }
        finally
        {
            IsSaving = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // ── Logotyp ────────────────────────────────────────────────────

    private async Task OnLogoSelectedAsync(InputFileChangeEventArgs e)
    {
        ErrorMessage = null;
        var file = e.File;
        if (file is null)
            return;

        if (file.Size > CompanyProfileService.MaxLogoBytes)
        {
            ErrorMessage = "Logotypen får vara högst 2 MB.";
            return;
        }

        var contentType = file.ContentType?.ToLowerInvariant() ?? string.Empty;
        if (contentType is not ("image/png" or "image/jpeg" or "image/jpg"))
        {
            ErrorMessage = "Endast PNG- och JPG-bilder stöds som logotyp.";
            return;
        }

        await using var stream = file.OpenReadStream(CompanyProfileService.MaxLogoBytes);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        var data = ms.ToArray();

        PendingLogo = new PendingLogoFile(data, contentType,
            $"data:{contentType};base64,{Convert.ToBase64String(data)}");
    }

    private void ConfirmLogoRequested()
    {
        ShowConfirmDialog(
            "Vill du byta företagslogotyp?",
            "Den nya logotypen används i framtida rapporter, PDF-exporter och dokument. Ändringen loggas.",
            "Bekräfta byte",
            async () => await SaveLogoAsync());
    }

    private async Task SaveLogoAsync()
    {
        if (PendingLogo is null)
            return;

        IsSaving = true;
        try
        {
            var result = await ProfileService.ChangeLogoAsync(PendingLogo.Data, PendingLogo.ContentType);
            if (result.Succeeded)
            {
                MHD.ToastInfo("Logotypen har uppdaterats.");
                await LoadAsync();
            }
            else
            {
                ErrorMessage = result.Error;
            }
        }
        finally
        {
            IsSaving = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CancelPendingLogo() => PendingLogo = null;

    private void RestoreLogoRequested()
    {
        ShowConfirmDialog(
            "Vill du återställa föregående logotyp?",
            "Återställningen räknas som ett logotypbyte, används i framtida rapporter och loggas.",
            "Bekräfta byte",
            async () => await RestoreLogoAsync());
    }

    private async Task RestoreLogoAsync()
    {
        IsSaving = true;
        try
        {
            var result = await ProfileService.RestorePreviousLogoAsync();
            if (result.Succeeded)
            {
                MHD.ToastInfo("Föregående logotyp har återställts.");
                await LoadAsync();
            }
            else
            {
                ErrorMessage = result.Error;
            }
        }
        finally
        {
            IsSaving = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // ── Bekräftelsedialog med egna knapptexter (Bekräfta/Avbryt) ────

    private void ShowConfirmDialog(string title, string message, string confirmText, Func<Task> onConfirm)
    {
        var model = new MhdDialogModel
        {
            Title = title,
            State = MhdState.Warning,
            Size = MhdDialogSize.Medium,
            CloseOnOverlayClick = false,
            Content = builder =>
            {
                builder.OpenElement(0, "p");
                builder.AddAttribute(1, "class", "text-sm leading-relaxed text-slate-700 dark:text-slate-300");
                builder.AddContent(2, message);
                builder.CloseElement();
            },
            Buttons =
            {
                new MhdDialogButtonModel
                {
                    Text = confirmText,
                    State = MhdState.Warning,
                    IsPrimary = true,
                    OnClick = EventCallback.Factory.Create(this, async () =>
                    {
                        await DialogService.CloseAsync();
                        await onConfirm();
                    })
                },
                new MhdDialogButtonModel
                {
                    Text = "Avbryt",
                    State = MhdState.Secondary,
                    OnClick = EventCallback.Factory.Create(this, () => DialogService.CloseAsync())
                }
            }
        };

        DialogService.Show(model);
    }
}
