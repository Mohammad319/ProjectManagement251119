@page "/control"
@rendermode InteractiveServer
@using BlazorMHD.UI.Components.Navigation.Tabs
@using BlazorMHD.UI.Core.Navigation
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using ProjectManagement.Components.ControlComponents.ApplicationTemplate
@using ProjectManagement.Components.ControlComponents.Project.Storage
@using ProjectManagement.Components.ControlComponents.Template
@attribute [Authorize(Roles = PMRolesConst.Tenant.Users)]

@inject AuthenticationStateProvider AuthStateProvider

<div class="space-y-2">
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">
        <div class="pointer-events-auto h-[min(78vh,960px)] overflow-hidden">
            <MhdTabs Items="@Tabs"
                     Mode="MhdTabMode.Vertical"
                     Size="MhdSize.Md"
                     Collapsible="true"
                     @bind-IsCollapsed="collapsed"
                     @bind-ActiveKey="ActiveKey">
            </MhdTabs>
        </div>
    </div>
</div>

@code {
    [Parameter] public string? ActiveKey { get; set; }

    private List<MhdTabItem> Tabs { get; set; } = [];
    private bool collapsed;

    protected override async Task OnInitializedAsync()
    {
        Tabs.Clear();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        var isAdmin = user.IsInRole(PMRolesConst.Tenant.Admin);
        var isSuperManager = user.IsInRole(PMRolesConst.Tenant.AdminManger)
                             || user.IsInRole(PMRolesConst.Tenant.Manger);

        if (isAdmin)
        {
            AddTab("department", ResourceApp.department, "fa fa-building", @<ProjectManagement.Components.ControlComponents.Department.Index />);
            AddTab("resourceType", CalcResource.resourceType, "fa fa-cubes", @<ProjectManagement.Components.ControlComponents.ResourceType.ResourceTypeUI />);
            AddTab("project", CalcResource.project, "fa fa-diagram-project", @<ProjectManagement.Components.ControlComponents.Project.ProjectPages.ProjectControl />);
            AddTab("templates-admin", ResourceLoc.templates, "fa fa-layer-group", @<TemplateIndex />);
            AddTab("organisation", ResourceApp.organisation, "fa fa-sitemap", @<ProjectManagement.Components.ControlComponents.Organisation.OrganisationCategory.CategoriesUI />);
        }

        if (isSuperManager)
            AddTab("templates-super", ResourceLoc.templates, "fa fa-layer-group", @<TemplateIndex />);

        if (isAdmin || isSuperManager)
        {
            AddTab("selfInspection", ResourceLoc.selfInspection, "fa fa-clipboard-check", @<ApplicationIndexUI />);
            AddTab("accounts", CalcResource.account, "fa fa-file-invoice-dollar", @<ProjectManagement.Components.ControlComponents.Accounts.AccountGroupsUI />);
            AddTab("storage", CalcResource.StorageSort, "fa fa-boxes-stacked", @<StorageIndex />);
        }

        EnsureActiveKey();
    }

    private void AddTab(string key, string text, string icon, RenderFragment content)
    {
        Tabs.Add(new MhdTabItem
        {
            Key = key,
            Text = text,
            Icon = icon,
            Content = content
        });
    }

    private void EnsureActiveKey()
    {
        if (!Tabs.Any())
            return;

        if (string.IsNullOrWhiteSpace(ActiveKey) || Tabs.All(x => x.Key != ActiveKey))
            ActiveKey = Tabs.First().Key;
    }
}
