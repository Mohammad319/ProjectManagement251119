@page "/control"
@rendermode InteractiveServer
@using BlazorMHD.UI.Components.Navigation.Tabs
@using BlazorMHD.UI.Core.Navigation
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using ProjectManagement.Components.ControlComponents.ApplicationTemplate
@using ProjectManagement.Components.ControlComponents.Template
@attribute [Authorize(Roles = PMRolesConst.Tenant.Users)]

@inject AuthenticationStateProvider AuthStateProvider

<div class="pm-control-shell space-y-2">
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">
        <div class="pointer-events-auto h-[min(78vh,960px)] overflow-hidden">
            <MhdTabs Items="@Tabs"
                     Mode="MhdTabMode.Vertical"
                     Size="MhdSize.Md"
                     Collapsible="true"
                     @bind-IsCollapsed="collapsed"
                     @bind-ActiveKey="ActiveKey">
            </MhdTabs>
        </div>
    </div>
</div>

@code {
    [Parameter] public string? ActiveKey { get; set; }

    private List<MhdTabItem> Tabs { get; set; } = [];
    private bool collapsed;

    protected override async Task OnInitializedAsync()
    {
        Tabs.Clear();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        var isAdmin = user.IsInRole(PMRolesConst.Tenant.Admin);

        if (isAdmin)
        {
            // Full admininställningsmeny. "Konto" (nu "Kontoplan") och "Mallar" ligger som flikar
            // under Kalkyl (CalculationControl), inte som egna huvudmenyer.
            AddTab("department", "Avdelningar & användare", "fa fa-building", @<ProjectManagement.Components.ControlComponents.Department.Index />);
            AddTab("project", CalcResource.project, "fa fa-diagram-project", @<ProjectManagement.Components.ControlComponents.Project.ProjectPages.ProjectControl />);
            AddTab("calculation", CalcResource.calculation, "fa fa-calculator", @<ProjectManagement.Components.ControlComponents.Calculation.CalculationControl />);
            AddTab("organisation", "Kunder & leverantörer", "fa fa-address-book", @<ProjectManagement.Components.ControlComponents.Organisation.OrganisationCategory.CategoriesUI />);
            AddTab("selfInspection", ResourceLoc.selfInspection, "fa fa-clipboard-check", @<ApplicationIndexUI />);
            // "Bibliotek" (StorageIndex) removed from the settings left menu — the library belongs
            // to calculation work and is used contextually inside the calculation view instead.
        }
        else
        {
            // Vanliga användare/visare: inga admininställningar. Endast egna mallar och kund-/
            // leverantörsregistret (skriv-/ändra-åtgärder är gated längre in för visare/gäst).
            AddTab("templates-user", "Mina mallar", "fa fa-layer-group", @<TemplateIndex />);
            AddTab("organisation", "Kunder & leverantörer", "fa fa-address-book", @<ProjectManagement.Components.ControlComponents.Organisation.OrganisationCategory.CategoriesUI />);
        }

        EnsureActiveKey();
    }

    private void AddTab(string key, string text, string icon, RenderFragment content)
    {
        Tabs.Add(new MhdTabItem
        {
            Key = key,
            Text = text,
            Icon = icon,
            Content = content
        });
    }

    private void EnsureActiveKey()
    {
        if (!Tabs.Any())
            return;

        if (string.IsNullOrWhiteSpace(ActiveKey) || Tabs.All(x => x.Key != ActiveKey))
            ActiveKey = Tabs.First().Key;
    }
}
