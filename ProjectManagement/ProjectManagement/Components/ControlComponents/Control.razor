@page "/control"
@using BlazorMHD.UI.Components.Navigation.Tabs
@using BlazorMHD.UI.Core.Navigation
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using ProjectManagement.Components.ControlComponents.ApplicationTemplate
@using ProjectManagement.Components.ControlComponents.Project.Storage
@using ProjectManagement.Components.ControlComponents.Template
@attribute [Authorize(Roles = PMRolesConst.Tenant.Users)]

@inject AuthenticationStateProvider AuthStateProvider

<div class="space-y-4">
    <div class="rounded-2xl border border-slate-200 bg-white px-4 py-4 shadow-sm dark:border-slate-700 dark:bg-slate-900 sm:px-5 sm:py-5">
        <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
            <div>
                <div class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">Settings</div>
                <h1 class="mt-1 text-xl font-semibold text-slate-900 dark:text-slate-100">Tenant control center</h1>
                <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-500 dark:text-slate-400">
                    Configure departments, projects, templates, storage, organisations, and self-inspection resources for the current tenant.
                </p>
            </div>

            <div class="grid gap-2 sm:grid-cols-2 xl:grid-cols-3">
                <div class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 dark:border-slate-700 dark:bg-slate-800/60">
                    <div class="text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400">Scope</div>
                    <div class="mt-1 text-sm font-semibold text-slate-900 dark:text-slate-100">Tenant only</div>
                </div>
                <div class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 dark:border-slate-700 dark:bg-slate-800/60">
                    <div class="text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400">Navigation</div>
                    <div class="mt-1 text-sm font-semibold text-slate-900 dark:text-slate-100">Role-based tabs</div>
                </div>
                <div class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 dark:border-slate-700 dark:bg-slate-800/60">
                    <div class="text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400">Next phase</div>
                    <div class="mt-1 text-sm font-semibold text-slate-900 dark:text-slate-100">Localized user emails</div>
                </div>
            </div>
        </div>
    </div>

    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">
        <div class="pointer-events-auto h-[min(78vh,960px)] overflow-hidden">
            <MhdTabs Items="@Tabs"
                     Mode="MhdTabMode.Vertical"
                     Size="MhdSize.Md"
                     Collapsible="true"
                     @bind-IsCollapsed="collapsed"
                     @bind-ActiveKey="ActiveKey">
            </MhdTabs>
        </div>
    </div>
</div>

@code {
    [Parameter] public string? ActiveKey { get; set; }

    private List<TabItem> Tabs { get; set; } = [];
    private bool collapsed;

    protected override async Task OnInitializedAsync()
    {
        Tabs.Clear();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        var isAdmin = user.IsInRole(PMRolesConst.Tenant.Admin);
        var isSuperManager = user.IsInRole(PMRolesConst.Tenant.Super_Manger)
                             || user.IsInRole(PMRolesConst.Tenant.SuperManger);

        if (isAdmin)
        {
            AddTab("department", ResourceApp.department, "fa fa-building", @<ProjectManagement.Components.ControlComponents.Department.Index />);
            AddTab("resourceType", CalcResource.resourceType, "fa fa-cubes", @<ProjectManagement.Components.ControlComponents.ResourceType.ResourceTypeUI />);
            AddTab("project", CalcResource.project, "fa fa-diagram-project", @<ProjectManagement.Components.ControlComponents.Project.ProjectPages.ProjectControl />);
            AddTab("templates-admin", ResourceLoc.templates, "fa fa-layer-group", @<TemplateIndex />);
            AddTab("organisation", ResourceApp.organisation, "fa fa-sitemap", @<ProjectManagement.Components.ControlComponents.Organisation.OrganisationCategory.CategoriesUI />);
        }

        if (isSuperManager)
            AddTab("templates-super", ResourceLoc.templates, "fa fa-layer-group", @<TemplateIndex />);

        if (isAdmin || isSuperManager)
        {
            AddTab("selfInspection", ResourceLoc.selfInspection, "fa fa-clipboard-check", @<ApplicationIndexUI />);
            AddTab("accounts", CalcResource.account, "fa fa-file-invoice-dollar", @<ProjectManagement.Components.ControlComponents.Accounts.AccountGroupsUI />);
            AddTab("storage", CalcResource.StorageSort, "fa fa-boxes-stacked", @<StorageIndex />);
        }

        EnsureActiveKey();
    }

    private void AddTab(string key, string text, string icon, RenderFragment content)
    {
        Tabs.Add(new TabItem
        {
            Key = key,
            Text = text,
            Icon = icon,
            Content = content
        });
    }

    private void EnsureActiveKey()
    {
        if (!Tabs.Any())
            return;

        if (string.IsNullOrWhiteSpace(ActiveKey) || Tabs.All(x => x.Key != ActiveKey))
            ActiveKey = Tabs.First().Key;
    }
}
