@using BlazorMHD.UI.Components.Data.Table
@using Domain.Entities.Calculation
﻿@using ProjectManagement.Client.Shared.Model.Project.Calculation;
@inject ICommandDispatcher MicroBus
@inject ContextMenuService ContextService
@inject MhdServices MHD
@inject IStringLocalizer<ResourceApp> AppLoc

 <MhdTable TItem="StatusResourcesEntity" Items="Status?.Where(x => x.IsVisible == IsVisible).OrderByDescending(x => x.SortOrder).ToList()"
      ShowFilter="false">
      <HeaderTemplate>
        <th style="width:200px;" class="@CssClasses.Table.TH">
            <div class="@CssClasses.Layout.FlexItemsCenter">
                <button @onclick="() => ModalForm(new StatusResourcesEntity())" class="@CssClasses.Btn.IconButton.Success">@Icons.Plus2</button>
                <button @onclick="() => IsVisible = !IsVisible" class="@CssClasses.Btn.IconButton.Secondary">@((MarkupString)Icons.GetVisibleIcon(IsVisible))</button>
            </div>
        </th>
        <th class="@CssClasses.Table.TH">@CalcResource.name</th>
      </HeaderTemplate>
          <ChildContent>
        <MhdTableColumn>
            <Template Context="status">
                <div class="@CssClasses.Layout.FlexItemsCenter">
                    <button @onclick="() => ModalForm(status)" class="@CssClasses.Btn.IconButton.Warning">@Icons.Edit</button>
                    <button @onclick="() => Remove(status)" class="@CssClasses.Btn.IconButton.Danger">@((MarkupString)Icons.DeleteSVG)</button>
                </div>
            </Template>
        </MhdTableColumn>
        <MhdTableColumn Title="@CalcResource.name">
            <Template Context="status">
                <span style="width:25px; height:25px; background-color:@status.Color; display:inline-block;"></span>
                @status.Name
            </Template>
        </MhdTableColumn>
          </ChildContent>
</MhdTable> 
