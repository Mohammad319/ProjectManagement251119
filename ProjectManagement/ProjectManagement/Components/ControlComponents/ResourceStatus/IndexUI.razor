@using Domain.Entities.Calculation
@inherits AppComponentBase

@if (IsLoading)
{
    <BlazorMHD.UI.Components.Feedback.Loading.MhdLoading />
}
else if (VisibleStatuses.Any())
{
    <div class="space-y-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-2 shadow-sm dark:border-slate-800 dark:bg-slate-950">
            <div class="flex items-center justify-between gap-2">
                <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-xs font-medium text-slate-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300">
                    @VisibleStatuses.Count() @CalcLoc[nameof(CalcResource.name)]
                </span>

                <div class="flex items-center gap-2">
                    <button @onclick="CreateNewAsync"
                            class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-emerald-300 bg-emerald-50 text-emerald-600 transition hover:bg-emerald-100 dark:border-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-300 dark:hover:bg-emerald-900/50"
                            title="@AppLoc[LocalizerConst.New, CalcResource.procurementMethods]"
                            aria-label="@AppLoc[LocalizerConst.New, CalcResource.procurementMethods]">
                        @Icons.Plus2
                    </button>
                    <button @onclick="ToggleVisibleAsync"
                            class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-slate-300 bg-white text-slate-600 transition hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
                            title="@AppLoc[nameof(ResourceApp.isVisible)]"
                            aria-label="@AppLoc[nameof(ResourceApp.isVisible)]">
                        @((MarkupString)Icons.GetVisibleIcon(IsVisible))
                    </button>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 gap-2 md:grid-cols-2 lg:grid-cols-3">
            @foreach (var status in VisibleStatuses)
            {
                <article class="rounded-xl border border-slate-200 bg-white p-3 shadow-sm transition hover:border-slate-300 dark:border-slate-800 dark:bg-slate-950 dark:hover:border-slate-700">
                    <div class="flex items-center justify-between gap-2">
                        <div class="flex min-w-0 items-center gap-2">
                            <span style="background-color:@status.Color" class="inline-block h-4 w-4 shrink-0 rounded-full border border-slate-200 dark:border-slate-700"></span>
                            <span class="truncate text-sm font-medium text-slate-800 dark:text-slate-100">@status.Name</span>
                        </div>

                        <div class="flex items-center gap-1.5">
                            <button @onclick="() => OpenFormAsync(status)"
                                    class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-amber-300 bg-amber-50 text-amber-600 transition hover:bg-amber-100 dark:border-amber-700 dark:bg-amber-900/30 dark:text-amber-300 dark:hover:bg-amber-900/50"
                                    title="@AppLoc[nameof(ResourceApp.update)]">
                                @Icons.Edit
                            </button>
                            <button @onclick="() => Remove(status)"
                                    class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-red-300 bg-red-50 text-red-600 transition hover:bg-red-100 dark:border-red-700 dark:bg-red-900/30 dark:text-red-300 dark:hover:bg-red-900/50"
                                    title="@AppLoc[nameof(ResourceApp.delete)]">
                                @((MarkupString)Icons.DeleteSVG)
                            </button>
                        </div>
                    </div>
                </article>
            }
        </div>
    </div>
}
else
{
    <div class="rounded-xl border border-dashed border-slate-200 bg-white/50 px-6 py-8 text-center text-sm text-slate-500 dark:border-slate-700 dark:bg-slate-900/40 dark:text-slate-400">
        @AppLoc[nameof(ResourceApp.ThereAreNoItemsToDisplay)]
    </div>
}
