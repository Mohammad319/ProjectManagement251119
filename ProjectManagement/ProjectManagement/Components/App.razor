<!DOCTYPE html>
<html lang="en">

<head>
    <style>
        .mhd-ripple {
            position: relative;
            overflow: hidden;
        }

        .mhd-ripple::after {
            content: "";
            position: absolute;
            inset: 0;
            border-radius: inherit;
            background: rgba(148, 163, 184, 0.35);
            transform: scale(0);
            opacity: 0;
            transition: transform .25s ease-out, opacity .4s ease-out;
        }

        .mhd-ripple:active::after {
            transform: scale(2);
            opacity: 1;
            transition: 0s;
        }
    </style>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />

    <!-- يطبق dark مبكرًا على <html> لمنع الوميض -->
    <script src="js/theme-init.js"></script>

    <ResourcePreloader />

    <link rel="stylesheet" href="@Assets["ProjectManagement.styles.css"]" />
    <link href="_content/ContextMenuMHD/css/tailwind-contextmenu.css" rel="stylesheet" />

    <!-- Tailwind الناتج -->
    <link rel="stylesheet" href="/css/custom.css" />
    <link rel="stylesheet" href="_content/BlazorMHD.UI/css/mhd.css" />
    <link rel="stylesheet" href="/css/app.css" />

    <ImportMap />
    <HeadOutlet />

    <link rel="shortcut icon" href="Icons/favicon.ico" type="image/x-icon">
    <script src="_content/BlazorMHD.UI/js/BlazorMHDUI.js"></script>


</head>

<body class="bg-white text-black dark:bg-gray-900 dark:text-white">
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["Components/Account/Shared/PasskeySubmit.razor.js"]" type="module"></script>

    <script src="js/resizabletable.js?v=1"></script>
    <script src="_content/ContextMenuMHD/js/contextMenuMHD.js"></script>
       <script src="js/reorderhelper.js"></script>
    <script>
        (function () {
            var culture = localStorage['BlazorCulture'];
            if (culture) {
                document.cookie = ".AspNetCore.Culture=c=" + culture + "|uic=" + culture + "; path=/";
            }
        })();
        window.blazorCulture = {
            get: () => localStorage['BlazorCulture'],
            set: (value) => { localStorage['BlazorCulture'] = value; }
        };
    </script>
</body>

</html>
