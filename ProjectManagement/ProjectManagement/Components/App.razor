@using System.Globalization

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />

    <script src="@Assets["js/theme-init.js"]"></script>

    <ResourcePreloader />

    <style>@@layer theme, base, components, utilities;</style>

    <link rel="stylesheet" href="@Assets["ProjectManagement.styles.css"]" />
    <!-- mhd.css is self-contained (animations bundled); a single reference is enough -->
    <link rel="stylesheet" href="@Assets["_content/BlazorMHD.UI/css/mhd.css"]" />
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <link rel="stylesheet" href="@Assets["css/custom.css"]" />

    <ImportMap />
    <HeadOutlet />
</head>

<body class="min-h-screen bg-slate-50 text-slate-900 antialiased dark:bg-slate-950 dark:text-slate-100">
    <Routes />
    <ReconnectModal />

    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["Components/Account/Shared/PasskeySubmit.razor.js"]" type="module"></script>
    @* BlazorMHD.UI now loads its JS automatically as an ES module — no script tag needed. *@
    <script src="@Assets["js/auth-session.js"]"></script>
    <script src="@Assets["js/password-visibility.js"]"></script>
    <script src="@Assets["js/calcGridBehavior.js"]"></script>
    <script src="@Assets["js/reportExport.js"]"></script>
    <script src="@Assets["js/atacostTransfer.js"]"></script>
    <script src="@Assets["js/resizableTable.js"]"></script>
    <script src="@Assets["js/tableColumnFilterPosition.js"]"></script>
    <script src="@Assets["js/hoverTooltip.js"]"></script>
    <script src="@Assets["js/reorderHelper.js"]"></script>

    <script>
        (function () {
        function resolveUiCulture() {
        var stored = localStorage['BlazorUICulture'] || localStorage['BlazorCulture'];
        if (stored) {
        return stored;
        }

        var browserCulture = (navigator.languages && navigator.languages.length ? navigator.languages[0] : navigator.language) || 'sv-SE';
        var resolved = browserCulture.toLowerCase().startsWith('sv') ? 'sv-SE' : 'en-US';
        localStorage['BlazorUICulture'] = resolved;
        localStorage['BlazorCulture'] = resolved;
        return resolved;
        }

        function applyCultureCookie(uiCulture) {
        document.cookie = ".AspNetCore.Culture=c=sv-SE|uic=" + uiCulture + "; path=/; max-age=31536000; samesite=lax";
        }

        var uiCulture = resolveUiCulture();
        applyCultureCookie(uiCulture);

        window.blazorCulture = {
        get: () => resolveUiCulture(),
        set: (value) => {
        localStorage['BlazorUICulture'] = value;
        localStorage['BlazorCulture'] = value;
        applyCultureCookie(value);
        }
        };
        })();
    </script>
</body>

</html>
