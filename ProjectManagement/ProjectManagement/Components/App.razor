<head>
    <style>
        .mhd-ripple {
            position: relative;
            overflow: hidden;
        }

        .mhd-ripple::after {
            content: "";
            position: absolute;
            inset: 0;
            border-radius: inherit;
            background: rgba(148, 163, 184, 0.35);
            transform: scale(0);
            opacity: 0;
            transition: transform .25s ease-out, opacity .4s ease-out;
        }

        .mhd-ripple:active::after {
            transform: scale(2);
            opacity: 1;
            transition: 0s;
        }
    </style>
    <meta charset="utf-8" />
