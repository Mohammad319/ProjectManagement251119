@using ProjectManagement.Shared
@inject IHttpContextAccessor HttpContextAccessor

<div class="alert alert-danger">
    <h5>@PMWebResource.ErrorPageTitle</h5>
    <p>@PMWebResource.ErrorPageMessage</p>
    <small>@PMWebResource.TraceIdLabel: @HttpContextAccessor.HttpContext?.TraceIdentifier</small>
</div>
