@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.AspNetCore.Components.Routing
@using ProjectManagement.Services
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject AppErrorDialog ErrorDialog

<div class="min-h-screen bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100">
    <div class="mx-auto flex min-h-screen max-w-[1900px] flex-col">
        <ErrorBoundary @ref="_boundary" @key="_errorKey">
            <ChildContent>
                <AuthorizeView>
                    <Authorized>
                        <NavMenu @rendermode="InteractiveServer"></NavMenu>
                    </Authorized>
                </AuthorizeView>

                <main class="flex-1 px-3 pb-4 pt-3 sm:px-4 lg:px-6 lg:pb-6 lg:pt-4">
                    @Body
                </main>
            </ChildContent>

            <ErrorContent Context="ex">
                <div class="mx-auto max-w-3xl rounded-2xl border border-rose-200 bg-rose-50 px-4 py-4 text-sm text-rose-700 shadow-sm dark:border-rose-900/70 dark:bg-rose-950/40 dark:text-rose-300">
                    حدث خطأ في الواجهة.
                </div>
                @HandleUiError(ex)
            </ErrorContent>
        </ErrorBoundary>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private ErrorBoundary? _boundary;
    private Exception? _pendingError;
    private bool _dialogShown;
    private int _errorKey = 0;

    private RenderFragment HandleUiError(Exception ex) => builder =>
    {
        if (_pendingError is null)
        {
            _pendingError = ex;
            _dialogShown = false;

            _ = InvokeAsync(async () =>
            {
                if (_dialogShown) return;
                _dialogShown = true;
#if DEBUG
                Console.Error.WriteLine(ex.ToString());
#endif

                var msg = "حدث خطأ في الواجهة. حاول تحديث الصفحة.";
                ErrorDialog.Show("خطأ", msg, traceId: null);

                await Task.Yield();

                _boundary?.Recover();
                _pendingError = null;
                _errorKey++;
                StateHasChanged();
            });
        }
    };

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = HandleLocationChangedAsync();
    }

    private async Task HandleLocationChangedAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("applyThemeFromStorage");
        }
        catch
        {
        }

        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("applyThemeFromStorage");
            }
            catch
            {
            }
        }
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
