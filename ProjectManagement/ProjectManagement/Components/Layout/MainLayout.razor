@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Routing
@using ProjectManagement.Services
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject AppErrorDialog ErrorDialog

<div class="mainContainer">

    <ErrorBoundary @ref="_boundary" @key="_errorKey">
        <ChildContent>
            <AuthorizeView>
                <Authorized>
                    <NavMenu @rendermode="InteractiveServer"></NavMenu>
                </Authorized>
            </AuthorizeView>
            @Body
        </ChildContent>

        <ErrorContent Context="ex">
            <div class="p-4 text-red-600 dark:text-red-400">
                حدث خطأ في الواجهة.
            </div>
            @HandleUiError(ex)
        </ErrorContent>
    </ErrorBoundary>

</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private ErrorBoundary? _boundary;
    private Exception? _pendingError;
    private bool _dialogShown;
    private int _errorKey = 0;

    private RenderFragment HandleUiError(Exception ex) => builder =>
    {
        // خزّن الخطأ مرة واحدة فقط (بدون side-effect مباشر)
        if (_pendingError is null)
        {
            _pendingError = ex;
            _dialogShown = false;

            // نفّذ فتح الـ dialog بعد render
            _ = InvokeAsync(async () =>
            {
                if (_dialogShown) return;
                _dialogShown = true;
#if DEBUG
Console.Error.WriteLine(ex.ToString());
#endif

                var msg = "حدث خطأ في الواجهة. حاول تحديث الصفحة.";
                ErrorDialog.Show("خطأ", msg, traceId: null);

                // أعطِ UI فرصة يتنفس
                await Task.Yield();

                // Recover + force recreate boundary
                _boundary?.Recover();
                _pendingError = null;
                _errorKey++;
                StateHasChanged();
            });
        }
    };

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        try
        {
            // نعيد تطبيق الثيم من localStorage بعد التنقل
            await JS.InvokeVoidAsync("applyThemeFromStorage");
        }
        catch
        {
            // تجاهل أي أخطاء JS بسيطة
        }

        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("applyThemeFromStorage");
            }
            catch
            {
            }
        }
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
