@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.AspNetCore.Components.Routing
@using ProjectManagement.Services
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject AppErrorDialog ErrorDialog

<div class="mainContainer">
    <ErrorBoundary @ref="_boundary" @key="_errorKey">
        <ChildContent>
            <AuthorizeView>
                <Authorized>
                    <div class="flex items-start bg-white shadow-md dark:bg-gray-800">
                        <div class="min-w-0 flex-1">
                            <NavMenu @rendermode="InteractiveServer"></NavMenu>
                        </div>
                    </div>
                </Authorized>
            </AuthorizeView>
            @Body
        </ChildContent>

        <ErrorContent Context="ex">
            <div class="mx-auto max-w-3xl rounded-2xl border border-rose-200 bg-rose-50 px-4 py-4 text-sm text-rose-700 shadow-sm dark:border-rose-900/70 dark:bg-rose-950/40 dark:text-rose-300">
                @PMWebResource.UiErrorMessage
            </div>
            @HandleUiError(ex)
        </ErrorContent>
    </ErrorBoundary>
</div>

<div id="blazor-error-ui" data-nosnippet>
    @PMWebResource.ErrorPageTitle
    <a href="." class="reload">@PMWebResource.Reload</a>
    <span class="dismiss">x</span>
</div>

@code {
    private ErrorBoundary? _boundary;
    private Exception? _pendingError;
    private bool _dialogShown;
    private int _errorKey;

    private RenderFragment HandleUiError(Exception ex) => builder =>
    {
        if (_pendingError is null)
        {
            _pendingError = ex;
            _dialogShown = false;

            _ = InvokeAsync(async () =>
            {
                if (_dialogShown)
                {
                    return;
                }

                _dialogShown = true;
#if DEBUG
                Console.Error.WriteLine(ex.ToString());
#endif

                var msg = PMWebResource.UiErrorMessage;
                ErrorDialog.Show(PMWebResource.UiErrorTitle, msg, traceId: null);

                await Task.Yield();

                _boundary?.Recover();
                _pendingError = null;
                _errorKey++;
                StateHasChanged();
            });
        }
    };

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = HandleLocationChangedAsync();
    }

    private async Task HandleLocationChangedAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("applyThemeFromStorage");
        }
        catch
        {
        }

        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("applyThemeFromStorage");
            }
            catch
            {
            }
        }
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
