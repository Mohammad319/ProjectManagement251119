@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Web
@using Application.Interfaces
@using Application.Feature.Notification.Commands
@using Application.Feature.Notification.Queries
@using Microsoft.AspNetCore.Components.Authorization
@using ProjectManagement.Shared
@using ProjectManagement.Shared.Constant
@using ProjectManagement.Shared.DTO.Notification
@using ProjectManagement.Shared.Enums
@using ProjectManagement.Services.UI
@implements IDisposable
@inject ICommandDispatcher Dispatcher
@inject IUserNotificationNotifier Notifier
@inject NavigationManager Navigation

<div class="relative inline-block text-left">
    <button type="button"
            class="btn nav-link relative"
            @onclick="TogglePanelAsync"
            title="@PMWebResource.NotificationsTitle"
            aria-label="@PMWebResource.NotificationsTitle"
            aria-haspopup="true"
            aria-expanded="@_open">
        <span aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                <path d="M13.73 21a2 2 0 0 1-3.46 0" />
            </svg>
        </span>
        @if (_unreadCount > 0)
        {
            @* Small, discrete dot (no number) – the unread count is shown in the panel header instead.
               Absolutely positioned in the icon corner so it never shifts the topbar layout. *@
            <span class="pointer-events-none absolute right-0 top-0 h-2 w-2 rounded-full bg-rose-600 ring-2 ring-white dark:ring-gray-800"
                  aria-label="@string.Format(PMWebResource.NotificationsUnreadAria, _unreadCount)"></span>
        }
    </button>

    @if (_open)
    {
        <div class="fixed inset-0 z-[990]" @onclick="ClosePanel"></div>
        <div class="absolute right-0 z-[1000] mt-2 w-80 max-w-[90vw] origin-top-right rounded-xl border border-gray-200 bg-white shadow-lg dark:border-gray-700 dark:bg-gray-800"
             role="menu" tabindex="-1" @onkeydown="OnPanelKeyDownAsync">
            @* Compact two-row header: title + "Rensa lästa" on row 1, the unread count +
               "Markera alla som lästa" on row 2. Both actions stay visible but go disabled
               (no pointer) when there is nothing to act on. No dropdown – two plain text actions. *@
            <div class="border-b border-gray-100 px-4 py-2 dark:border-gray-700">
                <div class="flex items-center justify-between gap-2">
                    <span class="text-sm font-semibold text-gray-800 dark:text-gray-100">@PMWebResource.NotificationsTitle</span>
                    <button type="button"
                            class="@(HasReadItems ? "pm-text-action-secondary" : "pm-text-action-disabled") text-xs"
                            disabled="@(!HasReadItems)"
                            @onclick="ClearReadAsync">
                        @PMWebResource.NotificationsClearRead
                    </button>
                </div>
                <div class="mt-0.5 flex items-center justify-between gap-2">
                    <span class="text-[0.7rem] font-medium text-gray-500 dark:text-gray-400">@UnreadCountText</span>
                    <button type="button"
                            class="@(_unreadCount > 0 ? "pm-text-action-secondary" : "pm-text-action-disabled") text-xs"
                            disabled="@(_unreadCount == 0)"
                            @onclick="MarkAllReadAsync">
                        @PMWebResource.NotificationsMarkAllRead
                    </button>
                </div>
            </div>

            <div class="max-h-96 overflow-y-auto">
                @if (_loading)
                {
                    <div class="px-4 py-6 text-center text-sm text-gray-500 dark:text-gray-400">@PMWebResource.NotificationsLoading</div>
                }
                else if (_summary is null || _summary.Items.Count == 0)
                {
                    <div class="px-4 py-6 text-center">
                        <p class="text-sm font-medium text-gray-700 dark:text-gray-200">@PMWebResource.NotificationsEmpty</p>
                        <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">@PMWebResource.NotificationsEmptyHint</p>
                    </div>
                }
                else
                {
                    @foreach (var item in _summary.Items)
                    {
                        <div class="@ItemClass(item)">
                            <div class="flex items-start gap-2">
                                @if (!item.IsRead)
                                {
                                    <span class="mt-1.5 h-2 w-2 flex-none rounded-full bg-rose-500" aria-hidden="true"></span>
                                }
                                <div class="min-w-0 flex-1">
                                    @{
                                        var isRemoved = item.Type == NotificationType.ProjectAccessRemoved;
                                        var isExpanded = _expandedNotificationId == item.Id;
                                        var accessLevel = NotificationPresenter.AccessLevelLabel(item);
                                        var calcInfo = NotificationPresenter.CalculationsInfo(item);
                                        var fullProject = string.IsNullOrWhiteSpace(item.ProjectName) ? "—" : item.ProjectName!;
                                    }
                                    <p class="truncate text-sm font-medium text-gray-900 dark:text-gray-100">@NotificationPresenter.Title(item)</p>

                                    @* Compact message – clamped to max two lines, long project names ellipsised. *@
                                    <p class="mt-0.5 line-clamp-2 text-xs text-gray-600 dark:text-gray-300">@NotificationPresenter.ShortMessage(item)</p>

                                    @* Date + actions on one row (wraps on narrow widths but stays compact). *@
                                    <div class="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1">
                                        <span class="text-[0.65rem] text-gray-400">@FormatDate(item.CreatedAt)</span>
                                        <button type="button" class="pm-text-action-secondary text-[0.65rem]"
                                                @onclick="() => ToggleDetails(item)">
                                            @(isExpanded ? PMWebResource.NotificationsHideDetails : PMWebResource.NotificationsShowDetails)
                                        </button>
                                        @if (!item.IsRead)
                                        {
                                            <button type="button" class="pm-text-action-secondary text-[0.65rem]"
                                                    @onclick="() => MarkReadAsync(item)">
                                                @PMWebResource.NotificationsMarkRead
                                            </button>
                                        }
                                        @* "Open project" is hidden for removed access – the user can no longer open it. *@
                                        @if (item.ProjectId.HasValue && !isRemoved)
                                        {
                                            <button type="button" class="pm-text-action-primary text-[0.65rem]"
                                                    @onclick="() => OpenProjectAsync(item)">
                                                @(item.CalculationId.HasValue ? PMWebResource.NotificationsOpenCalculation : PMWebResource.NotificationsOpenProject)
                                            </button>
                                        }
                                    </div>

                                    @* "Projektet är inte längre tillgängligt." is intentionally NOT shown in the
                                       compact view – it now lives under "Visa detaljer" (see the details block). *@

                                    @* Extra information only when expanded via "Show details". *@
                                    @if (isExpanded)
                                    {
                                        <dl class="mt-1.5 space-y-0.5 rounded-lg bg-gray-50 px-2 py-1.5 text-[0.65rem] dark:bg-gray-700/40">
                                            @if (isRemoved)
                                            {
                                                <p class="pb-0.5 font-medium text-gray-600 dark:text-gray-300">@PMWebResource.NotificationsProjectUnavailable</p>
                                            }
                                            <div class="flex gap-1">
                                                <dt class="font-semibold text-gray-500 dark:text-gray-400">@PMWebResource.NotificationDetailProject:</dt>
                                                <dd class="min-w-0 break-words text-gray-700 dark:text-gray-200">@fullProject</dd>
                                            </div>
                                            @if (isRemoved)
                                            {
                                                <div class="flex gap-1">
                                                    <dt class="font-semibold text-gray-500 dark:text-gray-400">@PMWebResource.NotificationDetailStatus:</dt>
                                                    <dd class="text-gray-700 dark:text-gray-200">@PMWebResource.NotificationTitleAccessRemoved</dd>
                                                </div>
                                                <div class="flex gap-1">
                                                    <dt class="font-semibold text-gray-500 dark:text-gray-400">@PMWebResource.NotificationDetailTime:</dt>
                                                    <dd class="text-gray-700 dark:text-gray-200">@FormatDate(item.CreatedAt)</dd>
                                                </div>
                                                <p class="pt-0.5 text-gray-500 dark:text-gray-400">@PMWebResource.NotificationAccessRemovedDetail</p>
                                            }
                                            else
                                            {
                                                @if (!string.IsNullOrWhiteSpace(item.ActorName))
                                                {
                                                    <div class="flex gap-1">
                                                        <dt class="font-semibold text-gray-500 dark:text-gray-400">@PMWebResource.NotificationDetailSharedBy:</dt>
                                                        <dd class="text-gray-700 dark:text-gray-200">@item.ActorName</dd>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(accessLevel))
                                                {
                                                    <div class="flex gap-1">
                                                        <dt class="font-semibold text-gray-500 dark:text-gray-400">@PMWebResource.NotificationDetailAccessLevel:</dt>
                                                        <dd class="text-gray-700 dark:text-gray-200">@accessLevel</dd>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(calcInfo))
                                                {
                                                    <div class="flex gap-1">
                                                        <dt class="font-semibold text-gray-500 dark:text-gray-400">@PMWebResource.NotificationDetailCalculations:</dt>
                                                        <dd class="text-gray-700 dark:text-gray-200">@calcInfo</dd>
                                                    </div>
                                                }
                                                <div class="flex gap-1">
                                                    <dt class="font-semibold text-gray-500 dark:text-gray-400">@PMWebResource.NotificationDetailValidity:</dt>
                                                    <dd class="text-gray-700 dark:text-gray-200">@NotificationPresenter.ValidityLabel(item)</dd>
                                                </div>
                                            }
                                        </dl>
                                    }

                                    @if (_unavailableNotificationId == item.Id)
                                    {
                                        <p class="mt-1 text-[0.65rem] text-rose-600 dark:text-rose-400">
                                            @(item.CalculationId.HasValue ? PMWebResource.NotificationsNoAccessCalculation : PMWebResource.NotificationsNoAccess)
                                        </p>
                                    }
                                </div>

                                <button type="button"
                                        class="pm-icon-action mt-0.5 flex-none p-1"
                                        title="@PMWebResource.NotificationsRemove"
                                        aria-label="@PMWebResource.NotificationsRemove"
                                        @onclick="() => RemoveAsync(item)">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
                                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <line x1="18" y1="6" x2="6" y2="18" />
                                        <line x1="6" y1="6" x2="18" y2="18" />
                                    </svg>
                                </button>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    }
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private int _userId;
    private int? _departmentId;
    private bool _isViewer;

    private int _unreadCount;
    private bool _open;
    private bool _loading;
    private NotificationSummaryDTO? _summary;
    private int? _unavailableNotificationId;
    // Which notification currently has its details expanded (null = all collapsed/compact).
    private int? _expandedNotificationId;

    private IDisposable? _subscription;

    private bool HasReadItems => _summary?.Items.Any(i => i.IsRead) == true;

    // "1 oläst" / "N olästa" – always the UNREAD count (never "lästa"). Shown even at 0
    // so the two-row header keeps a stable layout.
    private string UnreadCountText =>
        string.Format(
            _unreadCount == 1 ? PMWebResource.NotificationsUnreadCountOne : PMWebResource.NotificationsUnreadCount,
            _unreadCount);

    private void ToggleDetails(NotificationListItemDTO item) =>
        _expandedNotificationId = _expandedNotificationId == item.Id ? null : item.Id;

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserAsync();

        if (_userId <= 0)
            return;

        await RefreshCountAsync();

        // Realtime: refresh when a notification is created/updated for this user (same server instance).
        _subscription = Notifier.Subscribe(_userId, OnNotifiedAsync);
    }

    private async Task OnNotifiedAsync()
    {
        await RefreshCountAsync();
        if (_open)
            await LoadSummaryAsync();
    }

    private async Task ResolveCurrentUserAsync()
    {
        if (AuthStateTask is null)
            return;

        var user = (await AuthStateTask).User;
        if (user?.Identity?.IsAuthenticated != true)
            return;

        if (int.TryParse(user.FindFirst(PMClaimsConst.UserId)?.Value, out var uid))
            _userId = uid;

        if (int.TryParse(user.FindFirst(PMClaimsConst.DepartmentId)?.Value, out var did) && did > 0)
            _departmentId = did;

        _isViewer = user.IsInRole(PMRolesConst.Tenant.Viewer);
    }

    private async Task RefreshCountAsync()
    {
        try
        {
            _unreadCount = await Dispatcher.Send(new GetUnreadNotificationCountQuery(_userId));
        }
        catch
        {
            // Ignore transient read failures; the badge simply won't update this cycle.
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task TogglePanelAsync()
    {
        _open = !_open;
        _unavailableNotificationId = null;

        if (_open)
            await LoadSummaryAsync();
    }

    private void ClosePanel()
    {
        _open = false;
        _unavailableNotificationId = null;
        _expandedNotificationId = null;
    }

    private Task OnPanelKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            ClosePanel();

        return Task.CompletedTask;
    }

    private async Task LoadSummaryAsync()
    {
        _loading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            _summary = await Dispatcher.Send(new GetNotificationSummaryQuery(_userId, 15));
            _unreadCount = _summary.UnreadCount;
        }
        catch
        {
            _summary = new NotificationSummaryDTO();
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task MarkReadAsync(NotificationListItemDTO item)
    {
        if (item.IsRead)
            return;

        var ok = await Dispatcher.Send(new MarkNotificationReadCommand(item.Id, _userId));
        if (ok)
        {
            item.ReadAt = DateTime.UtcNow;
            _unreadCount = Math.Max(0, _unreadCount - 1);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task MarkAllReadAsync()
    {
        await Dispatcher.Send(new MarkAllNotificationsReadCommand(_userId));
        if (_summary is not null)
        {
            var now = DateTime.UtcNow;
            foreach (var n in _summary.Items.Where(n => !n.IsRead))
                n.ReadAt = now;
        }
        _unreadCount = 0;
        await InvokeAsync(StateHasChanged);
    }

    private async Task RemoveAsync(NotificationListItemDTO item)
    {
        var ok = await Dispatcher.Send(new DeleteNotificationCommand(item.Id, _userId));
        if (!ok)
            return;

        // A removed notification leaves the list; if it was unread, the badge must drop too.
        if (!item.IsRead)
            _unreadCount = Math.Max(0, _unreadCount - 1);

        _summary?.Items.Remove(item);
        if (_unavailableNotificationId == item.Id)
            _unavailableNotificationId = null;
        if (_expandedNotificationId == item.Id)
            _expandedNotificationId = null;

        await InvokeAsync(StateHasChanged);
    }

    private async Task ClearReadAsync()
    {
        await Dispatcher.Send(new ClearReadNotificationsCommand(_userId));
        if (_summary is not null)
            _summary.Items.RemoveAll(i => i.IsRead);

        _unavailableNotificationId = null;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OpenProjectAsync(NotificationListItemDTO item)
    {
        if (item.ProjectId is not { } projectId)
            return;

        // The notification grants no access on its own – always re-check the live access.
        var info = await Dispatcher.Send(
            new GetProjectOpenInfoQuery(projectId, _userId, _departmentId, _isViewer));

        if (info is null || !info.CanOpen)
        {
            _unavailableNotificationId = item.Id;
            await InvokeAsync(StateHasChanged);
            return;
        }

        await MarkReadAsync(item);
        _open = false;

        // Deep-link straight to the exact project (and calculation, when the notification has one) so the
        // SPA selects it explicitly instead of falling back to the first project in the folder.
        var url = $"/?openProject={projectId}";
        if (item.CalculationId is { } calcId)
            url += $"&openCalc={calcId}";

        Navigation.NavigateTo(url, forceLoad: true);
    }

    private static string ItemClass(NotificationListItemDTO item) =>
        item.IsRead
            ? "border-b border-gray-100 px-4 py-3 dark:border-gray-700"
            : "border-b border-gray-100 bg-indigo-50/40 px-4 py-3 dark:border-gray-700 dark:bg-indigo-500/10";

    private static string FormatDate(DateTime utc) =>
        utc.ToLocalTime().ToString("yyyy-MM-dd HH:mm");

    public void Dispose()
    {
        _subscription?.Dispose();
    }
}
