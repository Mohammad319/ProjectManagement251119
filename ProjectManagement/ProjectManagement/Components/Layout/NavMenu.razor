@using System.Globalization
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.JSInterop
@using ProjectManagement.Components.ControlComponents
@using ProjectManagement.Components.ControlComponents.Project
@using ProjectManagement.Shared
@implements IDisposable

@inject NavigationManager _navigationManager
@inject IJSRuntime JS
@inject SignInManager<ApplicationUser> SignInManager

<nav class="shadow-md bg-white dark:bg-gray-800">
    <div class="w-full flex flex-wrap items-center justify-between p-0.5">
        <a class="flex items-center" href="/" aria-label="ProjectManagement home">
            <img src="Icons/Logo.png" alt="Logo" class="h-8 w-auto" />
        </a>

        <button class="text-gray-700 dark:text-white md:hidden focus:outline-none"
                @onclick="ToggleNavMenu"
                aria-controls="navbarMenu"
                aria-expanded="@isNavOpen"
                aria-label="Toggle navigation">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
        </button>

        <div class="@($"w-full md:flex md:items-center md:w-auto {(isNavOpen ? "" : "hidden")}")" id="navbarMenu">
            <ul class="flex flex-col mt-0.5 md:flex-row md:space-x-3 md:mt-0 w-full md:justify-end">
                <li class="text-right md:text-left flex-grow">
                    <button class="btn nav-link" @onclick="ChangeLanguage" title="@PMWebResource.ToggleLanguage" aria-label="@PMWebResource.ToggleLanguage">
                        @((MarkupString)(IsEnglishCulture ? Icons.EN : Icons.SE))
                    </button>
                </li>

                <li class="text-right md:text-left flex-grow">
                    <button class="btn nav-link" @onclick="ToggleTheme" title="@PMWebResource.ToggleTheme" aria-label="@PMWebResource.ToggleTheme">
                        <span>@((MarkupString)(IsDark ? Icons.Sun : Icons.DarkMode))</span>
                    </button>
                </li>

                <AuthorizeView Roles="@PMRolesConst.Tenant.AdminManger">
                    <li class="text-right md:text-left flex-grow">
                        <button class="btn nav-link" @onclick='@(() => OpenDialog("org"))' title="@PMWebResource.AdminSettings" aria-label="@PMWebResource.AdminSettings">
                            @((MarkupString)Icons.Company)
                        </button>
                    </li>
                </AuthorizeView>

                <li class="text-right md:text-left flex-grow">
                    <button class="btn nav-link" @onclick='@(() => OpenDialog("control"))' title="@PMWebResource.Settings" aria-label="@PMWebResource.Settings">
                        <span aria-hidden="true">@((MarkupString)Icons.Settings)</span>
                    </button>
                </li>

                <li class="text-right md:text-left flex-grow">
                    <button class="btn nav-link" @onclick="PersonalSettingFun" title="@PMResourceIdentity.Menu_Profile" aria-label="@PMResourceIdentity.Menu_Profile">
                        <span aria-hidden="true">@((MarkupString)Icons.Person)</span>
                    </button>
                </li>

                <li class="text-right md:text-left flex-grow">
                    <form action="/Account/Logout" method="post" class="inline">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit" class="btn nav-link flex items-center space-x-2" title="@PMResourceIdentity.logout" aria-label="@PMResourceIdentity.logout">
                            <span aria-hidden="true">@((MarkupString)Icons.Logout)</span>
                        </button>
                    </form>
                </li>
            </ul>
        </div>
    </div>
</nav>

@if (!string.IsNullOrEmpty(Page))
{
    <div aria-hidden="true">
        <div class="fixed inset-0 bg-black/50 backdrop-blur-[2px]" @onclick="CloseDialog"></div>
        <div class="fixed inset-0 flex items-center justify-center pointer-events-none" style="z-index:17;">
            <div class="pointer-events-auto w-[90vw] h-[90vh] rounded-2xl bg-white text-slate-900 shadow-2xl ring-1 ring-black/5
                                dark:bg-slate-800 dark:text-slate-100 dark:ring-white/10 box-border flex flex-col overflow-hidden">
                <div class="p-5 flex items-start justify-between gap-4 border-b border-slate-200 dark:border-slate-700">
                    <div>
                        <h2 class="text-xl font-semibold">@GetDialogTitle()</h2>
                        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">@PMWebResource.SettingsDescription</p>
                    </div>
                    <button type="button"
                            class="rounded-lg px-2.5 py-1.5 text-sm ring-1 ring-slate-300/60 hover:bg-slate-100 dark:ring-slate-700/60 dark:hover:bg-slate-700/50"
                            @onclick="CloseDialog"
                            aria-label="@PMWebResource.Close"
                            title="@PMWebResource.Close">
                        ×
                    </button>
                </div>
                <div class="flex-1 p-5 overflow-auto">
                    @if (Page == "control")
                    {
                        <Control />
                    }
                    else if (Page == "identity")
                    {
                        <PersonalSettings />
                    }
                    else if (Page == "org")
                    {
                        <Control ActiveKey="organisation" />
                    }
                </div>
            </div>
        </div>
    </div>
}


@code {
    private string Page = string.Empty;
    private string? currentUrl;
    private bool IsDark;
    private bool isNavOpen;

    [Parameter] public EventCallback<string> OnMenuClick { get; set; }

    private bool IsEnglishCulture => CultureInfo.CurrentCulture.Name == "en-US";

    protected override void OnInitialized()
    {
        currentUrl = _navigationManager.ToBaseRelativePath(_navigationManager.Uri);
        _navigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = _navigationManager.ToBaseRelativePath(e.Location);
        _ = SyncThemeAfterNavigationAsync();
    }

    private async Task SyncThemeAfterNavigationAsync()
    {
        try
        {
            var currentTheme = await JS.InvokeAsync<string>("getCurrentTheme");
            IsDark = currentTheme == "dark";
        }
        catch
        {
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleTheme()
    {
        var newTheme = await JS.InvokeAsync<string>("toggleDarkClass");
        IsDark = newTheme == "dark";
        await InvokeAsync(StateHasChanged);
    }

    private void OpenDialog(string ty)
    {
        Page = ty;
        isNavOpen = false;
    }

    private void PersonalSettingFun() => _navigationManager.NavigateTo("Account/Manage", true);

    private void ToggleNavMenu() => isNavOpen = !isNavOpen;

    private void CloseDialog() => Page = string.Empty;

    private string GetDialogTitle() => Page switch
    {
        "org" => PMWebResource.AdminSettings,
        _ => PMWebResource.Settings
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var currentTheme = await JS.InvokeAsync<string>("getCurrentTheme");
            IsDark = currentTheme == "dark";
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
        }
    }

    private async Task ChangeLanguage()
    {
        var newCulture = CultureInfo.CurrentCulture.Name == "sv-SE" || string.IsNullOrEmpty(CultureInfo.CurrentCulture.Name)
            ? "en-US"
            : "sv-SE";

        await JS.InvokeVoidAsync("blazorCulture.set", newCulture);
        _navigationManager.NavigateTo(_navigationManager.Uri, forceLoad: true);
    }

    public void Dispose()
    {
        _navigationManager.LocationChanged -= OnLocationChanged;
    }
}
