@using System.Globalization
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.JSInterop
@using ProjectManagement.Client.Pages.Project.ProjectPages
@using ProjectManagement.Shared
@implements IDisposable
@inject MhdServices MHD

@inject NavigationManager _navigationManager
@inject IJSRuntime JS
@inject SignInManager<ApplicationUser> SignInManager

<nav class="relative z-[1000] overflow-visible">
    <div class="w-full flex flex-wrap items-center justify-between overflow-visible p-0.5">
        <a class="flex items-center" href="/" aria-label="@PMWebResource.ProjectManagementHome">
            <img src="Icons/Logo.png" alt="Logo" class="h-8 w-auto" />
        </a>

        <button class="text-gray-700 dark:text-white md:hidden focus:outline-none"
                @onclick="ToggleNavMenu"
                aria-controls="navbarMenu"
                aria-expanded="@isNavOpen"
                aria-label="@PMWebResource.ToggleNavigation">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
        </button>

        <div class="@($"w-full md:flex md:items-center md:w-auto {(isNavOpen ? "" : "hidden")}")" id="navbarMenu">
            @* Clean topbar: only the four most-used quick actions.
               Prislistor | Språk | Notiser | Användare.
               Tema, Support and Kunder & leverantörer live under the user (Användare) menu. *@
            <ul class="mt-0.5 flex w-full flex-col gap-1 md:mt-0 md:w-auto md:flex-row md:flex-wrap md:items-center md:justify-end md:gap-2">

                <li class="text-right md:text-left md:flex-none">
                    <button class="btn nav-link" @onclick="PriceList" title="Prislistor" aria-label="Prislistor">
                        <span aria-hidden="true">@((MarkupString)Icons.PriceTag)</span>
                    </button>
                </li>
                <li class="text-right md:text-left md:flex-none">
                    <button class="btn nav-link" @onclick="ChangeLanguage" title="Språk" aria-label="Språk">
                        @((MarkupString)(IsEnglishCulture ? Icons.EN : Icons.SE))
                    </button>
                </li>
                <li class="text-right md:text-left md:flex-none">
                    <NotificationBell />
                </li>
                <li class="relative text-right md:text-left md:flex-none">
                    <button class="btn nav-link"
                            @ref="_profileButtonRef"
                            @onclick="ToggleProfileMenu"
                            title="Användare"
                            aria-label="Användare"
                            aria-haspopup="menu"
                            aria-expanded="@isProfileMenuOpen">
                        <span aria-hidden="true">@((MarkupString)Icons.Person)</span>
                    </button>
                </li>
            </ul>
        </div>
    </div>
</nav>

@if (isProfileMenuOpen)
{
    <div class="fixed inset-0 z-[2147483646]" @onclick="CloseProfileMenu" aria-hidden="true"></div>
    <div class="fixed z-[2147483647] overflow-hidden rounded-lg border border-slate-200 bg-white py-1 text-left shadow-2xl ring-1 ring-black/5 dark:border-slate-700 dark:bg-slate-900 dark:ring-white/10"
         style="@ProfileMenuStyle"
         role="menu"
         aria-label="Användarmeny">
        <button type="button"
                class="flex w-full items-center gap-2.5 px-3 py-2 text-left text-sm font-medium text-slate-700 transition hover:bg-slate-100 focus:bg-slate-100 focus:outline-none dark:text-slate-200 dark:hover:bg-slate-800 dark:focus:bg-slate-800"
                role="menuitem"
                @onclick="PersonalSettingFun">
            <span class="inline-flex h-5 w-5 shrink-0 items-center justify-center text-slate-500 dark:text-slate-400" aria-hidden="true">@((MarkupString)Icons.Person)</span>
            <span>Min profil</span>
        </button>
        <button type="button"
                class="flex w-full items-center gap-2.5 px-3 py-2 text-left text-sm text-slate-700 transition hover:bg-slate-100 focus:bg-slate-100 focus:outline-none dark:text-slate-200 dark:hover:bg-slate-800 dark:focus:bg-slate-800"
                role="menuitem"
                @onclick="OpenMySettings">
            <span class="inline-flex h-5 w-5 shrink-0 items-center justify-center text-slate-500 dark:text-slate-400" aria-hidden="true">@((MarkupString)Icons.Settings)</span>
            <span>Mina inställningar</span>
        </button>
        <button type="button"
                class="flex w-full items-center gap-2.5 px-3 py-2 text-left text-sm text-slate-700 transition hover:bg-slate-100 focus:bg-slate-100 focus:outline-none dark:text-slate-200 dark:hover:bg-slate-800 dark:focus:bg-slate-800"
                role="menuitem"
                @onclick="ToggleTheme">
            <span class="inline-flex h-5 w-5 shrink-0 items-center justify-center text-slate-500 dark:text-slate-400" aria-hidden="true">@((MarkupString)(IsDark ? Icons.Sun : Icons.Moon))</span>
            <span>Byt tema</span>
        </button>
        <button type="button"
                class="flex w-full items-center gap-2.5 px-3 py-2 text-left text-sm text-slate-700 transition hover:bg-slate-100 focus:bg-slate-100 focus:outline-none dark:text-slate-200 dark:hover:bg-slate-800 dark:focus:bg-slate-800"
                role="menuitem"
                @onclick="OpenSupport">
            <span class="inline-flex h-5 w-5 shrink-0 items-center justify-center text-slate-500 dark:text-slate-400" aria-hidden="true">@((MarkupString)Icons.Support)</span>
            <span>Support</span>
        </button>
        <div class="my-1 border-t border-slate-200 dark:border-slate-700" role="separator"></div>
        <form action="/Account/Logout" method="post">
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="@currentUrl" />
            <button type="submit"
                    class="flex w-full items-center gap-2.5 px-3 py-2 text-left text-sm text-slate-700 transition hover:bg-slate-100 focus:bg-slate-100 focus:outline-none dark:text-slate-200 dark:hover:bg-slate-800 dark:focus:bg-slate-800"
                    role="menuitem"
                    @onclick="CloseProfileMenu">
                <span class="inline-flex h-5 w-5 shrink-0 items-center justify-center text-slate-500 dark:text-slate-400" aria-hidden="true">@((MarkupString)Icons.Logout)</span>
                <span>Logga ut</span>
            </button>
        </form>
    </div>
}


@code {
    private string? currentUrl;
    private bool IsDark;
    private bool isNavOpen;
    private bool isProfileMenuOpen;
    private bool _profileMenuPositionPending;
    private bool _profileMenuPositioned;
    private ElementReference _profileButtonRef;
    private DotNetObjectReference<NavMenu>? _dotNetRef;
    private UserMenuPosition _profileMenuPosition = new(44, 8, 176, 320);

    private string ProfileMenuStyle
        => _profileMenuPositioned
            ? $"top:{_profileMenuPosition.Top}px;left:{_profileMenuPosition.Left}px;width:{_profileMenuPosition.Width}px;max-height:{_profileMenuPosition.MaxHeight}px;"
            : "top:2.75rem;right:0.5rem;width:11rem;max-height:calc(100vh - 3.5rem);";

    [Parameter] public EventCallback<string> OnMenuClick { get; set; }

    private bool IsEnglishCulture => CultureInfo.CurrentUICulture.Name == "en-US";

    protected override void OnInitialized()
    {
        currentUrl = _navigationManager.ToBaseRelativePath(_navigationManager.Uri);
        _navigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = _navigationManager.ToBaseRelativePath(e.Location);
        _ = SyncThemeAfterNavigationAsync();
    }

    private async Task SyncThemeAfterNavigationAsync()
    {
        try
        {
            var currentTheme = await JS.InvokeAsync<string>("getCurrentTheme");
            IsDark = currentTheme == "dark";
        }
        catch
        {
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleTheme()
    {
        await CloseProfileMenuAsync();
        var newTheme = await JS.InvokeAsync<string>("toggleDarkClass");
        IsDark = newTheme == "dark";
        await InvokeAsync(StateHasChanged);
    }

    // "Mina inställningar" — the user's own work settings (Mina mallar + Kunder & leverantörer).
    // The Control component gates its tabs by role: admins additionally see the full admin settings,
    // regular users only see their own templates and the customer/supplier register.
    private async Task OpenMySettings()
    {
        isNavOpen = false;
        await CloseProfileMenuAsync();
        MHD.Modal.ShowComponent<Components.ControlComponents.Control>(
            "Mina inställningar", null, MhdDialogSize.FullScreen);
    }

    private void ToggleProfileMenu()
    {
        isProfileMenuOpen = !isProfileMenuOpen;
        isNavOpen = false;
        _profileMenuPositioned = false;
        _profileMenuPositionPending = isProfileMenuOpen;

        if (isProfileMenuOpen)
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            _ = JS.InvokeVoidAsync("projectManagementUserMenu.enableEscape", _dotNetRef);
        }
        else
        {
            _ = JS.InvokeVoidAsync("projectManagementUserMenu.disableEscape");
        }
    }

    private async Task PersonalSettingFun()
    {
        await CloseProfileMenuAsync();
        _navigationManager.NavigateTo("Account/Manage", true);
    }

    private void CloseProfileMenu()
    {
        _ = CloseProfileMenuAsync();
    }

    [JSInvokable]
    public async Task CloseProfileMenuFromJs()
    {
        await CloseProfileMenuAsync();
    }

    private async Task CloseProfileMenuAsync()
    {
        if (!isProfileMenuOpen)
        {
            return;
        }

        isProfileMenuOpen = false;
        _profileMenuPositionPending = false;
        _profileMenuPositioned = false;

        try
        {
            await JS.InvokeVoidAsync("projectManagementUserMenu.disableEscape");
        }
        catch
        {
        }

        await InvokeAsync(StateHasChanged);
    }
    private async Task OpenSupport()
    {
        isNavOpen = false;
        await CloseProfileMenuAsync();
        MHD.Modal.ShowComponent<Components.Support.SupportUI>(
            PMWebResource.SupportNavTitle, null, MhdDialogSize.Large);
    }

    private void ToggleNavMenu()
    {
        isNavOpen = !isNavOpen;
        isProfileMenuOpen = false;
    }

    void PriceList()
    {
        isProfileMenuOpen = false;
        MHD.Modal.ShowComponent<Components.ControlComponents.PriceImport.PriceImportJobsPage>(
            "Prislistor", null, MhdDialogSize.FullScreen);
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var currentTheme = await JS.InvokeAsync<string>("getCurrentTheme");
                IsDark = currentTheme == "dark";
                await InvokeAsync(StateHasChanged);
            }
            catch
            {
            }
        }

        if (isProfileMenuOpen && _profileMenuPositionPending)
        {
            _profileMenuPositionPending = false;

            try
            {
                _profileMenuPosition = await JS.InvokeAsync<UserMenuPosition>(
                    "projectManagementUserMenu.getPosition",
                    _profileButtonRef,
                    192);
                _profileMenuPositioned = true;
                await InvokeAsync(StateHasChanged);
            }
            catch
            {
            }
        }
    }

    private async Task ChangeLanguage()
    {
        isProfileMenuOpen = false;
        var newCulture = CultureInfo.CurrentUICulture.Name == "sv-SE" || string.IsNullOrEmpty(CultureInfo.CurrentUICulture.Name)
            ? "en-US"
            : "sv-SE";

        await JS.InvokeVoidAsync("blazorCulture.set", newCulture);
        _navigationManager.NavigateTo(_navigationManager.Uri, forceLoad: true);
    }

    public void Dispose()
    {
        _navigationManager.LocationChanged -= OnLocationChanged;
        _dotNetRef?.Dispose();
        _ = JS.InvokeVoidAsync("projectManagementUserMenu.disableEscape");
    }

    private sealed record UserMenuPosition(double Top, double Left, double Width, double MaxHeight);
}
