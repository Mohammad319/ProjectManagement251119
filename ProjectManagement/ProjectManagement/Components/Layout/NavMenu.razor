@using System.Globalization
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.JSInterop
@using ProjectManagement.Components.ControlComponents
@using ProjectManagement.Components.ControlComponents.Project
@using ProjectManagement.Client.Pages.Project.ProjectPages
@using ProjectManagement.Shared
@implements IDisposable
@inject MhdServices MHD

@inject NavigationManager _navigationManager
@inject IJSRuntime JS
@inject SignInManager<ApplicationUser> SignInManager

<nav>
    <div class="w-full flex flex-wrap items-center justify-between p-0.5">
        <a class="flex items-center" href="/" aria-label="@PMWebResource.ProjectManagementHome">
            <img src="Icons/Logo.png" alt="Logo" class="h-8 w-auto" />
        </a>

        <button class="text-gray-700 dark:text-white md:hidden focus:outline-none"
                @onclick="ToggleNavMenu"
                aria-controls="navbarMenu"
                aria-expanded="@isNavOpen"
                aria-label="@PMWebResource.ToggleNavigation">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
        </button>

        <div class="@($"w-full md:flex md:items-center md:w-auto {(isNavOpen ? "" : "hidden")}")" id="navbarMenu">
            <ul class="mt-0.5 flex w-full flex-col gap-1 md:mt-0 md:w-auto md:flex-row md:flex-wrap md:items-center md:justify-end md:gap-2">
                <li class="text-right md:text-left md:flex-none">
                    <button class="btn nav-link" @onclick="ChangeLanguage" title="@PMWebResource.ToggleLanguage" aria-label="@PMWebResource.ToggleLanguage">
                        @((MarkupString)(IsEnglishCulture ? Icons.EN : Icons.SE))
                    </button>
                </li>

                <li class="text-right md:text-left md:flex-none">
                    <button class="btn nav-link" @onclick="ToggleTheme" title="@PMWebResource.ToggleTheme" aria-label="@PMWebResource.ToggleTheme">
                        <span>@((MarkupString)(IsDark ? Icons.Sun : Icons.DarkMode))</span>
                    </button>
                </li>

                <AuthorizeView Roles="@PMRolesConst.Tenant.AdminManger">
                    <li class="text-right md:text-left md:flex-none">
                        <button class="btn nav-link" @onclick="OpenOrgDialog" title="@PMWebResource.AdminSettings" aria-label="@PMWebResource.AdminSettings">
                            @((MarkupString)Icons.Company)
                        </button>
                    </li>
                </AuthorizeView>

                <li class="text-right md:text-left md:flex-none">
                    <button class="btn nav-link" @onclick="PriceList" title="Prisimport" aria-label="Prisimport">
                        <span aria-hidden="true">@((MarkupString)Icons.ImportFromCloud)</span>
                    </button>
                </li>

                <li class="text-right md:text-left md:flex-none">
                    <button class="btn nav-link" @onclick="OpenControlDialog" title="@PMWebResource.Settings" aria-label="@PMWebResource.Settings">
                        <span aria-hidden="true">@((MarkupString)Icons.Settings)</span>
                    </button>
                </li>

                <li class="text-right md:text-left md:flex-none">
                    <button class="btn nav-link" @onclick="OpenSupport" title="@PMWebResource.SupportNavTitle" aria-label="@PMWebResource.SupportNavTitle">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"/>
                            <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>
                            <line x1="12" y1="17" x2="12.01" y2="17"/>
                        </svg>
                    </button>
                </li>

                <li class="text-right md:text-left md:flex-none">
                    <button class="btn nav-link" @onclick="PersonalSettingFun" title="@PMResourceIdentity.Menu_Profile" aria-label="@PMResourceIdentity.Menu_Profile">
                        <span aria-hidden="true">@((MarkupString)Icons.Person)</span>
                    </button>
                </li>

                <li class="text-right md:text-left md:flex-none">
                    <CentralReportsMenu />
                </li>

                <li class="text-right md:text-left md:flex-none">
                    <form action="/Account/Logout" method="post" class="inline">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit" class="btn nav-link flex items-center space-x-2" title="@PMResourceIdentity.logout" aria-label="@PMResourceIdentity.logout">
                            <span aria-hidden="true">@((MarkupString)Icons.Logout)</span>
                        </button>
                    </form>
                </li>
            </ul>
        </div>
    </div>
</nav>


@code {
    private string? currentUrl;
    private bool IsDark;
    private bool isNavOpen;

    [Parameter] public EventCallback<string> OnMenuClick { get; set; }

    private bool IsEnglishCulture => CultureInfo.CurrentUICulture.Name == "en-US";

    protected override void OnInitialized()
    {
        currentUrl = _navigationManager.ToBaseRelativePath(_navigationManager.Uri);
        _navigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = _navigationManager.ToBaseRelativePath(e.Location);
        _ = SyncThemeAfterNavigationAsync();
    }

    private async Task SyncThemeAfterNavigationAsync()
    {
        try
        {
            var currentTheme = await JS.InvokeAsync<string>("getCurrentTheme");
            IsDark = currentTheme == "dark";
        }
        catch
        {
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleTheme()
    {
        var newTheme = await JS.InvokeAsync<string>("toggleDarkClass");
        IsDark = newTheme == "dark";
        await InvokeAsync(StateHasChanged);
    }

    private void OpenControlDialog()
    {
        isNavOpen = false;
        MHD.Modal.ShowComponent<Components.ControlComponents.Control>(
            PMWebResource.Settings, null, DialogSize.FullScreen);
    }

    private void OpenOrgDialog()
    {
        isNavOpen = false;
        MHD.Modal.ShowComponent<Components.ControlComponents.Control>(
            PMWebResource.AdminSettings,
            new Dictionary<string, object> { ["ActiveKey"] = "organisation" },
            DialogSize.FullScreen);
    }

    private void PersonalSettingFun() => _navigationManager.NavigateTo("Account/Manage", true);
    private void OpenSupport()
    {
        isNavOpen = false;
        MHD.Modal.ShowComponent<Components.Support.SupportUI>(
            PMWebResource.SupportNavTitle, null, DialogSize.Large);
    }

    private void ToggleNavMenu() => isNavOpen = !isNavOpen;

    void PriceList()
    {
        MHD.Modal.ShowComponent<Components.ControlComponents.PriceImport.PriceImportJobsPage>(
            "Price List", null, DialogSize.FullScreen);
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var currentTheme = await JS.InvokeAsync<string>("getCurrentTheme");
            IsDark = currentTheme == "dark";
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
        }
    }

    private async Task ChangeLanguage()
    {
        var newCulture = CultureInfo.CurrentUICulture.Name == "sv-SE" || string.IsNullOrEmpty(CultureInfo.CurrentUICulture.Name)
            ? "en-US"
            : "sv-SE";

        await JS.InvokeVoidAsync("blazorCulture.set", newCulture);
        _navigationManager.NavigateTo(_navigationManager.Uri, forceLoad: true);
    }

    public void Dispose()
    {
        _navigationManager.LocationChanged -= OnLocationChanged;
    }
}
