<StatusMessage Message="@StatusMessage" />
<h3 class="text-xl font-semibold text-gray-900 dark:text-gray-100">@PMIdentityText.RecoveryCodesTitle</h3>

<div role="alert"
     class="mt-3 rounded-lg border border-yellow-300 bg-yellow-50 p-4 text-yellow-900
         dark:border-yellow-700/60 dark:bg-yellow-950 dark:text-yellow-100">
    <p class="font-semibold">@PMIdentityText.StoreRecoveryCodesSafely</p>
    <p class="mt-2">
        @PMIdentityText.LoseAccessWithoutRecoveryCodes
    </p>
</div>

<div class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
    @foreach (var recoveryCode in RecoveryCodes)
    {
        <div class="rounded-md bg-gray-100 px-3 py-2 text-center font-mono text-sm text-gray-800 shadow-sm
                        dark:bg-gray-800 dark:text-gray-100">
            <code>@recoveryCode</code>
        </div>
    }
</div>

@code {
    [Parameter]
    public string[] RecoveryCodes { get; set; } = [];

    [Parameter]
    public string? StatusMessage { get; set; }
}
