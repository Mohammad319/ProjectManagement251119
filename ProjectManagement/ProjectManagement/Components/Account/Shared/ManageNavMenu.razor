@using Microsoft.AspNetCore.Identity
@using ProjectManagement.Shared
@inject SignInManager<ApplicationUser> SignInManager

<ul class="flex flex-col space-y-1">
    <li>
        <a href="/"
           class="block rounded-md px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 hover:text-blue-700
              dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-blue-400"
           data-enhance-nav="false">
            ⬅ @PMResourceIdentity.Nav_BackToHome
        </a>
    </li>

    <li>
        <NavLink class="block rounded-md px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 hover:text-blue-700
             dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-blue-400"
                 activeClass="bg-blue-100 text-blue-700 dark:bg-blue-900/50 dark:text-blue-300"
                 href="Account/Manage"
                 Match="NavLinkMatch.All">
            @PMResourceIdentity.Menu_Profile
        </NavLink>
    </li>

    <li>
        <NavLink class="block rounded-md px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 hover:text-blue-700
             dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-blue-400"
                 activeClass="bg-blue-100 text-blue-700 dark:bg-blue-900/50 dark:text-blue-300"
                 href="Account/Manage/Email">
            Email
        </NavLink>
    </li>

    <li>
        <NavLink class="block rounded-md px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 hover:text-blue-700
             dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-blue-400"
                 activeClass="bg-blue-100 text-blue-700 dark:bg-blue-900/50 dark:text-blue-300"
                 href="Account/Manage/ChangePassword">
            @PMResourceIdentity.password
        </NavLink>
    </li>


    <li>
        <NavLink class="block rounded-md px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 hover:text-blue-700
             dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-blue-400"
                 activeClass="bg-blue-100 text-blue-700 dark:bg-blue-900/50 dark:text-blue-300"
                 href="Account/Manage/TwoFactorAuthentication">
            @PMResourceIdentity.Security_TwoFactorAuthentication
        </NavLink>
    </li>

    <li>
        <NavLink class="block rounded-md px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 hover:text-blue-700
             dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-blue-400"
                 activeClass="bg-blue-100 text-blue-700 dark:bg-blue-900/50 dark:text-blue-300"
                 href="Account/Manage/Passkeys">
            @PMIdentityText.PasskeysLabel
        </NavLink>
    </li>

    <li>
        <NavLink class="block rounded-md px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 hover:text-blue-700
             dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-blue-400"
                 activeClass="bg-blue-100 text-blue-700 dark:bg-blue-900/50 dark:text-blue-300"
                 href="Account/Manage/PersonalData">
            @PMResourceIdentity.Label_PersonalData
        </NavLink>
    </li>

    <li>
        <NavLink class="block rounded-md px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 hover:text-blue-700
             dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-blue-400"
                 activeClass="bg-blue-100 text-blue-700 dark:bg-blue-900/50 dark:text-blue-300"
                 href="Account/Manage/Impressum">
            Impressum
        </NavLink>
    </li>
    <li>
        <NavLink class="block rounded-md px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 hover:text-blue-700
             dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-blue-400"
                 activeClass="bg-blue-100 text-blue-700 dark:bg-blue-900/50 dark:text-blue-300"
                 href="Account/Manage/legal">
            Legal
        </NavLink>
    </li>
    <li>
        <NavLink class="block rounded-md px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 hover:text-blue-700
             dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-blue-400"
                 activeClass="bg-blue-100 text-blue-700 dark:bg-blue-900/50 dark:text-blue-300"
                 href="Account/Manage/Privacy">
            Privacy
        </NavLink>
    </li>
    <li>
        <NavLink class="block rounded-md px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 hover:text-blue-700
             dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-blue-400"
                 activeClass="bg-blue-100 text-blue-700 dark:bg-blue-900/50 dark:text-blue-300"
                 href="Account/Manage/Terms">
            @PMAppFormatResource.TabTerms
        </NavLink>
    </li>
    <li>
        <NavLink class="block rounded-md px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 hover:text-blue-700
             dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-blue-400"
                 activeClass="bg-blue-100 text-blue-700 dark:bg-blue-900/50 dark:text-blue-300"
                 href="Account/Manage/Libraries">
            @PMResourceIdentity.Label_ThirdParty
        </NavLink>
    </li>
</ul>

