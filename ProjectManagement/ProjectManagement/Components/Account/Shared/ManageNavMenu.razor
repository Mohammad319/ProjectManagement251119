@using Microsoft.AspNetCore.Identity
@using ProjectManagement.Shared
@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager Nav

@{
    // Only three main sections — the details live as internal tabs on each section page
    // (see ManageSectionTabs). Active state uses a filled + ring look so hover can never
    // be mistaken for the current page.
    const string ItemBase = "flex items-center gap-2.5 rounded-md px-3 py-2 text-sm font-medium text-slate-600 transition hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-slate-100";
    const string ItemActive = "flex items-center gap-2.5 rounded-md px-3 py-2 text-sm font-semibold bg-sky-50 text-sky-700 ring-1 ring-inset ring-sky-200 dark:bg-sky-900/40 dark:text-sky-200 dark:ring-sky-800";
}

<nav class="flex flex-col">
    <a href="/"
       class="mb-2 flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium text-slate-500 transition hover:bg-slate-100 hover:text-slate-800 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-slate-100"
       data-enhance-nav="false">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="19" y1="12" x2="5" y2="12" />
            <polyline points="12 19 5 12 12 5" />
        </svg>
        @PMResourceIdentity.Nav_BackToHome
    </a>

    <ul class="flex flex-col space-y-1">
        <li>
            <a href="Account/Manage" class="@(ActiveSection == "konto" ? ItemActive : ItemBase)">
                Konto
            </a>
        </li>
        <li>
            <a href="Account/Manage/TwoFactorAuthentication" class="@(ActiveSection == "sakerhet" ? ItemActive : ItemBase)">
                Säkerhet
            </a>
        </li>
        <li>
            <a href="Account/Manage/PersonalData" class="@(ActiveSection == "juridik" ? ItemActive : ItemBase)">
                Data &amp; juridik
            </a>
        </li>
    </ul>
</nav>

@code {
    private static readonly string[] SakerhetPaths =
    [
        "/account/manage/twofactorauthentication", "/account/manage/enableauthenticator",
        "/account/manage/disable2fa", "/account/manage/resetauthenticator",
        "/account/manage/generaterecoverycodes", "/account/manage/passkeys", "/account/manage/renamepasskey"
    ];

    private static readonly string[] JuridikPaths =
    [
        "/account/manage/personaldata", "/account/manage/privacy", "/account/manage/terms",
        "/account/manage/impressum", "/account/manage/libraries"
    ];

    private string ActiveSection
    {
        get
        {
            var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/').ToLowerInvariant();
            if (SakerhetPaths.Contains(path))
                return "sakerhet";
            if (JuridikPaths.Contains(path))
                return "juridik";
            return "konto";
        }
    }
}
