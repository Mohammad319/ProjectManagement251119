@using Microsoft.AspNetCore.Identity
@using ProjectManagement.Shared
@inject SignInManager<ApplicationUser> SignInManager
@inject Microsoft.Extensions.Localization.IStringLocalizer<PMResourceLegal> L

@{
    // Shared item styling. Active state uses a distinct filled + ring look so hover (a plain
    // slate wash) can never be mistaken for the current page.
    const string ItemBase = "flex items-center gap-2.5 rounded-md px-3 py-2 text-sm font-medium text-slate-600 transition hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-slate-100";
    const string ItemActive = "bg-sky-50 text-sky-700 font-semibold ring-1 ring-inset ring-sky-200 dark:bg-sky-900/40 dark:text-sky-200 dark:ring-sky-800";
    const string GroupLabel = "px-3 pb-1 pt-4 text-[11px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500";
}

<nav class="flex flex-col">
    <a href="/"
       class="mb-2 flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium text-slate-500 transition hover:bg-slate-100 hover:text-slate-800 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-slate-100"
       data-enhance-nav="false">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="19" y1="12" x2="5" y2="12" />
            <polyline points="12 19 5 12 12 5" />
        </svg>
        @PMResourceIdentity.Nav_BackToHome
    </a>

    <div class="@GroupLabel">Konto</div>
    <ul class="flex flex-col space-y-1">
        <li>
            <NavLink class="@ItemBase" activeClass="@ItemActive" href="Account/Manage" Match="NavLinkMatch.All">
                @PMResourceIdentity.Menu_Profile
            </NavLink>
        </li>
        <li>
            <NavLink class="@ItemBase" activeClass="@ItemActive" href="Account/Manage/Email">
                E-post
            </NavLink>
        </li>
        <li>
            <NavLink class="@ItemBase" activeClass="@ItemActive" href="Account/Manage/ChangePassword">
                @PMResourceIdentity.password
            </NavLink>
        </li>
    </ul>

    <div class="@GroupLabel">Säkerhet</div>
    <ul class="flex flex-col space-y-1">
        <li>
            <NavLink class="@ItemBase" activeClass="@ItemActive" href="Account/Manage/TwoFactorAuthentication">
                @PMResourceIdentity.Security_TwoFactorAuthentication
            </NavLink>
        </li>
        <li>
            <NavLink class="@ItemBase" activeClass="@ItemActive" href="Account/Manage/Passkeys">
                @PMIdentityText.PasskeysLabel
            </NavLink>
        </li>
    </ul>

    <div class="@GroupLabel">Data &amp; juridik</div>
    <ul class="flex flex-col space-y-1">
        <li>
            <NavLink class="@ItemBase" activeClass="@ItemActive" href="Account/Manage/PersonalData">
                @PMResourceIdentity.Label_PersonalData
            </NavLink>
        </li>
        <li>
            <NavLink class="@ItemBase" activeClass="@ItemActive" href="Account/Manage/Privacy">
                @L["legalTabPrivacy"]
            </NavLink>
        </li>
        <li>
            <NavLink class="@ItemBase" activeClass="@ItemActive" href="Account/Manage/Terms">
                @L["legalTabTerms"]
            </NavLink>
        </li>
        <li>
            <NavLink class="@ItemBase" activeClass="@ItemActive" href="Account/Manage/Impressum">
                Impressum
            </NavLink>
        </li>
        <li>
            <NavLink class="@ItemBase" activeClass="@ItemActive" href="Account/Manage/Libraries">
                @PMResourceIdentity.Label_ThirdParty
            </NavLink>
        </li>
    </ul>
</nav>
