@page "/Account/ResetPasswordConfirmation"
@using ProjectManagement.Shared
<PageTitle>@PMResourceIdentity.Title_ResetPasswordConfirmation</PageTitle>

<div class="mx-auto max-w-xl py-6">
    <div class="rounded-3xl border border-emerald-200 bg-emerald-50 p-6 shadow-sm dark:border-emerald-900/50 dark:bg-emerald-950/30 sm:p-8">
        <h1 class="text-2xl font-bold tracking-tight text-emerald-900 dark:text-emerald-100">@PMResourceIdentity.Title_ResetPasswordConfirmation</h1>
        <p role="alert" class="mt-3 text-sm leading-6 text-emerald-800 dark:text-emerald-200">
            Your password has been reset. Please
            <a href="Account/Login" class="font-semibold underline underline-offset-2 hover:no-underline">
                @PMResourceIdentity.login
            </a>.
        </p>
    </div>
</div>
