@page "/Account/Manage/TwoFactorAuthentication"

@using Microsoft.AspNetCore.Http.Features
@using Microsoft.AspNetCore.Identity

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>@PMIdentityText.TwoFactorAuthenticationTitleWithSuffix</PageTitle>

<StatusMessage />
<h3 class="text-xl font-semibold text-gray-900 dark:text-gray-100">
    @PMIdentityText.TwoFactorAuthenticationTitleWithSuffix
</h3>

@if (canTrack)
{
    @if (is2faEnabled)
    {
        @if (recoveryCodesLeft == 0)
        {
            <div role="alert"
                 class="mt-3 rounded-lg border border-red-300 bg-red-50 p-4 text-red-900
                              dark:border-red-900/50 dark:bg-red-950 dark:text-red-100">
                <strong class="block">@PMIdentityText.NoRecoveryCodesLeft</strong>
                <p class="mt-1">
                    You must
                    <a href="/Account/Manage/GenerateRecoveryCodes"
                       class="font-medium underline underline-offset-2 hover:no-underline text-red-800 dark:text-red-200">
                        @PMIdentityText.GenerateNewRecoveryCodes
                    </a>
                    @PMIdentityText.BeforeLoginWithRecoveryCode
                </p>
            </div>
        }
        else if (recoveryCodesLeft == 1)
        {
            <div role="alert"
                 class="mt-3 rounded-lg border border-red-300 bg-red-50 p-4 text-red-900
                              dark:border-red-900/50 dark:bg-red-950 dark:text-red-100">
                <strong class="block">@PMIdentityText.OneRecoveryCodeLeft</strong>
                <p class="mt-1">
                    You can
                    <a href="/Account/Manage/GenerateRecoveryCodes"
                       class="font-medium underline underline-offset-2 hover:no-underline text-red-800 dark:text-red-200">
                        @PMIdentityText.GenerateNewRecoveryCodes
                    </a>.
                </p>
            </div>
        }
        else if (recoveryCodesLeft <= 3)
        {
            <div role="alert"
                 class="mt-3 rounded-lg border border-yellow-300 bg-yellow-50 p-4 text-yellow-900
                              dark:border-yellow-700/60 dark:bg-yellow-950 dark:text-yellow-100">
                <strong class="block">@PMIdentityText.Format(PMIdentityText.RecoveryCodesLeftFormat, recoveryCodesLeft)</strong>
                <p class="mt-1">
                    @PMIdentityText.YouShouldGenerateRecoveryCodes
                    <a href="/Account/Manage/GenerateRecoveryCodes"
                       class="font-medium underline underline-offset-2 hover:no-underline text-yellow-800 dark:text-yellow-200">
                        @PMIdentityText.GenerateNewRecoveryCodes
                    </a>.
                </p>
            </div>
        }

        <div class="mt-4 flex flex-wrap items-center gap-3">
            @if (isMachineRemembered)
            {
                <form class="inline-block"
                      @formname="forget-browser"
                      @onsubmit="OnSubmitForgetBrowserAsync"
                      method="post">
                    <AntiforgeryToken />
                    <button type="submit"
                            class="inline-flex items-center justify-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm
                                     transition-colors hover:bg-blue-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600
                                     dark:bg-blue-500 dark:hover:bg-blue-400 dark:focus-visible:outline-blue-400">
                        @PMIdentityText.ForgetThisBrowser
                    </button>
                </form>
            }

            <a href="/Account/Manage/Disable2fa"
               class="inline-flex items-center justify-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm
                        transition-colors hover:bg-blue-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600
                        dark:bg-blue-500 dark:hover:bg-blue-400 dark:focus-visible:outline-blue-400">
                @PMIdentityText.Disable2faAction
            </a>

            <a href="/Account/Manage/GenerateRecoveryCodes"
               class="inline-flex items-center justify-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm
                        transition-colors hover:bg-blue-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600
                        dark:bg-blue-500 dark:hover:bg-blue-400 dark:focus-visible:outline-blue-400">
                @PMIdentityText.ResetRecoveryCodes
            </a>
        </div>
    }

    <h4 class="mt-6 text-lg font-semibold text-gray-900 dark:text-gray-100">
        @PMIdentityText.AuthenticatorApp
    </h4>

    @if (!hasAuthenticator)
    {
        <a href="/Account/Manage/EnableAuthenticator"
           class="mt-2 inline-flex items-center justify-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm
                      transition-colors hover:bg-blue-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600
                      dark:bg-blue-500 dark:hover:bg-blue-400 dark:focus-visible:outline-blue-400">
            @PMIdentityText.AddAuthenticatorApp
        </a>
    }
    else
    {
        <div class="mt-2 flex flex-wrap items-center gap-3">
            <a href="/Account/Manage/EnableAuthenticator"
               class="inline-flex items-center justify-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm
                        transition-colors hover:bg-blue-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600
                        dark:bg-blue-500 dark:hover:bg-blue-400 dark:focus-visible:outline-blue-400">
                @PMIdentityText.SetUpAuthenticatorApp
            </a>

            <a href="/Account/Manage/ResetAuthenticator"
               class="inline-flex items-center justify-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm
                        transition-colors hover:bg-blue-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600
                        dark:bg-blue-500 dark:hover:bg-blue-400 dark:focus-visible:outline-blue-400">
                @PMIdentityText.ResetAuthenticatorApp
            </a>
        </div>
    }
}
else
{
    <div role="alert"
         class="mt-3 rounded-lg border border-red-300 bg-red-50 p-4 text-red-900
                  dark:border-red-900/50 dark:bg-red-950 dark:text-red-100">
        <strong class="block">@PMIdentityText.PrivacyPolicyNotAccepted</strong>
        <p class="mt-1">@PMIdentityText.AcceptPolicyBefore2fa</p>
    </div>
}


@code {
    private bool canTrack;
    private bool hasAuthenticator;
    private int recoveryCodesLeft;
    private bool is2faEnabled;
    private bool isMachineRemembered;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        canTrack = HttpContext.Features.Get<ITrackingConsentFeature>()?.CanTrack ?? true;
        hasAuthenticator = await UserManager.GetAuthenticatorKeyAsync(user) is not null;
        is2faEnabled = await UserManager.GetTwoFactorEnabledAsync(user);
        isMachineRemembered = await SignInManager.IsTwoFactorClientRememberedAsync(user);
        recoveryCodesLeft = await UserManager.CountRecoveryCodesAsync(user);
    }

    private async Task OnSubmitForgetBrowserAsync()
    {
        await SignInManager.ForgetTwoFactorClientAsync();

        RedirectManager.RedirectToCurrentPageWithStatus(
            PMIdentityText.CurrentBrowserForgotten,
            HttpContext);
    }
}
