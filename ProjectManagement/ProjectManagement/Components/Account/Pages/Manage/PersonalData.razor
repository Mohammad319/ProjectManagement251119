@page "/Account/Manage/PersonalData"
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>@PMIdentityText.PersonalDataTitle</PageTitle>

<StatusMessage />
<h3 class="text-xl font-semibold text-gray-900 dark:text-gray-100">@PMIdentityText.PersonalDataTitle</h3>

<div class="grid grid-cols-1 md:max-w-xl mt-3">
    <div class="space-y-4 text-gray-700 dark:text-gray-300">
        <p>
            @PMIdentityText.PersonalDataDescription
        </p>

        <p class="font-semibold text-red-700 dark:text-red-400">
            @PMIdentityText.PersonalDataDeleteWarning
        </p>

        <!-- Note: Use an absolute path if needed -->
        <form action="/Account/Manage/DownloadPersonalData" method="post" class="mt-4">
            <AntiforgeryToken />
            <button type="submit"
                    class="inline-flex items-center justify-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm
               transition-colors hover:bg-blue-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600
               dark:bg-blue-500 dark:hover:bg-blue-400 dark:focus-visible:outline-blue-400">
                @PMIdentityText.DownloadAction
            </button>
        </form>

        <p>
            <a href="/Account/Manage/DeletePersonalData"
               class="inline-flex items-center justify-center rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow-sm
               transition-colors hover:bg-red-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600
               dark:bg-red-500 dark:hover:bg-red-400 dark:focus-visible:outline-red-400">
                @PMIdentityText.DeleteAction
            </a>
        </p>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user  = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
        }
    }
}
