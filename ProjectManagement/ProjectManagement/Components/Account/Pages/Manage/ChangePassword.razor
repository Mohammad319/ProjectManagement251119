@page "/Account/Manage/ChangePassword"
@using ProjectManagement.Components.Account
@using Microsoft.AspNetCore.Components.Authorization
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ChangePassword> Logger
@inject IAccountNotificationEmailSender AccountNotificationEmailSender

<PageTitle>@PMIdentityText.ChangePasswordTitle</PageTitle>
<StatusMessage Message="@message" />
<div class="flex justify-center">
    <div class="w-full max-w-xl">
        <EditForm Model="Input" FormName="change-password" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="mb-4 text-red-600 dark:text-red-400" role="alert" />

            <div class="mb-4">
                <label for="Input.OldPassword" class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-200">
                    @PMIdentityText.CurrentPasswordLabel
                </label>
                <InputText type="password"
                           @bind-Value="Input.OldPassword"
                           id="Input.OldPassword"
                           class="block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-gray-900 shadow-sm
                 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500
                 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100 dark:placeholder-gray-400"
                           autocomplete="current-password"
                           aria-required="true"
                           placeholder="@PMIdentityText.EnterOldPassword" />
                <ValidationMessage For="() => Input.OldPassword" class="mt-1 text-sm text-red-600 dark:text-red-400" />
            </div>

            <div class="mb-4">
                <label for="Input.NewPassword" class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-200">
                    @PMIdentityText.NewPasswordLabel
                </label>
                <InputText type="password"
                           @bind-Value="Input.NewPassword"
                           id="Input.NewPassword"
                           class="block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-gray-900 shadow-sm
                 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500
                 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100 dark:placeholder-gray-400"
                           autocomplete="new-password"
                           aria-required="true"
                           placeholder="@PMIdentityText.EnterNewPassword" />
                <ValidationMessage For="() => Input.NewPassword" class="mt-1 text-sm text-red-600 dark:text-red-400" />
            </div>

            <div class="mb-6">
                <label for="Input.ConfirmPassword" class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-200">
                    @PMIdentityText.ConfirmNewPasswordLabel
                </label>
                <InputText type="password"
                           @bind-Value="Input.ConfirmPassword"
                           id="Input.ConfirmPassword"
                           class="block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-gray-900 shadow-sm
                 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500
                 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100 dark:placeholder-gray-400"
                           autocomplete="new-password"
                           aria-required="true"
                           placeholder="@PMIdentityText.EnterNewPassword" />
                <ValidationMessage For="() => Input.ConfirmPassword" class="mt-1 text-sm text-red-600 dark:text-red-400" />
            </div>

            <button type="submit"
                    class="w-full rounded-lg bg-indigo-600 px-4 py-2.5 font-medium text-white shadow
               hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500
               dark:bg-indigo-500 dark:hover:bg-indigo-400 dark:focus:ring-indigo-300 disabled:opacity-50">
                @PMIdentityText.UpdatePasswordAction
            </button>
        </EditForm>
    </div>
</div>

@code {
    private string? message;
    private ApplicationUser? user;
    private bool hasPassword;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        hasPassword = await UserManager.HasPasswordAsync(user);
        if (!hasPassword)
        {
            RedirectManager.RedirectTo("Account/Manage/SetPassword");
        }
    }

    private async Task OnValidSubmitAsync()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        var changePasswordResult = await UserManager.ChangePasswordAsync(user, Input.OldPassword, Input.NewPassword);
        if (!changePasswordResult.Succeeded)
        {
            message = $"Error: {string.Join(",", changePasswordResult.Errors.Select(error => error.Description))}";
            return;
        }

        await SignInManager.RefreshSignInAsync(user);
        Logger.LogInformation("User changed their password successfully.");
        await AccountNotificationEmailSender.SendPasswordChangedNoticeAsync(user.Email ?? string.Empty, $"{user.Firstname} {user.Lastname}".Trim());

        RedirectManager.RedirectToCurrentPageWithStatus(PMIdentityText.PasswordChangedStatus, HttpContext);
    }

    private sealed class InputModel
    {
        [Required]
        [DataType(DataType.Password)]
        [Display(Name = nameof(PMIdentityText.CurrentPasswordLabel), ResourceType = typeof(PMIdentityText))]
        public string OldPassword { get; set; } = "";

        [Required]
        [StringLength(100, ErrorMessageResourceName = nameof(PMIdentityText.PasswordLengthError), ErrorMessageResourceType = typeof(PMIdentityText), MinimumLength = 6)]
        [DataType(DataType.Password)]
        [Display(Name = nameof(PMIdentityText.NewPasswordLabel), ResourceType = typeof(PMIdentityText))]
        public string NewPassword { get; set; } = "";

        [DataType(DataType.Password)]
        [Display(Name = nameof(PMIdentityText.ConfirmNewPasswordLabel), ResourceType = typeof(PMIdentityText))]
        [Compare("NewPassword", ErrorMessageResourceName = nameof(PMIdentityText.NewPasswordConfirmationMismatch), ErrorMessageResourceType = typeof(PMIdentityText))]
        public string ConfirmPassword { get; set; } = "";
    }
}
