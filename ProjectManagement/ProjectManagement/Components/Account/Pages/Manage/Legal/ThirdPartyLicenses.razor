@page "/Account/Manage/Libraries"
@using System.Globalization

<h2>@PMAppFormatResource.TabLicenses</h2>

<p>
    @T("ThirdPartyLibrariesDescription", "This application is built using the .NET platform and relies on several open-source libraries. We gratefully acknowledge the work of the developers behind these components.")
</p>

<ul>
    <li>Blazored.LocalStorage - @T("MitLicenseLabel", "MIT License")</li>
    <li>ClosedXML - @T("MitLicenseLabel", "MIT License")</li>
    <li>ChartJs.Blazor.Fork - @T("MitLicenseLabel", "MIT License")</li>
    @* <li>Newtonsoft.Json - @T("MitLicenseLabel", "MIT License")</li> *@
</ul>

<p>
    @T("ThirdPartyLibrariesMicrosoftNotice", ".NET and ASP.NET Core libraries used are provided by Microsoft and licensed under the MIT License.")
</p>

<p>
    @T("ThirdPartyLibrariesOwnership", "Each library is the property of its respective authors and contributors.")
</p>

@code {
    private static string T(string key, string fallback)
        => PMAppFormatResource.ResourceManager.GetString(key, CultureInfo.CurrentUICulture) ?? fallback;
}
