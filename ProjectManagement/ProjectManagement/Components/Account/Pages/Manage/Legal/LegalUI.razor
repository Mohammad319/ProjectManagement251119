@page "/Account/Manage/legal"
@using ProjectManagement.Client.Shared.Constants
@using ProjectManagement.Client.Shared.ResourceFiles.APP
@using ProjectManagement.Shared
@using ProjectManagement.Shared.Constant
@inject Microsoft.Extensions.Localization.IStringLocalizer<ResourceApp> L

<div class="inline-flex items-center gap-1 rounded-md border border-slate-200 bg-white p-1 dark:border-slate-700 dark:bg-slate-800 mb-3" role="group" aria-label="Legal tabs">
    <button class="rounded-md px-3 py-1.5 text-sm font-medium transition-colors @(activeTab == "impressum" ? "bg-blue-600 text-white dark:bg-blue-500" : "text-blue-700 hover:bg-blue-50 dark:text-blue-300 dark:hover:bg-slate-700")"
            @onclick="@(() => SelectTab("impressum"))">
        Impressum
    </button>
    <button class="rounded-md px-3 py-1.5 text-sm font-medium transition-colors @(activeTab == "privacy" ? "bg-blue-600 text-white dark:bg-blue-500" : "text-blue-700 hover:bg-blue-50 dark:text-blue-300 dark:hover:bg-slate-700")"
            @onclick="@(() => SelectTab("privacy"))">
        @PMAppFormatResource.TabPrivacy
    </button>
    <button class="rounded-md px-3 py-1.5 text-sm font-medium transition-colors @(activeTab == "terms" ? "bg-blue-600 text-white dark:bg-blue-500" : "text-blue-700 hover:bg-blue-50 dark:text-blue-300 dark:hover:bg-slate-700")"
            @onclick="@(() => SelectTab("terms"))">
        @PMAppFormatResource.TabTerms
    </button>
    <button class="rounded-md px-3 py-1.5 text-sm font-medium transition-colors @(activeTab == "licenses" ? "bg-blue-600 text-white dark:bg-blue-500" : "text-blue-700 hover:bg-blue-50 dark:text-blue-300 dark:hover:bg-slate-700")"
            @onclick="@(() => SelectTab("licenses"))">
        @PMAppFormatResource.TabLicenses
    </button>
</div>

<div>
    @if (activeTab == "impressum")
    {
        <div>
            <ImpressumUI></ImpressumUI>
        </div>
    }
    else if (activeTab == "privacy")
    {
        <div>
            <h2>@PMAppFormatResource.TabPrivacy</h2>
            <p>@PMAppFormatResource.PrivacyContent</p>
        </div>
    }
    else if (activeTab == "terms")
    {
        <div>
            <p>@((MarkupString)PMAppFormatResource.TermsContent.Replace("\n", "<br />"))</p>
        </div>
    }
    else if (activeTab == "licenses")
    {
        <div>
            <ThirdPartyLicenses></ThirdPartyLicenses>
        </div>
    }
</div>

@code {
    private string activeTab = "impressum";

    void SelectTab(string tabName)
    {
        activeTab = tabName;
    }
}
