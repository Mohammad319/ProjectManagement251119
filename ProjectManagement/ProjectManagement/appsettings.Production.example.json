{
  "ConnectionStrings": {
    "PMTConnection": "Server=YOUR_SQL_SERVER;Database=ProjectManagement;User Id=YOUR_USER;Password=YOUR_PASSWORD;Encrypt=True;TrustServerCertificate=False;MultipleActiveResultSets=True",
    "TaskResourceBlueprintsConnection": "Server=YOUR_SQL_SERVER;Database=TaskResourceBlueprints;User Id=YOUR_USER;Password=YOUR_PASSWORD;Encrypt=True;TrustServerCertificate=False;MultipleActiveResultSets=True"
  },
  "AllowedHosts": "your-domain.example;www.your-domain.example",
  "DetailedErrors": false,
  "Bootstrap": {
    "EnableConfiguredAdmin": false,
    "EnableInitialize2022": false
  },
  "TenantReload": {
    "Secret": "CHANGE-ME-LONG-RANDOM-SECRET-ONLY-IF-YOU-USE-TENANT-RELOAD"
  },
  "TenantContext": {
    "AllowHeaderOverride": false,
    "HeaderSecret": ""
  },
  "DataProtection": {
    "KeysPath": "C:\\ProjectManagement\\DataProtectionKeys"
  },
  "MailSettings": {
    "Mail": "no-reply@your-domain.example",
    "DisplayName": "ProjectManagement",
    "Password": "YOUR_SMTP_PASSWORD",
    "Host": "smtp.your-provider.example",
    "Port": 587,
    "UseSsl": true
  },
  "User": {
    "Email": "",
    "Password": ""
  },
  "Sentry": {
    "Dsn": "",
    "MinimumEventLevel": "Error",
    "MinimumBreadcrumbLevel": "Information",
    "AttachStacktrace": true,
    "SendDefaultPii": false,
    "MaxRequestBodySize": "None",
    "TracesSampleRate": 0.05,
    "Debug": false,
    "DiagnosticLevel": "Error"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.MSSqlServer"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "PMTConnection",
          "sinkOptionsSection": {
            "tableName": "Logs",
            "schemaName": "dbo",
            "autoCreateSqlTable": true
          },
          "restrictedToMinimumLevel": "Warning",
          "columnOptionsSection": {
            "additionalColumns": [
              {
                "ColumnName": "TenantID",
                "PropertyName": "TenantID",
                "DataType": "int",
                "AllowNull": true
              },
              {
                "ColumnName": "UserId",
                "PropertyName": "UserId",
                "DataType": "nvarchar",
                "DataLength": 450
              },
              {
                "ColumnName": "DepartmentId",
                "PropertyName": "DepartmentId",
                "DataType": "int",
                "AllowNull": true
              },
              {
                "ColumnName": "TraceId",
                "PropertyName": "TraceId",
                "DataType": "nvarchar",
                "DataLength": 128
              }
            ]
          }
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId",
      "WithExceptionDetails"
    ],
    "Properties": {
      "ApplicationName": "ProjectManagement.Server"
    }
  }
}
