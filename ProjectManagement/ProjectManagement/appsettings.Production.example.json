{
  "AllowedHosts": "pm.example.se",
  "Bootstrap": {
    "EnableConfiguredAdmin": false
  },
  "DataProtection": {
    "KeysPath": "C:\\ProjectManagement\\DataProtectionKeys"
  },
  "SecurityHeaders": {
    "CspReportOnly": true
  },
  "ConnectionStrings": {
    "AuthPermissionsConnection": "Server=YOUR_SQL_SERVER;Database=ProjectManagement;User Id=YOUR_USER;Password=YOUR_PASSWORD;Encrypt=True;TrustServerCertificate=False;MultipleActiveResultSets=True",
    "BlueprintsConnection": "Server=YOUR_SQL_SERVER;Database=TaskResourceBlueprints;User Id=YOUR_USER;Password=YOUR_PASSWORD;Encrypt=True;TrustServerCertificate=False;MultipleActiveResultSets=True"
  },
  "MailSettings": {
    "Mail": "no-reply@example.se",
    "DisplayName": "ProjectManagement",
    "Password": "PUT_IN_SECRET_STORE",
    "Host": "smtp.example.se",
    "Port": 587
  },
  "TenantReload": {
    "Secret": "SET-A-STRONG-RANDOM-VALUE-OR-REMOVE-THE-SECTION"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
