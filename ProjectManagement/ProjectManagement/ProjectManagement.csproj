<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-ProjectManagement-59df31a9-7e9c-4950-a479-3318bb11c361</UserSecretsId>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>
	<ItemGroup>
		<Compile Remove="**\node_modules\**" />
		<Content Remove="**\node_modules\**" />
		<EmbeddedResource Remove="**\node_modules\**" />
		<None Remove="**\node_modules\**" />
	</ItemGroup>
  <PropertyGroup>
    <SatelliteResourceLanguages>en;sv</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup>
		<DefaultItemExcludes>$(DefaultItemExcludes);**\node_modules\**</DefaultItemExcludes>
	</PropertyGroup>


	<ItemGroup>
    <ProjectReference Include="..\..\Application\Application.csproj" />
    <ProjectReference Include="..\..\AuthPermissions\AuthPermissions.csproj" />
    <ProjectReference Include="..\..\TaskResourceBlueprints\TaskResourceBlueprints.csproj" />
    <ProjectReference Include="..\..\Persistence\Persistence.csproj" />
    <ProjectReference Include="..\..\ProjectManagement.ServiceDefaults\ProjectManagement.ServiceDefaults.csproj" />
    <ProjectReference Include="..\ProjectManagement.Client\ProjectManagement.Client.csproj" />
    <PackageReference Include="Asp.Versioning.Mvc" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.7" />
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.7" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.7">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.7">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="NCalcSync" Version="5.12.0" />
    <PackageReference Include="Sentry.AspNetCore" Version="6.4.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.MSSqlServer" Version="9.0.3" />
  </ItemGroup>


	<ItemGroup>
	  <Compile Update="Shared\PMAppFormatResource.Designer.cs">
	    <DependentUpon>PMAppFormatResource.resx</DependentUpon>
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	  </Compile>
	  <Compile Update="Shared\PMResourceIdentity.Designer.cs">
	    <DependentUpon>PMResourceIdentity.resx</DependentUpon>
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	  </Compile>
	</ItemGroup>


	<ItemGroup>
	  <EmbeddedResource Update="Shared\PMAppFormatResource.resx">
	    <LastGenOutput>PMAppFormatResource.Designer.cs</LastGenOutput>
	    <Generator>PublicResXFileCodeGenerator</Generator>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Shared\PMResourceIdentity.resx">
	    <LastGenOutput>PMResourceIdentity.Designer.cs</LastGenOutput>
	    <Generator>PublicResXFileCodeGenerator</Generator>
	  </EmbeddedResource>
	</ItemGroup>
	<ItemGroup>
		<Content Update="**\package.json" CopyToPublishDirectory="Never" />
		<Content Update="**\package-lock.json" CopyToPublishDirectory="Never" />
		<Content Update="**\tailwind.config.js" CopyToPublishDirectory="Never" />
		<Content Update="**\postcss.config.js" CopyToPublishDirectory="Never" />
	</ItemGroup>

	<Target Name="BuildTailwindCss" BeforeTargets="Build;Publish" Condition="Exists('$(MSBuildProjectDirectory)\package.json')">
		<Exec Command="npm ci" WorkingDirectory="$(MSBuildProjectDirectory)" Condition="!Exists('$(MSBuildProjectDirectory)\node_modules')" />
		<Exec Command="npm run tw:build" WorkingDirectory="$(MSBuildProjectDirectory)" />
	</Target>

</Project>
