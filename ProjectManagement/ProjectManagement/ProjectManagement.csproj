<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-ProjectManagement-59df31a9-7e9c-4950-a479-3318bb11c361</UserSecretsId>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>
	<ItemGroup>
		<Compile Remove="**\node_modules\**" />
		<Content Remove="**\node_modules\**" />
		<EmbeddedResource Remove="**\node_modules\**" />
		<None Remove="**\node_modules\**" />
	</ItemGroup>
  <PropertyGroup>
    <SatelliteResourceLanguages>en;sv</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup>
		<DefaultItemExcludes>$(DefaultItemExcludes);**\node_modules\**</DefaultItemExcludes>
	</PropertyGroup>


	<ItemGroup>
    <ProjectReference Include="..\..\Application\Application.csproj" />
    <ProjectReference Include="..\..\AuthPermissions\AuthPermissions.csproj" />
    <ProjectReference Include="..\..\TaskResourceBlueprints\TaskResourceBlueprints.csproj" />
    <ProjectReference Include="..\..\Persistence\Persistence.csproj" />
    <ProjectReference Include="..\..\ProjectManagement.ServiceDefaults\ProjectManagement.ServiceDefaults.csproj" />
    <ProjectReference Include="..\ProjectManagement.Client\ProjectManagement.Client.csproj" />
    <PackageReference Include="Asp.Versioning.Mvc" Version="8.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.0" />
    <PackageReference Include="NCalcSync" Version="5.8.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.MSSqlServer" Version="9.0.2" />
  </ItemGroup>


	<ItemGroup>
	  <Compile Update="Shared\PMAppFormatResource.Designer.cs">
	    <DependentUpon>PMAppFormatResource.resx</DependentUpon>
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	  </Compile>
	  <Compile Update="Shared\PMResourceIdentity.Designer.cs">
	    <DependentUpon>PMResourceIdentity.resx</DependentUpon>
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	  </Compile>
	</ItemGroup>


	<ItemGroup>
	  <EmbeddedResource Update="Shared\PMAppFormatResource.resx">
	    <LastGenOutput>PMAppFormatResource.Designer.cs</LastGenOutput>
	    <Generator>PublicResXFileCodeGenerator</Generator>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Shared\PMResourceIdentity.resx">
	    <LastGenOutput>PMResourceIdentity.Designer.cs</LastGenOutput>
	    <Generator>PublicResXFileCodeGenerator</Generator>
	  </EmbeddedResource>
	</ItemGroup>

</Project>
