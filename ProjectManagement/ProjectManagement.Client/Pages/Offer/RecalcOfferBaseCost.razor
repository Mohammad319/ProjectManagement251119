@using ProjectManagement.Shared.DTO.Organisation
@inherits AppComponentBase

<div class="p-4 bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-100 space-y-3">

    @if (Organisations != null)
    {
        <div class="grid grid-cols-1 gap-3 md:grid-cols-3">
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">
                    @ResourceApp.organisation
                </label>

                <select class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100"
                        @bind="OrgID">
                    <option value="0"></option>
                    @foreach (var cat in Organisations)
                    {
                        <option value="@cat.Id">@cat.Name</option>
                    }
                </select>

        </div>
    }

    @if (OrgID > 0)
    {
        <div class="grid grid-cols-1 gap-3 md:grid-cols-3  pt-3">
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">
                    @AppLoc["baseCostAverage"]
                </label>

                <input class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 text-sm"
                       type="number"
                       step="0.01"
                       @bind="Basecost" />
        </div>
        <div class="flex flex-col gap-1 pt-0.5">
            <span class="text-slate-500 dark:text-slate-400 text-[11px]">
                @ResourceLoc.Message_EnterNewAverageCost
            </span>
        </div>
    }
</div>

<div class="mt-4 flex items-center justify-end gap-2 border-t border-slate-200 dark:border-slate-700 pt-3">
    <button class="inline-flex items-center justify-center gap-1 rounded-md bg-emerald-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-emerald-700 disabled:cursor-not-allowed disabled:opacity-60 dark:bg-emerald-500 dark:hover:bg-emerald-400"
            disabled="@(OrgID <= 0)"
            @onclick="SaveAsync">
        @((MarkupString)Icons.SaveCloud)
        <span>@ResourceApp.save</span>
    </button>
</div>

@code {
    double Basecost = 0;
    List<ListDTO>? Organisations;
    int OrgID = 0;

    protected async override Task OnInitializedAsync()
    {
        Organisations = await Repo.Org.GetVisibleOrIdAsync();
    }

    async Task SaveAsync()
    {
        if (OrgID <= 0) return;

        if (await Repo.Offer.ReCalc(Calc.Id, OrgID, Basecost))
            Modal.Close();
    }
}
