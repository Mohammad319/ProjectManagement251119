@using ProjectManagement.Client.Services.Calculation.CalculationItems
@using ProjectManagement.Client.Shared.MVVM.Calculation
@using ProjectManagement.Shared.Enums
@inherits AppComponentBase

<div class="p-4 bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-100 space-y-3">

    <!-- نموذج الفلترة -->
    <EditForm id="filterForm" Model="@Filter">
        <div class="grid grid-cols-1 gap-3 md:grid-cols-4">
            @* Folder *@
            @if (FoldersList != null && FoldersList.Count > 0)
            {
                <div class="md:col-span-2">
                    <div class="flex flex-col gap-1">
                        <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">
                            @ResourceLoc.folder
                        </label>

                        <InputSelect class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100"
                                     @bind-Value:get="Filter.FolderID"
                                     @bind-Value:set="(value) => FolderChanged(value)">
                            <option value=""></option>
                            @foreach (var status in FoldersList)
                            {
                                <option value="@status.Id">@status.Name</option>
                            }
                        </InputSelect>
                    </div>
                </div>
            }

            @* Project *@
            @if (Projects != null && Projects.Count > 0)
            {
                <div class="md:col-span-2">
                    <div class="flex flex-col gap-1">
                        <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">
                            @CalcResource.project
                        </label>

                        <InputSelect class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100"
                                     @bind-Value:get="Filter.ProjectID"
                                     @bind-Value:set="(value) => ProjectChanged(value)">
                            <option value=""></option>
                            @foreach (var status in Projects)
                            {
                                <option value="@status.Id">@status.Name</option>
                            }
                        </InputSelect>
                    </div>
                </div>
            }

            @* Calculation *@
            @if (Calcs != null && Calcs.Count > 0)
            {
                <div class="md:col-span-2">
                    <div class="flex flex-col gap-1">
                        <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">
                            @CalcResource.calculation
                        </label>

                        <InputSelect class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100"
                                     @bind-Value:get="Filter.CalculationID"
                                     @bind-Value:set="(value) => CalcChanged(value)">
                            <option value="0"></option>
                            @foreach (var status in Calcs)
                            {
                                <option value="@status.Id">@status.Name</option>
                            }
                        </InputSelect>
                    </div>
                </div>
            }

            @* Resource Type Enum *@
            <div class="md:col-span-2">
                <div class="flex flex-col gap-1">
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">
                        @CalcResource.resourceType
                    </label>

                    <InputSelect class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100"
                                 @bind-Value="Filter.ResType">
                        <option></option>
                        @foreach (ResourceTypesEnum level in Enum.GetValues(typeof(ResourceTypesEnum)))
                        {
                            <option value="@level">@ResourceLocalize.GetResourceType(level)</option>
                        }
                    </InputSelect>
                </div>
            </div>

            @* Resource Type from DB *@
            @if (ResourceTypes != null)
            {
                <div class="md:col-span-2">
                    <div class="flex flex-col gap-1">
                        <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">
                            @CalcResource.resourceType
                        </label>

                        <InputSelect class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100"
                                     @bind-Value:get="Filter.ResourceTypeId"
                                     @bind-Value:set="(value) => ChangeResType(value)">
                            <option></option>
                            @foreach (var item in ResourceTypes)
                            {
                                <option value="@item.Id">@item.Name</option>
                            }
                        </InputSelect>
                    </div>
                </div>
            }

            @* Organisation (datalist) *@
            @if (Organisations != null)
            {
                <div class="md:col-span-2">
                    <div class="flex flex-col gap-1">
                        <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">
                            @ResourceApp.organisation
                        </label>

                        <input list="orgList"
                               id="orgInput"
                               class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100"
                               @oninput="OnInputOrgChanged" />

                        <datalist id="orgList">
                            <option></option>
                            @foreach (var cat in Organisations)
                            {
                                <option data-id="@cat.Id" value="@cat.Name"></option>
                            }
                        </datalist>
                    </div>
                </div>
            }

            @* زر الفلترة *@
            <div class="md:col-span-2 flex items-end">
                <button type="submit"
                        form="filterForm"
                        class="inline-flex items-center justify-center gap-1 rounded-md bg-indigo-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-indigo-700 disabled:cursor-not-allowed disabled:opacity-60 dark:bg-indigo-500 dark:hover:bg-indigo-400"
                        @onclick="GetOffersAsync">
                    @((MarkupString)Icons.Search)
                    <span>@ResourceApp.filter</span>
                </button>
            </div>
        </div>
    </EditForm>

<!-- نتائج الفلترة -->
<div class="bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-lg shadow-sm">
    @if (Offers is null || Offers.Count == 0)
    {
        <div class="px-3 py-6 text-center text-sm text-slate-500 dark:text-slate-400">
            @ResourceApp.notFoundData
        </div>
    }
    else
    {
        <div class="max-h-[55vh] overflow-y-auto overflow-x-auto rounded-lg">
            <table class="min-w-full text-xs leading-tight text-xs sm:text-sm">
                <thead class="bg-slate-50 dark:bg-slate-900 sticky top-0 z-10">
                    <tr>
                        <th class="px-2 py-1.5 text-xs font-semibold uppercase tracking-wide text-slate-600 dark:text-slate-300 text-left">@ResourceApp.organisation</th>
                        <th class="px-2 py-1.5 text-xs font-semibold uppercase tracking-wide text-slate-600 dark:text-slate-300 text-left">@ResourceLoc.resource</th>
                        <th class="px-2 py-1.5 text-xs font-semibold uppercase tracking-wide text-slate-600 dark:text-slate-300 text-right">@CalcResource.cost</th>
                        <th class="px-2 py-1.5 text-xs font-semibold uppercase tracking-wide text-slate-600 dark:text-slate-300 text-right">@CalcResource.baseCost</th>
                        <th class="px-2 py-1.5 text-xs font-semibold uppercase tracking-wide text-slate-600 dark:text-slate-300 text-center">@ResourceApp.date</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                    @for (var index = 0; index < Offers.Count; index++)
                    {
                        var cat = Offers[index];
                        var isSelected = SelectedOfferIndex == index;
                        var isExpanded = ExpandedOfferIndex == index;

                        <tr class="transition-colors @(isSelected ? "bg-blue-50 dark:bg-blue-950/40" : "")">

                            <td class="px-2 py-1.5 align-middle text-slate-700 dark:text-slate-200">
                                <span class="block text-[11px] sm:text-xs text-slate-800 dark:text-slate-100 truncate max-w-xs sm:max-w-sm">
                                    @(string.IsNullOrEmpty(cat.Organisation)
                                          ? ""
                                          : $"{cat.Organisation} > {cat.SubCategory} > {cat.Category}")
                                </span>
                            </td>

                            <td class="px-2 py-1.5 align-middle text-slate-700 dark:text-slate-200">
                                <span class="block text-[11px] sm:text-xs text-slate-700 dark:text-slate-200 truncate max-w-lg">
                                    @cat.CalcName (@cat.CalcCode)
                                    &nbsp;&gt;&nbsp;
                                    @cat.TaskName (@cat.TaskCode)
                                    &nbsp;&gt;&nbsp;
                                    @cat.ResName
                                </span>
                            </td>

                            <td class="px-2 py-1.5 align-middle text-slate-700 dark:text-slate-200 text-right">
                                <span class="tabular-nums">@cat.Cost</span>
                            </td>

                            <td class="px-2 py-1.5 align-middle text-slate-700 dark:text-slate-200 text-right">
                                <span class="tabular-nums">@cat.BaseCost</span>
                            </td>

                            <td class="px-2 py-1.5 align-middle text-slate-700 dark:text-slate-200 text-center text-[11px] text-slate-600 dark:text-slate-300">
                                @cat.Date
                            </td>
                        </tr>

                        @* صف التفاصيل الموسّعة *@
                        @if (isExpanded)
                        {
                            <tr class="bg-slate-50 dark:bg-slate-900/70">
                                <td></td>
                                <td colspan="6" class="px-2 py-2 text-[11px] sm:text-xs text-slate-700 dark:text-slate-200">
                                    <div class="flex flex-col gap-1">
                                        <div>
                                            <span class="font-semibold">@ResourceApp.organisation:</span>
                                            <span class="ms-1">
                                                @(string.IsNullOrEmpty(cat.Organisation)
                                                      ? "-"
                                                      : $"{cat.Organisation} > {cat.SubCategory} > {cat.Category}")
                                            </span>
                                        </div>
                                        <div>
                                            <span class="font-semibold">@ResourceLoc.resource:</span>
                                            <span class="ms-1">
                                                @cat.CalcName (@cat.CalcCode) &gt; @cat.TaskName (@cat.TaskCode) &gt; @cat.ResName
                                            </span>
                                        </div>
                                        <div>
                                            <span class="font-semibold">@CalcResource.cost:</span>
                                            <span class="ms-1 tabular-nums">@cat.Cost</span>
                                            <span class="mx-1 text-slate-400">/</span>
                                            <span class="font-semibold">@CalcResource.baseCost:</span>
                                            <span class="ms-1 tabular-nums">@cat.BaseCost</span>
                                        </div>
                                        @* لو فيه حقل تعليق في DTO تقدر تضيفه هنا *@
                                        @* <div>
                                            <span class="font-semibold">@CalcResource.comment:</span>
                                            <span class="ms-1">@cat.Comment</span>
                                           </div> *@
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>


</div>
@code {
    [Parameter] public EventCallback<int> OnOfferSelected { get; set; }

    private async Task SelectOfferAsync(int index)
    {
        SelectedOfferIndex = index;
        if (OnOfferSelected.HasDelegate)
        {
            await OnOfferSelected.InvokeAsync(index);
        }
    }

    private int? SelectedOfferIndex { get; set; }
    private int? ExpandedOfferIndex { get; set; }

    // يُنادى عند الضغط على زر الاختيار
    private void SelectOffer2(int index)
    {
        SelectedOfferIndex = index;

        // هنا تقدر تضيف أي منطق إضافي
        // مثل استدعاء Callback للأب، أو حفظ الـ Offer المختار في متغير
        // SelectedOffer = Offers[index];
    }

    // يُنادى عند الضغط على زر السهم
    private void ToggleExpand(int index)
    {
        ExpandedOfferIndex = ExpandedOfferIndex == index ? null : index;
    }
}
