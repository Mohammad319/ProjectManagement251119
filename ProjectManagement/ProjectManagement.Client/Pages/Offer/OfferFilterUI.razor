@using ProjectManagement.Client.Services.Calculation.CalculationItems
@using ProjectManagement.Client.Shared.MVVM.Calculation
@using ProjectManagement.Shared.Enums
@inherits AppComponentBase

<div class="flex flex-col gap-3 p-3 bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-100">

    <!-- Filter Card -->
    <div class="rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 shadow-sm">
        <div class="flex items-center gap-2 px-3 py-2 border-b border-slate-100 dark:border-slate-700">
            <span class="text-indigo-500 dark:text-indigo-400 flex-shrink-0" style="width:14px;height:14px;display:inline-flex">@((MarkupString)Icons.Search)</span>
            <span class="text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">@ResourceApp.filter</span>
        </div>

        <EditForm id="filterForm" Model="@Filter">
            <div class="p-3 flex flex-row flex-wrap gap-2 items-end">

                @* Folder *@
                @if (FoldersList != null && FoldersList.Count > 0)
                {
                    <div class="flex-1 min-w-0">
                        <label class="block mb-0.5 text-[10px] font-medium text-slate-400 dark:text-slate-500 uppercase tracking-wide">@ResourceLoc.folder</label>
                        <InputSelect class="w-full rounded border border-slate-200 bg-white px-2 py-1 text-xs text-slate-700 focus:outline-none focus:ring-1 focus:ring-indigo-400 dark:border-slate-600 dark:bg-slate-700 dark:text-slate-100"
                                     @bind-Value:get="Filter.FolderID"
                                     @bind-Value:set="(value) => FolderChanged(value)">
                            <option value=""></option>
                            @foreach (var status in FoldersList)
                            {
                                <option value="@status.Id">@status.Name</option>
                            }
                        </InputSelect>
                    </div>
                }

                @* Project *@
                @if (Projects != null && Projects.Count > 0)
                {
                    <div class="flex-1 min-w-0">
                        <label class="block mb-0.5 text-[10px] font-medium text-slate-400 dark:text-slate-500 uppercase tracking-wide">@CalcResource.project</label>
                        <InputSelect class="w-full rounded border border-slate-200 bg-white px-2 py-1 text-xs text-slate-700 focus:outline-none focus:ring-1 focus:ring-indigo-400 dark:border-slate-600 dark:bg-slate-700 dark:text-slate-100"
                                     @bind-Value:get="Filter.ProjectID"
                                     @bind-Value:set="(value) => ProjectChanged(value)">
                            <option value=""></option>
                            @foreach (var status in Projects)
                            {
                                <option value="@status.Id">@status.Name</option>
                            }
                        </InputSelect>
                    </div>
                }

                @* Calculation *@
                @if (Calcs != null && Calcs.Count > 0)
                {
                    <div class="flex-1 min-w-0">
                        <label class="block mb-0.5 text-[10px] font-medium text-slate-400 dark:text-slate-500 uppercase tracking-wide">@CalcResource.calculation</label>
                        <InputSelect class="w-full rounded border border-slate-200 bg-white px-2 py-1 text-xs text-slate-700 focus:outline-none focus:ring-1 focus:ring-indigo-400 dark:border-slate-600 dark:bg-slate-700 dark:text-slate-100"
                                     @bind-Value:get="Filter.CalculationID"
                                     @bind-Value:set="(value) => CalcChanged(value)">
                            <option value="0"></option>
                            @foreach (var status in Calcs)
                            {
                                <option value="@status.Id">@status.Name</option>
                            }
                        </InputSelect>
                    </div>
                }

                @* Resource Type Enum *@
                <div class="flex-1 min-w-0">
                    <label class="block mb-0.5 text-[10px] font-medium text-slate-400 dark:text-slate-500 uppercase tracking-wide">@CalcResource.resourceType</label>
                    <InputSelect class="w-full rounded border border-slate-200 bg-white px-2 py-1 text-xs text-slate-700 focus:outline-none focus:ring-1 focus:ring-indigo-400 dark:border-slate-600 dark:bg-slate-700 dark:text-slate-100"
                                 @bind-Value="Filter.ResType">
                        <option></option>
                        @foreach (ResourceTypesEnum level in Enum.GetValues(typeof(ResourceTypesEnum)))
                        {
                            <option value="@level">@ResourceLocalize.GetResourceType(level)</option>
                        }
                    </InputSelect>
                </div>

                @* Resource Type from DB *@
                @if (ResourceTypes != null)
                {
                    <div class="flex-1 min-w-0">
                        <label class="block mb-0.5 text-[10px] font-medium text-slate-400 dark:text-slate-500 uppercase tracking-wide">@CalcResource.resourceType</label>
                        <InputSelect class="w-full rounded border border-slate-200 bg-white px-2 py-1 text-xs text-slate-700 focus:outline-none focus:ring-1 focus:ring-indigo-400 dark:border-slate-600 dark:bg-slate-700 dark:text-slate-100"
                                     @bind-Value:get="Filter.ResourceTypeId"
                                     @bind-Value:set="(value) => ChangeResType(value)">
                            <option></option>
                            @foreach (var item in ResourceTypes)
                            {
                                <option value="@item.Id">@item.Name</option>
                            }
                        </InputSelect>
                    </div>
                }

                @* Organisation (datalist) *@
                @if (Organisations != null)
                {
                    <div class="flex-1 min-w-0">
                        <label class="block mb-0.5 text-[10px] font-medium text-slate-400 dark:text-slate-500 uppercase tracking-wide">@ResourceApp.organisation</label>
                        <input list="orgList"
                               id="orgInput"
                               class="w-full rounded border border-slate-200 bg-white px-2 py-1 text-xs text-slate-700 focus:outline-none focus:ring-1 focus:ring-indigo-400 dark:border-slate-600 dark:bg-slate-700 dark:text-slate-100"
                               @oninput="OnInputOrgChanged" />
                        <datalist id="orgList">
                            <option></option>
                            @foreach (var cat in Organisations)
                            {
                                <option data-id="@cat.Id" value="@cat.Name"></option>
                            }
                        </datalist>
                    </div>
                }

                @* Filter Button *@
                <div class="flex-shrink-0 flex items-end">
                    <button type="submit"
                            form="filterForm"
                            class="inline-flex items-center gap-1.5 rounded bg-indigo-600 px-3 py-1 text-xs font-semibold text-white hover:bg-indigo-700 active:bg-indigo-800 disabled:opacity-60 dark:bg-indigo-500 dark:hover:bg-indigo-400 transition-colors"
                            @onclick="GetOffersAsync">
                        @((MarkupString)Icons.Search)
                        <span>@ResourceApp.filter</span>
                    </button>
                </div>

            </div>
        </EditForm>
    </div>

    <!-- Results -->
    <div class="rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 shadow-sm overflow-hidden">
        @if (Offers is null || Offers.Count == 0)
        {
            <div class="flex flex-col items-center justify-center py-10 gap-2 text-slate-400 dark:text-slate-600">
                <svg class="w-8 h-8 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                </svg>
                <span class="text-xs">@ResourceApp.notFoundData</span>
            </div>
        }
        else
        {
            <div class="flex items-center px-3 py-1.5 bg-slate-50 dark:bg-slate-900/50 border-b border-slate-100 dark:border-slate-700">
                <span class="text-[11px] text-slate-400 dark:text-slate-500">
                    <span class="font-semibold text-slate-600 dark:text-slate-300">@Offers.Count</span>
                </span>
            </div>

            <div class="max-h-[52vh] overflow-y-auto overflow-x-auto">
                <table class="min-w-full text-xs">
                    <thead class="sticky top-0 z-10 bg-slate-50 dark:bg-slate-900 border-b border-slate-200 dark:border-slate-700">
                        <tr>
                            <th class="px-2 py-1.5 text-left text-[10px] font-semibold uppercase tracking-wide text-slate-400 dark:text-slate-500 whitespace-nowrap">@ResourceApp.organisation</th>
                            <th class="px-2 py-1.5 text-left text-[10px] font-semibold uppercase tracking-wide text-slate-400 dark:text-slate-500 whitespace-nowrap">@ResourceLoc.resource</th>
                            <th class="px-2 py-1.5 text-right text-[10px] font-semibold uppercase tracking-wide text-slate-400 dark:text-slate-500 whitespace-nowrap">@CalcResource.cost</th>
                            <th class="px-2 py-1.5 text-right text-[10px] font-semibold uppercase tracking-wide text-slate-400 dark:text-slate-500 whitespace-nowrap">@CalcResource.baseCost</th>
                            <th class="px-2 py-1.5 text-center text-[10px] font-semibold uppercase tracking-wide text-slate-400 dark:text-slate-500 whitespace-nowrap">@ResourceApp.date</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                        @for (var index = 0; index < Offers.Count; index++)
                        {
                            var cat = Offers[index];
                            var isSelected = SelectedOfferIndex == index;
                            var isExpanded = ExpandedOfferIndex == index;

                            <tr class="cursor-pointer transition-colors hover:bg-slate-50 dark:hover:bg-slate-700/40 @(isSelected ? "bg-indigo-50 dark:bg-indigo-950/40" : "")"
                                @onclick="() => SelectOfferAsync(index)">

                                <td class="px-2 py-1.5 align-middle">
                                    <span class="block truncate max-w-[160px] text-slate-700 dark:text-slate-200">
                                        @(string.IsNullOrEmpty(cat.Organisation)
                                              ? ""
                                              : $"{cat.Organisation} > {cat.SubCategory} > {cat.Category}")
                                    </span>
                                </td>

                                <td class="px-2 py-1.5 align-middle">
                                    <span class="block truncate max-w-xs text-slate-700 dark:text-slate-200">
                                        @cat.CalcName (@cat.CalcCode)
                                        &nbsp;&gt;&nbsp;
                                        @cat.TaskName (@cat.TaskCode)
                                        &nbsp;&gt;&nbsp;
                                        @cat.ResName
                                    </span>
                                </td>

                                <td class="px-2 py-1.5 align-middle text-right">
                                    <span class="tabular-nums font-medium text-slate-800 dark:text-slate-100">@cat.Cost</span>
                                </td>

                                <td class="px-2 py-1.5 align-middle text-right">
                                    <span class="tabular-nums text-slate-500 dark:text-slate-400">@cat.BaseCost</span>
                                </td>

                                <td class="px-2 py-1.5 align-middle text-center text-[11px] text-slate-500 dark:text-slate-400 whitespace-nowrap">
                                    @cat.Date
                                </td>
                            </tr>

                            @if (isExpanded)
                            {
                                <tr class="bg-indigo-50/60 dark:bg-indigo-950/20">
                                    <td></td>
                                    <td colspan="4" class="px-3 py-2 text-[11px] text-slate-600 dark:text-slate-300">
                                        <div class="flex flex-wrap gap-x-4 gap-y-0.5">
                                            <div>
                                                <span class="font-semibold text-slate-400 dark:text-slate-500">@ResourceApp.organisation:</span>
                                                <span class="ms-1">
                                                    @(string.IsNullOrEmpty(cat.Organisation) ? "-" : $"{cat.Organisation} > {cat.SubCategory} > {cat.Category}")
                                                </span>
                                            </div>
                                            <div>
                                                <span class="font-semibold text-slate-400 dark:text-slate-500">@ResourceLoc.resource:</span>
                                                <span class="ms-1">@cat.CalcName (@cat.CalcCode) &gt; @cat.TaskName (@cat.TaskCode) &gt; @cat.ResName</span>
                                            </div>
                                            <div>
                                                <span class="font-semibold text-slate-400 dark:text-slate-500">@CalcResource.cost:</span>
                                                <span class="ms-1 tabular-nums">@cat.Cost</span>
                                                <span class="mx-2 text-slate-300 dark:text-slate-600">/</span>
                                                <span class="font-semibold text-slate-400 dark:text-slate-500">@CalcResource.baseCost:</span>
                                                <span class="ms-1 tabular-nums">@cat.BaseCost</span>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

</div>
@code {
    [Parameter] public EventCallback<int> OnOfferSelected { get; set; }

    private async Task SelectOfferAsync(int index)
    {
        SelectedOfferIndex = index;
        if (OnOfferSelected.HasDelegate)
        {
            await OnOfferSelected.InvokeAsync(index);
        }
    }

    private int? SelectedOfferIndex { get; set; }
    private int? ExpandedOfferIndex { get; set; }

    private void SelectOffer2(int index)
    {
        SelectedOfferIndex = index;
    }

    private void ToggleExpand(int index)
    {
        ExpandedOfferIndex = ExpandedOfferIndex == index ? null : index;
    }
}
