@using ProjectManagement.Client.Pages.Project.Storage.Row
@using ProjectManagement.Client.Pages.Project.Storage.Storages
@using ProjectManagement.Shared.DTO.App.Dataloader
@using ProjectManagement.Shared.DTO.Project
@inherits AppComponentBase
@if (Post.AuthoritySelected == AuthorityStorage.program)
{
    <ProjectManagement.Client.Pages.Project.Storage.App.TaskList
    RefreshBack="StateHasChanged">
    <Content>
            <select class="@($"{InputClass} w-[170px] max-w-[170px]")"
                    value="@((int)Post.AuthoritySelected)"
                    @onchange="GetAuthorityStorage">
                @foreach (AuthorityStorage level in Enum.GetValues<AuthorityStorage>())
                {
                    <option value="@((int)level)">@AppLoc[level.ToString()]</option>
                }
            </select>

    </Content>
</ProjectManagement.Client.Pages.Project.Storage.App.TaskList>
}
else
{
    <div class="sticky top-0 z-10 mb-1 flex flex-nowrap items-center justify-between gap-2 overflow-x-auto bg-white dark:bg-slate-900">
        <div class="flex min-w-0 flex-nowrap items-center gap-2">
            <!-- اختيار نوع Authority -->
            <select class="@($"{InputClass} w-[170px] max-w-[170px]")"
                    @onchange="(e) => GetAuthorityStorage(e)">
                @foreach (var level in Enum.GetValues<AuthorityStorage>())
                {
                    <option value="@((int)level)">@AppLoc[level.ToString()]</option>
                }
            </select>

            <!-- اختيار نوع التخزين إن لم يكن ImportFromOtherCalc أو program -->
            @if (Post.AuthoritySelected != AuthorityStorage.ImportFromOtherCalc)
            {
                <select class="@($"{InputClass} w-[180px] max-w-[180px]")"
                        @onchange="(e) => GetStorageSort(e)">
                    @foreach (StorageSort level in Enum.GetValues(typeof(StorageSort)))
                    {
                        <option value="@level">@ResourceLocalize.GetStorageSort(level)</option>
                    }
                </select>
            }
        </div>

        <!-- الأزرار -->
        <div class="flex flex-nowrap items-center justify-end gap-1 shrink-0">
            @if (BtnMore)
            {
                <button class="shrink-0 rounded-md border border-amber-500 bg-white px-3 py-1 text-sm font-medium text-amber-700 transition hover:bg-amber-500 hover:text-white dark:border-amber-400 dark:bg-slate-800 dark:text-slate-100 dark:hover:bg-amber-500 dark:hover:text-white"
                        @onclick="GetAsync">
                    @ResourceApp.import
                </button>
            }

            <button class="shrink-0 rounded-md border border-amber-500 bg-white px-3 py-1 text-sm font-medium text-amber-700 transition hover:bg-amber-500 hover:text-white dark:border-amber-400 dark:bg-slate-800 dark:text-slate-100 dark:hover:bg-amber-500 dark:hover:text-white"
                    @onclick="GetAsync">
                @ResourceApp.import
            </button>

            @if (SaveBtnVisivble())
            {
                <button class="shrink-0 rounded-md border border-green-500 bg-white px-3 py-1 text-sm font-medium text-green-700 transition hover:bg-green-500 hover:text-white dark:border-green-400 dark:bg-slate-800 dark:text-slate-100 dark:hover:bg-green-500 dark:hover:text-white"
                        @onclick="SaveAsync">
                    @ResourceApp.save
                </button>
            }
        </div>
    </div>

    @if (Post.AuthoritySelected == AuthorityStorage.ImportFromOtherCalc)
    {
        <CalcItemsFilter @ref="ImportOtherCalc"
                         ItemType="Post.Type"
                         MaxFractionDigits="MaxFractionDigits"
                         Callback="StateHasChanged"></CalcItemsFilter>
    }
    else
    {
            <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-600">
                <HeaderStorageUI></HeaderStorageUI>
                <tbody class="divide-y divide-gray-100 hover:divide-gray-200 dark:divide-gray-700">
                    <UserStorage Type="Post.Type"
                                 ParentID="ParentID"
                                 MaxFractionDigits="MaxFractionDigits"
                                 @ref="UserStorage"
                                 Callback="StateHasChanged"></UserStorage>
                </tbody>
            </table>
    }
}
       
        @code {
    private string InputClass => "border border-gray-300 rounded px-2 py-0 text-[13px] leading-tight h-[25px] bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white";

    [Parameter] public int ParentID { get; set; }
    [Parameter] public CalculationItemType CalcType { get; set; }

    CalcItemsFilter? ImportOtherCalc;
    UserStorage? UserStorage;
    bool BtnMore = false;
    GetFilterDTO Post = new GetFilterDTO();
    private int MaxFractionDigits => Math.Clamp(Template?.MathRound ?? NumericFormatHelper.DefaultMaxFractionDigits, 0, 15);
    protected override void OnInitialized() => Post.Type = CalcType;

    bool SaveBtnVisivble()
    {
        return ( UserStorage != null && UserStorage.SaveBtnVisible())
        || (Post.AuthoritySelected == AuthorityStorage.ImportFromOtherCalc && Post.AuthoritySelected == AuthorityStorage.ImportFromOtherCalc
            && ImportOtherCalc != null && ImportOtherCalc.Post.Items != null
            && ImportOtherCalc.Post.Items.Any());
    }

    async Task ChangeTypeAsync(ChangeEventArgs e)
    {
        var typeValue = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(typeValue)) return;

        Post.Type = (CalculationItemType)Enum.Parse(typeof(CalculationItemType), typeValue);
        if (Post.AuthoritySelected == AuthorityStorage.ImportFromOtherCalc && ImportOtherCalc is not null){
            await ImportOtherCalc.SetNewTypeAsync(Post.Type);
        }
    }

    void ChangeItemCalcCategories(ChangeEventArgs e)
    {
        Post.ItemCalcCategory = e.Value?.ToString() ?? string.Empty;
    }

    async Task SaveAsync()
    {
        bool result = false;
        if (Post.AuthoritySelected == AuthorityStorage.ImportFromOtherCalc)
            result = ImportOtherCalc is not null && await ImportOtherCalc.SaveAsync(ParentID);

        else result = UserStorage is not null && await UserStorage.SaveAsync();
        if (result && (Post.AuthoritySelected == AuthorityStorage.ImportFromOtherCalc || Post.Type == CalculationItemType.resource))
            await CalcService.RefreshAfterStructuralMutationAsync();

        MHD.Notifications(ToastType.Info, result);
        await Modal.CloseAsync();
    }

    void GetStorageSort(ChangeEventArgs e)
    {
        var sortValue = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(sortValue)) return;
        Post.SortSelected = (StorageSort)Enum.Parse(typeof(StorageSort), sortValue);
    }
   void GetAuthorityStorage(ChangeEventArgs e)
    {
        var authorityValue = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(authorityValue)) return;

        AuthorityStorage n = (AuthorityStorage)Enum.Parse(typeof(AuthorityStorage), authorityValue);
        Post.AuthoritySelected = n;
        StateHasChanged();
    }

    async Task GetAsync()
    {
        if (Post.AuthoritySelected == AuthorityStorage.ImportFromOtherCalc)
        {
            if (ImportOtherCalc is not null)
                await ImportOtherCalc.GetObjectTypeAsync(1);
        }
        else if (UserStorage is not null)
        {
            await UserStorage.GetAsync(Post);
        }
    }
}
