@using ProjectManagement.Client.Pages.Project.Storage.Row
@using ProjectManagement.Client.Shared.MVVM.Calculation
@inherits AppComponentBase
    <EditForm id="filterForm" Model="@Filter" class="grid grid-cols-1 md:grid-cols-4 gap-2">
            @if (FoldersList != null && FoldersList.Count> 0)
            {
                <div>
                    <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@ResourceLoc.folder</label>
                <InputSelect class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" @bind-Value:get="Filter.FolderID" @bind-Value:set="(value) => FolderChanged(value)">
                        <option></option>
                        @foreach (var status in FoldersList)
                        {
                            <option value="@status.Id">@status.Name</option>
                        }
                    </InputSelect>
                </div>
                @if (Projects != null && Projects.Count > 0)
                {
                <div>
                        <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.project</label>
                    <InputSelect class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" @bind-Value:get="Filter.ProjectID" @bind-Value:set="(value) => ProjectChanged(value)">
                            <option></option>
                            @foreach (var status in Projects)
                            {
                                <option value="@status.Id">@status.Name</option>
                            }
                        </InputSelect>
                    </div>
                    @if (Calcs != null && Calcs.Count > 0)
                    {
                        <div>
                            <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.calculation</label>
                        <InputSelect class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" @bind-Value:get="Filter.CalculationID" @bind-Value:set="(value) => CalcChanged(value)">
                                <option value="0"></option>
                                @foreach (var status in Calcs)
                                {
                                    <option value="@status.Id">@status.Name</option>
                                }
                            </InputSelect>
                        </div>
                    }
                }
            }
            <div>
                <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.code </label>
                <InputText @bind-Value="Filter.Code" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" />
            </div>
            <div>
                <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.name </label>
                <InputText @bind-Value="Filter.Name" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" />
            </div>
        <div>
            <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.unit </label>
            <InputText @bind-Value="Filter.Unit" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" />
        </div>
        @if (Post.Type == CalculationItemType.task)
            {
                @if (TGSStatuses != null)
                {
                    <div>
                        <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.status</label>
                        <InputSelect @bind-Value="Filter.Status" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white">
                            <option value="0"></option>
                            @foreach (var status in TGSStatuses)
                            {
                                <option value="@status.Id">@status.Name</option>
                            }
                        </InputSelect>
                    </div>
                }
            }
            else
            {
            <div>
                <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.accountGroups</label>
                <InputSelect class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" @bind-Value:get="AccountGroupSelected.Id" @bind-Value:set="(value) => ChangeGroupAccount(value)">
                    <option></option>
                    @if (Config.AccountGroups != null) foreach (var status in Config.AccountGroups)
                    {
                        <option value="@status.Id">@status.Name</option>
                    }
                </InputSelect>
            </div>
                @if (Accounts != null && Accounts.Count > 0)
                {
                <div>
                    <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.account</label>
                    <InputSelect class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" @bind-Value:get="Filter.Account" @bind-Value:set="(value) => Filter.Account = value">
                        <option></option>
                        @foreach (var status in Accounts)
                        {
                            <option value="@status.Id">@status.Name</option>
                        }
                    </InputSelect>
                </div>
                }
                @if (Config.Statues != null)
                {
                    <div>
                        <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.status</label>
                        <InputSelect @bind-Value="Filter.Status" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white">
                            <option value=""></option>
                        @foreach (var status in Config.Statues)
                            {
                                <option value="@status.Id">@status.Name</option>
                            }
                        </InputSelect>
                    </div>
                }
                <div>
                <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.resourceType: </label>
                    <InputSelect @bind-Value="@Filter.ResType" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white">
                    @foreach (ResourceTypesEnum level in Enum.GetValues(typeof(ResourceTypesEnum)))
                    {
                        <option value="@level">@ResourceLocalize.GetResourceType(level)</option>
                    }
                    </InputSelect>
                </div>
            @if (Config.ResourceTypes != null)
                {
                    <div>
                        <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.resourceType</label>
                        <InputSelect class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white"
                                     @bind-Value:get="Filter.ResourceTypeId" @bind-Value:set="(value) =>ChangeResType(value)">
                            <option value=""></option>
                        @foreach (var item in Config.ResourceTypes)
                            {
                                <option value="@item.Id" selected="@(Filter.ResourceTypeId == item.Id)">@item.Name</option>
                            }
                        </InputSelect>
                    </div>
                }
            }
        </EditForm>
    <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-600">
            <HeaderStorageUI></HeaderStorageUI>
        <tbody class="divide-y divide-gray-100 hover:divide-gray-200 dark:divide-gray-700">
                @if (List != null)
                {
                    @if (Post.Type == CalculationItemType.task){
                        foreach (var task in (List as IEnumerable<TaskListMVVM> ?? Enumerable.Empty<TaskListMVVM>())) {
                        <tr class="@UiStyles.ClassTask">
                                <td><span @onclick="()=> Add(task.Id,task.Metadata.Quantity)" class="@(Post.Items.Any(x => x.Id == task.Id) ? "text-danger" : "text-primary")">
                                    @((MarkupString)(Post.Items.Any(x => x.Id == task.Id) ? Icons.Minus : Icons.Plus))
                    </span>
                </td>
                                <td>@task.Metadata.Code</td>
                                <td><input type="checkbox" disabled checked="@task.Metadata.IsActive" /></td>
                                <td>@task.Name</td>
                                <td>@task.Metadata.Quantity / @task.BaseCost</td>
                                <td>@task.Metadata.Unit</td>
                                <td>@task.Metadata.ChangeFactor1</td>
                                <td>@task.Metadata.ChangeFactor2</td>
                                <td>@task.Metadata.Cap</td>
                                <td></td>
                            </tr>
                                    }
                                    }
                    else if (Post.Type == CalculationItemType.resource)
                        foreach (var Resource in (List as IEnumerable<ResourceListMVVM> ?? Enumerable.Empty<ResourceListMVVM>()))
                        {
                        <tr class="@UiStyles.ClassResource">
                                <td><span @onclick="()=> Add(Resource.Id,Resource.Quantity)" class="@(Post.Items.Any(x => x.Id == Resource.Id) ? "text-danger" : "text-primary")">
                                    @((MarkupString)(Post.Items.Any(x => x.Id == Resource.Id) ? Icons.Minus : Icons.Plus))
                    </span></td>
                                <td></td>
                                <td><input type="checkbox" disabled checked="@Resource.Active" /></td>
                                <td>@Resource.Name</td>
                                <td>@String.Format("{0:0.##}", Resource.BaseCost)</td>
                                <td>@Resource.Cost / @Resource.Unit</td>
                                <td>@Resource.ChangeFactor1</td>
                                <td>@Resource.ChangeFactor2</td>
                                <td>@Resource.CapWaste</td>
                                <td>@Resource.CO2</td>
                            </tr>
                        }
                }
            </tbody>
        </table>
