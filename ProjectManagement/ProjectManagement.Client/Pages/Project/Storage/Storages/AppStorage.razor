@using ProjectManagement.Client.Extensions.Storage
@using ProjectManagement.Client.Shared.Model.Tenant
@using ProjectManagement.Shared.DTO.App.Dataloader
@using ProjectManagement.Shared.DTO.Calculation
@using ProjectManagement.Shared.DTO.Project
@inherits AppComponentBase


@if (tasks != null) foreach (var task in tasks)
    {
        <div class="bg-white dark:bg-gray-800 shadow rounded-2xl px-4 mb-1 border border-gray-200 dark:border-gray-700">
            <div class="app-storage-task-layout mb-0 text-gray-900 dark:text-gray-100">
                <div>
                    <h2 class="flex flex-wrap items-center gap-2 text-xl font-semibold text-blue-700">
                        @task.Name
                        <button @onclick="() => CalcFunk(task)" class="px-2 py-1 border border-blue-600 text-blue-600 rounded transition hover:bg-blue-600 hover:text-white dark:border-blue-400 dark:text-blue-400 dark:hover:bg-blue-400 dark:hover:text-white">@AppLoc["Button_Apply"]</button>
                        <span role="button" @onclick="() => AddRemoveTask(task)" class="@(TaskResSelecteds.Any(x => x.Id == task.Id) ? "text-danger" : "text-primary")">
                            @((MarkupString)(TaskResSelecteds.Any(x => x.Id == task.Id) ? Icons.Minus : Icons.Plus2))
                        </span>
                    </h2>
                    <p class="text-sm text-gray-500">@CalcResource.code: @task.Code | @CalcResource.quantity: @FormatNumber(task.Quantity) @task.Unit</p>
                </div>
                <div class="app-storage-conditions-wrap">
                    @if ((task.ConditionEffect == null || task.ConditionEffect?.Any() != true))
                    {
                        <p class="text-gray-600 dark:text-gray-300 italic">@StorageLoc["storageNoConditions"]</p>
                    }
                    else
                    {
                        @if (task.ConditionEffect != null)
                        {
                            <div class="condition-cards-grid">
                                @foreach (var condition in task.ConditionEffect)
                                {
                                    @if (condition.ExternalVariables.Any() || condition.Items.Count > 1)
                                    {
                                        <div class="condition-card border border-gray-300 dark:border-gray-700 rounded-xl p-3 shadow-sm bg-white dark:bg-gray-800">
                                            <div class="mb-2">
                                                <h2 class="text-lg font-bold text-gray-800 dark:text-gray-100">@condition.Name</h2>
                                            </div>

                                            @if (condition.Items.Count > 1)
                                            {
                                                <div class="mb-3">
                                                    <div class="condition-options-grid">
                                                        @foreach (var item in condition.Items)
                                                        {
                                                            <label class="condition-choice flex items-center gap-2 rounded-lg border border-gray-200 px-3 py-2 text-sm text-gray-700 transition hover:bg-gray-50 dark:border-gray-600 dark:text-gray-100 dark:hover:bg-gray-700">
                                                                @if (condition.IsMultiSelect)
                                                                {
                                                                    <input type="checkbox"
                                                                           class="h-4 w-4 accent-blue-600"
                                                                           @bind="item.IsSelected" />
                                                                }
                                                                else
                                                                {
                                                                    <input type="radio"
                                                                           name="@GetConditionGroupName("task", task.Id, condition)"
                                                                           class="h-4 w-4 accent-blue-600"
                                                                           checked="@item.IsSelected"
                                                                           @onchange="() => OnSingleSelectionChanged(item.Id.ToString(), condition)" />
                                                                }
                                                                <span>@item.Name</span>
                                                            </label>
                                                        }
                                                    </div>
                                                </div>
                                            }

                                            @if (condition.ExternalVariables.Any())
                                            {
                                                <div class="mb-1">
                                                    <h3 class="font-semibold text-sm text-gray-700 dark:text-gray-300 mb-2">
                                                        <span class="text-xs px-2 py-0 bg-blue-100 dark:bg-blue-800 text-blue-700 dark:text-blue-200 rounded-full">
                                                            @StorageLoc["storageVariables"]: @condition.ExternalVariables.Count
                                                        </span>
                                                        @StorageLoc["storageEnterVariables"]
                                                    </h3>
                                                    <div class="condition-variables-grid">
                                                        @foreach (var variable in condition.ExternalVariables)
                                                        {
                                                            <div>
                                                                <label class="block text-xs font-medium text-gray-600 dark:text-gray-300 mb-1">
                                                                    @variable.DisplayName
                                                                </label>

                                                                @if (variable.AllowedValues is { Count: > 0 })
                                                                {
                                                                    <select class="w-full bg-white dark:bg-gray-700 text-sm rounded border-gray-300 dark:border-gray-600 text-gray-900 dark:text-gray-100"
                                                                            @bind="variable.Value">
                                                                        @foreach (var val in variable.AllowedValues)
                                                                        {
                                                                            <option value="@val">@FormatNumber(val)</option>
                                                                        }
                                                                    </select>
                                                                }
                                                                else
                                                                {
                                                                    <TrimmedNumberInput TValue="decimal?"
                                                                                        class="w-full bg-white dark:bg-gray-700 text-sm rounded border-gray-300 dark:border-gray-600 text-gray-900 dark:text-gray-100 px-2"
                                                                                        @bind-Value="variable.Value"
                                                                                        MaxFractionDigits="@MaxFractionDigits"
                                                                                        step="any"
                                                                                        min="@variable.Min"
                                                                                        max="@variable.Max" />
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        }
                    }
                </div>
            </div>

            @if (task.Resources?.Count > 0)
            {
                <div class="overflow-x-auto">
                    <table class="min-w-full text-sm text-left text-gray-700 dark:text-gray-200">
                        <thead class="bg-gray-100 dark:bg-gray-700 text-xs text-gray-600 dark:text-gray-300 uppercase border-b dark:border-gray-600">
                            <tr>
                                <th class="px-4 py-2">@CalcResource.name</th>
                                <th class="px-4 py-2">@CalcResource.quantity</th>
                                <th class="px-4 py-2">@CalcResource.unit</th>
                                <th class="px-4 py-2">@CalcResource.cost</th>
                                <th class="px-4 py-2">@CalcResource.baseCost</th>
                                <th class="px-4 py-2">@CalcResource.cap / @CalcResource.waste</th>
                                <th class="px-4 py-2">@CalcResource.changeFactor1 / 2</th>

                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var res in task.Resources)
                            {
                                <tr class="border-b dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700 transition cursor-pointer text-gray-800 dark:text-gray-200"
                                    @onclick="() => ToggleConditionRow(res)">
                                    <td class="px-4 py-2 font-medium">
         
                                        <span role="button" @onclick="() => AddRemoveRes(task.Id,res.Id)"
                                              @onclick:stopPropagation="true"
                                              class="@(IsTaskResourceSelected(task.Id, res.Id) ? "text-danger" : "text-primary")">
@((MarkupString)(IsTaskResourceSelected(task.Id, res.Id) ? Icons.Minus : Icons.Plus2))
                                        </span>
                                        <span>  @res.Name</span>
                                      
                                    </td>
                                    <td class="px-4 py-2">@FormatNumber(res.Quantity)</td>
                                    <td class="px-4 py-2">@res.Unit</td>
                                    <td class="px-4 py-2 text-green-600 font-semibold">@FormatNumber(res.Data?.Cost)</td>
                                    <td class="px-4 py-2">@FormatNumber(res.Data?.BaseCost)</td>
                                    <td class="px-4 py-2">@FormatNumber(res.Data?.CapWaste)</td>
                                    <td class="px-4 py-2">@FormatNumber(res.Data?.ChangeFactor1) / @FormatNumber(res.Data?.ChangeFactor2)</td>
                                </tr>
                                @if (IsConditionRowVisible(res.Id))
                                {
                                    <tr class="bg-gray-50 dark:bg-gray-800 border-b dark:border-gray-700">
                                        <td colspan="7" class="px-4 py-2">
                                            <div class="condition-cards-grid text-gray-800 dark:text-gray-200">
                                                @foreach (var condition in res.ConditionEffect)
                                                {
                                                    @if (condition.ExternalVariables.Any() || condition.Items.Count > 1)
                                                    {
                                                        <div class="condition-card border border-gray-300 dark:border-gray-600 rounded-md p-3 bg-white dark:bg-gray-900 text-xs shadow-sm">
                                                            <h2 class="font-semibold text-gray-800 dark:text-gray-100 mb-2">@condition.Name</h2>
                                                            @if (condition.Items.Count > 1)
                                                            {
                                                                <div class="mb-3">
                                                                    <div class="condition-options-grid">
                                                                        @foreach (var item in condition.Items)
                                                                        {
                                                                            <label class="condition-choice flex items-center gap-2 rounded-lg border border-gray-200 px-3 py-2 text-sm text-gray-700 transition hover:bg-gray-50 dark:border-gray-600 dark:text-gray-100 dark:hover:bg-gray-700">
                                                                                @if (condition.IsMultiSelect)
                                                                                {
                                                                                    <input type="checkbox"
                                                                                           class="h-4 w-4 accent-blue-600"
                                                                                           @bind="item.IsSelected" />
                                                                                }
                                                                                else
                                                                                {
                                                                                    <input type="radio"
                                                                                           name="@GetConditionGroupName("resource", res.Id, condition)"
                                                                                           class="h-4 w-4 accent-blue-600"
                                                                                           checked="@item.IsSelected"
                                                                                           @onchange="() => OnSingleSelectionChanged(item.Id.ToString(), condition)" />
                                                                                }
                                                                                <span>@item.Name</span>
                                                                            </label>
                                                                        }
                                                                    </div>
                                                                </div>
                                                            }
                                                            @if (condition.ExternalVariables.Any())
                                                            {
                                                                <div class="condition-variables-grid mt-2">
                                                                    @foreach (var variable in condition.ExternalVariables)
                                                                    {
                                                                        <div class="flex flex-col w-full">
                                                                            <label class="text-gray-700 dark:text-gray-300 mb-1">@variable.DisplayName:</label>

                                                                            @if (variable.AllowedValues?.Count > 0)
                                                                            {
                                                                                <select class="p-1 border text-xs rounded bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100"
                                                                                        @bind="variable.Value">
                                                                                    <option value="">-- @AppLoc["select"] --</option>
                                                                                    @foreach (var val in variable.AllowedValues)
                                                                                    {
                                                                                        <option value="@val">@FormatNumber(val)</option>
                                                                                    }
                                                                                </select>
                                                                            }
                                                                            else
                                                                            {
                                                                                <TrimmedNumberInput TValue="decimal?"
                                                                                                    class="p-1 border text-xs rounded bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100"
                                                                                                    @bind-Value="variable.Value"
                                                                                                    MaxFractionDigits="@MaxFractionDigits"
                                                                                                    step="any"
                                                                                                    min="@variable.Min"
                                                                                                    max="@variable.Max" />
                                                                            }
                                                                        </div>
                                                                    }
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
    @* <p class="text-sm text-red-500">No resources have been added for this task.</p> *@
            }
        </div>
    }

       
@code {
    [Parameter] public CalculationItemType Type { get; set; }
    [Parameter] public int ParentID { get; set; }
    [Parameter] public EventCallback Callback { get; set; }
    List<ConditionDto>? Conditions;
    List<TaskWithResourcesMDto>? tasks;
    List<TaskResSelected> TaskResSelecteds = new();
 
    void AddRemoveTask(TaskWithResourcesMDto ts)
    {
        var o = TaskResSelecteds.FirstOrDefault(x => x.Id == ts.Id);
        if (o == null){
                var toadd = new TaskResSelected() { Id = ts.Id, Resoueces = ts.Resources.Select(x => x.Id).ToList() };
                if (toadd.Resoueces == null) toadd.Resoueces = [];
                TaskResSelecteds.Add(toadd);
        }
        else TaskResSelecteds.Remove(o);
    }
    void AddRemoveRes(int id,int resId)
    {
        var o = TaskResSelecteds.FirstOrDefault(x => x.Id == id);
        if (o == null) TaskResSelecteds.Add(new() { Id = id, Resoueces = [resId] });
        else
        {
            var re = o?.Resoueces?.FirstOrDefault(x => x == resId);
            if (re == null || re ==0) o?.Resoueces?.Add(resId);
            else o?.Resoueces?.Remove(resId);
        }
    }
    bool IsTaskResourceSelected(int taskId, int resourceId)
        => TaskResSelecteds.FirstOrDefault(x => x.Id == taskId)?.Resoueces?.Contains(resourceId) == true;

    static bool TryRestoreResourceDefaults(ResourceEXDto resource)
    {
        if (resource.Values is null || resource.Values.Count < 4)
            return false;

        resource.Data.CapWaste = resource.Values[0];
        resource.Data.ChangeFactor1 = resource.Values[1];
        resource.Data.ChangeFactor2 = resource.Values[2];
        resource.Data.BaseCost = resource.Values[3];
        return true;
    }

    public async Task GetAsync()
    {
        tasks = null;
        if (Type == CalculationItemType.task)
        {
            if (Conditions == null && Type == CalculationItemType.task)
            {
                Conditions = await Repo.Storage.GetConditionsAsync();
                tasks = await Repo.Storage.GetTasksAppAsync();
                if (tasks != null) foreach (var ts in tasks)
                        if (ts.Resources != null) foreach (var res in ts.Resources)
                            {
                                res.Backup();
                            }
            }
        }
    }
    private void OnSingleSelectionChanged(string? e, ConditionDto cat)
    {
        foreach (var item in cat.Items)
        {
            item.IsSelected = false;
        }
        var ttt = cat.Items.FirstOrDefault(x => x.Id.ToString() == e);
        if (ttt == null) return;
        ttt.IsSelected = true;
    }
    void RefREsh() => StateHasChanged();
    private HashSet<int> VisibleConditionRows = new();
    void ToggleConditionRow(ResourceEXDto res)
    {
        if (res.ConditionEffect == null || res.ConditionEffect.Count == 0) return;
        if (VisibleConditionRows.Contains(res.Id))
            VisibleConditionRows.Remove(res.Id);
        else
            VisibleConditionRows.Add(res.Id);
    }
    bool IsConditionRowVisible(int id) => VisibleConditionRows.Contains(id);
    void CalcFunk(TaskWithResourcesMDto task)
    {
        var listcond = task.ConditionEffect.SelectMany(x => x.Items).Where(x => x.IsSelected).ToList();
        Dictionary<string, decimal> externalVariables = task.ConditionEffect.SelectMany(x => x.ExternalVariables)
    .Where(x => x.Value.HasValue).ToDictionary(x => x.VariableName, x => x.Value.GetValueOrDefault());
        if (task.Resources != null) foreach (var resource in task.Resources)
            {
                if (!TryRestoreResourceDefaults(resource))
                    continue;
                @* resource.Data.Cost = resource.Values.Count > 4 ? resource.Values[4] : resource.Data.Cost; *@

                var conds = task.ConditionEffect.Where(x => resource.ConditionTaskIds.Any(c => c == x.Id))
                            .SelectMany(x => x.Items).Where(x => x.IsSelected).ToList();
                if (conds != null) foreach (var eq in conds)
                        foreach (var e in eq.Equations)
                        {
                            if (e.Types.Any(x => x == resource.ResType))
                                resource.Calculate(e.TargetVarible, e.Formula, externalVariables);
                        }
                foreach (var rescon in resource.ConditionEffect)
                {
                Dictionary<string, decimal> exvar = rescon.ExternalVariables
                                    .Where(x => x.Value.HasValue)
                                    .ToDictionary(
                                    x => x.VariableName,
                                    x => x.Value.GetValueOrDefault()
                                    );

                    foreach (var item in rescon.Items)
                        if (item.IsSelected) foreach (var eq in item.Equations)
                            {
                                if (eq.Types.Any(x => x == resource.ResType))
                                    resource.Calculate(eq.TargetVarible, eq.Formula, exvar);

                            }
                }
            }
    }


    class TaskResSelected()
    {
        public int Id { get; set; }
        public List<int>? Resoueces { get; set; }
    }

    private static string GetConditionGroupName(string scope, int ownerId, ConditionDto condition)
        => $"{scope}-{ownerId}-condition-{condition.Id}";

    private int MaxFractionDigits => Math.Clamp(Template?.MathRound ?? NumericFormatHelper.DefaultMaxFractionDigits, 0, 15);

    private string FormatNumber(decimal value)
        => NumericFormatHelper.Format(value, MaxFractionDigits);

    private string FormatNumber(decimal? value)
        => NumericFormatHelper.Format(value, MaxFractionDigits);
}
