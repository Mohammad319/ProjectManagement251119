@using ProjectManagement.Client.Extensions.Storage
@using ProjectManagement.Client.Shared.Model.Tenant
@using ProjectManagement.Shared.DTO.App.Dataloader
@using ProjectManagement.Shared.DTO.Calculation
@using ProjectManagement.Shared.DTO.Project
@inherits AppComponentBase


@if (tasks != null) foreach (var task in tasks)
    {
        <div class="bg-white dark:bg-gray-800 shadow rounded-2xl px-4 mb-1 border border-gray-200 dark:border-gray-700">
            <div class="flex justify-between items-center mb-0 text-gray-900 dark:text-gray-100">
                <div>
                    <h2 class="text-xl font-semibold text-blue-700">
                        @task.Name
                        <button @onclick="() => CalcFunk(task)" class="@CssClasses.Btn.Outline.Primary">Applay</button>
                        <span role="button" @onclick="() => AddRemoveTask(task)" class="@(TaskResSelecteds.Any(x => x.Id == task.Id) ? "text-danger" : "text-primary")">
                            @((MarkupString)(TaskResSelecteds.Any(x => x.Id == task.Id) ? Icons.Minus : Icons.Plus2))
                        </span>
                    </h2>
                    <p class="text-sm text-gray-500">@CalcResource.code: @task.Code | @CalcResource.quantity: @task.Quantity @task.Unit</p>
                </div>
                <div class="flex justify-between items-center">
                    @if ((task.ConditionEffect == null || task.ConditionEffect?.Any() != true))
                    {
                        <p class="text-gray-600 dark:text-gray-300 italic">لا توجد شروط.</p>
                    }
                    else
                    {
                        @if (task.ConditionEffect != null) foreach (var condition in task.ConditionEffect)
                                if (condition.ExternalVariables.Any() || condition.Items.Count > 1)
                                {
                                    <div class="border border-gray-300 dark:border-gray-700 rounded-xl p-1 shadow-sm bg-white dark:bg-gray-800">
                                        <div class="flex justify-between items-center mb-1">
                                            <div>
                                                <h2 class="text-lg font-bold text-gray-800 dark:text-gray-100">@condition.Name</h2>
                                                @if (condition.Items.Count > 1)
                                                {
                                                    <div class="flex justify-between items-center">

                                                        @if (condition.IsMultiSelect)
                                                        {
                                                            <div class="w-60 h-30 overflow-auto border rounded px-1">
                                                                <select class="w-full h-full p-2 text-sm" @onchange="(ev) => OnMultiSelectionChanged(ev, condition)">

                                                                    @foreach (var item in condition.Items)
                                                                    {
                                                                        <option value="@(item.Id)">
                                                                            @item.Name
                                                                        </option>
                                                                    }
                                                                </select>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="px-1">
                                                                <select class="@CssClasses.Input.Text" @onchange="(e) => OnSingleSelectionChanged(e.Value.ToString(), condition)">
                                                                    <option></option>

                                                                    @foreach (var item in condition.Items)
                                                                    {
                                                                        <option value="@( item.Id)">@item.Name</option>
                                                                    }
                                                                </select>
                                                            </div>
                                                        }

                                                    </div>
                                                }
                                            </div>

                                        </div>

                                        @if (condition.ExternalVariables.Any())
                                        {
                                            <div class="mb-1">
                                                <h3 class="font-semibold text-sm text-gray-700 dark:text-gray-300 mb-1">
                                                    <span class="text-xs px-2 py-0 bg-blue-100 dark:bg-blue-800 text-blue-700 dark:text-blue-200 rounded-full">
                                                        متغيرات: @condition.ExternalVariables.Count
                                                    </span>
                                                    🔢 إدخال قيم المتغيرات:
                                                </h3>
                                                <div class="grid">
                                                    @foreach (var variable in condition.ExternalVariables)
                                                    {
                                                        <div>
                                                            <label class="block text-xs font-medium text-gray-600 dark:text-gray-300 mb-0">
                                                                @variable.DisplayName
                                                            </label>

                                                            @if (variable.AllowedValues is { Count: > 0 })
                                                            {
                                                                <select class="w-full bg-white dark:bg-gray-700 text-sm rounded border-gray-300 dark:border-gray-600 text-gray-900 dark:text-gray-100"
                                                                        @bind="variable.Value">
                                                                    @foreach (var val in variable.AllowedValues)
                                                                    {
                                                                        <option value="@val">@val</option>
                                                                    }
                                                                </select>
                                                            }
                                                            else
                                                            {
                                                                <input type="number" style="width:90px;"
                                                                       class="w-full bg-white dark:bg-gray-700 text-sm rounded border-gray-300 dark:border-gray-600 text-gray-900 dark:text-gray-100 px-2"
                                                                       @bind="variable.Value"
                                                                       step="any"
                                                                       min="@variable.Min"
                                                                       max="@variable.Max" />
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }

                                    </div>
                                }
                    }
                </div>
            </div>

            @if (task.Resources?.Count > 0)
            {
                <div class="overflow-x-auto">
                    <table class="min-w-full text-sm text-left text-gray-700 dark:text-gray-200">
                        <thead class="bg-gray-100 dark:bg-gray-700 text-xs text-gray-600 dark:text-gray-300 uppercase border-b dark:border-gray-600">
                            <tr>
                                <th class="px-4 py-2">@CalcResource.name</th>
                                <th class="px-4 py-2">@CalcResource.quantity</th>
                                <th class="px-4 py-2">@CalcResource.unit</th>
                                <th class="px-4 py-2">@CalcResource.cost</th>
                                <th class="px-4 py-2">@CalcResource.baseCost</th>
                                <th class="px-4 py-2">CapWaste</th>
                                <th class="px-4 py-2">@CalcResource.changeFactor1 / 2</th>

                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var res in task.Resources)
                            {
                                <tr class="border-b dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700 transition cursor-pointer text-gray-800 dark:text-gray-200"
                                    @onclick="() => ToggleConditionRow(res)">
                                    <td class="px-4 py-2 font-medium">
         
                                        <span role="button" @onclick="() => AddRemoveRes(task.Id,res.Id)"
                                              @onclick:stopPropagation="true"
                                              class="@(TaskResSelecteds.Any(x => x.Id == task.Id) && TaskResSelecteds.First(x=>x.Id == task.Id).Resoueces.Any(r=>r == res.Id)? "text-danger" : "text-primary")">
@((MarkupString)(TaskResSelecteds.Any(x => x.Id == task.Id) && TaskResSelecteds.First(x => x.Id == task.Id).Resoueces.Any(r => r == res.Id) ? Icons.Minus : Icons.Plus2))
                                        </span>
                                        <span>  @res.Name</span>
                                      
                                    </td>
                                    <td class="px-4 py-2">@res.Data?.Quantity</td>
                                    <td class="px-4 py-2">@res.Data?.Unit</td>
                                    <td class="px-4 py-2 text-green-600 font-semibold">@res.Data?.Cost</td>
                                    <td class="px-4 py-2">@res.Data?.BaseCost</td>
                                    <td class="px-4 py-2">@res.Data?.CapWaste</td>
                                    <td class="px-4 py-2">@res.Data?.ChangeFactor1 / @res.Data?.ChangeFactor2</td>
                                </tr>
                                @if (IsConditionRowVisible(res.Id))
                                {
                                    <tr class="bg-gray-50 dark:bg-gray-800 border-b dark:border-gray-700">
                                        <td colspan="7" class="px-4 py-2">
                                            <div class="flex flex-wrap gap-4 text-gray-800 dark:text-gray-200">
                                                @foreach (var condition in res.ConditionEffect)
                                                    if (condition.ExternalVariables.Any() || condition.Items.Count > 1)
                                                    {
                                                        <div class="border border-gray-300 dark:border-gray-600 rounded-md p-3 bg-white dark:bg-gray-900 text-xs w-60 shadow-sm">
                                                            <h2 class="font-semibold text-gray-800 dark:text-gray-100 mb-2">@condition.Name</h2>
                                                            @if (condition.Items.Count > 1)
                                                            {
                                                                @if (condition.IsMultiSelect)
                                                                {
                                                                    <select multiple
                                                                            class="w-full h-20 p-1 border text-xs rounded bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100"
                                                                            @onchange="(ev) => OnMultiSelectionChanged(ev, condition)">
                                                                        @foreach (var item in condition.Items)
                                                                        {
                                                                            <option value="@item.Id">@item.Name</option>
                                                                        }
                                                                    </select>
                                                                }
                                                                else
                                                                {
                                                                    <select class="w-full p-1 border text-xs rounded bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100"
                                                                            @onchange="(e) => OnSingleSelectionChanged(e.Value.ToString(), condition)">
                                                                        <option></option>

                                                                        @foreach (var item in condition.Items)
                                                                        {
                                                                            <option value="@item.Id">@item.Name</option>
                                                                        }
                                                                    </select>
                                                                }
                                                            }
                                                            @if (condition.ExternalVariables.Any())
                                                            {
                                                                <div class="flex flex-wrap gap-2 mt-2">
                                                                    @foreach (var variable in condition.ExternalVariables)
                                                                    {
                                                                        <div class="flex flex-col w-full">
                                                                            <label class="text-gray-700 dark:text-gray-300 mb-1">@variable.DisplayName:</label>

                                                                            @if (variable.AllowedValues?.Count > 0)
                                                                            {
                                                                                <select class="p-1 border text-xs rounded bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100"
                                                                                        @bind="variable.Value">
                                                                                    <option value="">-- اختر --</option>
                                                                                    @foreach (var val in variable.AllowedValues)
                                                                                    {
                                                                                        <option value="@val">@val</option>
                                                                                    }
                                                                                </select>
                                                                            }
                                                                            else
                                                                            {
                                                                                <input type="number"
                                                                                       class="p-1 border text-xs rounded bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100"
                                                                                       @bind="variable.Value"
                                                                                       step="any"
                                                                                       min="@variable.Min"
                                                                                       max="@variable.Max" />
                                                                            }
                                                                        </div>
                                                                    }
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                @* <p class="text-sm text-red-500">لا توجد موارد مضافة لهذه المهمة.</p> *@
            }
        </div>
    }

       
