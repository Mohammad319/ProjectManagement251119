<thead class="bg-slate-100 dark:bg-slate-800 text-[11px] text-slate-700 dark:text-slate-300">
    <tr class="divide-x divide-slate-200 dark:divide-slate-700">
        <th scope="col" class="px-1 py-[2px] font-semibold text-left w-[90px]"></th>
        <th scope="col" class="px-1 py-[2px] font-semibold text-left w-[100px]">
            @CalcResource.code/@CalcResource.account
        </th>
        <th scope="col" class="px-1 py-[2px] font-semibold text-left w-[90px]">
            @CalcResource.active
        </th>
        <th scope="col" class="px-1 py-[2px] font-semibold text-left w-[250px]">
            @CalcResource.name
        </th>
        <th scope="col" class="px-1 py-[2px] font-semibold text-left w-[100px]">
            @CalcResource.baseCost / @CalcResource.quantity
        </th>
        <th scope="col" class="px-1 py-[2px] font-semibold text-left w-[150px]">
            @CalcResource.cost
        </th>
        <th scope="col" class="px-1 py-[2px] font-semibold text-left w-[150px]">
            @CalcResource.unit
        </th>
        <th scope="col" class="px-1 py-[2px] font-semibold text-left w-[170px]">
            @CalcResource.changeFactor1 / 2
        </th>
        <th scope="col" class="px-1 py-[2px] font-semibold text-left w-[150px]">
            @CalcResource.waste / @CalcResource.cap
        </th>
        <th scope="col" class="px-1 py-[2px] font-semibold text-left w-[150px]">
            @CalcResource.co2
        </th>
        <th scope="col" class="px-1 py-[2px] font-semibold text-left w-[150px]">
            @CalcResource.note
        </th>
    </tr>
</thead>

