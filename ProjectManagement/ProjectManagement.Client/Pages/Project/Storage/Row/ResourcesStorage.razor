@using ProjectManagement.Client.Constant;
@using ProjectManagement.Client.Shared.MVVM.Calculation
@using ProjectManagement.Client.Shared.Model.Project.Calculation;
@using ProjectManagement.Shared.DTO.Calculation
<tr class="border-b border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 text-[11px] text-slate-800 dark:text-slate-200">
    <td class="px-1 py-[2px]">@ChildContent</td>
    <td class="px-1 py-[2px]"></td>
    <td class="px-1 py-[2px] text-center">
        <input type="checkbox"
               disabled
               checked="@Resource.IsActive"
               class="h-3 w-3 accent-amber-500 cursor-default" />
    </td>
    <td class="px-1 py-[2px] whitespace-nowrap">@Resource.Name</td>
    <td class="px-1 py-[2px] text-right">@String.Format("{0:0.##}", Resource.Data.BaseCost)</td>
    <td class="px-1 py-[2px] text-right">@String.Format("{0:0.##}", Resource.Data.Cost)</td>
    <td class="px-1 py-[2px] text-center">@Resource.Data.Unit</td>
    <td class="px-1 py-[2px] text-center">@Resource.Data.ChangeFactor1 / @Resource.Data.ChangeFactor2</td>
    <td class="px-1 py-[2px] text-right">@Resource.Data.CapWaste</td>
    <td class="px-1 py-[2px] text-right">@Resource.Data.CO2</td>
    <td class="px-1 py-[2px] truncate max-w-[160px]">@Resource.Data.Note</td>
</tr>


@code {
    [Parameter, EditorRequired] public ResourcePostDTO Resource { get; set; } = default!;
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;
}
