@using ProjectManagement.Client.Shared.MVVM.Calculation
@using ProjectManagement.Client.Shared.ResourceFiles
@using ProjectManagement.Shared.DTO.Project
@using ProjectManagement.Client.Shared.Model.Project.Calculation
@using ProjectManagement.Client.Shared.ViewModel
@inherits AppComponentBase

<div class="rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">
    <div class="border-b border-slate-200 px-5 py-4 dark:border-slate-700">
        <h3 class="text-base font-semibold text-slate-900 dark:text-slate-100">
            @StorageLoc["storageOptions"]
        </h3>
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
            @StorageLoc["storageOptionsHint"]
        </p>
    </div>

    <div class="space-y-6 p-5">
        <!-- Storage level -->
        <section class="space-y-3">
            <div>
                <h4 class="text-sm font-semibold text-slate-800 dark:text-slate-100">
                    @StorageLoc["storageLevel"]
                </h4>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                    @StorageLoc["storageLevelHint"]
                </p>
            </div>

            <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
                @foreach (AuthorityStorage storage in Enum.GetValues<AuthorityStorage>())
                {
                    if (storage != AuthorityStorage.program && storage != AuthorityStorage.ImportFromOtherCalc)
                    {
                        var isSelected = StorageLevelValue == storage;

                        <button type="button"
                                @onclick="() => SelectStorage(storage)"
                                class="@GetStorageButtonClass(isSelected)">
                            <div class="flex items-center gap-3">
                                <div class="@GetDotOuterClass(isSelected, false)">
                                    <div class="@GetDotInnerClass(isSelected, false)"></div>
                                </div>

                                <span class="font-medium text-slate-700 dark:text-slate-200">
                                    @AppLoc[storage.ToString()]
                                </span>
                            </div>
                        </button>
                    }
                }
            </div>
        </section>

        <!-- Sorting -->
        <section class="space-y-3">
            <div>
                <h4 class="text-sm font-semibold text-slate-800 dark:text-slate-100">
                    @StorageLoc["storageSort"]
                </h4>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                    @StorageLoc["storageSortHint"]
                </p>
            </div>

            <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
                @foreach (StorageSort sort in Enum.GetValues<StorageSort>())
                {
                    var isSelected = StorageSortValue == sort;

                    <button type="button"
                            @onclick="() => SelectStorageSort(sort)"
                            class="@GetSortButtonClass(isSelected)">
                        <div class="flex items-center gap-3">
                            <div class="@GetDotOuterClass(isSelected, true)">
                                <div class="@GetDotInnerClass(isSelected, true)"></div>
                            </div>

                            <span class="font-medium text-slate-700 dark:text-slate-200">
                                @ResourceLocalize.GetStorageSort(sort)
                            </span>
                        </div>
                    </button>
                }
            </div>
        </section>
    </div>

    <div class="flex items-center justify-end gap-2 border-t border-slate-200 px-5 py-4 dark:border-slate-700">
        <button type="button"
                class="inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
                @onclick="Close">
            @ResourceApp.cancel
        </button>

        <button type="button"
                class="inline-flex items-center justify-center rounded-xl bg-emerald-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-400 focus:ring-offset-2 dark:focus:ring-offset-slate-900"
                @onclick="SaveAPI">
            @ResourceApp.save
        </button>
    </div>
</div>

@code {
    private AuthorityStorage StorageLevelValue = AuthorityStorage._private;
    private StorageSort StorageSortValue = StorageSort.Construction;

    [Parameter] public object Parent { get; set; } = default!;

    private CalculationItemType StorageType;
    private string Name = string.Empty;
    private int Id;

    private void GetParentType()
    {
        if (Parent is TaskListMVVM taskListMVVM)
        {
            StorageType = CalculationItemType.task;
            Id = taskListMVVM.Id;
            Name = taskListMVVM.Name;
        }
        else if (Parent is ResourceListMVVM resource)
        {
            StorageType = CalculationItemType.resource;
            Id = resource.Id;
            Name = resource.Name;
        }
    }

    protected override void OnInitialized()
    {
        GetParentType();
    }

    private async Task SaveAPI()
    {
        if (await Repo.Storage.SaveAsync(Id, StorageType, StorageLevelValue, StorageSortValue))
            Close();
    }

    private void SelectStorage(AuthorityStorage value)
    {
        StorageLevelValue = value;
    }

    private void SelectStorageSort(StorageSort value)
    {
        StorageSortValue = value;
    }

    private string GetStorageButtonClass(bool isSelected)
    {
        var baseClass = "w-full rounded-xl border px-4 py-3 text-left transition min-h-[56px] ";
        return isSelected
            ? baseClass + "border-blue-600 bg-blue-50 ring-2 ring-blue-200 dark:border-blue-400 dark:bg-blue-500/10 dark:ring-blue-500/20"
            : baseClass + "border-slate-200 bg-white hover:border-blue-300 hover:bg-blue-50/60 dark:border-slate-700 dark:bg-slate-800 dark:hover:border-blue-500 dark:hover:bg-slate-800";
    }

    private string GetSortButtonClass(bool isSelected)
    {
        var baseClass = "w-full rounded-xl border px-4 py-3 text-left transition min-h-[56px] ";
        return isSelected
            ? baseClass + "border-emerald-600 bg-emerald-50 ring-2 ring-emerald-200 dark:border-emerald-400 dark:bg-emerald-500/10 dark:ring-emerald-500/20"
            : baseClass + "border-slate-200 bg-white hover:border-emerald-300 hover:bg-emerald-50/60 dark:border-slate-700 dark:bg-slate-800 dark:hover:border-emerald-500 dark:hover:bg-slate-800";
    }

    private string GetDotOuterClass(bool isSelected, bool isGreen)
    {
        var selectedClass = isGreen
            ? "border-emerald-600 dark:border-emerald-400"
            : "border-blue-600 dark:border-blue-400";

        var normalClass = "border-slate-400 dark:border-slate-500";

        return $"flex h-4 w-4 items-center justify-center rounded-full border {(isSelected ? selectedClass : normalClass)}";
    }

    private string GetDotInnerClass(bool isSelected, bool isGreen)
    {
        var colorClass = isGreen
            ? "bg-emerald-600 dark:bg-emerald-400"
            : "bg-blue-600 dark:bg-blue-400";

        return $"h-2 w-2 rounded-full {colorClass} {(isSelected ? "opacity-100" : "opacity-0")}";
    }

    private void Close() => Modal.Close();
}
