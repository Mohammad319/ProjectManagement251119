@using ProjectManagement.Shared.DTO.Account
@using ProjectManagement.Shared.DTO.Calculation
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<ResourceApp> AppLoc
@inject IStringLocalizer<ResourceStorage> StorageLoc
@using ProjectManagement.Shared.DTO.ProjectAppStorage
@using ProjectManagement.Shared.DTO.ProjectAppStorage.Service
@using ProjectManagement.Shared.DTO.ResourceType
@using ProjectManagement.Shared.Helper
@using ProjectManagement.Shared.Helper.ProjectAppStorage

@if (Rows is null || !Rows.Any())
{
    <div class="mt-2 rounded border p-1 md:p-2 bg-white/60 dark:bg-gray-900/40 border-gray-200 dark:border-gray-700 text-xs text-gray-500 dark:text-gray-400">
        @StorageLoc["storageNoResourcesAvailable"]
    </div>
}
else
{
    <!-- حاوية الجدول مع شريط تمرير أفقي وعمودي -->
    <div class="w-full max-w-full"
         style="
                max-height: calc(100vh - 220px);
                overflow-x: auto;
                overflow-y: auto;
                -webkit-overflow-scrolling: touch;
             ">
        <table class="text-[11px] leading-tight"
               style="min-width: 1800px; white-space: nowrap;">
            <thead class="bg-gray-100/80 dark:bg-gray-800/70">
                <tr>
                    <th class="px-1 py-0.5 text-left text-[11px] font-semibold w-[60px]">@CalcResource.active</th>
                    <th class="px-1 py-0.5 text-left text-[11px] font-semibold w-[75px]">@CalcResource.account</th>
                    <th class="px-1 py-0.5 text-left text-[11px] font-semibold w-[450px]">@ResourceLoc.resource</th>
                    <th class="px-1 py-0.5 text-left text-[11px] font-semibold w-[75px]">@CalcResource.type</th>
                    <th class="px-1 py-0.5 text-left text-[11px] font-semibold w-[75px]">@CalcResource.resourceSort</th>
                    <th class="px-1 py-0.5 text-left text-[11px] font-semibold w-[75px]">@CalcResource.status</th>
                    <th class="px-1 py-0.5 text-left text-[11px] font-semibold w-[75px]">@CalcResource.unit</th>
                    <th class="px-1 py-0.5 text-left text-[11px] font-semibold w-[75px]">@CalcResource.baseCost</th>
                    <th class="px-1 py-0.5 text-left text-[11px] font-semibold w-[75px]">@CalcResource.cost</th>
                    <th class="px-1 py-0.5 text-left text-[11px] font-semibold w-[75px]">@CalcResource.totalNetCost</th>

                    <th class="px-1 py-0.5 text-left text-[11px] font-semibold w-[75px]">@CalcResource.co2</th>
                    <th class="px-1 py-0.5 text-left text-[11px] font-semibold w-[65px]">@CalcResource.changeFactor1</th>
                    <th class="px-1 py-0.5 text-left text-[11px] font-semibold w-[65px]">@CalcResource.changeFactor2</th>
                    <th class="px-1 py-0.5 text-left text-[11px] font-semibold w-[75px]">@CalcResource.quantity</th>
                    <th class="px-1 py-0.5 text-left text-[11px] font-semibold w-[75px]">@CalcResource.cap / @CalcResource.waste</th>
                    <th class="px-1 py-0.5 text-left text-[11px] font-semibold w-[65px]">@StorageLoc["storageMorning"]</th>
                    <th class="px-1 py-0.5 text-left text-[11px] font-semibold w-[65px]">@StorageLoc["storageMorningCost"]</th>

                    <th class="px-1 py-0.5 text-left text-[11px] font-semibold w-[85px]">@StorageLoc["storageDay"]</th>
                    <th class="px-1 py-0.5 text-left text-[11px] font-semibold w-[65px]">@StorageLoc["storageDayCost"]</th>

                    <th class="px-1 py-0.5 text-left text-[11px] font-semibold w-[65px]">@StorageLoc["storageEvening"]</th>
                    <th class="px-1 py-0.5 text-left text-[11px] font-semibold w-[65px]">@StorageLoc["storageEveningCost"]</th>

                    @if (_propColumns.Count > 0)
                    {
                        @foreach (var col in _propColumns)
                        {
                            <th class="px-1 py-0.5 text-left text-[11px] font-semibold w-[90px]">@col.DisplayName</th>
                        }
                    }
                    <th class="px-1 py-0.5 text-left text-[11px] font-semibold w-[75px]">F</th>
                </tr>
            </thead>

            <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
                @{
                    var renderedMenuKeys = new HashSet<string>(StringComparer.Ordinal);
                    var renderedRowKeyCounts = new Dictionary<string, int>(StringComparer.Ordinal);
                }

                @foreach (var r in Rows)
                {
                    if (r is null)
                        continue;

                    // هل هذا المورد ضمن مجموعة MenuId فيها عنصرين أو أكثر؟
                    var menuGroup = FindGroup(r);
                    var isMenuRow = false;
                    var current = r;

                    if (menuGroup is not null)
                    {
                        // إذا سبق ورسمنا صف لهذه المجموعة في نفس دورة الرسم فلا نعيد رسمها
                        if (!renderedMenuKeys.Add(menuGroup.Key))
                        {
                            continue;
                        }

                        current = menuGroup.Resources.FirstOrDefault(x => x.Id == menuGroup.SelectedResourceId)
                            ?? menuGroup.Resources.FirstOrDefault(x => x.IsAdded)
                            ?? menuGroup.Resources.First();
                        menuGroup.SelectedResourceId = current.Id;
                        isMenuRow = true;
                    }

                    current.Data ??= new ProjectManagement.Shared.Base.Calculation.ResourceMetadata();

                    var hasFormulas = current.Formulas is { Count: > 0 };
                    var assignedTargets = hasFormulas ? ResourceFormulaApplier.GetAssignedTargets(current.Formulas) : null;
                    var baseCostIsDerived = assignedTargets?.Contains(ResourceFieldBaseCost) == true;
                    var costIsDerived = assignedTargets?.Contains(ResourceFieldCost) == true;
                    var expanded = _expanded.Contains(current.Id);

                    var group = (current.GroupId is int gid && gid > 0)
                    ? Config?.AccountGroups?.FirstOrDefault(x => x.Id == gid)
                    : null;

                    var type = (current.ResourceTypeId is int tid)
                    ? Config?.ResourceTypes?.FirstOrDefault(x => x.Id == tid)
                    : null;

                    var baseRowKey = isMenuRow && menuGroup is not null
                        ? $"menu:{menuGroup.Key}"
                        : BuildResourceRowKey(current);
                    var duplicateCount = renderedRowKeyCounts.TryGetValue(baseRowKey, out var seenCount)
                        ? seenCount + 1
                        : 0;
                    renderedRowKeyCounts[baseRowKey] = duplicateCount;
                    var rowKey = duplicateCount == 0
                        ? baseRowKey
                        : $"{baseRowKey}#{duplicateCount}";

                    <tr @key="rowKey" class="hover:bg-amber-50/60 dark:hover:bg-amber-900/20">
                        <!-- Active / Add -->
                        <td class="px-1 py-0.5 text-[11px] text-gray-800 dark:text-gray-300">
                            @if (AddBtnIsVisible)
                            {
                                <button @onclick="() => current.IsAdded = !current.IsAdded"
                                        class="@ToggleClass">
                                    @(current.IsAdded ? "−" : "+")
                                </button>
                            }
                            <input type="checkbox"
                                   class="h-4 w-4 text-blue-600 rounded focus:ring-blue-500 dark:text-blue-400"
                                   checked="@current.Active" disabled />
                        </td>

                        <!-- Account -->
                        <td>
                            <select @bind="current.AccountId"
                                    class="@SelectSt">
                                <option value="">@StorageLoc["storageSelectAccount"]</option>

                                @foreach (var g in (Config?.AccountGroups ?? Enumerable.Empty<AccountGroupsListDto>()))
                                {
                                    <optgroup label="@g.Name">
                                        @foreach (var a in (g.Accounts ?? Enumerable.Empty<ListAccountDTO>()))
                                        {
                                            <option value="@a.Id">@a.Name</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                        </td>

                        <!-- Resource + Dropdown حسب MenuId -->
                        <td class="px-1 py-0.5 text-[11px] text-gray-800 dark:text-gray-300">
                            <div class="inline-flex gap-2">
                                <!-- زر التعديل -->
                                <span class="text-[18px] text-neutral-800 underline hover:text-neutral-900 transition dark:text-neutral-300 dark:hover:text-neutral-100 text-[10px] leading-none px-0.5"
                                      @onclick="async () => await OnEdit.InvokeAsync(current)">
                                    ✎
                                </span>

                                @if (isMenuRow && menuGroup is not null)
                                {
                                    <!-- القائمة المنسدلة للموارد التي لها نفس MenuId -->
                                    <select class="@SelectSt mr-1"
                                            value="@menuGroup.SelectedResourceId"
                                            @onchange="e => OnMenuChanged(menuGroup, e)">
                                        @foreach (var opt in menuGroup.Resources)
                                        {
                                            <option value="@opt.Id">@opt.Name</option>
                                        }
                                    </select>
                                }

                                <!-- اسم المورد / الاسم المخصص -->
                                @if (!NameConfig || string.IsNullOrWhiteSpace(current.NameUserValue))
                                {
                                    <input type="text" @bind="current.Name"
                                           class="w-full border border-gray-300 dark:border-gray-600 rounded px-1 py-0.5 text-[11px]
                                                              bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100
                                                              focus:outline-none focus:ring-1 focus:ring-blue-500" />
                                }
                                else
                                {
                                    <input type="text" @bind="current.NameUserValue"
                                           class="w-full border border-gray-300 dark:border-gray-600 rounded px-1 py-0.5 text-[11px]
                                                              bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100
                                                              focus:outline-none focus:ring-1 focus:ring-blue-500" />
                                }
                            </div>
                        </td>

                        <!-- Type -->
                        <td>
                            <select class="@SelectSt"
                                    @bind="current.ResourceTypeId">
                                <option value=""></option>
                                @if (Config?.ResourceTypes is not null)
                                {
                                    @foreach (var item in Config.ResourceTypes)
                                    {
                                        <option value="@item.Id">@item.Name</option>
                                    }
                                }
                            </select>
                        </td>

                        <!-- Sort -->
                        <td>
                            @if (type?.ResourcesSort is not null)
                            {
                                <select class="@SelectSt"
                                        @bind="current.ResourceSortId">
                                    <option></option>
                                    @foreach (var item in type.ResourcesSort)
                                    {
                                        <option value="@item.Id">@item.Name</option>
                                    }
                                </select>
                            }
                        </td>

                        <!-- Status -->
                        <td>
                            <select @bind="current.StatusId"
                                    class="@SelectSt">
                                <option value=""></option>
                                @if (Config?.Statues is not null)
                                {
                                    foreach (var status in Config.Statues)
                                    {
                                        <option value="@status.Id">@status.Name</option>
                                    }
                                }
                            </select>
                        </td>

                        <!-- Unit / BaseCost / Cost / TotalCost -->
                        <td class="px-1 py-0.5">
                            <input type="text" @bind="current.Data.Unit" class="@St" />
                        </td>
                        <td class="px-1 py-0.5">
                            <input type="text"
                                   inputmode="decimal"
                                   value="@GetResourceInputValue(current, ResourceFieldBaseCost)"
                                   @oninput="e => OnResourceNumberChanged(current, ResourceFieldBaseCost, e)"
                                   @onblur="() => OnResourceNumberBlur(current, ResourceFieldBaseCost)"
                                   class="@St"
                                   disabled="@baseCostIsDerived" />
                        </td>
                        <td class="px-1 py-0.5">
                            <input type="text"
                                   inputmode="decimal"
                                   value="@GetResourceInputValue(current, ResourceFieldCost)"
                                   @oninput="e => OnResourceNumberChanged(current, ResourceFieldCost, e)"
                                   @onblur="() => OnResourceNumberBlur(current, ResourceFieldCost)"
                                   class="@St"
                                   disabled="@costIsDerived" />
                        </td>
                        <td class="px-1 py-0.5">
                            @if (current.Id < 0)
                            {
                                <span>*</span>
                                <input type="text" value="@FormatNumber(TotalCost)" class="@St" disabled />
                            }
                            else
                            {
                                <input type="text" value="@FormatNumber(current.TotalCost)" class="@St" disabled />
                            }
                        </td>

                        <!-- CO2 / ChangeFactors / Quantity / CapWaste -->
                        <td class="px-1 py-0.5">
                            <TrimmedNumberInput TValue="double?"
                                                @bind-Value="current.Data.CO2"
                                                MaxFractionDigits="@MaxFractionDigits"
                                                step="any"
                                                class="@St" />
                        </td>
                        <td class="px-1 py-0.5">
                            <input type="text"
                                   inputmode="decimal"
                                   value="@GetResourceInputValue(current, ResourceFieldChangeFactor1)"
                                   @oninput="e => OnResourceNumberChanged(current, ResourceFieldChangeFactor1, e)"
                                   @onblur="() => OnResourceNumberBlur(current, ResourceFieldChangeFactor1)"
                                   class="@St" />
                        </td>
                        <td class="px-1 py-0.5">
                            <input type="text"
                                   inputmode="decimal"
                                   value="@GetResourceInputValue(current, ResourceFieldChangeFactor2)"
                                   @oninput="e => OnResourceNumberChanged(current, ResourceFieldChangeFactor2, e)"
                                   @onblur="() => OnResourceNumberBlur(current, ResourceFieldChangeFactor2)"
                                   class="@St" />
                        </td>
                        <td class="px-1 py-0.5">
                            <input type="text"
                                   inputmode="decimal" disabled
                                   value="@GetResourceInputValue(current, ResourceFieldQuantity)"
                                   @oninput="e => OnResourceNumberChanged(current, ResourceFieldQuantity, e)"
                                   @onblur="() => OnResourceNumberBlur(current, ResourceFieldQuantity)"
                                   class="@St" />
                        </td>
                        <td class="px-1 py-0.5">
                            <input type="text"
                                   inputmode="decimal"
                                   value="@GetResourceInputValue(current, ResourceFieldCapWaste)"
                                   @oninput="e => OnResourceNumberChanged(current, ResourceFieldCapWaste, e)"
                                   @onblur="() => OnResourceNumberBlur(current, ResourceFieldCapWaste)"
                                   class="@St" />
                        </td>

                        <td class="px-1 py-0.5">
                            @if (current.HasCap && current.CalcResCost != null)
                            {
                                <TrimmedNumberInput TValue="int"
                                                    @bind-Value="current.CalcResCost.Morgen"
                                                    MaxFractionDigits="@MaxFractionDigits"
                                                    step="1"
                                                    class="@St" />
                            }
                        </td>
                        <td class="px-1 py-0.5">
                            @if (current.HasCap && current.CalcResCost != null)
                            {
                                <TrimmedNumberInput TValue="decimal"
                                                    @bind-Value="current.CalcResCost.MorgenCost"
                                                    MaxFractionDigits="@MaxFractionDigits"
                                                    step="any"
                                                    class="@St" />
                            }
                        </td>
                        <td class="px-1 py-0.5">
                            @if (current.HasCap && current.CalcResCost != null)
                            {
                                <TrimmedNumberInput TValue="int"
                                                    @bind-Value="current.CalcResCost.Day"
                                                    MaxFractionDigits="@MaxFractionDigits"
                                                    step="1"
                                                    class="@St" />
                            }
                        </td>
                        <td class="px-1 py-0.5">
                            @if (current.HasCap && current.CalcResCost != null)
                            {
                                <TrimmedNumberInput TValue="decimal"
                                                    @bind-Value="current.CalcResCost.DayCost"
                                                    MaxFractionDigits="@MaxFractionDigits"
                                                    step="any"
                                                    class="@St" />
                            }
                        </td>
                        <td class="px-1 py-0.5">
                            @if (current.HasCap && current.CalcResCost != null)
                            {
                                <TrimmedNumberInput TValue="int"
                                                    @bind-Value="current.CalcResCost.Evening"
                                                    MaxFractionDigits="@MaxFractionDigits"
                                                    step="1"
                                                    class="@St" />
                            }
                        </td>
                        <td class="px-1 py-0.5">
                            @if (current.HasCap && current.CalcResCost != null)
                            {
                                <TrimmedNumberInput TValue="decimal"
                                                    @bind-Value="current.CalcResCost.EveningCost"
                                                    MaxFractionDigits="@MaxFractionDigits"
                                                    step="any"
                                                    class="@St" />
                            }
                        </td>

                        <!-- Dynamic properties -->
                        @if (_propColumns.Count > 0)
                        {
                            @foreach (var col in _propColumns)
                            {
                                var p = current.Properties?.FirstOrDefault(x => NormalizeName(x.DisplayName) == col.NameKey);
                                <td class="px-1 py-0.5">
                                    @if (p is null)
                                    {
                                        <span class="text-[11px] text-gray-400">—</span>
                                    }
                                    else if (p.DataType == DataType.Number)
                                    {
                                       <input type="text"
                                               inputmode="decimal"
                                               value="@GetPropertyInputValue(current, p)"
                                               @oninput="e => OnPropertyNumberChanged(current, p, e)"
                                               @onblur="() => OnPropertyNumberBlur(current, p)"
                                               max="@p.MaxNumericValue"
                                               class="@St"
                                               disabled="@(!p.IsUserEditable)" />
                                    }
                                    else
                                    {
                                        <input type="text"
                                               value="@GetPropertyInputValue(current, p)"
                                               @oninput="e => OnPropertyTextChanged(current, p, e)"
                                               @onblur="() => OnPropertyBlur(current, p)"
                                               class="@St"
                                               disabled="@(!p.IsUserEditable)" />
                                    }
                                </td>
                            }
                        }

                        <!-- Formulas toggle -->
                        <td class="px-1 py-0.5">
                            @if (hasFormulas)
                            {
                                <button type="button"
                                        class="inline-flex items-center rounded border px-2 py-0.5 text-[11px]
                                                           border-gray-500 text-gray-700 hover:bg-gray-500 hover:text-white
                                                           dark:border-gray-400 dark:text-gray-300 dark:hover:bg-gray-400"
                                        @onclick="() => Toggle(current.Id)">
                                    @((expanded ? "H" : "S")) (@current.Formulas.Count)
                                </button>
                            }
                            else
                            {
                                <span class="text-[11px] text-gray-500 dark:text-gray-400">—</span>
                            }
                        </td>
                    </tr>

                    @if (hasFormulas && expanded)
                    {
                        <tr class="hover:bg-transparent">
                            <td class="px-1 py-1" colspan="@(_staticColspan + _propColumns.Count)">
                                <div class="mt-1 rounded border p-1.5 md:p-2 bg-white/60 dark:bg-gray-900/40 border-gray-200 dark:border-gray-700">
                                    <div class="text-[13px] font-semibold mb-1 text-gray-800 dark:text-gray-100">@StorageLoc["storageFormulas"]</div>
                                    <ul class="list-disc ml-5">
                                        @foreach (var f in current.Formulas)
                                        {
                                            <li class="text-[13px] text-gray-800 dark:text-gray-200">@f</li>
                                        }
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter] public IEnumerable<ResourceDto> Rows { get; set; } = Array.Empty<ResourceDto>();
    [Parameter] public bool AddBtnIsVisible { get; set; }
    [Parameter] public ResourceFormDTO Config { get; set; } = default!;
    [Parameter] public EventCallback<ResourceDto> OnEdit { get; set; }
    [Parameter] public bool NameConfig { get; set; }
    [Parameter] public bool CostConfig { get; set; }
    [Parameter] public decimal TotalCost { get; set; }
    [Parameter] public int MaxFractionDigits { get; set; } = NumericFormatHelper.DefaultMaxFractionDigits;
    [Parameter] public IReadOnlyDictionary<ParamName, decimal>? TaskParameters { get; set; }

    // يُستدعى عند تغيير Dropdown أو أي تغيّر نريد أن نبلّغ به الأب (TaskCard مثلاً)
    [Parameter] public EventCallback OnChanged { get; set; }
    private const string ToggleClass =
            //"inline-flex items-center justify-center rounded-full " +
            "inline-flex h-5 w-5 items-center justify-center rounded-md  " +
    "border border-slate-400 dark:border-slate-600 " +
    "bg-transparent dark:bg-transparent " +
    "w-5 h-5 cursor-pointer transition-all duration-200 ease-out " +
    "hover:opacity-70 hover:scale-110 hover:shadow-sm";
    // ستايل المدخلات العادية
    string St = "w-full border border-gray-300 dark:border-gray-600 rounded px-1 py-0.5 text-[11px] " +
                "bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 " +
                "focus:outline-none focus:ring-1 focus:ring-yellow-400";

    // ستايل القوائم المنسدلة (select)
    string SelectSt = "w-full border border-gray-300 dark:border-gray-600 rounded px-1 py-0.5 text-[11px] " +
                      "bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 " +
                      "focus:outline-none focus:ring-1 focus:ring-blue-500";

    private HashSet<int> _expanded = new();
    private const string ResourceFieldBaseCost = "basecost";
    private const string ResourceFieldCost = "cost";
    private const string ResourceFieldChangeFactor1 = "chf1";
    private const string ResourceFieldChangeFactor2 = "chf2";
    private const string ResourceFieldQuantity = "quantity";
    private const string ResourceFieldCapWaste = "capwaste";
    private readonly Dictionary<string, string> _propertyInputDrafts = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _resourceInputDrafts = new(StringComparer.Ordinal);

    private sealed class PropColumn
    {
        public string NameKey { get; init; } = string.Empty;
        public string DisplayName { get; init; } = string.Empty;
    }

    private sealed class ResourceMenuGroup
    {
        public string Key { get; set; } = string.Empty;
        public int MenuId { get; set; }
        public List<ResourceDto> Resources { get; set; } = new();
        public int SelectedResourceId { get; set; }
    }

    private List<PropColumn> _propColumns = new();
    private List<ResourceMenuGroup> _menuGroups = new();

    private int _staticColspan = 17;

    protected override void OnParametersSet()
    {
        var previousSelections = _menuGroups.ToDictionary(g => g.Key, g => g.SelectedResourceId, StringComparer.Ordinal);

        // أعمدة الخصائص الديناميكية
        _propColumns = Rows?
            .SelectMany(r => r.Properties ?? Enumerable.Empty<ResourcePropertyBindDto>())
            .Where(p => !string.IsNullOrWhiteSpace(p.DisplayName))
            .GroupBy(p => NormalizeName(p.DisplayName))
            .Select(g => new PropColumn
            {
                NameKey = g.Key,
                DisplayName = g.First().DisplayName
            })
            .OrderBy(c => c.DisplayName, StringComparer.CurrentCultureIgnoreCase)
            .ToList()
            ?? [];

        // تجميع الموارد حسب MenuId (فقط التي تحتوي على عنصرين أو أكثر)
        _menuGroups = Rows?
            .Where(r => r?.MenuId.HasValue == true)
            .GroupBy(r => GetMenuGroupKey(r!))
            .Where(g => g.Count() >= 2)
            .Select(g =>
            {
                var resources = g.ToList();
                var sample = resources[0];
                var selectedResourceId = GetSelectedResourceId(resources, g.Key, previousSelections);
                SyncGroupSelection(resources, selectedResourceId);

                return new ResourceMenuGroup
                {
                    Key = g.Key,
                    MenuId = sample.MenuId!.Value,
                    Resources = resources,
                    SelectedResourceId = selectedResourceId
                };
            })
            .ToList()
            ?? [];
    }

    private static string NormalizeName(string name)
        => (name ?? string.Empty).Trim().ToLowerInvariant();

    private static string GetMenuGroupKey(ResourceDto resource)
        => $"{resource.ResourceSource}:{resource.MenuId!.Value}";

    private static int GetSelectedResourceId(
        IReadOnlyList<ResourceDto> resources,
        string menuKey,
        IReadOnlyDictionary<string, int> previousSelections)
    {
        if (previousSelections.TryGetValue(menuKey, out var previousId)
            && resources.Any(r => r.Id == previousId))
        {
            return previousId;
        }

        return resources.FirstOrDefault(r => r.IsAdded)?.Id
            ?? resources.First().Id;
    }

    private static void SyncGroupSelection(IEnumerable<ResourceDto> resources, int selectedResourceId)
    {
        foreach (var resource in resources)
        {
            resource.IsAdded = resource.Id == selectedResourceId;
        }
    }

    private void Toggle(int resourceId)
    {
        if (!_expanded.Add(resourceId))
            _expanded.Remove(resourceId);
    }

    private ResourceMenuGroup? FindGroup(ResourceDto r)
        => r.MenuId.HasValue
            ? _menuGroups.FirstOrDefault(g => g.Key == GetMenuGroupKey(r))
            : null;

    private static string BuildResourceRowKey(ResourceDto resource)
        => $"resource:{resource.ResourceSource}:{resource.MenuId ?? 0}:{resource.Id}";

    private async Task OnMenuChanged(ResourceMenuGroup group, ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var id))
            return;

        group.SelectedResourceId = id;
        SyncGroupSelection(group.Resources, id);

        if (OnChanged.HasDelegate)
            await OnChanged.InvokeAsync();
    }

    private async Task NotifyRowsChanged()
    {
        if (OnChanged.HasDelegate)
            await OnChanged.InvokeAsync();
    }

    private async Task OnResourceNumberChanged(ResourceDto resource, string field, ChangeEventArgs e)
    {
        var rawValue = e.Value?.ToString() ?? string.Empty;
        _resourceInputDrafts[GetResourceInputKey(resource, field)] = rawValue;

        if (!NumericInputHelper.TryParseNullableDecimal(rawValue, out var parsed))
            return;

        if (!TrySetResourceFieldValue(resource, field, parsed))
            return;

        ResourceFormulaApplier.ApplyRow(resource, TaskParameters ?? new Dictionary<ParamName, decimal>());
        await NotifyRowsChanged();
        await InvokeAsync(StateHasChanged);
    }

    private Task OnResourceNumberBlur(ResourceDto resource, string field)
    {
        _resourceInputDrafts.Remove(GetResourceInputKey(resource, field));
        return InvokeAsync(StateHasChanged);
    }

    private async Task OnPropertyNumberChanged(ResourceDto resource, ResourcePropertyBindDto property, ChangeEventArgs e)
    {
        var rawValue = e.Value?.ToString() ?? string.Empty;
        _propertyInputDrafts[GetPropertyInputKey(resource, property)] = rawValue;

        if (!NumericInputHelper.TryParseNullableDecimal(rawValue, out var parsed))
            return;

        property.NumberDefault = parsed;
        ResourceFormulaApplier.ApplyRow(resource, TaskParameters ?? new Dictionary<ParamName, decimal>());
        await NotifyRowsChanged();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnPropertyTextChanged(ResourceDto resource, ResourcePropertyBindDto property, ChangeEventArgs e)
    {
        var rawValue = e.Value?.ToString() ?? string.Empty;
        _propertyInputDrafts[GetPropertyInputKey(resource, property)] = rawValue;
        property.TextDefault = rawValue;

        ResourceFormulaApplier.ApplyRow(resource, TaskParameters ?? new Dictionary<ParamName, decimal>());
        await NotifyRowsChanged();
        await InvokeAsync(StateHasChanged);
    }

    private Task OnPropertyNumberBlur(ResourceDto resource, ResourcePropertyBindDto property)
        => OnPropertyBlur(resource, property);

    private Task OnPropertyBlur(ResourceDto resource, ResourcePropertyBindDto property)
    {
        _propertyInputDrafts.Remove(GetPropertyInputKey(resource, property));
        return InvokeAsync(StateHasChanged);
    }

    private string GetPropertyInputValue(ResourceDto resource, ResourcePropertyBindDto property)
        => _propertyInputDrafts.TryGetValue(GetPropertyInputKey(resource, property), out var draft)
            ? draft
            : property.DataType == DataType.Number
                ? FormatNullableNumber(property.NumberDefault)
                : property.TextDefault ?? string.Empty;

    private string GetResourceInputValue(ResourceDto resource, string field)
        => _resourceInputDrafts.TryGetValue(GetResourceInputKey(resource, field), out var draft)
            ? draft
            : field switch
            {
                ResourceFieldBaseCost => FormatNullableNumber(resource.Data.BaseCost),
                ResourceFieldQuantity => FormatNullableNumber(resource.Data.Quantity),
                ResourceFieldCost => FormatNumber(resource.Data.Cost),
                ResourceFieldChangeFactor1 => FormatNumber(resource.Data.ChangeFactor1),
                ResourceFieldChangeFactor2 => FormatNumber(resource.Data.ChangeFactor2),
                ResourceFieldCapWaste => FormatNumber(resource.Data.CapWaste),
                _ => string.Empty
            };

    private bool TrySetResourceFieldValue(ResourceDto resource, string field, decimal? value)
    {
        switch (field)
        {
            case ResourceFieldBaseCost:
                resource.Data.BaseCost = value;
                return true;
            case ResourceFieldQuantity:
                resource.Data.Quantity = value;
                return true;
            case ResourceFieldCost when value.HasValue:
                resource.Data.Cost = value.Value;
                return true;
            case ResourceFieldChangeFactor1 when value.HasValue:
                resource.Data.ChangeFactor1 = value.Value;
                return true;
            case ResourceFieldChangeFactor2 when value.HasValue:
                resource.Data.ChangeFactor2 = value.Value;
                return true;
            case ResourceFieldCapWaste when value.HasValue:
                resource.Data.CapWaste = value.Value;
                return true;
            default:
                return false;
        }
    }

    private static string GetPropertyInputKey(ResourceDto resource, ResourcePropertyBindDto property)
        => $"{resource.ResourceSource}:{resource.Id}:{resource.MenuId ?? 0}:{property.Id}";

    private static string GetResourceInputKey(ResourceDto resource, string field)
        => $"{resource.ResourceSource}:{resource.Id}:{resource.MenuId ?? 0}:{field}";

    private string FormatNullableNumber(decimal? value)
        => NumericFormatHelper.Format(value, MaxFractionDigits);

    private string FormatNumber(decimal value)
        => NumericFormatHelper.Format(value, MaxFractionDigits);
}
