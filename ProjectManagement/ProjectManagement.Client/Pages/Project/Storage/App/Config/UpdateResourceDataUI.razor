@using ProjectManagement.Client.Shared.Repositories.Calculation
@using ProjectManagement.Shared.DTO.ProjectAppStorage
@using ProjectManagement.Shared.DTO.ResourceType
@inject IStorageRepository IStorageRepository

@if (editContext is null)
{
    <div role="status" class="flex items-center gap-2 p-3">
        <span class="animate-spin rounded-full h-4 w-4 border border-current border-t-transparent"></span>
        <span class="sr-only">Loading…</span>
        <span>Loading…</span>
    </div>
}
else
{
    <EditForm id="resForm"
              class="@CssClasses.Modal.Body"
              EditContext="editContext"
              OnValidSubmit="HandleSubmitAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="@CssClasses.Layout.FlexWrap">
            <div class="@CssClasses.Layout.FlexMinWidth(300)">
                <label class="@CssClasses.Form.Label" for="res-name">@CalcResource.name</label>
                <InputText id="res-name" @bind-Value="ResourceUpdate.Name" class="@CssClasses.Input.Text" />
                <ValidationMessage For="@(() => ResourceUpdate.Name)" />
            </div>

            <div class="@CssClasses.Layout.FlexMinWidth(150)">
                <label class="@CssClasses.Form.Label" for="res-cost">@CalcResource.cost</label>
                <InputNumber id="res-cost" @bind-Value="ResourceUpdate.Cost" class="@CssClasses.Input.Number" />
                <ValidationMessage For="@(() => ResourceUpdate.Cost)" />
            </div>

            <div class="@CssClasses.Layout.FlexMinWidth(150)">
                <label class="@CssClasses.Form.Label" for="res-co2">@CalcResource.co2</label>
                <InputNumber id="res-co2" @bind-Value="ResourceUpdate.Co2" class="@CssClasses.Input.Number" />
                <ValidationMessage For="@(() => ResourceUpdate.Co2)" />
            </div>

            @if (!isRefreshing && Config.AccountGroups is not null)
            {
                <div class="@CssClasses.Layout.FlexWidth(selectWidth)">
                    <label class="@CssClasses.Form.Label" for="res-acct-group">@CalcResource.accountGroups</label>
                    <InputSelect id="res-acct-group" class="@CssClasses.Input.Select" @bind-Value="accountGroupId" @bind-Value:after="OnGroupChanged">
                        <option value="">—</option>
                        @foreach (var group in Config.AccountGroups)
                        {
                            <option value="@group.Id">@group.Name</option>
                        }
                    </InputSelect>
                </div>

                @if (AccountGroupSelected?.Accounts is not null)
                {
                    <div class="@CssClasses.Layout.FlexWidth(selectWidth)">
                        <label class="@CssClasses.Form.Label" for="res-account">@CalcResource.account</label>
                        <InputSelect id="res-account" class="@CssClasses.Input.Select" @bind-Value="ResourceUpdate.AccountId">
                            <option value="">—</option>
                            @foreach (var acc in AccountGroupSelected.Accounts)
                            {
                                <option value="@acc.Id">@($"{acc.Account} ({acc.Name})")</option>
                            }
                        </InputSelect>
                    </div>
                }
            }
        </div>

        <div class="@CssClasses.Layout.FlexWrap">
            @if (Config.ResourceTypes is not null)
            {
                <div class="@CssClasses.Layout.FlexWidth(selectWidth)">
                    <label class="@CssClasses.Form.Label" for="res-type">@CalcResource.resourceType</label>
                    <InputSelect id="res-type" class="@CssClasses.Input.Select" @bind-Value="ResourceUpdate.ResourceTypeId" @bind-Value:after="OnTypeChanged">
                        <option value="">—</option>
                        @foreach (var rt in Config.ResourceTypes)
                        {
                            <option value="@rt.Id">@rt.Name</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => ResourceUpdate.ResourceTypeId)" />
                </div>
            }

            @if (ResTypeSelected?.ResourcesSort is not null && ResTypeSelected.ResourcesSort.Any())
            {
                <div class="@CssClasses.Layout.FlexWidth(selectWidth)">
                    <label class="@CssClasses.Form.Label" for="res-sort">@CalcResource.resourceSort</label>
                    <InputSelect id="res-sort" class="@CssClasses.Input.Select" @bind-Value="ResourceUpdate.ResourceSortId">
                        <option value="">—</option>
                        @foreach (var sort in ResTypeSelected.ResourcesSort)
                        {
                            <option value="@sort.Id">@sort.Name</option>
                        }
                    </InputSelect>
                </div>
            }

            <div class="@CssClasses.Layout.FlexWidth(selectWidth)">
                <label class="@CssClasses.Form.Label" for="res-status">@CalcResource.status</label>
                <InputSelect id="res-status" @bind-Value="ResourceUpdate.StatusId" class="@CssClasses.Input.Select">
                    <option value="">—</option>
                    @if (Config.Statues is not null)
                    {
                        @foreach (var status in Config.Statues)
                        {
                            <option value="@status.Id">@status.Name</option>
                        }
                    }
                </InputSelect>
                <ValidationMessage For="@(() => ResourceUpdate.StatusId)" />
            </div>
        </div>

        <div class="mt-4 flex gap-2 justify-end">
            <button type="submit" class="@CssClasses.Btn.Outline.Primary" disabled="@isSubmitting">save</button>
            <button type="button" class="@CssClasses.Btn.Outline.Secondary" @onclick="ResetForm" disabled="@isSubmitting">reset</button>
        </div>

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="text-red-600 mt-2">@error</div>
        }
    </EditForm>
}

@code {
    [Parameter] public ResourceDto Resource { get; set; } = default!;
    [Parameter] public ResourceTenantLinkBase? ResourceUpdate { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public ResourceFormDTO Config { get; set; } = new();

    private EditContext? editContext;

    // UI state
    private int selectWidth = 160;
    private bool isRefreshing = false;
    private bool isSubmitting = false;
    private string? error;

    // Selections
    private AccountGroupsListDto AccountGroupSelected;
    private int? accountGroupId;
    private ListResourceTypeDTO ResTypeSelected;

    protected override async Task OnParametersSetAsync()
    {
        // Initialize ResourceUpdate from Resource if needed

        if (ResourceUpdate is null)
        {
            ResourceUpdate = new ResourceTenantLinkBase
            {
                Name = string.IsNullOrWhiteSpace(Resource?.NameUserValue) ? Resource?.Name : Resource.NameUserValue,
                Cost = Resource?.CostUserValue ?? Resource?.Data?.Cost,
                Co2 = Resource?.Data?.CO2,
                AccountId = Resource?.AccountId,
                ResourceTypeId = Resource?.ResourceTypeId,
                ResourceSortId = Resource?.ResourceSortId,
                StatusId = Resource?.StatusId,
            };
        }

        // Preselect account group from existing AccountId
        if (Resource?.AccountId is int accId && Config.AccountGroups is not null)
        {
            AccountGroupSelected = Config.AccountGroups.FirstOrDefault(g => g.Accounts?.Any(a => a.Id == accId) == true);
            accountGroupId = AccountGroupSelected?.Id;
        }

        // Preselect resource type details
        if (ResourceUpdate?.ResourceTypeId is int rtId)
        {
            ResTypeSelected = Config.ResourceTypes?.FirstOrDefault(x => x.Id == rtId);
        }

        editContext ??= new EditContext(ResourceUpdate!);
        await Task.CompletedTask;
    }

    private void OnGroupChanged()
    {
        AccountGroupSelected = null;
        ResourceUpdate!.AccountId = null;

        if (accountGroupId.HasValue)
        {
            AccountGroupSelected = Config.AccountGroups?.FirstOrDefault(x => x.Id == accountGroupId.Value);
        }
        else
        {
            accountGroupId = null;
        }
    }

    private void OnTypeChanged()
    {
        ResTypeSelected = null;
        ResourceUpdate!.ResourceSortId = null;

        if (ResourceUpdate.ResourceTypeId.HasValue)
        {
            ResTypeSelected = Config.ResourceTypes?.FirstOrDefault(x => x.Id == ResourceUpdate.ResourceTypeId.Value);
        }
        else
        {
            ResourceUpdate.ResourceTypeId = null;
        }
    }

    private Task OnTypeChanged(ChangeEventArgs args)
    {
        ResTypeSelected = null;
        ResourceUpdate!.ResourceSortId = null;

        if (int.TryParse(Convert.ToString(args?.Value), out var id))
        {
            ResourceUpdate.ResourceTypeId = id;
            ResTypeSelected = Config.ResourceTypes?.FirstOrDefault(x => x.Id == id);
        }
        else
        {
            ResourceUpdate.ResourceTypeId = null;
        }

        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task HandleSubmitAsync()
    {
        if (ResourceUpdate is null) return;

        error = null;
        isSubmitting = true;
        try
        {
            var ok = await IStorageRepository.UpdateResourceAppStorageTenantAsync(Resource.Id, ResourceUpdate);
            if (ok)
            {
                // Sync the displayed resource with edited values
                Resource.NameUserValue = ResourceUpdate.Name;
                Resource.Data.CO2 = ResourceUpdate.Co2;
                Resource.CostUserValue = ResourceUpdate.Cost;

                Resource.AccountId = ResourceUpdate.AccountId;
                Resource.ResourceTypeId = ResourceUpdate.ResourceTypeId;
                Resource.ResourceSortId = ResourceUpdate.ResourceSortId;
                Resource.StatusId = ResourceUpdate.StatusId;

                await OnChanged.InvokeAsync();
            }
            else
            {
                error = "Failed to save changes."; // Localize as needed
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void ResetForm()
    {
        if (Resource is null || ResourceUpdate is null) return;

        ResourceUpdate.Name = Resource.Name;
        ResourceUpdate.AccountId = Resource.AccountId;
        ResourceUpdate.ResourceTypeId = Resource.ResourceTypeId;
        ResourceUpdate.ResourceSortId = Resource.ResourceSortId;
        ResourceUpdate.StatusId = Resource.StatusId;

        // Re-evaluate dependent selections
        accountGroupId = null;
        AccountGroupSelected = null;
        if (Resource.AccountId.HasValue && Config.AccountGroups is not null)
        {
            AccountGroupSelected = Config.AccountGroups.FirstOrDefault(g => g.Accounts?.Any(a => a.Id == Resource.AccountId.Value) == true);
            accountGroupId = AccountGroupSelected?.Id;
        }

        ResTypeSelected = null;
        if (Resource.ResourceTypeId.HasValue)
        {
            ResTypeSelected = Config.ResourceTypes?.FirstOrDefault(x => x.Id == Resource.ResourceTypeId.Value);
        }

        editContext = new EditContext(ResourceUpdate);
    }
}
