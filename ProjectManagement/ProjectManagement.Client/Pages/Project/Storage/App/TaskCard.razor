@using ProjectManagement.Client.Pages.Project.Storage.App.Config
@using ProjectManagement.Client.Shared.Repositories.Calculation
@using ProjectManagement.Shared.DTO.Calculation
@using ProjectManagement.Shared.DTO.ProjectAppStorage
@using ProjectManagement.Shared.DTO.ProjectAppStorage.Service
@using ProjectManagement.Shared.Enums
@using ProjectManagement.Shared.Helper.ProjectAppStorage
@using System.Globalization
@inject ITasksUserComputationServiceWasm Compute
@inject IStorageRepository TaskService
@inherits AppComponentBase
@inject AppState AppState

<div class="w-full min-w-0 mb-2">
    <!-- Controls, task identity, dimensions, and result -->
    <div class="sticky top-0 z-30 flex flex-wrap items-center gap-x-2 gap-y-1 border-b border-slate-200 bg-white/95 py-1 backdrop-blur dark:border-slate-800 dark:bg-slate-950/95">
        <div class="flex items-center gap-0.5 shrink-0">
            <button @onclick="OnClick" class="@ToggleClass">
                @(Task.Added ? "-" : "+")
            </button>
            <button @onclick="CollspanTask"
                    class="shrink-0 text-slate-500 dark:text-slate-400 group-hover:text-slate-600 transition-transform duration-200">
                <svg xmlns="http://www.w3.org/2000/svg"
                     class="@($"w-4 h-4 transform transition-transform duration-200 {(Task.Collspanded ? "rotate-90" : "rotate-0")}")"
                     fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
            </button>
            @if (Task.Uncontrollable)
            {
                <button @onclick="ToggleResources"
                        class="border border-gray-500 text-gray-500 rounded transition hover:bg-gray-500 hover:text-white dark:border-gray-400 dark:text-gray-400 dark:hover:bg-gray-400 dark:hover:text-white px-0.5 py-0 text-sm">
                    @(_showResources ? ResourceApp.hiddenItems : ResourceApp.visibleItems)
                </button>
            }
        </div>

        @if (HeaderContent is not null)
        {
            @HeaderContent
        }
        else if (ShowTaskName)
        {
            @if (!string.IsNullOrEmpty(Task.Code))
            {
                <span class="text-xs text-slate-500 whitespace-nowrap">[@Task.Code]</span>
            }
            <span class="text-sm font-semibold text-slate-800 dark:text-slate-100 truncate max-w-[300px]">
                @Task.DisplayName
            </span>
        }

        <DimensionInputs Task="Task"
                         MaxFractionDigits="MaxFractionDigits"
                         OnChanged="OnAnswersChanged"
                         OnApply="Apply" />

        @if (!string.IsNullOrEmpty(_computeError))
        {
            <div class="inline-flex max-w-full items-center rounded bg-red-100 px-2 py-[3px] text-[11px] text-red-700 dark:bg-red-900/40 dark:text-red-300">
                @_computeError
            </div>
        }

        @if (!string.IsNullOrEmpty(_resultText))
        {
            <div class="inline-flex h-[27px] max-w-full items-center rounded border border-slate-200 bg-slate-50 px-2 text-[12px] text-slate-700 dark:border-slate-700 dark:bg-slate-900/50 dark:text-slate-200"
                title="@_resultFullText">
                <strong class="mr-1 font-semibold">@StorageLoc["storageResult"]:</strong>
                <span class="tabular-nums whitespace-nowrap">@_resultText (@ResultUnit)</span>
            </div>
        }
    </div>

    <!-- State, cost, and status -->
    <div class="flex flex-wrap items-center gap-x-2 gap-y-1 mt-1 pl-[52px]">
        @Row2Content
        @if (Task.TotalCost != 0)
        {
            <span class="text-sm font-semibold text-slate-800 dark:text-slate-100 whitespace-nowrap">
                @FormatNumber(Task.TotalCost)<span class="opacity-70">/ @SelectedInputUnitCode</span>
            </span>
        }
        <div class="w-[175px] shrink-0">
            <select @bind="Task.StatusId" class="w-full h-[25px] border border-gray-300 rounded px-2 text-[13px] leading-tight bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:text-white dark:border-gray-600">
                <option></option>
                @if (Statuses != null)
                    foreach (var status in Statuses)
                    {
                        <option value="@status.Id">@status.Name</option>
                    }
            </select>
        </div>
    </div>

    @if (Task.Collspanded)
    {
        <div class="mt-2 min-w-0">
            <FinalResourcesTable2 Rows="GetVisibleRows()"
                                  MaxFractionDigits="MaxFractionDigits"
                                  AddBtnIsVisible="Task.Added"
                                  Config="Config"
                                  OnEdit="GetResourceTEnant"
                                  OnChanged="OnAnswersChanged"
                                  CostConfig="CostConfig"
                                  NameConfig="NameConfig"
                                  TaskParameters="Task.ParameterValues"
                                  TotalCost="Task.TotalCost" />
        </div>
    }
</div>

@code {
    [Parameter] public ProjectTaskDto Task { get; set; } = default!;
    [Parameter] public ResourceFormDTO Config { get; set; } = default!;
    [Parameter] public List<ListOrderDTO> Statuses { get; set; } = default!;
    [Parameter] public EventCallback ToAdded { get; set; }
    [Parameter] public bool NameConfig { get; set; }
    [Parameter] public bool CostConfig { get; set; }
    [Parameter] public bool CO2Config { get; set; }
    [Parameter] public bool ShowTaskName { get; set; } = true;
    [Parameter] public bool InlineHeader { get; set; }
    [Parameter] public RenderFragment? HeaderContent { get; set; }
    [Parameter] public RenderFragment? Row2Content { get; set; }
    private const string ToggleClass =
            "inline-flex h-5 w-5 items-center justify-center rounded-md  " +
    "border border-slate-400 dark:border-slate-600 " +
    "bg-transparent dark:bg-transparent " +
    "w-5 h-5 cursor-pointer transition-all duration-200 ease-out " +
    "hover:opacity-70 hover:scale-110 hover:shadow-sm";
    private bool _showResources = true;
    private int SummaryId => -Task.Id;
    private int MaxFractionDigits => Math.Clamp(Template?.MathRound ?? NumericFormatHelper.DefaultMaxFractionDigits, 0, 15);
    private string? _computeError;
    private string? _resultText;
    private string? _resultFullText;
    private bool _triedLoadingMissingQuantity;
    private string ResultUnit => Task.UnitCode;
    private string SelectedInputUnitCode => string.IsNullOrWhiteSpace(Task.NewUnitCode)
        ? Task.UnitCode
        : Task.NewUnitCode;
    private void ToggleResources() => _showResources = !_showResources;
    private bool IsSummary(ResourceDto r) => r?.Id == SummaryId;
    private IEnumerable<ResourceDto> GetVisibleRows()
    {
        var all = Task?.Resources ?? Enumerable.Empty<ResourceDto>();
        if (!Task?.Uncontrollable ?? true) return all;
        if (_showResources) return all;
        return all.Where(IsSummary);
    }
    void GetResourceTEnant(ResourceDto res)
    {
        if (res is null || res.Id == SummaryId) return;

        ResourceDto? resource = null;
        if (res.ResourceSource == ResourceSource.Base)
            resource = Task.BaseResources.FirstOrDefault(r => r.Id == res.Id);
        else resource = Task.ResultResources.FirstOrDefault(r => r.Id == res.Id);
        if (resource != null)
        {
            Modal.ShowComponent<UpdateResourceDataUI>("Update",
            new Dictionary<string, object>
            {
                [nameof(UpdateResourceDataUI.Resource)] = resource,
                [nameof(UpdateResourceDataUI.Config)] = Config,
                [nameof(UpdateResourceDataUI.OnChanged)] = EventCallback.Factory.Create(this, Modal.Close)
            });
        }
    }
    async Task OnClick()
    {
        Task.Added = !Task.Added;
        await LoadingTask();
        if (Task.Added)
        {
            Task.Collspanded = true;
            await TrackTaskUsageAsync();
        }

        foreach (var item in Task.Resources ?? Enumerable.Empty<ResourceDto>())
            item.IsAdded = Task.Added;

        var summary = Task.Resources?.FirstOrDefault(IsSummary);
        if (summary is not null)
            summary.IsAdded = Task.Added;

        if (ToAdded.HasDelegate)
            await ToAdded.InvokeAsync();
    }

    private async Task TrackTaskUsageAsync()
    {
        try
        {
            await TaskService.IncrementTaskUsageAsync(Task.Id);
        }
        catch
        {
            // Usage tracking is non-critical for adding the task.
        }
    }
    async Task CollspanTask()
    {
        await LoadingTask();
        Task.Collspanded = !Task.Collspanded;
    }
    async Task LoadingTask()
    {
        if (!Task.IsLoading)
        {
            var task = await TaskService.GetTaskForUserDtoAsync(Task.Id);
            if (task != null)
            {
                Task.Quantity = task.Quantity;
                Task.UnitCode = task.UnitCode;
                Task.NewUnitCode = task.NewUnitCode;
                Task.ChangeFactor1 = task.ChangeFactor1;
                Task.ChangeFactor2 = task.ChangeFactor2;
                Task.PriceProduction = task.PriceProduction;
                Task.WorkloadThresholds = task.WorkloadThresholds ?? [];
                Task.Uncontrollable = task.Uncontrollable;
                Task.CapacityResourceId = task.CapacityResourceId;
                Task.Note = task.Note ?? string.Empty;
                Task.BaseResources = task.BaseResources ?? new List<ResourceDto>();
                Task.ResultResources = task.ResultResources ?? new List<ResourceDto>();
                Task.UpperNote = task.UpperNote ?? [];
                Task.StateLinks = task.StateLinks ?? [];
                ApplyCostAdjustments(Task.BaseResources);
            }
            Task.IsLoading = true;
        }

        RefreshBaseResources();
        Compute.BuildFinalRows(Task);
        EnsureUncontrollableSummary();
        StateHasChanged();
    }
    protected override void OnInitialized()
    {
        RefreshBaseResources();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_triedLoadingMissingQuantity && Task is { Id: > 0, Quantity: null })
        {
            _triedLoadingMissingQuantity = true;
            await LoadingTask();
        }
    }

    private void OnAnswersChanged()
    {
        RefreshBaseResources();
        Compute.BuildFinalRows(Task);
        EnsureUncontrollableSummary();
        StateHasChanged();
    }

    private async Task Apply()
    {
        _computeError = null;
        _resultText = null;
        try
        {
            var inputUnit = SelectedInputUnitCode;
            var taskUnit = Task.UnitCode!;
            var rule = GetActiveConversionRule(inputUnit, taskUnit);

            if (rule?.Params.Any(p => p.Source == ParamSource.Resource) == true && !Task.IsLoading)
                await LoadingTask();

            var parameters = BuildConversionParameters(rule);
            var value = Compute.ComputeOrThrow(
                toUnit: inputUnit,
                fromUnit: taskUnit,
                quantity: Task.Quantity ?? 0,
                parameters: parameters);
            _resultText = value.ToString("N3", CultureInfo.CurrentCulture);
            _resultFullText = value.ToString("G", CultureInfo.CurrentCulture);

            RefreshBaseResources();
            Compute.BuildFinalRows(Task);
            EnsureUncontrollableSummary();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _computeError = ex.Message;
        }
    }

    private static UnitRule? GetActiveConversionRule(string? inputUnit, string? taskUnit)
    {
        var from = UnitRulesCatalog.BuildKey(inputUnit ?? string.Empty);
        var to = UnitRulesCatalog.BuildKey(taskUnit ?? string.Empty);

        if (string.IsNullOrWhiteSpace(from) || string.IsNullOrWhiteSpace(to))
            return null;

        if (string.Equals(from, to, StringComparison.OrdinalIgnoreCase))
            return null;

        return UnitRulesCatalog.TryGet(from, to, out var rule) ? rule : null;
    }

    private IReadOnlyDictionary<ParamName, decimal> BuildConversionParameters(UnitRule? rule)
    {
        if (rule is null || rule.Params.All(p => p.Source == ParamSource.User))
            return Task.ParameterValues;

        var parameters = new Dictionary<ParamName, decimal>(Task.ParameterValues);
        foreach (var param in rule.Params.Where(p => p.Source == ParamSource.Resource))
        {
            if (!parameters.ContainsKey(param.Key) && TryGetResourceParameter(param.Key, out var value))
                parameters[param.Key] = value;
        }

        return parameters;
    }

    private bool TryGetResourceParameter(ParamName key, out decimal value)
    {
        value = default;
        if (key != ParamName.Density)
            return false;

        foreach (var parameter in Task.Resources.SelectMany(r => r.Data.Parameters).Where(p => p.IsActive))
        {
            if (!IsDensityParameter(parameter.Name, parameter.Unit))
                continue;

            value = NormalizeDensityValue(parameter.Value, parameter.Unit);
            return true;
        }

        return false;
    }

    private static bool IsDensityParameter(string? name, string? unit)
    {
        var normalizedName = NormalizeUnitToken(name);
        var normalizedUnit = NormalizeUnitToken(unit);

        return normalizedName.Contains("density", StringComparison.Ordinal)
            || normalizedName.Contains("densitet", StringComparison.Ordinal)
            || normalizedUnit.Contains("t/m3", StringComparison.Ordinal)
            || normalizedUnit.Contains("ton/m3", StringComparison.Ordinal)
            || normalizedUnit.Contains("kg/m3", StringComparison.Ordinal);
    }

    private static decimal NormalizeDensityValue(decimal value, string? unit)
    {
        var normalizedUnit = NormalizeUnitToken(unit);
        return normalizedUnit.Contains("kg/m3", StringComparison.Ordinal)
            ? value / 1000m
            : value;
    }

    private static string NormalizeUnitToken(string? value)
        => (value ?? string.Empty)
            .Trim()
            .ToLowerInvariant()
            .Replace(" ", string.Empty)
            .Replace("^", string.Empty)
            .Replace("\u00b3", "3");

    public void RefreshBaseResources()
        => Compute.RefreshResources(Task.BaseResources, Task.Quantity, Task.ParameterValues);

    public void ApplyCostAdjustments(IEnumerable<ResourceDto> resources)
    {
        if (!CostConfig) return;
        foreach (var res in resources)
            if (res.CostUserValue.HasValue)
                res.Data.Cost = res.CostUserValue.Value;
    }

    public void EnsureUncontrollableSummary()
    {
        if (Task is null || !Task.Uncontrollable)
        {
            if (Task is not null)
            {
                Task.BaseResources = (Task.BaseResources ?? new List<ResourceDto>())
                                 .Where(r => !IsSummary(r)).ToList();
            }
            return;
        }

        Task.BaseResources ??= [];
        var others = (Task.Resources ?? new List<ResourceDto>()).Where(r => r is not null && !IsSummary(r)).ToList();

        var totalBaseCost = others.Sum(r => r?.Data?.BaseCost ?? 0);
        var totalCost = others.Sum(r => r?.Data.Cost ?? 0);
        var co2 = others.Sum(r => r?.Data.CO2 ?? 0);
        var totalStorageCost = others.Sum(r => r?.CostStorageValue ?? 0);
        var totalUserCost = others.Sum(r => r?.CostUserValue ?? r?.CostStorageValue ?? 0);

        var summary = Task.BaseResources.FirstOrDefault(IsSummary);
        if (summary is null)
        {
            summary = new ResourceDto
            {
                Id = SummaryId,
                Active = true,
                IsAdded = Task.Added,
                Name = Task.DisplayName,
                ResourceSource = ResourceSource.Base,
                CostStorageValue = totalStorageCost,
                CostUserValue = totalUserCost,
                Quantity = Task.Quantity ?? 0,
                Unit = Task.UnitCode ?? string.Empty,
                Data = new ProjectManagement.Shared.Base.Calculation.ResourceMetadata
                {
                    BaseCost = totalBaseCost,
                    Cost = totalCost,
                    CO2 = co2,
                    ChangeFactor1 = Task.ChangeFactor1,
                    ChangeFactor2 = Task.ChangeFactor2,
                    Note = Task.Note
                }
            };
            Task.BaseResources.Insert(0, summary);
        }
    }
    public string FormatNumber(decimal value)
        => NumericFormatHelper.Format(value, MaxFractionDigits);

}
