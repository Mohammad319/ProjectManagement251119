@using ProjectManagement.Client.Pages.Project.Storage.App.Config
@using ProjectManagement.Client.Shared.Repositories.Calculation
@using ProjectManagement.Client.Shared.Services.TfIdf
@using ProjectManagement.Shared.Base.Calculation
@using ProjectManagement.Shared.DTO.Calculation
@using ProjectManagement.Shared.DTO.ProjectAppStorage
@using ProjectManagement.Shared.DTO.ProjectAppStorage.Service
@using ProjectManagement.Shared.Enums
@inject IStorageRepository TaskService
@inject ITasksUserComputationServiceWasm Compute
@inherits AppComponentBase
@inject AppState AppState
@inject TfIdfClientService TfIdfService

@using ProjectManagement.Shared.Helper.ProjectAppStorage
@using ProjectManagement.Shared.Helper.Text
@using Microsoft.JSInterop
@using System.Text.Json
@using System.Net
@inject IJSRuntime JS
@implements IAsyncDisposable
<div class="sticky top-0 z-10 flex items-center gap-1.5 bg-white dark:bg-slate-900">
    @Content
    @if (_tasks != null && _tasks.Any(x => x.Added))
    {
        <button class="px-2 py-0.5 border border-green-600 text-green-600 rounded transition hover:bg-green-600 hover:text-white dark:border-green-400 dark:text-green-400 dark:hover:bg-green-400 dark:hover:text-white text-sm" @onclick="SaveAsync">
            @ResourceApp.save
        </button>
    }

    <div class="w-[320px] shrink-0">
        <input type="text"
               class="@($"{InputClass} w-full")"
               value="@_rawSearchQuery"
               @oninput="OnSearchInput"
               placeholder="@ResourceLoc.EnterPartOfCodeOrName" />
    </div>

    <div>
        <button class="inline-flex items-center justify-center w-7 h-7 rounded-full border text-[11px] transition-all duration-150 hover:scale-105 active:scale-95 border-blue-300 text-blue-600 hover:bg-blue-100 hover:ring-1 hover:ring-blue-300 dark:border-blue-400 dark:text-blue-300 dark:hover:bg-blue-900/40 dark:hover:ring-blue-500  px-0.5 py-0 text-sm"
                @onclick="Refresh">
            @((MarkupString)Icons.Refresh)
        </button>
        <button class="inline-flex items-center justify-center w-7 h-7 rounded-full border text-[11px] transition-all duration-150 hover:scale-105 active:scale-95 border-blue-300 text-blue-600 hover:bg-blue-100 hover:ring-1 hover:ring-blue-300 dark:border-blue-400 dark:text-blue-300 dark:hover:bg-blue-900/40 dark:hover:ring-blue-500 px-0.5 py-0 text-sm"
                @onclick="StorageStateModal">
            @((MarkupString)Icons.Machines)
        </button>
    </div>
</div>

@if (_error is not null)
{
    <div class="mt-3 flex items-center gap-2 rounded border border-red-300 bg-red-50 px-3 py-2 text-sm text-red-700 dark:border-red-700 dark:bg-red-900/20 dark:text-red-400">
        <span>! @_error</span>
        <button class="ml-auto underline hover:no-underline" @onclick="Refresh">Retry</button>
    </div>
}

@if (_loading)
{
    <div class="pt-3">
        <BlazorMHD.UI.Components.Feedback.Loading.MhdLoading />
    </div>
}
else if (_tasks != null)
{
    var results = GetScoredGroups().ToList();
    if (results.Count == 0)
    {
        <div class="mt-3 rounded border border-dashed border-gray-300 px-3 py-6 text-center text-sm text-gray-500 dark:border-gray-700 dark:text-gray-400">
            No storage tasks matched "@_rawSearchQuery".
            @if (!string.IsNullOrWhiteSpace(_rawSearchQuery))
            {
                <button class="ml-2 text-blue-600 underline hover:no-underline dark:text-blue-400" @onclick="ClearSearchAsync">Clear search</button>
            }
        </div>
    }
    foreach (var result in results)
    {
        var group = result.Group;
        var score = result.Score;
        var stateGroups = group.StateGroupNames;
        var selectedStates = _selectedStates[group.Key];
        var matched = MatchTask(group, selectedStates);

        <div class="mb-2" @key="group.Key">
            @if (!string.IsNullOrWhiteSpace(_rawSearchQuery) && score < 1.0)
            {
                <div class="flex items-center gap-1 mb-0.5">
                    <div class="h-1 w-16 overflow-hidden rounded-full bg-gray-200 dark:bg-gray-700">
                        <div class="h-full rounded-full @FuzzySearchHelper.BarColorClass(score)" style="width:@((score * 100).ToString("0", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                    </div>
                    <span class="text-[10px] @FuzzySearchHelper.TextColorClass(score)">@score.ToString("0%", System.Globalization.CultureInfo.InvariantCulture)</span>
                </div>
            }
            @{
                var displayTask = matched ?? group.Tasks.FirstOrDefault(HasResources);
            }
            @if (displayTask is not null)
            {
                <TaskCard @key="displayTask.Id" Task="displayTask" ToAdded="TaskToAdd" Config="Config"
                          Statuses="Statuses" CO2Config="AppState.StorageApp.CO2"
                          CostConfig="AppState.StorageApp.Cost" NameConfig="AppState.StorageApp.Name"
                          ShowTaskName="@(stateGroups.Count == 0)">
                    <HeaderContent>
                        @RenderTaskHeader(result)
                    </HeaderContent>
                    <Row2Content>
                        @if (stateGroups.Count > 0)
                        {
                            @foreach (var sg in stateGroups)
                            {
                                var groupId = sg.Key;
                                var groupName = sg.Value;
                                var stateOptions = group.StateOptions.GetValueOrDefault(groupId, []);
                                <div class="flex items-center gap-1 shrink-0">
                                    <span class="text-xs text-slate-500 whitespace-nowrap">@groupName:</span>
                                    <select class="h-[25px] border border-gray-300 rounded px-2 text-[13px] leading-tight bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:text-white dark:border-gray-600"
                                            value="@(selectedStates.TryGetValue(groupId, out var sv) ? sv.ToString() : string.Empty)"
                                            @onchange="e => OnStateChanged(group.Key, groupId, e)">
                                        <option value="">--</option>
                                        @foreach (var opt in stateOptions)
                                        {
                                            <option value="@opt.StateId">@opt.StateName</option>
                                        }
                                    </select>
                                </div>
                            }
                        }
                    </Row2Content>
                </TaskCard>
            }
        </div>
    }

    @if (_loadingMore)
    {
        <div class="flex justify-center pt-3 pb-2">
            <BlazorMHD.UI.Components.Feedback.Loading.MhdLoading />
        </div>
    }
    else if (_hasMore && results.Count > 0)
    {
        <div id="@SentinelId" class="h-4 w-full"></div>
    }
}

@code {
    private const int PageSize = 25;
    private const string InputClass = "border border-gray-300 rounded px-2 py-1 text-[13px] leading-tight h-[25px] bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white";

    private string SentinelId => $"scroll-sentinel-{Calc.Id}";
    private DotNetObjectReference<TaskList>? _selfRef;
    private bool _observerAttached = false;

    // Fuzzy search via FuzzySearchHelper and SwedishTaskTextNormalizer.

    private string _rawSearchQuery = string.Empty;
    private CancellationTokenSource? _searchCts;
    private string _lastInputQuery = "\0";
    private string _lastServerSearchKey = "\0";
    private const bool ResourcesOnly = true;
    private int _requestVersion;
    private string UiStateStorageKey => $"storage-task-list-ui:{Calc.Id}";

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        var next = e.Value?.ToString() ?? string.Empty;
        if (string.Equals(_lastInputQuery, next, StringComparison.Ordinal))
            return;

        _lastInputQuery = next;
        _rawSearchQuery = next;
        BuildServerFilter(_rawSearchQuery);
        _scoredCache = null;
        StateHasChanged();
        await SaveUiStateAsync();

        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;
        try
        {
            await Task.Delay(450, token);
            if (!token.IsCancellationRequested && ShouldRefreshServerForSearch(_rawSearchQuery))
                await Refresh();
        }
        catch (TaskCanceledException) { }
    }

    private List<SearchResult>? _scoredCache;
    private string _lastScoredQuery = "\0";

    private IEnumerable<SearchResult> GetScoredGroups()
    {
        if (_scoredCache is not null
            && _lastScoredQuery == _rawSearchQuery)
            return _scoredCache;

        _lastScoredQuery = _rawSearchQuery;
        _scoredCache = ComputeScoredGroups().ToList();
        return _scoredCache;
    }

    private IEnumerable<SearchResult> ComputeScoredGroups()
    {
        var q = _rawSearchQuery.Trim();
        var groups = _taskGroups
            .Where(g => g.Tasks.Any(HasResources))
            .Select(g => BuildSearchResult(g, q))
            .Where(r => PassesUiFilters(r.Group));
        if (string.IsNullOrWhiteSpace(q))
            return groups
                .Select(r => r with { Score = Math.Min(1.0, r.Score + GetStateSelectionBoost(r.Group)) })
                .OrderByDescending(r => r.Score)
                .ThenBy(r => r.Group.DisplayName);

        var tokens = filterDto.SearchTokens;

        return groups
            .Select(r => r with { Score = Math.Min(1.0, r.Score + TaskListSearchHelper.GetTokenBonus(r.Group.NormalizedCombinedText, tokens) + GetStateSelectionBoost(r.Group)) })
            .Where(x => x.Score >= FuzzySearchHelper.Threshold)
            .OrderByDescending(x => x.Score);
    }

    private SearchResult BuildSearchResult(TaskGroup group, string query)
    {
        var result = TaskListSearchHelper.BuildResult(group.ToSearchInput(group.Tasks.Any(HasResources)), query);
        return new SearchResult(group, result.Score, result.Badges, result.MatchHint);
    }

    private double GetStateSelectionBoost(TaskGroup group)
    {
        if (!_selectedStates.TryGetValue(group.Key, out var selected) || selected.Count == 0)
            return 0;

        return MatchTask(group, selected) is not null ? 0.04 : 0;
    }

    private bool PassesUiFilters(TaskGroup group)
    {
        return true;
    }

    // Fills filterDto.SearchTokens with the top-2 most distinctive Swedish tokens.
    // Uses TF-IDF weights when available; falls back to digit/length heuristic.
    // For very short inputs (<= 3 chars) or when normalization removes everything,
    // falls back to raw NameOrCode so the server still does a prefix-style search.
    private void BuildServerFilter(string rawQuery)
    {
        filterDto.SearchTokens = [];
        filterDto.NameOrCode = string.Empty;

        if (string.IsNullOrWhiteSpace(rawQuery)) return;

        var trimmed = rawQuery.Trim();

        // Short prefix queries (e.g. "VA", "sch") bypass normalization.
        if (trimmed.Length <= 3)
        {
            filterDto.NameOrCode = trimmed;
            return;
        }

        var normalized = SwedishTaskTextNormalizer.Normalize(trimmed);
        var source = string.IsNullOrWhiteSpace(normalized) ? trimmed : normalized;

        // Exclude bigrams (contain '_'); they are generated by Normalize() for NormalizedTextSv
        // phrase-level matching and must NOT be used as server search tokens (they never appear
        // in task Name or Code, so the server would return 0 results if they were ranked first).
        var tokens = source.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                           .Where(t => !t.Contains('_'))
                           .ToArray();

        // If normalization discarded everything (all stop words), search raw
        if (tokens.Length == 0)
        {
            filterDto.NameOrCode = trimmed;
            return;
        }

        var index = TfIdfService.Index;
        var ranked = index.IsEmpty
            ? tokens.OrderByDescending(t => t.Any(char.IsDigit) ? 1000 + t.Length : t.Length)
            : tokens.OrderByDescending(t => index.GetWeight(t)).ThenByDescending(t => t.Length);

        var top2 = ranked.Take(2).ToList();

        // Add both bigram orders for phrase-level matching on the server.
        // Stored in NormalizedTextSv as "t0_t1" and "t1_t0".
        if (top2.Count == 2)
        {
            var t0 = top2[0];
            var t1 = top2[1];
            top2.Add($"{t0}_{t1}");
            top2.Add($"{t1}_{t0}");
        }

        filterDto.SearchTokens = top2;
    }

    private bool ShouldRefreshServerForSearch(string rawQuery)
    {
        var trimmed = rawQuery.Trim();
        if (trimmed.Length == 1)
            return false;

        var key = $"{trimmed}|{string.Join(',', filterDto.SearchTokens)}|{filterDto.NameOrCode}|{ResourcesOnly}";
        if (string.Equals(key, _lastServerSearchKey, StringComparison.Ordinal))
            return false;

        _lastServerSearchKey = key;
        return true;
    }

    private async Task ClearSearchAsync()
    {
        _rawSearchQuery = string.Empty;
        _lastInputQuery = string.Empty;
        BuildServerFilter(_rawSearchQuery);
        _scoredCache = null;
        await SaveUiStateAsync();
        await Refresh();
    }

    private RenderFragment RenderTaskHeader(SearchResult result) => @<text>
        @if (!string.IsNullOrEmpty(result.Group.Code))
        {
            <span class="text-xs text-slate-500 whitespace-nowrap">[@HighlightText(result.Group.Code)]</span>
        }
        <span class="text-sm font-semibold text-slate-800 dark:text-slate-100 truncate max-w-[300px]">@HighlightText(result.Group.DisplayName)</span>
        @foreach (var badge in result.Badges.Take(4))
        {
            <span class="@GetSearchBadgeClass(badge)">@badge.Label</span>
        }
        @if (!string.IsNullOrWhiteSpace(result.MatchHint))
        {
            <span class="max-w-[260px] truncate rounded bg-yellow-50 px-1.5 py-0.5 text-[10px] font-semibold text-yellow-800 ring-1 ring-yellow-200 dark:bg-yellow-950/40 dark:text-yellow-200 dark:ring-yellow-800"
                  title="@result.MatchHint">@HighlightText(result.MatchHint)</span>
        }
    </text>;

    private static string GetSearchBadgeClass(TaskListSearchBadge badge)
    {
        const string baseClass = "shrink-0 rounded px-1.5 py-0.5 text-[10px] font-semibold ring-1";
        return badge.Kind switch
        {
            "code" => $"{baseClass} bg-indigo-50 text-indigo-700 ring-indigo-200 dark:bg-indigo-950/40 dark:text-indigo-300 dark:ring-indigo-800",
            "name" => $"{baseClass} bg-blue-50 text-blue-700 ring-blue-200 dark:bg-blue-950/40 dark:text-blue-300 dark:ring-blue-800",
            "resource" => $"{baseClass} bg-emerald-50 text-emerald-700 ring-emerald-200 dark:bg-emerald-950/40 dark:text-emerald-300 dark:ring-emerald-800",
            "state" => $"{baseClass} bg-amber-50 text-amber-700 ring-amber-200 dark:bg-amber-950/40 dark:text-amber-300 dark:ring-amber-800",
            _ => $"{baseClass} bg-gray-50 text-gray-600 ring-gray-200 dark:bg-gray-800 dark:text-gray-300 dark:ring-gray-700"
        };
    }

    private MarkupString HighlightText(string text)
    {
        if (string.IsNullOrWhiteSpace(_rawSearchQuery) || string.IsNullOrWhiteSpace(text))
            return new MarkupString(WebUtility.HtmlEncode(text));

        var query = _rawSearchQuery.Trim();
        var index = text.IndexOf(query, StringComparison.OrdinalIgnoreCase);
        if (index < 0)
            return new MarkupString(WebUtility.HtmlEncode(text));

        var before = WebUtility.HtmlEncode(text[..index]);
        var match = WebUtility.HtmlEncode(text.Substring(index, query.Length));
        var after = WebUtility.HtmlEncode(text[(index + query.Length)..]);
        return new MarkupString($"{before}<mark class=\"rounded bg-yellow-200 px-0.5 text-yellow-950 dark:bg-yellow-500/30 dark:text-yellow-100\">{match}</mark>{after}");
    }

    private static string BuildResourceSearchText(ProjectTaskDto task)
        => string.Join(' ', new[]
        {
            task.ResourceSearchText,
            string.Join(" | ", task.Resources.Select(r => $"{r.Name} {r.NameUserValue} {r.Unit}"))
        }.Where(x => !string.IsNullOrWhiteSpace(x)));

    private sealed record SearchResult(TaskGroup Group, double Score, List<TaskListSearchBadge> Badges, string? MatchHint);
    private sealed class StorageTaskListUiState
    {
        public string SearchQuery { get; set; } = string.Empty;
        public Dictionary<string, Dictionary<int, int>> SelectedStates { get; set; } = [];
    }

    private async Task LoadUiStateAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", UiStateStorageKey);
            if (string.IsNullOrWhiteSpace(json))
                return;

            var state = JsonSerializer.Deserialize<StorageTaskListUiState>(json);
            if (state is null)
                return;

            _rawSearchQuery = state.SearchQuery ?? string.Empty;
            _lastInputQuery = _rawSearchQuery;
            _restoredSelectedStates = state.SelectedStates ?? [];
            filterDto.ResourcesOnly = ResourcesOnly;
            BuildServerFilter(_rawSearchQuery);
        }
        catch { }
    }

    private async Task SaveUiStateAsync()
    {
        try
        {
            var state = new StorageTaskListUiState
            {
                SearchQuery = _rawSearchQuery,
                SelectedStates = _selectedStates
            };
            await JS.InvokeVoidAsync("localStorage.setItem", UiStateStorageKey, JsonSerializer.Serialize(state));
        }
        catch { }
    }

    private sealed class TaskGroup
    {
        public string Key { get; init; } = string.Empty;
        public string DisplayName { get; init; } = string.Empty;
        public string Code { get; init; } = string.Empty;
        public string SearchText { get; private set; } = string.Empty;
        // Pre-built search string reused across every search to avoid per-search interpolation.
        public string CombinedText { get; private set; } = string.Empty;
        public string NormalizedCombinedText { get; private set; } = string.Empty;
        public string ResourceSearchText { get; private set; } = string.Empty;
        public string NormalizedResourceText { get; private set; } = string.Empty;
        public List<ProjectTaskDto> Tasks { get; } = [];
        public Dictionary<int, string> StateGroupNames { get; } = [];
        // groupId to sorted (StateId, StateName), updated via RebuildStateOptions().
        public Dictionary<int, List<(int StateId, string StateName)>> StateOptions { get; } = [];

        private readonly HashSet<string> _searchParts = [];
        private readonly HashSet<string> _resourceSearchParts = [];

        public void AddTask(ProjectTaskDto task)
        {
            Tasks.Add(task);
            foreach (var sl in task.StateLinks)
                StateGroupNames.TryAdd(sl.GroupId, sl.GroupName);
            if (!string.IsNullOrWhiteSpace(task.SearchText) && _searchParts.Add(task.SearchText))
                SearchText = SearchText.Length == 0 ? task.SearchText : SearchText + " " + task.SearchText;
            var resourceText = BuildResourceSearchText(task);
            if (!string.IsNullOrWhiteSpace(resourceText) && _searchParts.Add(resourceText))
                SearchText = SearchText.Length == 0 ? resourceText : SearchText + " " + resourceText;
            CombinedText = $"{Code} {DisplayName} {SearchText}";
            NormalizedCombinedText = SwedishTaskTextNormalizer.Normalize(CombinedText);
            if (!string.IsNullOrWhiteSpace(resourceText) && _resourceSearchParts.Add(resourceText))
            {
                ResourceSearchText = string.Join(" | ", _resourceSearchParts);
                NormalizedResourceText = SwedishTaskTextNormalizer.Normalize(ResourceSearchText);
            }
        }

        public TaskListSearchInput ToSearchInput(bool hasResources)
            => new(
                DisplayName,
                Code,
                CombinedText,
                NormalizedCombinedText,
                ResourceSearchText,
                NormalizedResourceText,
                StateGroupNames.Count > 0,
                hasResources);

        public void RebuildStateOptions()
        {
            StateOptions.Clear();
            // Single pass over all StateLinks.
            foreach (var g in Tasks.SelectMany(t => t.StateLinks).GroupBy(sl => sl.GroupId))
            {
                StateOptions[g.Key] = g
                    .Select(sl => (sl.StateId, sl.StateName))
                    .DistinctBy(x => x.StateId)
                    .OrderBy(x => x.StateName)
                    .ToList();
            }
        }
    }

    void StorageStateModal()
    {
        Modal.ShowComponent<StorageDataSourceConfigUI>(ResourceLoc.Description_SystemOrUserValues,
        new Dictionary<string, object>
        {
            [nameof(UpdateResourceDataUI.OnChanged)] = EventCallback.Factory.Create<bool>(this, Refresh1)
        });
    }

    void Refresh1(bool refr)
    {
        if (refr)
        {
            InvokeAsync(StateHasChanged);
            foreach (var item in _tasks)
            {
                foreach (var res in item.Resources)
                {
                    if (AppState.StorageApp.Cost && res.CostUserValue.HasValue)
                        res.Data.Cost = (decimal)res.CostUserValue.Value;
                    else if (res.CostStorageValue.HasValue)
                        res.Data.Cost = (decimal)res.CostStorageValue.Value;
                }
            }
        }
        Modal.Close();
    }

    private bool _loading = true;
    private bool _loadingMore = false;
    private bool _hasMore = false;
    private string? _error;
    private List<ProjectTaskDto> _tasks = new();
    private List<TaskGroup> _taskGroups = [];
    private Dictionary<string, TaskGroup> _taskGroupDict = [];
    // groupKey to selected state ids by stateGroupId.
    private Dictionary<string, Dictionary<int, int>> _selectedStates = [];
    private Dictionary<string, Dictionary<int, int>> _restoredSelectedStates = [];
    ProjectTaskFilterDto filterDto = new() { ResourcesOnly = ResourcesOnly };
    [Parameter] public EventCallback RefreshBack { get; set; }
    [Parameter] public RenderFragment? Content { get; set; }
    ResourceFormDTO Config = new();
    List<ListOrderDTO>? Statuses;

    async Task TaskToAdd()
    {
        await RefreshBack.InvokeAsync();
    }

    void OnStateChanged(string groupKey, int stateGroupId, ChangeEventArgs e)
    {
        if (!_selectedStates.TryGetValue(groupKey, out var dict))
            return;
        if (int.TryParse(e.Value?.ToString(), out var stateId) && stateId > 0)
            dict[stateGroupId] = stateId;
        else
            dict.Remove(stateGroupId);
        _scoredCache = null;
        _ = SaveUiStateAsync();
        StateHasChanged();
    }

    ProjectTaskDto? MatchTask(TaskGroup group, Dictionary<int, int> selected)
    {
        if (selected.Count == 0)
            return null;

        foreach (var task in group.Tasks)
        {
            if (!HasResources(task))
                continue;

            bool allMatch = true;
            foreach (var (groupId, stateId) in selected)
            {
                if (!task.StateLinks.Any(sl => sl.GroupId == groupId && sl.StateId == stateId))
                {
                    allMatch = false;
                    break;
                }
            }
            if (allMatch) return task;
        }
        return null;
    }

    void AppendToTaskGroups(List<ProjectTaskDto> newTasks)
    {
        var updatedKeys = new HashSet<string>();
        foreach (var task in newTasks)
        {
            if (!HasResources(task))
                continue;

            var key = $"{(task.Code ?? string.Empty).Trim()}||{task.DisplayName.Trim()}";
            if (!_taskGroupDict.TryGetValue(key, out var group))
            {
                group = new TaskGroup { Key = key, DisplayName = task.DisplayName.Trim(), Code = (task.Code ?? string.Empty).Trim() };
                _taskGroupDict[key] = group;
                _taskGroups.Add(group);
                _selectedStates.TryAdd(key, _restoredSelectedStates.TryGetValue(key, out var restored)
                    ? new Dictionary<int, int>(restored)
                    : []);
            }
            group.AddTask(task);
            updatedKeys.Add(key);
        }
        foreach (var key in updatedKeys)
            _taskGroupDict[key].RebuildStateOptions();
        _scoredCache = null;
    }

    private static bool HasResources(ProjectTaskDto task)
        => task.HasResources || task.BaseResources.Count > 0 || task.ResultResources.Count > 0;

    async Task Refresh()
    {
        var requestVersion = ++_requestVersion;
        _error = null;
        _loading = true;
        filterDto.ResourcesOnly = ResourcesOnly;
        try
        {
            _tasks = [];
            _selectedStates = [];
            _taskGroups = [];
            _taskGroupDict = [];
            List<ProjectTaskDto> batch;
            do
            {
                filterDto.Skip = _tasks.Count;
                filterDto.Take = PageSize;
                batch = await TaskService.GetTasksForUserDtoAsync(filterDto);
                if (requestVersion != _requestVersion)
                    return;

                ApplyCostAdjustments(batch);
                _tasks.AddRange(batch);
                AppendToTaskGroups(batch);
            }
            while (_taskGroups.Count < PageSize && batch.Count == PageSize);

            _hasMore = batch.Count == PageSize;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _tasks = [];
            _taskGroups = [];
            _taskGroupDict = [];
            _hasMore = false;
        }
        finally
        {
            if (requestVersion == _requestVersion)
                _loading = false;
        }
    }

    async Task LoadMoreAsync()
    {
        var requestVersion = ++_requestVersion;
        _error = null;
        _loadingMore = true;
        try
        {
            var groupsBefore = _taskGroups.Count;
            List<ProjectTaskDto> batch;
            do
            {
                filterDto.Skip = _tasks.Count;
                filterDto.Take = PageSize;
                batch = await TaskService.GetTasksForUserDtoAsync(filterDto);
                if (requestVersion != _requestVersion)
                    return;

                ApplyCostAdjustments(batch);
                _tasks.AddRange(batch);
                AppendToTaskGroups(batch);
            }
            while (_taskGroups.Count < groupsBefore + PageSize && batch.Count == PageSize);

            _hasMore = batch.Count == PageSize;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            if (requestVersion == _requestVersion)
                _loadingMore = false;
        }
    }

    void ApplyCostAdjustments(List<ProjectTaskDto> tasks)
    {
        if (!AppState.StorageApp.Cost) return;
        foreach (var item in tasks)
            foreach (var res in item.Resources)
                if (res.CostUserValue.HasValue)
                    res.Data.Cost = (decimal)res.CostUserValue.Value;
    }

    public async Task<bool> SaveAsync()
    {
        var Tasks = _tasks.Where(x => x.Added).Select(Task =>
        {
            var hasConversionParameters = Task.ParameterValues.Count > 0;
            var baseQuantity = Task.Quantity;
            var conversionFactor = ResolveTaskConversionFactor(Task);
            var quantity = hasConversionParameters && baseQuantity.HasValue
                ? Math.Round(baseQuantity.Value * Task.ChangeFactor1 * conversionFactor, 3, MidpointRounding.AwayFromZero)
                : baseQuantity;
            var unit = Task.UnitCode ?? string.Empty;
            var baseUnit = !string.IsNullOrWhiteSpace(Task.NewUnitCode)
                ? Task.NewUnitCode
                : Task.UnitCode;

            return new TaskPostDTO
            {
                Id = Task.Id,
                Name = Task.DisplayName,
                Order = Task.SortOrder,
                StatusId = Task.StatusId,
                Quantity = quantity,
                Unit = unit,

                Metadata = new ProjectManagement.Shared.Base.Calculation.TaskMetadata
                {
                    QuantityParam = ConstValues.FixedQ,
                    BaseQuantity = hasConversionParameters ? baseQuantity : null,
                    ChangeFactor1 = Task.ChangeFactor1,
                    ChangeFactor2 = conversionFactor,
                    IsActive = Task.IsActive,
                    Type = ProjectManagement.Shared.Base.Calculation.TaskType.Task,
                    Code = Task.Code,
                    UpperNote = Task.UpperNote,
                    BaseUnit = hasConversionParameters ? baseUnit ?? string.Empty : string.Empty,
                    Note = Task.Note,
                    IsOH = Calc.OHFactors,
                    ConversionParameters = Task.ParameterValues
                        .Select(kv => new ProjectManagement.Shared.Base.Calculation.TaskConversionParameter
                        {
                            Name = kv.Key.ToString(),
                            Value = kv.Value,
                            Unit = ResolveTaskParameterUnit(kv.Key, Task.UnitCode)
                        }).ToList(),
                },
                Resources = Task.BaseResources.Concat(Task.ResultResources).Where(r => r.IsAdded).Select(res => new ResourcePostDTO
                {
                    Id = res.Id,
                    ResourceTypeId = res.ResourceTypeId,
                    ResourceSortId = res.ResourceSortId,
                    AccountId = res.AccountId,
                    IsActive = res.Active,
                    StatusId = res.StatusId,
                    Quantity = res.Quantity ?? 0m,
                    Unit = res.Unit,
                    Data = new ResourceMetadata()
                    {
                        Note = res.Data.Note,
                        ChangeFactor1 = res.Data.ChangeFactor1,
                        ChangeFactor2 = res.Data.ChangeFactor2,
                        CapWaste = res.Data.CapWaste,
                        CO2 = res.Data.CO2,
                        Cost = res.Data.Cost,
                        BaseCost = res.Data.BaseCost,
                        Parameters = res.Data.Parameters,
                        AddOns = res.Data.AddOns,
                        Times = res.Data.Times,
                    },
                    ResType = res.ResType,
                    Name = AppState.StorageApp.Name ? res.NameUserValue : res.Name,
                }).ToList()
            };
        }).ToList();
        foreach (var ts in Tasks)
        {
            ts.Id = 0;
            ts.Metadata.IsOH = Calc.OHFactors;
            ts.ParentTaskId = null;
            if (ts.StatusId == 0) ts.StatusId = null;
        }

        var createdTasks = await Repo.Task.CreateAsync(Tasks, Calc.Id);
        if (createdTasks.Count == 0)
            return false;

        await CalcService.AddCreatedTasksOrRefreshAsync(createdTasks);

        foreach (var ts in _tasks)
        {
            ts.Added = false;
            foreach (var res in ts.Resources)
                res.IsAdded = false;
        }
        return true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var shouldObserve = _hasMore && !_loading && !_loadingMore;
        if (shouldObserve && !_observerAttached)
        {
            _selfRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("observeIntersection", _selfRef, SentinelId);
            _observerAttached = true;
        }
        else if (!shouldObserve && _observerAttached)
        {
            await JS.InvokeVoidAsync("unobserveIntersection", SentinelId);
            _observerAttached = false;
        }
    }

    [JSInvokable]
    public async Task OnScrolledToBottom()
    {
        if (_loadingMore || !_hasMore || _loading) return;
        _observerAttached = false;
        try { await JS.InvokeVoidAsync("unobserveIntersection", SentinelId); } catch { }
        await InvokeAsync(async () =>
        {
            await LoadMoreAsync();
            StateHasChanged();
        });
    }

    public async ValueTask DisposeAsync()
    {
        if (_observerAttached)
        {
            try { await JS.InvokeVoidAsync("unobserveIntersection", SentinelId); } catch { }
            _observerAttached = false;
        }
        _selfRef?.Dispose();
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadUiStateAsync();
            var tfidfTask = LoadTfIdfAsync();
            await Refresh();
            Config = await Repo.Resource.GetConfigForm();
            Statuses = (await Repo.Task.GetAsync()).ToList();
            await tfidfTask;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadTfIdfAsync()
    {
        if (TfIdfService.IsLoaded) return;
        try
        {
            var idf = await TaskService.GetTfIdfAsync();
            TfIdfService.SetIndex(new TfIdfIndex(idf));
        }
        catch
        {
            // Non-critical; search falls back to length-based token selection.
        }
    }

    private static decimal ResolveTaskConversionFactor(ProjectTaskDto task)
    {
        if (task.ParameterValues.Count == 0)
            return task.ChangeFactor2;

        decimal product = 1m;
        foreach (var value in task.ParameterValues.Values)
            product *= value;

        return Math.Round(product, 4, MidpointRounding.AwayFromZero);
    }

    private static string ResolveTaskParameterUnit(ParamName parameter, string? fallbackUnit)
        => parameter is ParamName.Thickness or ParamName.Width or ParamName.Length
            ? "m"
            : fallbackUnit ?? string.Empty;
}
