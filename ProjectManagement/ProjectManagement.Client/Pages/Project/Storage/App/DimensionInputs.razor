@using ProjectManagement.Shared.DTO.ProjectAppStorage
@using ProjectManagement.Shared.Enums
@using ProjectManagement.Shared.Helper.ProjectAppStorage
@using System.Linq.Expressions
@inherits AppComponentBase

<div class="flex flex-wrap items-end gap-1 md:gap-1.5 text-[11px]"
     @key="@($"{Task.Id}:{Task.NewUnitCode ?? "-"}")">

    <!-- Quantity -->
    <div class="flex flex-col gap-0.5 w-[90px]">
        <input type="text"
               id="@($"quantity-{Task.Id}")"
               inputmode="decimal"
               placeholder="@CalcResource.quantity"
               value="@GetTaskQuantityInputValue()"
               @oninput="OnTaskQuantityInputChanged"
               @onblur="OnTaskQuantityBlur"
               class="w-full border border-gray-300 dark:border-gray-600 rounded px-1.5 py-0.5 text-[11px] bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-1 focus:ring-blue-500" />
    </div>

    <!-- Unit -->
    @if (Task.UnitGroupId.HasValue)
    {
        <div class="flex flex-col gap-0.5 w-[110px]">
            <label for="@($"unit-{Task.Id}")"
                   class="text-[10px] text-gray-700 dark:text-gray-300">
                @CalcResource.unit
            </label>
            <select id="@($"unit-{Task.Id}")"
                    class="w-full border border-gray-300 dark:border-gray-600 rounded px-1.5 py-0.5 text-[11px] bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-1 focus:ring-blue-500"
                    value="@Task.NewUnitCode"
                    @onchange="OnUnitChanged">
                <option value=""> --- </option>
                @foreach (var to in Task.UnitGroup.Keys.Distinct(StringComparer.OrdinalIgnoreCase))
                {
                    <option value="@to">@to</option>
                }
            </select>
        </div>
    }

    @{
        var inputs = new (string Label, ParamName Name, int Index)[]
        {
            ("Thickness (mm)", ParamName.Thickness, 0),
            ("Width (mm)",     ParamName.Width,     1),
            ("Length (mm)",    ParamName.Length,    2)
        };
    }

    <!-- Dimensions -->
    @foreach (var inp in inputs)
    {
        var maxVal = Task.WorkloadThresholds[inp.Index];
        var show = (maxVal > 0) || Needs(Task, inp.Name);

        if (show)
        {
            <div class="flex flex-col gap-0.5 w-[120px]">
                <input type="text"
                       inputmode="decimal"
                       placeholder="@inp.Label"
                       value="@GetParameterInputValue(inp.Name)"
                       @oninput="e => OnParamInputChanged(inp.Name, e)"
                       @onblur="() => OnParamBlur(inp.Name)"
                       class="w-full border border-gray-300 dark:border-gray-600 rounded px-1.5 py-0.5 text-[11px] bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-1 focus:ring-blue-500"
                       @attributes="@((maxVal > 0 ? new Dictionary<string, object> { { "max", maxVal } } : null))" />
            </div>
        }
    }

    <!-- Apply button -->
    @if (ShouldShowApply(Task))
    {
        <button class="px-2 py-1 border border-blue-600 text-blue-600 rounded transition hover:bg-blue-600 hover:text-white dark:border-blue-400 dark:text-blue-400 dark:hover:bg-blue-400 dark:hover:text-white px-1 py-0.5 text-sm mt-2 text-[11px] h-[26px] px-2"
                @onclick="() => OnApply.InvokeAsync()">
            @ResourceApp.Button_Apply
        </button>
    }
</div>

@code {
    [Parameter] public ProjectTaskDto Task { get; set; } = default!;
    [Parameter] public int MaxFractionDigits { get; set; } = NumericFormatHelper.DefaultMaxFractionDigits;
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public EventCallback OnApply { get; set; }

    private readonly DimensionValueModel _dimensionValues = new();
    private string? _taskQuantityDraft;
    private readonly Dictionary<ParamName, string> _parameterDrafts = new();

    protected override void OnParametersSet()
    {
        _dimensionValues.Thickness = ReadParameterValue(ParamName.Thickness);
        _dimensionValues.Width = ReadParameterValue(ParamName.Width);
        _dimensionValues.Length = ReadParameterValue(ParamName.Length);
    }

    // ========== تغيّر الوحدة ==========
    private void OnUnitChanged(ChangeEventArgs e)
    {
        Task.NewUnitCode = e.Value?.ToString();
        StateHasChanged();
        if (OnChanged.HasDelegate)
            OnChanged.InvokeAsync();
    }

    // ========== تحديث بارامتر ==========
    private decimal? ReadParameterValue(ParamName name)
        => Task.ParameterValues.TryGetValue(name, out var value) ? value : null;

    private decimal? GetParameterValue(ParamName name)
        => name switch
        {
            ParamName.Thickness => _dimensionValues.Thickness,
            ParamName.Width => _dimensionValues.Width,
            ParamName.Length => _dimensionValues.Length,
            _ => ReadParameterValue(name)
        };

    private Expression<Func<decimal?>> GetValueExpression(ParamName name)
        => name switch
        {
            ParamName.Thickness => () => _dimensionValues.Thickness,
            ParamName.Width => () => _dimensionValues.Width,
            ParamName.Length => () => _dimensionValues.Length,
            _ => () => _dimensionValues.Thickness
        };

    private string GetTaskQuantityInputValue()
        => _taskQuantityDraft ?? NumericFormatHelper.Format(Task.Quantity, MaxFractionDigits);

    private async Task OnTaskQuantityInputChanged(ChangeEventArgs e)
    {
        var rawValue = e.Value?.ToString() ?? string.Empty;
        _taskQuantityDraft = rawValue;

        if (!NumericInputHelper.TryParseNullableDecimal(rawValue, out var parsed))
            return;

        Task.Quantity = parsed;

        if (OnChanged.HasDelegate)
            await OnChanged.InvokeAsync();
    }

    private Task OnTaskQuantityBlur()
    {
        _taskQuantityDraft = null;
        return InvokeAsync(StateHasChanged);
    }

    private string GetParameterInputValue(ParamName name)
        => _parameterDrafts.TryGetValue(name, out var draft)
            ? draft
            : NumericFormatHelper.Format(GetParameterValue(name), MaxFractionDigits);

    private async Task OnParamInputChanged(ParamName name, ChangeEventArgs e)
    {
        var rawValue = e.Value?.ToString() ?? string.Empty;
        _parameterDrafts[name] = rawValue;

        if (!NumericInputHelper.TryParseNullableDecimal(rawValue, out var parsed))
            return;

        OnParamChangedInternal(name, parsed);

        if (OnChanged.HasDelegate)
            await OnChanged.InvokeAsync();
    }

    private Task OnParamBlur(ParamName name)
    {
        _parameterDrafts.Remove(name);
        return InvokeAsync(StateHasChanged);
    }

    private void OnParamChangedInternal(ParamName name, decimal? value)
    {
        switch (name)
        {
            case ParamName.Thickness:
                _dimensionValues.Thickness = value;
                break;
            case ParamName.Width:
                _dimensionValues.Width = value;
                break;
            case ParamName.Length:
                _dimensionValues.Length = value;
                break;
        }

        if (value.HasValue)
            Task.ParameterValues[name] = value.Value;
        else
            Task.ParameterValues.Remove(name);
    }

    // ========== منطق العرض ==========
    private bool Needs(ProjectTaskDto t, ParamName p)
    {
        if (string.IsNullOrWhiteSpace(t.NewUnitCode) || string.IsNullOrWhiteSpace(t.UnitCode))
            return false;

        if (t.UnitCode.Equals(t.NewUnitCode, StringComparison.OrdinalIgnoreCase))
            return false;

        if (!UnitRulesCatalog.TryGet(t.NewUnitCode, t.UnitCode, out var rule))
            return false;

        return rule.Params.Any(param => param.Key == p);
    }

    private bool ShouldShowApply(ProjectTaskDto t)
    {
        var thresholds = t.WorkloadThresholds ?? new List<decimal>();
        bool needsDims = Needs(t, ParamName.Thickness)
                      || Needs(t, ParamName.Width)
                      || Needs(t, ParamName.Length);
        return thresholds.Any(x => x > 0) || needsDims;
    }

    private sealed class DimensionValueModel
    {
        public decimal? Thickness { get; set; }
        public decimal? Width { get; set; }
        public decimal? Length { get; set; }
    }
}
