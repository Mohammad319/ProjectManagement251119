@using ProjectManagement.Client.Shared.MVVM.Calculation
@inherits AppComponentBase

<div>
    <div class="mb-3 flex items-center justify-between gap-3">
        <p class="text-sm text-slate-500 dark:text-slate-400">@Calculation.Name</p>
        <button type="button"
                class="shrink-0 rounded-md bg-sky-600 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-sky-700 disabled:cursor-not-allowed disabled:opacity-50"
                disabled="@_isCreatingVersion"
                title="Skapa ny version av kalkylen"
                @onclick="async () => await CreateNewVersionAsync(Calculation)">
            + Ny version
        </button>
    </div>

    @* Intern scroll i tabellområdet så hela sidan aldrig får horisontell scroll. *@
    <div class="overflow-x-auto">
        <table class="min-w-full text-xs">
            <thead>
                <tr class="border-b border-slate-200 dark:border-slate-700">
                    @* Rubrik och cellvärde styrs av samma ColumnKey (VersionColumns) så ordningen alltid stämmer. *@
                    @foreach (var col in VersionColumns)
                    {
                        <th class="@VersionHeaderClass(col)">@VersionHeaderLabel(col)</th>
                    }
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                @foreach (var version in GetVersions())
                {
                    <tr>
                        @foreach (var col in VersionColumns)
                        {
                            @RenderVersionCell(col, version)
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="mt-4 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-300">
            @_message
        </div>
    }
</div>

@code {
    [Parameter] public ListCalculationMVVM Calculation { get; set; } = default!;
    [Parameter] public EventCallback OnReloadRequired { get; set; }

    private bool _isCreatingVersion;
    private string _message = string.Empty;

    // Kanonisk kolumnordning. Rubrik (VersionHeaderLabel) och cell (RenderVersionCell) styrs av
    // samma nyckel, så data aldrig kan hamna under fel rubrik även om listan ändras senare.
    private static readonly string[] VersionColumns =
        { "version", "code", "name", "created", "updated", "status", "actions" };

    private string VersionHeaderClass(string key) => key switch
    {
        // Åtgärder ligger längst till höger.
        "actions" => "pb-2 text-right text-[11px] font-semibold text-slate-500 dark:text-slate-400",
        _ => "pb-2 pr-4 text-left text-[11px] font-semibold text-slate-500 dark:text-slate-400"
    };

    private string VersionHeaderLabel(string key) => key switch
    {
        "version" => AppLoc["version"].Value,
        "code"    => AppLoc["code"].Value,
        "name"    => AppLoc["calculationName"].Value,
        "created" => AppLoc["createdDate"].Value,
        "updated" => AppLoc["lastModified"].Value,
        "status"  => AppLoc["calculationStatus"].Value,
        "actions" => string.Empty,
        _         => string.Empty
    };

    private RenderFragment RenderVersionCell(string key, ListCalculationMVVM version) => key switch
    {
        "version" => @<td class="py-2 pr-4"><span class="font-mono font-semibold text-slate-800 dark:text-slate-100">@FormatVersion(version.VersionNumber)</span></td>,
        "code"    => @<td class="py-2 pr-4 font-mono text-slate-500 dark:text-slate-400">@FormatText(version.Code)</td>,
        "name"    => @<td class="py-2 pr-4 text-slate-700 dark:text-slate-200">@version.Name</td>,
        "created" => @<td class="py-2 pr-4 text-slate-500 dark:text-slate-400">@FormatDate(version.CreatedAt)</td>,
        "updated" => @<td class="py-2 pr-4 text-slate-500 dark:text-slate-400">@(version.UpdatedAt is { } u ? FormatDate(u) : "-")</td>,
        "status"  => RenderVersionStatusCell(version),
        "actions" => RenderVersionActionsCell(version),
        _         => @<td></td>
    };

    private RenderFragment RenderVersionStatusCell(ListCalculationMVVM version) => __builder =>
    {
        var (label, cls) = VersionStatus(version);
        <td class="py-2 pr-4">
            <span class="inline-flex rounded-full px-1.5 py-0.5 text-[10px] font-semibold @cls">@label</span>
        </td>;
    };

    private RenderFragment RenderVersionActionsCell(ListCalculationMVVM version) =>
        @<td class="py-2 text-right">
            <div class="flex flex-wrap justify-end gap-1.5">
                <button type="button"
                        class="rounded-md border border-slate-300 px-2 py-1 font-medium text-slate-700 transition hover:bg-slate-50 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
                        @onclick="async () => await OpenVersionAsync(version)">
                    @AppLoc["open"]
                </button>
                @if (!version.IsCurrentVersion)
                {
                    <button type="button"
                            class="rounded-md border border-violet-300 px-2 py-1 font-medium text-violet-700 transition hover:bg-violet-50 disabled:cursor-not-allowed disabled:opacity-50 dark:border-violet-800 dark:text-violet-300 dark:hover:bg-violet-950/40"
                            disabled="@_isCreatingVersion"
                            @onclick="async () => await RestoreAsNewVersionAsync(version)">
                        @AppLoc["restoreAsNewVersion"]
                    </button>
                }
                @if (CanArchiveVersion(version))
                {
                    <button type="button"
                            class="rounded-md border border-amber-300 px-2 py-1 font-medium text-amber-700 transition hover:bg-amber-50 dark:border-amber-800 dark:text-amber-300 dark:hover:bg-amber-950/40"
                            @onclick="async () => await ArchiveVersionAsync(version)">
                        @AppLoc["archiveVersion"]
                    </button>
                }
            </div>
        </td>;

    // Versionsstatus: arkiverad → "Arkiverad"; aktuell version → "Aktuell"; låst → "Låst";
    // i övrigt en tidigare (ej aktuell) version. Återanvänder befintliga statusflaggor – ingen ny logik.
    private (string Label, string Class) VersionStatus(ListCalculationMVVM version)
    {
        if (version.IsArchived)
            return (AppLoc["archived"].Value, "bg-amber-100 text-amber-700 dark:bg-amber-950/50 dark:text-amber-300");
        if (version.IsCurrentVersion)
            return (AppLoc["current"].Value, "bg-emerald-100 text-emerald-700 dark:bg-emerald-950/50 dark:text-emerald-300");
        if (version.IsLocked)
            return (AppLoc["locked"].Value, "bg-slate-200 text-slate-600 dark:bg-slate-800 dark:text-slate-300");
        return ("Tidigare version", "bg-slate-100 text-slate-500 dark:bg-slate-800 dark:text-slate-400");
    }

    private IEnumerable<ListCalculationMVVM> GetVersions() =>
        CalculationVersionSelector.GetVersions(
            Folder.State.ProjectSelected?.Calculations,
            Calculation);

    private bool CanArchiveVersion(ListCalculationMVVM version) =>
        !version.IsCurrentVersion &&
        !version.IsLocked &&
        !version.IsArchived &&
        !(Folder.State.ProjectSelected?.Calculations ?? [])
            .Any(c => c.SourceCalculationId == version.Id);

    private static string FormatVersion(int v) => $"V.{v:D2}";
    private static string FormatText(string? v) => string.IsNullOrWhiteSpace(v) ? "-" : v;
    private static string FormatDate(DateTime d) => d == default ? "-" : d.ToString("yyyy-MM-dd");

    private async Task OpenVersionAsync(ListCalculationMVVM version)
    {
        await Modal.CloseAsync();
        await CalcService.SetCalc(version.Id);
    }

    private async Task CreateNewVersionAsync(ListCalculationMVVM calculation)
    {
        if (_isCreatingVersion || calculation.Id <= 0)
            return;

        _isCreatingVersion = true;
        _message = string.Empty;

        try
        {
            var newId = await Repo.Calculation.CreateVersionAsync(calculation.Id);
            if (newId <= 0)
            {
                _message = "Ny version kunde inte skapas.";
                return;
            }

            await OnReloadRequired.InvokeAsync();
            StateHasChanged();
            await CalcService.SetCalc(newId);
            MHD.Notifications(ToastType.Add, true);
        }
        catch (Exception ex)
        {
            _message = "Ett fel uppstod när en ny version skulle skapas.";
            await ClientLog.ErrorAsync("Create calculation version failed", ex: ex);
        }
        finally
        {
            _isCreatingVersion = false;
        }
    }

    private Task RestoreAsNewVersionAsync(ListCalculationMVVM version) =>
        CreateNewVersionAsync(version);

    private async Task ArchiveVersionAsync(ListCalculationMVVM version)
    {
        var dto = await Repo.Calculation.GetPostAsync(version.Id);
        if (dto is null) return;
        dto.IsArchived = true;
        bool ok = await Repo.Calculation.UpdateAsync(dto, version.Id);
        if (ok)
        {
            await OnReloadRequired.InvokeAsync();
            StateHasChanged();
        }
        MHD.Notifications(ToastType.Update, ok);
    }
}
