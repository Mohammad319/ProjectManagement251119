@using Microsoft.AspNetCore.Components.Forms
@using ProjectManagement.Client.Shared.SharedComponent
@using ProjectManagement.Client.Shared.SharedComponent.Contact

@inherits AppComponentBase

@if (IsLoading)
{
    <MhdLoading />
}
else if (ProjectUpdate is not null)
{
    <EditForm id="@DialogFormId" @key="editContext" class="space-y-0" EditContext="editContext!"
              OnValidSubmit="HandleSubmitAsync">

        <DataAnnotationsValidator />
        <FormValidationSummary />

        @if (IsReadOnly)
        {
            <div class="mb-3 flex items-start gap-2 rounded-lg border border-sky-200 bg-sky-50 px-3 py-2 text-sm text-sky-800 dark:border-sky-900/60 dark:bg-sky-950/30 dark:text-sky-200">
                <svg class="mt-0.5 h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <span>Du har visningsbehörighet. Du kan läsa projektet men inte ändra grunddata.</span>
            </div>
        }

        @* A native disabled fieldset makes every nested field read-only for Visare without
           touching each input; the submit is also guarded in HandleSubmitAsync. *@
        <fieldset disabled="@IsReadOnly" class="contents">
        <div class="pr-1">
            <div class="grid grid-cols-1 gap-3 xl:grid-cols-2">

                @* Grunddata *@
                <section class="rounded-lg border border-slate-200 bg-white p-3 shadow-sm dark:border-slate-700 dark:bg-slate-900 xl:col-span-2">
                    <h3 class="mb-3 text-sm font-semibold text-slate-800 dark:text-slate-100">@AppLoc["basicData"]</h3>
                    <div class="mb-3 grid grid-cols-4 gap-3">
                        <div class="col-span-1">
                            <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400">@CalcResource.code</label>
                            <InputText class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100" @bind-Value="@ProjectUpdate.Code" />
                        </div>
                        <div class="col-span-3">
                            <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400">@CalcResource.name</label>
                            <InputText class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100" @bind-Value="@ProjectUpdate.Name" />
                        </div>
                    </div>
                    <div class="grid grid-cols-3 gap-3">
                        <div>
                            <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400"
                                   title="Projektstatus beskriver projektets övergripande läge och resultat, t.ex. förfrågan, inlämnat, vunnet eller förlorat.">Projektstatus</label>
                            <MhdFormSelect TValue="int?"
                                           @bind-Value="ProjectUpdate.StatusId"
                                           Options="StatusItems"
                                           ShowColorDot="true"
                                           Placeholder="@AppLoc["selectPlaceholder"]" />
                        </div>
                        <div>
                            <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400">@CalcResource.projectType</label>
                            <MhdFormSelect TValue="int?"
                                           @bind-Value="ProjectUpdate.TypeId"
                                           Options="@ToItems(Config?.Types)"
                                           Placeholder="@AppLoc["selectPlaceholder"]" />
                        </div>
                        <div class="flex items-end">
                            <label class="inline-flex cursor-pointer items-center gap-2 rounded-md border border-slate-200 px-2.5 py-1.5 transition hover:bg-slate-50 dark:border-slate-700 dark:hover:bg-slate-800">
                                <input type="checkbox"
                                       class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 dark:border-slate-500"
                                       checked="@(ProjectUpdate.IsArchived)"
                                       @onchange="e => ProjectUpdate.IsArchived = (bool)(e.Value ?? false)" />
                                <span class="select-none text-sm text-slate-700 dark:text-slate-300">@AppLoc["archived"]</span>
                            </label>
                        </div>
                    </div>
                </section>

                @* ── Left column: Ansvar, Tidsplan, Kundgrupper ─ *@
                <div class="flex flex-col gap-3">

                    @* Ansvar *@
                    <section class="rounded-lg border border-slate-200 bg-white p-3 shadow-sm dark:border-slate-700 dark:bg-slate-900">
                        <h3 class="mb-3 text-sm font-semibold text-slate-800 dark:text-slate-100">@AppLoc["responsibility"]</h3>
                        <div class="grid grid-cols-1 gap-3 sm:!grid-cols-[minmax(0,1fr)_minmax(0,1fr)] [&>*]:min-w-0 [&_input]:min-w-0 [&_select]:min-w-0 [&_input]:w-full [&_select]:w-full">
                           
                            <div>
                                <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400">Kalkylansvarig</label>
                                <MhdFormSelect TValue="string"
                                               @bind-Value="ProjectResponsible"
                                               Options="ResponsibleUserItems"
                                               Placeholder="Välj ansvarig" />
                            </div>
                            <div>
                                <label class="mb-0.5 flex items-center gap-1 text-xs font-medium text-slate-600 dark:text-slate-400">
                                    <span>Granskare</span>
                                    @* Discreet info icon: CSS tooltip on hover and keyboard focus, layout-neutral
                                       (absolute + pointer-events-none), readable in light and dark mode. *@
                                    <span class="group relative inline-flex">
                                        <svg tabindex="0" role="img"
                                             aria-label="En granskare med endast visningsåtkomst kan skriva granskningskommentarer, men inte ändra projekt, kalkyler eller ekonomiska värden."
                                             class="h-3.5 w-3.5 cursor-help text-slate-400 outline-none transition-colors hover:text-sky-600 focus-visible:text-sky-600 focus-visible:ring-2 focus-visible:ring-sky-500/40 dark:hover:text-sky-400 dark:focus-visible:text-sky-400"
                                             viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                        </svg>
                                        <span role="tooltip"
                                              class="pointer-events-none absolute left-1/2 top-full z-[80] mt-1 w-64 -translate-x-1/2 rounded-md bg-slate-800 px-2.5 py-1.5 text-xs font-normal leading-snug text-white opacity-0 shadow-lg transition-opacity duration-150 group-hover:opacity-100 group-focus-within:opacity-100 dark:bg-slate-700">
                                            En granskare med endast visningsåtkomst kan skriva granskningskommentarer, men inte ändra projekt, kalkyler eller ekonomiska värden.
                                        </span>
                                    </span>
                                </label>
                                <MhdFormSelect TValue="string"
                                               Value="ProjectUpdate.Inspector"
                                               ValueChanged="OnInspectorChanged"
                                               Options="UserItems"
                                               Placeholder="Ingen granskare" />
                            </div>
                        </div>
                    </section>

                    @* Projektplats *@
                    <section class="rounded-lg border border-slate-200 bg-white p-3 shadow-sm dark:border-slate-700 dark:bg-slate-900">
                        <h3 class="mb-3 text-sm font-semibold text-slate-800 dark:text-slate-100">@AppLoc["projectLocation"]</h3>
                        <div class="grid grid-cols-1 gap-3">
                            <div>
                                <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400">Adress</label>
                                <InputText class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100" @bind-Value="@MainAddress.City" />
                            </div>
                            <div>
                                <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400">Geografisk plats</label>
                                <InputText class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100"
                                           placeholder="Text, koordinat, kartlänk …"
                                           @bind-Value="@MainAddress.Street" />
                            </div>
                        </div>
                    </section>

                    @* Tidsplan *@
                    <section class="rounded-lg border border-slate-200 bg-white p-3 shadow-sm dark:border-slate-700 dark:bg-slate-900">
                        <h3 class="mb-3 text-sm font-semibold text-slate-800 dark:text-slate-100">@AppLoc["projectSchedule"]</h3>
                        <div class="grid grid-cols-1 gap-3 sm:!grid-cols-[minmax(0,1fr)_minmax(0,1fr)] [&>*]:min-w-0 [&_input]:min-w-0 [&_select]:min-w-0 [&_input]:w-full [&_select]:w-full">
                            <div>
                                <label class="mb-0.5 flex items-center gap-1 text-xs font-medium text-slate-600 dark:text-slate-400">
                                    <span>@CalcResource.startDate</span>
                                    <DateStatusDot Date="ProjectUpdate.StartDate" />
                                </label>
                                <InputDate ParsingErrorMessage="@($"{CalcResource.startDate} måste vara ett giltigt datum.")" class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100" @bind-Value="@ProjectUpdate.StartDate" />
                            </div>
                            <div>
                                <label class="mb-0.5 flex items-center gap-1 text-xs font-medium text-slate-600 dark:text-slate-400">
                                    <span>@CalcResource.endDate</span>
                                    <DateStatusDot Date="ProjectUpdate.EndDate" />
                                </label>
                                <InputDate ParsingErrorMessage="@($"{CalcResource.endDate} måste vara ett giltigt datum.")" class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100" @bind-Value="@ProjectUpdate.EndDate" />
                            </div>
                        </div>
                    </section>

                    @* Kundgrupper *@
                    <section class="rounded-lg border border-slate-200 bg-white p-3 shadow-sm dark:border-slate-700 dark:bg-slate-900">
                        <h3 class="mb-3 text-sm font-semibold text-slate-800 dark:text-slate-100">@AppLoc["customerInformation"]</h3>
                        <div class="grid grid-cols-1 gap-3 sm:!grid-cols-[minmax(0,1fr)_minmax(0,1fr)] [&>*]:min-w-0 [&_input]:min-w-0 [&_select]:min-w-0 [&_input]:w-full [&_select]:w-full">
                            <div>
                                <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400">@CalcResource.developer</label>
                                <InputText class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100" @bind-Value="@ProjectUpdate.Developer" />
                            </div>
                            @if (Config?.Organisation != null)
                            {
                                <div>
                                    <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400">Beställare</label>
                                    <MhdFormSelect TValue="int?"
                                                   @bind-Value="ProjectUpdate.OrganisationId"
                                                   Options="@ToItems(Config.Organisation)"
                                                   Placeholder="@AppLoc["selectPlaceholder"]" />
                                </div>
                            }
                       
                            <div>
                                <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400">@ResourceLoc.clientsProjectmanager</label>
                                <InputText class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100" @bind-Value="@ProjectUpdate.ClientsManager" />
                            </div>
                            <div>
                                <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400">@ResourceLoc.designer</label>
                                <InputText class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100" @bind-Value="@ProjectUpdate.Designer" />
                            </div>
                            <div>
                                <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400">Kundens kontaktperson under upphandlingstiden</label>
                                <InputText class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100" @bind-Value="@ProjectUpdate.Supervisor" />
                            </div>
                            <div class="sm:col-span-2">
                                <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400">@CalcResource.overviewInfoProject</label>
                                <InputText class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100" @bind-Value="@ProjectUpdate.OverviewInfoProject" />
                            </div>
                        </div>
                    </section>

                </div>

                @* ── Right column: Upphandling ─────────── *@
                <div class="flex flex-col gap-3">

                    @* Upphandling *@
                    <section class="rounded-lg border border-slate-200 bg-white p-3 shadow-sm dark:border-slate-700 dark:bg-slate-900">
                        <h3 class="mb-3 text-sm font-semibold text-slate-800 dark:text-slate-100">@AppLoc["procurementAndReferences"]</h3>
                        <div class="grid grid-cols-1 gap-3 sm:!grid-cols-[minmax(0,1fr)_minmax(0,1fr)] [&>*]:min-w-0 [&_input]:min-w-0 [&_select]:min-w-0 [&_input]:w-full [&_select]:w-full">
                            <div>
                                <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400">@AppLoc["procurementNumber"]</label>
                                <InputText class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100" @bind-Value="@ProjectUpdate.ProcurementNumber" />
                            </div>
                            <div>
                                <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400">@AppLoc["customerReference"]</label>
                                <InputText class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100" @bind-Value="@ProjectUpdate.CustomerReference" />
                            </div>
                            <div class="sm:col-span-2">
                                <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400">@AppLoc["procurementName"]</label>
                                <InputText class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100" @bind-Value="@ProjectUpdate.ProcurementName" />
                            </div>
                            <div>
                                <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400">@CalcResource.procurementMethods</label>
                                <MhdFormSelect TValue="int?"
                                               @bind-Value="ProjectUpdate.ProcurementMethodsId"
                                               Options="@ToItems(Config?.Methods)"
                                               Placeholder="@AppLoc["selectPlaceholder"]" />
                            </div>
                            <div>
                                <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400">@CalcResource.projectContract</label>
                                <MhdFormSelect TValue="int?"
                                               @bind-Value="ProjectUpdate.ContractId"
                                               Options="@ToItems(Config?.Contracts)"
                                               Placeholder="@AppLoc["selectPlaceholder"]" />
                            </div>
                            <div>
                                <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400">@CalcResource.projectCompensation</label>
                                <MhdFormSelect TValue="int?"
                                               @bind-Value="ProjectUpdate.CompensationId"
                                               Options="@ToItems(Config?.Compensations)"
                                               Placeholder="@AppLoc["selectPlaceholder"]" />
                            </div>


                            <div>
                                <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400">Upphandlingsförfarande</label>
                                <MhdFormSelect TValue="int?"
                                               @bind-Value="ProjectUpdate.ProcurementProcedureId"
                                               Options="@ToItems(Config?.Procedures)"
                                               Placeholder="@AppLoc["selectPlaceholder"]" />
                            </div>
                          
                            <div>
                                <label class="mb-0.5 flex items-center gap-1 text-xs font-medium text-slate-600 dark:text-slate-400">
                                    <span>@CalcResource.publicationDate</span>
                                    <DateStatusDot Date="ProjectUpdate.PublicationDate" />
                                </label>
                                <InputDate ParsingErrorMessage="@($"{CalcResource.publicationDate} måste vara ett giltigt datum.")" class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100" @bind-Value="@ProjectUpdate.PublicationDate" />
                            </div>
                            <div>
                                <label class="mb-0.5 flex items-center gap-1 text-xs font-medium text-slate-600 dark:text-slate-400">
                                    <span>Sista dag för att ställa frågor</span>
                                    <DateStatusDot Date="ProjectUpdate.TenderQA" />
                                </label>
                                <InputDate ParsingErrorMessage="Sista dag för att ställa frågor måste vara ett giltigt datum." class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100" @bind-Value="@ProjectUpdate.TenderQA" />
                            </div>
                            <div>
                                <label class="mb-0.5 flex items-center gap-1 text-xs font-medium text-slate-600 dark:text-slate-400">
                                    <span>@CalcResource.tenderDeadline</span>
                                    <DateStatusDot Date="ProjectUpdate.TenderDeadline" />
                                </label>
                                <InputDate ParsingErrorMessage="@($"{CalcResource.tenderDeadline} måste vara ett giltigt datum.")" class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100" @bind-Value="@ProjectUpdate.TenderDeadline" />
                            </div>
                            <div>
                                <label class="mb-0.5 flex items-center gap-1 text-xs font-medium text-slate-600 dark:text-slate-400">
                                    <span>@CalcResource.decisionDate</span>
                                    <DateStatusDot Date="ProjectUpdate.DecisionDate" />
                                </label>
                                <InputDate ParsingErrorMessage="@($"{CalcResource.decisionDate} måste vara ett giltigt datum.")" class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100" @bind-Value="@ProjectUpdate.DecisionDate" />
                            </div>
                            <div class="sm:col-span-2">
                                <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400">@AppLoc["procurementLink"]</label>
                                <InputText class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100" @bind-Value="@ProjectUpdate.ProcurementLink" />
                            </div>
                        </div>
                    </section>

                    @* Kontakter *@
                    <section class="rounded-lg border border-slate-200 bg-white p-3 shadow-sm dark:border-slate-700 dark:bg-slate-900">
                        <h3 class="mb-3 text-sm font-semibold text-slate-800 dark:text-slate-100">@ResourceIdentity.contact</h3>
                        <ContactsUI Contacts="ProjectUpdate.Contacts" />
                    </section>

                </div>

                @* ── Bottom: Anteckning ──────────────────────────────── *@
                <section class="rounded-lg border border-slate-200 bg-white p-3 shadow-sm dark:border-slate-700 dark:bg-slate-900 xl:col-span-2">
                    <h3 class="mb-3 text-sm font-semibold text-slate-800 dark:text-slate-100">Anteckning</h3>
                    <div class="space-y-2">
                        @for (int i = 0; i < ProjectUpdate.Notes.Count; i++)
                        {
                            var idx = i;
                            <div class="flex items-start gap-2">
                                <textarea class="min-h-24 flex-1 resize-y rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100"
                                          placeholder="Anteckning"
                                          @bind="ProjectUpdate.Notes[idx]">
                                </textarea>
                                @if (ProjectUpdate.Notes.Count > 1)
                                {
                                    <button type="button"
                                            class="mt-1 rounded-md p-1.5 text-slate-400 hover:bg-red-50 hover:text-red-600 dark:hover:bg-red-950/30 dark:hover:text-red-400"
                                            title="Ta bort"
                                            @onclick="() => RemoveNote(idx)">
                                        ×
                                    </button>
                                }
                            </div>
                        }
                        <button type="button"
                                class="mt-1 inline-flex items-center gap-1.5 text-sm text-sky-600 hover:text-sky-700 dark:text-sky-400 dark:hover:text-sky-300"
                                @onclick="AddNote">
                            + Lägg till anteckning
                        </button>
                    </div>
                </section>

            </div>
        </div>
        </fieldset>
    </EditForm>

    @* One-time info when a view-only reviewer is picked. Kept outside the disabled fieldset so the
       OK button stays clickable; shown only the first time until "Visa inte detta meddelande igen". *@
    @if (_showReviewerInfoModal)
    {
        <div class="fixed inset-0 z-[1100] flex items-center justify-center bg-black/40 p-4" @onclick="DismissReviewerInfoAsync">
            <div class="w-full max-w-md rounded-xl border border-slate-200 bg-white p-5 shadow-xl dark:border-slate-700 dark:bg-slate-900"
                 @onclick:stopPropagation="true">
                <div class="mb-3 flex items-start gap-3">
                    <span class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-sky-100 text-sky-600 dark:bg-sky-950/50 dark:text-sky-400">
                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    </span>
                    <div>
                        <h3 class="text-base font-semibold text-slate-900 dark:text-slate-100">Granskaren har endast visningsåtkomst</h3>
                        <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Granskaren kan skriva granskningskommentarer, men kan inte ändra projekt, kalkyler eller ekonomiska värden.</p>
                    </div>
                </div>
                <label class="mb-4 flex cursor-pointer items-center gap-2 text-sm text-slate-600 dark:text-slate-300">
                    <input type="checkbox"
                           class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 dark:border-slate-500"
                           checked="@_dontShowReviewerInfoAgain"
                           @onchange="e => _dontShowReviewerInfoAgain = (bool)(e.Value ?? false)" />
                    <span class="select-none">Visa inte detta meddelande igen</span>
                </label>
                <div class="flex justify-end">
                    <button type="button"
                            class="rounded-md bg-sky-600 px-4 py-1.5 text-sm font-medium text-white shadow-sm transition hover:bg-sky-700 focus:outline-none focus:ring-2 focus:ring-sky-500/40"
                            @onclick="DismissReviewerInfoAsync">
                        OK
                    </button>
                </div>
            </div>
        </div>
    }
}
