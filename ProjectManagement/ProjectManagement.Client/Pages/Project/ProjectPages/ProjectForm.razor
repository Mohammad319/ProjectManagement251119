@using BlazorMHD.UI.Components.Navigation.Tabs
@using Microsoft.AspNetCore.Components.Forms
@using ProjectManagement.Client.Shared.SharedComponent.Contact
@using ProjectManagement.Shared.Base.Project
@using BlazorMHD.UI.Core.Navigation
@using BlazorMHD.UI.Core.DesignSystem
@using NavTabItem = BlazorMHD.UI.Core.Navigation.TabItem

@inherits AppComponentBase

@if (IsLoading)
{
    <BlazorMHD.UI.Components.Feedback.Loading.MhdLoading />
}
else if (ProjectUpdate is not null)
{
    <EditForm id="projectForm" class="space-y-0" Model="@ProjectUpdate"
              OnValidSubmit="HandleSubmitAsync">

        <DataAnnotationsValidator />
        <ValidationSummary class="text-red-600 mb-2" />

        <!-- التابات -->
        <MhdTabs Items="@TabItems"
                 Mode="MhdTabMode.Horizontal"
                 Size="MhdSize.Sm"
                 @bind-ActiveKey="ActiveKey" />

        <!-- محتوى كل تبويب -->
        @if (Part == 1)
        {
            <div class="grid grid-cols-1 md:grid-cols-3 gap-2">
                <div>
                    <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.code</label>
                    <InputText class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" @bind-Value="@ProjectUpdate.Code" />
                    <ValidationMessage For=@(() => ProjectUpdate.Code) />
                </div>
                <div class="md:col-span-2">
                    <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.name</label>
                    <InputText class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" @bind-Value="@ProjectUpdate.Name" />
                    <ValidationMessage For=@(() => ProjectUpdate.Name) />
                </div>
                <div>
                    <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.projectType</label>
                    <InputSelect @bind-Value="ProjectUpdate.TypeId" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white">
                        <option></option>
                        @if (Config?.Types != null)
                        {
                            foreach (var t in Config.Types)
                            {
                                <option value="@t.Id">@t.Name</option>
                            }
                        }
                    </InputSelect>
                    <ValidationMessage For=@(() => ProjectUpdate.TypeId) />
                </div>
            </div>
        }
        else if (Part == 2)
        {
            <div class="grid grid-cols-1 md:grid-cols-4 gap-2">
                <div>
                    <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.projectContract</label>
                    <InputSelect @bind-Value="ProjectUpdate.ContractId" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white">
                        <option></option>
                        @if (Config?.Contracts != null)
                        {
                            foreach (var t in Config.Contracts)
                            {
                                <option value="@t.Id">@t.Name</option>
                            }
                        }
                    </InputSelect>
                </div>
                <div>
                    <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.projectCompensation</label>
                    <InputSelect @bind-Value="ProjectUpdate.CompensationId" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white">
                        <option></option>
                        @if (Config?.Compensations != null)
                        {
                            foreach (var t in Config.Compensations)
                            {
                                <option value="@t.Id">@t.Name</option>
                            }
                        }
                    </InputSelect>
                    <ValidationMessage For=@(() => ProjectUpdate.CompensationId) />
                </div>
                <div>
                    <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.procurement</label>
                    <InputSelect @bind-Value="ProjectUpdate.Procurement" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white">
                        <option value="@Procurement.A">@Procurement.A</option>
                        <option value="@Procurement.B">@Procurement.B</option>
                    </InputSelect>
                </div>
                <div>
                    <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.procurementMethods</label>
                    <InputSelect @bind-Value="ProjectUpdate.ProcurementMethodsId" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white">
                        <option></option>
                        @if (Config?.Methods != null)
                        {
                            foreach (var t in Config.Methods)
                            {
                                <option value="@t.Id">@t.Name</option>
                            }
                        }
                    </InputSelect>
                </div>
            </div>
        }
        else if (Part == 3)
        {
            <div class="grid grid-cols-1 md:grid-cols-4 gap-2">
                @for (int i = 0; i < ProjectUpdate.Responsibles.Count; i++)
                {
                    <div>
                        <label>@CalcResource.responsible</label>
                        <InputText class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white"
                                   @bind-Value="@ProjectUpdate.Responsibles[i]" />
                    </div>
                }

                <div>
                    <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.inspector</label>
                    <InputText class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" @bind-Value="@ProjectUpdate.Inspector" />
                </div>
                <div>
                    <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@ResourceApp.organisation</label>
                    <InputText class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" @bind-Value="@ProjectUpdate.Supervisor" />
                </div>
            </div>
        }
        else if (Part == 4)
        {
            <div class="grid grid-cols-1 md:grid-cols-4 gap-2">
                @if (Config?.Organisation != null)
                {
                    <div>
                        <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@ResourceApp.organisation</label>
                        <InputSelect @bind-Value="ProjectUpdate.OrganisationId" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white">
                            <option></option>
                            @foreach (var t in Config.Organisation)
                            {
                                <option value="@t.Id">@t.Name</option>
                            }
                        </InputSelect>
                    </div>
                }

                <div>
                    <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.developer</label>
                    <InputText class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" @bind-Value="@ProjectUpdate.Developer" />
                </div>
                <div>
                    <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@ResourceLoc.clientsProjectmanager</label>
                    <InputText class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" @bind-Value="@ProjectUpdate.ClientsManager" />
                </div>
                <div>
                    <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@ResourceLoc.designer</label>
                    <InputText class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" @bind-Value="@ProjectUpdate.Designer" />
                </div>
                <div>
                    <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.overviewInfoProject</label>
                    <InputText class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" @bind-Value="@ProjectUpdate.OverviewInfoProject" />
                </div>
            </div>
        }
        else if (Part == 5)
        {
            <div class="grid grid-cols-1 md:grid-cols-4 gap-2">
                <div>
                    <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.startDate</label>
                    <InputDate class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" @bind-Value="@ProjectUpdate.StartDate" />
                </div>
                <div>
                    <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.endDate</label>
                    <InputDate class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" @bind-Value="@ProjectUpdate.EndDate" />
                </div>
                <div>
                    <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.tenderDeadline</label>
                    <InputDate class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" @bind-Value="@ProjectUpdate.TenderDeadline" />
                </div>
                <div>
                    <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.tenderQA</label>
                    <InputDate class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" @bind-Value="@ProjectUpdate.TenderQA" />
                </div>
            </div>
        }
        else if (Part == 6)
        {
            <div class="grid grid-cols-1 md:grid-cols-4 gap-2">
                <div class="flex items-center mt-auto gap-2">
                    <InputCheckbox class="h-4 w-4 text-blue-600 rounded focus:ring-blue-500 dark:text-blue-400" @bind-Value="@ProjectUpdate.IsVisible" />
                    <label class="select-none dark:text-white">@ResourceApp.visible</label>
                </div>

                <div class="md:col-span-3">
                    <button type="button" class="px-2 py-1 border border-green-600 text-green-600 rounded transition hover:bg-green-600 hover:text-white dark:border-green-400 dark:text-green-400 dark:hover:bg-green-400 dark:hover:text-white"
                            @onclick="()=>ProjectUpdate.Notes.Add(string.Empty)">
                        @AppLoc[LocalizerConst.New, ResourceLoc.description]
                    </button>
                </div>

                @for (int i = 0; i < ProjectUpdate.Notes.Count; i++)
                {
                    var index = i;

                    <div class="grid grid-cols-12 gap-2 items-start">
                        <!-- Delete Button -->
                        <button type="button" class="col-span-1 mt-2
                                   inline-flex items-center justify-center rounded-md
                                   px-2 py-1 border border-red-500 text-red-500 text-sm
                                   hover:bg-red-500 hover:text-white transition"
                                @onclick="() => ProjectUpdate.Notes.RemoveAt(index)">
                            @((MarkupString)Icons.DeleteSVG)
                        </button>

                        <!-- Note TextArea -->
                        <div class="col-span-11">
                            <textarea class="w-full rounded border border-gray-300 px-2 py-2 text-sm
                                         min-h-28 resize-y
                                         focus:outline-none focus:ring-2 focus:ring-blue-500
                                         dark:bg-gray-800 dark:border-gray-600 dark:text-white"
                                      @bind="ProjectUpdate.Notes[index]">
                        </textarea>
                        </div>
                    </div>
                }

            </div>
        }
        else if (Part == 7)
        {
            <div class="md:col-span-4">
                <ContactsUI Contacts="ProjectUpdate.Contacts" />
            </div>
        }
    </EditForm>

    <div class="mt-1 flex justify-end gap-1">
        <button type="submit"
                class="px-2 py-1 border border-green-600 text-green-600 rounded transition hover:bg-green-600 hover:text-white dark:border-green-400 dark:text-green-400 dark:hover:bg-green-400 dark:hover:text-white"
                style="margin-right:5px;"
                form="projectForm"
                disabled="@IsLoading">
            @ResourceApp.save
        </button>

        <button type="button"
                class="px-2 py-1 border border-gray-500 text-gray-500 rounded transition hover:bg-gray-500 hover:text-white dark:border-gray-400 dark:text-gray-400 dark:hover:bg-gray-400 dark:hover:text-white"
                @onclick="CancelAsync">
            @ResourceApp.cancel
        </button>
    </div>
}
