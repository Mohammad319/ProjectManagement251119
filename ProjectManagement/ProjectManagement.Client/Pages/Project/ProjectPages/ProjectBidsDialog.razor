@using ProjectManagement.Shared.DTO.Project
@using ProjectManagement.Shared.Enums
@using ProjectManagement.Client.Helper
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inherits AppComponentBase

@if (_editItem is not null)
{
    @* ── Edit / Create form ─────────────────────────────── *@
    <div class="space-y-3">
        <div class="flex items-center justify-between">
            <h3 class="text-sm font-semibold text-slate-800 dark:text-slate-100">
                @(_editItem.Id == 0 ? "Lägg till anbudsgivare" : "Redigera anbudsgivare")
            </h3>
        </div>

        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <div class="sm:col-span-2">
                <label class="mb-1 block text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
                    Anbudsgivare <span class="text-amber-500">*</span>
                </label>
                <input type="text"
                       class="w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-sm text-slate-800 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 @(_formTouched && string.IsNullOrWhiteSpace(_editItem.BidderName) ? "border-red-400 dark:border-red-600" : "")"
                       placeholder="Företagets namn..."
                       @bind="_editItem.BidderName" />
                @if (_formTouched && string.IsNullOrWhiteSpace(_editItem.BidderName))
                {
                    <p class="mt-1 text-[11px] text-red-500">Ange anbudsgivare innan du sparar.</p>
                }
            </div>

            @* ── Anbudsstatus ── *@
            <div>
                <label class="mb-1 block text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Anbudsstatus</label>
                <select class="w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-sm text-slate-800 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
                        value="@_editItem.Status"
                        @onchange="OnStatusChanged">
                    <option value="@BidStatus.Valid">Giltigt</option>
                    <option value="@BidStatus.Rejected">Förkastat</option>
                </select>
            </div>

            @if (_editItem.Status == BidStatus.Rejected)
            {
                <div>
                    <label class="mb-1 block text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Förkastningsorsak</label>
                    <input list="rejection-reasons"
                           type="text"
                           class="w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-sm text-slate-800 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
                           placeholder="Ange orsak..."
                           @bind="_editItem.RejectionReason" />
                    <datalist id="rejection-reasons">
                        <option value="För sent inkommet anbud" />
                        <option value="Uppfyller inte skallkrav" />
                        <option value="Formellt fel" />
                        <option value="Ej kvalificerad" />
                        <option value="Onormalt lågt pris" />
                        <option value="Annan orsak" />
                    </datalist>
                </div>
            }

            @if (IsPointsModel)
            {
                @* ── Poängbaserad utvärdering ── *@
                @if (HasColumns)
                {
                    @foreach (var col in _columns)
                    {
                        var columnId = col.Id;
                        <div>
                            <label class="mb-1 block text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">@col.Name</label>
                            <input type="text"
                                   inputmode="decimal"
                                   class="w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-right text-sm text-slate-800 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
                                   placeholder="0"
                                   value="@FormatPoints(GetFormPrice(columnId))"
                                   @onchange="e => SetFormPrice(columnId, ParseAmount(e.Value?.ToString()))" />
                        </div>
                    }
                }
                else
                {
                    <div>
                        <label class="mb-1 block text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Poäng</label>
                        <input type="text"
                               inputmode="decimal"
                               class="w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-right text-sm text-slate-800 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
                               placeholder="0"
                               value="@FormatPoints(_editItem.Amount)"
                               @onchange="e => _editItem.Amount = ParseAmount(e.Value?.ToString())" />
                    </div>
                }

                @* ── Beräknad totalpoäng (read-only) ── *@
                <div class="sm:col-span-2 flex flex-wrap items-center gap-x-6 gap-y-1 rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-xs dark:border-slate-700 dark:bg-slate-900/60">
                    <span class="text-slate-500 dark:text-slate-400">
                        Totalpoäng:
                        <span class="ml-1 font-mono font-semibold text-sky-700 dark:text-sky-300">@FormatPoints(FormPointsTotal)</span>
                    </span>
                </div>
            }
            else
            {
                @* ── Prisbaserad utvärdering (lägst jämförelsesumma) ── *@
                @if (HasColumns)
                {
                    @foreach (var col in _columns)
                    {
                        var columnId = col.Id;
                        <div>
                            <label class="mb-1 block text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">@col.Name</label>
                            <input type="text"
                                   inputmode="decimal"
                                   class="w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-right text-sm text-slate-800 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
                                   placeholder="0"
                                   value="@FormatAmount(GetFormPrice(columnId))"
                                   @onchange="e => OnPriceChanged(columnId, ParseAmount(e.Value?.ToString()))" />
                        </div>
                    }
                }
                else
                {
                    <div>
                        <label class="mb-1 block text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">@(IsTotalCostModel ? "Total kostnad" : "Pris")</label>
                        <input type="text"
                               inputmode="decimal"
                               class="w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-right text-sm text-slate-800 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
                               placeholder="0"
                               value="@FormatAmount(_editItem.Amount)"
                               @onchange="e => { _editItem.Amount = ParseAmount(e.Value?.ToString()); OnTotalChanged(); }" />
                    </div>
                }

                @* Mervärdeavdrag + jämförelsesumma används endast för Pris och kvalitet med jämförelsesumma. *@
                @if (UsesDeduction)
                {
                    <div>
                        <label class="mb-1 block text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Mervärdeavdrag %</label>
                        <input type="text"
                               inputmode="decimal"
                               class="w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-right text-sm text-slate-800 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
                               placeholder="0"
                               value="@FormatPercent(_editItem.DeductionPercent)"
                               @onchange="e => OnDeductionChanged(ParseAmount(e.Value?.ToString()))" />
                    </div>

                    <div>
                        <label class="mb-1 block text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Jämförelsesumma</label>
                        <input type="text"
                               inputmode="decimal"
                               class="w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-right text-sm text-slate-800 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
                               placeholder="0"
                               value="@FormatAmount(_editItem.ComparisonAmount)"
                               @onchange="e => OnComparisonChanged(ParseAmount(e.Value?.ToString()))" />
                    </div>
                }

                @* ── Beräknade summor (read-only) ── *@
                <div class="sm:col-span-2 flex flex-wrap items-center gap-x-6 gap-y-1 rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-xs dark:border-slate-700 dark:bg-slate-900/60">
                    @if (IsTotalCostModel)
                    {
                        <span class="text-slate-500 dark:text-slate-400">
                            Total kostnad:
                            <span class="ml-1 font-mono font-semibold text-sky-700 dark:text-sky-300">@FormatSwedishAmount(FormTotal)</span>
                        </span>
                    }
                    else
                    {
                        <span class="text-slate-500 dark:text-slate-400">
                            Anbudssumma:
                            <span class="ml-1 font-mono font-semibold text-slate-800 dark:text-slate-100">@FormatSwedishAmount(FormTotal)</span>
                        </span>
                        @if (ShowComparison)
                        {
                            <span class="text-slate-500 dark:text-slate-400">
                                Jämförelsesumma:
                                <span class="ml-1 font-mono font-semibold text-sky-700 dark:text-sky-300">@FormatSwedishAmount(_editItem.ComparisonAmount ?? FormTotal)</span>
                            </span>
                        }
                    }
                </div>
            }

            @* ── Tilldelad / Placering ── *@
            <div class="flex items-center gap-2">
                <input type="checkbox"
                       id="isAwarded"
                       class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-600 dark:bg-slate-800"
                       checked="@_editItem.IsAwarded"
                       disabled="@(_editItem.Status == BidStatus.Rejected)"
                       @onchange="OnAwardedChanged" />
                <label for="isAwarded" class="text-sm @(_editItem.Status == BidStatus.Rejected ? "text-slate-400 dark:text-slate-600" : "text-slate-700 dark:text-slate-200")">Tilldelad</label>
                @if (_editItem.Status == BidStatus.Rejected)
                {
                    <span class="text-[11px] text-slate-400 dark:text-slate-500">(förkastade anbud kan inte tilldelas)</span>
                }
            </div>

            @if (_editItem.Status == BidStatus.Valid)
            {
                <div>
                    <div class="mb-1 flex items-center justify-between gap-2">
                        <label class="block text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400"
                               title="Placering räknas automatiskt enligt vald metod men kan ändras manuellt vid behov.">Placering</label>
                        <span class="text-[10px] font-medium @(_editItem.IsPlacementManuallyOverridden ? "text-amber-600 dark:text-amber-400" : "text-slate-400 dark:text-slate-500")">
                            @(_editItem.IsPlacementManuallyOverridden ? "Manuell" : "Automatisk")
                        </span>
                    </div>
                    <input type="number"
                           min="1"
                           step="1"
                           class="w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-sm text-slate-800 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
                           placeholder="@(_editItem.AutoPlacement?.ToString() ?? "-")"
                           value="@_editItem.Placement"
                           @onchange="OnPlacementChanged" />
                    @if (_editItem.IsPlacementManuallyOverridden)
                    {
                        <button type="button"
                                class="mt-1 text-[11px] font-medium text-sky-600 hover:underline dark:text-sky-400"
                                @onclick="ResetAutomaticPlacement">
                            Återställ automatisk placering
                        </button>
                    }
                </div>
            }
        </div>

        <div>
            <label class="mb-1 block text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Anteckning</label>
            <textarea class="w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-sm text-slate-800 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
                      rows="2"
                      placeholder="Valfri anteckning..."
                      @bind="_editItem.Note"></textarea>
        </div>

        @if (!string.IsNullOrWhiteSpace(_formError))
        {
            <div class="rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-xs text-red-700 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-300">
                @_formError
            </div>
        }

        <div class="flex justify-end gap-2">
            <button type="button"
                    class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
                    disabled="@_isSaving"
                    @onclick="CancelEdit">
                Avbryt
            </button>
            <button type="button"
                    class="rounded-lg border border-emerald-300 bg-emerald-50 px-3 py-1.5 text-sm font-semibold text-emerald-700 transition hover:bg-emerald-100 disabled:cursor-not-allowed disabled:opacity-50 dark:border-emerald-900/60 dark:bg-emerald-950/30 dark:text-emerald-300"
                    disabled="@_isSaving"
                    @onclick="SaveBidAsync">
                @(_isSaving ? "Sparar..." : "Spara")
            </button>
        </div>
    </div>
}
else
{
    @* ── List view ───────────────────────────────────────── *@
    <div class="space-y-3">

        @* Utvärderingsmodell + toolbar *@
        <AuthorizeView Roles="@PMRolesConst.Tenant.AdminManger">
            <div class="space-y-2">
                @* Utvärderingsgrund *@
                <div class="flex flex-wrap items-center gap-2">
                    <span class="w-32 shrink-0 text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Utvärderingsgrund</span>
                    <div class="inline-flex overflow-hidden rounded-lg border border-slate-300 dark:border-slate-700">
                        <button type="button"
                                class="@(IsPriceQualityBasis ? "bg-sky-600 px-2.5 py-1 text-xs font-semibold text-white" : "px-2.5 py-1 text-xs font-medium text-slate-600 transition hover:bg-slate-50 dark:text-slate-300 dark:hover:bg-slate-800")"
                                disabled="@_isModelSaving"
                                @onclick="() => SetBasisAsync(BidEvaluationBasis.PriceQuality)">
                            Pris och kvalitet
                        </button>
                        <button type="button"
                                class="@(IsPriceBasis ? "border-l border-sky-700 bg-sky-600 px-2.5 py-1 text-xs font-semibold text-white" : "border-l border-slate-300 px-2.5 py-1 text-xs font-medium text-slate-600 transition hover:bg-slate-50 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800")"
                                disabled="@_isModelSaving"
                                @onclick="() => SetBasisAsync(BidEvaluationBasis.Price)">
                            Pris
                        </button>
                        <button type="button"
                                class="@(IsCostBasis ? "border-l border-sky-700 bg-sky-600 px-2.5 py-1 text-xs font-semibold text-white" : "border-l border-slate-300 px-2.5 py-1 text-xs font-medium text-slate-600 transition hover:bg-slate-50 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800")"
                                disabled="@_isModelSaving"
                                @onclick="() => SetBasisAsync(BidEvaluationBasis.Cost)">
                            Kostnad
                        </button>
                    </div>
                </div>

                @* Hjälptext: kort synlig text + info-ikon med längre förklaring *@
                <div class="text-[11px] leading-snug text-slate-500 dark:text-slate-400">
                    <HoverTooltip Text="@BasisLongHelp" ShowInfoIcon="true" Focusable="true">
                        <span>@BasisShortHelp</span>
                    </HoverTooltip>
                </div>

                @* Beräkningsmetod — beroende på vald utvärderingsgrund *@
                <div class="flex flex-wrap items-center gap-2">
                    <span class="w-32 shrink-0 text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Beräkningsmetod</span>
                    @if (IsPriceBasis)
                    {
                        <span class="inline-flex rounded-lg border border-sky-300 bg-sky-50 px-2.5 py-1 text-xs font-semibold text-sky-700 dark:border-sky-800 dark:bg-sky-950/40 dark:text-sky-300">Lägst anbudssumma</span>
                    }
                    else if (IsCostBasis)
                    {
                        <span class="inline-flex rounded-lg border border-sky-300 bg-sky-50 px-2.5 py-1 text-xs font-semibold text-sky-700 dark:border-sky-800 dark:bg-sky-950/40 dark:text-sky-300">Lägst total kostnad</span>
                    }
                    else
                    {
                        <div class="inline-flex overflow-hidden rounded-lg border border-slate-300 dark:border-slate-700">
                            <button type="button"
                                    class="@(IsLowestComparisonModel ? "bg-sky-600 px-2.5 py-1 text-xs font-semibold text-white" : "px-2.5 py-1 text-xs font-medium text-slate-600 transition hover:bg-slate-50 dark:text-slate-300 dark:hover:bg-slate-800")"
                                    disabled="@_isModelSaving"
                                    @onclick="() => SetMethodAsync(BidEvaluationModel.LowestComparison)">
                                Lägst jämförelsesumma med mervärdeavdrag
                            </button>
                            <button type="button"
                                    class="@(IsPointsModel ? "border-l border-sky-700 bg-sky-600 px-2.5 py-1 text-xs font-semibold text-white" : "border-l border-slate-300 px-2.5 py-1 text-xs font-medium text-slate-600 transition hover:bg-slate-50 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800")"
                                    disabled="@_isModelSaving"
                                    @onclick="() => SetMethodAsync(BidEvaluationModel.HighestPoints)">
                                Högst totalpoäng
                            </button>
                        </div>
                    }
                </div>

                @* Hjälptext: kort synlig text + info-ikon med längre förklaring *@
                <div class="text-[11px] leading-snug text-slate-500 dark:text-slate-400">
                    <HoverTooltip Text="@MethodLongHelp" ShowInfoIcon="true" Focusable="true">
                        <span>@MethodShortHelp</span>
                    </HoverTooltip>
                </div>

                @* Knappar *@
                <div class="flex items-center justify-between">
                    <button type="button"
                            class="@(_manageColumnsOpen ? "inline-flex h-8 items-center gap-1.5 rounded-lg border border-sky-300 bg-sky-50 px-2.5 text-xs font-semibold text-sky-700 transition dark:border-sky-800 dark:bg-sky-950/40 dark:text-sky-300" : "inline-flex h-8 items-center gap-1.5 rounded-lg border border-slate-300 bg-white px-2.5 text-xs font-semibold text-slate-600 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800")"
                            title="Hantera utvärderingsdelar för detta projekt"
                            @onclick="ToggleManageColumns">
                        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2" />
                        </svg>
                        <span>@PartsLabelPlural</span>
                        @if (HasColumns)
                        {
                            <span class="inline-flex h-4 min-w-4 items-center justify-center rounded-full bg-sky-600 px-1 text-[10px] font-bold leading-none text-white">@_columns.Count</span>
                        }
                    </button>
                    <button type="button"
                            class="inline-flex h-8 items-center gap-1.5 rounded-lg border border-emerald-400 bg-emerald-500 px-2.5 text-xs font-semibold text-white transition hover:bg-emerald-600 dark:border-emerald-600 dark:bg-emerald-600 dark:hover:bg-emerald-700"
                            @onclick="() => StartCreate()">
                        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                        </svg>
                        <span>Lägg till anbudsgivare</span>
                    </button>
                </div>
            </div>
        </AuthorizeView>

        @* ── Hantera utvärderingsdelar ── *@
        @if (_manageColumnsOpen)
        {
            <div class="rounded-xl border border-sky-200 bg-sky-50/50 p-3 dark:border-sky-900/60 dark:bg-sky-950/20">
                <div class="mb-2 flex items-center justify-between">
                    <h4 class="text-xs font-semibold text-slate-700 dark:text-slate-200">@PartsLabelPlural för detta projekt</h4>
                    <button type="button"
                            class="flex h-5 w-5 items-center justify-center rounded text-slate-400 hover:bg-slate-200/60 hover:text-slate-600 dark:hover:bg-slate-800"
                            title="Stäng"
                            @onclick="() => _manageColumnsOpen = false">
                        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                    </button>
                </div>

                <p class="mb-2 text-[11px] leading-snug text-slate-500 dark:text-slate-400">
                    @PartsHelpText
                </p>

                @* Lägg-till-rad ligger fast högst upp i sektionen *@
                <div class="mb-2 flex items-center gap-1.5">
                    <input type="text"
                           class="h-7 flex-1 rounded-lg border border-slate-300 bg-white px-2 text-xs text-slate-800 outline-none transition focus:border-sky-500 focus:ring-1 focus:ring-sky-500/30 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
                           placeholder="@($"Ny {PartsNoun}, t.ex. Del 1, Option 1...")"
                           @bind="_newColumnName"
                           @bind:event="oninput" />
                    <button type="button"
                            class="inline-flex h-7 items-center gap-1 rounded-lg border border-emerald-300 bg-emerald-50 px-2 text-xs font-semibold text-emerald-700 transition hover:bg-emerald-100 disabled:cursor-not-allowed disabled:opacity-50 dark:border-emerald-900/60 dark:bg-emerald-950/30 dark:text-emerald-300"
                            disabled="@(_isColumnSaving || string.IsNullOrWhiteSpace(_newColumnName))"
                            @onclick="CreateColumnAsync">
                        @AddPartLabel
                    </button>
                </div>

                @* Nya utvärderingsdelar visas i listan under lägg-till-raden *@
                @if (HasColumns)
                {
                    <div class="space-y-1.5">
                        @foreach (var col in _columns)
                        {
                            var column = col;
                            var columnIndex = _columns.IndexOf(col);
                            <div class="flex items-center gap-1.5">
                                <input type="text"
                                       class="h-7 flex-1 rounded-lg border border-slate-300 bg-white px-2 text-xs text-slate-800 outline-none transition focus:border-sky-500 focus:ring-1 focus:ring-sky-500/30 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
                                       value="@GetColumnEditName(column.Id)"
                                       @onchange="e => _columnNameEdits[column.Id] = e.Value?.ToString() ?? string.Empty" />
                                <button type="button"
                                        class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-lg border border-slate-300 bg-white text-slate-500 transition hover:text-emerald-600 disabled:cursor-not-allowed disabled:opacity-40 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-400"
                                        title="Spara ändring"
                                        disabled="@(_isColumnSaving || !IsColumnChanged(column))"
                                        @onclick="() => RenameColumnAsync(column)">
                                    <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
                                </button>
                                <button type="button"
                                        class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-lg border border-slate-300 bg-white text-slate-500 transition hover:text-sky-600 disabled:cursor-not-allowed disabled:opacity-40 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-400"
                                        title="Flytta upp"
                                        disabled="@(_isColumnSaving || columnIndex == 0)"
                                        @onclick="() => MoveColumnAsync(column, -1)">
                                    <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" /></svg>
                                </button>
                                <button type="button"
                                        class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-lg border border-slate-300 bg-white text-slate-500 transition hover:text-sky-600 disabled:cursor-not-allowed disabled:opacity-40 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-400"
                                        title="Flytta ner"
                                        disabled="@(_isColumnSaving || columnIndex == _columns.Count - 1)"
                                        @onclick="() => MoveColumnAsync(column, 1)">
                                    <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                                </button>
                                <button type="button"
                                        class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-lg border border-slate-300 bg-white text-slate-500 transition hover:border-red-400 hover:text-red-600 disabled:cursor-not-allowed disabled:opacity-40 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-400"
                                        title="Ta bort utvärderingsdel"
                                        disabled="@_isColumnSaving"
                                        @onclick="() => DeleteColumnAsync(column)">
                                    <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                </button>
                            </div>
                        }
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(_columnError))
                {
                    <p class="mt-1.5 text-[11px] text-red-600 dark:text-red-400">@_columnError</p>
                }
            </div>
        }

        @* ── Laddningsfel ── *@
        @if (_loadFailed)
        {
            <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-6 text-center dark:border-red-900/60 dark:bg-red-950/30">
                <p class="text-sm font-medium text-red-700 dark:text-red-300">Anbuden kunde inte hämtas.</p>
                <p class="mt-0.5 text-xs text-red-600/80 dark:text-red-400/80">Kontrollera anslutningen och försök igen.</p>
                <button type="button"
                        class="mt-3 inline-flex items-center gap-1.5 rounded-lg border border-red-300 bg-white px-3 py-1.5 text-sm font-semibold text-red-700 transition hover:bg-red-50 dark:border-red-800 dark:bg-slate-900 dark:text-red-300"
                        @onclick="LoadAsync">
                    Försök igen
                </button>
            </div>
        }
        else if (_bids.Any())
        {
            <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">
                <table class="min-w-full text-xs">
                    <thead class="bg-slate-50 dark:bg-slate-800">
                        <tr class="border-b border-slate-200 dark:border-slate-700">
                            <th class="px-3 py-2 text-left text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Anbudsgivare</th>
                            <th class="px-3 py-2 text-center text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Status</th>

                            @if (IsPointsModel)
                            {
                                @* Pris och kvalitet + Högst totalpoäng: poängdelar + Totalpoäng. *@
                                @if (HasColumns)
                                {
                                    @foreach (var col in _columns)
                                    {
                                        <th class="px-3 py-2 text-right text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400" title="@col.Name">@col.Name</th>
                                    }
                                }
                                <th class="px-3 py-2 text-right text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Totalpoäng</th>
                            }
                            else if (IsTotalCostModel)
                            {
                                @* Kostnad + Lägst total kostnad: kostnadsdelar + Total kostnad (ingen anbudssumma/mervärdeavdrag/jämförelsesumma). *@
                                @if (HasColumns)
                                {
                                    @foreach (var col in _columns)
                                    {
                                        <th class="px-3 py-2 text-right text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400" title="@col.Name">@col.Name</th>
                                    }
                                }
                                <th class="px-3 py-2 text-right text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Total kostnad</th>
                            }
                            else
                            {
                                @* Pris / Pris och kvalitet + Lägst jämförelsesumma: prisdelar + Anbudssumma (+ Mervärdeavdrag) + Jämförelsesumma. *@
                                @if (HasColumns)
                                {
                                    @foreach (var col in _columns)
                                    {
                                        <th class="px-3 py-2 text-right text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400" title="@col.Name">@col.Name</th>
                                    }
                                }
                                else
                                {
                                    <th class="px-3 py-2 text-right text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Pris</th>
                                }
                                <th class="px-3 py-2 text-right text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Anbudssumma</th>
                                @if (UsesDeduction)
                                {
                                    <th class="px-3 py-2 text-right text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400" title="Mervärdeavdrag i procent">Mervärdeavdrag %</th>
                                }
                                @if (ShowComparison)
                                {
                                    <th class="px-3 py-2 text-right text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400" title="Anbudssumma minus mervärdeavdrag">Jämförelsesumma</th>
                                }
                            }

                            <th class="px-3 py-2 text-center text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Tilldelad</th>
                            <th class="px-3 py-2 text-center text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400"
                                title="Placering räknas automatiskt enligt vald metod men kan ändras manuellt vid behov.">Placering</th>
                            <th class="px-3 py-2 text-left text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Anteckning</th>
                            <th class="px-3 py-2"></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                        @foreach (var bid in _bids)
                        {
                            var isRejected = bid.Status == BidStatus.Rejected;
                            var isBest = !isRejected && IsBestBid(bid);
                            <tr class="@(isRejected ? "bg-slate-50/60 text-slate-400 dark:bg-slate-950/40" : "transition-colors hover:bg-slate-50 dark:hover:bg-slate-800/60") @(isBest ? "bg-emerald-50/60 dark:bg-emerald-950/20" : "")">
                                <td class="px-3 py-2 font-medium @(isRejected ? "text-slate-400 dark:text-slate-500" : "text-slate-800 dark:text-slate-100")">
                                    @bid.BidderName
                                    @if (isBest)
                                    {
                                        <span class="ml-1.5 inline-flex rounded-full bg-emerald-100 px-1.5 py-0.5 text-[10px] font-semibold text-emerald-700 dark:bg-emerald-950/50 dark:text-emerald-300">Bäst</span>
                                    }
                                </td>
                                <td class="px-3 py-2 text-center">
                                    @if (isRejected)
                                    {
                                        <span class="inline-flex rounded-full bg-red-100 px-1.5 py-0.5 text-[10px] font-semibold text-red-700 dark:bg-red-950/50 dark:text-red-300" title="@bid.RejectionReason">Förkastat</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex rounded-full bg-slate-100 px-1.5 py-0.5 text-[10px] font-semibold text-slate-600 dark:bg-slate-800 dark:text-slate-300">Giltigt</span>
                                    }
                                </td>

                                @if (IsPointsModel)
                                {
                                    @if (HasColumns)
                                    {
                                        @foreach (var col in _columns)
                                        {
                                            var value = GetBidPartValue(bid, col.Id);
                                            <td class="px-3 py-2 text-right font-mono text-slate-600 dark:text-slate-300">
                                                @(value.HasValue ? FormatPoints(value.Value) : "-")
                                            </td>
                                        }
                                    }
                                    <td class="px-3 py-2 text-right font-mono font-semibold text-sky-700 dark:text-sky-300">
                                        @(bid.TotalPoints.HasValue ? FormatPoints(bid.TotalPoints.Value) : "-")
                                    </td>
                                }
                                else if (IsTotalCostModel)
                                {
                                    @if (HasColumns)
                                    {
                                        @foreach (var col in _columns)
                                        {
                                            var value = GetBidPartValue(bid, col.Id);
                                            <td class="px-3 py-2 text-right font-mono text-slate-600 dark:text-slate-300">
                                                @(value.HasValue ? FormatSwedishAmount(value.Value) : "-")
                                            </td>
                                        }
                                    }
                                    <td class="px-3 py-2 text-right font-mono font-semibold @(isRejected ? "text-slate-400 dark:text-slate-500" : "text-sky-700 dark:text-sky-300")">
                                        @(bid.Amount.HasValue ? FormatSwedishAmount(bid.Amount.Value) : "-")
                                    </td>
                                }
                                else
                                {
                                    @if (HasColumns)
                                    {
                                        @foreach (var col in _columns)
                                        {
                                            var value = GetBidPartValue(bid, col.Id);
                                            <td class="px-3 py-2 text-right font-mono text-slate-600 dark:text-slate-300">
                                                @(value.HasValue ? FormatSwedishAmount(value.Value) : "-")
                                            </td>
                                        }
                                    }
                                    else
                                    {
                                        <td class="px-3 py-2 text-right font-mono text-slate-600 dark:text-slate-300">
                                            @(bid.Amount.HasValue ? FormatSwedishAmount(bid.Amount.Value) : "-")
                                        </td>
                                    }
                                    <td class="px-3 py-2 text-right font-mono font-semibold @(isRejected ? "text-slate-400 dark:text-slate-500" : "text-slate-800 dark:text-slate-100")">
                                        @(bid.Amount.HasValue ? FormatSwedishAmount(bid.Amount.Value) : "-")
                                    </td>
                                    @if (UsesDeduction)
                                    {
                                        <td class="px-3 py-2 text-right font-mono text-slate-600 dark:text-slate-300">
                                            @((bid.DeductionPercent ?? 0) > 0 ? $"{FormatPercent(bid.DeductionPercent)} %" : "-")
                                        </td>
                                    }
                                    @if (ShowComparison)
                                    {
                                        <td class="px-3 py-2 text-right font-mono font-semibold @(isRejected ? "text-slate-400 dark:text-slate-500" : "text-sky-700 dark:text-sky-300")">
                                            @(bid.ComparisonAmount.HasValue ? FormatSwedishAmount(bid.ComparisonAmount.Value) : "-")
                                        </td>
                                    }
                                }

                                <td class="px-3 py-2 text-center">
                                    @if (bid.IsAwarded)
                                    {
                                        <svg class="mx-auto h-4 w-4 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                                        </svg>
                                    }
                                </td>
                                <td class="px-3 py-2 text-center text-slate-600 dark:text-slate-300">
                                    <span class="font-mono">@(bid.Placement?.ToString() ?? "-")</span>
                                    @if (bid.IsPlacementManuallyOverridden)
                                    {
                                        <span class="ml-1 text-[10px] font-medium text-amber-600 dark:text-amber-400" title="Manuell placering">Manuell</span>
                                    }
                                </td>
                                <td class="max-w-[200px] truncate px-3 py-2 text-slate-500 dark:text-slate-400" title="@bid.Note">
                                    @(string.IsNullOrWhiteSpace(bid.Note) ? "-" : bid.Note)
                                </td>
                                <td class="px-3 py-2 text-right">
                                    <AuthorizeView Roles="@PMRolesConst.Tenant.AdminManger">
                                        <div class="flex items-center justify-end gap-1">
                                            <button type="button"
                                                    class="inline-flex h-6 w-6 items-center justify-center rounded border border-slate-300 text-slate-500 transition hover:border-sky-400 hover:text-sky-600 dark:border-slate-700 dark:text-slate-400 dark:hover:border-sky-600 dark:hover:text-sky-400"
                                                    title="Redigera"
                                                    @onclick="() => StartEdit(bid)">
                                                <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                                </svg>
                                            </button>
                                            <button type="button"
                                                    class="inline-flex h-6 w-6 items-center justify-center rounded border border-slate-300 text-slate-500 transition hover:border-red-400 hover:text-red-600 dark:border-slate-700 dark:text-slate-400 dark:hover:border-red-600 dark:hover:text-red-400"
                                                    title="Ta bort"
                                                    @onclick="() => DeleteBidAsync(bid)">
                                                <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                </svg>
                                            </button>
                                        </div>
                                    </AuthorizeView>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* Summary *@
            <div class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-xs text-slate-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300">
                <span class="font-semibold">@_bids.Count anbudsgivare</span>
                @if (_rejectedCount > 0)
                {
                    <span class="ml-2 text-red-600 dark:text-red-400">· @_rejectedCount förkastat</span>
                }
                @if (IsPointsModel)
                {
                    var scored = _bids.Where(b => b.IsValid && b.TotalPoints.HasValue).ToList();
                    @if (scored.Any())
                    {
                        <span class="ml-3">Högsta totalpoäng: <span class="font-mono font-semibold text-sky-700 dark:text-sky-300">@FormatPoints(scored.Max(b => b.TotalPoints!.Value))</span></span>
                        <span class="ml-3">Lägsta totalpoäng: <span class="font-mono">@FormatPoints(scored.Min(b => b.TotalPoints!.Value))</span></span>
                    }
                }
                else if (IsTotalCostModel)
                {
                    var valid = _bids.Where(b => b.IsValid && b.Amount.HasValue).ToList();
                    @if (valid.Any())
                    {
                        <span class="ml-3">Lägsta total kostnad: <span class="font-mono font-semibold text-sky-700 dark:text-sky-300">@FormatSwedishAmount(valid.Min(b => b.Amount!.Value))</span></span>
                        <span class="ml-3">Högsta total kostnad: <span class="font-mono">@FormatSwedishAmount(valid.Max(b => b.Amount!.Value))</span></span>
                    }
                }
                else if (ShowComparison)
                {
                    var valid = _bids.Where(b => b.IsValid && b.ComparisonAmount.HasValue).ToList();
                    @if (valid.Any())
                    {
                        <span class="ml-3">Lägsta jämförelsesumma: <span class="font-mono font-semibold text-sky-700 dark:text-sky-300">@FormatSwedishAmount(valid.Min(b => b.ComparisonAmount!.Value))</span></span>
                        <span class="ml-3">Högsta jämförelsesumma: <span class="font-mono">@FormatSwedishAmount(valid.Max(b => b.ComparisonAmount!.Value))</span></span>
                    }
                }
                else
                {
                    var valid = _bids.Where(b => b.IsValid && b.Amount.HasValue).ToList();
                    @if (valid.Any())
                    {
                        <span class="ml-3">Lägsta anbudssumma: <span class="font-mono font-semibold text-sky-700 dark:text-sky-300">@FormatSwedishAmount(valid.Min(b => b.Amount!.Value))</span></span>
                        <span class="ml-3">Högsta anbudssumma: <span class="font-mono">@FormatSwedishAmount(valid.Max(b => b.Amount!.Value))</span></span>
                    }
                }
            </div>
        }
        else if (_isLoading)
        {
            <div class="py-6 text-center text-sm text-slate-500 dark:text-slate-400">Laddar...</div>
        }
        else
        {
            <div class="rounded-xl border border-dashed border-slate-300 bg-slate-50 px-4 py-8 text-center dark:border-slate-700 dark:bg-slate-950/60">
                <p class="text-sm text-slate-500 dark:text-slate-400">Inga anbudsgivare registrerade ännu.</p>
                <AuthorizeView Roles="@PMRolesConst.Tenant.AdminManger">
                    <button type="button"
                            class="mt-3 inline-flex items-center gap-1.5 rounded-lg border border-emerald-300 bg-emerald-50 px-3 py-1.5 text-sm font-semibold text-emerald-700 transition hover:bg-emerald-100 dark:border-emerald-900/60 dark:bg-emerald-950/30 dark:text-emerald-300 dark:hover:bg-emerald-950/50"
                            @onclick="() => StartCreate()">
                        + Lägg till anbudsgivare
                    </button>
                </AuthorizeView>
            </div>
        }

    </div>
}

@code {
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public string ProjectName { get; set; } = string.Empty;

    private List<ProjectBidListDTO> _bids = [];
    private List<ProjectBidPriceColumnDTO> _columns = [];
    private BidEvaluationModel _evaluationModel = BidEvaluationModel.LowestComparison;
    private BidEvaluationBasis _evaluationBasis = BidEvaluationBasis.Price;
    private ProjectBidFormModel? _editItem;
    private bool _isSaving;
    private bool _isLoading;
    private bool _loadFailed;
    private bool _formTouched;
    private string _formError = string.Empty;
    private int _rejectedCount;

    private bool _manageColumnsOpen;
    private bool _isColumnSaving;
    private bool _isModelSaving;
    private string _newColumnName = string.Empty;
    private string _columnError = string.Empty;
    private readonly Dictionary<int, string> _columnNameEdits = new();

    private bool HasColumns => _columns.Count > 0;
    private bool IsPointsModel => _evaluationModel == BidEvaluationModel.HighestPoints;
    private bool IsLowestComparisonModel => _evaluationModel == BidEvaluationModel.LowestComparison;
    private bool IsTotalCostModel => _evaluationModel == BidEvaluationModel.LowestTotalCost;

    private bool IsPriceBasis => _evaluationBasis == BidEvaluationBasis.Price;
    private bool IsCostBasis => _evaluationBasis == BidEvaluationBasis.Cost;
    private bool IsPriceQualityBasis => _evaluationBasis == BidEvaluationBasis.PriceQuality;

    // Mervärdeavdrag only applies to "Pris och kvalitet" with the comparison-sum method.
    private bool UsesDeduction => IsPriceQualityBasis && IsLowestComparisonModel;

    // Ren prismodell (utvärderingsgrund Pris) visar bara anbudssumma — jämförelsesumma och
    // mervärdeavdrag hör till "Pris och kvalitet". Sant endast när jämförelsesumman är relevant.
    private bool ShowComparison => UsesDeduction;

    // Dynamiskt namn på utvärderingsdelar beroende på vald grund/metod.
    private string PartsNoun => IsPointsModel ? "poängdel" : IsCostBasis ? "kostnadsdel" : "prisdel";
    private string PartsLabelPlural => IsPointsModel ? "Poängdelar" : IsCostBasis ? "Kostnadsdelar" : "Prisdelar";
    private string AddPartLabel => IsPointsModel ? "Lägg till poängdel" : IsCostBasis ? "Lägg till kostnadsdel" : "Lägg till prisdel";

    // Hjälptexter: kort synlig text + längre förklaring (visas via info-ikon/tooltip).
    private string BasisShortHelp => _evaluationBasis switch
    {
        BidEvaluationBasis.PriceQuality => "Både pris och kvalitet påverkar resultatet.",
        BidEvaluationBasis.Cost => "Anbuden jämförs utifrån total kostnad.",
        _ => "Anbuden jämförs utifrån pris."
    };

    private string BasisLongHelp => _evaluationBasis switch
    {
        BidEvaluationBasis.PriceQuality => "Används när anbuden bedöms utifrån bästa förhållandet mellan pris och kvalitet. Kvalitet kan hanteras genom mervärdeavdrag eller poäng.",
        BidEvaluationBasis.Cost => "Används när anbuden jämförs utifrån total kostnad, inte bara pris. Kostnadsdelar kan till exempel vara inköpspris, drift, service, underhåll eller livscykelkostnad. Lägst total kostnad får bäst placering.",
        _ => "Används när anbuden jämförs utifrån pris. Prisdelar summeras till anbudssumma och lägst anbudssumma får bäst placering."
    };

    private string MethodShortHelp =>
        IsCostBasis ? "Kostnadsdelar summeras."
        : IsPointsModel ? "Poängdelar summeras till totalpoäng."
        : UsesDeduction ? "Mervärde räknas av från anbudssumman."
        : "Prisdelar summeras.";

    private string MethodLongHelp =>
        IsCostBasis ? "Alla kostnadsdelar summeras till total kostnad. Lägst total kostnad får bäst placering."
        : IsPointsModel ? "Används när pris och kvalitet omvandlas till poäng, till exempel Pris 30 poäng och Kvalitet 70 poäng. Högst totalpoäng får bäst placering."
        : UsesDeduction ? "Prisdelar summeras till anbudssumma. Mervärdeavdrag räknas av och ger en jämförelsesumma. Lägst jämförelsesumma får bäst placering. Exempel: 1 000 000 kr med 30 % mervärdeavdrag ger 700 000 kr i jämförelsesumma."
        : "Alla prisdelar summeras till anbudssumma. Lägst anbudssumma får bäst placering.";

    // Anpassad hjälptext för "hantera utvärderingsdelar" beroende på vald grund/metod.
    private string PartsHelpText =>
        IsCostBasis ? "Standard är att endast en kostnadsdel utvärderas. Lägg till kostnadsdelar om anbudet består av flera kostnader som ska summeras, till exempel inköpspris, drift, service, underhåll eller livscykelkostnad."
        : IsPointsModel ? "Standard är att endast en poängdel utvärderas. Lägg till poängdelar om anbudet ska bedömas i flera delar, till exempel Pris, Kvalitet, Miljö, Leveranstid eller Service."
        : UsesDeduction ? "Standard är att endast en prisdel utvärderas. Lägg till prisdelar om anbudet består av flera delar som ska summeras. Mervärdeavdrag kan sedan räknas av från anbudssumman."
        : "Standard är att endast en prisdel utvärderas. Lägg till prisdelar om anbudet består av flera delar som ska summeras, till exempel Del 1, Del 2, Option 1 eller Option 2.";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _loadFailed = false;
        StateHasChanged();
        try
        {
            var view = await Repo.ProjectBid.GetViewAsync(ProjectId) ?? new ProjectBidsViewDTO();
            _columns = view.PriceColumns;
            _bids = view.Bids;
            _evaluationModel = view.EvaluationModel;
            _evaluationBasis = view.EvaluationBasis;
            _rejectedCount = _bids.Count(b => b.Status == BidStatus.Rejected);
            _columnNameEdits.Clear();
        }
        catch (Exception ex)
        {
            _loadFailed = true;
            _bids = [];
            _columns = [];
            await ClientLog.ErrorAsync($"Failed to load project bids for project {ProjectId}.", ex: ex);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    // Selecting an evaluation basis (Pris/Kostnad/Pris och kvalitet) picks a sensible
    // default method for that basis. The method picker is only shown for Pris och kvalitet.
    private async Task SetBasisAsync(BidEvaluationBasis basis)
    {
        var method = basis switch
        {
            BidEvaluationBasis.Price => BidEvaluationModel.LowestComparison,
            BidEvaluationBasis.Cost => BidEvaluationModel.LowestTotalCost,
            // Keep the current method if it is valid for Pris och kvalitet, otherwise default.
            BidEvaluationBasis.PriceQuality => _evaluationModel == BidEvaluationModel.HighestPoints
                ? BidEvaluationModel.HighestPoints
                : BidEvaluationModel.LowestComparison,
            _ => BidEvaluationModel.LowestComparison
        };

        await SetEvaluationAsync(basis, method);
    }

    private Task SetMethodAsync(BidEvaluationModel method) =>
        SetEvaluationAsync(_evaluationBasis, method);

    private async Task SetEvaluationAsync(BidEvaluationBasis basis, BidEvaluationModel method)
    {
        if ((basis == _evaluationBasis && method == _evaluationModel) || _isModelSaving)
            return;

        _isModelSaving = true;
        try
        {
            var ok = await Repo.ProjectBid.SetEvaluationAsync(ProjectId, basis, method);
            if (ok)
            {
                await LoadAsync();
            }
            else
            {
                MHD.Notifications(ToastType.Update, false);
            }
        }
        catch (Exception ex)
        {
            MHD.Notifications(ToastType.Update, false);
            await ClientLog.ErrorAsync($"Failed to set bid evaluation for project {ProjectId}.", ex: ex);
        }
        finally
        {
            _isModelSaving = false;
        }
    }

    // ── Best-bid highlight ──────────────────────────────────
    private bool IsBestBid(ProjectBidListDTO bid)
    {
        if (!bid.IsValid)
            return false;

        if (IsPointsModel)
        {
            var scored = _bids.Where(b => b.IsValid && b.TotalPoints.HasValue).ToList();
            return bid.TotalPoints.HasValue && scored.Count > 0 && bid.TotalPoints.Value == scored.Max(b => b.TotalPoints!.Value);
        }

        if (IsTotalCostModel)
        {
            var priced = _bids.Where(b => b.IsValid && b.Amount.HasValue).ToList();
            return bid.Amount.HasValue && priced.Count > 0 && bid.Amount.Value == priced.Min(b => b.Amount!.Value);
        }

        var valid = _bids.Where(b => b.IsValid && b.ComparisonAmount.HasValue).ToList();
        return bid.ComparisonAmount.HasValue && valid.Count > 0 && bid.ComparisonAmount.Value == valid.Min(b => b.ComparisonAmount!.Value);
    }

    // ── Per-part value (with legacy fallback) ───────────────
    // Bids saved before evaluation parts existed only have a total Amount.
    // They are shown in the first price part so no data is hidden.
    private decimal? GetBidPartValue(ProjectBidListDTO bid, int columnId)
    {
        if (bid.Prices.TryGetValue(columnId, out var value))
            return value;

        if (bid.Prices.Count == 0 && bid.Amount.HasValue &&
            _columns.Count > 0 && _columns[0].Id == columnId)
            return bid.Amount;

        return null;
    }

    // ── Bid form ────────────────────────────────────────────

    private void StartCreate()
    {
        _editItem = new ProjectBidFormModel();
        _formTouched = false;
        _formError = string.Empty;
        _manageColumnsOpen = false;
    }

    private void StartEdit(ProjectBidListDTO bid)
    {
        var model = new ProjectBidFormModel
        {
            Id = bid.Id,
            BidderName = bid.BidderName,
            // Enkel-fältet (Pris/Poäng) saknar egna delar. I poängmodellen ligger värdet
            // i Totalpoäng (Amount returneras som null för poäng), annars i Amount.
            Amount = !HasColumns && IsPointsModel ? bid.TotalPoints : bid.Amount,
            DeductionPercent = bid.DeductionPercent,
            ComparisonAmount = bid.ComparisonAmount,
            Note = bid.Note,
            IsAwarded = bid.IsAwarded,
            Placement = bid.Placement,
            AutoPlacement = bid.AutoPlacement,
            IsPlacementManuallyOverridden = bid.IsPlacementManuallyOverridden,
            Status = bid.Status,
            RejectionReason = bid.RejectionReason,
            LastEdited = ComparisonField.Deduction
        };

        foreach (var (columnId, value) in bid.Prices)
            model.Prices[columnId] = value;

        // Legacy bid in a project that now has evaluation parts: prefill the first part
        // from the effective single value (Totalpoäng i poängmodellen, annars Amount).
        var legacySingle = IsPointsModel ? bid.TotalPoints : bid.Amount;
        if (HasColumns && model.Prices.Count == 0 && legacySingle.HasValue)
            model.Prices[_columns[0].Id] = legacySingle.Value;

        _editItem = model;
        _formTouched = false;
        _formError = string.Empty;
        _manageColumnsOpen = false;
    }

    private void CancelEdit()
    {
        _editItem = null;
        _formError = string.Empty;
    }

    private decimal? GetFormPrice(int columnId) =>
        _editItem is not null && _editItem.Prices.TryGetValue(columnId, out var value) ? value : null;

    private void SetFormPrice(int columnId, decimal? value)
    {
        if (_editItem is null)
            return;

        if (value.HasValue)
            _editItem.Prices[columnId] = value.Value;
        else
            _editItem.Prices.Remove(columnId);
    }

    private void OnPriceChanged(int columnId, decimal? value)
    {
        SetFormPrice(columnId, value);
        OnTotalChanged();
    }

    /// <summary>
    /// Summan av utvärderingsdelarna (eller legacy-/enkelbeloppet när inga delar finns).
    /// Modellen avgör om summan tolkas som anbudssumma eller totalpoäng.
    /// </summary>
    private decimal FormPartsSum =>
        _editItem is null
            ? 0
            : HasColumns
                ? _columns.Sum(c => _editItem.Prices.TryGetValue(c.Id, out var v) ? v : 0)
                : _editItem.Amount ?? 0;

    /// <summary>Anbudssumma (prismodell).</summary>
    private decimal FormTotal => FormPartsSum;

    /// <summary>Totalpoäng (poängmodell).</summary>
    private decimal FormPointsTotal => FormPartsSum;

    // ── Jämförelsesumma ⇄ Mervärdeavdrag (båda hållen) ──────
    // Senast ändrat fält styr beräkningen.

    private void OnDeductionChanged(decimal? value)
    {
        if (_editItem is null)
            return;

        _editItem.DeductionPercent = value;
        _editItem.LastEdited = ComparisonField.Deduction;
        RecomputeComparisonFromDeduction();
    }

    private void OnComparisonChanged(decimal? value)
    {
        if (_editItem is null)
            return;

        _editItem.ComparisonAmount = value;
        _editItem.LastEdited = ComparisonField.Comparison;
        RecomputeDeductionFromComparison();
    }

    private void OnTotalChanged()
    {
        if (_editItem is null)
            return;

        // Anbudssumma ändrades → räkna om beroende på senast använda beräkningssätt.
        if (_editItem.LastEdited == ComparisonField.Comparison)
            RecomputeDeductionFromComparison();
        else
            RecomputeComparisonFromDeduction();
    }

    private void RecomputeComparisonFromDeduction()
    {
        if (_editItem is null)
            return;

        var total = FormTotal;
        var deduction = Math.Clamp(_editItem.DeductionPercent ?? 0, 0, 100);
        _editItem.ComparisonAmount = total - total * deduction / 100m;
    }

    private void RecomputeDeductionFromComparison()
    {
        if (_editItem is null)
            return;

        var total = FormTotal;
        var comparison = _editItem.ComparisonAmount ?? 0;

        if (total > 0)
            _editItem.DeductionPercent = Math.Round((1 - comparison / total) * 100m, 2);
        else
            _editItem.DeductionPercent = 0;
    }

    // ── Status / Tilldelad ──────────────────────────────────

    private void OnStatusChanged(ChangeEventArgs e)
    {
        if (_editItem is null)
            return;

        _editItem.Status = Enum.TryParse<BidStatus>(e.Value?.ToString(), out var status) ? status : BidStatus.Valid;

        if (_editItem.Status == BidStatus.Rejected)
        {
            // Förkastade anbud kan inte vara tilldelade.
            _editItem.IsAwarded = false;
            _editItem.Placement = null;
            _editItem.IsPlacementManuallyOverridden = false;
        }
        else
        {
            _editItem.RejectionReason = null;
        }
    }

    private void OnAwardedChanged(ChangeEventArgs e)
    {
        if (_editItem is null)
            return;

        var awarded = e.Value is bool b && b;

        if (awarded && _editItem.Status == BidStatus.Rejected)
        {
            // Blockera tilldelning av förkastat anbud.
            _editItem.IsAwarded = false;
            _formError = "Förkastade anbud kan inte markeras som tilldelade. Ändra status till Giltigt först.";
            return;
        }

        _editItem.IsAwarded = awarded;
        _formError = string.Empty;

    }

    private void OnPlacementChanged(ChangeEventArgs e)
    {
        if (_editItem is null)
            return;

        _editItem.Placement = int.TryParse(e.Value?.ToString(), out var placement) && placement > 0
            ? placement
            : null;
        _editItem.IsPlacementManuallyOverridden = _editItem.Placement.HasValue;
    }

    private void ResetAutomaticPlacement()
    {
        if (_editItem is null)
            return;

        _editItem.Placement = null;
        _editItem.IsPlacementManuallyOverridden = false;
    }

    private async Task SaveBidAsync()
    {
        if (_editItem is null)
            return;

        _formTouched = true;

        if (string.IsNullOrWhiteSpace(_editItem.BidderName))
            return;

        // ── Validering ──
        if (_editItem.Prices.Values.Any(v => v < 0) || _editItem.Amount is < 0)
        {
            _formError = "Värden får inte vara negativa.";
            return;
        }

        if (_editItem.Status == BidStatus.Rejected && _editItem.IsAwarded)
        {
            _formError = "Förkastade anbud kan inte vara tilldelade.";
            return;
        }

        if (!IsPointsModel)
        {
            if (_editItem.DeductionPercent is < 0 or > 100)
            {
                _formError = "Mervärdeavdrag måste vara mellan 0 och 100 %.";
                return;
            }

            var total = FormTotal;
            var comparison = _editItem.ComparisonAmount ?? total;

            if (comparison < 0)
            {
                _formError = "Jämförelsesumman får inte vara negativ.";
                return;
            }

            if (comparison > total && total > 0)
            {
                _formError = "Jämförelsesumman får inte vara större än anbudssumman vid ett avdrag.";
                return;
            }
        }

        if (_editItem.IsPlacementManuallyOverridden && _editItem.Placement is < 1)
        {
            _formError = "Placering måste vara ett positivt heltal.";
            return;
        }

        _isSaving = true;
        _formError = string.Empty;

        try
        {
            var isAwarded = _editItem.IsAwarded && _editItem.Status == BidStatus.Valid;
            var dto = new ProjectBidPostDTO
            {
                BidderName = _editItem.BidderName.Trim(),
                // Utan utvärderingsdelar skickas det enkla beloppet (Pris/Poäng).
                // Med delar härleder servern summan av delarna utifrån modellen.
                Amount = HasColumns ? null : _editItem.Amount,
                Prices = HasColumns ? new Dictionary<int, decimal>(_editItem.Prices) : null,
                // Mervärdeavdrag används bara i prismodellen.
                DeductionPercent = IsPointsModel || _editItem.DeductionPercent is null or 0 ? null : _editItem.DeductionPercent,
                Note = string.IsNullOrWhiteSpace(_editItem.Note) ? null : _editItem.Note.Trim(),
                IsAwarded = isAwarded,
                Placement = _editItem.IsPlacementManuallyOverridden ? _editItem.Placement : null,
                IsPlacementManuallyOverridden = _editItem.IsPlacementManuallyOverridden,
                Status = _editItem.Status,
                RejectionReason = _editItem.Status == BidStatus.Rejected && !string.IsNullOrWhiteSpace(_editItem.RejectionReason)
                    ? _editItem.RejectionReason.Trim()
                    : null
            };

            bool success;
            if (_editItem.Id == 0)
            {
                var newId = await Repo.ProjectBid.CreateAsync(ProjectId, dto);
                success = newId > 0;
            }
            else
            {
                success = await Repo.ProjectBid.UpdateAsync(_editItem.Id, ProjectId, dto);
            }

            if (success)
            {
                _editItem = null;
                await LoadAsync();
                MHD.Notifications(ToastType.Update, true);
            }
            else
            {
                _formError = "Anbudsgivaren kunde inte sparas. Kontrollera uppgifterna och försök igen.";
                MHD.Notifications(ToastType.Update, false);
            }
        }
        catch (Exception ex)
        {
            _formError = "Anbudsgivaren kunde inte sparas just nu. Försök igen om en stund.";
            await ClientLog.ErrorAsync($"Failed to save project bid for project {ProjectId}.", ex: ex);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task DeleteBidAsync(ProjectBidListDTO bid)
    {
        MHD.DeleteMessage(bid.BidderName, EventCallback.Factory.Create(this, async () =>
        {
            var ok = await Repo.ProjectBid.DeleteAsync(bid.Id, ProjectId);
            if (ok)
            {
                _bids.Remove(bid);
                _rejectedCount = _bids.Count(b => b.Status == BidStatus.Rejected);
            }
            MHD.Notifications(ToastType.Delete, ok);
            StateHasChanged();
        }));
    }

    // ── Evaluation-part management ──────────────────────────

    private void ToggleManageColumns()
    {
        _manageColumnsOpen = !_manageColumnsOpen;
        _columnError = string.Empty;
        _newColumnName = string.Empty;
    }

    private string GetColumnEditName(int columnId) =>
        _columnNameEdits.TryGetValue(columnId, out var edited)
            ? edited
            : _columns.FirstOrDefault(c => c.Id == columnId)?.Name ?? string.Empty;

    private bool IsColumnChanged(ProjectBidPriceColumnDTO column) =>
        _columnNameEdits.TryGetValue(column.Id, out var editedName) &&
        !string.Equals(editedName.Trim(), column.Name, StringComparison.Ordinal) &&
        !string.IsNullOrWhiteSpace(editedName);

    private async Task CreateColumnAsync()
    {
        var name = _newColumnName.Trim();
        if (name.Length == 0)
        {
            _columnError = "Namn krävs.";
            return;
        }
        if (_columns.Any(c => string.Equals(c.Name, name, StringComparison.CurrentCultureIgnoreCase)))
        {
            _columnError = "En utvärderingsdel med detta namn finns redan. Välj ett annat namn.";
            return;
        }

        _isColumnSaving = true;
        _columnError = string.Empty;
        try
        {
            var id = await Repo.ProjectBid.CreateColumnAsync(ProjectId,
                new ProjectBidPriceColumnPostDTO { Name = name });
            if (id > 0)
            {
                _newColumnName = string.Empty;
                await LoadAsync();
            }
            else
            {
                _columnError = "Utvärderingsdelen kunde inte skapas. Kontrollera namnet och försök igen.";
            }
        }
        catch (Exception ex)
        {
            _columnError = "Utvärderingsdelen kunde inte skapas just nu. Försök igen om en stund.";
            await ClientLog.ErrorAsync($"Failed to create bid evaluation part for project {ProjectId}.", ex: ex);
        }
        finally
        {
            _isColumnSaving = false;
        }
    }

    private async Task RenameColumnAsync(ProjectBidPriceColumnDTO column)
    {
        var name = GetColumnEditName(column.Id).Trim();

        if (name.Length == 0)
        {
            _columnError = "Namn krävs.";
            return;
        }
        if (_columns.Any(c => c.Id != column.Id && string.Equals(c.Name, name, StringComparison.CurrentCultureIgnoreCase)))
        {
            _columnError = "En utvärderingsdel med detta namn finns redan. Välj ett annat namn.";
            return;
        }

        _isColumnSaving = true;
        _columnError = string.Empty;
        try
        {
            var ok = await Repo.ProjectBid.RenameColumnAsync(column.Id, ProjectId,
                new ProjectBidPriceColumnPostDTO { Name = name });
            if (ok)
                await LoadAsync();
            else
                _columnError = "Ändringen kunde inte sparas. Försök igen.";
        }
        catch (Exception ex)
        {
            _columnError = "Ändringen kunde inte sparas just nu. Försök igen om en stund.";
            await ClientLog.ErrorAsync($"Failed to update bid evaluation part {column.Id} for project {ProjectId}.", ex: ex);
        }
        finally
        {
            _isColumnSaving = false;
        }
    }

    private async Task MoveColumnAsync(ProjectBidPriceColumnDTO column, int direction)
    {
        _isColumnSaving = true;
        try
        {
            if (await Repo.ProjectBid.MoveColumnAsync(column.Id, ProjectId, direction))
                await LoadAsync();
        }
        catch (Exception ex)
        {
            await ClientLog.ErrorAsync($"Failed to move bid evaluation part {column.Id} for project {ProjectId}.", ex: ex);
        }
        finally
        {
            _isColumnSaving = false;
        }
    }

    private async Task DeleteColumnAsync(ProjectBidPriceColumnDTO column)
    {
        MHD.DeleteMessage(column.Name, EventCallback.Factory.Create(this, async () =>
        {
            _isColumnSaving = true;
            try
            {
                var ok = await Repo.ProjectBid.DeleteColumnAsync(column.Id, ProjectId);
                if (ok)
                    await LoadAsync();
                MHD.Notifications(ToastType.Delete, ok);
            }
            catch (Exception ex)
            {
                await ClientLog.ErrorAsync($"Failed to delete bid evaluation part {column.Id} for project {ProjectId}.", ex: ex);
            }
            finally
            {
                _isColumnSaving = false;
                StateHasChanged();
            }
        }));
        await Task.CompletedTask;
    }

    // ── Formatting ──────────────────────────────────────────

    private static string FormatAmount(decimal? amount) =>
        amount.HasValue ? amount.Value.ToString("N0") : string.Empty;

    private static string FormatSwedishAmount(decimal amount) =>
        amount.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("sv-SE"));

    private static string FormatPercent(decimal? value) =>
        value.HasValue
            ? value.Value.ToString("0.##", System.Globalization.CultureInfo.GetCultureInfo("sv-SE"))
            : string.Empty;

    private static string FormatPoints(decimal? value) =>
        value.HasValue
            ? value.Value.ToString("0.##", System.Globalization.CultureInfo.GetCultureInfo("sv-SE"))
            : string.Empty;

    private static decimal? ParseAmount(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return null;

        var cleaned = value.Replace(" ", "").Replace(" ", "").Replace(",", ".");
        return decimal.TryParse(cleaned, System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var result)
            ? result
            : null;
    }

    private enum ComparisonField
    {
        Deduction,
        Comparison
    }

    private sealed class ProjectBidFormModel
    {
        public int Id { get; set; }
        public string BidderName { get; set; } = string.Empty;
        public decimal? Amount { get; set; }
        public Dictionary<int, decimal> Prices { get; } = new();
        public decimal? DeductionPercent { get; set; }
        public decimal? ComparisonAmount { get; set; }
        public string? Note { get; set; }
        public bool IsAwarded { get; set; }
        public int? Placement { get; set; }
        public int? AutoPlacement { get; set; }
        public bool IsPlacementManuallyOverridden { get; set; }
        public BidStatus Status { get; set; } = BidStatus.Valid;
        public string? RejectionReason { get; set; }
        public ComparisonField LastEdited { get; set; } = ComparisonField.Deduction;
    }
}
