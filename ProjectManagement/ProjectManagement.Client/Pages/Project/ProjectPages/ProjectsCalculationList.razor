                <button type="button" disabled="@(_currentPage >= TotalPages)" class="@PaginationBtnCls" @onclick="NextPage" title="@AppLoc["next"]">
                    <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                </button>
                <button type="button" disabled="@(_currentPage >= TotalPages)" class="@PaginationBtnCls" @onclick="LastPage" title="@AppLoc["last"]">
                    <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M6 5l7 7-7 7" /></svg>
