                                    HeaderClass="w-12 select-none whitespace-nowrap bg-slate-50 px-2 py-2 text-right font-semibold text-slate-400 dark:bg-slate-900 dark:text-slate-500" HeaderStyle="min-width:44px;">
                        <HeaderContent><HoverTooltip Text="Radnummer i aktuell vy" Class="justify-end">#</HoverTooltip></HeaderContent>
                    </MhdTableColumn>
                    <MhdTableColumn TItem="ListCalculationMVVM" Visible='IsCalculationColumnVisible("code")' ColumnKey="code" Order='@_columnView.OrderIndex("code")' Frozen="true"
                                    HeaderClass='@($"{SortableHeaderClass("code")} w-28 bg-slate-50 dark:bg-slate-900")' HeaderStyle="min-width:70px;" OnHeaderClick='() => SortBy("code")'>
                        <HeaderContent><span class="inline-flex items-center gap-1">@CalcResource.code @((MarkupString)SortIndicatorHtml("code")) <TableColumnFilter FilterState='CF("code")' OnChanged="OnColumnFilterChanged" /></span></HeaderContent>
                    </MhdTableColumn>
                    <MhdTableColumn TItem="ListCalculationMVVM" Visible='IsCalculationColumnVisible("name")' ColumnKey="name" Order='@_columnView.OrderIndex("name")' Frozen="true"
                                    HeaderClass='@($"{SortableHeaderClass("name")} min-w-52 border-r border-slate-300 bg-slate-50 dark:border-slate-600 dark:bg-slate-900")' HeaderStyle="min-width:160px;" OnHeaderClick='() => SortBy("name")'>
                        <HeaderContent><span class="inline-flex items-center gap-1">@AppLoc["calculationName"] @((MarkupString)SortIndicatorHtml("name")) <TableColumnFilter FilterState='CF("name")' OnChanged="OnColumnFilterChanged" /></span></HeaderContent>
                    </MhdTableColumn>
                    <MhdTableColumn TItem="ListCalculationMVVM" Visible='IsCalculationColumnVisible("version")' ColumnKey="version" Order='@_columnView.OrderIndex("version")'
                                    HeaderClass='@SortableHeaderClass("version")' HeaderStyle="min-width:80px;" OnHeaderClick='() => SortBy("version")'>
                        <HeaderContent><span class="inline-flex items-center gap-1">@AppLoc["version"] @((MarkupString)SortIndicatorHtml("version")) <TableColumnFilter FilterState='CF("version")' OnChanged="OnColumnFilterChanged" /></span></HeaderContent>
                    </MhdTableColumn>
                    <MhdTableColumn TItem="ListCalculationMVVM" Visible='IsCalculationColumnVisible("calculationType")' ColumnKey="calculationType" Order='@_columnView.OrderIndex("calculationType")'
                                    HeaderClass='@SortableHeaderClass("calculationType")' HeaderStyle="min-width:150px;" OnHeaderClick='() => SortBy("calculationType")'>
                        <HeaderContent><span class="inline-flex items-center gap-1">@AppLoc["calculationType"] @((MarkupString)SortIndicatorHtml("calculationType")) <TableColumnFilter FilterState='CF("calculationType")' OnChanged="OnColumnFilterChanged" /></span></HeaderContent>
                    </MhdTableColumn>
                    <MhdTableColumn TItem="ListCalculationMVVM" Visible='IsCalculationColumnVisible("status")' ColumnKey="status" Order='@_columnView.OrderIndex("status")'
                                    HeaderClass='@SortableHeaderClass("status")' HeaderStyle="min-width:80px;" OnHeaderClick='() => SortBy("status")'>
                        <HeaderContent><span class="inline-flex items-center gap-1">Kalkylstatus @((MarkupString)SortIndicatorHtml("status")) <TableColumnFilter FilterState='CF("status")' OnChanged="OnColumnFilterChanged" /></span></HeaderContent>
                    </MhdTableColumn>
                    <MhdTableColumn TItem="ListCalculationMVVM" Visible='IsCalculationColumnVisible("responsible")' ColumnKey="responsible" Order='@_columnView.OrderIndex("responsible")'
                                    HeaderClass='@SortableHeaderClass("responsible")' HeaderStyle="min-width:80px;" OnHeaderClick='() => SortBy("responsible")'>
                        <HeaderContent><span class="inline-flex items-center gap-1">@AppLoc["calculationResponsible"] @((MarkupString)SortIndicatorHtml("responsible")) <TableColumnFilter FilterState='CF("responsible")' OnChanged="OnColumnFilterChanged" /></span></HeaderContent>
                    </MhdTableColumn>
                    <MhdTableColumn TItem="ListCalculationMVVM" Visible='IsCalculationColumnVisible("inspector")' ColumnKey="inspector" Order='@_columnView.OrderIndex("inspector")'
                                    HeaderClass='@SortableHeaderClass("inspector")' HeaderStyle="min-width:80px;" OnHeaderClick='() => SortBy("inspector")'>
                        <HeaderContent><span class="inline-flex items-center gap-1">@AppLoc["reviewer"] @((MarkupString)SortIndicatorHtml("inspector")) <TableColumnFilter FilterState='CF("inspector")' OnChanged="OnColumnFilterChanged" /></span></HeaderContent>
                    </MhdTableColumn>
                    <MhdTableColumn TItem="ListCalculationMVVM" Visible='IsCalculationColumnVisible("deadline")' ColumnKey="deadline" Order='@_columnView.OrderIndex("deadline")'
                                    HeaderClass='@SortableHeaderClass("deadline")' HeaderStyle="min-width:80px;" OnHeaderClick='() => SortBy("deadline")'>
                        <HeaderContent><span class="inline-flex items-center gap-1">@CalcResource.tenderDeadline @((MarkupString)SortIndicatorHtml("deadline")) <TableColumnFilter FilterState='CF("deadline")' OnChanged="OnColumnFilterChanged" /></span></HeaderContent>
                    </MhdTableColumn>
                    <MhdTableColumn TItem="ListCalculationMVVM" Visible='IsCalculationColumnVisible("archived")' ColumnKey="archived" Order='@_columnView.OrderIndex("archived")'
                                    HeaderClass='@SortableHeaderClass("archived")' HeaderStyle="min-width:60px;" OnHeaderClick='() => SortBy("archived")'>
                        <HeaderContent><span class="inline-flex items-center gap-1">@AppLoc["archived"] @((MarkupString)SortIndicatorHtml("archived")) <TableColumnFilter FilterState='CF("archived")' OnChanged="OnColumnFilterChanged" /></span></HeaderContent>
                    </MhdTableColumn>
                    <MhdTableColumn TItem="ListCalculationMVVM" Visible='IsCalculationColumnVisible("access")' ColumnKey="access" Order='@_columnView.OrderIndex("access")'
                                    HeaderClass='@SortableHeaderClass("access")' HeaderStyle="min-width:110px;" OnHeaderClick='() => SortBy("access")'>
                        <HeaderContent><span class="inline-flex items-center gap-1"><HoverTooltip Text="Hur kalkylen är tillgänglig och om den ingår i extra delning. Klicka på värdet för detaljer." Focusable="true">Åtkomst</HoverTooltip> @((MarkupString)SortIndicatorHtml("access")) <TableColumnFilter FilterState='CF("access")' OnChanged="OnColumnFilterChanged" /></span></HeaderContent>
                    </MhdTableColumn>
                    <MhdTableColumn TItem="ListCalculationMVVM" Visible='IsCalculationColumnVisible("project")' ColumnKey="project" Order='@_columnView.OrderIndex("project")'
                                    HeaderClass='@SortableHeaderClass("project")' HeaderStyle="min-width:80px;" OnHeaderClick='() => SortBy("project")'>
                        <HeaderContent><span class="inline-flex items-center gap-1">@AppLoc["project"] @((MarkupString)SortIndicatorHtml("project")) <TableColumnFilter FilterState='CF("project")' OnChanged="OnColumnFilterChanged" /></span></HeaderContent>
                    </MhdTableColumn>
                    <MhdTableColumn TItem="ListCalculationMVVM" Visible='IsCalculationColumnVisible("folder")' ColumnKey="folder" Order='@_columnView.OrderIndex("folder")'
                                    HeaderClass='@SortableHeaderClass("folder")' HeaderStyle="min-width:80px;" OnHeaderClick='() => SortBy("folder")'>
                        <HeaderContent><span class="inline-flex items-center gap-1">@AppLoc["folder"] @((MarkupString)SortIndicatorHtml("folder")) <TableColumnFilter FilterState='CF("folder")' OnChanged="OnColumnFilterChanged" /></span></HeaderContent>
                    </MhdTableColumn>
                    <MhdTableColumn TItem="ListCalculationMVVM" Visible='IsCalculationColumnVisible("calculationRole")' ColumnKey="calculationRole" Order='@_columnView.OrderIndex("calculationRole")'
                                    HeaderClass='@SortableHeaderClass("calculationRole")' HeaderStyle="min-width:150px;" OnHeaderClick='() => SortBy("calculationRole")'>
                        <HeaderContent><span class="inline-flex items-center gap-1">@AppLoc["calculationRole"] @((MarkupString)SortIndicatorHtml("calculationRole")) <TableColumnFilter FilterState='CF("calculationRole")' OnChanged="OnColumnFilterChanged" /></span></HeaderContent>
                    </MhdTableColumn>
                    <MhdTableColumn TItem="ListCalculationMVVM" Visible='IsCalculationColumnVisible("qa")' ColumnKey="qa" Order='@_columnView.OrderIndex("qa")'
                                    HeaderClass='@SortableHeaderClass("qa")' HeaderStyle="min-width:120px;" OnHeaderClick='() => SortBy("qa")'>
                        <HeaderContent><span class="inline-flex items-center gap-1"><HoverTooltip Text="Sista dag för frågor och svar" ShowInfoIcon="true" Focusable="true">Frågor/svar</HoverTooltip> @((MarkupString)SortIndicatorHtml("qa")) <TableColumnFilter FilterState='CF("qa")' OnChanged="OnColumnFilterChanged" /></span></HeaderContent>
                    </MhdTableColumn>
                    <MhdTableColumn TItem="ListCalculationMVVM" Visible='IsCalculationColumnVisible("createdAt")' ColumnKey="createdAt" Order='@_columnView.OrderIndex("createdAt")'
