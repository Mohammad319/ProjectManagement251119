    private async Task OpenVersionAsync(ListCalculationMVVM calculation)
    {
        _versionDialogCalculation = null;
        await NewCalculation(calculation.Id);
    }

    private async Task CreateNewVersionAsync(ListCalculationMVVM calculation)
    {
        if (_isCreatingVersion || calculation.Id <= 0)
            return;

        _isCreatingVersion = true;
        _versionDialogMessage = string.Empty;

        try
        {
            var newCalculationId = await Repo.Calculation.CreateVersionAsync(calculation.Id);
            if (newCalculationId <= 0)
            {
                _versionDialogMessage = "Ny version kunde inte skapas.";
                return;
            }

            await ReloadCalculationsAsync();
            await CalcService.SetCalc(newCalculationId);
            MHD.Notifications(ToastType.Add, true);
        }
        catch (Exception ex)
        {
            _versionDialogMessage = "Ett fel uppstod när en ny version skulle skapas.";
            await ClientLog.ErrorAsync("Create calculation version failed", ex: ex);
        }
        finally
        {
            _isCreatingVersion = false;
        }
    }

    private static bool CanCreateProductionCalculation(ListCalculationMVVM calculation) =>
        calculation.CalculationType == CalculationVersionType.Tender &&
        calculation.IsLocked &&
        calculation.StatusAllowsProductionCalculation;

    private void OpenProductionDialog(ListCalculationMVVM calculation)
    {
        if (!CanCreateProductionCalculation(calculation))
            return;

        _productionDialogCalculation = calculation;
        _productionDialogMessage = string.Empty;
    }

    private void CancelProductionDialog()
    {
        if (_isCreatingProductionCalculation)
            return;

        _productionDialogCalculation = null;
        _productionDialogMessage = string.Empty;
    }

    private async Task CreateProductionCalculationAsync()
    {
        if (_productionDialogCalculation is null || _isCreatingProductionCalculation)
            return;

        _isCreatingProductionCalculation = true;
        _productionDialogMessage = string.Empty;

        try
        {
            var newCalculationId = await Repo.Calculation.CreateProductionCopyAsync(_productionDialogCalculation.Id);
            if (newCalculationId <= 0)
            {
                _productionDialogMessage = "Produktionskalkylen kunde inte skapas.";
                return;
            }

            _productionDialogCalculation = null;
            await ReloadCalculationsAsync();
            await CalcService.SetCalc(newCalculationId);
            MHD.Notifications(ToastType.Add, true);
        }
        catch (Exception ex)
        {
            _productionDialogMessage = "Ett fel uppstod när produktionskalkylen skulle skapas.";
            await ClientLog.ErrorAsync("Create production calculation failed", ex: ex);
        }
        finally
        {
            _isCreatingProductionCalculation = false;
        }
    }

    private string GetCalculationStatusText(ListCalculationMVVM calculation)
    {
        if (!string.IsNullOrWhiteSpace(calculation.Status))
            return calculation.Status;

        return calculation.EndDate < DateTime.Today ? AppLoc["finished"] : CalcResource.active;
    }

    private string GetStatusDotClass(ListCalculationMVVM calculation)
    {
        if (!string.IsNullOrWhiteSpace(calculation.Status))
            return "bg-sky-500 dark:bg-sky-400";

        return calculation.EndDate < DateTime.Today
            ? "bg-emerald-500 dark:bg-emerald-400"
            : "bg-amber-400 dark:bg-amber-300";
    }

    private static string GetCalculationRowClass(ListCalculationMVVM calculation, bool selected)
    {
        var classes = new List<string>
        {
            "cursor-pointer transition-colors",
            "hover:bg-slate-50 dark:hover:bg-slate-900/80"
        };

        if (selected)
            classes.Add("bg-violet-50 dark:bg-violet-950/30");

        if (calculation.IsDragOver)
            classes.Add("ring-2 ring-blue-400");

        return string.Join(" ", classes);
    }

    async Task Context(ListCalculationMVVM item)
    {
        var list = new List<MenuItem>();

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        bool isInAnyRole = PMRolesConst.Tenant.AdminSuperManger.Split(',').Any(r => user.IsInRole(r));

        list.Add(new() { IconHtml = Icons.Active, Label = AppLoc["openCalculation"], OnClickAsync = async () => await NewCalculation(item.Id) });

        if (user.Identity?.IsAuthenticated == true && isInAnyRole)
        {
            list.Add(new() { IconHtml = Icons.Edit, Label = ResourceApp.edit, OnClickAsync = () => { UpdateForm(item); return Task.CompletedTask; } });
            if (item.IsCurrentVersion)
                list.Add(new() { IconHtml = Icons.Copy, Label = "Skapa ny version", OnClickAsync = async () => await CreateNewVersionAsync(item) });
            list.Add(new() { IconHtml = Icons.PermissionShield, Label = ResourceApp.share, OnClickAsync = () => { ShareForm(item); return Task.CompletedTask; } });
            list.Add(new() { IconHtml = Icons.Tender, Label = ResourceLoc.tender, OnClickAsync = () => { TenderPage(item); return Task.CompletedTask; } });
            list.Add(new() { IconHtml = Icons.Folder, Label = AppLoc["moveCalculation"], OnClickAsync = () => { OpenMoveCopyDialog(item, MoveCopyOperation.Move); return Task.CompletedTask; } });
            list.Add(new() { IconHtml = Icons.Copy, Label = AppLoc["copyCalculation"], OnClickAsync = () => { OpenMoveCopyDialog(item, MoveCopyOperation.Copy); return Task.CompletedTask; } });

            if (IaVisible)
                list.Add(new() { IconHtml = Icons.Archive, Label = AppLoc["archiveCalculation"], OnClickAsync = async () => await ArchiveOrRestoreCalculationAsync(item, archive: true) });
            else
                list.Add(new() { IconHtml = Icons.Restore, Label = AppLoc["restoreFromArchive"], OnClickAsync = async () => await ArchiveOrRestoreCalculationAsync(item, archive: false) });

            list.Add(new() { IsSeparator = true });
            list.Add(new() { IconHtml = Icons.Delete, Label = ResourceApp.delete, CssClass = "text-red-600 dark:text-red-400", OnClickAsync = () => { Remove(item); return Task.CompletedTask; } });
        }

        await ContextService.ShowMenuAsync(list);
    }

    async Task ArchiveOrRestoreCalculationAsync(ListCalculationMVVM cal, bool archive)
    {
        var dto = await Repo.Calculation.GetPostAsync(cal.Id);
        if (dto is null) return;
        dto.IsVisible = !archive;
        bool ok = await Repo.Calculation.UpdateAsync(dto, cal.Id);
        if (ok)
        {
            Folder.State.ProjectSelected?.Calculations?.Remove(cal);
            UoWService.Folder.State.Notify();
            StateHasChanged();
        }
        MHD.Notifications(ToastType.Update, ok);
    }

