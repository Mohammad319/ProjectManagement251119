                        <HeaderContent><span class="inline-flex items-center gap-1"><HoverTooltip Text="Sannolikhet att vinna" ShowInfoIcon="true" Focusable="true">Vinstchans</HoverTooltip> @((MarkupString)SortIndicatorHtml("priority")) <TableColumnFilter FilterState='CF("priority")' OnChanged="OnColumnFilterChanged" /></span></HeaderContent>
                    </MhdTableColumn>
