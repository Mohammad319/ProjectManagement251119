                list = list.Where(c => _calcColFilters["code"].MatchesText(c.Code));
            if (_calcColFilters["name"].IsActive)
                list = list.Where(c => _calcColFilters["name"].MatchesText(c.Name));
            if (_calcColFilters["version"].IsActive)
                list = list.Where(c => _calcColFilters["version"].MatchesNumber(c.VersionNumber));
            if (_calcColFilters["project"].IsActive)
                list = list.Where(c => _calcColFilters["project"].MatchesText(GetCalculationProjectName(c)));
            if (_calcColFilters["folder"].IsActive)
                list = list.Where(c => _calcColFilters["folder"].MatchesText(GetCalculationFolderName(c)));
            if (_calcColFilters["calculationType"].IsActive)
                list = list.Where(c => _calcColFilters["calculationType"].MatchesDropdown(GetCalculationTypeLabel(c.CalculationType)));
            if (_calcColFilters["calculationRole"].IsActive)
                list = list.Where(c => _calcColFilters["calculationRole"].MatchesDropdown(GetCalculationRoleLabel(c.CalculationRole)));
            if (_calcColFilters["status"].IsActive)
