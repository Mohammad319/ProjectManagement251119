                    </MhdTableColumn>
                    <MhdTableColumn TItem="ListCalculationMVVM" Visible='IsCalculationColumnVisible("end")' ColumnKey="end" Order='@_columnView.OrderIndex("end")'
                                    HeaderClass='@SortableHeaderClass("end")' HeaderStyle="min-width:80px;" OnHeaderClick='() => SortBy("end")'>
