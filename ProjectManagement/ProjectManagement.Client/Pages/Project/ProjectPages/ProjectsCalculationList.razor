@using BlazorMHD.UI.Components.Navigation.Tabs
@using ProjectManagement.Client.Constant
@using Calculation
@using Calculation.Form
@using Calculation.HourlyPriceList
@using Calculation.Income
@using Calculation.Share
@using Calculation.Tender
@using ProjectManagement.Client.Services.Folder
@using ProjectManagement.Client.Helper
@using ProjectManagement.Client.Shared.MVVM.Calculation
@using Microsoft.AspNetCore.Authorization
@using ProjectManagement.Client.Shared.MVVM.Folder
@using ProjectManagement.Shared.DTO.Project
@inject AuthenticationStateProvider AuthenticationStateProvider
@attribute [Authorize]
@using ProjectManagement.Shared.Enums
@using BlazorMHD.UI.Core.Data
@using BlazorMHD.UI.Core.DesignSystem
@using BlazorMHD.UI.Components.Data.ColumnPicker
@using BlazorMHD.UI.Core.Navigation
@using NavTabItem = BlazorMHD.UI.Core.Navigation.TabItem

@inherits AppComponentBase
@inject IJSRuntime JS
@implements IDisposable

<div class="ml-1 flex flex-col overflow-hidden h-[calc(100dvh-2.25rem)]">

    @* ── Sticky header: toolbar + filters ──────────────── *@
    <div class="sticky top-0 z-30 shrink-0 -mx-1 border-b border-slate-200 bg-white px-1 pb-1 shadow-sm dark:border-slate-800 dark:bg-slate-950">

    @* ── Header toolbar ─────────────────────────────────── *@
    <div class="flex w-full flex-wrap items-center justify-between gap-1.5 px-1 pt-1 pb-0.5">
        <div class="min-w-0">
            <div class="flex flex-col text-gray-700 dark:text-gray-300">
                <span class="truncate text-sm font-semibold">
                    @AppLoc["calculationsInProjectFormat", Folder.State.ProjectSelected?.Name ?? "-"]
                </span>
                <span class="truncate text-xs text-slate-500 dark:text-slate-400">
                    @AppLoc["folderNameFormat", Folder.State.FolderSelected?.Name ?? "-"]
                    @if (!string.IsNullOrWhiteSpace(Folder.State.ProjectSelected?.Code))
                    {
                        <span> · @AppLoc["projectCodeFormat", Folder.State.ProjectSelected?.Code ?? "-"]</span>
                    }
                    <span> · @FilteredCalculations.Count() @CalcResource.calculation</span>
                </span>
            </div>
        </div>

        <div class="flex flex-wrap items-center gap-1">
            @* Toggle: Versioner *@
            <button type="button"
                    class="@(_showAllVersions ? "inline-flex h-7 items-center gap-1 rounded border border-blue-300 bg-blue-50 px-2 text-[11px] font-medium text-blue-700 transition dark:border-blue-800 dark:bg-blue-950/40 dark:text-blue-300" : "inline-flex h-7 items-center gap-1 rounded border border-slate-200 bg-white px-2 text-[11px] font-medium text-slate-600 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800") + " disabled:cursor-not-allowed disabled:opacity-40"
                    disabled="@(!HasAnyMultipleVersions)"
                    @onclick="async () => { _showAllVersions = !_showAllVersions; ResetPage(); }">
                <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2" />
                </svg>
                <span>@AppLoc["showAllVersions"]</span>
            </button>

            <div class="h-4 w-px bg-slate-200 dark:bg-slate-700"></div>

            @* Filtrera *@
            <button type="button"
                    class="@(_showFilters || HasActiveFilters ? "inline-flex h-7 items-center gap-1 rounded border border-blue-300 bg-blue-50 px-2 text-[11px] font-medium text-blue-700 transition dark:border-blue-800 dark:bg-blue-950/40 dark:text-blue-300" : "inline-flex h-7 items-center gap-1 rounded border border-slate-200 bg-white px-2 text-[11px] font-medium text-slate-600 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800")"
                    @onclick="() => _showFilters = !_showFilters">
                <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2a1 1 0 01-.293.707L13 13.414V19a1 1 0 01-.553.894l-4 2A1 1 0 017 21v-7.586L3.293 6.707A1 1 0 013 6V4z" />
                </svg>
                <span>Filtrera</span>
                @if (HasActiveFilters)
                {
                    <span class="inline-flex h-3.5 w-3.5 items-center justify-center rounded-full bg-blue-600 text-[9px] font-bold text-white">!</span>
                }
            </button>

            @* Kolumner *@
            <MhdColumnPicker Text="Kolumner"
                             Columns="@CalculationColumnOptions"
                             ColumnVisibility="_calculationColumns"
                             OnChanged="StateHasChanged" />

            <div class="h-4 w-px bg-slate-200 dark:bg-slate-700"></div>

            @* Excel *@
            <button type="button"
                    class="inline-flex h-7 items-center gap-1 rounded border border-slate-200 bg-white px-2 text-[11px] font-medium text-slate-600 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800"
                    @onclick="ExportCalculationListAsync">
                <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                <span>Excel</span>
            </button>

            @* PDF *@
            <button type="button"
                    class="inline-flex h-7 items-center gap-1 rounded border border-slate-200 bg-white px-2 text-[11px] font-medium text-slate-600 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800"
                    @onclick="ExportCalculationPdfAsync">
                <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                </svg>
                <span>PDF</span>
            </button>

            @* Skriv ut *@
            <button type="button"
                    class="inline-flex h-7 items-center gap-1 rounded border border-slate-200 bg-white px-2 text-[11px] font-medium text-slate-600 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800"
                    @onclick="PrintCalculationListAsync">
                <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
                </svg>
                <span>Skriv ut</span>
            </button>

            @* Rapporter dropdown *@
            <div class="relative">
                <button type="button"
                        class="inline-flex h-7 items-center gap-1 rounded border border-slate-200 bg-white px-2 text-[11px] font-medium text-slate-600 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-40 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800"
                        disabled="@(Folder.State.ProjectSelected is null)"
                        @onclick="() => _reportsMenuOpen = !_reportsMenuOpen">
                    <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    <span>Rapporter</span>
                    <svg class="h-2.5 w-2.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                    </svg>
                </button>
                @if (_reportsMenuOpen)
                {
                    <div class="fixed inset-0 z-30" @onclick="() => _reportsMenuOpen = false"></div>
                    <div class="absolute right-0 top-full z-40 mt-1 w-44 rounded-md border border-slate-200 bg-white py-1 shadow-lg dark:border-slate-700 dark:bg-slate-900">
                        <button type="button"
                                class="flex w-full items-center gap-2 px-3 py-1.5 text-[11px] text-slate-700 hover:bg-slate-50 dark:text-slate-200 dark:hover:bg-slate-800"
                                @onclick="() => { _reportsMenuOpen = false; OpenReports(); }">
                            @AppLoc["reports"]
                        </button>
                    </div>
                }
            </div>

            <div class="h-4 w-px bg-slate-200 dark:bg-slate-700"></div>

            <AuthorizeView Roles="@PMRolesConst.Tenant.AdminManger">
                @* Toggle: Visa arkiverade *@
                @if (!Folder.State.OtherDepartment)
                {
                    <button type="button"
                            class="@(!IaVisible ? "inline-flex h-7 items-center gap-1 rounded border border-amber-300 bg-amber-50 px-2 text-[11px] font-medium text-amber-700 transition dark:border-amber-800 dark:bg-amber-950/40 dark:text-amber-300" : "inline-flex h-7 items-center gap-1 rounded border border-slate-200 bg-white px-2 text-[11px] font-medium text-slate-600 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800")"
                            @onclick="RefreshCalculationsAsync">
                        <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
                        </svg>
                        <span>@(IaVisible ? AppLoc["showArchived"] : AppLoc["hideArchived"])</span>
                    </button>
                }

                @* Ny kalkyl *@
                <button type="button"
                        class="inline-flex h-7 shrink-0 items-center gap-1 rounded border border-emerald-400 bg-emerald-500 px-2 text-[11px] font-semibold text-white transition hover:bg-emerald-600 disabled:cursor-not-allowed disabled:opacity-40 dark:border-emerald-600 dark:bg-emerald-600 dark:hover:bg-emerald-700"
                        disabled="@(Folder.State.OtherDepartment || Folder.State.ProjectSelected is null)"
                        title="@AppLoc["newCalculation"]"
                        @onclick="() => UpdateForm(new ListCalculationMVVM())">
                    <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                    </svg>
                    <span>Ny kalkyl</span>
                </button>
            </AuthorizeView>
        </div>
    </div>

    @* ── Filter panel ────────────────────────────────────── *@
    @if (_showFilters)
    {
        <div class="mx-1 mb-2 rounded-lg border border-slate-200 bg-slate-50 p-3 dark:border-slate-700 dark:bg-slate-900/60">
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">

                <div class="flex flex-col gap-1">
                    <label class="text-[11px] font-semibold text-slate-500 dark:text-slate-400">@AppLoc["status"]</label>
                    <input type="text" placeholder="@AppLoc["filterStatusPlaceholder"]"
                           class="h-8 rounded border border-slate-300 bg-white px-2 text-xs text-slate-700 focus:outline-none focus:ring-1 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200"
                           @bind="_filterStatus" @bind:event="oninput" @bind:after="ResetPage" />
                </div>

                <div class="flex flex-col gap-1">
                    <label class="text-[11px] font-semibold text-slate-500 dark:text-slate-400">@AppLoc["calculationType"]</label>
                    <select class="h-8 rounded border border-slate-300 bg-white px-2 text-xs text-slate-700 focus:outline-none focus:ring-1 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200"
                            @bind="_filterCalcType" @bind:after="ResetPage">
                        <option value="">@AppLoc["allItems"]</option>
                        <option value="Tender">@AppLoc["tenderCalculation"]</option>
                        <option value="Contract">@AppLoc["contractCalculation"]</option>
                        <option value="Production">@AppLoc["productionCalculation"]</option>
                    </select>
                </div>

                <div class="flex flex-col gap-1">
                    <label class="text-[11px] font-semibold text-slate-500 dark:text-slate-400">@AppLoc["calculationResponsible"]</label>
                    <input type="text" placeholder="@AppLoc["filterResponsiblePlaceholder"]"
                           class="h-8 rounded border border-slate-300 bg-white px-2 text-xs text-slate-700 focus:outline-none focus:ring-1 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200"
                           @bind="_filterResponsible" @bind:event="oninput" @bind:after="ResetPage" />
                </div>

                <div class="flex flex-col gap-1">
                    <label class="text-[11px] font-semibold text-slate-500 dark:text-slate-400">@AppLoc["reviewer"]</label>
                    <input type="text" placeholder="@AppLoc["filterReviewerPlaceholder"]"
                           class="h-8 rounded border border-slate-300 bg-white px-2 text-xs text-slate-700 focus:outline-none focus:ring-1 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200"
                           @bind="_filterInspector" @bind:event="oninput" @bind:after="ResetPage" />
                </div>

                <div class="flex flex-col gap-1">
                    <label class="text-[11px] font-semibold text-slate-500 dark:text-slate-400">@AppLoc["deadlineFrom"]</label>
                    <input type="date"
                           class="h-8 rounded border border-slate-300 bg-white px-2 text-xs text-slate-700 focus:outline-none focus:ring-1 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200"
                           @bind="_filterDeadlineFrom" @bind:after="ResetPage" />
                </div>

                <div class="flex flex-col gap-1">
                    <label class="text-[11px] font-semibold text-slate-500 dark:text-slate-400">@AppLoc["deadlineTo"]</label>
                    <input type="date"
                           class="h-8 rounded border border-slate-300 bg-white px-2 text-xs text-slate-700 focus:outline-none focus:ring-1 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200"
                           @bind="_filterDeadlineTo" @bind:after="ResetPage" />
                </div>

                <div class="flex flex-col gap-1">
                    <label class="text-[11px] font-semibold text-slate-500 dark:text-slate-400">@AppLoc["locked"]</label>
                    <select class="h-8 rounded border border-slate-300 bg-white px-2 text-xs text-slate-700 focus:outline-none focus:ring-1 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200"
                            @bind="_filterLocked" @bind:after="ResetPage">
                        <option value="">@AppLoc["allItems"]</option>
                        <option value="true">@AppLoc["locked"]</option>
                        <option value="false">@AppLoc["unlocked"]</option>
                    </select>
                </div>

                <div class="flex flex-col gap-1">
                    <label class="text-[11px] font-semibold text-slate-500 dark:text-slate-400">@AppLoc["hasMultipleVersions"]</label>
                    <select class="h-8 rounded border border-slate-300 bg-white px-2 text-xs text-slate-700 focus:outline-none focus:ring-1 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200"
                            @bind="_filterMultipleVersions" @bind:after="ResetPage">
                        <option value="">@AppLoc["allItems"]</option>
                        <option value="true">@AppLoc["yes"]</option>
                        <option value="false">@AppLoc["no"]</option>
                    </select>
                </div>
            </div>
            <div class="mt-2 flex justify-end">
                <button type="button"
                        class="rounded px-2 py-1 text-xs font-medium text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200"
                        @onclick="ClearFilters">
                    @AppLoc["clearFilters"]
                </button>
            </div>
        </div>
    }

    </div>@* ── End sticky header ─────────────────────────── *@

    @* ── Calculation table ──��───────────────────────────── *@
    @if (SortedCalculations.Any())
    {
        <div class="divNetCalc mr-1 mt-2 flex-1 min-h-0 overflow-auto rounded-lg border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-950">
            <table id="resizeMe" class="min-w-full table-auto text-left text-xs">
                <thead class="sticky top-0 z-20 bg-slate-50 text-[11px] font-semibold text-slate-500 dark:bg-slate-900 dark:text-slate-400">
                    <tr>
                        @if (IsCalculationColumnVisible("code"))
                        {
                            <th id="hcode" class="@SortableHeaderClass("code") sticky left-0 z-[11] w-28 bg-slate-50 dark:bg-slate-900" style="min-width:70px;" @onclick='() => SortBy("code")'>
                                <span class="inline-flex items-center gap-1">@CalcResource.code @((MarkupString)SortIndicatorHtml("code")) <TableColumnFilter FilterState='CF("code")' OnChanged="OnColumnFilterChanged" /></span>
                            </th>
                        }
                        @if (IsCalculationColumnVisible("name"))
                        {
                            <th id="hname" class="@SortableHeaderClass("name") sticky left-28 z-[11] min-w-52 border-r border-slate-300 bg-slate-50 dark:border-slate-600 dark:bg-slate-900" style="min-width:160px;" @onclick='() => SortBy("name")'>
                                <span class="inline-flex items-center gap-1">@AppLoc["calculationName"] @((MarkupString)SortIndicatorHtml("name")) <TableColumnFilter FilterState='CF("name")' OnChanged="OnColumnFilterChanged" /></span>
                            </th>
                        }
                        @if (ShowVersionColumn)
                        {
                            <th id="hversion" class="@SortableHeaderClass("version")" style="min-width:80px;" @onclick='() => SortBy("version")'>
                                <span class="inline-flex items-center gap-1">@AppLoc["version"] @((MarkupString)SortIndicatorHtml("version"))</span>
                            </th>
                        }
                        @if (IsCalculationColumnVisible("project"))
                        {
                            <th id="hproject" class="@SortableHeaderClass("project")" style="min-width:80px;" @onclick='() => SortBy("project")'>
                                <span class="inline-flex items-center gap-1">@AppLoc["project"] @((MarkupString)SortIndicatorHtml("project"))</span>
                            </th>
                        }
                        @if (IsCalculationColumnVisible("folder"))
                        {
                            <th id="hfolder" class="@SortableHeaderClass("folder")" style="min-width:80px;" @onclick='() => SortBy("folder")'>
                                <span class="inline-flex items-center gap-1">@AppLoc["folder"] @((MarkupString)SortIndicatorHtml("folder"))</span>
                            </th>
                        }
                        @if (IsCalculationColumnVisible("calculationType"))
                        {
                            <th id="hcalculationType" class="@SortableHeaderClass("calculationType")" style="min-width:150px;" @onclick='() => SortBy("calculationType")'>
                                <span class="inline-flex items-center gap-1">@AppLoc["calculationType"] @((MarkupString)SortIndicatorHtml("calculationType")) <TableColumnFilter FilterState='CF("calculationType")' OnChanged="OnColumnFilterChanged" /></span>
                            </th>
                        }
                        @if (IsCalculationColumnVisible("status"))
                        {
                            <th id="hstatus" class="@SortableHeaderClass("status")" style="min-width:80px;" @onclick='() => SortBy("status")'>
                                <span class="inline-flex items-center gap-1">@CalcResource.status @((MarkupString)SortIndicatorHtml("status")) <TableColumnFilter FilterState='CF("status")' OnChanged="OnColumnFilterChanged" /></span>
                            </th>
                        }
                        @if (IsCalculationColumnVisible("responsible"))
                        {
                            <th id="hresponsible" class="@SortableHeaderClass("responsible")" style="min-width:80px;" @onclick='() => SortBy("responsible")'>
                                <span class="inline-flex items-center gap-1">@AppLoc["calculationResponsible"] @((MarkupString)SortIndicatorHtml("responsible")) <TableColumnFilter FilterState='CF("responsible")' OnChanged="OnColumnFilterChanged" /></span>
                            </th>
                        }
                        @if (IsCalculationColumnVisible("inspector"))
                        {
                            <th id="hinspector" class="@SortableHeaderClass("inspector")" style="min-width:80px;" @onclick='() => SortBy("inspector")'>
                                <span class="inline-flex items-center gap-1">@AppLoc["reviewer"] @((MarkupString)SortIndicatorHtml("inspector")) <TableColumnFilter FilterState='CF("inspector")' OnChanged="OnColumnFilterChanged" /></span>
                            </th>
                        }
                        @if (IsCalculationColumnVisible("qa"))
                        {
                            <th id="hqa" class="@SortableHeaderClass("qa")" style="min-width:120px;" title="Sista dag för frågor och svar" @onclick='() => SortBy("qa")'>
                                <span class="inline-flex items-center gap-1">Sista dag frågor/svar @((MarkupString)SortIndicatorHtml("qa")) <TableColumnFilter FilterState='CF("qa")' OnChanged="OnColumnFilterChanged" /></span>
                            </th>
                        }
                        @if (IsCalculationColumnVisible("deadline"))
                        {
                            <th id="hdeadline" class="@SortableHeaderClass("deadline")" style="min-width:80px;" @onclick='() => SortBy("deadline")'>
                                <span class="inline-flex items-center gap-1">@CalcResource.tenderDeadline @((MarkupString)SortIndicatorHtml("deadline")) <TableColumnFilter FilterState='CF("deadline")' OnChanged="OnColumnFilterChanged" /></span>
                            </th>
                        }
                        @if (IsCalculationColumnVisible("priority"))
                        {
                            <th id="hpriority" class="@SortableHeaderClass("priority")" style="min-width:80px;" @onclick='() => SortBy("priority")'>
                                <span class="inline-flex items-center gap-1">@AppLoc["probability"] @((MarkupString)SortIndicatorHtml("priority")) <TableColumnFilter FilterState='CF("priority")' OnChanged="OnColumnFilterChanged" /></span>
                            </th>
                        }
                        @if (IsCalculationColumnVisible("createdAt"))
                        {
                            <th id="hcreatedAt" class="@SortableHeaderClass("createdAt")" style="min-width:80px;" @onclick='() => SortBy("createdAt")'>
                                <span class="inline-flex items-center gap-1">@AppLoc["createdDate"] @((MarkupString)SortIndicatorHtml("createdAt")) <TableColumnFilter FilterState='CF("createdAt")' OnChanged="OnColumnFilterChanged" /></span>
                            </th>
                        }
                        @if (IsCalculationColumnVisible("updatedAt"))
                        {
                            <th id="hupdatedAt" class="@SortableHeaderClass("updatedAt")" style="min-width:80px;" @onclick='() => SortBy("updatedAt")'>
                                <span class="inline-flex items-center gap-1">@AppLoc["lastModified"] @((MarkupString)SortIndicatorHtml("updatedAt")) <TableColumnFilter FilterState='CF("updatedAt")' OnChanged="OnColumnFilterChanged" /></span>
                            </th>
                        }
                        @if (IsCalculationColumnVisible("start"))
                        {
                            <th id="hstart" class="@SortableHeaderClass("start")" style="min-width:80px;" @onclick='() => SortBy("start")'>
                                <span class="inline-flex items-center gap-1">@CalcResource.startDate @((MarkupString)SortIndicatorHtml("start")) <TableColumnFilter FilterState='CF("start")' OnChanged="OnColumnFilterChanged" /></span>
                            </th>
                        }
                        @if (IsCalculationColumnVisible("end"))
                        {
                            <th id="hend" class="@SortableHeaderClass("end")" style="min-width:80px;" @onclick='() => SortBy("end")'>
                                <span class="inline-flex items-center gap-1">@CalcResource.endDate @((MarkupString)SortIndicatorHtml("end")) <TableColumnFilter FilterState='CF("end")' OnChanged="OnColumnFilterChanged" /></span>
                            </th>
                        }
                        @if (IsCalculationColumnVisible("timeMonth"))
                        {
                            <th id="htimeMonth" class="@SortableHeaderClass("timeMonth")" style="min-width:80px;" @onclick='() => SortBy("timeMonth")'>
                                <span class="inline-flex items-center gap-1">@AppLoc["projectDurationMonths"] @((MarkupString)SortIndicatorHtml("timeMonth")) <TableColumnFilter FilterState='CF("timeMonth")' OnChanged="OnColumnFilterChanged" /></span>
                            </th>
                        }
                        @if (IsCalculationColumnVisible("tax"))
                        {
                            <th id="htax" class="@SortableHeaderClass("tax")" style="min-width:60px;" @onclick='() => SortBy("tax")'>
                                <span class="inline-flex items-center gap-1">@AppLoc["vatPercent"] @((MarkupString)SortIndicatorHtml("tax")) <TableColumnFilter FilterState='CF("tax")' OnChanged="OnColumnFilterChanged" /></span>
                            </th>
                        }
                        @if (IsCalculationColumnVisible("archived"))
                        {
                            <th id="harchived" class="whitespace-nowrap px-3 py-2 relative" style="min-width:60px;">
                                <span class="inline-flex items-center gap-1">@AppLoc["archived"] <TableColumnFilter FilterState='CF("archived")' OnChanged="OnColumnFilterChanged" /></span>
                            </th>
                        }
                        @if (IsCalculationColumnVisible("privacy"))
                        {
                            <th id="hprivacy" class="whitespace-nowrap px-3 py-2 relative" style="min-width:60px;">
                                <span class="inline-flex items-center gap-1">@ResourceApp._private <TableColumnFilter FilterState='CF("privacy")' OnChanged="OnColumnFilterChanged" /></span>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                    @foreach (var calu in PagedCalculations)
                    {
                        var isSelected = Folder.State.Calculation?.Id == calu.Id;
                        var rowClasses = GetCalculationRowClass(calu, isSelected);

                        <tr @key="calu.Id"
                            class="@rowClasses"
                            @oncontextmenu:preventDefault
                            @oncontextmenu="() => Context(calu)"
                            @onclick="async () => await NewCalculation(calu.Id)"
                            @ondrop="async _ => await HandleDrop(calu)"
                            @ondragleave="() => calu.IsDragOver = false"
                            @ondragover:preventDefault="true"
                            @ondragover="() => calu.IsDragOver = calcDraging is not null"
                            @ondragstart="() => calcDraging = calu"
                            @ondragend="() => calcDraging = null"
                            draggable="true">
                            @if (IsCalculationColumnVisible("code"))
                            {
                                <td class="sticky left-0 z-[2] w-28 whitespace-nowrap bg-white px-3 py-2 font-mono text-[11px] text-slate-500 hover:bg-slate-50 dark:bg-slate-950 dark:text-slate-400 dark:hover:bg-slate-900 @(isSelected ? "!bg-blue-50 dark:!bg-blue-950/30" : string.Empty)">
                                    @FormatText(calu.Code)
                                </td>
                            }
                            @if (IsCalculationColumnVisible("name"))
                            {
                                <td class="sticky left-28 z-[2] max-w-80 border-r border-slate-200 bg-white px-3 py-2 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-950 dark:hover:bg-slate-900 @(isSelected ? "!bg-blue-50 dark:!bg-blue-950/30" : string.Empty)">
                                    <span class="truncate font-semibold text-slate-800 dark:text-slate-100" title="@calu.Name">@calu.Name</span>
                                </td>
                            }
                            @if (ShowVersionColumn)
                            {
                                <td class="whitespace-nowrap px-3 py-2">
                                    <div class="flex items-center gap-1.5">
                                        <span class="font-mono text-slate-600 dark:text-slate-300">@FormatVersion(calu.VersionNumber)</span>
                                        @if (calu.IsCurrentVersion)
                                        {
                                            <span class="shrink-0 rounded-full bg-emerald-100 px-1.5 py-0.5 text-[10px] font-semibold text-emerald-700 dark:bg-emerald-950/50 dark:text-emerald-300">@AppLoc["current"]</span>
                                        }
                                        @if (HasMultipleVersions(calu))
                                        {
                                            <button type="button"
                                                    class="shrink-0 rounded border border-slate-300 px-1.5 py-0.5 text-[10px] font-medium text-slate-500 transition hover:border-slate-400 hover:text-slate-700 dark:border-slate-700 dark:text-slate-400 dark:hover:border-slate-500 dark:hover:text-slate-200"
                                                    @onclick:stopPropagation="true"
                                                    @onclick="() => OpenVersionsDialog(calu)">
                                                @AppLoc["showVersions"]
                                            </button>
                                        }
                                    </div>
                                </td>
                            }
                            @if (IsCalculationColumnVisible("project"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatText(calu.ProjectName)</td>
                            }
                            @if (IsCalculationColumnVisible("folder"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatText(calu.FolderName)</td>
                            }
                            @if (IsCalculationColumnVisible("calculationType"))
                            {
                                <td class="whitespace-nowrap px-3 py-2">
                                    <span class="inline-flex items-center gap-1">
                                        <span class="@GetCalcTypeBadgeClass(calu)">
                                            @GetCalculationTypeLabel(calu.CalculationType)
                                        </span>
                                        @if (calu.IsLocked)
                                        {
                                            <svg class="h-3 w-3 shrink-0 text-amber-500 dark:text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-label="@AppLoc["locked"]">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                                            </svg>
                                        }
                                    </span>
                                </td>
                            }
                            @if (IsCalculationColumnVisible("status"))
                            {
                                <td class="whitespace-nowrap px-3 py-2">
                                    <span class="inline-flex items-center gap-1.5">
                                        <span class="h-2 w-2 shrink-0 rounded-full @GetStatusDotClass(calu)"></span>
                                        <span class="text-slate-700 dark:text-slate-200">@GetCalculationStatusText(calu)</span>
                                    </span>
                                </td>
                            }
                            @if (IsCalculationColumnVisible("responsible"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatText(calu.Responsible)</td>
                            }
                            @if (IsCalculationColumnVisible("inspector"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatText(calu.Inspector)</td>
                            }
                            @if (IsCalculationColumnVisible("qa"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatDate(calu.TenderQA)</td>
                            }
                            @if (IsCalculationColumnVisible("deadline"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatDate(calu.TenderDeadline)</td>
                            }
                            @if (IsCalculationColumnVisible("priority"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@calu.Priority %</td>
                            }
                            @if (IsCalculationColumnVisible("createdAt"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatDate(calu.CreatedAt)</td>
                            }
                            @if (IsCalculationColumnVisible("updatedAt"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@(calu.UpdatedAt.HasValue ? FormatDate(calu.UpdatedAt.Value) : "-")</td>
                            }
                            @if (IsCalculationColumnVisible("start"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatDate(calu.StartDate)</td>
                            }
                            @if (IsCalculationColumnVisible("end"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatDate(calu.EndDate)</td>
                            }
                            @if (IsCalculationColumnVisible("timeMonth"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@calu.TimeMonth</td>
                            }
                            @if (IsCalculationColumnVisible("tax"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@calu.Tax %</td>
                            }
                            @if (IsCalculationColumnVisible("archived"))
                            {
                                <td class="whitespace-nowrap px-3 py-2">
                                    <span class="inline-flex rounded-full px-2 py-0.5 text-[11px] font-semibold @(!calu.IsVisible ? "bg-amber-100 text-amber-700 dark:bg-amber-950/50 dark:text-amber-300" : "bg-slate-100 text-slate-500 dark:bg-slate-800 dark:text-slate-300")">
                                        @(!calu.IsVisible ? AppLoc["archived"].Value : "-")
                                    </span>
                                </td>
                            }
                            @if (IsCalculationColumnVisible("privacy"))
                            {
                                <td class="whitespace-nowrap px-3 py-2">
                                    <span class="inline-flex rounded-full px-2 py-0.5 text-[11px] font-semibold @(calu.IsPrivate ? "bg-amber-100 text-amber-700 dark:bg-amber-950/50 dark:text-amber-300" : "bg-slate-100 text-slate-500 dark:bg-slate-800 dark:text-slate-300")">
                                        @(calu.IsPrivate ? ResourceApp._private : "-")
                                    </span>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* ── Pagination bar ──────────────────────────────── *@
        <div class="shrink-0 mr-1 mt-1 grid grid-cols-3 items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs shadow-sm dark:border-slate-800 dark:bg-slate-950">
            @* Left: page size *@
            <div class="flex items-center gap-1.5">
                <select class="h-6 rounded border border-slate-300 bg-white px-1 text-[11px] text-slate-700 focus:outline-none focus:ring-1 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200"
                        @bind="_pageSize" @bind:after="() => _currentPage = 1">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                    <option value="0">@AppLoc["allItems"]</option>
                </select>
                <span class="text-[11px] text-slate-500 dark:text-slate-400">/ sida</span>
            </div>

            @* Center: range info *@
            <div class="text-center text-[11px] text-slate-500 dark:text-slate-400">
                @if (_pageSize <= 0 || TotalFilteredCount == 0)
                {
                    @AppLoc["showingAllFormat", TotalFilteredCount]
                }
                else
                {
                    @AppLoc["showingRangeFormat", PageStart, PageEnd, TotalFilteredCount]
                }
            </div>

            @* Right: navigation *@
            <div class="flex items-center justify-end gap-1">
                <button type="button" disabled="@(_currentPage <= 1)" class="@PaginationBtnCls" @onclick="FirstPage" title="Första">
                    <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 19l-7-7 7-7M18 19l-7-7 7-7" /></svg>
                </button>
                <button type="button" disabled="@(_currentPage <= 1)" class="@PaginationBtnCls" @onclick="PreviousPage" title="Föregående">
                    <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
                </button>
                <span class="min-w-[2.5rem] text-center text-[11px] text-slate-500 dark:text-slate-400">
                    @if (TotalPages > 1) { @($"{_currentPage}/{TotalPages}") }
                </span>
                <button type="button" disabled="@(_currentPage >= TotalPages)" class="@PaginationBtnCls" @onclick="NextPage" title="Nästa">
                    <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                </button>
                <button type="button" disabled="@(_currentPage >= TotalPages)" class="@PaginationBtnCls" @onclick="LastPage" title="Sista">
                    <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M6 5l7 7-7 7" /></svg>
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-6 py-12 text-center dark:border-slate-700 dark:bg-slate-950/60">
            <div class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">@CalcResource.calculation</div>
            <h3 class="mt-2 text-lg font-semibold text-slate-900 dark:text-slate-100">@AppLoc["calculationsEmptyState"]</h3>
            <p class="mt-2 text-sm leading-6 text-slate-500 dark:text-slate-400">@AppLoc["calculationsEmptyStateHint"]</p>
            @if (!Folder.State.OtherDepartment && Folder.State.ProjectSelected is not null)
            {
                <AuthorizeView Roles="@PMRolesConst.Tenant.AdminManger">
                    <button type="button"
                            class="mt-4 inline-flex items-center gap-1.5 rounded-lg border border-emerald-300 bg-emerald-50 px-4 py-2 text-sm font-semibold text-emerald-700 transition hover:bg-emerald-100 dark:border-emerald-900/60 dark:bg-emerald-950/30 dark:text-emerald-300 dark:hover:bg-emerald-950/50"
                            @onclick="() => UpdateForm(new ListCalculationMVVM())">
                        <span aria-hidden="true">@((MarkupString)Icons.Plus)</span>
                        <span>@AppLoc["newCalculation"]</span>
                    </button>
                </AuthorizeView>
            }
        </div>
    }
</div>

@* ── Production calculation dialog ──────────────────── *@
@if (_productionDialogCalculation is not null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/50 px-4 py-6">
        <div class="w-full max-w-lg rounded-lg border border-slate-200 bg-white p-5 shadow-2xl dark:border-slate-700 dark:bg-slate-900">
            <div class="space-y-3 text-slate-700 dark:text-slate-200">
                <h2 class="text-base font-semibold text-slate-900 dark:text-slate-50">@AppLoc["createProductionCalculationTitle"]</h2>
                <p class="text-sm leading-6">
                    @AppLoc["createProductionCalculationDescription"]
                </p>
                <p class="text-sm font-medium text-slate-900 dark:text-slate-100">@AppLoc["continueQuestion"]</p>
                @if (!string.IsNullOrWhiteSpace(_productionDialogMessage))
                {
                    <div class="rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-300">
                        @_productionDialogMessage
                    </div>
                }
            </div>
            <div class="mt-5 flex flex-wrap justify-end gap-2">
                <button type="button"
                        class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
                        disabled="@_isCreatingProductionCalculation"
                        @onclick="CancelProductionDialog">
                    @AppLoc["cancelOrder"]
                </button>
                <button type="button"
                        class="rounded-lg border border-emerald-500 bg-emerald-600 px-3 py-1.5 text-sm font-semibold text-white transition hover:bg-emerald-700 disabled:cursor-not-allowed disabled:opacity-50 dark:border-emerald-500 dark:bg-emerald-500 dark:hover:bg-emerald-600"
                        disabled="@_isCreatingProductionCalculation"
                        @onclick="CreateProductionCalculationAsync">
                    @AppLoc["createProductionCalculation"]
                </button>
            </div>
        </div>
    </div>
}

@* ── Versions dialog ─────────────────────────────────── *@
@if (_versionDialogCalculation is not null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/50 px-4 py-6">
        <div class="w-full max-w-2xl rounded-lg border border-slate-200 bg-white p-5 shadow-2xl dark:border-slate-700 dark:bg-slate-900">
            <div class="flex items-start justify-between gap-3">
                <div>
                    <h2 class="text-base font-semibold text-slate-900 dark:text-slate-50">@AppLoc["versions"]</h2>
                    <p class="mt-0.5 text-sm text-slate-600 dark:text-slate-300">@_versionDialogCalculation.Name</p>
                </div>
                <button type="button"
                        class="rounded-md border border-slate-300 px-2 py-1 text-sm text-slate-600 transition hover:bg-slate-50 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800"
                        @onclick="CloseVersionsDialog">
                    @AppLoc["close"]
                </button>
            </div>
            <div class="mt-4 overflow-x-auto">
                <table class="min-w-full text-xs">
                    <thead>
                        <tr class="border-b border-slate-200 dark:border-slate-700">
                            <th class="pb-2 pr-4 text-left text-[11px] font-semibold text-slate-500 dark:text-slate-400">@AppLoc["version"]</th>
                            <th class="pb-2 pr-4 text-left text-[11px] font-semibold text-slate-500 dark:text-slate-400">@AppLoc["code"]</th>
                            <th class="pb-2 pr-4 text-left text-[11px] font-semibold text-slate-500 dark:text-slate-400">@AppLoc["calculationName"]</th>
                            <th class="pb-2 pr-4 text-left text-[11px] font-semibold text-slate-500 dark:text-slate-400">@AppLoc["tenderDeadline"]</th>
                            <th class="pb-2"></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                        @foreach (var version in GetVersions(_versionDialogCalculation))
                        {
                            <tr>
                                <td class="py-2 pr-4">
                                    <div class="flex items-center gap-1.5">
                                        <span class="font-mono font-semibold text-slate-800 dark:text-slate-100">@FormatVersion(version.VersionNumber)</span>
                                        @if (version.IsCurrentVersion)
                                        {
                                            <span class="rounded-full bg-emerald-100 px-1.5 py-0.5 text-[10px] font-semibold text-emerald-700 dark:bg-emerald-950/50 dark:text-emerald-300">@AppLoc["current"]</span>
                                        }
                                    </div>
                                </td>
                                <td class="py-2 pr-4 font-mono text-slate-500 dark:text-slate-400">@FormatText(version.Code)</td>
                                <td class="py-2 pr-4 text-slate-700 dark:text-slate-200">@version.Name</td>
                                <td class="py-2 pr-4 text-slate-500 dark:text-slate-400">
                                    @if (version.TenderDeadline != default)
                                    {
                                        <span title="@version.TenderDeadline.ToString("yyyy-MM-dd HH:mm:ss")">
                                            @version.TenderDeadline.ToString("yyyy-MM-dd")
                                        </span>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>
                                <td class="py-2 text-right">
                                    <div class="flex flex-wrap justify-end gap-1.5">
                                        <button type="button"
                                                class="rounded-md border border-slate-300 px-2 py-1 font-medium text-slate-700 transition hover:bg-slate-50 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
                                                @onclick="async () => await OpenVersionAsync(version)">
                                            @AppLoc["open"]
                                        </button>
                                        @if (!version.IsCurrentVersion)
                                        {
                                            <button type="button"
                                                    class="rounded-md border border-violet-300 px-2 py-1 font-medium text-violet-700 transition hover:bg-violet-50 disabled:cursor-not-allowed disabled:opacity-50 dark:border-violet-800 dark:text-violet-300 dark:hover:bg-violet-950/40"
                                                    disabled="@_isCreatingVersion"
                                                    @onclick="async () => await RestoreAsNewVersionAsync(version)">
                                                @AppLoc["restoreAsNewVersion"]
                                            </button>
                                        }
                                        @if (CanArchiveVersion(version))
                                        {
                                            <button type="button"
                                                    class="rounded-md border border-amber-300 px-2 py-1 font-medium text-amber-700 transition hover:bg-amber-50 dark:border-amber-800 dark:text-amber-300 dark:hover:bg-amber-950/40"
                                                    @onclick="async () => await ArchiveOrRestoreCalculationAsync(version, archive: true)">
                                                @AppLoc["archiveVersion"]
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (!string.IsNullOrWhiteSpace(_versionDialogMessage))
            {
                <div class="mt-4 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-300">
                    @_versionDialogMessage
                </div>
            }
        </div>
    </div>
}

@code {
    private DotNetObjectReference<ProjectsCalculationList>? _dotNetRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _dotNetRef ??= DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("initializeResizableColumns", _dotNetRef);
    }

    [JSInvokable]
    public void SaveTemplateBlazor(string data) { }

    public void Dispose() => _dotNetRef?.Dispose();

    private ListCalculationMVVM? calcDraging;
    private bool IaVisible { get; set; } = true;
    private ListCalculationMVVM? _productionDialogCalculation;
    private bool _isCreatingProductionCalculation;
    private string _productionDialogMessage = string.Empty;
    private bool _showAllVersions;
    private ListCalculationMVVM? _versionDialogCalculation;
    private bool _isCreatingVersion;
    private string _versionDialogMessage = string.Empty;
    private bool _reportsMenuOpen;

    private string _sortColumn = "";
    private bool _sortAscending = true;

    private int _pageSize = 25;
    private int _currentPage = 1;
    private const string ToolbarButtonClass = "inline-flex h-9 items-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3 text-sm font-medium text-slate-700 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800";
    private const string PaginationBtnCls = "inline-flex h-6 w-6 items-center justify-center rounded border border-slate-200 text-slate-600 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-35 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800";

    private int TotalFilteredCount => FilteredCalculations.Count();
    private int TotalPages => _pageSize <= 0 ? 1 : Math.Max(1, (int)Math.Ceiling((double)TotalFilteredCount / _pageSize));
    private int PageStart => TotalFilteredCount == 0 ? 0 : (_currentPage - 1) * _pageSize + 1;
    private int PageEnd => Math.Min(_currentPage * _pageSize, TotalFilteredCount);

    private IEnumerable<ListCalculationMVVM> PagedCalculations =>
        _pageSize <= 0
            ? SortedCalculations
            : SortedCalculations.Skip((_currentPage - 1) * _pageSize).Take(_pageSize);

    private void ResetPage() => _currentPage = 1;
    private void FirstPage() => _currentPage = 1;
    private void LastPage() => _currentPage = TotalPages;
    private void PreviousPage() { if (_currentPage > 1) _currentPage--; }
