                </ChildContent>
                <RowTemplate Context="calu">
                    @{
                        var isSelected = Folder.State.Calculation?.Id == calu.Id;
                        var canReorder = CanReorderCalculations;
                        var draggableValue = canReorder ? "true" : "false";
                        var rowClasses = GetCalculationRowClass(calu, isSelected, canReorder);
                        var rowNumber = _calcRowNumbers.TryGetValue(calu.Id, out var _rn) ? _rn : 0;
                    }

                        <tr @key="calu.Id"
                            class="@rowClasses"
                            title="@(canReorder ? null : "Ändra ordning är bara tillgängligt vid manuell sortering.")"
                            @oncontextmenu:preventDefault
                            @oncontextmenu="() => Context(calu)"
                            @onclick="async () => await OpenCalculationAsync(calu)"
                            @ondrop="async _ => await HandleDrop(calu)"
                            @ondragleave="() => calu.IsDragOver = false"
                            @ondragover:preventDefault="true"
                            @ondragover="() => calu.IsDragOver = canReorder && calcDraging is not null"
                            @ondragstart="() => OnCalcDragStart(calu)"
                            @ondragend="() => calcDraging = null"
                            draggable="@draggableValue">
                            @if (IsCalculationColumnVisible("rowNumber"))
                            {
                                <td class="sticky left-0 z-[2] w-12 whitespace-nowrap bg-white px-2 py-2 text-right font-mono text-[11px] text-slate-400 group-hover:bg-slate-50 dark:bg-slate-950 dark:text-slate-500 dark:group-hover:bg-slate-900/80 @(isSelected ? "!bg-blue-50 dark:!bg-blue-950/30" : string.Empty)">
                                    @rowNumber
                                </td>
                            }
                            @if (IsCalculationColumnVisible("code"))
                            {
                                <td class="sticky @CodeStickyLeftClass z-[2] w-28 whitespace-nowrap bg-white px-3 py-2 font-mono text-[11px] text-slate-500 group-hover:bg-slate-50 dark:bg-slate-950 dark:text-slate-400 dark:group-hover:bg-slate-900/80 @(isSelected ? "!bg-blue-50 dark:!bg-blue-950/30" : string.Empty)">
                                    @FormatText(calu.Code)
                                </td>
                            }
                            @if (IsCalculationColumnVisible("name"))
                            {
                                <td class="sticky @NameStickyLeftClass z-[2] max-w-80 border-r border-slate-200 bg-white px-3 py-2 group-hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-950 dark:group-hover:bg-slate-900/80 @(isSelected ? "!bg-blue-50 dark:!bg-blue-950/30" : string.Empty)">
                                    <div class="flex min-w-0 items-center gap-2">
                                        <HoverTooltip Text="@calu.Name" OnlyWhenTruncated="true" Class="truncate font-semibold text-slate-800 dark:text-slate-100">
                                            <span class="truncate">@calu.Name</span>
                                        </HoverTooltip>
                                        @if (calu.ImportInfo?.IsImportedCopy == true)
                                        {
                                            <button type="button"
                                                    class="shrink-0 rounded-full border border-sky-200 bg-sky-50 px-2 py-0.5 text-[10px] font-semibold text-sky-700 transition hover:bg-sky-100 dark:border-sky-900 dark:bg-sky-950/40 dark:text-sky-300"
                                                    title="Visa importinformation"
                                                    @onclick:stopPropagation="true"
                                                    @onclick="() => OpenImportInfoDialog(calu)">
                                                Importerad kopia
                                            </button>
                                        }
                                    </div>
                                </td>
                            }
                            @if (IsCalculationColumnVisible("version"))
                            {
                                <td class="whitespace-nowrap px-3 py-2">
                                    <div class="flex items-center gap-1.5">
                                        <span class="font-mono text-slate-600 dark:text-slate-300">@FormatVersion(calu.VersionNumber)</span>
                                        @if (calu.IsCurrentVersion)
                                        {
                                            <span class="shrink-0 font-semibold text-emerald-600 dark:text-emerald-400" title="Aktuell version" aria-label="Aktuell version">✓</span>
                                        }
                                        @if (HasMultipleVersions(calu))
                                        {
                                            <button type="button"
                                                    class="shrink-0 rounded border border-slate-300 px-1.5 py-0.5 text-[10px] font-medium text-slate-500 transition hover:border-slate-400 hover:text-slate-700 dark:border-slate-700 dark:text-slate-400 dark:hover:border-slate-500 dark:hover:text-slate-200"
                                                    title="Visa alla versioner"
                                                    @onclick:stopPropagation="true"
                                                    @onclick="() => OpenVersionsDialog(calu)">
                                                Versioner
                                            </button>
                                        }
                                    </div>
                                </td>
                            }
                            @if (IsCalculationColumnVisible("calculationType"))
                            {
                                <td class="whitespace-nowrap px-3 py-2">
                                    <span class="inline-flex items-center gap-1">
                                        <span class="@GetCalcTypeBadgeClass(calu)">
                                            @GetCalculationTypeLabel(calu.CalculationType)
                                        </span>
                                        @if (calu.IsLocked)
                                        {
                                            <svg class="h-3 w-3 shrink-0 text-amber-500 dark:text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-label="@AppLoc["locked"]">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                                            </svg>
                                        }
                                    </span>
                                </td>
                            }
                            @if (IsCalculationColumnVisible("status"))
                            {
                                <td class="whitespace-nowrap px-3 py-2">
                                    <span class="inline-flex items-center gap-1.5">
                                        <span class="h-2 w-2 shrink-0 rounded-full"
                                              style="background-color:@GetCalculationStatusColor(calu)"></span>
                                        <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-200">@GetCalculationStatusText(calu)</span>
                                    </span>
                                </td>
                            }
                            @if (IsCalculationColumnVisible("responsible"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatText(calu.Responsible)</td>
                            }
                            @if (IsCalculationColumnVisible("inspector"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatText(calu.Inspector)</td>
                            }
