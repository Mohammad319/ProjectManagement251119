@using ProjectManagement.Client.Constant
@using Calculation
@using Calculation.Form
@using Calculation.Share
@using Calculation.Tender
@using ProjectManagement.Client.Helper
@using ProjectManagement.Client.Services.Folder
@using BlazorMHD.UI.Components.Data.Table
@using ProjectManagement.Client.Shared.Model.Project
@using ProjectManagement.Shared.DTO.Project
@using ProjectManagement.Shared.Helper
@using ProjectManagement.Client.Shared.MVVM.Calculation
@using ProjectManagement.Client.Shared.MVVM.Folder
@using System.Globalization
@using ProjectManagement.Shared.Policies
@using Microsoft.AspNetCore.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider
@attribute [Authorize]
@using ProjectManagement.Shared.Enums
@using BlazorMHD.UI.Core.Data
@using NavTabItem = BlazorMHD.UI.Core.Navigation.MhdTabItem

@inherits AppComponentBase
@inject IJSRuntime JS
@inject ProjectManagement.Client.Services.Calculation.CalculationListViewPreference ViewPreference
@inject ProjectManagement.Client.Services.Folder.ListSavedFilterStorage SavedFilterStorage
@inject ProjectManagement.Client.Services.Folder.ListSavedColumnViewStorage SavedColumnViewStorage
@implements IDisposable

@{
    // Reset the per-render filter+sort memo so SortedCalculationsSnapshot is rebuilt exactly
    // once this render (and never serves data left over from a previous render).
    _sortedSnapshot = null;
}
<div class="flex h-full min-h-0 flex-col gap-1 overflow-hidden px-1 pb-1">

    @* ── Sticky header: toolbar + filters ──────────────── *@
    <div class="sticky top-0 z-[80] shrink-0 -mx-1 border-b border-slate-200 bg-white px-1 pb-1 shadow-sm dark:border-slate-800 dark:bg-slate-950">

    @* ── Header toolbar ─────────────────────────────────── *@
    <div class="flex w-full flex-wrap items-center justify-between gap-1.5 px-1 pt-1 pb-0.5">
        <div class="min-w-0">
            @* Kompakt rubrik i en rad: vad · plats · (hela avdelningen / filtrerat urval) · antal *@
            <span class="block truncate text-sm text-slate-700 dark:text-slate-200" title="@CalculationHeaderText">
                <span class="font-semibold">Kalkyler i @CalculationListPlaceName</span><span class="text-slate-500 dark:text-slate-400">@CalculationHeaderMeta</span>
            </span>
        </div>

        <div class="flex flex-wrap items-center gap-1">
            @* Filtrera *@
            <div class="relative">
                <button type="button"
                        class="@(HasActiveFilters ? "inline-flex h-7 items-center gap-1 rounded border border-blue-300 bg-blue-50 px-2 text-[11px] font-medium text-blue-700 transition dark:border-blue-800 dark:bg-blue-950/40 dark:text-blue-300" : "inline-flex h-7 items-center gap-1 rounded border border-slate-200 bg-white px-2 text-[11px] font-medium text-slate-600 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800")"
                        @onclick="() => _filterMenuOpen = !_filterMenuOpen">
                    <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2a1 1 0 01-.293.707L13 13.414V19a1 1 0 01-.553.894l-4 2A1 1 0 017 21v-7.586L3.293 6.707A1 1 0 013 6V4z" />
                    </svg>
                    <span>@AppLoc["filter"]</span>
                    @if (ActiveFilterCount > 0)
                    {
                        <span class="inline-flex h-4 min-w-[1rem] items-center justify-center rounded-full bg-blue-600 px-1 text-[9px] font-bold leading-none text-white dark:bg-blue-500">@ActiveFilterCount</span>
                    }
                    @if (HasHiddenActiveFilterColumns)
                    {
                        <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-amber-500 dark:bg-amber-400" title="Filtret använder dold kolumn"></span>
                    }
                    <svg class="h-2.5 w-2.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                    </svg>
                </button>
                @if (_filterMenuOpen)
                {
                    <div class="fixed inset-0 z-[70]" @onclick="CloseCalcFilterMenu"></div>
                    <div class="absolute left-0 top-full z-[90] mt-1 w-72 rounded-md border border-slate-200 bg-white py-1 shadow-lg dark:border-slate-700 dark:bg-slate-900">

                        @* ── Aktiva filter ── *@
                        <div class="px-3 pt-1.5 pb-0.5">
                            <span class="text-[10px] font-semibold tracking-wide text-slate-400 dark:text-slate-500">Aktiva filter</span>
                        </div>
                        @if (HasActiveFilters)
                        {
                            <div class="flex max-h-32 flex-wrap gap-1 overflow-y-auto px-3 pb-1.5">
                                @foreach (var kv in _calcColFilters.Where(kv => kv.Value.IsActive))
                                {
                                    var filterKey = kv.Key;
                                    <span class="inline-flex max-w-full items-center gap-1 rounded-full bg-blue-50 px-2 py-0.5 text-[10px] font-medium text-blue-700 dark:bg-blue-950/40 dark:text-blue-300">
                                        <HoverTooltip Text="@GetCalcFilterLabel(filterKey, kv.Value)" Class="truncate">
                                            <span class="truncate">@GetCalcFilterLabel(filterKey, kv.Value)</span>
                                        </HoverTooltip>
                                        <button type="button"
                                                class="shrink-0 text-blue-400 hover:text-blue-700 dark:hover:text-blue-200"
                                                title="@AppLoc["clearAllFilters"]"
                                                @onclick="() => ClearSingleCalcFilter(filterKey)">
                                            <svg class="h-2.5 w-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" /></svg>
                                        </button>
                                    </span>
                                }
                            </div>
                        }
                        else
                        {
                            <span class="block px-3 pb-1.5 text-[11px] text-slate-400 dark:text-slate-500">@AppLoc["noActiveFilters"]</span>
                        }

                        @* ── Åtgärder ── *@
                        <div class="my-1 border-t border-slate-100 dark:border-slate-800"></div>
                        @if (_saveFilterPromptOpen)
                        {
                            <div class="px-3 py-1.5">
                                <label class="mb-1 block text-[10px] font-semibold text-slate-500 dark:text-slate-400">Namn på filter</label>
                                <input type="text"
                                       class="w-full rounded border border-slate-300 bg-white px-2 py-1 text-[11px] text-slate-800 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500/30 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
                                       placeholder="T.ex. Kalkyler att granska"
                                       @bind="_saveFilterName"
                                       @bind:event="oninput" />
                                @if (!string.IsNullOrEmpty(_saveFilterError))
                                {
                                    <p class="mt-1 text-[10px] text-red-600 dark:text-red-400">@_saveFilterError</p>
                                }
                                <div class="mt-1.5 flex items-center gap-1.5">
                                    <button type="button"
                                            class="inline-flex h-6 items-center rounded bg-blue-600 px-2 text-[11px] font-semibold text-white transition hover:bg-blue-700 disabled:cursor-not-allowed disabled:opacity-50"
                                            disabled="@(string.IsNullOrWhiteSpace(_saveFilterName))"
                                            @onclick="SaveCurrentCalcFilterAsync">
                                        Spara
                                    </button>
                                    <button type="button"
                                            class="inline-flex h-6 items-center rounded border border-slate-200 bg-white px-2 text-[11px] font-medium text-slate-600 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800"
                                            @onclick="() => { _saveFilterPromptOpen = false; _saveFilterError = null; }">
                                        Avbryt
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <button type="button"
                                    class="flex w-full items-center gap-2 px-3 py-1.5 text-[11px] text-slate-700 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-40 dark:text-slate-200 dark:hover:bg-slate-800"
                                    disabled="@(!CanSaveCurrentCalcFilter)"
                                    title="@(MatchingSavedCalcFilter is not null ? "Detta filter är redan sparat." : null)"
                                    @onclick="OpenSaveFilterPrompt">
                                <svg class="h-3 w-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" /></svg>
                                <span>Spara aktuellt filter</span>
                            </button>
                            @if (MatchingSavedCalcFilter is { } matchedCalcFilter)
                            {
                                <div class="flex items-start gap-1.5 px-3 pb-1.5 pt-0.5 text-[10px] text-slate-500 dark:text-slate-400">
                                    <svg class="mt-0.5 h-3 w-3 shrink-0 text-emerald-500 dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                    <span>Aktuellt filter matchar sparat filter: <span class="font-semibold text-slate-600 dark:text-slate-300">@matchedCalcFilter.Name</span></span>
                                </div>
                            }
                        }
                        <button type="button"
                                class="flex w-full items-center gap-2 px-3 py-1.5 text-[11px] text-red-600 hover:bg-red-50 disabled:cursor-not-allowed disabled:opacity-40 dark:text-red-400 dark:hover:bg-red-950/30"
                                disabled="@(!HasActiveFilters)"
                                @onclick="() => { ClearFilters(); CloseCalcFilterMenu(); }">
                            <svg class="h-3 w-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                            <span>Rensa filter</span>
                        </button>

                        @* ── Filter använder dold kolumn ── *@
                        @if (HasHiddenActiveFilterColumns)
                        {
                            <HiddenFilterColumnsNotice Mode="HiddenFilterNoticeMode.Inline"
                                                       Label="@HiddenActiveFilterColumnsLabel"
                                                       OnReveal="RevealFilterColumnsAsync" />
                        }

                        @* ── Sparade filter ── *@
                        <div class="my-1 border-t border-slate-100 dark:border-slate-800"></div>
                        <div class="px-3 pt-0.5 pb-0.5">
                            <span class="text-[10px] font-semibold tracking-wide text-slate-400 dark:text-slate-500">Sparade filter</span>
                        </div>
                        @if (_savedCalcFilters.Count == 0)
                        {
                            <span class="block px-3 pb-1.5 text-[11px] text-slate-400 dark:text-slate-500">Inga sparade filter ännu.</span>
                        }
                        else
                        {
                            <div class="max-h-44 overflow-y-auto pb-1">
                                @foreach (var saved in _savedCalcFilters)
                                {
                                    var savedFilter = saved;
                                    <div class="flex items-center gap-1 px-3 py-1 hover:bg-slate-50 dark:hover:bg-slate-800">
                                        <button type="button"
                                                class="flex min-w-0 flex-1 items-center gap-2 text-left text-[11px] text-slate-700 dark:text-slate-200"
                                                title="Använd: @savedFilter.Name"
                                                @onclick="() => ApplyCalcSavedFilterAsync(savedFilter)">
                                            <svg class="h-3 w-3 shrink-0 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2a1 1 0 01-.293.707L13 13.414V19a1 1 0 01-.553.894l-4 2A1 1 0 017 21v-7.586L3.293 6.707A1 1 0 013 6V4z" /></svg>
                                            <span class="truncate">@savedFilter.Name</span>
                                            <span class="shrink-0 rounded-full bg-slate-100 px-1.5 text-[9px] font-semibold text-slate-500 dark:bg-slate-800 dark:text-slate-400">@savedFilter.Filters.Count</span>
                                        </button>
                                        <button type="button"
                                                class="shrink-0 rounded p-0.5 text-slate-400 transition hover:bg-red-50 hover:text-red-600 dark:hover:bg-red-950/30 dark:hover:text-red-400"
                                                title="Ta bort: @savedFilter.Name"
                                                @onclick="() => DeleteCalcSavedFilterAsync(savedFilter)">
                                            <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                @* ── Flytande notice: filter använder dold kolumn (visas även när menyn är stängd) ── *@
                @if (ShowHiddenFilterNotice)
                {
                    <HiddenFilterColumnsNotice Mode="HiddenFilterNoticeMode.Floating"
                                               Title="@HiddenFilterColumnTitle"
                                               Help="@HiddenFilterColumnHelp"
                                               OnReveal="RevealFilterColumnsAsync"
                                               OnDismiss="DismissHiddenFilterNotice" />
                }
            </div>

            @* Vy dropdown *@
            <div class="relative">
                <button type="button"
                        class="@(ViewBadgeCount > 0 ? "inline-flex h-7 items-center gap-1 rounded border border-blue-300 bg-blue-50 px-2 text-[11px] font-medium text-blue-700 transition dark:border-blue-800 dark:bg-blue-950/40 dark:text-blue-300" : "inline-flex h-7 items-center gap-1 rounded border border-slate-200 bg-white px-2 text-[11px] font-medium text-slate-600 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800")"
                        @onclick="() => _viewMenuOpen = !_viewMenuOpen">
                    <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                    </svg>
                    <span>@AppLoc["view"]</span>
                    @if (ViewBadgeCount > 0)
                    {
                        <span class="inline-flex h-4 min-w-[1rem] items-center justify-center rounded-full bg-blue-600 px-1 text-[9px] font-bold leading-none text-white dark:bg-blue-500">@ViewBadgeCount</span>
                    }
                    <svg class="h-2.5 w-2.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                    </svg>
                </button>
                @if (_viewMenuOpen)
                {
                    <div class="fixed inset-0 z-[70]" @onclick="() => _viewMenuOpen = false"></div>
                    <div class="absolute left-0 top-full z-[90] mt-1 w-72 rounded-md border border-slate-200 bg-white py-1 shadow-lg dark:border-slate-700 dark:bg-slate-900">

                        @* Innehåll *@
                        <div class="px-3 pt-1.5 pb-0.5">
                            <span class="text-[10px] font-semibold tracking-wide text-slate-400 dark:text-slate-500">Innehåll</span>
                        </div>
                        <button type="button"
                                class="@(_contentMode == ContentModeCalculations ? "flex w-full items-center gap-2 px-3 py-1.5 text-[11px] text-blue-700 dark:text-blue-300" : "flex w-full items-center gap-2 px-3 py-1.5 text-[11px] text-slate-700 hover:bg-slate-50 dark:text-slate-200 dark:hover:bg-slate-800")"
                                @onclick="() => { _contentMode = ContentModeCalculations; _viewMenuOpen = false; }">
                            <svg class="h-3 w-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 11h.01M12 11h.01M15 11h.01M4 5h16a1 1 0 011 1v12a1 1 0 01-1 1H4a1 1 0 01-1-1V6a1 1 0 011-1z" />
                            </svg>
                            <span class="flex-1 text-left">Kalkyler</span>
                            @if (_contentMode == ContentModeCalculations)
                            {
                                <svg class="ml-auto h-3 w-3 shrink-0 text-blue-600 dark:text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
                            }
                        </button>
                        <button type="button"
                                class="@(FolderScopeMode ? "flex w-full items-center gap-2 px-3 py-1.5 text-[11px] text-slate-700 hover:bg-slate-50 dark:text-slate-200 dark:hover:bg-slate-800" : "flex w-full items-center gap-2 px-3 py-1.5 text-[11px] text-slate-400 dark:text-slate-600 cursor-not-allowed")"
                                disabled="@(!FolderScopeMode)"
                                title="@(FolderScopeMode ? null : "Projekt innehåller inte andra projekt. Välj Kalkyler för att visa projektets kalkyler.")"
                                @onclick="async () => await ShowProjectsAsync()">
                            <svg class="h-3 w-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.5 5.5h15v13h-15z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9h8M8 13h5" />
                            </svg>
                            <span class="flex-1 text-left">Projekt</span>
                        </button>

                        @* Separator *@
                        <div class="my-1 border-t border-slate-100 dark:border-slate-800"></div>

                        @* Visa alla versioner (only for Kalkyler mode) *@
                        @if (_contentMode == ContentModeCalculations)
                        {
                        <div title="@(!HasAnyMultipleVersionsInCurrentView ? AppLoc["noCalcsMultiVersions"].Value : null)">
                            <button type="button"
                                    class="@(_showAllVersions ? "flex w-full items-center gap-2 px-3 py-1.5 text-[11px] text-blue-700 dark:text-blue-300" : "flex w-full items-center gap-2 px-3 py-1.5 text-[11px] text-slate-700 hover:bg-slate-50 dark:text-slate-200 dark:hover:bg-slate-800") + " disabled:cursor-not-allowed disabled:opacity-40"
                                    disabled="@(!HasAnyMultipleVersionsInCurrentView)"
                                    @onclick="async () => { _showAllVersions = !_showAllVersions; ResetPage(); }">
                                <svg class="h-3 w-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2" />
                                </svg>
                                <span class="flex-1 text-left">@AppLoc["showAllVersions"]</span>
                                @if (_showAllVersions)
                                {
                                    <svg class="ml-auto h-3 w-3 shrink-0 text-blue-600 dark:text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
                                }
                            </button>
                        </div>
                        }

                        @* Separator *@
                        <div class="my-1 border-t border-slate-100 dark:border-slate-800"></div>

                        <ColumnViewMenu Manager="_columnView"
                                        ColumnOptions="CalculationColumnOptions"
                                        OnViewApplied="CloseColumnViewMenus"
                                        OnColumnsChanged="StateHasChanged" />

                    </div>
                }
            </div>

            @* Rapporter dropdown *@
            <div class="relative">
                <button type="button"
                        class="inline-flex h-7 items-center gap-1 rounded border border-slate-200 bg-white px-2 text-[11px] font-medium text-slate-600 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-40 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800"
                        disabled="@(!CanOpenReports)"
                        @onclick="() => _reportMenuOpen = !_reportMenuOpen">
                    <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    <span>@AppLoc["reports"]</span>
                    <svg class="h-2.5 w-2.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                    </svg>
                </button>
                @if (_reportMenuOpen)
                {
                    <div class="fixed inset-0 z-[70]" @onclick="() => _reportMenuOpen = false"></div>
                    <div class="absolute right-0 top-full z-[90] mt-1 w-52 rounded-md border border-slate-200 bg-white py-1 shadow-lg dark:border-slate-700 dark:bg-slate-900">
                        @foreach (var item in CalcReportMenuItems)
                        {
                            var itemView = item.View;
                            <button type="button"
                                    class="@(item.Enabled ? "flex w-full items-center gap-2 px-3 py-1.5 text-[11px] text-slate-700 hover:bg-slate-50 dark:text-slate-200 dark:hover:bg-slate-800" : "flex w-full cursor-not-allowed items-center gap-2 px-3 py-1.5 text-[11px] text-slate-400 dark:text-slate-600")"
                                    disabled="@(!item.Enabled)"
                                    title="@item.DisabledReason"
                                    @onclick="() => { _reportMenuOpen = false; OpenReport(itemView); }">
                                <span>@AppLoc[item.LabelKey]</span>
                            </button>
                        }
                    </div>
                }
            </div>

            <div class="h-4 w-px bg-slate-200 dark:bg-slate-700"></div>

            <AuthorizeView Roles="@PMRolesConst.Tenant.AdminManger">
                @{
                    var noProjectContext = FolderScopeMode || Folder.State.OtherDepartment || Folder.State.ProjectSelected is null;
                }
                @* Split button: primary creates a new calculation, the caret opens import. *@
                <div class="relative inline-flex">
                    <button type="button"
                            class="inline-flex h-7 shrink-0 items-center gap-1 rounded-l border border-emerald-400 bg-emerald-500 px-2 text-[11px] font-semibold text-white transition hover:bg-emerald-600 disabled:cursor-not-allowed disabled:opacity-40 dark:border-emerald-600 dark:bg-emerald-600 dark:hover:bg-emerald-700"
                            disabled="@noProjectContext"
                            title="@AppLoc["newCalculation"]"
                            @onclick="() => UpdateForm(new ListCalculationMVVM())">
                        <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
