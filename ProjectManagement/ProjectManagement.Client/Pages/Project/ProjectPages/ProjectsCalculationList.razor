    private string BuildScopeLoadKey()
    {
        if (!FolderScopeMode)
            return Folder.State.ProjectSelected?.Id.ToString() ?? string.Empty;

        var folderId = Folder.State.FolderSelected?.Id.ToString() ?? string.Empty;
        var departmentId = Folder.State.SelectedDepartmentId?.ToString() ?? string.Empty;
        return $"{IsDepartmentScope}:{folderId}:{departmentId}:{Folder.State.OtherDepartment}:{UoWService.Folder.ShowArchived}";
    }

    private async Task LoadScopeCalculationsAsync(bool forceReload)
    {
        _loadingScopeCalculations = true;
        StateHasChanged();

        var source = new List<(FolderMVVM Folder, ListProjectMVVM Project)>();

        if (IsDepartmentScope)
        {
            foreach (var folder in Folder.State.FoldersList)
            {
                if (!folder.ProjectsLoaded)
                    await Folder.SetProjectsToFolder(folder);

                foreach (var project in folder.Projects ?? [])
                    source.Add((folder, project));
            }
        }
        else if (Folder.State.FolderSelected is { } selectedFolder)
        {
            if (!selectedFolder.ProjectsLoaded)
                await Folder.SetProjectsToFolder(selectedFolder);

            foreach (var project in selectedFolder.Projects ?? [])
                source.Add((selectedFolder, project));
        }

        var rows = new List<ScopeCalculationRow>();
        foreach (var (folder, project) in source)
        {
            if (forceReload)
                project.CalculationsLoaded = false;

            if (!project.CalculationsLoaded)
                await Folder.SetCalcsToProject(project);

            var calcs = project.Calculations ?? [];
            foreach (var calculation in calcs)
                rows.Add(new ScopeCalculationRow(folder, project, calculation));
        }

        _scopeCalculationRows = rows;
        _scopeCalculationLookup = rows
            .GroupBy(row => row.Calculation.Id)
            .ToDictionary(group => group.Key, group => group.First());
        _loadingScopeCalculations = false;
        _currentPage = 1;
    }

