@using BlazorMHD.UI.Components.Navigation.Tabs
@using ProjectManagement.Client.Constant
@using Calculation
@using Calculation.Form
@using Calculation.HourlyPriceList
@using Calculation.Income
@using Calculation.Share
@using Calculation.Tender
@using ProjectManagement.Client.Services.Folder
@using ProjectManagement.Client.Helper
@using ProjectManagement.Client.Shared.MVVM.Calculation
@using Microsoft.AspNetCore.Authorization
@using ProjectManagement.Client.Shared.MVVM.Folder
@using ProjectManagement.Shared.DTO.Project
@inject AuthenticationStateProvider AuthenticationStateProvider
@attribute [Authorize]
@using ProjectManagement.Shared.Enums
@using BlazorMHD.UI.Core.Data
@using BlazorMHD.UI.Core.DesignSystem
@using BlazorMHD.UI.Components.Data.ColumnPicker
@using BlazorMHD.UI.Core.Navigation
@using NavTabItem = BlazorMHD.UI.Core.Navigation.TabItem

@inherits AppComponentBase

<div class="ml-1">

    @* ── Header toolbar ─────────────────────────────────── *@
    <div class="flex w-full flex-wrap items-center justify-between gap-2 p-1">
        <div class="min-w-0">
            <div class="flex flex-col text-gray-700 dark:text-gray-300">
                <span class="truncate text-sm font-semibold">
                    @AppLoc["calculationsInProjectFormat", Folder.State.ProjectSelected?.Name ?? "-"]
                </span>
                <span class="truncate text-xs text-slate-500 dark:text-slate-400">
                    @AppLoc["folderNameFormat", Folder.State.FolderSelected?.Name ?? "-"]
                    @if (!string.IsNullOrWhiteSpace(Folder.State.ProjectSelected?.Code))
                    {
                        <span> · @AppLoc["projectCodeFormat", Folder.State.ProjectSelected?.Code ?? "-"]</span>
                    }
                    <span> · @SortedCalculations.Count() @CalcResource.calculation</span>
                </span>
            </div>
        </div>

        <div class="flex flex-wrap items-center gap-2">
            <label class="inline-flex h-9 cursor-pointer items-center gap-2 rounded-lg border border-slate-300 bg-white px-3 text-sm font-medium text-slate-700 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800">
                <input type="checkbox"
                       class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 dark:border-slate-600 dark:bg-slate-800"
                       @bind="_showAllVersions" />
                <span>@AppLoc["showAllVersions"]</span>
            </label>

            <MhdColumnPicker Text="@AppLoc["columns"]"
                             Columns="@CalculationColumnOptions"
                             ColumnVisibility="_calculationColumns"
                             OnChanged="StateHasChanged" />

            <button type="button"
                    class="inline-flex h-9 items-center gap-1.5 rounded-lg border border-sky-300 bg-sky-50 px-3 text-sm font-semibold text-sky-700 transition hover:bg-sky-100 disabled:cursor-not-allowed disabled:opacity-50 dark:border-sky-900/60 dark:bg-sky-950/30 dark:text-sky-300 dark:hover:bg-sky-950/50"
                    disabled="@(Folder.State.ProjectSelected is null)"
                    title="@AppLoc["incomeOverview"]"
                    @onclick="OpenIncomeOverview">
                <span>@AppLoc["incomeOverview"]</span>
            </button>

            <AuthorizeView Roles="@PMRolesConst.Tenant.AdminManger">
                @if (!Folder.State.OtherDepartment)
                {
                    <button type="button"
                            class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-slate-300 bg-white text-sm font-medium text-slate-700 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
                            title="Uppdatera"
                            @onclick="RefreshCalculationsAsync">
                        <span aria-hidden="true">@((MarkupString)Icons.GetVisibleIcon(IaVisible))</span>
                    </button>
                }

                <button type="button"
                        class="inline-flex h-9 shrink-0 items-center gap-1.5 rounded-lg border border-emerald-300 bg-emerald-50 px-3 text-sm font-semibold text-emerald-700 transition hover:bg-emerald-100 disabled:cursor-not-allowed disabled:opacity-50 dark:border-emerald-900/60 dark:bg-emerald-950/30 dark:text-emerald-300 dark:hover:bg-emerald-950/50"
                        disabled="@(Folder.State.OtherDepartment || Folder.State.ProjectSelected is null)"
                        title="@AppLoc["newCalculation"]"
                        @onclick="() => UpdateForm(new ListCalculationMVVM())">
                    <span aria-hidden="true">@((MarkupString)Icons.Plus)</span>
                    <span>@AppLoc["newCalculation"]</span>
                </button>
            </AuthorizeView>
        </div>
    </div>

    @* ── Calculation table ──────────────────────────────── *@
    @if (SortedCalculations.Any())
    {
        <div class="mr-1 overflow-x-auto rounded-lg border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-950">
            <table class="min-w-full table-auto text-left text-xs">
                <thead class="bg-slate-50 text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:bg-slate-900 dark:text-slate-400">
                    <tr>
                        @if (IsCalculationColumnVisible("code"))
                        {
                            <th class="@SortableHeaderClass("code")" @onclick='() => SortBy("code")'>
                                <span class="inline-flex items-center gap-1">@CalcResource.code @((MarkupString)SortIndicatorHtml("code"))</span>
                            </th>
                        }
                        @if (IsCalculationColumnVisible("name"))
                        {
                            <th class="@SortableHeaderClass("name") min-w-52" @onclick='() => SortBy("name")'>
                                <span class="inline-flex items-center gap-1">@AppLoc["calculationName"] @((MarkupString)SortIndicatorHtml("name"))</span>
                            </th>
                        }
                        @if (IsCalculationColumnVisible("calculationType"))
                        {
                            <th class="@SortableHeaderClass("calculationType")" @onclick='() => SortBy("calculationType")'>
                                <span class="inline-flex items-center gap-1">Kalkyltyp @((MarkupString)SortIndicatorHtml("calculationType"))</span>
                            </th>
                        }
                        @if (IsCalculationColumnVisible("status"))
                        {
                            <th class="@SortableHeaderClass("status")" @onclick='() => SortBy("status")'>
                                <span class="inline-flex items-center gap-1">@CalcResource.status @((MarkupString)SortIndicatorHtml("status"))</span>
                            </th>
                        }
                        @if (IsCalculationColumnVisible("responsible"))
                        {
                            <th class="@SortableHeaderClass("responsible")" @onclick='() => SortBy("responsible")'>
                                <span class="inline-flex items-center gap-1">@CalcResource.responsible @((MarkupString)SortIndicatorHtml("responsible"))</span>
                            </th>
                        }
                        @if (IsCalculationColumnVisible("start"))
                        {
                            <th class="@SortableHeaderClass("start")" @onclick='() => SortBy("start")'>
                                <span class="inline-flex items-center gap-1">@CalcResource.startDate @((MarkupString)SortIndicatorHtml("start"))</span>
                            </th>
                        }
                        @if (IsCalculationColumnVisible("end"))
                        {
                            <th class="@SortableHeaderClass("end")" @onclick='() => SortBy("end")'>
                                <span class="inline-flex items-center gap-1">@CalcResource.endDate @((MarkupString)SortIndicatorHtml("end"))</span>
                            </th>
                        }
                        @if (IsCalculationColumnVisible("deadline"))
                        {
                            <th class="@SortableHeaderClass("deadline")" @onclick='() => SortBy("deadline")'>
                                <span class="inline-flex items-center gap-1">@CalcResource.tenderDeadline @((MarkupString)SortIndicatorHtml("deadline"))</span>
                            </th>
                        }
                        @if (IsCalculationColumnVisible("qa"))
                        {
                            <th class="@SortableHeaderClass("qa")" @onclick='() => SortBy("qa")'>
                                <span class="inline-flex items-center gap-1">@CalcResource.tenderQA @((MarkupString)SortIndicatorHtml("qa"))</span>
                            </th>
                        }
                        @if (IsCalculationColumnVisible("privacy"))
                        {
                            <th class="whitespace-nowrap px-3 py-2">@ResourceApp._private</th>
                        }
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                    @foreach (var calu in SortedCalculations)
                    {
                        var isSelected = Folder.State.Calculation?.Id == calu.Id;
                        var rowClasses = GetCalculationRowClass(calu, isSelected);

                        <tr @key="calu.Id"
                            class="@rowClasses"
                            @oncontextmenu:preventDefault
                            @oncontextmenu="() => Context(calu)"
                            @onclick="async () => await NewCalculation(calu.Id)"
                            @ondrop="async _ => await HandleDrop(calu)"
                            @ondragleave="() => calu.IsDragOver = false"
                            @ondragover:preventDefault="true"
                            @ondragover="() => calu.IsDragOver = calcDraging is not null"
                            @ondragstart="() => calcDraging = calu"
                            @ondragend="() => calcDraging = null"
                            draggable="true">
                            @if (IsCalculationColumnVisible("code"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 font-mono text-[11px] text-slate-500 dark:text-slate-400">
                                    @FormatText(calu.Code)
                                </td>
                            }
                            @if (IsCalculationColumnVisible("name"))
                            {
                                <td class="max-w-80 px-3 py-2">
                                    <span class="block truncate font-semibold text-slate-800 dark:text-slate-100" title="@calu.Name">@GetCalculationVersionTitle(calu)</span>
                                    <div class="mt-1 flex flex-wrap items-center gap-1.5" @onclick:stopPropagation="true">
                                        <span class="@GetVersionBadgeClass(calu)">
                                            @(calu.IsCurrentVersion ? "Aktuell" : "Äldre version")
                                        </span>
                                        <button type="button"
                                                class="rounded-md border border-slate-300 px-2 py-0.5 text-[11px] font-medium text-slate-600 transition hover:bg-slate-50 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800"
                                                @onclick="() => OpenVersionsDialog(calu)">
                                            Visa versioner
                                        </button>
                                        @if (calu.IsCurrentVersion)
                                        {
                                            <button type="button"
                                                    class="rounded-md border border-blue-300 bg-blue-50 px-2 py-0.5 text-[11px] font-semibold text-blue-700 transition hover:bg-blue-100 disabled:cursor-not-allowed disabled:opacity-50 dark:border-blue-900/60 dark:bg-blue-950/30 dark:text-blue-300 dark:hover:bg-blue-950/50"
                                                    disabled="@_isCreatingVersion"
                                                    @onclick="() => CreateNewVersionAsync(calu)">
                                                Skapa ny version
                                            </button>
                                        }
                                    </div>
                                    @if (calu.IsLocked)
                                    {
                                        <div class="mt-1 flex flex-wrap items-center gap-1">
                                            <span class="inline-flex items-center gap-1 rounded-full bg-amber-100 px-2 py-0.5 text-[11px] font-semibold text-amber-700 dark:bg-amber-950/50 dark:text-amber-300">
                                                <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                                                </svg>
                                                @(calu.CalculationType == CalculationVersionType.Production ? "Produktionskalkyl · Låst" : "Anbudskalkyl · Låst")
                                            </span>
                                        </div>
                                    }
                                </td>
                            }
                            @if (IsCalculationColumnVisible("calculationType"))
                            {
                                <td class="whitespace-nowrap px-3 py-2" @onclick:stopPropagation="true">
                                    @if (calu.IsLocked)
                                    {
                                        <div class="flex flex-col gap-1">
                                            <span class="text-xs font-semibold text-slate-700 dark:text-slate-200">
                                                @GetCalculationTypeLabel(calu.CalculationType) · Låst
                                            </span>
                                            @if (CanCreateProductionCalculation(calu))
                                            {
                                                <button type="button"
                                                        class="w-fit rounded-md border border-emerald-500 bg-emerald-600 px-2 py-1 text-[11px] font-semibold text-white transition hover:bg-emerald-700 dark:border-emerald-500 dark:bg-emerald-500 dark:hover:bg-emerald-600"
                                                        @onclick="() => OpenProductionDialog(calu)">
                                                    Skapa produktionskalkyl
                                                </button>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="@GetCalcTypeBadgeClass(calu)">
                                            @GetCalculationTypeLabel(calu.CalculationType)
                                        </span>
                                    }
                                </td>
                            }
                            @if (IsCalculationColumnVisible("status"))
                            {
                                <td class="whitespace-nowrap px-3 py-2">
                                    <span class="inline-flex items-center gap-1.5">
                                        <span class="h-2 w-2 shrink-0 rounded-full @GetStatusDotClass(calu)"></span>
                                        <span class="text-slate-700 dark:text-slate-200">@GetCalculationStatusText(calu)</span>
                                    </span>
                                </td>
                            }
                            @if (IsCalculationColumnVisible("responsible"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatText(calu.Responsible)</td>
                            }
                            @if (IsCalculationColumnVisible("start"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatDate(calu.StartDate)</td>
                            }
                            @if (IsCalculationColumnVisible("end"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatDate(calu.EndDate)</td>
                            }
                            @if (IsCalculationColumnVisible("deadline"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatDate(calu.TenderDeadline)</td>
                            }
                            @if (IsCalculationColumnVisible("qa"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatDate(calu.TenderQA)</td>
                            }
                            @if (IsCalculationColumnVisible("privacy"))
                            {
                                <td class="whitespace-nowrap px-3 py-2">
                                    <span class="inline-flex rounded-full px-2 py-0.5 text-[11px] font-semibold @(calu.IsPrivate ? "bg-amber-100 text-amber-700 dark:bg-amber-950/50 dark:text-amber-300" : "bg-slate-100 text-slate-500 dark:bg-slate-800 dark:text-slate-300")">
                                        @(calu.IsPrivate ? ResourceApp._private : "-")
                                    </span>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-6 py-12 text-center dark:border-slate-700 dark:bg-slate-950/60">
            <div class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">@CalcResource.calculation</div>
            <h3 class="mt-2 text-lg font-semibold text-slate-900 dark:text-slate-100">@AppLoc["calculationsEmptyState"]</h3>
            <p class="mt-2 text-sm leading-6 text-slate-500 dark:text-slate-400">@AppLoc["calculationsEmptyStateHint"]</p>
            @if (!Folder.State.OtherDepartment && Folder.State.ProjectSelected is not null)
            {
                <AuthorizeView Roles="@PMRolesConst.Tenant.AdminManger">
                    <button type="button"
                            class="mt-4 inline-flex items-center gap-1.5 rounded-lg border border-emerald-300 bg-emerald-50 px-4 py-2 text-sm font-semibold text-emerald-700 transition hover:bg-emerald-100 dark:border-emerald-900/60 dark:bg-emerald-950/30 dark:text-emerald-300 dark:hover:bg-emerald-950/50"
                            @onclick="() => UpdateForm(new ListCalculationMVVM())">
                        <span aria-hidden="true">@((MarkupString)Icons.Plus)</span>
                        <span>@AppLoc["newCalculation"]</span>
                    </button>
                </AuthorizeView>
            }
        </div>
    }
</div>

@* ── Production calculation dialog ──────────────────── *@
@if (_productionDialogCalculation is not null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/50 px-4 py-6">
        <div class="w-full max-w-lg rounded-lg border border-slate-200 bg-white p-5 shadow-2xl dark:border-slate-700 dark:bg-slate-900">
            <div class="space-y-3 text-slate-700 dark:text-slate-200">
                <h2 class="text-base font-semibold text-slate-900 dark:text-slate-50">Du håller på att skapa en produktionskalkyl.</h2>
                <p class="text-sm leading-6">
                    Den låsta anbudskalkylen kommer att sparas som historik.
                    En kopia skapas som produktionskalkyl och öppnas för fortsatt arbete.
                </p>
                <p class="text-sm font-medium text-slate-900 dark:text-slate-100">Vill du fortsätta?</p>
                @if (!string.IsNullOrWhiteSpace(_productionDialogMessage))
                {
                    <div class="rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-300">
                        @_productionDialogMessage
                    </div>
                }
            </div>
            <div class="mt-5 flex flex-wrap justify-end gap-2">
                <button type="button"
                        class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
                        disabled="@_isCreatingProductionCalculation"
                        @onclick="CancelProductionDialog">
                    Avbryt
                </button>
                <button type="button"
                        class="rounded-lg border border-emerald-500 bg-emerald-600 px-3 py-1.5 text-sm font-semibold text-white transition hover:bg-emerald-700 disabled:cursor-not-allowed disabled:opacity-50 dark:border-emerald-500 dark:bg-emerald-500 dark:hover:bg-emerald-600"
                        disabled="@_isCreatingProductionCalculation"
                        @onclick="CreateProductionCalculationAsync">
                    Skapa produktionskalkyl
                </button>
            </div>
        </div>
    </div>
}

@* ── Versions dialog ─────────────────────────────────── *@
@if (_versionDialogCalculation is not null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/50 px-4 py-6">
        <div class="w-full max-w-lg rounded-lg border border-slate-200 bg-white p-5 shadow-2xl dark:border-slate-700 dark:bg-slate-900">
            <div class="flex items-start justify-between gap-3">
                <div>
                    <h2 class="text-base font-semibold text-slate-900 dark:text-slate-50">Versioner</h2>
                    <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">@_versionDialogCalculation.Name</p>
                </div>
                <button type="button"
                        class="rounded-md border border-slate-300 px-2 py-1 text-sm text-slate-600 transition hover:bg-slate-50 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800"
                        @onclick="CloseVersionsDialog">
                    Stäng
                </button>
            </div>
            <div class="mt-4 space-y-2">
                @foreach (var version in GetVersions(_versionDialogCalculation))
                {
                    <div class="flex items-center justify-between gap-3 rounded-md border border-slate-200 px-3 py-2 dark:border-slate-700">
                        <div class="min-w-0">
                            <div class="flex flex-wrap items-center gap-2">
                                <span class="text-sm font-semibold text-slate-800 dark:text-slate-100">Version @version.VersionNumber</span>
                                @if (version.IsCurrentVersion)
                                {
                                    <span class="rounded-full bg-emerald-100 px-2 py-0.5 text-[11px] font-semibold text-emerald-700 dark:bg-emerald-950/50 dark:text-emerald-300">aktuell</span>
                                }
                            </div>
                            <div class="mt-0.5 truncate text-xs text-slate-500 dark:text-slate-400">
                                @FormatText(version.Status)
                            </div>
                        </div>
                        <button type="button"
                                class="shrink-0 rounded-md border border-slate-300 px-2 py-1 text-xs font-medium text-slate-700 transition hover:bg-slate-50 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
                                @onclick="async () => await OpenVersionAsync(version)">
                            Öppna
                        </button>
                    </div>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(_versionDialogMessage))
            {
                <div class="mt-4 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-300">
                    @_versionDialogMessage
                </div>
            }
        </div>
    </div>
}

@code {
    private ListCalculationMVVM? calcDraging;
    private bool IaVisible { get; set; } = true;
    private ListCalculationMVVM? _productionDialogCalculation;
    private bool _isCreatingProductionCalculation;
    private string _productionDialogMessage = string.Empty;
    private bool _showAllVersions;
    private ListCalculationMVVM? _versionDialogCalculation;
    private bool _isCreatingVersion;
    private string _versionDialogMessage = string.Empty;

    private string _sortColumn = "";
    private bool _sortAscending = true;

    private int Part { get; set; } = 1;

    private string _activeKey = "1";
    private string ActiveKey
    {
        get => _activeKey;
        set
        {
            _activeKey = value;
            if (int.TryParse(value, out var p))
                Part = p;
        }
    }

    private List<NavTabItem> Tabs => new()
    {
        new NavTabItem { Key = "1", Text = AppLoc["all"], Icon = "📄" },
        new NavTabItem { Key = "2", Text = CalcResource.active, Icon = "▶️" },
        new NavTabItem { Key = "3", Text = AppLoc["finished"], Icon = "✅" }
    };

    private readonly Dictionary<string, bool> _calculationColumns = new()
    {
        ["code"] = true,
        ["name"] = true,
        ["calculationType"] = true,
        ["status"] = true,
        ["responsible"] = true,
        ["start"] = false,
        ["end"] = true,
        ["deadline"] = true,
        ["qa"] = false,
        ["privacy"] = false
    };

    private List<MhdColumnPickerItem> CalculationColumnOptions => new()
    {
        new("code", CalcResource.code),
        new("name", AppLoc["calculationName"].Value),
        new("calculationType", "Kalkyltyp"),
        new("status", CalcResource.status),
        new("responsible", CalcResource.responsible),
        new("start", CalcResource.startDate),
        new("end", CalcResource.endDate),
        new("deadline", CalcResource.tenderDeadline),
        new("qa", CalcResource.tenderQA),
        new("privacy", ResourceApp._private)
    };

    private IEnumerable<ListCalculationMVVM> FilteredCalculations
    {
        get
        {
            var list = Folder.State.ProjectSelected?.Calculations
                       ?? Enumerable.Empty<ListCalculationMVVM>();

            if (!_showAllVersions)
                list = list.Where(c => c.IsCurrentVersion);

            return Part switch
            {
                2 => list.Where(c => c.EndDate >= DateTime.Today),
                3 => list.Where(c => c.EndDate < DateTime.Today),
                _ => list
            };
        }
    }

    private IEnumerable<ListCalculationMVVM> SortedCalculations
    {
        get
        {
            var list = FilteredCalculations;
            return _sortColumn switch
            {
                "code" => _sortAscending
                    ? list.OrderBy(x => x.Code)
                    : list.OrderByDescending(x => x.Code),
                "name" => _sortAscending
                    ? list.OrderBy(x => x.Name)
                    : list.OrderByDescending(x => x.Name),
                "calculationType" => _sortAscending
                    ? list.OrderBy(x => (int)x.CalculationType).ThenBy(x => x.IsLocked)
                    : list.OrderByDescending(x => (int)x.CalculationType).ThenByDescending(x => x.IsLocked),
                "status" => _sortAscending
                    ? list.OrderBy(x => x.StatusSortOrder ?? int.MaxValue).ThenBy(x => x.Status)
                    : list.OrderByDescending(x => x.StatusSortOrder ?? int.MinValue).ThenByDescending(x => x.Status),
                "responsible" => _sortAscending
                    ? list.OrderBy(x => x.Responsible)
                    : list.OrderByDescending(x => x.Responsible),
                "start" => _sortAscending
                    ? list.OrderBy(x => x.StartDate)
                    : list.OrderByDescending(x => x.StartDate),
                "end" => _sortAscending
                    ? list.OrderBy(x => x.EndDate)
                    : list.OrderByDescending(x => x.EndDate),
                "deadline" => _sortAscending
                    ? list.OrderBy(x => x.TenderDeadline)
                    : list.OrderByDescending(x => x.TenderDeadline),
                "qa" => _sortAscending
                    ? list.OrderBy(x => x.TenderQA)
                    : list.OrderByDescending(x => x.TenderQA),
                _ => list
            };
        }
    }

    private void SortBy(string column)
    {
        if (_sortColumn == column)
            _sortAscending = !_sortAscending;
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }
    }

    private string SortableHeaderClass(string column)
    {
        var active = _sortColumn == column;
        return "cursor-pointer select-none whitespace-nowrap px-3 py-2 transition " +
               (active ? "text-slate-800 dark:text-slate-200" : "hover:text-slate-700 dark:hover:text-slate-200");
    }

    private string SortIndicatorHtml(string column)
    {
        if (_sortColumn != column)
            return "<svg class=\"h-3 w-3 opacity-30\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M7 16V4m0 0L3 8m4-4l4 4M17 8v12m0 0l4-4m-4 4l-4-4\"/></svg>";

        return _sortAscending
            ? "<svg class=\"h-3 w-3\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 15l7-7 7 7\"/></svg>"
            : "<svg class=\"h-3 w-3\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 9l-7 7-7-7\"/></svg>";
    }

