    }

    private Task ExportCalculationListAsync() => ExportCalculationListAsync(pdfMode: false, printOnly: false);
    private Task ExportCalculationPdfAsync() => ExportCalculationListAsync(pdfMode: true, printOnly: true);
    private Task PrintCalculationListAsync() => ExportCalculationListAsync(pdfMode: false, printOnly: true);

    private async Task ExportCalculationListAsync(bool pdfMode, bool printOnly)
    {
        var columns = CalculationColumnOptions.Where(column => IsCalculationColumnVisible(column.Key)).ToList();
        if (ShowVersionColumn)
        {
            int nameIdx = columns.FindIndex(c => c.Key == "name");
            columns.Insert(nameIdx >= 0 ? nameIdx + 1 : columns.Count, new MhdColumnPickerItem("version", AppLoc["version"].Value));
        }
        var rows = SortedCalculations.Select(calculation => columns.Select(column => GetCalculationExportValue(calculation, column.Key)));
        var title = AppLoc["calculationListTitleFormat", Folder.State.ProjectSelected?.Name ?? "-"].Value;

        if (printOnly)
            await ReportExportInterop.PrintAsync(JS, title, columns.Select(column => column.Label), rows, pdfMode);
        else
            await ReportExportInterop.ExportExcelAsync(JS, "kalkyllista", title, columns.Select(column => column.Label), rows);
    }

    private object? GetCalculationExportValue(ListCalculationMVVM calculation, string key) => key switch
    {
        "code" => calculation.Code,
        "name" => calculation.Name,
        "calculationType" => GetCalculationTypeLabel(calculation.CalculationType),
        "status" => GetCalculationStatusText(calculation),
        "responsible" => calculation.Responsible,
        "inspector" => calculation.Inspector,
        "project" => calculation.ProjectName,
        "folder" => calculation.FolderName,
        "priority" => $"{calculation.Priority} %",
        "timeMonth" => calculation.TimeMonth,
        "tax" => $"{calculation.Tax} %",
        "start" => FormatDate(calculation.StartDate),
        "end" => FormatDate(calculation.EndDate),
        "deadline" => FormatDate(calculation.TenderDeadline),
        "qa" => FormatDate(calculation.TenderQA),
        "createdAt" => FormatDate(calculation.CreatedAt),
        "updatedAt" => calculation.UpdatedAt.HasValue ? FormatDate(calculation.UpdatedAt.Value) : "-",
        "version" => FormatVersion(calculation.VersionNumber),
        "archived" => calculation.IsVisible ? AppLoc["no"].Value : AppLoc["yes"].Value,
        "privacy" => calculation.IsPrivate ? AppLoc["yes"].Value : AppLoc["no"].Value,
        _ => string.Empty
    };

