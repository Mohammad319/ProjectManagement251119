                </div>
            </AuthorizeView>
        </div>
    </div>

    </div>@* ── End sticky header ─────────────────────────── *@

    @* ── Calculation table ──��───────────────────────────── *@
    @if (FolderScopeMode && _loadingScopeCalculations)
