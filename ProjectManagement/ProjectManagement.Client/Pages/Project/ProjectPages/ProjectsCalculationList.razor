    void OpenReport(string view)
    {
        if (!CanOpenReports)
            return;
        if (!CentralReportsDialog.IsReportEnabled(CentralReportsDialog.ReportHost.Calculations, view))
            return;

        // Exact calculation selection currently shown in the right-panel kalkyllista (all active
        // column filters + version mode already applied). The report must use precisely these.
        var filteredCalcs = FilteredCalculations.ToList();
        var lockedCalcIds = (IReadOnlyList<int>)filteredCalcs.Select(c => c.Id).Distinct().ToList();

        var filterParts = _calcColFilters
            .Where(kv => kv.Value.IsActive)
            .Select(kv => GetCalcFilterLabel(kv.Key, kv.Value))
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .ToList();

        var parameters = new Dictionary<string, object>
        {
            [nameof(CentralReportsDialog.InitialView)] = view,
            [nameof(CentralReportsDialog.Host)] = CentralReportsDialog.ReportHost.Calculations,
            [nameof(CentralReportsDialog.LockedCalculationIds)] = lockedCalcIds,
            [nameof(CentralReportsDialog.LockedShowAllVersions)] = _showAllVersions,
        };
        if (filterParts.Count > 0)
            parameters[nameof(CentralReportsDialog.SelectionFilterSummary)] = string.Join(" · ", filterParts);

        if (FolderScopeMode)
        {
            var filteredCalcIds = lockedCalcIds.ToHashSet();
            var lockedProjIds = (IReadOnlyList<Guid>)_scopeCalculationRows
                .Where(row => filteredCalcIds.Contains(row.Calculation.Id))
                .Select(row => row.Project.Id)
                .Distinct()
                .ToList();

            parameters[nameof(CentralReportsDialog.LockedProjectIds)] = lockedProjIds;

            var count = lockedProjIds.Count;
            string selLine = IsDepartmentScope
                ? $"Rapporten baseras på {count} projekt (från aktuell kalkyllista). Avdelning: {DepartmentName ?? "–"}."
                : $"Rapporten baseras på {count} projekt i mapp {Folder.State.FolderSelected?.Name ?? "–"}.";
            parameters[nameof(CentralReportsDialog.SelectionSummaryLine)] = selLine;

            if (!IsDepartmentScope && Folder.State.FolderSelected is not null)
                parameters[nameof(CentralReportsDialog.FolderScope)] = Folder.State.FolderSelected;
        }
        else
        {
            parameters[nameof(CentralReportsDialog.FolderScope)]   = Folder.State.FolderSelected!;
            parameters[nameof(CentralReportsDialog.ProjectScope)]  = Folder.State.ProjectSelected!;
            parameters[nameof(CentralReportsDialog.SelectionSummaryLine)] =
                $"Rapporten baseras på projektet {Folder.State.ProjectSelected?.Name ?? "–"}.";
        }

        Modal.ShowComponent<CentralReportsDialog>(
            AppLoc["reports"].Value,
            parameters,
            BlazorMHD.UI.Core.Services.MhdDialogSize.ExtraLarge);
    }

    private string GetCalcFilterLabel(string key, ColumnFilterState state)
    {
        var label = key switch
        {
            "code"            => "Kod",
            "name"            => "Kalkylnamn",
            "version"         => AppLoc["version"].Value,
            "project"         => "Projekt",
            "folder"          => "Mapp",
            "calculationType" => "Kalkyltyp",
            "calculationRole" => "Kalkylroll",
            "status"          => "Kalkylstatus",
            "responsible"     => "Ansvarig",
            "inspector"       => "Granskare",
            "deadline"        => "Anbudsdeadline",
            "qa"              => "Frågor/svar",
            "start"           => "Startdatum",
            "end"             => "Slutdatum",
            "address"         => "Adress",
            "createdAt"       => "Skapad",
            "updatedAt"       => "Senast ändrad",
            "priority"        => "Vinstchans",
            "timeMonth"       => AppLoc["projectDurationMonths"].Value,
            "tax"             => AppLoc["vatPercent"].Value,
            "archived"        => "Arkiverad",
            "privacy"         => "Privat",
            "access"          => "Åtkomst",
            _                 => key
        };
        return state.Type switch
        {
            ColumnFilterType.Text when state.TextOp == TextFilterOp.IsEmpty    => $"{label}: tom",
            ColumnFilterType.Text when state.TextOp == TextFilterOp.IsNotEmpty => $"{label}: ej tom",
            ColumnFilterType.Text     => $"{label}: {state.TextValue}",
            ColumnFilterType.Dropdown when state.SelectedValues.Count > 0 =>
                $"{label}: {string.Join(", ", state.SelectedValues)}",
            ColumnFilterType.Date when state.DateOp == DateFilterOp.IsEmpty    => $"{label}: tom",
            ColumnFilterType.Date when state.DateOp == DateFilterOp.IsNotEmpty => $"{label}: ej tom",
            ColumnFilterType.Date when state.DateOp == DateFilterOp.Between    => $"{label}: {state.DateFrom:yyyy-MM-dd}–{state.DateTo:yyyy-MM-dd}",
            ColumnFilterType.Date     => $"{label}: {state.DateFrom:yyyy-MM-dd}",
            ColumnFilterType.Number when state.NumberOp == NumberFilterOp.IsEmpty    => $"{label}: tom",
            ColumnFilterType.Number when state.NumberOp == NumberFilterOp.IsNotEmpty => $"{label}: ej tom",
            ColumnFilterType.Number when state.NumberOp == NumberFilterOp.Between    => $"{label}: {state.NumberFrom}–{state.NumberTo}",
            ColumnFilterType.Number   => $"{label}: {state.NumberFrom}",
            ColumnFilterType.Boolean  => $"{label}: {(state.BoolValue == "true" ? "Ja" : "Nej")}",
            _                         => label
        };
    }

    private Task ExportCalculationListAsync() => ExportCalculationListAsync(pdfMode: false, printOnly: false);
    private Task ExportCalculationPdfAsync() => ExportCalculationListAsync(pdfMode: true, printOnly: true);
    private Task PrintCalculationListAsync() => ExportCalculationListAsync(pdfMode: false, printOnly: true);

    private async Task ExportCalculationListAsync(bool pdfMode, bool printOnly)
    {
        // Row number is a visual helper column and is excluded from export/print.
        var columns = CalculationColumnOptions
            .Where(column => column.Key != "rowNumber" && IsCalculationColumnVisible(column.Key))
            .ToList();
        var rows = SortedCalculations.Select(calculation => columns.Select(column => GetCalculationExportValue(calculation, column.Key)));
        var title = FolderScopeMode
            ? $"Kalkyler i {(IsDepartmentScope ? DepartmentName : Folder.State.FolderSelected?.Name ?? "-")}"
            : AppLoc["calculationListTitleFormat", Folder.State.ProjectSelected?.Name ?? "-"].Value;

        if (printOnly)
            await ReportExportInterop.PrintAsync(JS, title, columns.Select(column => column.Label), rows, pdfMode);
        else
            await ReportExportInterop.ExportExcelAsync(JS, "kalkyllista", title, columns.Select(column => column.Label), rows);
    }

