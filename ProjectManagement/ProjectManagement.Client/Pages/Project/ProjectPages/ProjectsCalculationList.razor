                        <HeaderContent><span class="inline-flex items-center gap-1">@AppLoc["createdDate"] @((MarkupString)SortIndicatorHtml("createdAt")) <TableColumnFilter FilterState='CF("createdAt")' OnChanged="OnColumnFilterChanged" /></span></HeaderContent>
                    </MhdTableColumn>
                    <MhdTableColumn TItem="ListCalculationMVVM" Visible='IsCalculationColumnVisible("updatedAt")' ColumnKey="updatedAt" Order='@_columnView.OrderIndex("updatedAt")'
                                    HeaderClass='@SortableHeaderClass("updatedAt")' HeaderStyle="min-width:80px;" OnHeaderClick='() => SortBy("updatedAt")'>
                        <HeaderContent><span class="inline-flex items-center gap-1">@AppLoc["lastModified"] @((MarkupString)SortIndicatorHtml("updatedAt")) <TableColumnFilter FilterState='CF("updatedAt")' OnChanged="OnColumnFilterChanged" /></span></HeaderContent>
                    </MhdTableColumn>
                    <MhdTableColumn TItem="ListCalculationMVVM" Visible='IsCalculationColumnVisible("address")' ColumnKey="address" Order='@_columnView.OrderIndex("address")'
                                    HeaderClass='@SortableHeaderClass("address")' HeaderStyle="min-width:140px;" OnHeaderClick='() => SortBy("address")'>
                        <HeaderContent><span class="inline-flex items-center gap-1">Adress @((MarkupString)SortIndicatorHtml("address")) <TableColumnFilter FilterState='CF("address")' OnChanged="OnColumnFilterChanged" /></span></HeaderContent>
