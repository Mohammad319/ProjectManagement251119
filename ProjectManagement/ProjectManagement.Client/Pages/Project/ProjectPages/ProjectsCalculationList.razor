    void TenderPage(ListCalculationMVVM model)
    {
        Modal.ShowComponent<TenderListUI>(
            ResourceLoc.tender,
            new Dictionary<string, object>
            {
                [nameof(TenderListUI.Calculation)] = model
            },
            BlazorMHD.UI.Core.Services.MhdDialogSize.ExtraLarge);
    }

    private async Task ShowProjectsAsync()
    {
        _viewMenuOpen = false;
        if (OnShowProjectsRequested.HasDelegate)
            await OnShowProjectsRequested.InvokeAsync();
    }

    private async Task OpenCalculationAsync(ListCalculationMVVM calculation)
    {
        var project = GetCalculationProject(calculation);
        var folder = GetCalculationFolder(calculation);

        if (FolderScopeMode && project is not null && folder is not null)
        {
            Folder.State.SetCalculation(null, project, folder);
            await CalcService.SetCalc(calculation.Id, project, folder);
            return;
        }

        await CalcService.SetCalc(calculation.Id);
    }

    async Task CalcFormAsync(ListCalculationMVVM? calc)
    {
        if (calc is null)
        {
            await Modal.CloseAsync();
            return;
        }

        await ReloadCalculationsAsync(closeModal: true);
    }

    // Robust, id-based reorder WITHIN the current project only (never moves a calc to another
    // project): remove the dragged calc, re-insert relative to the drop target (after it when
    // moving down, before it when moving up — so the last row is reachable), then renumber the
    // whole project with stable gaps. No-ops when the order is unchanged.
    private async Task HandleDrop(ListCalculationMVVM target)
    {
        var dragged = calcDraging;
        calcDraging = null;

        if (dragged is not null) dragged.IsDragOver = false;
        if (target is not null) target.IsDragOver = false;

        if (dragged is null || target is null || !CanReorderCalculations || ReferenceEquals(dragged, target))
        {
            StateHasChanged();
            return;
        }

        var calculations = Folder.State.ProjectSelected?.Calculations;
        if (calculations is null)
            return;

        // Display order = top→bottom (highest Order first), matching the left tree and the project
        // list. Working by Id keeps the move independent of fragile UI row indexes.
        var ordered = calculations.OrderByDescending(c => c.Order).ToList();

        var fromIndex = ordered.FindIndex(c => c.Id == dragged.Id);
        var toIndex = ordered.FindIndex(c => c.Id == target.Id);
        if (fromIndex < 0 || toIndex < 0)
            return;

        var originalIds = ordered.Select(c => c.Id).ToList();

        ordered.RemoveAt(fromIndex);
        var targetAfterRemoval = ordered.FindIndex(c => c.Id == target.Id);
        // Moving down (dragged was above target) drops after the target; moving up drops before.
        var insertIndex = fromIndex < toIndex ? targetAfterRemoval + 1 : targetAfterRemoval;
        insertIndex = Math.Clamp(insertIndex, 0, ordered.Count);
        ordered.Insert(insertIndex, dragged);

        // Dropped back on the same effective position → save nothing, change nothing.
        if (ordered.Select(c => c.Id).SequenceEqual(originalIds))
        {
            StateHasChanged();
            return;
        }

        // Renumber the whole project so Order stays stable and collision-free (top = highest).
        // Only persist the calcs whose Order actually changed (backend sets SortOrder absolutely).
        const int step = 100;
        var changed = new List<ListCalculationMVVM>();
        for (var i = 0; i < ordered.Count; i++)
        {
            var newOrder = (ordered.Count - i) * step;
            if (ordered[i].Order != newOrder)
            {
                ordered[i].Order = newOrder;
                changed.Add(ordered[i]);
            }
        }

        // The right panel (default sort) and the left tree both render by Order over the same calc
        // objects, so mutating Order aligns them; Notify() makes the tree re-render now.
        Folder.State.Notify();
        StateHasChanged();

        foreach (var c in changed)
            await Repo.Calculation.ReOrderAsync(c.Id, c.Order);
    }

    private async Task ReloadCalculationsAsync(bool closeModal = false)
    {
        if (FolderScopeMode)
        {
            await LoadScopeCalculationsAsync(forceReload: true);
            UoWService.Folder.State.Notify();

            if (closeModal)
                await Modal.CloseAsync();

            return;
        }

        var project = Folder.State.ProjectSelected;
        if (project is null)
            return;

        if (UoWService.Folder.ShowArchived)
        {
            var active = await Repo.Calculation.GetAsync(project.Id, false);
            var archived = await Repo.Calculation.GetAsync(project.Id, true);
            project.Calculations = active.Concat(archived).OrderByDescending(x => x.Order).ToList();
        }
        else
        {
            project.Calculations = await Repo.Calculation.GetAsync(project.Id, false);
        }
        project.CalculationCount = CalculationVersionSelector.CountCurrentVersions(project.Calculations);
        UoWService.Folder.State.Notify();

        if (closeModal)
            await Modal.CloseAsync();
    }
}
