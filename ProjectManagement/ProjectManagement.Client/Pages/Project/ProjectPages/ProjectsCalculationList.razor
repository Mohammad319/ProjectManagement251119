    // Grupperad, flerradig tooltip för Åtkomst-kolumnen. Kalkyler delas inte separat i denna
    // version – åtkomsten styrs via projektets delning, vilket tooltipen förklarar tydligt.
    // viewerOnly = användaren har endast visningsåtkomst (Granskare/Visare) och får då en
    // hjälptext om granskningskommentarer i stället för "Klicka för detaljer".
    private string CalcAccessTooltip(ListCalculationMVVM c, bool viewerOnly)
    {
        var lines = new List<string>();

        if (c.IsPrivate)
        {
            lines.Add("Privat kalkyl");
            lines.Add("Endast behöriga personer kan se kalkylen.");
        }
        else
        {
            var recips = c.Access?.Recipients ?? [];

            if (recips.Count > 0)
            {
                // Kalkyler delas inte separat – åtkomsten kommer via projektets delning.
                // Här FÅR åtkomstnivån (Kan visa/Kan ändra) visas eftersom den gäller kalkylen.
                lines.Add("Delad via projektet");
                lines.Add("Kalkylen ingår i projektets delning.");

                var persons = recips.Where(r => r.Type == ProjectShareRecipientType.User).ToList();
                if (persons.Count > 0)
                {
                    lines.Add("Delade personer");
                    AccessSummaryFormatter.AppendRecipientLines(lines, persons, r => $"{r.Name} · {AccessSummaryFormatter.AccessLevelLabel(r.Role)}");
                }

                var depts = recips.Where(r => r.Type == ProjectShareRecipientType.Department).ToList();
                if (depts.Count > 0)
                {
                    lines.Add("Delade avdelningar");
                    AccessSummaryFormatter.AppendRecipientLines(lines, depts, r => $"{r.Name} · {AccessSummaryFormatter.AccessLevelLabel(r.Role)}");
                }
            }
            else
            {
                if (CalculationProjectHasSharing(c))
                {
                    lines.Add("Ingår inte i projektets delning");
                    lines.Add("Kalkylen ingår inte i den aktuella projektdelningen.");
                }
                else
                {
                    lines.Add("Avdelningsåtkomst");
                    lines.Add("Kalkylen är synlig via normal avdelningsåtkomst.");
                }
            }
        }

        lines.Add("Klicka för detaljer.");

        return string.Join("\n", lines);
    }

