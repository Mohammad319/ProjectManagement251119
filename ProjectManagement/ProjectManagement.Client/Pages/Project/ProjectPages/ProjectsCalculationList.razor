    private IEnumerable<ListCalculationMVVM> FilteredCalculations
    {
        get
        {
            var list = Folder.State.ProjectSelected?.Calculations
                       ?? Enumerable.Empty<ListCalculationMVVM>();

            if (!_showAllVersions)
                list = CalculationVersionSelector.SelectCurrentVersions(list);

            list = Part switch
            {
                2 => list.Where(c => c.EndDate >= DateTime.Today),
                3 => list.Where(c => c.EndDate < DateTime.Today),
                _ => list
            };

            if (!string.IsNullOrWhiteSpace(_filterStatus))
                list = list.Where(c => c.Status.Contains(_filterStatus, StringComparison.OrdinalIgnoreCase));

            if (!string.IsNullOrWhiteSpace(_filterCalcType))
            {
                if (_filterCalcType == "Production")
                    list = list.Where(c => c.CalculationType == CalculationVersionType.Production);
                else if (_filterCalcType == "Contract")
                    list = list.Where(c => c.CalculationType == CalculationVersionType.Contract);
                else if (_filterCalcType == "Tender")
                    list = list.Where(c => c.CalculationType == CalculationVersionType.Tender);
            }

            if (!string.IsNullOrWhiteSpace(_filterResponsible))
                list = list.Where(c => c.Responsible.Contains(_filterResponsible, StringComparison.OrdinalIgnoreCase));

            if (!string.IsNullOrWhiteSpace(_filterInspector))
                list = list.Where(c => c.Inspector.Contains(_filterInspector, StringComparison.OrdinalIgnoreCase));

            if (_filterDeadlineFrom.HasValue)
                list = list.Where(c => c.TenderDeadline.Date >= _filterDeadlineFrom.Value.Date);

            if (_filterDeadlineTo.HasValue)
                list = list.Where(c => c.TenderDeadline.Date <= _filterDeadlineTo.Value.Date);

            if (!string.IsNullOrWhiteSpace(_filterLocked))
            {
                bool locked = _filterLocked == "true";
                list = list.Where(c => c.IsLocked == locked);
            }

            if (!string.IsNullOrWhiteSpace(_filterMultipleVersions))
            {
                bool multi = _filterMultipleVersions == "true";
                var allCalcs = Folder.State.ProjectSelected?.Calculations ?? [];
                list = list.Where(c =>
                {
                    bool hasMulti = CalculationVersionSelector.HasMultipleVersions(allCalcs, c);
                    return hasMulti == multi;
                });
            }

            // ── Per-column filters ──────────────────────────────────
            if (_calcColFilters["code"].IsActive)
                list = list.Where(c => _calcColFilters["code"].MatchesText(c.Code));
            if (_calcColFilters["name"].IsActive)
                list = list.Where(c => _calcColFilters["name"].MatchesText(c.Name));
            if (_calcColFilters["calculationType"].IsActive)
                list = list.Where(c => _calcColFilters["calculationType"].MatchesDropdown(GetCalculationTypeLabel(c.CalculationType)));
            if (_calcColFilters["status"].IsActive)
                list = list.Where(c => _calcColFilters["status"].MatchesText(c.Status));
            if (_calcColFilters["responsible"].IsActive)
                list = list.Where(c => _calcColFilters["responsible"].MatchesText(c.Responsible));
            if (_calcColFilters["inspector"].IsActive)
                list = list.Where(c => _calcColFilters["inspector"].MatchesText(c.Inspector));
            if (_calcColFilters["qa"].IsActive)
                list = list.Where(c => _calcColFilters["qa"].MatchesDate(c.TenderQA == default ? null : c.TenderQA));
            if (_calcColFilters["deadline"].IsActive)
                list = list.Where(c => _calcColFilters["deadline"].MatchesDate(c.TenderDeadline == default ? null : c.TenderDeadline));
            if (_calcColFilters["start"].IsActive)
                list = list.Where(c => _calcColFilters["start"].MatchesDate(c.StartDate == default ? null : c.StartDate));
            if (_calcColFilters["end"].IsActive)
                list = list.Where(c => _calcColFilters["end"].MatchesDate(c.EndDate == default ? null : c.EndDate));
            if (_calcColFilters["createdAt"].IsActive)
                list = list.Where(c => _calcColFilters["createdAt"].MatchesDate(c.CreatedAt == default ? null : c.CreatedAt));
            if (_calcColFilters["updatedAt"].IsActive)
                list = list.Where(c => _calcColFilters["updatedAt"].MatchesDate(c.UpdatedAt));
            if (_calcColFilters["priority"].IsActive)
                list = list.Where(c => _calcColFilters["priority"].MatchesNumber((decimal?)c.Priority));
            if (_calcColFilters["timeMonth"].IsActive)
                list = list.Where(c => _calcColFilters["timeMonth"].MatchesNumber((decimal?)c.TimeMonth));
            if (_calcColFilters["tax"].IsActive)
                list = list.Where(c => _calcColFilters["tax"].MatchesNumber((decimal?)c.Tax));
            if (_calcColFilters["archived"].IsActive)
                list = list.Where(c => _calcColFilters["archived"].MatchesBool(!c.IsVisible));
            if (_calcColFilters["privacy"].IsActive)
                list = list.Where(c => _calcColFilters["privacy"].MatchesBool(c.IsPrivate));

            return list;
        }
    }

    private IEnumerable<ListCalculationMVVM> SortedCalculations
    {
        get
        {
            var list = FilteredCalculations;
            return _sortColumn switch
            {
                "code" => _sortAscending
                    ? list.OrderBy(x => x.Code)
                    : list.OrderByDescending(x => x.Code),
                "name" => _sortAscending
                    ? list.OrderBy(x => x.Name)
                    : list.OrderByDescending(x => x.Name),
                "calculationType" => _sortAscending
                    ? list.OrderBy(x => (int)x.CalculationType).ThenBy(x => x.IsLocked)
                    : list.OrderByDescending(x => (int)x.CalculationType).ThenByDescending(x => x.IsLocked),
                "status" => _sortAscending
                    ? list.OrderBy(x => x.StatusSortOrder ?? int.MaxValue).ThenBy(x => x.Status)
                    : list.OrderByDescending(x => x.StatusSortOrder ?? int.MinValue).ThenByDescending(x => x.Status),
                "responsible" => _sortAscending
                    ? list.OrderBy(x => x.Responsible)
                    : list.OrderByDescending(x => x.Responsible),
                "inspector" => _sortAscending
                    ? list.OrderBy(x => x.Inspector)
                    : list.OrderByDescending(x => x.Inspector),
                "project" => _sortAscending
                    ? list.OrderBy(x => x.ProjectName)
                    : list.OrderByDescending(x => x.ProjectName),
                "folder" => _sortAscending
                    ? list.OrderBy(x => x.FolderName)
                    : list.OrderByDescending(x => x.FolderName),
                "priority" => _sortAscending
                    ? list.OrderBy(x => x.Priority)
                    : list.OrderByDescending(x => x.Priority),
                "timeMonth" => _sortAscending
                    ? list.OrderBy(x => x.TimeMonth)
                    : list.OrderByDescending(x => x.TimeMonth),
                "tax" => _sortAscending
                    ? list.OrderBy(x => x.Tax)
                    : list.OrderByDescending(x => x.Tax),
                "start" => _sortAscending
                    ? list.OrderBy(x => x.StartDate)
                    : list.OrderByDescending(x => x.StartDate),
                "end" => _sortAscending
                    ? list.OrderBy(x => x.EndDate)
                    : list.OrderByDescending(x => x.EndDate),
                "deadline" => _sortAscending
                    ? list.OrderBy(x => x.TenderDeadline)
                    : list.OrderByDescending(x => x.TenderDeadline),
                "qa" => _sortAscending
                    ? list.OrderBy(x => x.TenderQA)
                    : list.OrderByDescending(x => x.TenderQA),
                "createdAt" => _sortAscending
                    ? list.OrderBy(x => x.CreatedAt)
                    : list.OrderByDescending(x => x.CreatedAt),
                "updatedAt" => _sortAscending
                    ? list.OrderBy(x => x.UpdatedAt)
                    : list.OrderByDescending(x => x.UpdatedAt),
                "version" => _sortAscending
                    ? list.OrderBy(x => x.VersionNumber)
                    : list.OrderByDescending(x => x.VersionNumber),
                _ => list
            };
        }
    }

    private void SortBy(string column)
    {
        if (_sortColumn == column)
            _sortAscending = !_sortAscending;
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }
        _currentPage = 1;
    }

