    private void CancelProductionDialog()
    {
        if (_isCreatingProductionCalculation)
            return;

        _productionDialogCalculation = null;
        _productionDialogMessage = string.Empty;
    }

    private async Task CreateProductionCalculationAsync()
    {
        if (_productionDialogCalculation is null || _isCreatingProductionCalculation)
            return;

        _isCreatingProductionCalculation = true;
        _productionDialogMessage = string.Empty;

        try
        {
            var newCalculationId = await Repo.Calculation.CreateProductionCopyAsync(_productionDialogCalculation.Id);
            if (newCalculationId <= 0)
            {
                _productionDialogMessage = AppLoc["productionCalculationCreateFailed"].Value;
                return;
            }

            _productionDialogCalculation = null;
            await ReloadCalculationsAsync();
            await CalcService.SetCalc(newCalculationId);
            MHD.Notifications(ToastType.Add, true);
        }
        catch (Exception ex)
        {
            _productionDialogMessage = AppLoc["productionCalculationCreateError"].Value;
            await ClientLog.ErrorAsync("Create production calculation failed", ex: ex);
        }
        finally
        {
            _isCreatingProductionCalculation = false;
        }
    }

    private string GetCalculationStatusText(ListCalculationMVVM calculation)
    {
        if (!string.IsNullOrWhiteSpace(calculation.Status))
            return calculation.Status;

        return calculation.EndDate < DateTime.Today ? AppLoc["finished"] : CalcResource.active;
    }

    private string GetCalculationStatusColor(ListCalculationMVVM calculation)
    {
        // Same shared color source as the folder tree; the date-derived colors only
        // apply when the calculation has no status at all (the text is derived too).
        if (!string.IsNullOrWhiteSpace(calculation.StatusColor) || !string.IsNullOrWhiteSpace(calculation.Status))
            return CalculationStatusColor.Resolve(calculation);

        return calculation.EndDate < DateTime.Today ? "#10b981" : "#f59e0b";
    }

    private static string GetCalculationRowClass(ListCalculationMVVM calculation, bool selected, bool canReorder)
    {
        var classes = new List<string>
        {
            canReorder ? "cursor-grab active:cursor-grabbing transition-colors" : "cursor-pointer transition-colors",
            "group",
            "hover:bg-slate-50 dark:hover:bg-slate-900/80"
        };

        if (selected)
            classes.Add("bg-violet-50 dark:bg-violet-950/30");

        if (calculation.IsDragOver)
            // Full-row drop line: an inset top box-shadow on every cell (see .pm-drop-row in
            // custom.css) so the blue line spans the whole row — including the sticky/frozen left
            // columns — without breaking at the sticky boundary and without any layout shift.
            classes.Add("pm-drop-row");

        return string.Join(" ", classes);
    }

    async Task Context(ListCalculationMVVM item)
    {
        var list = new List<MhdContextMenuItem>();

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var access = ContextMenuAccessPolicy.ForCalculation(authState.User, item.Access, Folder.State.OtherDepartment);

        // Grouped order (separated by dividers), identical to the left tree's calculation menu:
        // [huvudåtgärder] · [livscykel/hantering] · [export] · [ta bort].
        if (access.CanView)
        {
            list.Add(new() { IconHtml = Icons.Active, Label = AppLoc["openCalculation"], OnClickAsync = async () => await OpenCalculationAsync(item) });
            list.Add(new()
            {
                IconHtml = access.CanEditWork && item.IsCurrentVersion ? Icons.Edit : Icons.Details,
                Label = access.CanEditWork && item.IsCurrentVersion ? ResourceApp.edit : "Visa kalkyl",
                OnClickAsync = () => { UpdateForm(item, access.CanEditWork && item.IsCurrentVersion); return Task.CompletedTask; }
            });
            list.Add(new() { IconHtml = Icons.Details, Label = "Visa detaljer", OnClickAsync = () => { CalculationDetails(item); return Task.CompletedTask; } });

            if (GetCalculationProject(item) is { } projectForShare)
            {
                var projectAccess = ContextMenuAccessPolicy.ForProject(authState.User, projectForShare.Access, Folder.State.OtherDepartment);
                list.Add(new()
                {
                    IconHtml = Icons.PermissionShield,
                    Label = projectAccess.CanManageSharing ? "Delning och behörighet" : "Visa delning och behörighet",
                    OnClickAsync = () => { OpenProjectShareDialog(projectForShare, readOnly: !projectAccess.CanManageSharing); return Task.CompletedTask; }
                });
            }
        }

        if (access.CanManageLifecycle)
        {
            // Grupp 1 — huvudåtgärder (Versioner direkt efter Ändra)
            list.Add(new() { IsSeparator = true });
            list.Add(new() { IconHtml = Icons.Copy, Label = "Versioner", OnClickAsync = () => { OpenVersionsDialog(item); return Task.CompletedTask; } });

            // Grupp 2 — livscykel/hantering
            list.Add(new() { IsSeparator = true });
            // Delning sker på projektnivå – ingen separat kalkyldelning i kalkylmenyn (se ProjectShareUI).
            list.Add(new() { IconHtml = Icons.Folder, Label = AppLoc["moveCalculation"], OnClickAsync = () => { OpenMoveCopyDialog(item, MoveCopyOperation.Move); return Task.CompletedTask; } });
            list.Add(new() { IconHtml = Icons.Copy, Label = AppLoc["copyCalculation"], OnClickAsync = () => { OpenMoveCopyDialog(item, MoveCopyOperation.Copy); return Task.CompletedTask; } });

            if (!item.IsArchived)
                list.Add(new() { IconHtml = Icons.Archive, Label = AppLoc["archiveCalculation"], OnClickAsync = async () => await ArchiveOrRestoreCalculationAsync(item, archive: true) });
            else
                list.Add(new() { IconHtml = Icons.Restore, Label = AppLoc["restoreFromArchive"], OnClickAsync = async () => await ArchiveOrRestoreCalculationAsync(item, archive: false) });

            // Grupp 3 — export
            list.Add(new() { IsSeparator = true });
            list.Add(new() { IconHtml = Icons.Tender, Label = "Exportera kalkyl...", OnClickAsync = () => { OpenSendCalculationCopyDialog(item); return Task.CompletedTask; } });
        }

        // Grupp 4 — destruktiv åtgärd: "Ta bort kalkyl" / "Ta bort version" ligger alltid sist,
        // med separator före. Aktivt för olåsta kalkyler utan kritiska kopplingar; annars öppnas
        // en informationsdialog som förklarar varför borttagning inte är tillåten.
        var projectCalcs = GetProjectCalculationsFor(item).ToList();

        if (access.CanManageLifecycle)
        {
            list.Add(new() { IsSeparator = true });

            list.Add(new()
            {
                IconHtml = Icons.Delete,
                Label = CalculationDeleteHelper.DeleteLabel(projectCalcs, item),
                CssClass = CalculationDeleteHelper.DeleteCssClass,
                OnClickAsync = () => CalculationDeleteHelper.RequestDeleteAsync(
                    this, Repo, MHD, ClientLog, item, projectCalcs, access.CanManageLifecycle,
                    () => DeleteCalculationConfirmedAsync(item))
            });
        }

        await ContextService.ShowMenuAsync(list);
    }

    async Task DeleteCalculationConfirmedAsync(ListCalculationMVVM calculation)
    {
        bool ok;
        try
        {
            ok = await Repo.Calculation.DeleteAsync(calculation.Id);
        }
        catch (Exception ex)
        {
            await ClientLog.ErrorAsync("Delete calculation failed", ex: ex);
            MHD.Notifications(ToastType.Delete, false);
            return;
        }

        if (!ok)
        {
            // Bekräftelsedialogen stängs automatiskt (AutoClose); visa felmeddelande.
            MHD.Notifications(ToastType.Delete, false);
            return;
        }

        // Stäng öppen kalkyl om det var den som togs bort, uppdatera sedan lista + vänsterträd.
        var calcFolder = GetCalculationFolder(calculation);
        if (Folder.State.Calculation?.Id == calculation.Id && calcFolder is not null)
            Folder.State.SetCalculation(null, Folder.State.ProjectSelected, calcFolder);

        await ReloadCalculationsAsync();

        // Successmeddelande: "Kalkylen har tagits bort."
        MHD.ToastMessage(calculation.Name, ToastType.Delete, isSuccess: true);
    }

    async Task ArchiveOrRestoreCalculationAsync(ListCalculationMVVM cal, bool archive)
    {
        var dto = await Repo.Calculation.GetPostAsync(cal.Id);
        if (dto is null) return;
        dto.IsArchived = archive;
        bool ok = await Repo.Calculation.UpdateAsync(dto, cal.Id);
        if (ok)
        {
            await ReloadCalculationsAsync();
        }
        MHD.Notifications(ToastType.Update, ok);
    }

