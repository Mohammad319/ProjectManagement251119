    // Klick på "Åtkomst": öppna projektets delningsdialog (delning sker på projektnivå).
    // Skrivskyddad för den som inte får hantera delning (backend blockerar ändå obehörig hantering).
    private async Task OpenCalcShareDialog(ListCalculationMVVM calculation)
    {
        var project = GetCalculationProject(calculation);
        if (project is null) return;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var access = ContextMenuAccessPolicy.ForProject(authState.User, project.Access, Folder.State.OtherDepartment);
        bool readOnly = !access.CanManageSharing;

        Modal.ShowComponent<ProjectShareUI>(
            readOnly ? "Visa delning och behörighet" : "Delning och behörighet",
            new Dictionary<string, object>
            {
                [nameof(ProjectShareUI.ProjectId)]           = project.Id,
                [nameof(ProjectShareUI.ProjectName)]         = project.Name,
                [nameof(ProjectShareUI.ProjectDepartmentId)] = project.DepartmentId!,
                [nameof(ProjectShareUI.ProjectResponsible)]  = project.Responsible,
                [nameof(ProjectShareUI.SelectedCalculationName)] = calculation.Name,
                [nameof(ProjectShareUI.SelectedCalculationIsPrivate)] = calculation.IsPrivate,
                [nameof(ProjectShareUI.ReadOnly)]            = readOnly,
                [nameof(ProjectShareUI.OnCompleted)]         = EventCallback.Factory.Create(this, () => ReloadAfterShareChangeAsync(project))
            },
            BlazorMHD.UI.Core.Services.MhdDialogSize.ExtraLarge);
    }

    private async Task ReloadAfterShareChangeAsync(ListProjectMVVM project)
    {
        if (FolderScopeMode)
        {
            await LoadScopeCalculationsAsync(forceReload: true);
        }
        else
        {
            project.CalculationsLoaded = false;
            await Folder.SetCalcsToProject(project);
        }
        StateHasChanged();
    }

