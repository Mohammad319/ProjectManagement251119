@code {
    [Parameter] public bool FolderScopeMode { get; set; }
    [Parameter] public bool IsDepartmentScope { get; set; }
    [Parameter] public string? DepartmentName { get; set; }
    [Parameter] public EventCallback OnShowProjectsRequested { get; set; }

    private sealed record ScopeCalculationRow(FolderMVVM Folder, ListProjectMVVM Project, ListCalculationMVVM Calculation);

    // Resizable-column width persistence + JS interop (shared with ProjectsUI).
    private ListColumnWidthController _columnWidths = default!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // _columnWidths is created in OnInitializedAsync *after* an await, so the
        // first OnAfterRenderAsync can fire before it exists. Once set the component
        // re-renders and AttachAsync runs (it is idempotent).
        if (_columnWidths is not null)
            await _columnWidths.AttachAsync();

        // Force a "move" cursor while dragging calc rows to reorder (no "copy"/plus indicator).
        // Blazor's drag events can't set dataTransfer, so a tiny JS helper does it. Idempotent.
        try { await JS.InvokeVoidAsync("dragMoveEffect.attach", "resizeMe"); }
        catch (JSException) { }
        catch (InvalidOperationException) { }

        var scopeKey = CurrentViewKey;
        if (_prevProjectId != scopeKey)
        {
            _prevProjectId = scopeKey;

            if (_showAllVersions && !HasAnyMultipleVersionsInCurrentView)
            {
                _showAllVersions = false;
                StateHasChanged();
            }
        }
    }

    public void Dispose() => _columnWidths?.Dispose();

    private const string ContentModeCalculations = "calculations";
    private const string ContentModeProjects = "projects";
    private string _contentMode = ContentModeCalculations;

    private ListCalculationMVVM? calcDraging;

    // Manual drag-reorder is only meaningful for a single project's calculation list (not the
    // folder/department scope that mixes projects), in the default (manual) order, with no column
    // sort or filter rearranging/hiding rows. Cross-department views are treated as read-only here;
    // the backend still enforces the real edit permission.
    private bool CanReorderCalculations =>
        !FolderScopeMode
        && !Folder.State.OtherDepartment
        && string.IsNullOrEmpty(_sort.Column)
        && !HasActiveFilters
        && Folder.State.ProjectSelected?.Calculations is not null;

    private void OnCalcDragStart(ListCalculationMVVM calc)
    {
        if (CanReorderCalculations)
            calcDraging = calc;
    }

    private ListCalculationMVVM? _productionDialogCalculation;
    private bool _isCreatingProductionCalculation;
    private string _productionDialogMessage = string.Empty;
    private bool _showAllVersions;
    private bool _viewMenuOpen;
    private string? _prevProjectId;
    private string? _scopeLoadKey;
    private bool _loadingScopeCalculations;
    private List<ScopeCalculationRow> _scopeCalculationRows = [];
    private Dictionary<int, ScopeCalculationRow> _scopeCalculationLookup = [];

    // Shared sort state + header chrome (toggle, header CSS, indicator SVG) — see ListSortController.
    private readonly ListSortController _sort = new();

    private int _pageSize = 25;
    private int _currentPage = 1;
    private const string ToolbarButtonClass = "inline-flex h-9 items-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3 text-sm font-medium text-slate-700 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800";
    private const string PaginationBtnCls = "inline-flex h-6 w-6 items-center justify-center rounded border border-slate-200 text-slate-600 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-35 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800";

    // Materialized once per render (the memo is cleared at the top of the markup) so the
    // version-scope → filter → sort pipeline runs a single time even though several
    // render-path consumers read it: the row-number map, the table's Items, the header
    // count, the pager range and the version-column detection. Event handlers that need the
    // freshest data keep using the live SortedCalculations/FilteredCalculations instead.
    private List<ListCalculationMVVM>? _sortedSnapshot;
    private List<ListCalculationMVVM> SortedCalculationsSnapshot => _sortedSnapshot ??= SortedCalculations.ToList();

    private int TotalFilteredCount => SortedCalculationsSnapshot.Count;
    private int TotalPages => _pageSize <= 0 ? 1 : Math.Max(1, (int)Math.Ceiling((double)TotalFilteredCount / _pageSize));
    private int PageStart => TotalFilteredCount == 0 ? 0 : (_currentPage - 1) * _pageSize + 1;
    private int PageEnd => Math.Min(_currentPage * _pageSize, TotalFilteredCount);

    private IEnumerable<ListCalculationMVVM> PagedCalculations =>
        _pageSize <= 0
            ? SortedCalculationsSnapshot
            : SortedCalculationsSnapshot.Skip((_currentPage - 1) * _pageSize).Take(_pageSize);

    private void ResetPage() => _currentPage = 1;
    private void FirstPage() => _currentPage = 1;
    private void LastPage() => _currentPage = TotalPages;
    private void PreviousPage() { if (_currentPage > 1) _currentPage--; }
    private void NextPage() { if (_currentPage < TotalPages) _currentPage++; }

    private bool _filterMenuOpen;
    private bool _reportMenuOpen;
    private bool _newCalcMenuOpen;

    // Samma tillgänglighetslogik som rapportdialogens flikar (Kalkylvy).
    private static IReadOnlyList<CentralReportsDialog.ReportAvailability> CalcReportMenuItems =>
        CentralReportsDialog.GetReportAvailability(CentralReportsDialog.ReportHost.Calculations);

    private readonly Dictionary<string, ColumnFilterState> _calcColFilters = new()
    {
        ["code"]            = new() { Type = ColumnFilterType.Text },
        ["name"]            = new() { Type = ColumnFilterType.Text },
        ["version"]         = new() { Type = ColumnFilterType.Number },
        ["project"]         = new() { Type = ColumnFilterType.Text },
        ["folder"]          = new() { Type = ColumnFilterType.Text },
        ["calculationType"] = new() { Type = ColumnFilterType.Dropdown },
        ["calculationRole"] = new() { Type = ColumnFilterType.Dropdown },
        ["status"]          = new() { Type = ColumnFilterType.Dropdown },
        ["responsible"]     = new() { Type = ColumnFilterType.Dropdown },
        ["inspector"]       = new() { Type = ColumnFilterType.Dropdown },
        ["address"]         = new() { Type = ColumnFilterType.Text },
        ["qa"]              = new() { Type = ColumnFilterType.Date },
        ["deadline"]        = new() { Type = ColumnFilterType.Date },
        ["start"]           = new() { Type = ColumnFilterType.Date },
        ["end"]             = new() { Type = ColumnFilterType.Date },
        ["createdAt"]       = new() { Type = ColumnFilterType.Date },
        ["updatedAt"]       = new() { Type = ColumnFilterType.Date },
        ["priority"]        = new() { Type = ColumnFilterType.Number },
        ["timeMonth"]       = new() { Type = ColumnFilterType.Number },
        ["tax"]             = new() { Type = ColumnFilterType.Number },
        ["archived"]        = new() { Type = ColumnFilterType.Boolean },
        ["privacy"]         = new() { Type = ColumnFilterType.Boolean },
        // "Åtkomst" filtreras som flervalslista: åtkomsttyp, behörighet och mottagare.
        ["access"]          = new() { Type = ColumnFilterType.Dropdown },
    };

    protected override async Task OnInitializedAsync()
    {
        _calcColFilters["calculationType"].AvailableValues =
        [
            AppLoc["tenderCalculation"].Value,
            AppLoc["contractCalculation"].Value,
            AppLoc["productionCalculation"].Value,
        ];
        _calcColFilters["calculationRole"].AvailableValues = CalculationRoles
            .Select(GetCalculationRoleLabel)
            .ToList();

        // Column layout + named views now come from the shared library manager.
        // It loads persisted visible columns (known keys only) and forces rowNumber
        // on — radnummer visas alltid som standard. Returns whether a persisted
        // layout existed so first-run defaults are applied only on a fresh start.
        _columnView = new MhdColumnViewManager(
            new ListColumnViewStore(
                ListSavedColumnViewStorage.CalculationListScope,
                ViewPreference.LoadColumnsAsync,
                ViewPreference.SaveColumnsAsync,
                SavedColumnViewStorage,
                ViewPreference.LoadColumnOrderAsync,
                ViewPreference.SaveColumnOrderAsync),
            DefaultCalculationColumns,
            ListColumnViewLabels.Swedish,
            alwaysVisibleKeys: new[] { "rowNumber" },
            // Radnummer, Kod och Kalkylnamn är frysta och kan aldrig flyttas.
            lockedOrderKeys: new[] { "rowNumber", "code", "name" });

        // Created before the first await so it is non-null on the first render (the
        // markup reads HasActiveFilters etc.). Saved filters load just below.
        _filter = new ListColumnFilterController(
            _calcColFilters,
            SavedFilterStorage,
            ListSavedFilterStorage.CalculationListScope,
            _sort,
            columnExists: key => _calculationColumns.ContainsKey(key),
            isColumnVisible: IsCalculationColumnVisible,
            columnLabel: GetCalculationColumnLabel,
            revealColumn: key => _calculationColumns[key] = true,
            persistColumns: () => ViewPreference.SaveColumnsAsync(_calculationColumns),
            onChanged: () => _currentPage = 1,
            getShowAllVersions: () => _showAllVersions,
            setShowAllVersions: v => _showAllVersions = v);

        var hadPersistedColumns = await _columnView.InitializeAsync();

        // First run in a folder scope: show project/folder columns by default.
        if (!hadPersistedColumns && FolderScopeMode)
        {
            _calculationColumns["project"] = true;
            _calculationColumns["folder"] = IsDepartmentScope;
        }

        _columnWidths = new ListColumnWidthController(
            JS, ViewPreference.LoadColumnWidthsAsync, ViewPreference.SaveColumnWidthsAsync);
        await _columnWidths.LoadAsync();

        await _filter.LoadSavedAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!FolderScopeMode)
        {
            _scopeLoadKey = null;
            _loadingScopeCalculations = false;
            _scopeCalculationRows = [];
            _scopeCalculationLookup = [];
            return;
        }

        var key = BuildScopeLoadKey();
        if (_scopeLoadKey != key)
        {
            _scopeLoadKey = key;
            await LoadScopeCalculationsAsync(forceReload: false);
        }
    }

    private void OnColumnFilterChanged() => ResetPage();

    private ColumnFilterState CF(string key)
    {
        var state = _calcColFilters[key];
        switch (key)
        {
            case "status":
                state.AvailableValues = GetCalcDropdownValues(GetCalculationStatusText);
                break;
            case "responsible":
                state.AvailableValues = GetCalcDropdownValues(c => c.Responsible);
                break;
            case "inspector":
                state.AvailableValues = GetCalcDropdownValues(c => c.Inspector);
                break;
            case "access":
                state.AvailableGroups = GetCalcAccessFilterGroups();
                break;
        }
        return state;
    }

    private List<string> GetCalcDropdownValues(Func<ListCalculationMVVM, string?> selector) =>
        BaseCalculations
            .Select(selector)
            .Where(v => !string.IsNullOrWhiteSpace(v))
            .Select(v => v!)
            .Distinct()
            .OrderBy(v => v, StringComparer.CurrentCultureIgnoreCase)
            .ToList();

    private IEnumerable<ListCalculationMVVM> BaseCalculations =>
        FolderScopeMode
            ? _scopeCalculationRows.Select(row => row.Calculation)
            : Folder.State.ProjectSelected?.Calculations ?? Enumerable.Empty<ListCalculationMVVM>();

    // Shared filter management (active/clear, hidden-column notice, saved filters).
    // The _calcColFilters dictionary stays host-owned (the FilteredCalculations switch
    // and CF() read it directly); this layers the identical logic on top. See ListColumnFilterController.
    private ListColumnFilterController _filter = default!;

    private bool HasActiveFilters => _filter.HasActive;
    private int ActiveFilterCount => _filter.ActiveCount;

    private bool HasHiddenActiveFilterColumns => _filter.HasHiddenActiveColumns;

    private string HiddenActiveFilterColumnsLabel => _filter.HiddenColumnsLabel;

    private string GetCalculationColumnLabel(string key) =>
        CalculationColumnOptions.FirstOrDefault(c => c.Key == key)?.Label ?? key;

    private bool ShowHiddenFilterNotice => _filter.ShouldShowNotice(_filterMenuOpen);

    private string HiddenFilterColumnTitle => _filter.HiddenColumnsTitle;

    private string HiddenFilterColumnHelp => _filter.HiddenColumnsHelp;

    private void DismissHiddenFilterNotice() => _filter.DismissNotice();

    private Task RevealFilterColumnsAsync() => _filter.RevealColumnsAsync();

    private void ClearFilters() => _filter.Clear();

    private void ClearSingleCalcFilter(string key) => _filter.ClearSingle(key);

    // ── Rubrik (en rad) ─────────────────────────────────────
    private string CalculationListPlaceName => FolderScopeMode
        ? (IsDepartmentScope ? (DepartmentName ?? "-") : (Folder.State.FolderSelected?.Name ?? "-"))
        : (Folder.State.ProjectSelected?.Name ?? "-");

    private string CalculationHeaderMeta
    {
        get
        {
            var total = VisibleBaseCalculations.Count();
            if (HasActiveFilters)
                return $" · filtrerat urval · {SortedCalculationsSnapshot.Count} av {total} {CalcResource.calculation}";

            var wholeDepartment = FolderScopeMode && IsDepartmentScope ? " · hela avdelningen" : string.Empty;
            return $"{wholeDepartment} · {total} {CalcResource.calculation}";
        }
    }

