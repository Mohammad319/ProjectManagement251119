@using ProjectManagement.Shared.DTO.Project
@inherits AppComponentBase

    <div class="space-y-0">
        @if (ProjectDetails != null)
        {
        <dl class="grid grid-cols-1 md:grid-cols-3 gap-2">
                <dt>@CalcResource.name</dt>
            <dd class="md:col-span-2">@ProjectDetails.Name</dd>
                <dt>@ResourceLoc.folder</dt>
            <dd class="md:col-span-2">@ProjectDetails.Folder</dd>
                <dt>@CalcResource.status</dt>
            <dd class="md:col-span-2">@ProjectDetails.Status</dd>
                <dt>@ResourceApp.isVisible</dt>
            <dd class="md:col-span-2"><input type="checkbox" selected="@ProjectDetails.IsVisible" disabled /></dd>
            </dl>
        }
    </div>

@code {
    ProjectDetailsDTO? ProjectDetails;
    [Parameter]public Guid ProjectId { get; set; }

    protected async override Task OnInitializedAsync()
    {
        ProjectDetails = await Repo.Project.DetailsAsync(ProjectId);
    }
}
