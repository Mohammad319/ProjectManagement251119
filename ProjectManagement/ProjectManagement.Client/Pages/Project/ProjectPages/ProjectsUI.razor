                            @onclick="() => UpdateForm(new ListProjectMVVM())">
                        <span aria-hidden="true">@((MarkupString)Icons.Plus)</span>
                        <span>@AppLoc["newProject"]</span>
                    </button>
                </AuthorizeView>
            }
        </div>
    }
    }
</div>

@code {

    [Parameter] public EventCallback OnToggleArchived { get; set; }
    [Parameter] public bool IsDepartmentScope { get; set; }
    [Parameter] public string? DepartmentName { get; set; }

    Guid UpdateProject = Guid.Empty;
    private ListProjectMVVM? draggingProject;

    private const string ContentModeProjects = "projects";
    private const string ContentModeCalculations = "calculations";
    private string _contentMode = ContentModeProjects;
    private bool _showAllVersions = false;

    private bool _filterMenuOpen;
    private bool _viewMenuOpen;
    private bool _reportMenuOpen;
    private bool _newProjectMenuOpen;

    // Samma tillgänglighetslogik som rapportdialogens flikar (Projektvy).
    private static IReadOnlyList<CentralReportsDialog.ReportAvailability> ProjectReportMenuItems =>
        CentralReportsDialog.GetReportAvailability(CentralReportsDialog.ReportHost.Projects);

    // Shared sort state + header chrome (toggle, header CSS, indicator SVG) — see ListSortController.
    private readonly ListSortController _sort = new();

    private int _pageSize = 25;
    private int _currentPage = 1;
    private const string ProjPaginationBtnCls = "inline-flex h-6 w-6 items-center justify-center rounded border border-slate-200 text-slate-600 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-35 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800";

    private int ActiveProjectFilterCount => _filter.ActiveCount;
    private int ViewBadgeCount => _contentMode == ContentModeCalculations ? 1 : 0;

    private void FirstPage() => _currentPage = 1;
    private void LastPage() => _currentPage = TotalProjectPages;
    private void PreviousPage() { if (_currentPage > 1) _currentPage--; }
    private void NextPage() { if (_currentPage < TotalProjectPages) _currentPage++; }

    private readonly Dictionary<string, ColumnFilterState> _projColFilters = new()
    {
        ["code"]                 = new() { Type = ColumnFilterType.Text },
        ["name"]                 = new() { Type = ColumnFilterType.Text },
        ["status"]               = new() { Type = ColumnFilterType.Dropdown },
        ["responsible"]          = new() { Type = ColumnFilterType.Dropdown },
        ["inspector"]            = new() { Type = ColumnFilterType.Dropdown },
        ["deadline"]             = new() { Type = ColumnFilterType.Date },
        ["qa"]                   = new() { Type = ColumnFilterType.Date },
        ["start"]                = new() { Type = ColumnFilterType.Date },
        ["end"]                  = new() { Type = ColumnFilterType.Date },
        ["calculations"]         = new() { Type = ColumnFilterType.Number },
        ["byggherre"]            = new() { Type = ColumnFilterType.Text },
        ["organisation"]         = new() { Type = ColumnFilterType.Dropdown },
        ["procurementName"]      = new() { Type = ColumnFilterType.Text },
        ["procurementNumber"]    = new() { Type = ColumnFilterType.Text },
        ["customerReference"]    = new() { Type = ColumnFilterType.Text },
        ["contract"]             = new() { Type = ColumnFilterType.Dropdown },
        ["projectType"]          = new() { Type = ColumnFilterType.Dropdown },
        ["designer"]             = new() { Type = ColumnFilterType.Text },
        ["supervisor"]           = new() { Type = ColumnFilterType.Text },
        ["address"]              = new() { Type = ColumnFilterType.Text },
        ["procurementMethods"]   = new() { Type = ColumnFilterType.Dropdown },
        ["compensation"]         = new() { Type = ColumnFilterType.Dropdown },
        ["procurementProcedure"] = new() { Type = ColumnFilterType.Dropdown },
        ["clientsManager"]       = new() { Type = ColumnFilterType.Text },
        ["publicationDate"]      = new() { Type = ColumnFilterType.Date },
        ["decisionDate"]         = new() { Type = ColumnFilterType.Date },
        ["createdAt"]            = new() { Type = ColumnFilterType.Date },
        ["updatedAt"]            = new() { Type = ColumnFilterType.Date },
        ["archived"]             = new() { Type = ColumnFilterType.Boolean },
        // "Åtkomst" filtreras som flervalslista: åtkomsttyp, behörighet och mottagare.
        ["shared"]               = new() { Type = ColumnFilterType.Dropdown },
    };

    // Shared filter management (active/clear, hidden-column notice, saved filters).
    // The _projColFilters dictionary above stays host-owned (the FilteredProjects switch
    // and PF() read it directly); this layers the identical logic on top. See ListColumnFilterController.
    private ListColumnFilterController _filter = default!;

    private bool HasActiveProjectFilters => _filter.HasActive;

    private void ClearProjectFilters() => _filter.Clear();

    private void ClearSingleProjectFilter(string key) => _filter.ClearSingle(key);

    private void OnProjectColumnFilterChanged() => _currentPage = 1;

    private bool HasHiddenActiveFilterColumns => _filter.HasHiddenActiveColumns;

    private string HiddenActiveFilterColumnsLabel => _filter.HiddenColumnsLabel;

    private string GetProjectColumnLabel(string key) =>
        ProjectColumnOptions.FirstOrDefault(c => c.Key == key)?.Label ?? key;

    private bool ShowHiddenFilterNotice => _filter.ShouldShowNotice(_filterMenuOpen);

    private string HiddenFilterColumnTitle => _filter.HiddenColumnsTitle;

    private string HiddenFilterColumnHelp => _filter.HiddenColumnsHelp;

    private void DismissHiddenFilterNotice() => _filter.DismissNotice();

    private Task RevealFilterColumnsAsync() => _filter.RevealColumnsAsync();

    // ── Rubrik (en rad) ─────────────────────────────────────
    private string ProjectListPlaceName =>
        IsDepartmentScope ? (DepartmentName ?? "-") : (Folder.State.FolderSelected?.Name ?? "-");

    private string ProjectHeaderMeta
    {
        get
        {
            var total = BaseProjects.Count();
            if (HasActiveProjectFilters)
                return $" · filtrerat urval · {SortedProjectsSnapshot.Count} av {total} {CalcResource.project}";

            var wholeDepartment = IsDepartmentScope ? " · hela avdelningen" : string.Empty;
            return $"{wholeDepartment} · {total} {CalcResource.project}";
        }
    }

    private string ProjectHeaderText => $"Projekt i {ProjectListPlaceName}{ProjectHeaderMeta}";

    // ── Sparade filter (personliga, endast projektlistans scope) ──
    private List<SavedListFilter> _savedProjectFilters => _filter.Saved;
    private bool _saveFilterPromptOpen;
    private string _saveFilterName = string.Empty;
    private string? _saveFilterError;

    private void CloseProjectFilterMenu()
    {
        _filterMenuOpen = false;
        _saveFilterPromptOpen = false;
        _saveFilterError = null;
    }

    private void OpenSaveFilterPrompt()
    {
        _saveFilterPromptOpen = true;
        _saveFilterName = string.Empty;
        _saveFilterError = null;
    }

    private SavedListFilter? MatchingSavedProjectFilter => _filter.Matching;

    // "Spara aktuellt filter" is only enabled for a non-empty filter that isn't already saved.
    private bool CanSaveCurrentProjectFilter => _filter.CanSave;

    private async Task SaveCurrentProjectFilterAsync()
    {
        var error = await _filter.SaveAsync(_saveFilterName);
        if (error is not null)
        {
            _saveFilterError = error;
            return;
        }

        _saveFilterPromptOpen = false;
        _saveFilterName = string.Empty;
        _saveFilterError = null;
    }

    private Task ApplyProjectSavedFilterAsync(SavedListFilter saved)
    {
        _filter.Apply(saved);
        CloseProjectFilterMenu();
        return Task.CompletedTask;
    }

    private Task DeleteProjectSavedFilterAsync(SavedListFilter saved) => _filter.DeleteAsync(saved);

    // ── Sparade kolumnvyer (personliga, endast projektlistans scope) ──
    // A column view = which columns are shown, separate from filters. The logic
    // lives in the shared library (MhdColumnViewManager, see _columnView) and the
    // menu markup/UI state lives in the shared <ColumnViewMenu> component. The host
    // only closes its outer "Vy" dropdown once a view is applied.
    private void CloseColumnViewMenus() => _viewMenuOpen = false;

    private ColumnFilterState PF(string key)
    {
        var state = _projColFilters[key];
        if (state.Type == ColumnFilterType.Dropdown)
        {
            if (key == "shared")
                state.AvailableGroups = GetAccessFilterGroups();
            else
                state.AvailableValues = GetProjectDropdownValues(key);
        }
        return state;
    }

    private List<string> GetProjectDropdownValues(string key)
    {
        Func<ListProjectMVVM, string?> selector = key switch
        {
            "status"               => GetProjectStatusText,
            "responsible"          => p => p.Responsible,
            "inspector"            => p => p.Inspector,
            "organisation"         => p => p.Organisation,
            "contract"             => p => p.Contract,
            "projectType"          => p => p.Type,
            "procurementMethods"   => p => p.ProcurementMethods,
            "compensation"         => p => p.Compensation,
            "procurementProcedure" => p => p.ProcurementProcedure,
            _                      => _ => null
        };
        return BaseProjects
            .Select(selector)
            .Where(v => !string.IsNullOrWhiteSpace(v))
            .Select(v => v!)
            .Distinct()
            .OrderBy(v => v, StringComparer.CurrentCultureIgnoreCase)
            .ToList();
    }

    // ── "Åtkomst"-kolumn ──────────────────────────────────────────────────
    // Ren formatering/klassificering bor i AccessSummaryFormatter (delas + enhetstestas).
    private static bool AccessIsShared(ListProjectMVVM p) =>
        AccessSummaryFormatter.ProjectIsShared(p.Access, p.IsShared);

    private static string AccessSummaryText(ListProjectMVVM p) =>
        AccessSummaryFormatter.ProjectSummaryText(p.Access, p.IsShared);

    private static IEnumerable<string> ProjectAccessTags(ListProjectMVVM p) =>
        AccessSummaryFormatter.ProjectTags(p.Access, p.IsShared);

    private static string AccessTooltip(ListProjectMVVM p)
    {
        var a = p.Access;
        if (a is null)
            return p.IsShared ? "Projektet är delat med andra." : "Endast via normal avdelningsåtkomst.";

        var lines = new List<string>();
        if (a.ViaDepartment)
            lines.Add("Avdelningsåtkomst");
        foreach (var r in a.Recipients)
        {
            var typ = r.Type == ProjectShareRecipientType.Department ? "avdelning" : "person";
            var calc = a.ShareableCalcCount > 0 && r.CalcCount < a.ShareableCalcCount
                ? $"{r.CalcCount}/{a.ShareableCalcCount} kalkyler"
                : "alla tillgängliga kalkyler";
            lines.Add($"{r.Name} · {AccessSummaryFormatter.AccessLevelLabel(r.Role)} · {typ} · {calc}");
        }
        if (lines.Count == 0)
            lines.Add("Ingen åtkomst");
        lines.Add("Klicka för detaljer.");
        return string.Join("\n", lines);
    }

    // Grupperade filtervärden: Åtkomsttyp, Åtkomstnivå, Personer, Avdelningar.
    private List<FilterOptionGroup> GetAccessFilterGroups()
    {
        static FilterOption Opt(string s, string? tooltip = null) =>
            new() { Value = s, Label = s, Tooltip = tooltip };

        var groups = new List<FilterOptionGroup>
        {
            new()
            {
                Header = AccessSummaryFormatter.GroupAccessType,
                Options =
                [
                    Opt(
                        AccessSummaryFormatter.ProjectTypeDepartmentOnly,
                        "Projektet är endast tillgängligt via projektets egen avdelning."),
                    Opt(
                        AccessSummaryFormatter.TypeShared,
                        "Projektet är delat med personer eller avdelningar utöver projektets egen avdelning."),
                    Opt(
                        AccessSummaryFormatter.TypeLimited,
                        "Projektet är delat, men bara vissa kalkyler ingår i delningen."),
                ]
            },
            new()
            {
                Header = AccessSummaryFormatter.GroupAccessLevel,
                Options =
                [
                    Opt(AccessSummaryFormatter.LevelEdit),
                    Opt(AccessSummaryFormatter.LevelView),
                ]
            },
        };

        var recips = BaseProjects
            .Where(p => p.Access is not null)
            .SelectMany(p => p.Access!.Recipients)
            .ToList();

        var persons = RecipientOptions(recips, ProjectShareRecipientType.User);
        if (persons.Count > 0)
            groups.Add(new() { Header = AccessSummaryFormatter.GroupPersons, Options = persons });

        var depts = RecipientOptions(recips, ProjectShareRecipientType.Department);
        if (depts.Count > 0)
            groups.Add(new() { Header = AccessSummaryFormatter.GroupDepartments, Options = depts });

        return groups;
    }

    private static List<FilterOption> RecipientOptions(IEnumerable<ProjectAccessRecipientDTO> recips, ProjectShareRecipientType type) =>
        recips.Where(r => r.Type == type)
            .Select(r => new FilterOption { Value = AccessSummaryFormatter.RecipientFilterValue(r), Label = r.Name })
            .GroupBy(o => o.Value)
            .Select(g => g.First())
            .OrderBy(o => o.Label, StringComparer.CurrentCultureIgnoreCase)
