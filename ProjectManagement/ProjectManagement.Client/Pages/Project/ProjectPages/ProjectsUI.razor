                    </MhdTableColumn>
                </ChildContent>
                <RowTemplate Context="project">
                    @{
                        var isProjectArchived = project.IsArchived;
                        var isProjectSelected = Folder.State.ProjectSelected?.Id == project.Id;
                        var rowClasses = GetProjectRowClass(project, isProjectSelected, isProjectArchived);
                        var rowNumber = _projectRowNumbers.TryGetValue(project.Id, out var _rn) ? _rn : 0;
                    }

                        <tr @key="project.Id"
                            class="@rowClasses"
                            @oncontextmenu:preventDefault
                            @oncontextmenu="() => Context(project)"
                            @onclick="async () => await SetProject(project)"
                            @ondrop="async _ => await HandleDrop(project)"
                            @ondragleave="() => project.IsDragOver = false"
                            @ondragover:preventDefault="true"
                            @ondragover="() => project.IsDragOver = draggingProject is not null"
                            @ondragstart="() => draggingProject = project"
                            @ondragend="() => draggingProject = null"
