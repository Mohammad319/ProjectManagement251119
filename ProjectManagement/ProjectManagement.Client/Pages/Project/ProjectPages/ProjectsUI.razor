    private IEnumerable<ListProjectMVVM> PagedProjects
    {
        get
        {
            var sorted = SortedProjects;
            if (_pageSize == 0) return sorted;
            var total = sorted.Count();
            var maxPage = (int)Math.Ceiling((double)total / _pageSize);
            if (maxPage < 1) maxPage = 1;
            if (_currentPage > maxPage) _currentPage = maxPage;
            return sorted.Skip((_currentPage - 1) * _pageSize).Take(_pageSize);
        }
    }

    private void SortBy(string column)
    {
        if (_sortColumn == column)
            _sortAscending = !_sortAscending;
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }
        _currentPage = 1;
    }

    private void HandlePageSizeChanged(ChangeEventArgs e)
    {
        _pageSize = int.TryParse(e.Value?.ToString(), out var pageSize) ? pageSize : 25;
        _currentPage = 1;
    }

    private async Task HandleToggleArchived()
    {
        _currentPage = 1;
        await OnToggleArchived.InvokeAsync();
    }

