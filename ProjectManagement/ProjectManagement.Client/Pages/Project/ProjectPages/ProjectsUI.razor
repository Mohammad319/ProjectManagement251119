                                @onclick="() => _newProjectMenuOpen = !_newProjectMenuOpen">
                            <svg class="h-2.5 w-2.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                            </svg>
                        </button>
                        @if (_newProjectMenuOpen)
                        {
                            <div class="fixed inset-0 z-[70]" @onclick="() => _newProjectMenuOpen = false"></div>
                            <div class="absolute right-0 top-full z-[90] mt-1 w-60 rounded-md border border-slate-200 bg-white py-1 shadow-lg dark:border-slate-700 dark:bg-slate-900">
                                <button type="button"
                                        class="flex w-full items-center gap-2 px-3 py-1.5 text-[11px] text-slate-700 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-40 dark:text-slate-200 dark:hover:bg-slate-800"
                                        disabled="@noFolderContext"
                                        title="@(noFolderContext ? newProjectDisabledReason : AppLoc["newProject"].Value)"
                                        @onclick="() => { _newProjectMenuOpen = false; UpdateForm(new ListProjectMVVM()); }">
                                    <span aria-hidden="true">@((MarkupString)Icons.Plus)</span>
                                    <span>@AppLoc["newProject"]</span>
                                </button>
                                <button type="button"
                                        class="flex w-full items-center gap-2 px-3 py-1.5 text-[11px] text-slate-700 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-40 dark:text-slate-200 dark:hover:bg-slate-800"
