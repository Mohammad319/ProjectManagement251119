        => ProjectStatusColor.Resolve(project);

    private static string GetProjectRowClass(ListProjectMVVM project, bool selected, bool archived, bool canReorder)
    {
        var classes = new List<string>
        {
            // Grab/grabbing feel when manual reorder is available, otherwise the normal click cursor.
            canReorder ? "cursor-grab active:cursor-grabbing transition-colors" : "cursor-pointer transition-colors",
            "group",
            "hover:bg-slate-50 dark:hover:bg-slate-900/80"
        };
        if (selected)  classes.Add("bg-sky-50 dark:bg-sky-950/30");
        // Full-row drop line across all cells incl. frozen left columns (see .pm-drop-row in custom.css).
        if (project.IsDragOver) classes.Add("pm-drop-row");
        if (archived)  classes.Add("text-slate-500 opacity-75 grayscale dark:text-slate-400");
        return string.Join(" ", classes);
    }

    async Task Context(ListProjectMVVM item)
    {
        var list = new List<MhdContextMenuItem>();

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var access = ContextMenuAccessPolicy.ForProject(authState.User, item.Access, Folder.State.OtherDepartment);

        // Same grouped order as the left tree's project menu, separated by dividers:
        // [skapa/importera] · [arbeta med projekt] · [livscykel] · [export] · [ta bort].
        // (This list menu has no create/import items, so group 1 is simply absent here.)
        if (access.CanView)
        {
            list.Add(new()
            {
                IconHtml = access.CanEditWork ? Icons.Edit : Icons.Details,
                Label = access.CanEditWork ? "Ändra projektuppgifter" : "Visa projekt",
                OnClickAsync = () => { UpdateForm(item, access.CanEditWork); return Task.CompletedTask; }
            });
            list.Add(new() { IconHtml = Icons.Tender, Label = ResourceLoc.tender, OnClickAsync = () => { OpenProjectBidsDialog(item); return Task.CompletedTask; } });
            list.Add(new()
            {
                IconHtml = Icons.PermissionShield,
                Label = access.CanManageSharing ? "Delning och behörighet" : "Visa delning och behörighet",
                OnClickAsync = () => { OpenShareDialog(item, readOnly: !access.CanManageSharing); return Task.CompletedTask; }
            });
        }

        if (access.CanManageLifecycle)
        {
            // Grupp 3 — projektlivscykel
            list.Add(new() { IsSeparator = true });
            list.Add(new() { IconHtml = Icons.Folder, Label = AppLoc["moveProject"], OnClickAsync = () => { OpenMoveCopyDialog(item, MoveCopyOperation.Move); return Task.CompletedTask; } });
            list.Add(new() { IconHtml = Icons.Copy, Label = AppLoc["copyProject"], OnClickAsync = () => { OpenMoveCopyDialog(item, MoveCopyOperation.Copy); return Task.CompletedTask; } });

            if (!item.IsArchived)
                list.Add(new() { IconHtml = Icons.Archive, Label = AppLoc["archiveProject"], OnClickAsync = async () => await ArchiveOrRestoreProjectAsync(item, archive: true) });
            else
                list.Add(new() { IconHtml = Icons.Restore, Label = AppLoc["restoreFromArchive"], OnClickAsync = async () => await ArchiveOrRestoreProjectAsync(item, archive: false) });

            // Grupp 4 — export
            list.Add(new() { IsSeparator = true });
            list.Add(new() { IconHtml = Icons.Tender, Label = "Exportera projektet...", OnClickAsync = () => { OpenSendProjectCopyDialog(item); return Task.CompletedTask; } });
        }

        // Grupp 5 — destruktiv åtgärd: "Ta bort projekt" ligger alltid sist, med separator före.
        if (access.CanManageLifecycle)
        {
            list.Add(new() { IsSeparator = true });

            list.Add(new()
            {
                IconHtml = Icons.Delete,
                Label = ProjectDeleteHelper.DeleteLabel,
                CssClass = ProjectDeleteHelper.DeleteCssClass,
                OnClickAsync = () => ProjectDeleteHelper.RequestDeleteAsync(
                    this, Repo, MHD, ClientLog, item, access.CanManageLifecycle,
                    () => DeleteProjectConfirmedAsync(item))
            });
        }

        await ContextService.ShowMenuAsync(list);
    }

    async Task ArchiveOrRestoreProjectAsync(ListProjectMVVM project, bool archive)
    {
        var dto = await Repo.Project.GetToPostAsync(project.Id);
        if (dto is null) return;
        dto.IsArchived = archive;
        bool ok = await Repo.Project.UpdateAsync(project.Id, dto);
        if (ok)
        {
            project.IsArchived = archive;
            bool shouldKeepInList = UoWService.Folder.ShowArchived || !archive;
            if (!shouldKeepInList)
                Folder.State.FolderSelected?.Projects?.Remove(project);
            UoWService.Folder.State.Notify();
            StateHasChanged();
        }
        MHD.Notifications(ToastType.Update, ok);
    }

