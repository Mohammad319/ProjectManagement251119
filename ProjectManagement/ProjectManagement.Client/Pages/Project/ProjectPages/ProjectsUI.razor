        ["procurementNumber"]    = new() { Type = ColumnFilterType.Text },
        ["customerReference"]    = new() { Type = ColumnFilterType.Text },
        ["contract"]             = new() { Type = ColumnFilterType.Dropdown },
        ["projectType"]          = new() { Type = ColumnFilterType.Dropdown },
        ["designer"]             = new() { Type = ColumnFilterType.Text },
        ["supervisor"]           = new() { Type = ColumnFilterType.Text },
        ["address"]              = new() { Type = ColumnFilterType.Text },
        ["procurementMethods"]   = new() { Type = ColumnFilterType.Dropdown },
        ["compensation"]         = new() { Type = ColumnFilterType.Dropdown },
        ["procurementProcedure"] = new() { Type = ColumnFilterType.Dropdown },
        ["clientsManager"]       = new() { Type = ColumnFilterType.Text },
        ["publicationDate"]      = new() { Type = ColumnFilterType.Date },
        ["decisionDate"]         = new() { Type = ColumnFilterType.Date },
        ["createdAt"]            = new() { Type = ColumnFilterType.Date },
        ["updatedAt"]            = new() { Type = ColumnFilterType.Date },
        ["archived"]             = new() { Type = ColumnFilterType.Boolean },
        // "Åtkomst" filtreras som flervalslista: åtkomsttyp, behörighet och mottagare.
        ["shared"]               = new() { Type = ColumnFilterType.Dropdown },
    };

    // Shared filter management (active/clear, hidden-column notice, saved filters).
    // The _projColFilters dictionary above stays host-owned (the FilteredProjects switch
    // and PF() read it directly); this layers the identical logic on top. See ListColumnFilterController.
    private ListColumnFilterController _filter = default!;

    private bool HasActiveProjectFilters => _filter.HasActive;

    private void ClearProjectFilters() => _filter.Clear();

    private void ClearSingleProjectFilter(string key) => _filter.ClearSingle(key);

    private void OnProjectColumnFilterChanged() => _currentPage = 1;

    private bool HasHiddenActiveFilterColumns => _filter.HasHiddenActiveColumns;

    private string HiddenActiveFilterColumnsLabel => _filter.HiddenColumnsLabel;

    private string GetProjectColumnLabel(string key) =>
        ProjectColumnOptions.FirstOrDefault(c => c.Key == key)?.Label ?? key;

    private bool ShowHiddenFilterNotice => _filter.ShouldShowNotice(_filterMenuOpen);

    private string HiddenFilterColumnTitle => _filter.HiddenColumnsTitle;

    private string HiddenFilterColumnHelp => _filter.HiddenColumnsHelp;

    private void DismissHiddenFilterNotice() => _filter.DismissNotice();

    private Task RevealFilterColumnsAsync() => _filter.RevealColumnsAsync();

    // ── Rubrik (en rad) ─────────────────────────────────────
    private string ProjectListPlaceName =>
        IsDepartmentScope ? (DepartmentName ?? "-") : (Folder.State.FolderSelected?.Name ?? "-");

    private string ProjectHeaderMeta
    {
        get
        {
            var total = BaseProjects.Count();
            if (HasActiveProjectFilters)
                return $" · filtrerat urval · {SortedProjectsSnapshot.Count} av {total} {CalcResource.project}";

            var wholeDepartment = IsDepartmentScope ? " · hela avdelningen" : string.Empty;
            return $"{wholeDepartment} · {total} {CalcResource.project}";
        }
    }

    private string ProjectHeaderText => $"Projekt i {ProjectListPlaceName}{ProjectHeaderMeta}";

    // ── Sparade filter (personliga, endast projektlistans scope) ──
    private List<SavedListFilter> _savedProjectFilters => _filter.Saved;
    private bool _saveFilterPromptOpen;
    private string _saveFilterName = string.Empty;
    private string? _saveFilterError;

    private void CloseProjectFilterMenu()
    {
        _filterMenuOpen = false;
        _saveFilterPromptOpen = false;
        _saveFilterError = null;
    }

    private void OpenSaveFilterPrompt()
    {
        _saveFilterPromptOpen = true;
        _saveFilterName = string.Empty;
        _saveFilterError = null;
    }

    private SavedListFilter? MatchingSavedProjectFilter => _filter.Matching;

    // "Spara aktuellt filter" is only enabled for a non-empty filter that isn't already saved.
    private bool CanSaveCurrentProjectFilter => _filter.CanSave;

    private async Task SaveCurrentProjectFilterAsync()
    {
        var error = await _filter.SaveAsync(_saveFilterName);
        if (error is not null)
        {
            _saveFilterError = error;
            return;
        }

        _saveFilterPromptOpen = false;
        _saveFilterName = string.Empty;
        _saveFilterError = null;
    }

    private Task ApplyProjectSavedFilterAsync(SavedListFilter saved)
    {
        _filter.Apply(saved);
        CloseProjectFilterMenu();
        return Task.CompletedTask;
    }

    private Task DeleteProjectSavedFilterAsync(SavedListFilter saved) => _filter.DeleteAsync(saved);

    // ── Sparade kolumnvyer (personliga, endast projektlistans scope) ──
    // A column view = which columns are shown, separate from filters. The logic
    // lives in the shared library (MhdColumnViewManager, see _columnView) and the
    // menu markup/UI state lives in the shared <ColumnViewMenu> component. The host
    // only closes its outer "Vy" dropdown once a view is applied.
    private void CloseColumnViewMenus() => _viewMenuOpen = false;

    private ColumnFilterState PF(string key)
    {
        var state = _projColFilters[key];
        if (state.Type == ColumnFilterType.Dropdown)
        {
            if (key == "shared")
                state.AvailableGroups = GetAccessFilterGroups();
            else
                state.AvailableValues = GetProjectDropdownValues(key);
        }
        return state;
    }

    private List<string> GetProjectDropdownValues(string key)
    {
        Func<ListProjectMVVM, string?> selector = key switch
        {
            "status"               => GetProjectStatusText,
            "department"           => GetProjectDepartmentName,
            "folder"               => GetProjectFolderName,
            "responsible"          => p => p.Responsible,
            "inspector"            => p => p.Inspector,
            "organisation"         => p => p.Organisation,
            "contract"             => p => p.Contract,
            "projectType"          => p => p.Type,
            "procurementMethods"   => p => p.ProcurementMethods,
            "compensation"         => p => p.Compensation,
            "procurementProcedure" => p => p.ProcurementProcedure,
            _                      => _ => null
        };
        return BaseProjects
            .Select(selector)
            .Where(v => !string.IsNullOrWhiteSpace(v))
            .Select(v => v!)
            .Distinct()
            .OrderBy(v => v, StringComparer.CurrentCultureIgnoreCase)
            .ToList();
    }

    // ── "Åtkomst"-kolumn ──────────────────────────────────────────────────
    // Ren formatering/klassificering bor i AccessSummaryFormatter (delas + enhetstestas).
    private static bool AccessIsShared(ListProjectMVVM p) =>
        AccessSummaryFormatter.ProjectIsShared(p.Access, p.IsShared);

    private static string AccessSummaryText(ListProjectMVVM p) =>
        AccessSummaryFormatter.ProjectSummaryText(p.Access, p.IsShared);

    // Grupperad tooltip för Åtkomst-kolumnen: visar bara VEM som har åtkomst
    // (Avdelningsåtkomst, Delade personer, Delade avdelningar) – var för sig på egna rader.
    // OBS: kalkylomfattning ("x/y kalkyler", "Alla tillgängliga kalkyler") och åtkomstnivå
    // hör hemma i dialogen "Delning och behörighet", inte i denna snabba tooltip.
    private string AccessTooltip(ListProjectMVVM p)
    {
        var a = p.Access;
        if (a is null)
            return p.IsShared ? "Projektet är delat med andra." : "Endast via normal avdelningsåtkomst.";

        var lines = new List<string>();

        // Avdelningsåtkomst via projektets egen avdelning.
        if (a.ViaDepartment)
            lines.Add("Avdelningsåtkomst");

        var persons = a.Recipients.Where(r => r.Type == ProjectShareRecipientType.User).ToList();
        if (persons.Count > 0)
        {
            lines.Add("Delade personer");
            AccessSummaryFormatter.AppendRecipientLines(lines, persons, r => r.Name);
        }

        var depts = a.Recipients.Where(r => r.Type == ProjectShareRecipientType.Department).ToList();
        if (depts.Count > 0)
        {
            lines.Add("Delade avdelningar");
            AccessSummaryFormatter.AppendRecipientLines(lines, depts, r => r.Name);
        }

        if (lines.Count == 0)
            lines.Add("Ingen åtkomst");
        lines.Add("Klicka för detaljer.");
        return string.Join("\n", lines);
    }

    // Projektlistans Åtkomst-KOLUMN visar bara huvudstatus (Avdelningsåtkomst, Delat, Delvis delat),
    // men FILTRET är mer detaljerat: Åtkomsttyp, Åtkomstnivå, Personer och Avdelningar. Logiken bor i
    // ProjectAccessFilter (ren + enhetstestad); här byggs bara grupperna från listans projekt.
    private List<FilterOptionGroup> GetAccessFilterGroups() =>
        ProjectAccessFilter.BuildGroups(BaseProjects);

    private IEnumerable<ListProjectMVVM> BaseProjects =>
        IsDepartmentScope
            ? Folder.State.FoldersList.SelectMany(f => f.Projects ?? (IEnumerable<ListProjectMVVM>)[])
            : (Folder.State.FolderSelected?.Projects ?? (IEnumerable<ListProjectMVVM>)[]);

    private IEnumerable<ListProjectMVVM> FilteredProjects
    {
        get
        {
            var projects = BaseProjects;
            if (_projColFilters["code"].IsActive)
                projects = projects.Where(p => _projColFilters["code"].MatchesText(p.Code));
            if (_projColFilters["name"].IsActive)
                projects = projects.Where(p => _projColFilters["name"].MatchesText(p.Name));
            if (_projColFilters["department"].IsActive)
                projects = projects.Where(p => _projColFilters["department"].MatchesDropdown(GetProjectDepartmentName(p)));
            if (_projColFilters["folder"].IsActive)
                projects = projects.Where(p => _projColFilters["folder"].MatchesDropdown(GetProjectFolderName(p)));
            if (_projColFilters["status"].IsActive)
                projects = projects.Where(p => _projColFilters["status"].MatchesDropdown(GetProjectStatusText(p)));
            if (_projColFilters["responsible"].IsActive)
                projects = projects.Where(p => _projColFilters["responsible"].MatchesDropdown(p.Responsible));
            if (_projColFilters["inspector"].IsActive)
                projects = projects.Where(p => _projColFilters["inspector"].MatchesDropdown(p.Inspector));
            if (_projColFilters["deadline"].IsActive)
                projects = projects.Where(p => _projColFilters["deadline"].MatchesDate(p.TenderDeadline == default ? null : p.TenderDeadline));
            if (_projColFilters["qa"].IsActive)
                projects = projects.Where(p => _projColFilters["qa"].MatchesDate(p.TenderQA == default ? null : p.TenderQA));
            if (_projColFilters["start"].IsActive)
                projects = projects.Where(p => _projColFilters["start"].MatchesDate(p.StartDate == default ? null : p.StartDate));
            if (_projColFilters["end"].IsActive)
                projects = projects.Where(p => _projColFilters["end"].MatchesDate(p.EndDate == default ? null : p.EndDate));
            if (_projColFilters["calculations"].IsActive)
                projects = projects.Where(p => _projColFilters["calculations"].MatchesNumber(GetCalculationCount(p)));
            if (_projColFilters["byggherre"].IsActive)
                projects = projects.Where(p => _projColFilters["byggherre"].MatchesText(p.Developer));
            if (_projColFilters["organisation"].IsActive)
                projects = projects.Where(p => _projColFilters["organisation"].MatchesDropdown(p.Organisation));
            if (_projColFilters["procurementName"].IsActive)
                projects = projects.Where(p => _projColFilters["procurementName"].MatchesText(p.ProcurementName));
            if (_projColFilters["procurementNumber"].IsActive)
                projects = projects.Where(p => _projColFilters["procurementNumber"].MatchesText(p.ProcurementNumber));
            if (_projColFilters["customerReference"].IsActive)
                projects = projects.Where(p => _projColFilters["customerReference"].MatchesText(p.CustomerReference));
            if (_projColFilters["contract"].IsActive)
                projects = projects.Where(p => _projColFilters["contract"].MatchesDropdown(p.Contract));
            if (_projColFilters["projectType"].IsActive)
                projects = projects.Where(p => _projColFilters["projectType"].MatchesDropdown(p.Type));
            if (_projColFilters["designer"].IsActive)
                projects = projects.Where(p => _projColFilters["designer"].MatchesText(p.Designer));
            if (_projColFilters["supervisor"].IsActive)
                projects = projects.Where(p => _projColFilters["supervisor"].MatchesText(p.Supervisor));
            if (_projColFilters["address"].IsActive)
                projects = projects.Where(p => _projColFilters["address"].MatchesText(p.AddressText));
            if (_projColFilters["procurementMethods"].IsActive)
                projects = projects.Where(p => _projColFilters["procurementMethods"].MatchesDropdown(p.ProcurementMethods));
            if (_projColFilters["compensation"].IsActive)
                projects = projects.Where(p => _projColFilters["compensation"].MatchesDropdown(p.Compensation));
            if (_projColFilters["procurementProcedure"].IsActive)
                projects = projects.Where(p => _projColFilters["procurementProcedure"].MatchesDropdown(p.ProcurementProcedure));
            if (_projColFilters["clientsManager"].IsActive)
                projects = projects.Where(p => _projColFilters["clientsManager"].MatchesText(p.ClientsManager));
            if (_projColFilters["publicationDate"].IsActive)
                projects = projects.Where(p => _projColFilters["publicationDate"].MatchesDate(p.PublicationDate));
            if (_projColFilters["decisionDate"].IsActive)
                projects = projects.Where(p => _projColFilters["decisionDate"].MatchesDate(p.DecisionDate));
            if (_projColFilters["createdAt"].IsActive)
                projects = projects.Where(p => _projColFilters["createdAt"].MatchesDate(p.CreatedAt == default ? null : (DateTime?)p.CreatedAt));
            if (_projColFilters["updatedAt"].IsActive)
                projects = projects.Where(p => _projColFilters["updatedAt"].MatchesDate(p.UpdatedAt));
            if (_projColFilters["archived"].IsActive)
                projects = projects.Where(p => _projColFilters["archived"].MatchesBool(p.IsArchived));

            if (_projColFilters["shared"].IsActive)
            {
                // Faceted match (OR within a group, AND across groups). Groups are built from the full
                // base set so the selected values map to the same options the dropdown offered.
                var groups = ProjectAccessFilter.BuildGroups(BaseProjects);
                var selected = _projColFilters["shared"].SelectedValues;
                projects = projects.Where(p => ProjectAccessFilter.Matches(p, groups, selected));
            }
            return projects;
        }
    }

    private IEnumerable<ListProjectMVVM> SortedProjects
    {
        get
        {
            var projects = FilteredProjects;
            // Snapshot the shared sort state so the domain-specific switch below stays untouched.
            var _sortColumn = _sort.Column;
            var _sortAscending = _sort.Ascending;
            return _sortColumn switch
            {
                "code"             => _sortAscending ? projects.OrderBy(x => x.Code)               : projects.OrderByDescending(x => x.Code),
                "name"             => _sortAscending ? projects.OrderBy(x => x.Name)               : projects.OrderByDescending(x => x.Name),
                "department"       => _sortAscending ? projects.OrderBy(GetProjectDepartmentName, StringComparer.CurrentCultureIgnoreCase) : projects.OrderByDescending(GetProjectDepartmentName, StringComparer.CurrentCultureIgnoreCase),
                "folder"           => _sortAscending ? projects.OrderBy(GetProjectFolderName, StringComparer.CurrentCultureIgnoreCase) : projects.OrderByDescending(GetProjectFolderName, StringComparer.CurrentCultureIgnoreCase),
                "status"           => _sortAscending ? projects.OrderBy(x => x.Status)             : projects.OrderByDescending(x => x.Status),
                "responsible"      => _sortAscending ? projects.OrderBy(x => x.Responsible)        : projects.OrderByDescending(x => x.Responsible),
                "start"            => _sortAscending ? projects.OrderBy(x => x.StartDate)          : projects.OrderByDescending(x => x.StartDate),
                "end"              => _sortAscending ? projects.OrderBy(x => x.EndDate)            : projects.OrderByDescending(x => x.EndDate),
