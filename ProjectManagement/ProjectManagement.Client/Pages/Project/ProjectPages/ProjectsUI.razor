                                <span class="inline-flex items-center gap-1">@CalcResource.procurementMethods @((MarkupString)SortIndicatorHtml("procurementMethods")) <TableColumnFilter FilterState='PF("procurementMethods")' OnChanged="OnProjectColumnFilterChanged" /></span>
                            </th>
                        }
                        @if (IsProjectColumnVisible("compensation"))
                        {
                            <th id="hcompensation" class="@SortableHeaderClass("compensation")" style="min-width:110px;" @onclick='() => SortBy("compensation")'>
                                <span class="inline-flex items-center gap-1">@CalcResource.projectCompensation @((MarkupString)SortIndicatorHtml("compensation")) <TableColumnFilter FilterState='PF("compensation")' OnChanged="OnProjectColumnFilterChanged" /></span>
                            </th>
                        }
                        @if (IsProjectColumnVisible("procurementProcedure"))
                        {
                            <th id="hprocurementProcedure" class="@SortableHeaderClass("procurementProcedure")" style="min-width:130px;" @onclick='() => SortBy("procurementProcedure")'>
                                <span class="inline-flex items-center gap-1">Upphandlingsförfarande @((MarkupString)SortIndicatorHtml("procurementProcedure")) <TableColumnFilter FilterState='PF("procurementProcedure")' OnChanged="OnProjectColumnFilterChanged" /></span>
                            </th>
                        }
                        @if (IsProjectColumnVisible("clientsManager"))
                        {
                            <th id="hclientsManager" class="@SortableHeaderClass("clientsManager")" style="min-width:120px;" @onclick='() => SortBy("clientsManager")'>
                                <span class="inline-flex items-center gap-1">@ResourceLoc.clientsProjectmanager @((MarkupString)SortIndicatorHtml("clientsManager")) <TableColumnFilter FilterState='PF("clientsManager")' OnChanged="OnProjectColumnFilterChanged" /></span>
                            </th>
                        }
                        @if (IsProjectColumnVisible("publicationDate"))
                        {
                            <th id="hpublicationDate" class="@SortableHeaderClass("publicationDate")" style="min-width:90px;" @onclick='() => SortBy("publicationDate")'>
                                <span class="inline-flex items-center gap-1">@CalcResource.publicationDate @((MarkupString)SortIndicatorHtml("publicationDate")) <TableColumnFilter FilterState='PF("publicationDate")' OnChanged="OnProjectColumnFilterChanged" /></span>
                            </th>
                        }
                        @if (IsProjectColumnVisible("decisionDate"))
                        {
                            <th id="hdecisionDate" class="@SortableHeaderClass("decisionDate")" style="min-width:90px;" @onclick='() => SortBy("decisionDate")'>
                                <span class="inline-flex items-center gap-1">@CalcResource.decisionDate @((MarkupString)SortIndicatorHtml("decisionDate")) <TableColumnFilter FilterState='PF("decisionDate")' OnChanged="OnProjectColumnFilterChanged" /></span>
                            </th>
                        }
                        @if (IsProjectColumnVisible("createdAt"))
                        {
                            <th id="hcreatedAt" class="@SortableHeaderClass("createdAt")" style="min-width:90px;" @onclick='() => SortBy("createdAt")'>
                                <span class="inline-flex items-center gap-1">@AppLoc["createdDate"] @((MarkupString)SortIndicatorHtml("createdAt")) <TableColumnFilter FilterState='PF("createdAt")' OnChanged="OnProjectColumnFilterChanged" /></span>
                            </th>
                        }
                        @if (IsProjectColumnVisible("updatedAt"))
                        {
                            <th id="hupdatedAt" class="@SortableHeaderClass("updatedAt")" style="min-width:90px;" @onclick='() => SortBy("updatedAt")'>
                                <span class="inline-flex items-center gap-1">@AppLoc["lastModified"] @((MarkupString)SortIndicatorHtml("updatedAt")) <TableColumnFilter FilterState='PF("updatedAt")' OnChanged="OnProjectColumnFilterChanged" /></span>
                            </th>
                        }
                        @if (IsProjectColumnVisible("archived"))
                        {
                            <th id="harchived" class="@SortableHeaderClass("archived")" style="min-width:80px;" @onclick='() => SortBy("archived")'>
                                <span class="inline-flex items-center gap-1">@AppLoc["archived"] @((MarkupString)SortIndicatorHtml("archived")) <TableColumnFilter FilterState='PF("archived")' OnChanged="OnProjectColumnFilterChanged" /></span>
                            </th>
                        }
                        @if (IsProjectColumnVisible("shared"))
                        {
                            <th id="hshared" class="@SortableHeaderClass("shared")" style="min-width:70px;" @onclick='() => SortBy("shared")'>
                                <span class="inline-flex items-center gap-1">Delat @((MarkupString)SortIndicatorHtml("shared")) <TableColumnFilter FilterState='PF("shared")' OnChanged="OnProjectColumnFilterChanged" /></span>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                    @if (TotalProjectCount == 0)
                    {
                        <tr>
                            <td colspan="@VisibleProjectColumnCount" class="px-3 py-8 text-center">
                                <div class="flex flex-col items-center gap-2 text-slate-500 dark:text-slate-400">
                                    <span class="text-sm">@(HasActiveProjectFilters ? "Inga projekt matchar valt filter." : CalcResource.noResultsFound)</span>
                                    @if (HasActiveProjectFilters)
                                    {
                                        <button type="button"
                                                class="inline-flex h-7 items-center gap-1 rounded border border-slate-200 bg-white px-2 text-[11px] font-medium text-slate-600 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800"
                                                @onclick="ClearProjectFilters">
                                            <svg class="h-3 w-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                                            <span>@AppLoc["clearAllFilters"]</span>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    @{ var _projectRowNo = FirstProjectIndex; }
                    @foreach (var project in PagedProjects)
                    {
                        var isProjectArchived = project.IsArchived;
                        var isProjectSelected = Folder.State.ProjectSelected?.Id == project.Id;
                        var rowClasses = GetProjectRowClass(project, isProjectSelected, isProjectArchived);
                        var rowNumber = _projectRowNo++;

                        <tr @key="project.Id"
                            class="@rowClasses"
                            @oncontextmenu:preventDefault
                            @oncontextmenu="() => Context(project)"
                            @onclick="async () => await SetProject(project)"
                            @ondrop="async _ => await HandleDrop(project)"
                            @ondragleave="() => project.IsDragOver = false"
                            @ondragover:preventDefault="true"
                            @ondragover="() => project.IsDragOver = draggingProject is not null"
                            @ondragstart="() => draggingProject = project"
                            @ondragend="() => draggingProject = null"
                            draggable="true">
                            @if (IsProjectColumnVisible("rowNumber"))
                            {
                                <td class="sticky left-0 z-[2] w-12 whitespace-nowrap bg-white px-2 py-2 text-right font-mono text-[11px] text-slate-400 group-hover:bg-slate-50 dark:bg-slate-950 dark:text-slate-500 dark:group-hover:bg-slate-900/80 @(isProjectSelected ? "!bg-blue-50 dark:!bg-blue-950/30" : string.Empty)">
                                    @rowNumber
                                </td>
                            }
                            @if (IsProjectColumnVisible("code"))
                            {
                                <td class="sticky @CodeStickyLeftClass z-[2] w-28 whitespace-nowrap bg-white px-3 py-2 font-mono text-[11px] text-slate-500 group-hover:bg-slate-50 dark:bg-slate-950 dark:text-slate-400 dark:group-hover:bg-slate-900/80 @(isProjectSelected ? "!bg-blue-50 dark:!bg-blue-950/30" : string.Empty)">
                                    @(string.IsNullOrWhiteSpace(project.Code) ? "-" : project.Code)
                                </td>
                            }
                            @if (IsProjectColumnVisible("name"))
                            {
                                <td class="sticky @NameStickyLeftClass z-[2] max-w-80 border-r border-slate-200 bg-white px-3 py-2 group-hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-950 dark:group-hover:bg-slate-900/80 @(isProjectSelected ? "!bg-blue-50 dark:!bg-blue-950/30" : string.Empty)">
                                    <span class="block truncate font-semibold text-slate-800 dark:text-slate-100" title="@project.Name">@project.Name</span>
                                </td>
                            }
                            @if (IsProjectColumnVisible("status"))
                            {
                                <td class="whitespace-nowrap px-3 py-2">
                                    <span class="inline-flex items-center gap-1.5">
                                        <span class="h-2 w-2 shrink-0 rounded-full" style="background-color:@GetProjectStatusColor(project)"></span>
                                        <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-200">@GetProjectStatusText(project)</span>
                                    </span>
                                </td>
                            }
                            @if (IsProjectColumnVisible("responsible"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatText(project.Responsible)</td>
                            }
                            @if (IsProjectColumnVisible("start"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatDate(project.StartDate)</td>
                            }
                            @if (IsProjectColumnVisible("end"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatDate(project.EndDate)</td>
                            }
                            @if (IsProjectColumnVisible("deadline"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatDate(project.TenderDeadline)</td>
                            }
                            @if (IsProjectColumnVisible("qa"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatDate(project.TenderQA)</td>
                            }
                            @if (IsProjectColumnVisible("calculations"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-right">
                                    <button type="button"
                                            class="inline-flex min-w-[2rem] items-center justify-center rounded-md px-1.5 py-0.5 text-xs font-semibold text-slate-600 transition hover:bg-sky-100 hover:text-sky-700 dark:text-slate-300 dark:hover:bg-sky-900/40 dark:hover:text-sky-300"
                                            title="@AppLoc["showCalculations"]"
                                            @onclick:stopPropagation
                                            @onclick="async () => await SetProject(project)">
                                        @FormatCalculationCount(project)
                                    </button>
                                </td>
                            }
                            @if (IsProjectColumnVisible("byggherre"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatText(project.Developer)</td>
                            }
                            @if (IsProjectColumnVisible("organisation"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatText(project.Organisation)</td>
                            }
                            @if (IsProjectColumnVisible("procurementName"))
                            {
                                <td class="px-3 py-2 text-slate-600 dark:text-slate-300">@FormatText(project.ProcurementName)</td>
                            }
                            @if (IsProjectColumnVisible("procurementNumber"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatText(project.ProcurementNumber)</td>
                            }
                            @if (IsProjectColumnVisible("customerReference"))
                            {
                                <td class="px-3 py-2 text-slate-600 dark:text-slate-300">@FormatText(project.CustomerReference)</td>
                            }
                            @if (IsProjectColumnVisible("contract"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatText(project.Contract)</td>
                            }
                            @if (IsProjectColumnVisible("projectType"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatText(project.Type)</td>
                            }
                            @if (IsProjectColumnVisible("inspector"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatText(project.Inspector)</td>
                            }
                            @if (IsProjectColumnVisible("designer"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatText(project.Designer)</td>
                            }
                            @if (IsProjectColumnVisible("supervisor"))
                            {
                                <td class="px-3 py-2 text-slate-600 dark:text-slate-300">@FormatText(project.Supervisor)</td>
                            }
                            @if (IsProjectColumnVisible("address"))
                            {
                                <td class="px-3 py-2 text-slate-600 dark:text-slate-300">@FormatText(project.AddressText)</td>
                            }
                            @if (IsProjectColumnVisible("procurementMethods"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatText(project.ProcurementMethods)</td>
                            }
                            @if (IsProjectColumnVisible("compensation"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatText(project.Compensation)</td>
                            }
                            @if (IsProjectColumnVisible("procurementProcedure"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatText(project.ProcurementProcedure)</td>
                            }
                            @if (IsProjectColumnVisible("clientsManager"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatText(project.ClientsManager)</td>
                            }
                            @if (IsProjectColumnVisible("publicationDate"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatDate(project.PublicationDate)</td>
                            }
                            @if (IsProjectColumnVisible("decisionDate"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatDate(project.DecisionDate)</td>
                            }
                            @if (IsProjectColumnVisible("createdAt"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatDate(project.CreatedAt)</td>
                            }
                            @if (IsProjectColumnVisible("updatedAt"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatDate(project.UpdatedAt)</td>
                            }
                            @if (IsProjectColumnVisible("archived"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatYesNo(project.IsArchived)</td>
                            }
                            @if (IsProjectColumnVisible("shared"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">
                                    @if (project.IsShared)
                                    {
                                        <span class="inline-flex items-center gap-1" title="Projektet är delat med andra användare eller avdelningar.">
                                            <i class="fa-solid fa-share-nodes text-sky-500"></i> Ja
                                        </span>
                                    }
                                    else
                                    {
                                        <span>Nej</span>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* ── Pagination bar ──────────────────────────────── *@
        <div class="shrink-0 grid grid-cols-3 items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs shadow-sm dark:border-slate-800 dark:bg-slate-950">
            <div class="flex items-center gap-1.5">
                <select class="h-6 rounded border border-slate-300 bg-white px-1 text-[11px] text-slate-700 focus:outline-none focus:ring-1 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200"
                        value="@_pageSize"
                        @onchange="HandlePageSizeChanged">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                    <option value="0">@AppLoc["allItems"]</option>
                </select>
                <span class="text-[11px] text-slate-500 dark:text-slate-400">@AppLoc["perPage"]</span>
            </div>

            <div class="text-center text-[11px] text-slate-500 dark:text-slate-400">
                @if (_pageSize == 0 || TotalProjectCount == 0)
                {
                    @AppLoc["showingAllFormat", TotalProjectCount]
                }
                else
                {
                    @AppLoc["showingRangeFormat", FirstProjectIndex, LastProjectIndex, TotalProjectCount]
                }
            </div>

            <div class="flex items-center justify-end gap-1">
                <button type="button" disabled="@(_currentPage <= 1)" class="@ProjPaginationBtnCls" @onclick="FirstPage" title="@AppLoc["first"]">
                    <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 19l-7-7 7-7M18 19l-7-7 7-7" /></svg>
                </button>
                <button type="button" disabled="@(_currentPage <= 1)" class="@ProjPaginationBtnCls" @onclick="PreviousPage" title="@AppLoc["previous"]">
                    <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
                </button>
                <span class="min-w-[2.5rem] text-center text-[11px] text-slate-500 dark:text-slate-400">
                    @if (TotalProjectPages > 1) { @($"{_currentPage}/{TotalProjectPages}") }
                </span>
                <button type="button" disabled="@(_currentPage >= TotalProjectPages)" class="@ProjPaginationBtnCls" @onclick="NextPage" title="@AppLoc["next"]">
                    <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                </button>
                <button type="button" disabled="@(_currentPage >= TotalProjectPages)" class="@ProjPaginationBtnCls" @onclick="LastPage" title="@AppLoc["last"]">
                    <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M6 5l7 7-7 7" /></svg>
                </button>
            </div>
        </div>
    }
    else if (_contentMode == ContentModeProjects)
    {
        <div class="rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-6 py-12 text-center dark:border-slate-700 dark:bg-slate-950/60">
            <div class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">@CalcResource.project</div>
            <h3 class="mt-2 text-lg font-semibold text-slate-900 dark:text-slate-100">@AppLoc["projectsEmptyState"]</h3>
            <p class="mt-2 text-sm leading-6 text-slate-500 dark:text-slate-400">@AppLoc["projectsEmptyStateHint"]</p>
            @if (!Folder.State.OtherDepartment && Folder.State.FolderSelected is not null)
            {
                <AuthorizeView Roles="@PMRolesConst.Tenant.AdminManger">
                    <button type="button"
                            class="mt-4 inline-flex items-center gap-1.5 rounded-lg border border-emerald-300 bg-emerald-50 px-4 py-2 text-sm font-semibold text-emerald-700 transition hover:bg-emerald-100 dark:border-emerald-900/60 dark:bg-emerald-950/30 dark:text-emerald-300 dark:hover:bg-emerald-950/50"
                            @onclick="() => UpdateForm(new ListProjectMVVM())">
                        <span aria-hidden="true">@((MarkupString)Icons.Plus)</span>
                        <span>@AppLoc["newProject"]</span>
                    </button>
                </AuthorizeView>
            }
        </div>
    }
    }
</div>

@code {

    [Parameter] public EventCallback OnToggleArchived { get; set; }
    [Parameter] public bool IsDepartmentScope { get; set; }
    [Parameter] public string? DepartmentName { get; set; }

    private DotNetObjectReference<ProjectsUI>? _dotNetRef;
    Guid UpdateProject = Guid.Empty;
    private ListProjectMVVM? draggingProject;

    private const string ContentModeProjects = "projects";
    private const string ContentModeCalculations = "calculations";
    private string _contentMode = ContentModeProjects;
    private bool _showAllVersions = false;

    private bool _filterMenuOpen;
    private bool _viewMenuOpen;
    private bool _showColumnPanel;
    private bool _reportMenuOpen;

    // Samma tillgänglighetslogik som rapportdialogens flikar (Projektvy).
    private static IReadOnlyList<CentralReportsDialog.ReportAvailability> ProjectReportMenuItems =>
        CentralReportsDialog.GetReportAvailability(CentralReportsDialog.ReportHost.Projects);

    private string _sortColumn = "";
    private bool _sortAscending = true;

    private int _pageSize = 25;
    private int _currentPage = 1;
    private const string ProjPaginationBtnCls = "inline-flex h-6 w-6 items-center justify-center rounded border border-slate-200 text-slate-600 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-35 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800";

    private int ActiveProjectFilterCount => _projColFilters.Values.Count(f => f.IsActive);
    private int ViewBadgeCount => _contentMode == ContentModeCalculations ? 1 : 0;

    private void FirstPage() => _currentPage = 1;
    private void LastPage() => _currentPage = TotalProjectPages;
    private void PreviousPage() { if (_currentPage > 1) _currentPage--; }
    private void NextPage() { if (_currentPage < TotalProjectPages) _currentPage++; }

    private readonly Dictionary<string, ColumnFilterState> _projColFilters = new()
    {
        ["code"]                 = new() { Type = ColumnFilterType.Text },
        ["name"]                 = new() { Type = ColumnFilterType.Text },
        ["status"]               = new() { Type = ColumnFilterType.Dropdown },
        ["responsible"]          = new() { Type = ColumnFilterType.Dropdown },
        ["inspector"]            = new() { Type = ColumnFilterType.Dropdown },
        ["deadline"]             = new() { Type = ColumnFilterType.Date },
        ["qa"]                   = new() { Type = ColumnFilterType.Date },
        ["start"]                = new() { Type = ColumnFilterType.Date },
        ["end"]                  = new() { Type = ColumnFilterType.Date },
        ["calculations"]         = new() { Type = ColumnFilterType.Number },
        ["byggherre"]            = new() { Type = ColumnFilterType.Text },
        ["organisation"]         = new() { Type = ColumnFilterType.Dropdown },
        ["procurementName"]      = new() { Type = ColumnFilterType.Text },
        ["procurementNumber"]    = new() { Type = ColumnFilterType.Text },
        ["customerReference"]    = new() { Type = ColumnFilterType.Text },
        ["contract"]             = new() { Type = ColumnFilterType.Dropdown },
        ["projectType"]          = new() { Type = ColumnFilterType.Dropdown },
        ["designer"]             = new() { Type = ColumnFilterType.Text },
        ["supervisor"]           = new() { Type = ColumnFilterType.Text },
        ["address"]              = new() { Type = ColumnFilterType.Text },
        ["procurementMethods"]   = new() { Type = ColumnFilterType.Dropdown },
        ["compensation"]         = new() { Type = ColumnFilterType.Dropdown },
        ["procurementProcedure"] = new() { Type = ColumnFilterType.Dropdown },
        ["clientsManager"]       = new() { Type = ColumnFilterType.Text },
        ["publicationDate"]      = new() { Type = ColumnFilterType.Date },
        ["decisionDate"]         = new() { Type = ColumnFilterType.Date },
        ["createdAt"]            = new() { Type = ColumnFilterType.Date },
        ["updatedAt"]            = new() { Type = ColumnFilterType.Date },
        ["archived"]             = new() { Type = ColumnFilterType.Boolean },
        ["shared"]               = new() { Type = ColumnFilterType.Boolean },
    };

    private bool HasActiveProjectFilters => _projColFilters.Values.Any(f => f.IsActive);

    private void ClearProjectFilters()
    {
        foreach (var f in _projColFilters.Values) f.Clear();
        _currentPage = 1;
    }

    private void ClearSingleProjectFilter(string key)
    {
        _projColFilters[key].Clear();
        _currentPage = 1;
    }

    private void OnProjectColumnFilterChanged() => _currentPage = 1;

    // ── Dolda filterkolumner ────────────────────────────────
    // Filter keys map 1:1 to column keys, so an active filter on a hidden column
    // still works but is invisible. We surface that and offer to reveal the columns
    // WITHOUT touching the filter itself.
    private IEnumerable<string> HiddenActiveFilterColumnKeys =>
        _projColFilters
            .Where(kv => kv.Value.IsActive && _projectColumns.ContainsKey(kv.Key) && !IsProjectColumnVisible(kv.Key))
            .Select(kv => kv.Key);

    private bool HasHiddenActiveFilterColumns => HiddenActiveFilterColumnKeys.Any();

    private string HiddenActiveFilterColumnsLabel =>
        string.Join(", ", HiddenActiveFilterColumnKeys.Select(GetProjectColumnLabel));

    private string GetProjectColumnLabel(string key) =>
        ProjectColumnOptions.FirstOrDefault(c => c.Key == key)?.Label ?? key;

    // ── Flytande notice om dold filterkolumn ────────────────
    // Signaturen är mängden dolda filterkolumner. När den ändras (annat filter,
    // annan kolumnvy) skiljer den sig från den senast stängda och notisen visas
    // igen automatiskt. X stänger bara notisen — filter och kolumnvy rörs inte.
    private string? _dismissedHiddenFilterSignature;

    private string HiddenFilterColumnSignature =>
        string.Join("|", HiddenActiveFilterColumnKeys.OrderBy(k => k, StringComparer.Ordinal));

    private bool ShowHiddenFilterNotice =>
        HasHiddenActiveFilterColumns && !_filterMenuOpen &&
        _dismissedHiddenFilterSignature != HiddenFilterColumnSignature;

    private string HiddenFilterColumnTitle =>
        HiddenActiveFilterColumnKeys.Count() > 1
            ? $"Dolda filterkolumner: {HiddenActiveFilterColumnsLabel}"
            : $"Dold filterkolumn: {HiddenActiveFilterColumnsLabel}";

    private string HiddenFilterColumnHelp =>
        HiddenActiveFilterColumnKeys.Count() > 1
            ? "Aktuellt filter använder dolda kolumner."
            : "Aktuellt filter använder en dold kolumn.";

    private void DismissHiddenFilterNotice() =>
        _dismissedHiddenFilterSignature = HiddenFilterColumnSignature;

    // Make the hidden columns used by active filters visible. Only the column layout
    // changes (counts as a manual edit of the current view); the filter is untouched.
    private async Task RevealFilterColumnsAsync()
    {
        foreach (var key in HiddenActiveFilterColumnKeys.ToList())
            if (_projectColumns.ContainsKey(key))
                _projectColumns[key] = true;

        // Kolumnerna är synliga nu → notisen försvinner. Nollställ stängt-läget så
        // att en framtida dold kolumn visar notisen igen.
        _dismissedHiddenFilterSignature = null;
        await ViewPreference.SaveColumnsAsync(_projectColumns);
    }

    // ── Rubrik (en rad) ─────────────────────────────────────
    private string ProjectListPlaceName =>
        IsDepartmentScope ? (DepartmentName ?? "-") : (Folder.State.FolderSelected?.Name ?? "-");

    private string ProjectHeaderMeta
    {
        get
        {
            var total = BaseProjects.Count();
            if (HasActiveProjectFilters)
                return $" · filtrerat urval · {FilteredProjects.Count()} av {total} {CalcResource.project}";

            var wholeDepartment = IsDepartmentScope ? " · hela avdelningen" : string.Empty;
            return $"{wholeDepartment} · {total} {CalcResource.project}";
