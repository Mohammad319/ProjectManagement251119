    private Task PrintProjectListAsync()  => ExportProjectListAsync(pdfMode: false, printOnly: true);

    private async Task ExportProjectListAsync(bool pdfMode, bool printOnly)
    {
        // Radnummer är en visuell hjälpkolumn och tas inte med i export/utskrift.
        var columns = ProjectColumnOptions
            .Where(column => column.Key != "rowNumber" && IsProjectColumnVisible(column.Key))
            .ToList();
        var rows = SortedProjects.Select(project => columns.Select(column => GetProjectExportValue(project, column.Key)));
        var title = AppLoc["projectListTitleFormat", Folder.State.FolderSelected?.Name ?? "-"].Value;

        if (printOnly)
            await ReportExportInterop.PrintAsync(JS, title, columns.Select(column => column.Label), rows, pdfMode);
        else
            await ReportExportInterop.ExportExcelAsync(JS, "projektlista", title, columns.Select(column => column.Label), rows);
    }

