    private string ProjectHeaderText => $"Projekt i {ProjectListPlaceName}{ProjectHeaderMeta}";

    // ── Sparade filter (personliga, endast projektlistans scope) ──
    private List<SavedListFilter> _savedProjectFilters = [];
    private bool _saveFilterPromptOpen;
    private string _saveFilterName = string.Empty;
    private string? _saveFilterError;

    private void CloseProjectFilterMenu()
    {
        _filterMenuOpen = false;
        _saveFilterPromptOpen = false;
        _saveFilterError = null;
    }

    private void OpenSaveFilterPrompt()
    {
        _saveFilterPromptOpen = true;
        _saveFilterName = string.Empty;
        _saveFilterError = null;
    }

    // Snapshot of the current list state as a (still unnamed) saved filter. Shared by
    // both the save action and the duplicate-detection so they compare identical data.
    private SavedListFilter BuildCurrentProjectFilter(string name = "") => new()
    {
        Name = name,
        SortColumn = string.IsNullOrEmpty(_sortColumn) ? null : _sortColumn,
        SortAscending = _sortAscending,
        Filters = _projColFilters
            .Where(kv => kv.Value.IsActive)
            .ToDictionary(kv => kv.Key, kv => SavedColumnFilter.FromState(kv.Value))
    };

    // The first saved filter whose definition matches the current list state, or null.
    // Matching is by normalized content (not name), so a manually rebuilt filter is
    // recognised too. If old data holds several identical filters, the first wins.
    private SavedListFilter? MatchingSavedProjectFilter
    {
        get
        {
            if (!HasActiveProjectFilters) return null;
            var signature = BuildCurrentProjectFilter().ContentSignature();
            return _savedProjectFilters.FirstOrDefault(f => f.ContentSignature() == signature);
        }
    }

    // "Spara aktuellt filter" is only enabled for a non-empty filter that isn't already saved.
    private bool CanSaveCurrentProjectFilter => HasActiveProjectFilters && MatchingSavedProjectFilter is null;

    private async Task SaveCurrentProjectFilterAsync()
    {
        var name = _saveFilterName.Trim();
        if (name.Length == 0)
        {
            _saveFilterError = "Namn krävs.";
            return;
        }
        if (_savedProjectFilters.Any(f => string.Equals(f.Name, name, StringComparison.CurrentCultureIgnoreCase)))
        {
            _saveFilterError = "Ett filter med detta namn finns redan. Välj ett annat namn.";
            return;
        }

        var filter = BuildCurrentProjectFilter(name);
        var signature = filter.ContentSignature();
        if (_savedProjectFilters.Any(f => f.ContentSignature() == signature))
        {
            _saveFilterError = "Detta filter är redan sparat.";
            return;
        }

        _savedProjectFilters.Add(filter);
        _savedProjectFilters = _savedProjectFilters
            .OrderBy(f => f.Name, StringComparer.CurrentCultureIgnoreCase)
            .ToList();
        await SavedFilterStorage.SaveAllAsync(ListSavedFilterStorage.ProjectListScope, _savedProjectFilters);

        _saveFilterPromptOpen = false;
        _saveFilterName = string.Empty;
        _saveFilterError = null;
    }

    private Task ApplyProjectSavedFilterAsync(SavedListFilter saved)
    {
        foreach (var f in _projColFilters.Values) f.Clear();

        foreach (var (key, savedFilter) in saved.Filters)
        {
            if (_projColFilters.TryGetValue(key, out var state) && state.Type == savedFilter.Type)
                savedFilter.ApplyTo(state);
        }

        if (!string.IsNullOrEmpty(saved.SortColumn))
        {
            _sortColumn = saved.SortColumn;
            _sortAscending = saved.SortAscending;
        }

        _currentPage = 1;
        // Ett nyss valt sparat filter ska alltid kunna visa dold-kolumn-notisen,
        // även om samma kolumner var dolda och notisen tidigare stängdes.
        _dismissedHiddenFilterSignature = null;
        CloseProjectFilterMenu();
        return Task.CompletedTask;
    }

    private async Task DeleteProjectSavedFilterAsync(SavedListFilter saved)
    {
        _savedProjectFilters.Remove(saved);
        await SavedFilterStorage.SaveAllAsync(ListSavedFilterStorage.ProjectListScope, _savedProjectFilters);
    }

    // ── Sparade kolumnvyer (personliga, endast projektlistans scope) ──
    // A column view = which columns are shown. It is completely separate from
    // filters: applying a view never changes the filter, and applying a filter
    // never changes the view.
    private List<SavedColumnView> _savedColumnViews = [];
    private bool _saveViewPromptOpen;
    private string _saveViewName = string.Empty;
    private string? _saveViewError;

    private const string StandardColumnViewName = "Standard";

    // The column view the user last applied (Standard or a saved view's name). Kept
    // even after manual column edits so we can show "<name> · ändrad". Session-only:
    // after a reload the label falls back to signature detection. Null = never picked.
    private string? _selectedColumnViewName;

    private void OpenSaveViewPrompt()
    {
        _saveViewPromptOpen = true;
        _saveViewName = string.Empty;
        _saveViewError = null;
    }

    // Signature of the columns visible right now, used for "is this view active?"
    // and duplicate detection.
    private string CurrentColumnSignature => SavedColumnView.BuildSignature(_projectColumns);

    private bool IsStandardColumnViewActive =>
        CurrentColumnSignature == SavedColumnView.BuildSignature(DefaultProjectColumns);

    private bool IsColumnViewActive(SavedColumnView view) =>
        CurrentColumnSignature == view.ContentSignature();

    // The first saved view whose visible columns match the current layout, or null.
    private SavedColumnView? MatchingSavedColumnView
    {
        get
        {
            var signature = CurrentColumnSignature;
            return _savedColumnViews.FirstOrDefault(v => v.ContentSignature() == signature);
        }
    }

    // "Spara aktuell kolumnvy" is disabled when the current layout already matches
    // a saved view OR the built-in Standard view (nothing new to save).
    private bool CanSaveCurrentColumnView =>
        MatchingSavedColumnView is null && !IsStandardColumnViewActive;

    private string? SaveColumnViewDisabledReason =>
        MatchingSavedColumnView is { } match ? $"Denna kolumnvy är redan sparad: {match.Name}"
        : IsStandardColumnViewActive ? "Denna kolumnvy är redan sparad: Standard"
        : null;

    private async Task ApplyColumnLayoutAsync(IReadOnlyDictionary<string, bool> columns, string? viewName)
    {
        // Only touch known column keys; never add/remove columns the table doesn't know.
        foreach (var key in _projectColumns.Keys.ToList())
            _projectColumns[key] = columns.TryGetValue(key, out var visible) && visible;

        _selectedColumnViewName = viewName;
        await ViewPreference.SaveColumnsAsync(_projectColumns);
        _viewMenuOpen = false;
        _showColumnPanel = false;
        _saveViewPromptOpen = false;
    }

    private Task ApplyStandardColumnViewAsync() => ApplyColumnLayoutAsync(DefaultProjectColumns, StandardColumnViewName);

    private Task ApplySavedColumnViewAsync(SavedColumnView view) => ApplyColumnLayoutAsync(view.Columns, view.Name);

    // The live layout no longer exactly matches the view the user picked → "<name> · ändrad".
    private bool IsSelectedColumnViewModified
    {
        get
        {
            if (_selectedColumnViewName is null)
                return false;
            if (_selectedColumnViewName == StandardColumnViewName)
                return !IsStandardColumnViewActive;
            var view = _savedColumnViews.FirstOrDefault(v => v.Name == _selectedColumnViewName);
            return view is not null && !IsColumnViewActive(view);
        }
    }

    // What to show as the active column view: the picked view (with "· ändrad" when
    // edited) or, when nothing is picked this session, a label derived purely from
    // the current visible columns.
    private string ActiveColumnViewLabel
    {
        get
        {
            if (_selectedColumnViewName is { } name &&
                (name == StandardColumnViewName || _savedColumnViews.Any(v => v.Name == name)))
            {
                return IsSelectedColumnViewModified ? $"{name} · ändrad" : name;
            }
            return SignatureColumnViewLabel;
        }
    }

    private string SignatureColumnViewLabel =>
        IsStandardColumnViewActive ? StandardColumnViewName
        : MatchingSavedColumnView?.Name ?? "Anpassad vy";

    private async Task SaveCurrentColumnViewAsync()
    {
        var name = _saveViewName.Trim();
        if (name.Length == 0)
        {
            _saveViewError = "Namn krävs.";
            return;
        }
        if (string.Equals(name, StandardColumnViewName, StringComparison.CurrentCultureIgnoreCase))
        {
            _saveViewError = "Namnet Standard är reserverat. Välj ett annat namn.";
            return;
        }
        if (_savedColumnViews.Any(v => string.Equals(v.Name, name, StringComparison.CurrentCultureIgnoreCase)))
        {
            _saveViewError = "En kolumnvy med detta namn finns redan. Välj ett annat namn.";
            return;
        }

        var view = new SavedColumnView
        {
            Name = name,
            Columns = new Dictionary<string, bool>(_projectColumns)
        };
        if (_savedColumnViews.Any(v => v.ContentSignature() == view.ContentSignature()))
        {
            _saveViewError = "Denna kolumnvy är redan sparad.";
            return;
        }

        _savedColumnViews.Add(view);
        _savedColumnViews = _savedColumnViews
            .OrderBy(v => v.Name, StringComparer.CurrentCultureIgnoreCase)
            .ToList();
        await SavedColumnViewStorage.SaveAllAsync(ListSavedColumnViewStorage.ProjectListScope, _savedColumnViews);

        // The just-saved layout is now the active view (clean, not modified).
        _selectedColumnViewName = name;
        _saveViewPromptOpen = false;
        _saveViewName = string.Empty;
        _saveViewError = null;
    }

    private async Task DeleteSavedColumnViewAsync(SavedColumnView view)
    {
        _savedColumnViews.Remove(view);
        if (_selectedColumnViewName == view.Name)
            _selectedColumnViewName = null;
        await SavedColumnViewStorage.SaveAllAsync(ListSavedColumnViewStorage.ProjectListScope, _savedColumnViews);
    }

    private ColumnFilterState PF(string key)
    {
        var state = _projColFilters[key];
        if (state.Type == ColumnFilterType.Dropdown)
            state.AvailableValues = GetProjectDropdownValues(key);
        return state;
    }

    private List<string> GetProjectDropdownValues(string key)
    {
        Func<ListProjectMVVM, string?> selector = key switch
        {
            "status"               => GetProjectStatusText,
            "responsible"          => p => p.Responsible,
            "inspector"            => p => p.Inspector,
            "organisation"         => p => p.Organisation,
            "contract"             => p => p.Contract,
            "projectType"          => p => p.Type,
            "procurementMethods"   => p => p.ProcurementMethods,
            "compensation"         => p => p.Compensation,
            "procurementProcedure" => p => p.ProcurementProcedure,
            _                      => _ => null
        };
        return BaseProjects
            .Select(selector)
            .Where(v => !string.IsNullOrWhiteSpace(v))
            .Select(v => v!)
            .Distinct()
            .OrderBy(v => v, StringComparer.CurrentCultureIgnoreCase)
            .ToList();
    }

    private IEnumerable<ListProjectMVVM> BaseProjects =>
        IsDepartmentScope
            ? Folder.State.FoldersList.SelectMany(f => f.Projects ?? (IEnumerable<ListProjectMVVM>)[])
            : (Folder.State.FolderSelected?.Projects ?? (IEnumerable<ListProjectMVVM>)[]);

