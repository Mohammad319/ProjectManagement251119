                                disabled="@noFolderContext"
                                title="@(noFolderContext ? newProjectDisabledReason : AppLoc["newProject"].Value)"
                                @onclick="() => UpdateForm(new ListProjectMVVM())">
                            <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                            </svg>
                            <span>@AppLoc["newProject"]</span>
                        </button>
                        <button type="button"
                                class="inline-flex h-7 shrink-0 items-center justify-center rounded-r border border-l-0 border-emerald-400 bg-emerald-500 px-1 text-white transition hover:bg-emerald-600 dark:border-emerald-600 dark:bg-emerald-600 dark:hover:bg-emerald-700"
