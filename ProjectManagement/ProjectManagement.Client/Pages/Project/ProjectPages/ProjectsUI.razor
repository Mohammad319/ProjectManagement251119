    private IEnumerable<ListProjectMVVM> SortedProjects
    {
        get
        {
            var projects = FilteredProjects;
            // Snapshot the shared sort state so the domain-specific switch below stays untouched.
            var _sortColumn = _sort.Column;
            var _sortAscending = _sort.Ascending;
            return _sortColumn switch
            {
                "code"             => _sortAscending ? projects.OrderBy(x => x.Code)               : projects.OrderByDescending(x => x.Code),
                "name"             => _sortAscending ? projects.OrderBy(x => x.Name)               : projects.OrderByDescending(x => x.Name),
                "status"           => _sortAscending ? projects.OrderBy(x => x.Status)             : projects.OrderByDescending(x => x.Status),
                "responsible"      => _sortAscending ? projects.OrderBy(x => x.Responsible)        : projects.OrderByDescending(x => x.Responsible),
                "start"            => _sortAscending ? projects.OrderBy(x => x.StartDate)          : projects.OrderByDescending(x => x.StartDate),
                "end"              => _sortAscending ? projects.OrderBy(x => x.EndDate)            : projects.OrderByDescending(x => x.EndDate),
                "deadline"         => _sortAscending ? projects.OrderBy(x => x.TenderDeadline)     : projects.OrderByDescending(x => x.TenderDeadline),
                "qa"               => _sortAscending ? projects.OrderBy(x => x.TenderQA)           : projects.OrderByDescending(x => x.TenderQA),
                "calculations"     => _sortAscending ? projects.OrderBy(GetCalculationCount)        : projects.OrderByDescending(GetCalculationCount),
                "byggherre"        => _sortAscending ? projects.OrderBy(x => x.Developer)          : projects.OrderByDescending(x => x.Developer),
                "organisation"     => _sortAscending ? projects.OrderBy(x => x.Organisation)       : projects.OrderByDescending(x => x.Organisation),
                "procurementName"  => _sortAscending ? projects.OrderBy(x => x.ProcurementName)    : projects.OrderByDescending(x => x.ProcurementName),
                "procurementNumber"=> _sortAscending ? projects.OrderBy(x => x.ProcurementNumber)  : projects.OrderByDescending(x => x.ProcurementNumber),
                "customerReference"=> _sortAscending ? projects.OrderBy(x => x.CustomerReference)  : projects.OrderByDescending(x => x.CustomerReference),
                "contract"         => _sortAscending ? projects.OrderBy(x => x.Contract)           : projects.OrderByDescending(x => x.Contract),
                "projectType"      => _sortAscending ? projects.OrderBy(x => x.Type)               : projects.OrderByDescending(x => x.Type),
                "inspector"        => _sortAscending ? projects.OrderBy(x => x.Inspector)          : projects.OrderByDescending(x => x.Inspector),
                "designer"         => _sortAscending ? projects.OrderBy(x => x.Designer)           : projects.OrderByDescending(x => x.Designer),
                "supervisor"       => _sortAscending ? projects.OrderBy(x => x.Supervisor)         : projects.OrderByDescending(x => x.Supervisor),
                "address"          => _sortAscending ? projects.OrderBy(x => x.AddressText)        : projects.OrderByDescending(x => x.AddressText),
                "procurementMethods" => _sortAscending ? projects.OrderBy(x => x.ProcurementMethods) : projects.OrderByDescending(x => x.ProcurementMethods),
                "compensation"     => _sortAscending ? projects.OrderBy(x => x.Compensation)       : projects.OrderByDescending(x => x.Compensation),
                "procurementProcedure" => _sortAscending ? projects.OrderBy(x => x.ProcurementProcedure) : projects.OrderByDescending(x => x.ProcurementProcedure),
                "clientsManager"   => _sortAscending ? projects.OrderBy(x => x.ClientsManager)     : projects.OrderByDescending(x => x.ClientsManager),
                "publicationDate"  => _sortAscending ? projects.OrderBy(x => x.PublicationDate)    : projects.OrderByDescending(x => x.PublicationDate),
                "decisionDate"     => _sortAscending ? projects.OrderBy(x => x.DecisionDate)       : projects.OrderByDescending(x => x.DecisionDate),
                "createdAt"        => _sortAscending ? projects.OrderBy(x => x.CreatedAt)          : projects.OrderByDescending(x => x.CreatedAt),
                "updatedAt"        => _sortAscending ? projects.OrderBy(x => x.UpdatedAt)          : projects.OrderByDescending(x => x.UpdatedAt),
                "archived"         => _sortAscending ? projects.OrderBy(x => x.IsArchived)         : projects.OrderByDescending(x => x.IsArchived),
                "shared"           => _sortAscending ? projects.OrderBy(x => x.IsShared)          : projects.OrderByDescending(x => x.IsShared),
                _                  => projects.OrderByDescending(x => x.Order).ThenBy(x => x.Name, StringComparer.CurrentCultureIgnoreCase)
            };
        }
    }

    // Materialized once per render (the memo is cleared at the top of the markup), so the
    // filter+sort pipeline runs a single time even though several render-path consumers read
    // it: the row-number map, the table's Items, the header count and the pager range. Event
    // handlers that need the freshest data keep using the live SortedProjects instead.
    private List<ListProjectMVVM>? _sortedSnapshot;
    private List<ListProjectMVVM> SortedProjectsSnapshot => _sortedSnapshot ??= SortedProjects.ToList();

    private IEnumerable<ListProjectMVVM> PagedProjects
    {
        get
        {
            var sorted = SortedProjectsSnapshot;
            if (_pageSize == 0) return sorted;
            var total = sorted.Count;
            var maxPage = (int)Math.Ceiling((double)total / _pageSize);
            if (maxPage < 1) maxPage = 1;
            if (_currentPage > maxPage) _currentPage = maxPage;
            return sorted.Skip((_currentPage - 1) * _pageSize).Take(_pageSize);
        }
    }

