                                                   class="h-3.5 w-3.5 rounded border-slate-300 text-blue-600 focus:ring-blue-500 dark:border-slate-600 dark:bg-slate-800"
                                                   checked="@IsProjectColumnVisible(colKey)"
                                                   @onchange="async e => { _projectColumns[colKey] = e.Value is bool b && b; await ViewPreference.SaveColumnsAsync(_projectColumns); }" />
                                            <span>@col.Label</span>
                                        </label>
                                    }
                                </div>
                            }
                        }
                    </div>
                }
            </div>

            @* Rapporter dropdown *@
            <div class="relative">
                <button type="button"
                        class="inline-flex h-7 items-center gap-1 rounded border border-slate-200 bg-white px-2 text-[11px] font-medium text-slate-600 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-40 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800"
