    // Resizable-column width persistence + JS interop (shared with ProjectsCalculationList).
    private ListColumnWidthController _columnWidths = default!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Only the projects table lives in this component. In Kalkyler mode the
        // child ProjectsCalculationList owns the #resizeMe table and the shared
        // JS resize callback ref, so we must not hijack it here (that would route
        // calc-column resizes to this component under the wrong scope).
        if (_contentMode != ContentModeProjects)
            return;

        // Force a "move" cursor while dragging rows to reorder (no "copy"/plus indicator).
        // Blazor's drag events can't set dataTransfer, so a tiny JS helper does it. Idempotent.
        try { await JS.InvokeVoidAsync("dragMoveEffect.attach", "resizeMe"); }
        catch (JSException) { }
        catch (InvalidOperationException) { }

        // _columnWidths is created in OnInitializedAsync *after* an await, so the
        // first OnAfterRenderAsync can fire before it exists. Once it is set the
        // component re-renders and AttachAsync runs (it is idempotent).
        if (_columnWidths is null)
            return;

        await _columnWidths.AttachAsync();

        await EnsureProjectRecentChangesAsync();
    }

    // Hämta "Senaste ändringar" för de projekt som visar indikatorn (osedd ändring). Signatur-vakt
    // gör att vi bara hämtar när uppsättningen ändras, så OnAfterRender inte loopar.
    private async Task EnsureProjectRecentChangesAsync()
    {
        var ids = BaseProjects
            .Where(HasUnseenProjectChange)
            .Select(p => p.Id)
            .Distinct()
            .OrderBy(x => x)
            .ToList();

        var sig = string.Join(",", ids);
        if (sig == _recentChangesSig)
            return;

        _recentChangesSig = sig;
        _projectRecentChanges = ids.Count == 0
            ? new()
            : await ChangeLogRepo.GetRecentForProjectsAsync(ids);

        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        // The manager loads persisted visible columns (known keys only) and saved
        // views, and forces "rowNumber" on (radnummer visas alltid som standard).
        _columnView = new MhdColumnViewManager(
            new ProjectManagement.Client.Services.Folder.ListColumnViewStore(
                ProjectManagement.Client.Services.Folder.ListSavedColumnViewStorage.ProjectListScope,
                ViewPreference.LoadColumnsAsync,
                ViewPreference.SaveColumnsAsync,
                SavedColumnViewStorage,
                ViewPreference.LoadColumnOrderAsync,
                ViewPreference.SaveColumnOrderAsync),
            DefaultProjectColumns,
            ProjectManagement.Client.Services.Folder.ListColumnViewLabels.Swedish,
            alwaysVisibleKeys: new[] { "rowNumber" },
            // Radnummer, Kod och Projektnamn är frysta och kan aldrig flyttas.
            lockedOrderKeys: new[] { "rowNumber", "code", "name" });

        // Created before the first await so it is non-null on the first render (the
        // markup reads HasActiveProjectFilters etc.). Saved filters load just below.
        _filter = new ListColumnFilterController(
            _projColFilters,
            SavedFilterStorage,
            ListSavedFilterStorage.ProjectListScope,
            _sort,
            columnExists: key => _projectColumns.ContainsKey(key),
            isColumnVisible: IsProjectColumnVisible,
            columnLabel: GetProjectColumnLabel,
            revealColumn: key => _projectColumns[key] = true,
            persistColumns: () => ViewPreference.SaveColumnsAsync(_projectColumns),
            onChanged: () => _currentPage = 1);

        await _columnView.InitializeAsync();

        _columnWidths = new ListColumnWidthController(
            JS, ViewPreference.LoadColumnWidthsAsync, ViewPreference.SaveColumnWidthsAsync);
        await _columnWidths.LoadAsync();

        // Avdelningsnamn (id → namn) för "Avdelning"-kolumnen, dess filter och export.
        var departments = await Repo.Departments.GetDepartmentsAsListAsync();
        if (departments is not null)
            _departmentNames = departments
                .GroupBy(d => d.Id)
                .ToDictionary(g => g.Key, g => g.First().Name);

        // Senast öppnad per projekt (för ändringsindikatorn).
        _lastOpened = await ViewPreference.LoadLastOpenedAsync() ?? new();

        await _filter.LoadSavedAsync();
    }

    protected override void OnInitialized()
    {
        CalcService.PageChanged += ToastChanged;
    }

    public void Dispose()
    {
        CalcService.PageChanged -= ToastChanged;
        _columnWidths?.Dispose();
    }

    private void ToastChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    private bool IsProjectColumnVisible(string key) => _columnView.IsColumnVisible(key);

    // The radnummer column (when shown) is the first frozen column at left-0 (w-12).
    // Shift the following frozen columns (code, name) right so they don't overlap it.
    private string CodeStickyLeftClass => IsProjectColumnVisible("rowNumber") ? "left-12" : "left-0";
    private string NameStickyLeftClass => IsProjectColumnVisible("rowNumber") ? "left-40" : "left-28";

    private static string FormatText(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "-" : value;

    // Projektets avdelningsnamn via avdelnings-id. Tom sträng när namn saknas → visas som "-"
    // (FormatText). Symbolen 👥 hör hemma i avdelningsträdet/dropdownen, inte i tabellkolumnen.
    private string GetProjectDepartmentName(ListProjectMVVM p) =>
        p.DepartmentId is int id && _departmentNames.TryGetValue(id, out var name) ? name : string.Empty;

    // "Mapp"-kolumnen: projektets egen mapp (serverlevererat namn). Tomt → FormatText visar "-".
    private static string GetProjectFolderName(ListProjectMVVM p) => p.FolderName;

    // Ändringsindikator: visas när projektet ändrats efter att aktuell användare senast öppnade det.
    // Aldrig öppnade objekt (ingen baslinje) visar ingen indikator.
    private bool HasUnseenProjectChange(ListProjectMVVM p) =>
        p.UpdatedAt is { } updated
        && _lastOpened.TryGetValue(p.Id.ToString(), out var opened)
        && updated > opened;

    // Markera som läst när användaren öppnar projektet → indikatorn döljs (tills nästa ändring).
    private async Task MarkProjectOpenedAsync(ListProjectMVVM p)
    {
        _lastOpened[p.Id.ToString()] = DateTime.UtcNow;
        await ViewPreference.SaveLastOpenedAsync(_lastOpened);
    }

    private static string FormatDate(DateTime value) =>
        value == default ? "-" : value.ToString(ConstValues.DateFormat);

    private static string FormatDate(DateTime? value) =>
        value.HasValue ? FormatDate(value.Value) : "-";

    private static string FormatYesNo(bool value) =>
        value ? "Ja" : "Nej";

