    private static int GetCalculationCount(ListProjectMVVM project) =>
        project.CalculationsLoaded
            ? CalculationVersionSelector.CountCurrentVersions(project.Calculations)
            : project.CalculationCount;

    private int TotalProjectCount => SortedProjectsSnapshot.Count;
    private int TotalProjectPages => _pageSize == 0 ? 1 : (int)Math.Ceiling((double)TotalProjectCount / _pageSize);
    private int FirstProjectIndex => TotalProjectCount == 0 ? 0 : (_pageSize == 0 ? 1 : (_currentPage - 1) * _pageSize + 1);
    private int LastProjectIndex => _pageSize == 0 ? TotalProjectCount : Math.Min(_currentPage * _pageSize, TotalProjectCount);

