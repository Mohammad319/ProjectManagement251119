    async Task SetProject(ListProjectMVVM pro)
    {
        await Folder.NewProject(pro);
        Folder.State.SetCalculation(null, pro, Folder.State.FolderSelected!);
    }

    async Task GetAsync(bool refresh = true)
    {
        if (refresh && Folder.State.FolderSelected is not null)
        {
            Folder.State.FolderSelected.Projects =
                await Repo.Project.GetByFolderIdAsync(Folder.State.FolderSelected.Id, UoWService.Folder.ShowArchived);

            if (Folder.State.FolderSelected.Projects != null)
                Folder.State.FolderSelected.Projects =
                    Folder.State.FolderSelected.Projects
                        .OrderByDescending(x => x.Order)
                        .ToList();
        }
        await Modal.CloseAsync();
    }

    void AddProjectAsync(Tuple<bool, ListProjectMVVM> callBack)
    {
        if (callBack == null)
        {
            Modal.CloseAsync();
            return;
        }

        var project = callBack.Item2;
        bool shouldKeepInList = UoWService.Folder.ShowArchived || callBack.Item1;

        if (UpdateProject == Guid.Empty)
        {
            if (project.Id != Guid.Empty && shouldKeepInList)
                Folder.State.FolderSelected!.Projects.Insert(0, project);
        }
        else
        {
            var existing = Folder.State.FolderSelected!.Projects.FirstOrDefault(x => x.Id == UpdateProject);
            if (existing != null)
            {
                if (!shouldKeepInList)
                    Folder.State.FolderSelected.Projects.Remove(existing);
                else
                {
                    PropertyCopier.CopyPropertiesTo(project, existing);
                    existing.Id = UpdateProject;
                }
            }
        }

        Folder.State.FolderSelected!.Projects =
            Folder.State.FolderSelected.Projects
                .OrderByDescending(x => x.Order)
                .ToList();

        UoWService.Folder.State.Notify();
        Modal.CloseAsync();
    }

    async Task DeleteProjectConfirmedAsync(ListProjectMVVM project)
    {
        bool ok = await Repo.Project.DeleteAsync(project.Id);
        if (!ok)
        {
            // Bekräftelsedialogen stängs automatiskt (AutoClose); visa felmeddelande.
            MHD.Notifications(ToastType.Delete, isSuccess: false);
            return;
        }

        // Uppdatera projektlistan och vänsterträdet – ta bort projektet ur alla
        // laddade mappar (täcker både mapp-vy och avdelningsvy).
        foreach (var folder in Folder.State.FoldersList)
            folder.Projects?.RemoveAll(p => p.Id == project.Id);
        Folder.State.FolderSelected?.Projects?.RemoveAll(p => p.Id == project.Id);

        UoWService.Folder.State.Notify();

        // Successmeddelande: "Projektet har tagits bort."
        MHD.ToastMessage(project.Name, ToastType.Delete, isSuccess: true);

        StateHasChanged();
    }

    private async Task HandleDrop(ListProjectMVVM project)
    {
        if (draggingProject is null || Folder.State.FolderSelected?.Projects is null)
            return;

        draggingProject.IsDragOver = false;
        project.IsDragOver = false;

        var list = Folder.State.FolderSelected.Projects;
        int index = list.IndexOf(project);

        if (index == 0)
            draggingProject.Order = project.Order + 100;
        else if (draggingProject.Order < project.Order)
            draggingProject.Order = (project.Order + list[index - 1].Order) / 2;
        else if (draggingProject.Order > project.Order && (index + 1) < list.Count)
            draggingProject.Order = (list[index + 1].Order + project.Order) / 2;
        else
            draggingProject.Order = project.Order - 100;

        Folder.State.FolderSelected.Projects =
            list.OrderByDescending(x => x.Order).ToList();

        await Repo.Project.ReOrderAsync(draggingProject.Id, draggingProject.Order);

        draggingProject = null;
        StateHasChanged();
    }
