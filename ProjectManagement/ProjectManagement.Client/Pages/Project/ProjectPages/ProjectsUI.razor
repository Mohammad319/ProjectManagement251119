                            {
                                <td class="w-28 whitespace-nowrap bg-white px-3 py-2 font-mono text-[11px] text-slate-500 group-hover:bg-slate-50 dark:bg-slate-950 dark:text-slate-400 dark:group-hover:bg-slate-900/80 @(isProjectSelected ? "!bg-blue-50 dark:!bg-blue-950/30" : string.Empty)">
                                    @(string.IsNullOrWhiteSpace(project.Code) ? "-" : project.Code)
                                </td>
                            }
                            @if (IsProjectColumnVisible("name"))
                            {
                                <td class="max-w-80 border-r border-slate-200 bg-white px-3 py-2 group-hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-950 dark:group-hover:bg-slate-900/80 @(isProjectSelected ? "!bg-blue-50 dark:!bg-blue-950/30" : string.Empty)">
                                    <div class="flex min-w-0 items-center gap-2">
                                        <HoverTooltip Text="@project.Name" Class="truncate font-semibold text-slate-800 dark:text-slate-100">
                                            <span class="truncate">@project.Name</span>
                                        </HoverTooltip>
                                        @if (project.ImportInfo?.IsImportedCopy == true)
                                        {
                                            <button type="button"
                                                    class="shrink-0 rounded-full border border-sky-200 bg-sky-50 px-2 py-0.5 text-[10px] font-semibold text-sky-700 transition hover:bg-sky-100 dark:border-sky-900 dark:bg-sky-950/40 dark:text-sky-300"
