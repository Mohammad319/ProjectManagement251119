    async Task GetAsync(bool refresh = true)
    {
        if (refresh && Folder.State.FolderSelected is not null)
        {
            Folder.State.FolderSelected.Projects =
                await Repo.Project.GetByFolderIdAsync(Folder.State.FolderSelected.Id, UoWService.Folder.ShowArchived);

            if (Folder.State.FolderSelected.Projects != null)
                Folder.State.FolderSelected.Projects =
                    Folder.State.FolderSelected.Projects
                        .OrderByDescending(x => x.Order)
                        .ToList();
        }
        await Modal.CloseAsync();
    }

    async Task AddProjectAsync(Tuple<bool, ListProjectMVVM> callBack)
    {
        if (callBack == null)
        {
            await Modal.CloseAsync();
            return;
        }

        var project = callBack.Item2;
        bool shouldKeepInList = UoWService.Folder.ShowArchived || callBack.Item1;
        var targetId = UpdateProject == Guid.Empty ? project.Id : UpdateProject;

        // Re-fetch the authoritative row from the server. The form's MVVM only carries the edited
        // grunddata, so using it directly would blank out the denormalized/display columns (Avdelning,
        // Mapp, Skapad datum, beställare/upphandling-metadata, Senast ändrad m.m.). Falls back to the
        // form values if the refresh can't find the row. Mirrors how the calc list reloads after save.
        ListProjectMVVM? fresh = null;
        if (targetId != Guid.Empty && Folder.State.FolderSelected is not null)
        {
            try
            {
                fresh = (await Repo.Project.GetByFolderIdAsync(Folder.State.FolderSelected.Id, includeArchived: true))
                    .FirstOrDefault(x => x.Id == targetId);
            }
            catch { /* keep fallback below */ }
        }
        var rowData = fresh ?? project;

        if (UpdateProject == Guid.Empty)
        {
            if (project.Id != Guid.Empty && shouldKeepInList)
                Folder.State.FolderSelected!.Projects.Insert(0, rowData);
        }
        else
        {
            var existing = Folder.State.FolderSelected!.Projects.FirstOrDefault(x => x.Id == UpdateProject);
            if (existing != null)
            {
                if (!shouldKeepInList)
                    Folder.State.FolderSelected.Projects.Remove(existing);
                else
                {
                    PropertyCopier.CopyPropertiesTo(rowData, existing);
                    existing.Id = UpdateProject;
                }
            }
        }

        Folder.State.FolderSelected!.Projects =
            Folder.State.FolderSelected.Projects
                .OrderByDescending(x => x.Order)
                .ToList();

        UoWService.Folder.State.Notify();
        await Modal.CloseAsync();
    }

    async Task DeleteProjectConfirmedAsync(ListProjectMVVM project)
    {
        bool ok = await Repo.Project.DeleteAsync(project.Id);
        if (!ok)
        {
            // Bekräftelsedialogen stängs automatiskt (AutoClose); visa felmeddelande.
            MHD.Notifications(ToastType.Delete, isSuccess: false);
            return;
        }

        // Uppdatera projektlistan och vänsterträdet – ta bort projektet ur alla
        // laddade mappar (täcker både mapp-vy och avdelningsvy).
        foreach (var folder in Folder.State.FoldersList)
            folder.Projects?.RemoveAll(p => p.Id == project.Id);
        Folder.State.FolderSelected?.Projects?.RemoveAll(p => p.Id == project.Id);

        UoWService.Folder.State.Notify();

        // Successmeddelande: "Projektet har tagits bort."
        MHD.ToastMessage(project.Name, ToastType.Delete, isSuccess: true);

        StateHasChanged();
    }

    // Manual drag-reorder is only meaningful in the default (manual) order, within a single
    // folder scope, and when no column sort or filter is rearranging/hiding the rows.
    private bool CanReorderProjects =>
        _contentMode == ContentModeProjects
        && string.IsNullOrEmpty(_sort.Column)
        && !HasActiveProjectFilters
        && !IsDepartmentScope
        && Folder.State.FolderSelected?.Projects is not null;

    private void OnProjectDragStart(ListProjectMVVM project)
    {
        if (CanReorderProjects)
            draggingProject = project;
    }

    // Robust, id-based reorder: remove the dragged project, re-insert it relative to the drop
    // target (after it when moving down, before it when moving up — so the last row is reachable),
    // then renumber the whole scope with stable gaps. No-ops when the order is unchanged.
    private async Task HandleDrop(ListProjectMVVM target)
    {
        var dragged = draggingProject;
        draggingProject = null;

        if (dragged is not null) dragged.IsDragOver = false;
        if (target is not null) target.IsDragOver = false;

        if (dragged is null || target is null || !CanReorderProjects || ReferenceEquals(dragged, target))
        {
            StateHasChanged();
            return;
        }

        var projects = Folder.State.FolderSelected?.Projects;
        if (projects is null)
            return;

        // Display order = top→bottom (highest Order first), matching how both this list and the
        // left tree render. Working by Id keeps the move independent of fragile UI row indexes.
        var ordered = projects
            .OrderByDescending(p => p.Order)
            .ThenBy(p => p.Name, StringComparer.CurrentCultureIgnoreCase)
            .ToList();

        var fromIndex = ordered.FindIndex(p => p.Id == dragged.Id);
        var toIndex = ordered.FindIndex(p => p.Id == target.Id);
        if (fromIndex < 0 || toIndex < 0)
            return;

        var originalIds = ordered.Select(p => p.Id).ToList();

        ordered.RemoveAt(fromIndex);
        var targetAfterRemoval = ordered.FindIndex(p => p.Id == target.Id);
        // Moving down (dragged was above target) drops after the target; moving up drops before.
        var insertIndex = fromIndex < toIndex ? targetAfterRemoval + 1 : targetAfterRemoval;
        insertIndex = Math.Clamp(insertIndex, 0, ordered.Count);
        ordered.Insert(insertIndex, dragged);

        // Dropped back on the same effective position → save nothing, change nothing.
        if (ordered.Select(p => p.Id).SequenceEqual(originalIds))
        {
            StateHasChanged();
            return;
        }

        // Renumber the whole scope so Order stays stable and collision-free (top = highest).
        // Only persist the rows whose Order actually changed (backend sets SortOrder absolutely).
        const int step = 100;
        var changed = new List<ListProjectMVVM>();
        for (var i = 0; i < ordered.Count; i++)
        {
            var newOrder = (ordered.Count - i) * step;
            if (ordered[i].Order != newOrder)
            {
                ordered[i].Order = newOrder;
                changed.Add(ordered[i]);
            }
        }

        // Both this list and the left tree render by Order over the same project objects, so
        // mutating Order above already aligns them; Notify() makes the tree re-render now.
        Folder.State.Notify();
        StateHasChanged();

        foreach (var p in changed)
            await Repo.Project.ReOrderAsync(p.Id, p.Order);
    }
