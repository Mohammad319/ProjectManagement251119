    // Resizable-column width persistence + JS interop (shared with ProjectsCalculationList).
    private ListColumnWidthController _columnWidths = default!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Only the projects table lives in this component. In Kalkyler mode the
        // child ProjectsCalculationList owns the #resizeMe table and the shared
        // JS resize callback ref, so we must not hijack it here (that would route
        // calc-column resizes to this component under the wrong scope).
        if (_contentMode != ContentModeProjects)
            return;

        // _columnWidths is created in OnInitializedAsync *after* an await, so the
        // first OnAfterRenderAsync can fire before it exists. Once it is set the
        // component re-renders and AttachAsync runs (it is idempotent).
        if (_columnWidths is null)
            return;

        await _columnWidths.AttachAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        // The manager loads persisted visible columns (known keys only) and saved
        // views, and forces "rowNumber" on (radnummer visas alltid som standard).
        _columnView = new MhdColumnViewManager(
            new ProjectManagement.Client.Services.Folder.ListColumnViewStore(
                ProjectManagement.Client.Services.Folder.ListSavedColumnViewStorage.ProjectListScope,
                ViewPreference.LoadColumnsAsync,
                ViewPreference.SaveColumnsAsync,
                SavedColumnViewStorage),
            DefaultProjectColumns,
            ProjectManagement.Client.Services.Folder.ListColumnViewLabels.Swedish,
            alwaysVisibleKeys: new[] { "rowNumber" });

        // Created before the first await so it is non-null on the first render (the
        // markup reads HasActiveProjectFilters etc.). Saved filters load just below.
        _filter = new ListColumnFilterController(
            _projColFilters,
            SavedFilterStorage,
            ListSavedFilterStorage.ProjectListScope,
            _sort,
            columnExists: key => _projectColumns.ContainsKey(key),
            isColumnVisible: IsProjectColumnVisible,
            columnLabel: GetProjectColumnLabel,
            revealColumn: key => _projectColumns[key] = true,
            persistColumns: () => ViewPreference.SaveColumnsAsync(_projectColumns),
            onChanged: () => _currentPage = 1);

        await _columnView.InitializeAsync();

        _columnWidths = new ListColumnWidthController(
            JS, ViewPreference.LoadColumnWidthsAsync, ViewPreference.SaveColumnWidthsAsync);
        await _columnWidths.LoadAsync();

        await _filter.LoadSavedAsync();
    }

