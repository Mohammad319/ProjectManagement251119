    void OpenReport(string view)
    {
        if (!IsDepartmentScope && Folder.State.FolderSelected is null)
            return;
        if (!CentralReportsDialog.IsReportEnabled(CentralReportsDialog.ReportHost.Projects, view))
            return;

        var lockedIds = SortedProjects.Select(p => p.Id).ToList();
        var count = lockedIds.Count;

        string selLine = IsDepartmentScope
            ? $"Rapporten baseras på {count} projekt från aktuell projektlista. Avdelning: {DepartmentName ?? "–"}."
            : $"Rapporten baseras på {count} projekt i mapp {Folder.State.FolderSelected?.Name ?? "–"}.";

        var filterParts = _projColFilters
            .Where(kv => kv.Value.IsActive)
            .Select(kv => GetProjectFilterLabel(kv.Key, kv.Value))
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .ToList();
        var filterSummary = string.Join(" · ", filterParts);

        var parameters = new Dictionary<string, object>
        {
            [nameof(CentralReportsDialog.InitialView)]         = view,
            [nameof(CentralReportsDialog.Host)]                = CentralReportsDialog.ReportHost.Projects,
            [nameof(CentralReportsDialog.LockedProjectIds)]    = (IReadOnlyList<Guid>)lockedIds,
            [nameof(CentralReportsDialog.SelectionSummaryLine)] = selLine,
        };

        if (!string.IsNullOrWhiteSpace(filterSummary))
            parameters[nameof(CentralReportsDialog.SelectionFilterSummary)] = filterSummary;

        if (!IsDepartmentScope && Folder.State.FolderSelected is not null)
            parameters[nameof(CentralReportsDialog.FolderScope)] = Folder.State.FolderSelected;

        Modal.ShowComponent<CentralReportsDialog>(
            AppLoc["reports"].Value,
            parameters,
            BlazorMHD.UI.Core.Services.MhdDialogSize.ExtraLarge);
    }

    private string GetProjectFilterLabel(string key, ColumnFilterState state)
    {
        var label = key switch
        {
            "code"                 => "Kod",
            "name"                 => "Projektnamn",
            "status"               => "Projektstatus",
            "responsible"          => "Ansvarig",
            "inspector"            => "Granskare",
            "deadline"             => "Anbudsdeadline",
            "qa"                   => "Frågor/svar",
            "start"                => "Startdatum",
            "end"                  => "Slutdatum",
            "calculations"         => AppLoc["calculationCount"].Value,
            "byggherre"            => "Byggherre",
            "organisation"         => "Beställare",
            "procurementName"      => AppLoc["procurementName"].Value,
            "procurementNumber"    => AppLoc["procurementNumber"].Value,
            "customerReference"    => AppLoc["customerReference"].Value,
            "contract"             => CalcResource.projectContract,
            "projectType"          => CalcResource.projectType,
            "designer"             => "Projektörer",
            "supervisor"           => "Kundens kontaktperson",
            "address"              => "Adress",
            "procurementMethods"   => CalcResource.procurementMethods,
            "compensation"         => CalcResource.projectCompensation,
            "procurementProcedure" => "Upphandlingsförfarande",
            "clientsManager"       => ResourceLoc.clientsProjectmanager,
            "publicationDate"      => CalcResource.publicationDate,
            "decisionDate"         => CalcResource.decisionDate,
            "createdAt"            => "Skapad",
            "updatedAt"            => "Senast ändrad",
            "archived"             => AppLoc["archived"].Value,
            "shared"               => "Delat",
            _                      => key
        };
        return state.Type switch
        {
            ColumnFilterType.Text when state.TextOp == TextFilterOp.IsEmpty    => $"{label}: tom",
            ColumnFilterType.Text when state.TextOp == TextFilterOp.IsNotEmpty => $"{label}: ej tom",
            ColumnFilterType.Text    => $"{label}: {state.TextValue}",
            ColumnFilterType.Dropdown when state.SelectedValues.Count > 0 =>
                $"{label}: {string.Join(", ", state.SelectedValues)}",
            ColumnFilterType.Date when state.DateOp == DateFilterOp.IsEmpty    => $"{label}: tom",
            ColumnFilterType.Date when state.DateOp == DateFilterOp.IsNotEmpty => $"{label}: ej tom",
            ColumnFilterType.Date when state.DateOp == DateFilterOp.Between    => $"{label}: {state.DateFrom:yyyy-MM-dd}–{state.DateTo:yyyy-MM-dd}",
            ColumnFilterType.Date    => $"{label}: {state.DateFrom:yyyy-MM-dd}",
            ColumnFilterType.Number when state.NumberOp == NumberFilterOp.IsEmpty    => $"{label}: tom",
            ColumnFilterType.Number when state.NumberOp == NumberFilterOp.IsNotEmpty => $"{label}: ej tom",
            ColumnFilterType.Number when state.NumberOp == NumberFilterOp.Between    => $"{label}: {state.NumberFrom}–{state.NumberTo}",
            ColumnFilterType.Number  => $"{label}: {state.NumberFrom}",
            ColumnFilterType.Boolean => $"{label}: {(state.BoolValue == "true" ? "Ja" : "Nej")}",
            _                        => label
        };
    }

    private Task ExportProjectListAsync() => ExportProjectListAsync(pdfMode: false, printOnly: false);
