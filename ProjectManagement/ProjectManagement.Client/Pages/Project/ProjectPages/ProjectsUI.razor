@using ProjectManagement.Client.Constant
@using ProjectManagement.Client.Helper
@using Microsoft.Extensions.Logging
@using ProjectManagement.Client.Services.Folder
@using ProjectManagement.Client.Shared.MVVM.Folder
@using ProjectManagement.Client.Shared.Model.Project
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@using ProjectManagement.Shared.DTO.Project
@using System.Net.Http
@using BlazorMHD.UI.Core.Data
@using BlazorMHD.UI.Core.DesignSystem
@using ProjectManagement.Client.Shared.MVVM.Calculation
@using ProjectManagement.Shared.Enums
@inherits AppComponentBase
@implements IDisposable
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS
@inject ProjectManagement.Client.Services.Folder.ProjectListViewPreference ViewPreference

<div class="flex h-full min-h-0 flex-col gap-1 overflow-hidden px-1 pb-1">
    @if (_contentMode == ContentModeCalculations)
    {
        <ProjectsCalculationList @key="@($"folder-calculations-{IsDepartmentScope}-{Folder.State.FolderSelected?.Id}-{Folder.State.SelectedDepartmentId}")"
                                 FolderScopeMode="true"
                                 IsDepartmentScope="@IsDepartmentScope"
                                 DepartmentName="@DepartmentName"
                                 OnShowProjectsRequested="SwitchToProjectMode" />
    }
    else
    {

    @* ── Sticky header ─────────────────────────────────── *@
    <div class="sticky top-0 z-[80] shrink-0 -mx-1 border-b border-slate-200 bg-white px-1 pb-1 shadow-sm dark:border-slate-800 dark:bg-slate-950">
    <div class="flex w-full flex-wrap items-center justify-between gap-1.5 px-1 pt-1 pb-0.5">
        <div class="min-w-0">
            <div class="flex flex-col text-gray-700 dark:text-gray-300">
                <span class="truncate text-sm font-semibold">
                    @if (_contentMode == ContentModeCalculations)
                    {
                        <span>Kalkyler i @(IsDepartmentScope ? DepartmentName : Folder.State.FolderSelected?.Name ?? "-")</span>
                    }
                    else
                    {
                        @if (IsDepartmentScope)
                        {
                            <span>Projekt i @(DepartmentName ?? "-")</span>
                        }
                        else
                        {
                            @AppLoc["projectsInFolderFormat", Folder.State.FolderSelected?.Name ?? "-"]
                        }
                    }
                </span>
                <span class="truncate text-xs text-slate-500 dark:text-slate-400">
                    @if (_contentMode == ContentModeCalculations)
                    {
                        <span>0 @CalcResource.calculation</span>
                    }
                    else
                    {
                        <span>@SortedProjects.Count() @CalcResource.project</span>
                        @if (IsDepartmentScope)
                        {
                            <span class="ml-1 text-slate-400">· hela avdelningen</span>
                        }
                    }
                </span>
            </div>
        </div>

        <div class="flex flex-wrap items-center gap-1">

            @* Filtrera *@
            <div class="relative">
                <button type="button"
                        class="@(HasActiveProjectFilters ? "inline-flex h-7 items-center gap-1 rounded border border-blue-300 bg-blue-50 px-2 text-[11px] font-medium text-blue-700 transition dark:border-blue-800 dark:bg-blue-950/40 dark:text-blue-300" : "inline-flex h-7 items-center gap-1 rounded border border-slate-200 bg-white px-2 text-[11px] font-medium text-slate-600 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800")"
                        @onclick="() => _filterMenuOpen = !_filterMenuOpen">
                    <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2a1 1 0 01-.293.707L13 13.414V19a1 1 0 01-.553.894l-4 2A1 1 0 017 21v-7.586L3.293 6.707A1 1 0 013 6V4z" />
                    </svg>
                    <span>@AppLoc["filter"]</span>
                    @if (ActiveProjectFilterCount > 0)
                    {
                        <span class="inline-flex h-4 min-w-[1rem] items-center justify-center rounded-full bg-blue-600 px-1 text-[9px] font-bold leading-none text-white dark:bg-blue-500">@ActiveProjectFilterCount</span>
                    }
                    <svg class="h-2.5 w-2.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                    </svg>
                </button>
                @if (_filterMenuOpen)
                {
                    <div class="fixed inset-0 z-[70]" @onclick="() => _filterMenuOpen = false"></div>
                    <div class="absolute left-0 top-full z-[90] mt-1 w-48 rounded-md border border-slate-200 bg-white py-1 shadow-lg dark:border-slate-700 dark:bg-slate-900">
                        @if (HasActiveProjectFilters)
                        {
                            <button type="button"
                                    class="flex w-full items-center gap-2 px-3 py-1.5 text-[11px] text-red-600 hover:bg-red-50 dark:text-red-400 dark:hover:bg-red-950/30"
                                    @onclick="() => { ClearProjectFilters(); _filterMenuOpen = false; }">
                                <svg class="h-3 w-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                                <span>@AppLoc["clearAllFilters"]</span>
                            </button>
                        }
                        else
                        {
                            <span class="block px-3 py-2 text-[11px] text-slate-400 dark:text-slate-500">@AppLoc["noActiveFilters"]</span>
                        }
                    </div>
                }
            </div>

            @* Vy dropdown *@
            <div class="relative">
                <button type="button"
                        class="@(ViewBadgeCount > 0 ? "inline-flex h-7 items-center gap-1 rounded border border-blue-300 bg-blue-50 px-2 text-[11px] font-medium text-blue-700 transition dark:border-blue-800 dark:bg-blue-950/40 dark:text-blue-300" : "inline-flex h-7 items-center gap-1 rounded border border-slate-200 bg-white px-2 text-[11px] font-medium text-slate-600 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800")"
                        @onclick="() => _viewMenuOpen = !_viewMenuOpen">
                    <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                    </svg>
                    <span>@AppLoc["view"]</span>
                    @if (ViewBadgeCount > 0)
                    {
                        <span class="inline-flex h-4 min-w-[1rem] items-center justify-center rounded-full bg-blue-600 px-1 text-[9px] font-bold leading-none text-white dark:bg-blue-500">@ViewBadgeCount</span>
                    }
                    <svg class="h-2.5 w-2.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                    </svg>
                </button>
                @if (_viewMenuOpen)
                {
                    <div class="fixed inset-0 z-[70]" @onclick="() => { _viewMenuOpen = false; _showColumnPanel = false; }"></div>
                    <div class="absolute left-0 top-full z-[90] mt-1 w-56 rounded-md border border-slate-200 bg-white py-1 shadow-lg dark:border-slate-700 dark:bg-slate-900">

                        @* Innehåll *@
                        <div class="px-3 pt-1.5 pb-0.5">
                            <span class="text-[10px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500">Innehåll</span>
                        </div>
                        <button type="button"
                                class="@(_contentMode == ContentModeProjects ? "flex w-full items-center gap-2 px-3 py-1.5 text-[11px] text-blue-700 dark:text-blue-300" : "flex w-full items-center gap-2 px-3 py-1.5 text-[11px] text-slate-700 hover:bg-slate-50 dark:text-slate-200 dark:hover:bg-slate-800")"
                                @onclick="() => { _contentMode = ContentModeProjects; _viewMenuOpen = false; }">
                            <svg class="h-3 w-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4.5 5.5h15v13h-15z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 9h8M8 13h5" />
                            </svg>
                            <span class="flex-1 text-left">Projekt</span>
                            @if (_contentMode == ContentModeProjects)
                            {
                                <svg class="ml-auto h-3 w-3 shrink-0 text-blue-600 dark:text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
                            }
                        </button>
                        <button type="button"
                                class="@(_contentMode == ContentModeCalculations ? "flex w-full items-center gap-2 px-3 py-1.5 text-[11px] text-blue-700 dark:text-blue-300" : "flex w-full items-center gap-2 px-3 py-1.5 text-[11px] text-slate-700 hover:bg-slate-50 dark:text-slate-200 dark:hover:bg-slate-800")"
                                @onclick="async () => await SwitchToCalculationModeAsync()">
                            <svg class="h-3 w-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 11h.01M12 11h.01M15 11h.01M4 5h16a1 1 0 011 1v12a1 1 0 01-1 1H4a1 1 0 01-1-1V6a1 1 0 011-1z" />
                            </svg>
                            <span class="flex-1 text-left">Kalkyler</span>
                            @if (_contentMode == ContentModeCalculations)
                            {
                                <svg class="ml-auto h-3 w-3 shrink-0 text-blue-600 dark:text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
                            }
                        </button>

                        @if (_contentMode == ContentModeCalculations)
                        {
                            @* Separator *@
                            <div class="my-1 border-t border-slate-100 dark:border-slate-800"></div>

                            @* Visa alla versioner (only in Kalkyler mode) *@
                            <button type="button"
                                    class="@(_showAllVersions ? "flex w-full items-center gap-2 px-3 py-1.5 text-[11px] text-blue-700 dark:text-blue-300" : "flex w-full items-center gap-2 px-3 py-1.5 text-[11px] text-slate-700 hover:bg-slate-50 dark:text-slate-200 dark:hover:bg-slate-800")"
                                    @onclick="() => { _showAllVersions = !_showAllVersions; _viewMenuOpen = false; }">
                                <svg class="h-3 w-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2" />
                                </svg>
                                <span class="flex-1 text-left">@AppLoc["showAllVersions"]</span>
                                @if (_showAllVersions)
                                {
                                    <svg class="ml-auto h-3 w-3 shrink-0 text-blue-600 dark:text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
                                }
                            </button>
                        }

                        @if (_contentMode == ContentModeProjects)
                        {
                            @* Separator *@
                            <div class="my-1 border-t border-slate-100 dark:border-slate-800"></div>

                            <button type="button"
                                    class="flex w-full items-center gap-2 px-3 py-1.5 text-[11px] text-slate-700 hover:bg-slate-50 dark:text-slate-200 dark:hover:bg-slate-800"
                                    @onclick="() => _showColumnPanel = !_showColumnPanel">
                                <svg class="h-3 w-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2" />
                                </svg>
                                <span class="flex-1 text-left">@AppLoc["selectColumns"]</span>
                                <svg class="h-2.5 w-2.5 shrink-0 text-slate-400 transition-transform @(_showColumnPanel ? "rotate-180" : "")" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                    <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                                </svg>
                            </button>
                            @if (_showColumnPanel)
                            {
                                <div class="max-h-52 overflow-y-auto px-1 pb-1">
                                    @foreach (var col in ProjectColumnOptions)
                                    {
                                        var colKey = col.Key;
                                        <label class="flex cursor-pointer items-center gap-2 rounded px-2 py-1 text-[11px] text-slate-700 hover:bg-slate-50 dark:text-slate-200 dark:hover:bg-slate-800">
                                            <input type="checkbox"
                                                   class="h-3.5 w-3.5 rounded border-slate-300 text-blue-600 focus:ring-blue-500 dark:border-slate-600 dark:bg-slate-800"
                                                   checked="@IsProjectColumnVisible(colKey)"
                                                   @onchange="async e => { _projectColumns[colKey] = e.Value is bool b && b; await ViewPreference.SaveColumnsAsync(_projectColumns); }" />
                                            <span>@col.Label</span>
                                        </label>
                                    }
                                </div>
                            }
                        }
                    </div>
                }
            </div>

            @* Rapporter dropdown *@
            <div class="relative">
                <button type="button"
                        class="inline-flex h-7 items-center gap-1 rounded border border-slate-200 bg-white px-2 text-[11px] font-medium text-slate-600 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-40 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800"
                        disabled="@(!IsDepartmentScope && Folder.State.FolderSelected is null)"
                        @onclick="() => _reportMenuOpen = !_reportMenuOpen">
                    <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    <span>@AppLoc["reports"]</span>
                    <svg class="h-2.5 w-2.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                    </svg>
                </button>
                @if (_reportMenuOpen)
                {
                    <div class="fixed inset-0 z-[70]" @onclick="() => _reportMenuOpen = false"></div>
                    <div class="absolute right-0 top-full z-[90] mt-1 w-52 rounded-md border border-slate-200 bg-white py-1 shadow-lg dark:border-slate-700 dark:bg-slate-900">
                        @foreach (var item in ProjectReportMenuItems)
                        {
                            var itemView = item.View;
                            <button type="button"
                                    class="@(item.Enabled ? "flex w-full items-center gap-2 px-3 py-1.5 text-[11px] text-slate-700 hover:bg-slate-50 dark:text-slate-200 dark:hover:bg-slate-800" : "flex w-full cursor-not-allowed items-center gap-2 px-3 py-1.5 text-[11px] text-slate-400 dark:text-slate-600")"
                                    disabled="@(!item.Enabled)"
                                    title="@item.DisabledReason"
                                    @onclick="() => { _reportMenuOpen = false; OpenReport(itemView); }">
                                <span>@AppLoc[item.LabelKey]</span>
                            </button>
                        }
                    </div>
                }
            </div>


            <div class="h-4 w-px bg-slate-200 dark:bg-slate-700"></div>

            <AuthorizeView Roles="@PMRolesConst.Tenant.AdminManger">
                @if (_contentMode == ContentModeProjects)
                {
                    <button type="button"
                            class="inline-flex h-7 shrink-0 items-center gap-1 rounded border border-emerald-400 bg-emerald-500 px-2 text-[11px] font-semibold text-white transition hover:bg-emerald-600 disabled:cursor-not-allowed disabled:opacity-40 dark:border-emerald-600 dark:bg-emerald-600 dark:hover:bg-emerald-700"
                            disabled="@(IsDepartmentScope || Folder.State.OtherDepartment || Folder.State.FolderSelected is null)"
                            title="@(IsDepartmentScope ? "Välj en mapp innan du skapar ett projekt" : AppLoc["newProject"].Value)"
                            @onclick="() => UpdateForm(new ListProjectMVVM())">
                        <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                        </svg>
                        <span>@AppLoc["newProject"]</span>
                    </button>
                }
                else
                {
                    <button type="button"
                            class="inline-flex h-7 shrink-0 items-center gap-1 rounded border border-emerald-400 bg-emerald-500 px-2 text-[11px] font-semibold text-white transition hover:bg-emerald-600 disabled:cursor-not-allowed disabled:opacity-40 dark:border-emerald-600 dark:bg-emerald-600 dark:hover:bg-emerald-700"
                            disabled="true"
                            title="Välj ett projekt innan du skapar en kalkyl"
                            @onclick="() => { }">
                        <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                        </svg>
                        <span>@AppLoc["newCalculation"]</span>
                    </button>
                }
            </AuthorizeView>
        </div>
    </div>
    </div>@* ── End sticky header ─────────────────────────── *@

    @* ── Content area ────────────────────────────────────── *@
    @if (BaseProjects.Any())
    {
        <div class="divNetCalc flex-1 min-h-0 overflow-auto rounded-lg border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-950">
            <table id="resizeMe" class="w-max min-w-full table-auto text-left text-xs">
                <thead class="sticky top-0 z-50 bg-slate-50 text-[11px] font-semibold text-slate-500 dark:bg-slate-900 dark:text-slate-400">
                    <tr>
                        @if (IsProjectColumnVisible("code"))
                        {
                            <th id="hcode" data-pm-frozen="true" class="@SortableHeaderClass("code") sticky left-0 z-[60] w-28 bg-slate-50 dark:bg-slate-900" style="min-width:70px;" @onclick='() => SortBy("code")'>
                                <span class="inline-flex items-center gap-1">@CalcResource.code @((MarkupString)SortIndicatorHtml("code")) <TableColumnFilter FilterState='PF("code")' OnChanged="OnProjectColumnFilterChanged" /></span>
                            </th>
                        }
                        @if (IsProjectColumnVisible("name"))
                        {
                            <th id="hname" data-pm-frozen="true" class="@SortableHeaderClass("name") sticky left-28 z-[59] min-w-52 border-r border-slate-300 bg-slate-50 dark:border-slate-600 dark:bg-slate-900" style="min-width:160px;" @onclick='() => SortBy("name")'>
                                <span class="inline-flex items-center gap-1">@AppLoc["projectName"] @((MarkupString)SortIndicatorHtml("name")) <TableColumnFilter FilterState='PF("name")' OnChanged="OnProjectColumnFilterChanged" /></span>
                            </th>
                        }
                        @if (IsProjectColumnVisible("status"))
                        {
                            <th id="hstatus" class="@SortableHeaderClass("status")" style="min-width:80px;" title="Projektstatus beskriver projektets övergripande läge och resultat, t.ex. förfrågan, inlämnat, vunnet eller förlorat." @onclick='() => SortBy("status")'>
                                <span class="inline-flex items-center gap-1">Projektstatus @((MarkupString)SortIndicatorHtml("status")) <TableColumnFilter FilterState='PF("status")' OnChanged="OnProjectColumnFilterChanged" /></span>
                            </th>
                        }
                        @if (IsProjectColumnVisible("responsible"))
                        {
                            <th id="hresponsible" class="@SortableHeaderClass("responsible")" style="min-width:80px;" @onclick='() => SortBy("responsible")'>
                                <span class="inline-flex items-center gap-1">@AppLoc["calculationResponsible"] @((MarkupString)SortIndicatorHtml("responsible")) <TableColumnFilter FilterState='PF("responsible")' OnChanged="OnProjectColumnFilterChanged" /></span>
                            </th>
                        }
                        @if (IsProjectColumnVisible("start"))
                        {
                            <th id="hstart" class="@SortableHeaderClass("start")" style="min-width:80px;" @onclick='() => SortBy("start")'>
                                <span class="inline-flex items-center gap-1">@CalcResource.startDate @((MarkupString)SortIndicatorHtml("start")) <TableColumnFilter FilterState='PF("start")' OnChanged="OnProjectColumnFilterChanged" /></span>
                            </th>
                        }
                        @if (IsProjectColumnVisible("end"))
                        {
                            <th id="hend" class="@SortableHeaderClass("end")" style="min-width:80px;" @onclick='() => SortBy("end")'>
                                <span class="inline-flex items-center gap-1">@CalcResource.endDate @((MarkupString)SortIndicatorHtml("end")) <TableColumnFilter FilterState='PF("end")' OnChanged="OnProjectColumnFilterChanged" /></span>
                            </th>
                        }
                        @if (IsProjectColumnVisible("deadline"))
                        {
                            <th id="hdeadline" class="@SortableHeaderClass("deadline")" style="min-width:80px;" @onclick='() => SortBy("deadline")'>
                                <span class="inline-flex items-center gap-1">@CalcResource.tenderDeadline @((MarkupString)SortIndicatorHtml("deadline")) <TableColumnFilter FilterState='PF("deadline")' OnChanged="OnProjectColumnFilterChanged" /></span>
                            </th>
                        }
                        @if (IsProjectColumnVisible("qa"))
                        {
                            <th id="hqa" class="@SortableHeaderClass("qa")" style="min-width:80px;" title="Sista dag för frågor och svar" @onclick='() => SortBy("qa")'>
                                <span class="inline-flex items-center gap-1">Frågor/svar @((MarkupString)SortIndicatorHtml("qa")) <TableColumnFilter FilterState='PF("qa")' OnChanged="OnProjectColumnFilterChanged" /></span>
                            </th>
                        }
                        @if (IsProjectColumnVisible("calculations"))
                        {
                            <th id="hcalculations" class="@SortableHeaderClass("calculations") text-right" style="min-width:60px;" @onclick='() => SortBy("calculations")'>
                                <span class="inline-flex items-center justify-end gap-1">@AppLoc["calculationCount"] @((MarkupString)SortIndicatorHtml("calculations")) <TableColumnFilter FilterState='PF("calculations")' OnChanged="OnProjectColumnFilterChanged" /></span>
                            </th>
                        }
                        @if (IsProjectColumnVisible("byggherre"))
                        {
