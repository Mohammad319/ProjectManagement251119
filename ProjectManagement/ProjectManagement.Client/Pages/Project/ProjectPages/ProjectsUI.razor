@using ProjectManagement.Client.Constant
@using ProjectManagement.Client.Helper
@using Microsoft.Extensions.Logging
@using ProjectManagement.Client.Services.Folder
@using ProjectManagement.Client.Shared.MVVM.Folder
@using ProjectManagement.Client.Shared.Model.Project
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@using ProjectManagement.Shared.DTO.Project
@using System.Net.Http
@using BlazorMHD.UI.Core.Data
@using BlazorMHD.UI.Core.DesignSystem
@using BlazorMHD.UI.Components.Data.ColumnPicker
@inherits AppComponentBase
@implements IDisposable
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS

<div class="ml-1">

    @* ── Header toolbar ─────────────────────────────────── *@
    <div class="sticky top-0 z-20 bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-700 flex w-full flex-wrap items-center justify-between gap-2 px-1 py-1">
        <div class="min-w-0">
            <div class="truncate text-sm font-semibold text-gray-700 dark:text-gray-300">
                @AppLoc["projectsInFolderFormat", Folder.State.FolderSelected?.Name ?? "-"]
            </div>
            <div class="text-xs text-slate-500 dark:text-slate-400">
                @SortedProjects.Count() @CalcResource.project
                @if (HasActiveProjectFilters)
                {
                    <button type="button"
                            class="ml-2 inline-flex items-center gap-0.5 rounded bg-blue-50 px-1.5 py-0.5 text-[10px] font-semibold text-blue-600 hover:bg-blue-100 dark:bg-blue-950/40 dark:text-blue-300 dark:hover:bg-blue-950/60"
                            @onclick="ClearProjectFilters"
                            title="Rensa alla kolumnfilter">
                        <svg class="h-2.5 w-2.5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 3a1 1 0 011-1h12a1 1 0 011 1v3a1 1 0 01-.293.707L13 10.414V15a1 1 0 01-.553.894l-4 2A1 1 0 017 19v-8.586L3.293 6.707A1 1 0 013 6V3z" clip-rule="evenodd"/></svg>
                        Rensa filter
                    </button>
                }
            </div>
        </div>

        <div class="flex flex-wrap items-center gap-2">

            @if (!Folder.State.OtherDepartment)
            {
                <button type="button"
                        class="inline-flex h-9 items-center gap-1.5 rounded-lg border px-3 text-sm font-semibold transition @(UoWService.Folder.ShowArchived ? "border-amber-300 bg-amber-50 text-amber-700 hover:bg-amber-100 dark:border-amber-800/60 dark:bg-amber-950/30 dark:text-amber-300 dark:hover:bg-amber-950/50" : "border-slate-200 bg-slate-50 text-slate-600 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800")"
                        title="@AppLoc["showArchived"]"
                        @onclick="HandleToggleArchived">
                    <span>@AppLoc["showArchived"]</span>
                </button>
            }

            <MhdColumnPicker Text="@AppLoc["columns"]"
                             Columns="@ProjectColumnOptions"
                             ColumnVisibility="_projectColumns"
                             OnChanged="StateHasChanged" />

            <button type="button" class="@ToolbarButtonClass" @onclick="ExportProjectListAsync">@AppLoc["exportExcel"]</button>
            <button type="button" class="@ToolbarButtonClass" @onclick="ExportProjectPdfAsync">@AppLoc["exportPdf"]</button>
            <button type="button" class="@ToolbarButtonClass" @onclick="PrintProjectListAsync">@AppLoc["print"]</button>

            <button type="button"
                    class="inline-flex h-9 items-center gap-1.5 rounded-lg border border-sky-300 bg-sky-50 px-3 text-sm font-semibold text-sky-700 transition hover:bg-sky-100 disabled:cursor-not-allowed disabled:opacity-50 dark:border-sky-900/60 dark:bg-sky-950/30 dark:text-sky-300 dark:hover:bg-sky-950/50"
                    disabled="@(Folder.State.FolderSelected is null)"
                    title="@AppLoc["reports"]"
                    @onclick="OpenReports">
                <span>@AppLoc["reports"]</span>
            </button>

            <AuthorizeView Roles="@PMRolesConst.Tenant.AdminManger">
                <button type="button"
                        class="inline-flex h-9 items-center gap-1.5 rounded-lg border border-emerald-300 bg-emerald-50 px-3 text-sm font-semibold text-emerald-700 transition hover:bg-emerald-100 disabled:cursor-not-allowed disabled:opacity-50 dark:border-emerald-900/60 dark:bg-emerald-950/30 dark:text-emerald-300 dark:hover:bg-emerald-950/50"
                        disabled="@(Folder.State.OtherDepartment || Folder.State.FolderSelected is null)"
                        title="@AppLoc["newProject"]"
                        @onclick="() => UpdateForm(new ListProjectMVVM())">
                    <span aria-hidden="true">@((MarkupString)Icons.Plus)</span>
                    <span>@AppLoc["newProject"]</span>
                </button>
            </AuthorizeView>
        </div>
    </div>

    @* ── Project table ───────────────────────────────────── *@
    @if (SortedProjects.Any())
    {
        <div class="mr-1 overflow-x-auto rounded-lg border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-950">
            <table class="min-w-full table-auto text-left text-xs">
                <thead class="sticky top-11 z-10 bg-slate-50 text-[11px] font-semibold text-slate-500 dark:bg-slate-900 dark:text-slate-400">
                    <tr>
                        @if (IsProjectColumnVisible("code"))
                        {
                            <th class="@SortableHeaderClass("code") sticky left-0 z-[1] w-28 bg-slate-50 dark:bg-slate-900" @onclick='() => SortBy("code")'>
                                <span class="inline-flex items-center gap-1">
                                    @CalcResource.code
                                    @((MarkupString)SortIndicatorHtml("code"))
                                    <TableColumnFilter FilterState='PF("code")' OnChanged="OnProjectColumnFilterChanged" />
                                </span>
                            </th>
                        }
                        @if (IsProjectColumnVisible("name"))
                        {
                            <th class="@SortableHeaderClass("name") sticky left-28 z-[1] min-w-52 bg-slate-50 dark:bg-slate-900" @onclick='() => SortBy("name")'>
                                <span class="inline-flex items-center gap-1">
                                    @AppLoc["projectName"]
                                    @((MarkupString)SortIndicatorHtml("name"))
                                    <TableColumnFilter FilterState='PF("name")' OnChanged="OnProjectColumnFilterChanged" />
                                </span>
                            </th>
                        }
                        @if (IsProjectColumnVisible("status"))
                        {
                            <th class="@SortableHeaderClass("status")" @onclick='() => SortBy("status")'>
                                <span class="inline-flex items-center gap-1">
                                    @CalcResource.status
                                    @((MarkupString)SortIndicatorHtml("status"))
                                    <TableColumnFilter FilterState='PF("status")' OnChanged="OnProjectColumnFilterChanged" />
                                </span>
                            </th>
                        }
                        @if (IsProjectColumnVisible("responsible"))
                        {
                            <th class="@SortableHeaderClass("responsible")" @onclick='() => SortBy("responsible")'>
                                <span class="inline-flex items-center gap-1">
                                    @AppLoc["calculationResponsible"]
                                    @((MarkupString)SortIndicatorHtml("responsible"))
                                    <TableColumnFilter FilterState='PF("responsible")' OnChanged="OnProjectColumnFilterChanged" />
                                </span>
                            </th>
                        }
                        @if (IsProjectColumnVisible("start"))
                        {
                            <th class="@SortableHeaderClass("start")" @onclick='() => SortBy("start")'>
                                <span class="inline-flex items-center gap-1">
                                    @CalcResource.startDate
                                    @((MarkupString)SortIndicatorHtml("start"))
                                    <TableColumnFilter FilterState='PF("start")' OnChanged="OnProjectColumnFilterChanged" />
                                </span>
                            </th>
                        }
                        @if (IsProjectColumnVisible("end"))
                        {
                            <th class="@SortableHeaderClass("end")" @onclick='() => SortBy("end")'>
                                <span class="inline-flex items-center gap-1">
                                    @CalcResource.endDate
                                    @((MarkupString)SortIndicatorHtml("end"))
                                    <TableColumnFilter FilterState='PF("end")' OnChanged="OnProjectColumnFilterChanged" />
                                </span>
                            </th>
                        }
                        @if (IsProjectColumnVisible("deadline"))
                        {
                            <th class="@SortableHeaderClass("deadline")" @onclick='() => SortBy("deadline")'>
                                <span class="inline-flex items-center gap-1">
                                    @CalcResource.tenderDeadline
                                    @((MarkupString)SortIndicatorHtml("deadline"))
                                    <TableColumnFilter FilterState='PF("deadline")' OnChanged="OnProjectColumnFilterChanged" />
                                </span>
                            </th>
                        }
                        @if (IsProjectColumnVisible("qa"))
                        {
                            <th class="@SortableHeaderClass("qa")" @onclick='() => SortBy("qa")'>
                                <span class="inline-flex items-center gap-1">
                                    @CalcResource.tenderQA
                                    @((MarkupString)SortIndicatorHtml("qa"))
                                    <TableColumnFilter FilterState='PF("qa")' OnChanged="OnProjectColumnFilterChanged" />
                                </span>
                            </th>
                        }
                        @if (IsProjectColumnVisible("calculations"))
                        {
                            <th class="@SortableHeaderClass("calculations") text-right" @onclick='() => SortBy("calculations")'>
                                <span class="inline-flex items-center justify-end gap-1">
                                    @AppLoc["calculationCount"]
                                    @((MarkupString)SortIndicatorHtml("calculations"))
                                </span>
                            </th>
                        }
                        @if (IsProjectColumnVisible("byggherre"))
                        {
                            <th class="@SortableHeaderClass("byggherre")" @onclick='() => SortBy("byggherre")'>
                                <span class="inline-flex items-center gap-1">
                                    @CalcResource.developer
                                    @((MarkupString)SortIndicatorHtml("byggherre"))
                                    <TableColumnFilter FilterState='PF("byggherre")' OnChanged="OnProjectColumnFilterChanged" />
                                </span>
                            </th>
                        }
                        @if (IsProjectColumnVisible("organisation"))
                        {
                            <th class="@SortableHeaderClass("organisation")" @onclick='() => SortBy("organisation")'>
                                <span class="inline-flex items-center gap-1">
                                    @ResourceApp.organisation
                                    @((MarkupString)SortIndicatorHtml("organisation"))
                                    <TableColumnFilter FilterState='PF("organisation")' OnChanged="OnProjectColumnFilterChanged" />
                                </span>
                            </th>
                        }
                        @if (IsProjectColumnVisible("procurementName"))
                        {
                            <th class="@SortableHeaderClass("procurementName")" @onclick='() => SortBy("procurementName")'>
                                <span class="inline-flex items-center gap-1">
                                    @AppLoc["procurementName"]
                                    @((MarkupString)SortIndicatorHtml("procurementName"))
                                </span>
                            </th>
                        }
                        @if (IsProjectColumnVisible("procurementNumber"))
                        {
                            <th class="@SortableHeaderClass("procurementNumber")" @onclick='() => SortBy("procurementNumber")'>
                                <span class="inline-flex items-center gap-1">
                                    @AppLoc["procurementNumber"]
                                    @((MarkupString)SortIndicatorHtml("procurementNumber"))
                                </span>
                            </th>
                        }
                        @if (IsProjectColumnVisible("customerReference"))
                        {
                            <th class="@SortableHeaderClass("customerReference")" @onclick='() => SortBy("customerReference")'>
                                <span class="inline-flex items-center gap-1">
                                    @AppLoc["customerReference"]
                                    @((MarkupString)SortIndicatorHtml("customerReference"))
                                </span>
                            </th>
                        }
                        @if (IsProjectColumnVisible("contract"))
                        {
                            <th class="@SortableHeaderClass("contract")" @onclick='() => SortBy("contract")'>
                                <span class="inline-flex items-center gap-1">
                                    @CalcResource.projectContract
                                    @((MarkupString)SortIndicatorHtml("contract"))
                                </span>
                            </th>
                        }
                        @if (IsProjectColumnVisible("projectType"))
                        {
                            <th class="@SortableHeaderClass("projectType")" @onclick='() => SortBy("projectType")'>
                                <span class="inline-flex items-center gap-1">
                                    @CalcResource.projectType
                                    @((MarkupString)SortIndicatorHtml("projectType"))
                                </span>
                            </th>
                        }
                        @if (IsProjectColumnVisible("inspector"))
                        {
                            <th class="@SortableHeaderClass("inspector")" @onclick='() => SortBy("inspector")'>
                                <span class="inline-flex items-center gap-1">
                                    @CalcResource.inspector
                                    @((MarkupString)SortIndicatorHtml("inspector"))
                                    <TableColumnFilter FilterState='PF("inspector")' OnChanged="OnProjectColumnFilterChanged" />
                                </span>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                    @foreach (var project in PagedProjects)
                    {
                        var isProjectArchived = !project.IsVisible;
                        var isProjectSelected = Folder.State.ProjectSelected?.Id == project.Id;
                        var rowClasses = GetProjectRowClass(project, isProjectSelected, isProjectArchived);

                        <tr @key="project.Id"
                            class="@rowClasses"
                            @oncontextmenu:preventDefault
                            @oncontextmenu="() => Context(project)"
                            @onclick="async () => await SetProject(project)"
                            @ondrop="async _ => await HandleDrop(project)"
                            @ondragleave="() => project.IsDragOver = false"
                            @ondragover:preventDefault="true"
                            @ondragover="() => project.IsDragOver = draggingProject is not null"
                            @ondragstart="() => draggingProject = project"
                            @ondragend="() => draggingProject = null"
                            draggable="true">
                            @if (IsProjectColumnVisible("code"))
                            {
                                <td class="sticky left-0 z-[1] w-28 bg-white whitespace-nowrap px-3 py-2 font-mono text-[11px] text-slate-500 dark:bg-slate-950 dark:text-slate-400">
                                    <span class="inline-flex items-center gap-1.5">
                                        <span class="h-2.5 w-2.5 rounded-full border border-slate-300 dark:border-slate-700"
                                              style="background-color:@project.Color"></span>
                                        @(string.IsNullOrWhiteSpace(project.Code) ? "-" : project.Code)
                                    </span>
                                </td>
                            }
                            @if (IsProjectColumnVisible("name"))
                            {
                                <td class="sticky left-28 z-[1] max-w-80 bg-white px-3 py-2 dark:bg-slate-950">
                                    <span class="block truncate font-semibold text-slate-800 dark:text-slate-100" title="@project.Name">@project.Name</span>
                                </td>
                            }
                            @if (IsProjectColumnVisible("status"))
                            {
                                <td class="whitespace-nowrap px-3 py-2">
                                    <span class="@GetProjectStatusClass(project)">
                                        @GetProjectStatusText(project)
                                    </span>
                                </td>
                            }
                            @if (IsProjectColumnVisible("responsible"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatText(project.Responsible)</td>
                            }
                            @if (IsProjectColumnVisible("start"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatDate(project.StartDate)</td>
                            }
                            @if (IsProjectColumnVisible("end"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatDate(project.EndDate)</td>
                            }
                            @if (IsProjectColumnVisible("deadline"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatDate(project.TenderDeadline)</td>
                            }
                            @if (IsProjectColumnVisible("qa"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatDate(project.TenderQA)</td>
                            }
                            @if (IsProjectColumnVisible("calculations"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-right">
                                    <button type="button"
                                            class="inline-flex min-w-[2rem] items-center justify-center rounded-md px-1.5 py-0.5 text-xs font-semibold text-slate-600 transition hover:bg-sky-100 hover:text-sky-700 dark:text-slate-300 dark:hover:bg-sky-900/40 dark:hover:text-sky-300"
                                            title="@AppLoc["showCalculations"]"
                                            @onclick:stopPropagation
                                            @onclick="async () => await SetProject(project)">
                                        @FormatCalculationCount(project)
                                    </button>
                                </td>
                            }
                            @if (IsProjectColumnVisible("byggherre"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatText(project.Developer)</td>
                            }
                            @if (IsProjectColumnVisible("organisation"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatText(project.Organisation)</td>
                            }
                            @if (IsProjectColumnVisible("procurementName"))
                            {
                                <td class="px-3 py-2 text-slate-600 dark:text-slate-300">@FormatText(project.ProcurementName)</td>
                            }
                            @if (IsProjectColumnVisible("procurementNumber"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatText(project.ProcurementNumber)</td>
                            }
                            @if (IsProjectColumnVisible("customerReference"))
                            {
                                <td class="px-3 py-2 text-slate-600 dark:text-slate-300">@FormatText(project.CustomerReference)</td>
                            }
                            @if (IsProjectColumnVisible("contract"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatText(project.Contract)</td>
                            }
                            @if (IsProjectColumnVisible("projectType"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatText(project.Type)</td>
                            }
                            @if (IsProjectColumnVisible("inspector"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatText(project.Inspector)</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @* ── Pagination bar ─────────────────────────────── *@
        <div class="sticky bottom-0 z-10 mr-1 mt-1 grid grid-cols-3 items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs shadow-sm dark:border-slate-800 dark:bg-slate-950">
            @* Left: page size *@
            <div class="flex items-center gap-1.5">
                <select class="h-6 rounded border border-slate-300 bg-white px-1 text-[11px] text-slate-700 focus:outline-none focus:ring-1 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200"
                        value="@_pageSize"
                        @onchange="HandlePageSizeChanged">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                    <option value="0">@AppLoc["allItems"]</option>
                </select>
                <span class="text-[11px] text-slate-500 dark:text-slate-400">/ sida</span>
            </div>

            @* Center: range info *@
            <div class="text-center text-[11px] text-slate-500 dark:text-slate-400">
                @if (_pageSize == 0 || TotalProjectCount == 0)
                {
                    @AppLoc["showingAllFormat", TotalProjectCount]
                }
                else
                {
                    @AppLoc["showingRangeFormat", FirstProjectIndex, LastProjectIndex, TotalProjectCount]
                }
            </div>

            @* Right: navigation *@
            <div class="flex items-center justify-end gap-1">
                <button type="button" disabled="@(_currentPage <= 1)" class="@ProjPaginationBtnCls" @onclick="() => _currentPage = 1" title="Första">
                    <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 19l-7-7 7-7M18 19l-7-7 7-7" /></svg>
                </button>
                <button type="button" disabled="@(_currentPage <= 1)" class="@ProjPaginationBtnCls" @onclick="() => _currentPage--" title="Föregående">
                    <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
                </button>
                <span class="min-w-[2.5rem] text-center text-[11px] text-slate-500 dark:text-slate-400">
                    @if (TotalProjectPages > 1) { @($"{_currentPage}/{TotalProjectPages}") }
                </span>
                <button type="button" disabled="@(_currentPage >= TotalProjectPages)" class="@ProjPaginationBtnCls" @onclick="() => _currentPage++" title="Nästa">
                    <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                </button>
                <button type="button" disabled="@(_currentPage >= TotalProjectPages)" class="@ProjPaginationBtnCls" @onclick="() => _currentPage = TotalProjectPages" title="Sista">
                    <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M6 5l7 7-7 7" /></svg>
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-6 py-12 text-center dark:border-slate-700 dark:bg-slate-950/60">
            <div class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">@CalcResource.project</div>
            <h3 class="mt-2 text-lg font-semibold text-slate-900 dark:text-slate-100">@AppLoc["projectsEmptyState"]</h3>
            <p class="mt-2 text-sm leading-6 text-slate-500 dark:text-slate-400">
                @AppLoc["projectsEmptyStateHint"]
            </p>
            @if (!Folder.State.OtherDepartment && Folder.State.FolderSelected is not null)
            {
                <AuthorizeView Roles="@PMRolesConst.Tenant.AdminManger">
                    <button type="button"
                            class="mt-4 inline-flex items-center gap-1.5 rounded-lg border border-emerald-300 bg-emerald-50 px-4 py-2 text-sm font-semibold text-emerald-700 transition hover:bg-emerald-100 dark:border-emerald-900/60 dark:bg-emerald-950/30 dark:text-emerald-300 dark:hover:bg-emerald-950/50"
                            @onclick="() => UpdateForm(new ListProjectMVVM())">
                        <span aria-hidden="true">@((MarkupString)Icons.Plus)</span>
                        <span>@AppLoc["newProject"]</span>
                    </button>
                </AuthorizeView>
            }
        </div>
    }
</div>

@code {

    [Parameter] public EventCallback OnToggleArchived { get; set; }

    Guid UpdateProject = Guid.Empty;
    private ListProjectMVVM? draggingProject;

    private string _sortColumn = "";
    private bool _sortAscending = true;

    private int _pageSize = 25;
    private int _currentPage = 1;
    private const string ToolbarButtonClass = "inline-flex h-9 items-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3 text-sm font-medium text-slate-700 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800";
    private const string ProjPaginationBtnCls = "inline-flex h-6 w-6 items-center justify-center rounded border border-slate-200 text-slate-600 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-35 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800";

    private readonly Dictionary<string, ColumnFilterState> _projColFilters = new()
    {
        ["code"]          = new() { Type = ColumnFilterType.Text },
        ["name"]          = new() { Type = ColumnFilterType.Text },
        ["status"]        = new() { Type = ColumnFilterType.Text },
        ["responsible"]   = new() { Type = ColumnFilterType.Text },
        ["inspector"]     = new() { Type = ColumnFilterType.Text },
        ["deadline"]      = new() { Type = ColumnFilterType.Date },
        ["qa"]            = new() { Type = ColumnFilterType.Date },
        ["start"]         = new() { Type = ColumnFilterType.Date },
        ["end"]           = new() { Type = ColumnFilterType.Date },
        ["byggherre"]     = new() { Type = ColumnFilterType.Text },
        ["organisation"]  = new() { Type = ColumnFilterType.Text },
    };

    private bool HasActiveProjectFilters => _projColFilters.Values.Any(f => f.IsActive);

    private void ClearProjectFilters()
    {
        foreach (var f in _projColFilters.Values) f.Clear();
        _currentPage = 1;
    }

    private void OnProjectColumnFilterChanged() => _currentPage = 1;
    private ColumnFilterState PF(string key) => _projColFilters[key];

    private IEnumerable<ListProjectMVVM> FilteredProjects
    {
        get
        {
            var projects = Folder.State.FolderSelected?.Projects ?? (IEnumerable<ListProjectMVVM>)[];
            if (_projColFilters["code"].IsActive)
                projects = projects.Where(p => _projColFilters["code"].MatchesText(p.Code));
            if (_projColFilters["name"].IsActive)
                projects = projects.Where(p => _projColFilters["name"].MatchesText(p.Name));
            if (_projColFilters["status"].IsActive)
                projects = projects.Where(p => _projColFilters["status"].MatchesText(p.Status));
            if (_projColFilters["responsible"].IsActive)
                projects = projects.Where(p => _projColFilters["responsible"].MatchesText(p.Responsible));
            if (_projColFilters["inspector"].IsActive)
                projects = projects.Where(p => _projColFilters["inspector"].MatchesText(p.Inspector));
            if (_projColFilters["deadline"].IsActive)
                projects = projects.Where(p => _projColFilters["deadline"].MatchesDate(p.TenderDeadline == default ? null : p.TenderDeadline));
            if (_projColFilters["qa"].IsActive)
                projects = projects.Where(p => _projColFilters["qa"].MatchesDate(p.TenderQA == default ? null : p.TenderQA));
            if (_projColFilters["start"].IsActive)
                projects = projects.Where(p => _projColFilters["start"].MatchesDate(p.StartDate == default ? null : p.StartDate));
            if (_projColFilters["end"].IsActive)
                projects = projects.Where(p => _projColFilters["end"].MatchesDate(p.EndDate == default ? null : p.EndDate));
            if (_projColFilters["byggherre"].IsActive)
                projects = projects.Where(p => _projColFilters["byggherre"].MatchesText(p.Developer));
            if (_projColFilters["organisation"].IsActive)
                projects = projects.Where(p => _projColFilters["organisation"].MatchesText(p.Organisation));
            return projects;
        }
    }

    private IEnumerable<ListProjectMVVM> SortedProjects
    {
        get
        {
            var projects = FilteredProjects;
            return _sortColumn switch
            {
                "code" => _sortAscending
                    ? projects.OrderBy(x => x.Code)
                    : projects.OrderByDescending(x => x.Code),
                "name" => _sortAscending
                    ? projects.OrderBy(x => x.Name)
                    : projects.OrderByDescending(x => x.Name),
                "status" => _sortAscending
                    ? projects.OrderBy(x => x.Status)
                    : projects.OrderByDescending(x => x.Status),
                "responsible" => _sortAscending
                    ? projects.OrderBy(x => x.Responsible)
                    : projects.OrderByDescending(x => x.Responsible),
                "start" => _sortAscending
                    ? projects.OrderBy(x => x.StartDate)
                    : projects.OrderByDescending(x => x.StartDate),
                "end" => _sortAscending
                    ? projects.OrderBy(x => x.EndDate)
                    : projects.OrderByDescending(x => x.EndDate),
                "deadline" => _sortAscending
                    ? projects.OrderBy(x => x.TenderDeadline)
                    : projects.OrderByDescending(x => x.TenderDeadline),
                "qa" => _sortAscending
                    ? projects.OrderBy(x => x.TenderQA)
                    : projects.OrderByDescending(x => x.TenderQA),
                "calculations" => _sortAscending
                    ? projects.OrderBy(GetCalculationCount)
                    : projects.OrderByDescending(GetCalculationCount),
                "byggherre" => _sortAscending
                    ? projects.OrderBy(x => x.Developer)
                    : projects.OrderByDescending(x => x.Developer),
                "organisation" => _sortAscending
                    ? projects.OrderBy(x => x.Organisation)
                    : projects.OrderByDescending(x => x.Organisation),
                "procurementName" => _sortAscending
                    ? projects.OrderBy(x => x.ProcurementName)
                    : projects.OrderByDescending(x => x.ProcurementName),
                "procurementNumber" => _sortAscending
                    ? projects.OrderBy(x => x.ProcurementNumber)
                    : projects.OrderByDescending(x => x.ProcurementNumber),
                "customerReference" => _sortAscending
                    ? projects.OrderBy(x => x.CustomerReference)
                    : projects.OrderByDescending(x => x.CustomerReference),
                "contract" => _sortAscending
                    ? projects.OrderBy(x => x.Contract)
                    : projects.OrderByDescending(x => x.Contract),
                "projectType" => _sortAscending
                    ? projects.OrderBy(x => x.Type)
                    : projects.OrderByDescending(x => x.Type),
                "inspector" => _sortAscending
                    ? projects.OrderBy(x => x.Inspector)
                    : projects.OrderByDescending(x => x.Inspector),
                _ => projects
                    .OrderByDescending(x => x.Order)
                    .ThenBy(x => x.Name, StringComparer.CurrentCultureIgnoreCase)
            };
        }
    }

    private IEnumerable<ListProjectMVVM> PagedProjects
    {
        get
        {
            var sorted = SortedProjects;
            if (_pageSize == 0) return sorted;
            var total = sorted.Count();
            var maxPage = (int)Math.Ceiling((double)total / _pageSize);
            if (maxPage < 1) maxPage = 1;
            if (_currentPage > maxPage) _currentPage = maxPage;
            return sorted.Skip((_currentPage - 1) * _pageSize).Take(_pageSize);
        }
    }

    private void SortBy(string column)
    {
        if (_sortColumn == column)
            _sortAscending = !_sortAscending;
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }
        _currentPage = 1;
    }

