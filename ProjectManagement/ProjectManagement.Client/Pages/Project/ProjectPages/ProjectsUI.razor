    private void NextPage() { if (_currentPage < TotalProjectPages) _currentPage++; }

    private readonly Dictionary<string, ColumnFilterState> _projColFilters = new()
    {
        ["code"]                 = new() { Type = ColumnFilterType.Text },
        ["name"]                 = new() { Type = ColumnFilterType.Text },
        ["department"]           = new() { Type = ColumnFilterType.Dropdown },
        ["folder"]               = new() { Type = ColumnFilterType.Dropdown },
