    private async Task SwitchToCalculationModeAsync()
    {
        _contentMode = ContentModeCalculations;
        _viewMenuOpen = false;
        if (_folderCalculations == null && !_loadingFolderCalcs)
            await LoadFolderCalculationsAsync();
    }

    private async Task LoadFolderCalculationsAsync()
    {
        _loadingFolderCalcs = true;
        StateHasChanged();

        var result = new List<(ListProjectMVVM, ListCalculationMVVM)>();
        var projects = IsDepartmentScope
            ? Folder.State.FoldersList.SelectMany(f => f.Projects ?? []).ToList()
            : (IList<ListProjectMVVM>)(Folder.State.FolderSelected?.Projects ?? []);

        foreach (var project in projects)
        {
            if (!project.CalculationsLoaded)
                await Folder.SetCalcsToProject(project);

            var calcs = _showAllVersions
                ? (IEnumerable<ListCalculationMVVM>)(project.Calculations ?? [])
                : CalculationVersionSelector.SelectCurrentVersions(project.Calculations ?? []);

            foreach (var calc in calcs)
                result.Add((project, calc));
        }

        _folderCalculations = result;
        _loadingFolderCalcs = false;
    }

    private async Task OpenCalculationFromFolderViewAsync(ListProjectMVVM project, ListCalculationMVVM calc)
    {
        var folder = IsDepartmentScope
            ? Folder.State.FoldersList.FirstOrDefault(f => f.Projects?.Any(p => p.Id == project.Id) == true)
            : Folder.State.FolderSelected;
        if (folder is null) return;
        Folder.State.SetCalculation(null, project, folder);
        await CalcService.SetCalc(calc.Id, project, folder);
    }

