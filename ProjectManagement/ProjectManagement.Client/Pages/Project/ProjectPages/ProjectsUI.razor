@using ProjectManagement.Client.Constant
@using ProjectManagement.Client.Helper
@using Microsoft.Extensions.Logging
@using ProjectManagement.Client.Services.Folder
@using ProjectManagement.Client.Shared.MVVM.Folder
@using ProjectManagement.Client.Shared.Model.Project
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@using ProjectManagement.Shared.DTO.Project
@using System.Net.Http
@using BlazorMHD.UI.Core.Data
@using BlazorMHD.UI.Core.DesignSystem
@using BlazorMHD.UI.Components.Data.ColumnPicker
@inherits AppComponentBase
@implements IDisposable
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="ml-1">

    @* ── Header toolbar ─────────────────────────────────── *@
    <div class="flex w-full flex-wrap items-center justify-between gap-2 p-1">
        <div class="min-w-0">
            <div class="truncate text-sm font-semibold text-gray-700 dark:text-gray-300">
                @AppLoc["projectsInFolderFormat", Folder.State.FolderSelected?.Name ?? "-"]
            </div>
            <div class="text-xs text-slate-500 dark:text-slate-400">
                @SortedProjects.Count() @CalcResource.project
            </div>
        </div>

        @if (!Folder.State.OtherDepartment)
        {
            <div class="flex flex-wrap items-center gap-2">

                @* Archive filter toggle *@
                <button type="button"
                        class="inline-flex h-9 items-center gap-1.5 rounded-lg border px-3 text-sm font-semibold transition @(UoWService.Folder.ShowArchived ? "border-amber-300 bg-amber-50 text-amber-700 hover:bg-amber-100 dark:border-amber-800/60 dark:bg-amber-950/30 dark:text-amber-300 dark:hover:bg-amber-950/50" : "border-slate-200 bg-slate-50 text-slate-600 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800")"
                        title="@AppLoc["showArchived"]"
                        @onclick="async () => await OnToggleArchived.InvokeAsync()">
                    <span>@AppLoc["showArchived"]</span>
                </button>

                <MhdColumnPicker Text="@AppLoc["columns"]"
                                 Columns="@ProjectColumnOptions"
                                 ColumnVisibility="_projectColumns"
                                 OnChanged="StateHasChanged" />

                <button type="button"
                        class="inline-flex h-9 items-center gap-1.5 rounded-lg border border-sky-300 bg-sky-50 px-3 text-sm font-semibold text-sky-700 transition hover:bg-sky-100 disabled:cursor-not-allowed disabled:opacity-50 dark:border-sky-900/60 dark:bg-sky-950/30 dark:text-sky-300 dark:hover:bg-sky-950/50"
                        disabled="@(Folder.State.FolderSelected is null)"
                        title="@AppLoc["incomeOverview"]"
                        @onclick="OpenIncomeOverview">
                    <span>@AppLoc["incomeOverview"]</span>
                </button>

                <AuthorizeView Roles="@PMRolesConst.Tenant.AdminManger">
                    <button type="button"
                            class="inline-flex h-9 items-center gap-1.5 rounded-lg border border-emerald-300 bg-emerald-50 px-3 text-sm font-semibold text-emerald-700 transition hover:bg-emerald-100 disabled:cursor-not-allowed disabled:opacity-50 dark:border-emerald-900/60 dark:bg-emerald-950/30 dark:text-emerald-300 dark:hover:bg-emerald-950/50"
                            disabled="@(Folder.State.OtherDepartment || Folder.State.FolderSelected is null)"
                            title="@AppLoc["newProject"]"
                            @onclick="() => UpdateForm(new ListProjectMVVM())">
                        <span aria-hidden="true">@((MarkupString)Icons.Plus)</span>
                        <span>@AppLoc["newProject"]</span>
                    </button>
                </AuthorizeView>
            </div>
        }
    </div>

    @* ── Project table ───────────────────────────────────── *@
    @if (SortedProjects.Any())
    {
        <div class="mr-1 overflow-x-auto rounded-lg border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-950">
            <table class="min-w-full table-auto text-left text-xs">
                <thead class="bg-slate-50 text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:bg-slate-900 dark:text-slate-400">
                    <tr>
                        @if (IsProjectColumnVisible("code"))
                        {
                            <th class="@SortableHeaderClass("code")" @onclick='() => SortBy("code")'>
                                <span class="inline-flex items-center gap-1">
                                    @CalcResource.code
                                    @((MarkupString)SortIndicatorHtml("code"))
                                </span>
                            </th>
                        }
                        @if (IsProjectColumnVisible("name"))
                        {
                            <th class="@SortableHeaderClass("name") min-w-52" @onclick='() => SortBy("name")'>
                                <span class="inline-flex items-center gap-1">
                                    @AppLoc["projectName"]
                                    @((MarkupString)SortIndicatorHtml("name"))
                                </span>
                            </th>
                        }
                        @if (IsProjectColumnVisible("status"))
                        {
                            <th class="@SortableHeaderClass("status")" @onclick='() => SortBy("status")'>
                                <span class="inline-flex items-center gap-1">
                                    @CalcResource.status
                                    @((MarkupString)SortIndicatorHtml("status"))
                                </span>
                            </th>
                        }
                        @if (IsProjectColumnVisible("responsible"))
                        {
                            <th class="@SortableHeaderClass("responsible")" @onclick='() => SortBy("responsible")'>
                                <span class="inline-flex items-center gap-1">
                                    @CalcResource.responsible
                                    @((MarkupString)SortIndicatorHtml("responsible"))
                                </span>
                            </th>
                        }
                        @if (IsProjectColumnVisible("start"))
                        {
                            <th class="@SortableHeaderClass("start")" @onclick='() => SortBy("start")'>
                                <span class="inline-flex items-center gap-1">
                                    @CalcResource.startDate
                                    @((MarkupString)SortIndicatorHtml("start"))
                                </span>
                            </th>
                        }
                        @if (IsProjectColumnVisible("end"))
                        {
                            <th class="@SortableHeaderClass("end")" @onclick='() => SortBy("end")'>
                                <span class="inline-flex items-center gap-1">
                                    @CalcResource.endDate
                                    @((MarkupString)SortIndicatorHtml("end"))
                                </span>
                            </th>
                        }
                        @if (IsProjectColumnVisible("deadline"))
                        {
                            <th class="@SortableHeaderClass("deadline")" @onclick='() => SortBy("deadline")'>
                                <span class="inline-flex items-center gap-1">
                                    @CalcResource.tenderDeadline
                                    @((MarkupString)SortIndicatorHtml("deadline"))
                                </span>
                            </th>
                        }
                        @if (IsProjectColumnVisible("qa"))
                        {
                            <th class="@SortableHeaderClass("qa")" @onclick='() => SortBy("qa")'>
                                <span class="inline-flex items-center gap-1">
                                    @CalcResource.tenderQA
                                    @((MarkupString)SortIndicatorHtml("qa"))
                                </span>
                            </th>
                        }
                        @if (IsProjectColumnVisible("calculations"))
                        {
                            <th class="@SortableHeaderClass("calculations") text-right" @onclick='() => SortBy("calculations")'>
                                <span class="inline-flex items-center justify-end gap-1">
                                    @AppLoc["calculationCount"]
                                    @((MarkupString)SortIndicatorHtml("calculations"))
                                </span>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                    @foreach (var project in SortedProjects)
                    {
                        var isProjectArchived = !project.IsVisible;
                        var isProjectSelected = Folder.State.ProjectSelected?.Id == project.Id;
                        var rowClasses = GetProjectRowClass(project, isProjectSelected, isProjectArchived);

                        <tr @key="project.Id"
                            class="@rowClasses"
                            @oncontextmenu:preventDefault
                            @oncontextmenu="() => Context(project)"
                            @onclick="async () => await SetProject(project)"
                            @ondrop="async _ => await HandleDrop(project)"
                            @ondragleave="() => project.IsDragOver = false"
                            @ondragover:preventDefault="true"
                            @ondragover="() => project.IsDragOver = draggingProject is not null"
                            @ondragstart="() => draggingProject = project"
                            @ondragend="() => draggingProject = null"
                            draggable="true">
                            @if (IsProjectColumnVisible("code"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 font-mono text-[11px] text-slate-500 dark:text-slate-400">
                                    <span class="inline-flex items-center gap-1.5">
                                        <span class="h-2.5 w-2.5 rounded-full border border-slate-300 dark:border-slate-700"
                                              style="background-color:@project.Color"></span>
                                        @(string.IsNullOrWhiteSpace(project.Code) ? "-" : project.Code)
                                    </span>
                                </td>
                            }
                            @if (IsProjectColumnVisible("name"))
                            {
                                <td class="max-w-80 px-3 py-2">
                                    <span class="block truncate font-semibold text-slate-800 dark:text-slate-100" title="@project.Name">@project.Name</span>
                                </td>
                            }
                            @if (IsProjectColumnVisible("status"))
                            {
                                <td class="whitespace-nowrap px-3 py-2">
                                    <span class="@GetProjectStatusClass(project)">
                                        @GetProjectStatusText(project)
                                    </span>
                                </td>
                            }
                            @if (IsProjectColumnVisible("responsible"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatText(project.Responsible)</td>
                            }
                            @if (IsProjectColumnVisible("start"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatDate(project.StartDate)</td>
                            }
                            @if (IsProjectColumnVisible("end"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatDate(project.EndDate)</td>
                            }
                            @if (IsProjectColumnVisible("deadline"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatDate(project.TenderDeadline)</td>
                            }
                            @if (IsProjectColumnVisible("qa"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-slate-600 dark:text-slate-300">@FormatDate(project.TenderQA)</td>
                            }
                            @if (IsProjectColumnVisible("calculations"))
                            {
                                <td class="whitespace-nowrap px-3 py-2 text-right">
                                    <button type="button"
                                            class="inline-flex min-w-[2rem] items-center justify-center rounded-md px-1.5 py-0.5 text-xs font-semibold text-slate-600 transition hover:bg-sky-100 hover:text-sky-700 dark:text-slate-300 dark:hover:bg-sky-900/40 dark:hover:text-sky-300"
                                            title="@AppLoc["showCalculations"]"
                                            @onclick:stopPropagation
                                            @onclick="async () => await SetProject(project)">
                                        @FormatCalculationCount(project)
                                    </button>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-6 py-12 text-center dark:border-slate-700 dark:bg-slate-950/60">
            <div class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">@CalcResource.project</div>
            <h3 class="mt-2 text-lg font-semibold text-slate-900 dark:text-slate-100">@AppLoc["projectsEmptyState"]</h3>
            <p class="mt-2 text-sm leading-6 text-slate-500 dark:text-slate-400">
                @AppLoc["projectsEmptyStateHint"]
            </p>
            @if (!Folder.State.OtherDepartment && Folder.State.FolderSelected is not null)
            {
                <AuthorizeView Roles="@PMRolesConst.Tenant.AdminManger">
                    <button type="button"
                            class="mt-4 inline-flex items-center gap-1.5 rounded-lg border border-emerald-300 bg-emerald-50 px-4 py-2 text-sm font-semibold text-emerald-700 transition hover:bg-emerald-100 dark:border-emerald-900/60 dark:bg-emerald-950/30 dark:text-emerald-300 dark:hover:bg-emerald-950/50"
                            @onclick="() => UpdateForm(new ListProjectMVVM())">
                        <span aria-hidden="true">@((MarkupString)Icons.Plus)</span>
                        <span>@AppLoc["newProject"]</span>
                    </button>
                </AuthorizeView>
            }
        </div>
    }
</div>

@code {

    [Parameter] public EventCallback OnToggleArchived { get; set; }

    Guid UpdateProject = Guid.Empty;
    private ListProjectMVVM? draggingProject;

    private string _sortColumn = "";
    private bool _sortAscending = true;

    private IEnumerable<ListProjectMVVM> SortedProjects
    {
        get
        {
            var projects = Folder.State.FolderSelected?.Projects ?? [];
            return _sortColumn switch
            {
                "code" => _sortAscending
                    ? projects.OrderBy(x => x.Code)
                    : projects.OrderByDescending(x => x.Code),
                "name" => _sortAscending
                    ? projects.OrderBy(x => x.Name)
                    : projects.OrderByDescending(x => x.Name),
                "status" => _sortAscending
                    ? projects.OrderBy(x => x.Status)
                    : projects.OrderByDescending(x => x.Status),
                "responsible" => _sortAscending
                    ? projects.OrderBy(x => x.Responsible)
                    : projects.OrderByDescending(x => x.Responsible),
                "start" => _sortAscending
                    ? projects.OrderBy(x => x.StartDate)
                    : projects.OrderByDescending(x => x.StartDate),
                "end" => _sortAscending
                    ? projects.OrderBy(x => x.EndDate)
                    : projects.OrderByDescending(x => x.EndDate),
                "deadline" => _sortAscending
                    ? projects.OrderBy(x => x.TenderDeadline)
                    : projects.OrderByDescending(x => x.TenderDeadline),
                "qa" => _sortAscending
                    ? projects.OrderBy(x => x.TenderQA)
                    : projects.OrderByDescending(x => x.TenderQA),
                "calculations" => _sortAscending
                    ? projects.OrderBy(x => x.Calculations?.Count ?? 0)
                    : projects.OrderByDescending(x => x.Calculations?.Count ?? 0),
                _ => projects
            };
        }
    }

    private void SortBy(string column)
    {
        if (_sortColumn == column)
            _sortAscending = !_sortAscending;
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }
    }

    private string SortableHeaderClass(string column)
    {
        var active = _sortColumn == column;
        return "cursor-pointer select-none whitespace-nowrap px-3 py-2 transition " +
               (active
                   ? "text-slate-800 dark:text-slate-200"
                   : "hover:text-slate-700 dark:hover:text-slate-200");
    }

    private string SortIndicatorHtml(string column)
    {
        if (_sortColumn != column)
            return "<svg class=\"h-3 w-3 opacity-30\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M7 16V4m0 0L3 8m4-4l4 4M17 8v12m0 0l4-4m-4 4l-4-4\"/></svg>";

        return _sortAscending
            ? "<svg class=\"h-3 w-3\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 15l7-7 7 7\"/></svg>"
            : "<svg class=\"h-3 w-3\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 9l-7 7-7-7\"/></svg>";
    }

    private readonly Dictionary<string, bool> _projectColumns = new()
    {
        ["code"] = true,
        ["name"] = true,
        ["status"] = false,
        ["responsible"] = false,
        ["start"] = true,
        ["end"] = true,
        ["deadline"] = true,
        ["qa"] = false,
        ["calculations"] = true
    };

    private List<MhdColumnPickerItem> ProjectColumnOptions => new()
    {
        new("code", CalcResource.code),
        new("name", AppLoc["projectName"].Value),
        new("status", CalcResource.status),
        new("responsible", CalcResource.responsible),
        new("start", CalcResource.startDate),
        new("end", CalcResource.endDate),
        new("deadline", CalcResource.tenderDeadline),
        new("qa", CalcResource.tenderQA),
        new("calculations", AppLoc["calculationCount"].Value)
    };

    protected override void OnInitialized()
    {
        CalcService.PageChanged += ToastChanged;
    }

    public void Dispose()
    {
        CalcService.PageChanged -= ToastChanged;
    }

    private void ToastChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    private bool IsProjectColumnVisible(string key) =>
        _projectColumns.TryGetValue(key, out var visible) && visible;

    private static string FormatText(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string FormatDate(DateTime value) =>
        value == default ? "-" : value.ToString(ConstValues.DateFormat);

    private static string FormatCalculationCount(ListProjectMVVM project) =>
        project.CalculationsLoaded ? (project.Calculations?.Count ?? 0).ToString() : "-";

    private string GetProjectStatusText(ListProjectMVVM project)
    {
        if (!project.IsVisible)
            return AppLoc["archived"].Value;

        return string.IsNullOrWhiteSpace(project.Status) ? AppLoc["active"].Value : project.Status;
    }

    private static string GetProjectStatusClass(ListProjectMVVM project) =>
        !project.IsVisible
            ? "inline-flex rounded-full bg-slate-200 px-2 py-0.5 text-[11px] font-semibold text-slate-600 dark:bg-slate-800 dark:text-slate-300"
            : "inline-flex rounded-full bg-emerald-100 px-2 py-0.5 text-[11px] font-semibold text-emerald-700 dark:bg-emerald-950/50 dark:text-emerald-300";

    private static string GetProjectRowClass(ListProjectMVVM project, bool selected, bool archived)
    {
        var classes = new List<string>
        {
            "cursor-pointer transition-colors",
            "hover:bg-slate-50 dark:hover:bg-slate-900/80"
        };

        if (selected)
            classes.Add("bg-sky-50 dark:bg-sky-950/30");

        if (project.IsDragOver)
            classes.Add("ring-2 ring-blue-400");

        if (archived)
            classes.Add("text-slate-500 opacity-75 grayscale dark:text-slate-400");

        return string.Join(" ", classes);
    }

    async Task Context(ListProjectMVVM item)
    {
        if (Folder.State.OtherDepartment) return;
        var list = new List<MenuItem>();

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        bool isInAnyRole = PMRolesConst.Tenant.AdminManger.Split(',').Any(r => user.IsInRole(r));

        if (user.Identity?.IsAuthenticated == true && isInAnyRole)
        {
            list.Add(new() { IconHtml = Icons.Edit, Label = ResourceApp.edit, OnClickAsync = () => { UpdateForm(item); return Task.CompletedTask; } });
            list.Add(new() { IconHtml = Icons.Folder, Label = AppLoc["moveProject"], OnClickAsync = () => { OpenMoveCopyDialog(item, MoveCopyOperation.Move); return Task.CompletedTask; } });
            list.Add(new() { IconHtml = Icons.Copy, Label = AppLoc["copyProject"], OnClickAsync = () => { OpenMoveCopyDialog(item, MoveCopyOperation.Copy); return Task.CompletedTask; } });

            if (item.IsVisible)
                list.Add(new() { IconHtml = Icons.Archive, Label = AppLoc["archiveProject"], OnClickAsync = async () => await ArchiveOrRestoreProjectAsync(item, archive: true) });
            else
                list.Add(new() { IconHtml = Icons.Restore, Label = AppLoc["restoreFromArchive"], OnClickAsync = async () => await ArchiveOrRestoreProjectAsync(item, archive: false) });

            list.Add(new() { IsSeparator = true });
            list.Add(new() { IconHtml = Icons.Delete, Label = ResourceApp.delete, CssClass = "text-red-600 dark:text-red-400", OnClickAsync = () => { Remove(item); return Task.CompletedTask; } });
        }

        await ContextService.ShowMenuAsync(list);
    }

    async Task ArchiveOrRestoreProjectAsync(ListProjectMVVM project, bool archive)
    {
        var dto = await Repo.Project.GetToPostAsync(project.Id);
        if (dto is null) return;
        dto.IsVisible = !archive;
        bool ok = await Repo.Project.UpdateAsync(project.Id, dto);
        if (ok)
        {
            project.IsVisible = !archive;
            bool shouldKeepInList = UoWService.Folder.ShowArchived || !archive;
            if (!shouldKeepInList)
                Folder.State.FolderSelected?.Projects?.Remove(project);
            UoWService.Folder.State.Notify();
            StateHasChanged();
        }
        MHD.Notifications(ToastType.Update, ok);
    }

    void ProjectDetailsDialog(ListProjectMVVM model) =>
        Modal.ShowComponent<ProjectDetailsUI>(
            model.Name,
            new Dictionary<string, object>
            {
                [nameof(ProjectDetailsUI.ProjectId)] = model.Id,
            }, BlazorMHD.UI.Core.Services.DialogSize.ExtraLarge);

    void OpenMoveCopyDialog(ListProjectMVVM project, string operation) =>
        Modal.ShowComponent<MoveCopyDialog>(
            operation == MoveCopyOperation.Copy ? AppLoc["copyProject"] : AppLoc["moveProject"],
            new Dictionary<string, object>
            {
                [nameof(MoveCopyDialog.ItemKind)] = MoveCopyItemKind.Project,
                [nameof(MoveCopyDialog.Operation)] = operation,
                [nameof(MoveCopyDialog.SourceFolder)] = Folder.State.FolderSelected!,
                [nameof(MoveCopyDialog.SourceProject)] = project,
                [nameof(MoveCopyDialog.OnCompleted)] = EventCallback.Factory.Create(this, ReloadAfterMoveCopyAsync)
            },
            BlazorMHD.UI.Core.Services.DialogSize.ExtraLarge);

    async Task ReloadAfterMoveCopyAsync()
    {
        await GetAsync(refresh: true);
        UoWService.Folder.State.Notify();
    }

    void OpenIncomeOverview()
    {
        if (Folder.State.FolderSelected is null)
            return;

        Modal.ShowComponent<IncomeOverviewDialog>(
            AppLoc["incomeOverview"],
            new Dictionary<string, object>
            {
                [nameof(IncomeOverviewDialog.FolderScope)] = Folder.State.FolderSelected
            },
            BlazorMHD.UI.Core.Services.DialogSize.ExtraLarge);
    }

    void UpdateForm(ListProjectMVVM model)
    {
        UpdateProject = model.Id;
        Modal.ShowComponent<ProjectForm>(
            model.Id == Guid.Empty ? AppLoc[LocalizerConst.New, CalcResource.project] : AppLoc[LocalizerConst.Update, model.Name],
            new Dictionary<string, object>
            {
                [nameof(ProjectForm.Project)] = model,
                [nameof(ProjectForm.FolderId)] = Folder.State.FolderSelected!.Id,
                [nameof(ProjectForm.Callback)] = EventCallback.Factory.Create<Tuple<bool, ListProjectMVVM>>(this, AddProjectAsync)
            },
            BlazorMHD.UI.Core.Services.DialogSize.ExtraLarge,
            DialogButtonsHelper.CreateSaveCancelButtons(ProjectForm.DialogFormId));
    }

    async Task SetProject(ListProjectMVVM pro)
    {
        await Folder.NewProject(pro);
        Folder.State.SetCalculation(null, pro, Folder.State.FolderSelected!);
    }

    async Task GetAsync(bool refresh = true)
    {
        if (refresh && Folder.State.FolderSelected is not null)
        {
            Folder.State.FolderSelected.Projects =
                await Repo.Project.GetByFolderIdAsync(Folder.State.FolderSelected.Id, UoWService.Folder.ShowArchived);

            if (Folder.State.FolderSelected.Projects != null)
                Folder.State.FolderSelected.Projects =
                    Folder.State.FolderSelected.Projects
                        .OrderByDescending(x => x.Order)
                        .ToList();
        }

        Modal.Close();
    }

    void AddProjectAsync(Tuple<bool, ListProjectMVVM> callBack)
    {
        if (callBack == null)
        {
            Modal.Close();
            return;
        }

        var project = callBack.Item2;
        bool shouldKeepInList = UoWService.Folder.ShowArchived || callBack.Item1;

        if (UpdateProject == Guid.Empty)
        {
            if (project.Id != Guid.Empty && shouldKeepInList)
            {
                Folder.State.FolderSelected!.Projects.Insert(0, project);
            }
        }
        else
        {
            var existing = Folder.State.FolderSelected!.Projects.FirstOrDefault(x => x.Id == UpdateProject);
            if (existing != null)
            {
                if (!shouldKeepInList)
                {
                    Folder.State.FolderSelected.Projects.Remove(existing);
                }
                else
                {
                    PropertyCopier.CopyPropertiesTo(project, existing);
                    existing.Id = UpdateProject;
                }
            }
        }

        Folder.State.FolderSelected!.Projects =
            Folder.State.FolderSelected.Projects
                .OrderByDescending(x => x.Order)
                .ToList();

        UoWService.Folder.State.Notify();
        Modal.Close();
    }

    void Remove(ListProjectMVVM project) =>
        MHD.DeleteMessage(project.Name, EventCallback.Factory.Create(this, () => ConfirmRemoveAsync(project)));

    async Task ConfirmRemoveAsync(ListProjectMVVM project)
    {
        bool result = await Repo.Project.DeleteAsync(project.Id);
        if (result)
        {
            Folder.State.FolderSelected!.Projects.Remove(project);
        }
        MHD.Notifications(ToastType.Delete, result);
        UoWService.Folder.State.Notify();
    }

    private async Task HandleDrop(ListProjectMVVM project)
    {
        if (draggingProject is null || Folder.State.FolderSelected?.Projects is null)
            return;

        draggingProject.IsDragOver = false;
        project.IsDragOver = false;

        var list = Folder.State.FolderSelected.Projects;
        int index = list.IndexOf(project);

        if (index == 0)
            draggingProject.Order = project.Order + 100;
        else if (draggingProject.Order < project.Order)
            draggingProject.Order = (project.Order + list[index - 1].Order) / 2;
        else if (draggingProject.Order > project.Order && (index + 1) < list.Count)
            draggingProject.Order = (list[index + 1].Order + project.Order) / 2;
        else
            draggingProject.Order = project.Order - 100;

        Folder.State.FolderSelected.Projects =
            list.OrderByDescending(x => x.Order).ToList();

        await Repo.Project.ReOrderAsync(draggingProject.Id, draggingProject.Order);

        draggingProject = null;
        StateHasChanged();
    }
}
