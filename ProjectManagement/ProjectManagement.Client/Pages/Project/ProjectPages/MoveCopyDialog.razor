@using ProjectManagement.Client.Shared.MVVM.Calculation
@using ProjectManagement.Client.Shared.MVVM.Folder
@using ProjectManagement.Client.Shared.SharedComponent
@using ProjectManagement.Shared.DTO.Folder
@using ProjectManagement.Shared.DTO.Project

@inherits AppComponentBase

<div class="space-y-3 text-slate-800 dark:text-slate-100">

    @* ── Info box: what we act on + where it currently lives ──── *@
    <div class="rounded-lg border border-slate-200 bg-slate-50 p-3 text-sm dark:border-slate-800 dark:bg-slate-950">
        <div class="font-semibold">@GetTitle()</div>
        <div class="mt-1 text-xs text-slate-500 dark:text-slate-400">@GetCurrentLocation()</div>
        @if (IsArchived)
        {
            <div class="mt-2 inline-flex rounded-full bg-slate-200 px-2 py-0.5 text-[11px] font-semibold text-slate-600 dark:bg-slate-800 dark:text-slate-300">
                @AppLoc["archived"]
            </div>
        }
    </div>

    @* ── Error / feedback message ──────────────────────────── *@
    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-800 dark:border-amber-900/60 dark:bg-amber-950/30 dark:text-amber-200">
            @_message
        </div>
    }

    @* ── Action + place selectors ──────────────────────────── *@
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">

        @* Action (Move / Copy) *@
        <div>
            <label class="mb-1 block text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">@AppLoc["action"]</label>
            <MhdFormSelect TValue="string"
                           Value="Operation"
                           ValueChanged="OnOperationChanged"
                           Options="ActionOptions" />
        </div>

        @* Department *@
        <div>
            <label class="mb-1 block text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">@DepartmentLabel</label>
            <MhdFormSelect TValue="string"
                           Value="_targetDepartmentValue"
                           ValueChanged="OnDepartmentChanged"
                           Options="DepartmentOptions"
                           Placeholder="@AppLoc["selectDepartment"]" />
        </div>

        @* Folder (Project + Calculation) *@
        @if (ItemKind != MoveCopyItemKind.Folder)
        {
            <div>
                <label class="mb-1 block text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
                    @FolderLabel <span class="text-amber-500">*</span>
                </label>
                <MhdFormSelect TValue="string"
                               Value="_targetFolderValue"
                               ValueChanged="OnFolderChanged"
                               Options="FolderOptions"
                               Placeholder="@AppLoc["selectFolder"]"
                               Disabled="@(!_targetFolders.Any())" />
                @if (_targetFolders.Any() && string.IsNullOrEmpty(_targetFolderValue) && ItemKind == MoveCopyItemKind.Project)
                {
                    <p class="mt-1 text-[11px] text-amber-600 dark:text-amber-400">
                        @(Operation == MoveCopyOperation.Copy ? AppLoc["selectTargetFolderBeforeCopy"] : AppLoc["selectTargetFolderBeforeMove"])
                    </p>
                }
            </div>
        }

        @* Project (Calculation only) *@
        @if (ItemKind == MoveCopyItemKind.Calculation)
        {
            <div>
                <label class="mb-1 block text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
                    @ProjectLabel <span class="text-amber-500">*</span>
                </label>
                <MhdFormSelect TValue="string"
                               Value="_targetProjectValue"
                               ValueChanged="OnProjectChanged"
                               Options="ProjectOptions"
                               Placeholder="@AppLoc["selectProject"]"
                               Disabled="@(!_targetProjects.Any())" />
                @if (_targetProjects.Any() && string.IsNullOrEmpty(_targetProjectValue))
                {
                    <p class="mt-1 text-[11px] text-amber-600 dark:text-amber-400">
                        @(Operation == MoveCopyOperation.Copy ? AppLoc["selectTargetProjectBeforeCopy"] : AppLoc["selectTargetProjectBeforeMove"])
                    </p>
                }
            </div>
        }
    </div>

    @* ── Copy-only options ─────────────────────────────────── *@
    @if (Operation == MoveCopyOperation.Copy)
    {
        @if (ItemKind == MoveCopyItemKind.Folder)
        {
            <label class="flex items-center gap-2 rounded-lg border border-slate-200 bg-white p-2 text-sm dark:border-slate-800 dark:bg-slate-950">
                <input type="checkbox" class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 dark:border-slate-600 dark:bg-slate-800" @bind="_includeChildren" />
                <span>@AppLoc["copyFolderWithProjectsCalculations"]</span>
            </label>
        }
        else if (ItemKind == MoveCopyItemKind.Project)
        {
            <label class="flex items-center gap-2 rounded-lg border border-slate-200 bg-white p-2 text-sm dark:border-slate-800 dark:bg-slate-950">
                <input type="checkbox" class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 dark:border-slate-600 dark:bg-slate-800" @bind="_includeChildren" />
                <span>@AppLoc["copyProjectWithCalculations"]</span>
            </label>
        }
        else if (ItemKind == MoveCopyItemKind.Calculation)
        {
            @* Income values only make sense for a copy — never shown for Move. *@
            <label class="flex items-center gap-2 rounded-lg border border-slate-200 bg-white p-2 text-sm dark:border-slate-800 dark:bg-slate-950">
                <input type="checkbox" class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 dark:border-slate-600 dark:bg-slate-800" @bind="_copyIncome" />
                <span>@AppLoc["copyCalculationWithIncome"]</span>
            </label>
        }
    }

    @* ── Location summary ──────────────────────────────────── *@
    @* One place/value row per line: "Label: value" (or a soft "not selected" hint). *@
    @{
        RenderFragment LocationRows(string? department, string? folder, string? project, bool highlightMissing) =>
        @<text>
            <div class="text-slate-600 dark:text-slate-300">
                <span class="text-slate-400 dark:text-slate-500">@AppLoc["department"]:</span>
                @(department ?? AppLoc["notSelectedNeuter"].Value)
            </div>
            @if (ItemKind != MoveCopyItemKind.Folder)
            {
                <div class="mt-0.5 @(highlightMissing && string.IsNullOrEmpty(folder) ? "text-amber-600 dark:text-amber-400" : "text-slate-600 dark:text-slate-300")">
                    <span class="text-slate-400 dark:text-slate-500">@AppLoc["folder"]:</span>
                    @(folder ?? AppLoc["notSelectedCommon"].Value)
                </div>
            }
            @if (ItemKind == MoveCopyItemKind.Calculation)
            {
                <div class="mt-0.5 @(highlightMissing && string.IsNullOrEmpty(project) ? "text-amber-600 dark:text-amber-400" : "text-slate-600 dark:text-slate-300")">
                    <span class="text-slate-400 dark:text-slate-500">@AppLoc["project"]:</span>
                    @(project ?? AppLoc["notSelectedNeuter"].Value)
                </div>
            }
        </text>;

        var deptDisplay = Folder.State.Departments.FirstOrDefault(x => x.Id.ToString() == _targetDepartmentValue)?.Name;
        var folderDisplay = _targetFolders.FirstOrDefault(x => x.Id.ToString() == _targetFolderValue)?.Name;
        var projectDisplay = _targetProjects.FirstOrDefault(x => x.Id.ToString() == _targetProjectValue)?.Name;
    }

    @if (Operation == MoveCopyOperation.Move)
    {
        @* Move shows both where it is now and where it goes, so the change is explicit. *@
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
            <div class="rounded-lg border border-slate-200 bg-white p-3 text-xs dark:border-slate-800 dark:bg-slate-950">
                <div class="mb-1.5 font-semibold text-slate-800 dark:text-slate-100">@AppLoc["currentLocationHeading"]</div>
                @LocationRows(CurrentDepartmentName, SourceFolder?.Name, SourceProject?.Name, highlightMissing: false)
            </div>
            <div class="rounded-lg border border-sky-200 bg-sky-50/60 p-3 text-xs dark:border-sky-900/60 dark:bg-sky-950/20">
                <div class="font-semibold text-slate-800 dark:text-slate-100">@AppLoc["newLocation"]</div>
                <div class="mb-1.5 text-slate-500 dark:text-slate-400">@MoveLeadLine</div>
                @LocationRows(deptDisplay, folderDisplay, projectDisplay, highlightMissing: true)
            </div>
        </div>
    }
    else
    {
        <div class="rounded-lg border border-slate-200 bg-white p-3 text-xs dark:border-slate-800 dark:bg-slate-950">
            <div class="font-semibold text-slate-800 dark:text-slate-100">@AppLoc["selectedTarget"]</div>
            <div class="mb-1.5 text-slate-500 dark:text-slate-400">@AppLoc["copyCreatedIn"]</div>
            @LocationRows(deptDisplay, folderDisplay, projectDisplay, highlightMissing: true)
        </div>
    }

    @* ── "Already in place" guard (Move only) ──────────────── *@
    @if (IsSameAsCurrent)
    {
        <div class="rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-800 dark:border-amber-900/60 dark:bg-amber-950/30 dark:text-amber-200">
            @SamePlaceMessage
        </div>
    }

    @* ── Action buttons: Cancel (left) · primary (right) ───── *@
    <div class="flex justify-end gap-2">
        <button type="button"
                class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
                @onclick="Modal.CloseAsync">
            @ResourceApp.cancel
        </button>
        <button type="button"
                class="rounded-lg border border-emerald-300 bg-emerald-50 px-3 py-1.5 text-sm font-semibold text-emerald-700 transition hover:bg-emerald-100 disabled:cursor-not-allowed disabled:opacity-50 dark:border-emerald-900/60 dark:bg-emerald-950/30 dark:text-emerald-300"
                disabled="@IsConfirmDisabled"
                @onclick="ExecuteAsync">
            @OperationLabel
        </button>
    </div>
</div>

@code {
    [Parameter] public string ItemKind { get; set; } = MoveCopyItemKind.Project;
    [Parameter] public string Operation { get; set; } = MoveCopyOperation.Move;
    [Parameter] public FolderMVVM? SourceFolder { get; set; }
    [Parameter] public ListProjectMVVM? SourceProject { get; set; }
    [Parameter] public ListCalculationMVVM? SourceCalculation { get; set; }
    [Parameter] public EventCallback OnCompleted { get; set; }

    private string _targetDepartmentValue = string.Empty;
    private string _targetFolderValue = string.Empty;
    private string _targetProjectValue = string.Empty;
    private bool _includeChildren;
    private bool _copyIncome = true;
    private bool _isBusy;
    private string _message = string.Empty;
    private List<FolderMVVM> _targetFolders = [];
    private List<ListProjectMVVM> _targetProjects = [];

    // ── Operation-aware labels ────────────────────────────────
    private bool IsCopy => Operation == MoveCopyOperation.Copy;

    private string DepartmentLabel => IsCopy ? AppLoc["targetDepartment"] : AppLoc["moveToDepartment"];
    private string FolderLabel => IsCopy ? AppLoc["targetFolder"] : AppLoc["moveToFolder"];
    private string ProjectLabel => IsCopy ? AppLoc["targetProject"] : AppLoc["moveToProject"];

    private string MoveLeadLine => ItemKind switch
    {
        MoveCopyItemKind.Calculation => AppLoc["calculationMovedTo"],
        MoveCopyItemKind.Project => AppLoc["projectMovedTo"],
        _ => AppLoc["folderMovedTo"]
    };

    // ── Dropdown options (same model the project form uses) ───
    private IEnumerable<MhdSelectItem<string>> ActionOptions =>
    [
        new() { Value = MoveCopyOperation.Move, Label = AppLoc["move"] },
        new() { Value = MoveCopyOperation.Copy, Label = AppLoc["copyAction"] },
    ];

    private IEnumerable<MhdSelectItem<string>> DepartmentOptions =>
        Folder.State.Departments.Select(d => new MhdSelectItem<string> { Value = d.Id.ToString(), Label = d.Name });

    private IEnumerable<MhdSelectItem<string>> FolderOptions =>
        _targetFolders.Select(f => new MhdSelectItem<string> { Value = f.Id.ToString(), Label = f.Name });

    private IEnumerable<MhdSelectItem<string>> ProjectOptions =>
        _targetProjects.Select(p => new MhdSelectItem<string> { Value = p.Id.ToString(), Label = p.Name });

    private string? CurrentDepartmentName =>
        Folder.State.Departments.FirstOrDefault(d => d.Id == Folder.State.SelectedDepartmentId)?.Name;

    private bool IsArchived =>
        SourceFolder?.IsVisible == false ||
        SourceProject?.IsArchived == true;

    // A Move onto the exact same place is a no-op and must be blocked.
    private bool IsSameAsCurrent
    {
        get
        {
            if (IsCopy)
                return false;

            return ItemKind switch
            {
                MoveCopyItemKind.Calculation => SourceProject is not null && _targetProjectValue == SourceProject.Id.ToString(),
                MoveCopyItemKind.Project => SourceFolder is not null && _targetFolderValue == SourceFolder.Id.ToString(),
                MoveCopyItemKind.Folder => Folder.State.SelectedDepartmentId is { } current && _targetDepartmentValue == current.ToString(),
                _ => false
            };
        }
    }

    private string SamePlaceMessage => ItemKind switch
    {
        MoveCopyItemKind.Calculation => AppLoc["calculationAlreadyInPlace"],
        MoveCopyItemKind.Project => AppLoc["projectAlreadyInFolder"],
        _ => AppLoc["folderAlreadyInDepartment"]
    };

    private bool IsConfirmDisabled => _isBusy || !HasRequiredTargets() || IsSameAsCurrent;

    private bool HasRequiredTargets() => ItemKind switch
    {
        MoveCopyItemKind.Folder => !string.IsNullOrEmpty(_targetDepartmentValue),
        MoveCopyItemKind.Project => !string.IsNullOrEmpty(_targetDepartmentValue) && !string.IsNullOrEmpty(_targetFolderValue),
        MoveCopyItemKind.Calculation => !string.IsNullOrEmpty(_targetDepartmentValue) && !string.IsNullOrEmpty(_targetFolderValue) && !string.IsNullOrEmpty(_targetProjectValue),
        _ => false
    };

    protected override async Task OnInitializedAsync()
    {
        _targetDepartmentValue = (Folder.State.SelectedDepartmentId
            ?? Folder.State.Departments.FirstOrDefault()?.Id)?.ToString() ?? string.Empty;
        await LoadTargetFoldersAsync();

        if (SourceFolder is not null && ItemKind != MoveCopyItemKind.Folder)
            _targetFolderValue = SourceFolder.Id.ToString();

        if (SourceProject is not null && ItemKind == MoveCopyItemKind.Calculation)
            _targetProjectValue = SourceProject.Id.ToString();

        await LoadTargetProjectsAsync();
    }

    private void OnOperationChanged(string? value)
    {
        Operation = string.IsNullOrEmpty(value) ? MoveCopyOperation.Move : value;
    }

    private async Task OnDepartmentChanged(string? value)
    {
        _targetDepartmentValue = value ?? string.Empty;
        _targetFolderValue = string.Empty;
        _targetProjectValue = string.Empty;
        await LoadTargetFoldersAsync();
    }

    private async Task OnFolderChanged(string? value)
    {
        _targetFolderValue = value ?? string.Empty;
        _targetProjectValue = string.Empty;
        await LoadTargetProjectsAsync();
    }

    private void OnProjectChanged(string? value)
    {
        _targetProjectValue = value ?? string.Empty;
    }

    private async Task LoadTargetFoldersAsync()
    {
        _targetFolders = [];
        if (!int.TryParse(_targetDepartmentValue, out var departmentId) || departmentId <= 0)
            return;

        _targetFolders = await Repo.Folder.GetByDepartmentAsync(departmentId, includeArchived: true);
    }

    private async Task LoadTargetProjectsAsync()
    {
        _targetProjects = [];
        if (!Guid.TryParse(_targetFolderValue, out var folderId) || folderId == Guid.Empty)
            return;

        _targetProjects = await Repo.Project.GetByFolderIdAsync(folderId, includeArchived: true);
    }

    private async Task ExecuteAsync()
    {
        if (_isBusy || !HasRequiredTargets() || IsSameAsCurrent)
            return;

        _isBusy = true;
        _message = string.Empty;

        try
        {
            var result = ItemKind switch
            {
                MoveCopyItemKind.Folder => await ExecuteFolderAsync(),
                MoveCopyItemKind.Project => await ExecuteProjectAsync(),
                MoveCopyItemKind.Calculation => await ExecuteCalculationAsync(),
                _ => false
            };

            MHD.Notifications(IsCopy ? ToastType.Add : ToastType.Update, result);

            if (result)
            {
                await OnCompleted.InvokeAsync();
                await Modal.CloseAsync();
            }
            else if (string.IsNullOrWhiteSpace(_message))
            {
                _message = AppLoc["operationCouldNotComplete"];
            }
        }
        catch (Exception ex)
        {
            _message = AppLoc["operationFailed"];
            await ClientLog.ErrorAsync("Move/copy operation failed", ex: ex);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task<bool> ExecuteFolderAsync()
    {
        if (SourceFolder is null)
            return false;

        if (!int.TryParse(_targetDepartmentValue, out var targetDepartmentId) || targetDepartmentId <= 0)
            return false;

        if (Operation == MoveCopyOperation.Move)
        {
            return await Repo.Folder.MoveAsync(SourceFolder.Id, targetDepartmentId);
        }

        var targetName = EnsureUniqueName(SourceFolder.Name, _targetFolders.Select(x => x.Name));
        var newFolderId = await Repo.Folder.CreateAsync(new PostFolderDTO
        {
            Name = targetName,
            Color = SourceFolder.Color,
            IsVisible = SourceFolder.IsVisible,
            Order = SourceFolder.Order
        }, targetDepartmentId);

        if (newFolderId == Guid.Empty)
            return false;

        if (!_includeChildren)
            return true;

        await Folder.SetProjectsToFolder(SourceFolder);
        foreach (var project in SourceFolder.Projects)
        {
            await Repo.Project.CopyAsync(newFolderId, project.Id, includeCalculations: true);
        }

        return true;
    }

    private async Task<bool> ExecuteProjectAsync()
    {
        if (SourceProject is null || !Guid.TryParse(_targetFolderValue, out var targetFolderId) || targetFolderId == Guid.Empty)
            return false;

        if (Operation == MoveCopyOperation.Move)
        {
            return await Repo.Project.MoveAsync(SourceProject.Id, targetFolderId);
        }

        var newProjectId = await Repo.Project.CopyAsync(targetFolderId, SourceProject.Id, _includeChildren);
        return newProjectId != Guid.Empty;
    }

    private async Task<bool> ExecuteCalculationAsync()
    {
        if (SourceCalculation is null ||
            !Guid.TryParse(_targetProjectValue, out var targetProjectId) ||
            targetProjectId == Guid.Empty)
            return false;

        if (Operation == MoveCopyOperation.Move)
        {
            return await Repo.Calculation.MoveAsync(targetProjectId, SourceCalculation.Id);
        }

        var newCalculationId = await Repo.Calculation.CopyAsync(targetProjectId, SourceCalculation.Id);
        if (newCalculationId <= 0)
            return false;

        if (!_copyIncome)
        {
            var post = await Repo.Calculation.GetPostAsync(newCalculationId);
            post.Income.Clear();
            await Repo.Calculation.UpdateAsync(post, newCalculationId);
        }

        return true;
    }

    private string GetTitle() =>
        ItemKind switch
        {
            MoveCopyItemKind.Folder => $"{OperationLabel} {ResourceLoc.folder.ToLowerInvariant()}: {SourceFolder?.Name}",
            MoveCopyItemKind.Project => $"{OperationLabel} {CalcResource.project.ToLowerInvariant()}: {SourceProject?.Name}",
            MoveCopyItemKind.Calculation => $"{OperationLabel} {CalcResource.calculation.ToLowerInvariant()}: {SourceCalculation?.Name}",
            _ => OperationLabel
        };

    private string OperationLabel => IsCopy ? AppLoc["copyAction"] : AppLoc["move"];

    private string GetCurrentLocation()
    {
        if (ItemKind == MoveCopyItemKind.Folder)
            return AppLoc["currentLocationDepartment"];

        if (ItemKind == MoveCopyItemKind.Project)
            return AppLoc["currentLocationFormat", SourceFolder?.Name ?? "-"];

        return AppLoc["currentLocationPathFormat", SourceFolder?.Name ?? "-", SourceProject?.Name ?? "-"];
    }

    private static string EnsureUniqueName(string name, IEnumerable<string> existingNames)
    {
        var existing = existingNames.ToHashSet(StringComparer.CurrentCultureIgnoreCase);
        if (!existing.Contains(name))
            return name;

        var baseName = $"{name} - kopia";
        if (!existing.Contains(baseName))
            return baseName;

        var index = 2;
        while (existing.Contains($"{baseName} {index}"))
            index++;

        return $"{baseName} {index}";
    }

    private static string EnsureUniqueCode(string code, IEnumerable<string> existingCodes)
    {
        if (string.IsNullOrWhiteSpace(code))
            return string.Empty;

        return EnsureUniqueName(code, existingCodes);
    }
}
