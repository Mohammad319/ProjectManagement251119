@inherits AppComponentBase

<div class="relative">
    <button type="button"
            class="inline-flex h-8 items-center gap-1 rounded-lg px-2.5 text-xs font-semibold text-slate-700 transition hover:bg-slate-100 dark:text-slate-100 dark:hover:bg-slate-700"
            aria-expanded="@_isOpen"
            @onclick="() => _isOpen = !_isOpen">
        @AppLoc["reports"]
        <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
    </button>

    @if (_isOpen)
    {
        <div class="absolute right-0 z-50 mt-1 w-56 overflow-hidden rounded-lg border border-slate-200 bg-white p-1 text-left shadow-xl dark:border-slate-700 dark:bg-slate-900">
            @foreach (var item in MenuItems)
            {
                <button type="button"
                        class="block w-full rounded-md px-2.5 py-2 text-left text-xs font-semibold text-slate-700 transition hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800"
                        @onclick="() => OpenReport(item.View)">
                    @item.Label
                </button>
            }
        </div>
    }
</div>

@code {
    private bool _isOpen;

    private IReadOnlyList<(string View, string Label)> MenuItems =>
    [
        (CentralReportsDialog.ReportView.Income, AppLoc["incomeOverview"].Value),
        (CentralReportsDialog.ReportView.HitRate, AppLoc["hitRate"].Value),
        (CentralReportsDialog.ReportView.Calculations, AppLoc["calculationListReport"].Value),
        (CentralReportsDialog.ReportView.Projects, AppLoc["projectListReport"].Value),
        (CentralReportsDialog.ReportView.Export, AppLoc["exportPrint"].Value)
    ];

    private void OpenReport(string view)
    {
        _isOpen = false;
        var parameters = new Dictionary<string, object>
        {
            [nameof(CentralReportsDialog.InitialView)] = view
        };

        if (Folder.State.FolderSelected is not null)
            parameters[nameof(CentralReportsDialog.FolderScope)] = Folder.State.FolderSelected;

        if (Folder.State.ProjectSelected is not null)
            parameters[nameof(CentralReportsDialog.ProjectScope)] = Folder.State.ProjectSelected;

        Modal.ShowComponent<CentralReportsDialog>(
            AppLoc["reports"].Value,
            parameters,
            BlazorMHD.UI.Core.Services.DialogSize.ExtraLarge);
    }
}
