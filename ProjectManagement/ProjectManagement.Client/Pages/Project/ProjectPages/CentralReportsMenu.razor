@inherits AppComponentBase

<button type="button"
        class="inline-flex h-8 w-8 items-center justify-center rounded-lg text-slate-700 transition hover:bg-slate-100 dark:text-slate-100 dark:hover:bg-slate-700"
        aria-label="@AppLoc["reports"]"
        title="@AppLoc["reports"]"
        @onclick="ShowReportsMenu">
    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3v18h18" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 15l4-4 3 3 5-7" />
    </svg>
</button>

@code {
    private IReadOnlyList<(string View, string Label)> MenuItems =>
    [
        (CentralReportsDialog.ReportView.Income, AppLoc["incomeOverview"].Value),
        (CentralReportsDialog.ReportView.HitRate, AppLoc["hitRate"].Value),
        (CentralReportsDialog.ReportView.Calculations, AppLoc["calculationListReport"].Value),
        (CentralReportsDialog.ReportView.Projects, AppLoc["projectListReport"].Value)
    ];

    private Task ShowReportsMenu()
    {
        var items = MenuItems
            .Select(item => new MenuItem
            {
                Label = item.Label,
                OnClickAsync = () =>
                {
                    OpenReport(item.View);
                    return Task.CompletedTask;
                }
            })
            .ToList();

        return ContextService.ShowMenuAsync(items);
    }

    private void OpenReport(string view)
    {
        var parameters = new Dictionary<string, object>
        {
            [nameof(CentralReportsDialog.InitialView)] = view
        };

        if (Folder.State.FolderSelected is not null)
            parameters[nameof(CentralReportsDialog.FolderScope)] = Folder.State.FolderSelected;

        if (Folder.State.ProjectSelected is not null)
            parameters[nameof(CentralReportsDialog.ProjectScope)] = Folder.State.ProjectSelected;

        Modal.ShowComponent<CentralReportsDialog>(
            AppLoc["reports"].Value,
            parameters,
            BlazorMHD.UI.Core.Services.DialogSize.ExtraLarge);
    }
}
