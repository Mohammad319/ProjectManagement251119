@using ProjectManagement.Client.Shared.MVVM.Folder
@using ProjectManagement.Client.Shared.SharedComponent
@using ProjectManagement.Shared.DTO.Transfer
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Authorization
@inherits AppComponentBase
@attribute [Authorize(Roles = PMRolesConst.Tenant.AdminManger)]

<div class="space-y-4 text-slate-800 dark:text-slate-100">

    @* ── Select file ──────────────────────────────────────────── *@
    <div>
        <label class="mb-1 block text-xs font-medium text-slate-600 dark:text-slate-300">@(IsProject ? "Välj projektkopia (.atacost)" : "Välj kalkylkopia (.atacost)")</label>
        <InputFile OnChange="OnFileSelectedAsync" accept=".atacost" disabled="@_busy"
                   class="block w-full text-sm text-slate-600 file:mr-3 file:rounded-lg file:border-0 file:bg-sky-600 file:px-3 file:py-1.5 file:text-sm file:font-semibold file:text-white hover:file:bg-sky-700 dark:text-slate-300" />
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-xs text-red-700 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-300">
            @_error
        </div>
    }

    @* ── Package info ─────────────────────────────────────────── *@
    @if (_info is { IsValid: true })
    {
        <div class="rounded-lg border border-slate-200 bg-slate-50 p-3 text-sm dark:border-slate-800 dark:bg-slate-950">
            <div class="text-slate-600 dark:text-slate-300">
                <span class="text-slate-400 dark:text-slate-500">@(IsProject ? "Projekt:" : "Kalkyl:")</span>
                <span class="font-semibold">@_info.DisplayName</span>
            </div>
            @if (IsProject)
            {
                <div class="mt-0.5 text-slate-600 dark:text-slate-300">
                    <span class="text-slate-400 dark:text-slate-500">Valda kalkyler:</span> @_info.CalculationCount
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_info.SenderCompany))
            {
                <div class="mt-0.5 text-slate-600 dark:text-slate-300">
                    <span class="text-slate-400 dark:text-slate-500">Från:</span> @_info.SenderCompany
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_info.Message))
            {
                <div class="mt-2 rounded border border-slate-200 bg-white p-2 text-xs text-slate-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300">
                    <span class="text-slate-400 dark:text-slate-500">Meddelande:</span> @_info.Message
                </div>
            }
        </div>

        @* ── Select target ────────────────────────────────────── *@
        @if (HasPresetTarget)
        {
            @* Fixed target (e.g. opened from the folder tree): show it read-only. *@
            <div class="rounded-lg border border-slate-200 bg-slate-50 p-3 text-sm dark:border-slate-800 dark:bg-slate-950">
                <span class="text-slate-400 dark:text-slate-500">Importeras till:</span>
                <span class="font-semibold">@TargetSummary</span>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                <div>
                    <label class="mb-1 block text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Avdelning</label>
                    <MhdFormSelect TValue="string"
                                   Value="_departmentValue"
                                   ValueChanged="OnDepartmentChanged"
                                   Options="DepartmentOptions"
                                   Placeholder="Välj avdelning..." />
                </div>
                <div>
                    <label class="mb-1 block text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Mapp <span class="text-amber-500">*</span></label>
                    <MhdFormSelect TValue="string"
                                   Value="_folderValue"
                                   ValueChanged="OnFolderChanged"
                                   Options="FolderOptions"
                                   Placeholder="Välj mapp..."
                                   Disabled="@(!_folders.Any())" />
                </div>
                @if (!IsProject)
                {
                    <div class="sm:col-span-2">
                        <label class="mb-1 block text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Projekt <span class="text-amber-500">*</span></label>
                        <MhdFormSelect TValue="string"
                                       Value="_projectValue"
                                       ValueChanged="OnProjectChanged"
                                       Options="ProjectOptions"
                                       Placeholder="Välj projekt..."
                                       Disabled="@(!_projects.Any())" />
                    </div>
                }
            </div>
        }

        @* ── Folder required (project import) ─────────────────────── *@
        @if (IsProject && !HasPresetTarget && string.IsNullOrEmpty(_folderValue))
        {
            <div class="rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-800 dark:border-amber-900/60 dark:bg-amber-950/30 dark:text-amber-300">
                Välj en mapp först för att importera en projektkopia.
            </div>
        }

        @* ── Import preview ───────────────────────────────────────── *@
        @if (_previewBusy)
        {
            <div class="text-xs text-slate-500 dark:text-slate-400">Förhandsgranskar import…</div>
        }
        else if (_preview is { IsValid: true })
        {
            <div class="rounded-lg border border-slate-200 bg-white p-3 dark:border-slate-700 dark:bg-slate-900">
                <h3 class="mb-2 text-sm font-semibold text-slate-900 dark:text-slate-100">Importförhandsgranskning</h3>

                @* Read-only target summary. *@
                <div class="mb-3 text-xs text-slate-600 dark:text-slate-300">
                    <span class="text-slate-400 dark:text-slate-500">Importeras till:</span>
                    <span class="font-semibold">@(_preview.TargetSummary)</span>
                </div>

                @if (!_preview.CanImport)
                {
                    <div class="mb-3 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-xs text-red-700 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-300">
                        Importen är blockerad tills alla obligatoriska fält har giltiga lokala värden.
                    </div>
                }

                @* ── Manual mapping of unmatched values ──────────────── *@
                @if (_preview.MappableSlots is { Count: > 0 })
                {
                    <div class="mb-3 rounded-lg border border-amber-200 bg-amber-50/60 p-3 dark:border-amber-900/60 dark:bg-amber-950/20">
                        <h4 class="mb-2 text-xs font-semibold text-amber-800 dark:text-amber-300">Värden som saknar motsvarighet</h4>
                        <div class="space-y-2">
                            @foreach (var slot in _preview.MappableSlots)
                            {
                                <div class="grid grid-cols-1 gap-1.5 sm:grid-cols-2 sm:items-center">
                                    <div class="text-xs text-slate-600 dark:text-slate-300">
                                        <span class="text-slate-400 dark:text-slate-500">@slot.Label:</span>
                                        <span class="font-semibold">@slot.OriginalValue</span>
                                        @if (slot.AffectedRows > 0)
                                        {
                                            <span class="text-slate-400 dark:text-slate-500"> (@slot.AffectedRows rader)</span>
                                        }
                                    </div>
                                    <MhdFormSelect TValue="string"
                                                   Value="CurrentSlotToken(slot)"
                                                   ValueChanged="@(v => OnSlotChanged(slot, v))"
                                                   Options="SlotOptions(slot)" />
                                </div>
                            }
                        </div>
                    </div>
                }

                <CalculationImportInfoDialog Info="_preview.Info" />
            </div>
        }
    }

    <div class="flex items-center justify-end gap-2">
        <button type="button"
                class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200"
                @onclick="Modal.CloseAsync">Avbryt</button>
        <button type="button"
                class="inline-flex items-center gap-1.5 rounded-lg bg-emerald-600 px-3 py-1.5 text-sm font-semibold text-white transition hover:bg-emerald-700 disabled:cursor-not-allowed disabled:opacity-50"
                disabled="@IsImportDisabled"
                @onclick="ImportAsync">
            @(IsProject ? "Importera projekt" : "Importera")
        </button>
    </div>
</div>

@code {
    [Parameter] public string Kind { get; set; } = AtacostPackageDTO.KindProject;
    [Parameter] public EventCallback OnCompleted { get; set; }

    // Optional preset target. When TargetSummary is set (e.g. opened from the
    // folder tree) the dialog hides the department/folder/project pickers and
    // imports to this fixed location instead.
    [Parameter] public Guid? PresetFolderId { get; set; }
    [Parameter] public Guid? PresetProjectId { get; set; }
    [Parameter] public string? TargetSummary { get; set; }

    private bool IsProject => Kind == AtacostPackageDTO.KindProject;

    private bool HasPresetTarget => !string.IsNullOrWhiteSpace(TargetSummary);

    // Resolved import target: prefers a preset id, otherwise the picked value.
    private Guid TargetFolderId => PresetFolderId ?? (Guid.TryParse(_folderValue, out var id) ? id : Guid.Empty);
    private Guid TargetProjectId => PresetProjectId ?? (Guid.TryParse(_projectValue, out var id) ? id : Guid.Empty);

    private byte[]? _fileBytes;
    private AtacostPackageInfoDTO? _info;
    private AtacostImportPreviewDTO? _preview;
    private string _error = string.Empty;
    private bool _busy;
    private bool _previewBusy;

    // User's manual mapping decisions, keyed by "{Type}|{OriginalKey}" so each unmatched source
    // value carries a single decision that survives a preview refresh. Sent to preview and import.
    private readonly Dictionary<string, AtacostManualMappingDTO> _overrides = new(StringComparer.Ordinal);

    private string _departmentValue = string.Empty;
    private string _folderValue = string.Empty;
    private string _projectValue = string.Empty;
    private List<FolderMVVM> _folders = [];
    private List<ProjectManagement.Client.Shared.MVVM.Folder.ListProjectMVVM> _projects = [];

    private IEnumerable<MhdSelectItem<string>> DepartmentOptions =>
        Folder.State.Departments.Select(d => new MhdSelectItem<string> { Value = d.Id.ToString(), Label = d.Name });

    private IEnumerable<MhdSelectItem<string>> FolderOptions =>
        _folders.Select(f => new MhdSelectItem<string> { Value = f.Id.ToString(), Label = f.Name });

    private IEnumerable<MhdSelectItem<string>> ProjectOptions =>
        _projects.Select(p => new MhdSelectItem<string> { Value = p.Id.ToString(), Label = p.Name });

    private bool IsImportDisabled =>
        _busy ||
        _previewBusy ||
        _info is not { IsValid: true } ||
        // A valid, importable preview is required: this enforces that a target is selected and
        // (in a future required-field phase) that all mandatory fields have local values.
        _preview is not { IsValid: true, CanImport: true } ||
        (HasPresetTarget
            ? (IsProject ? TargetFolderId == Guid.Empty : TargetProjectId == Guid.Empty)
            : (string.IsNullOrEmpty(_folderValue) || (!IsProject && string.IsNullOrEmpty(_projectValue))));

    protected override async Task OnInitializedAsync()
    {
        // A preset target skips the pickers entirely; nothing to preload.
        if (HasPresetTarget)
            return;

        _departmentValue = (Folder.State.SelectedDepartmentId
            ?? Folder.State.Departments.FirstOrDefault()?.Id)?.ToString() ?? string.Empty;
        await LoadFoldersAsync();

        if (Folder.State.FolderSelected is not null && _folders.Any(f => f.Id == Folder.State.FolderSelected.Id))
        {
            _folderValue = Folder.State.FolderSelected.Id.ToString();
            await LoadProjectsAsync();
        }
    }

    // Runs the dry-run preview whenever both a valid file and a resolved target are available.
    // Clears the preview when either is missing so a stale preview never enables the button.
    private async Task TryLoadPreviewAsync()
    {
        _preview = null;

        if (_fileBytes is null || _info is not { IsValid: true })
            return;

        var targetReady = IsProject ? TargetFolderId != Guid.Empty : TargetProjectId != Guid.Empty;
        if (!targetReady)
            return;

        _previewBusy = true;
        try
        {
            var overrides = _overrides.Values.ToList();
            _preview = IsProject
                ? await Repo.Project.PreviewCopyAsync(TargetFolderId, _fileBytes, overrides)
                : await Repo.Calculation.PreviewCopyAsync(TargetProjectId, _fileBytes, overrides);
        }
        catch (Exception ex)
        {
            await ClientLog.ErrorAsync("Atacost preview failed", ex: ex);
            _preview = null;
        }
        finally
        {
            _previewBusy = false;
        }
    }

    private async Task OnFileSelectedAsync(InputFileChangeEventArgs e)
    {
        _error = string.Empty;
        _info = null;
        _preview = null;
        _fileBytes = null;
        _overrides.Clear();

        try
        {
            var file = e.File;
            using var ms = new MemoryStream();
            await file.OpenReadStream(maxAllowedSize: 64 * 1024 * 1024).CopyToAsync(ms);
            _fileBytes = ms.ToArray();

            _info = await Repo.Project.InspectCopyAsync(_fileBytes);

            if (_info is null || !_info.IsValid)
            {
                _error = IsProject
                    ? "Filen är inte en giltig projektkopia."
                    : "Filen är inte en giltig kalkylkopia.";
                _info = null;
            }
            else if (_info.Kind != Kind)
            {
                _error = IsProject
                    ? "Filen innehåller en kalkylkopia, inte en projektkopia."
                    : "Filen innehåller en projektkopia, inte en kalkylkopia.";
                _info = null;
            }
            else
            {
                await TryLoadPreviewAsync();
            }
        }
        catch (Exception ex)
        {
            await ClientLog.ErrorAsync("Atacost inspect failed", ex: ex);
            _error = "Filen kunde inte läsas. Kontrollera att filen är giltig.";
        }
    }

    private async Task OnDepartmentChanged(string? value)
    {
        _departmentValue = value ?? string.Empty;
        _folderValue = string.Empty;
        _projectValue = string.Empty;
        _projects = [];
        _preview = null;
        await LoadFoldersAsync();
    }

    private async Task OnFolderChanged(string? value)
    {
        _folderValue = value ?? string.Empty;
        _projectValue = string.Empty;
        await LoadProjectsAsync();
        // For a project import the folder is the target, so refresh the preview now.
        if (IsProject)
            await TryLoadPreviewAsync();
    }

    private async Task OnProjectChanged(string? value)
    {
        _projectValue = value ?? string.Empty;
        // For a calculation import the project is the target, so refresh the preview now.
        await TryLoadPreviewAsync();
    }

    private async Task LoadFoldersAsync()
    {
        _folders = [];
        if (int.TryParse(_departmentValue, out var departmentId) && departmentId > 0)
            _folders = await Repo.Folder.GetByDepartmentAsync(departmentId, includeArchived: true);
    }

    private async Task LoadProjectsAsync()
    {
        _projects = [];
        if (!IsProject && Guid.TryParse(_folderValue, out var folderId) && folderId != Guid.Empty)
            _projects = await Repo.Project.GetByFolderIdAsync(folderId, includeArchived: true);
    }

    private async Task ImportAsync()
    {
        if (IsImportDisabled || _fileBytes is null) return;
        _busy = true;
        _error = string.Empty;
        try
        {
            var overrides = _overrides.Values.ToList();
            var result = IsProject
                ? await Repo.Project.ImportCopyAsync(TargetFolderId, _fileBytes, overrides)
                : await Repo.Calculation.ImportCopyAsync(TargetProjectId, _fileBytes, overrides);

            if (result is { Success: true })
            {
                // The file was valid and the import succeeded.
                MHD.ToastInfo(IsProject ? "Projektkopian har importerats." : "Kalkylkopian har importerats.");
                if (OnCompleted.HasDelegate)
                    await OnCompleted.InvokeAsync();
                await Modal.CloseAsync();
            }
            else
            {
                // Show the precise, server-provided reason (target missing, no permission, required
                // mapping, or a logged save error) instead of a single generic failure message.
                _error = !string.IsNullOrWhiteSpace(result?.Message)
                    ? result!.Message
                    : (IsProject
                        ? "Projektkopian kunde läsas men kunde inte importeras. Kontrollera målplatsen och försök igen."
                        : "Kalkylkopian kunde läsas men kunde inte importeras. Kontrollera målprojektet och försök igen.");
            }
        }
        catch (Exception ex)
        {
            await ClientLog.ErrorAsync("Atacost import failed", ex: ex);
            _error = IsProject
                ? "Projektkopian kunde läsas men kunde inte importeras. Kontrollera målplatsen och försök igen."
                : "Kalkylkopian kunde läsas men kunde inte importeras. Kontrollera målprojektet och försök igen.";
        }
        finally
        {
            _busy = false;
        }
    }

    // ── Manual mapping ──────────────────────────────────────────────
    // Each unmatched slot is resolved through a single dropdown whose value is a token:
    //   ""          → import with deviation (no override)
    //   "map:{id}"  → map to a local value
    //   "exclude"   → exclude the affected rows (row-level slots only)

    private static string SlotKey(AtacostMappableSlotDTO slot) => $"{slot.Type}|{slot.OriginalKey}";

    private string CurrentSlotToken(AtacostMappableSlotDTO slot)
    {
        if (!_overrides.TryGetValue(SlotKey(slot), out var ov))
            return string.Empty;
        return ov.Action switch
        {
            "exclude" => "exclude",
            "map" when ov.LocalId.HasValue => $"map:{ov.LocalId.Value}",
            _ => string.Empty
        };
    }

    private IEnumerable<MhdSelectItem<string>> SlotOptions(AtacostMappableSlotDTO slot)
    {
        yield return new MhdSelectItem<string> { Value = string.Empty, Label = "Importera med avvikelse" };
        foreach (var opt in slot.Options)
            yield return new MhdSelectItem<string> { Value = $"map:{opt.Id}", Label = opt.Name };
        if (slot.IsRowLevel)
            yield return new MhdSelectItem<string> { Value = "exclude", Label = "Uteslut rader" };
    }

    private async Task OnSlotChanged(AtacostMappableSlotDTO slot, string? token)
    {
        var key = SlotKey(slot);

        if (string.IsNullOrEmpty(token))
        {
            // Back to the default — drop any stored decision.
            _overrides.Remove(key);
        }
        else if (token == "exclude")
        {
            _overrides[key] = new AtacostManualMappingDTO
            {
                Type = slot.Type,
                OriginalValue = slot.OriginalKey,
                Action = "exclude"
            };
        }
        else if (token.StartsWith("map:", StringComparison.Ordinal)
            && int.TryParse(token.AsSpan(4), out var localId))
        {
            _overrides[key] = new AtacostManualMappingDTO
            {
                Type = slot.Type,
                OriginalValue = slot.OriginalKey,
                LocalId = localId,
                Action = "map"
            };
        }

        // Re-run the dry-run so matched/deviation counts and CanImport reflect the new decision.
        await TryLoadPreviewAsync();
    }
}
