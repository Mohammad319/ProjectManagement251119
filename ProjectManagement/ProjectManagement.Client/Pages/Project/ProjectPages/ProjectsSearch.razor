    {
        await Folder.NewFolder(folder);
        await Folder.NewProject(project);
        await Modal.CloseAsync();
    }

    // ── Styled dropdown helpers (same look as the report window) ───────
    private const string LabelClass = "mb-1 block text-[11px] font-semibold text-slate-500 dark:text-slate-400";
    private const string SelectClass = "h-8 w-full rounded-md border border-slate-300 bg-white px-2 text-xs text-slate-800 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 disabled:bg-slate-100 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:disabled:bg-slate-800";

    private RenderFragment ChevronSvg => @<svg class="ml-1 h-3 w-3 shrink-0 text-slate-400" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
    </svg>;

    private RenderFragment CheckSvg => @<svg class="ml-auto h-3.5 w-3.5 shrink-0 text-sky-600 dark:text-sky-400" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>;

    // Body of the currently open dropdown popup (rendered inside the teleported panel).
    private RenderFragment ActiveDropdownBody() => _openDropdown switch
    {
        "type" => MultiOptionList(
            CalcLoc[nameof(CalcResource.allTypes)], _selectedTypes.Count == 0, ClearTypes,
            SpecificTypes, TypeLabel, t => _selectedTypes.Contains(t), ToggleType),
        "match" => SingleOptionList(
            MatchOperators, MatchOperatorLabel, op => op == MatchOperator, SelectMatchOperator),
        "status" => MultiOptionList(
            AppLoc["allStatuses"].Value, _selectedStatuses.Count == 0, ClearStatuses,
            AvailableCalcStatuses, s => s, s => _selectedStatuses.Contains(s), ToggleStatus),
        _ => (RenderFragment)(_ => { })
    };

    // Multi-select list body: checkboxes; toggling an item keeps the popup open.
    // The "All" row clears the set. Styled to match MhdFormSelect's option rows.
    private RenderFragment MultiOptionList<T>(
        string allLabel, bool allSelected, Action onClear,
        IEnumerable<T> items, Func<T, string> itemLabel, Func<T, bool> isChecked, Action<T, bool> onItemToggle)
        => @<text>
            <button type="button" class="@OptionRowClass(allSelected)" @onclick="() => { onClear(); StateHasChanged(); }">
                <span class="flex-1 truncate @(allSelected ? "" : "text-slate-500 dark:text-slate-400")">@allLabel</span>
                @if (allSelected) { @CheckSvg }
            </button>
            @foreach (var it in items)
            {
                var item = it;
                var on = isChecked(item);
                <label class="@OptionRowClass(on)">
                    <input type="checkbox" class="h-3.5 w-3.5 shrink-0 rounded border-slate-300 text-sky-600 focus:ring-sky-500 dark:border-slate-600 dark:bg-slate-950"
                           checked="@on" @onchange="e => { onItemToggle(item, (bool)(e.Value ?? false)); StateHasChanged(); }" />
                    <span class="flex-1 truncate">@itemLabel(item)</span>
                </label>
            }
        </text>;

    // Single-select list body: exactly one value; selecting closes the popup.
    private RenderFragment SingleOptionList<T>(
        IEnumerable<T> items, Func<T, string> itemLabel, Func<T, bool> isSelected, Action<T> onSelect)
        => @<text>
            @foreach (var it in items)
            {
                var item = it;
                var sel = isSelected(item);
                <button type="button" class="@OptionRowClass(sel)" @onclick="() => onSelect(item)">
                    <span class="flex-1 truncate">@itemLabel(item)</span>
                    @if (sel) { @CheckSvg }
                </button>
            }
        </text>;

    private static string OptionRowClass(bool selected) => selected
        ? "flex w-full cursor-pointer items-center gap-2 px-3 py-1.5 text-left text-sm font-medium text-sky-700 bg-sky-50 dark:bg-sky-950/40 dark:text-sky-300"
        : "flex w-full cursor-pointer items-center gap-2 px-3 py-1.5 text-left text-sm text-slate-700 transition-colors hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800";

    // ── Teleported dropdown popup: open/close + positioning ────────────
    private async Task ToggleDropdown(string key)
    {
        if (_openDropdown == key)
        {
            await CloseDropdownAsync();
            return;
        }

        _openDropdown = key;
        _pendingOpen = true;
        StateHasChanged();
    }

    private async Task CloseDropdownAsync()
    {
        if (_openDropdown is null) return;
        _openDropdown = null;
        try { await JS.InvokeVoidAsync("searchDropdownPortal.close"); }
        catch (JSException) { }
        catch (InvalidOperationException) { }
        StateHasChanged();
    }

    [JSInvokable]
    public Task OnPortalDismiss() => InvokeAsync(CloseDropdownAsync);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_portalMounted)
        {
            _portalMounted = true;
            try { await JS.InvokeVoidAsync("searchDropdownPortal.mount", _portalHost); }
            catch (JSException) { }
            catch (InvalidOperationException) { }
        }

        if (_openDropdown is null) return;

        var anchor = _openDropdown switch { "type" => _typeBtn, "match" => _matchBtn, _ => _statusBtn };
        try
        {
            if (_pendingOpen)
            {
                _pendingOpen = false;
                _selfRef ??= DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("searchDropdownPortal.open", _panelRef, anchor, _selfRef);
            }
            else
            {
                // Content changed (e.g. a checkbox toggled) — keep the popup anchored.
                await JS.InvokeVoidAsync("searchDropdownPortal.reposition");
            }
        }
        catch (JSException) { }
        catch (InvalidOperationException) { }
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("searchDropdownPortal.dispose"); }
        catch (JSException) { }
        catch (InvalidOperationException) { }
        catch (JSDisconnectedException) { }
        _selfRef?.Dispose();
    }
}
