@using ProjectManagement.Client.Services.Folder
@using ProjectManagement.Client.Shared.MVVM.Folder
@using ProjectManagement.Client.Shared.Repositories.Organisation
@using ProjectManagement.Shared.DTO.App.List
@using ProjectManagement.Shared.DTO.Organisation
@using ProjectManagement.Shared.DTO.Project
@using ProjectManagement.Client.Shared.Model.Project
@using ProjectManagement.Shared.Enums
@inherits AppComponentBase

<div class="space-y-2">

    <!-- Search / Filter -->
    <EditForm id="myForm"
              Model="@projectFilter"
              OnValidSubmit="HandleSubmitAsync"
              class="overflow-hidden rounded border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-900">

        <DataAnnotationsValidator />

        <!-- Top bar -->
        <div class="border-b border-slate-200 bg-slate-50 px-2 py-2 dark:border-slate-700 dark:bg-slate-800/70">
            <div class="overflow-x-auto overflow-y-hidden">
                <div class="flex min-w-max flex-nowrap items-end gap-2">
                    <div class="min-w-[320px] flex-1">
                        <InputText @bind-Value="@projectFilter.Name"
                                   placeholder="@AppLoc["projectNamePlaceholder"]"
                                   class="h-9 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:placeholder:text-slate-500 dark:focus:border-blue-400 dark:focus:ring-blue-400/20" />
                        <ValidationMessage For="(() => projectFilter.Name)" class="mt-1 text-xs text-red-600 dark:text-red-400" />
                    </div>

                    <button type="submit"
                            form="myForm"
                            disabled="@IsLoading"
                            class="inline-flex h-9 shrink-0 items-center justify-center gap-2 rounded-lg bg-blue-600 px-3 text-sm font-medium text-white transition hover:bg-blue-700 disabled:cursor-not-allowed disabled:opacity-60 dark:bg-blue-500 dark:hover:bg-blue-600">
                        <span>@((MarkupString)Icons.Search)</span>
                        <span>@AppLoc["search"]</span>
                    </button>

                    <button type="button"
                            disabled="@IsLoading"
                            @onclick="ToggleDetails"
                            class="inline-flex h-9 shrink-0 items-center justify-center gap-2 rounded-lg border border-slate-300 bg-white px-3 text-sm font-medium text-slate-700 transition hover:bg-slate-100 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">
                        <span class="oi @(DetailsDiv ? "oi-chevron-top" : "oi-chevron-bottom")"></span>
                        <span>@(DetailsDiv ? AppLoc["hideDetails"] : AppLoc["showDetails"])</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Advanced filters -->
        @if (DetailsDiv)
        {
            <div class="border-t border-slate-200 bg-slate-50/70 px-2 py-2 dark:border-slate-700 dark:bg-slate-800/40">
                <div class="grid grid-cols-2 gap-3">
                    <div class="min-w-0">
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-300">
                            @CalcResource.name
                        </label>
                        <InputSelect @bind-Value="projectFilter.NameOperator"
                                     class="h-9 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-blue-400 dark:focus:ring-blue-400/20">
                            <option value="%var%">%...%</option>
                            <option value="==">==</option>
                            <option value="!=">!=</option>
                            <option value="%var">%...</option>
                            <option value="var%">...%</option>
                        </InputSelect>
                        <ValidationMessage For="(() => projectFilter.NameOperator)" class="mt-1 text-xs text-red-600 dark:text-red-400" />
                    </div>

                    <div class="min-w-0">
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-300">
                            @CalcResource.code
                        </label>
                        <InputText @bind-Value="@projectFilter.Code"
                                   placeholder="@AppLoc["codePlaceholder"]"
                                   class="h-9 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:placeholder:text-slate-500 dark:focus:border-blue-400 dark:focus:ring-blue-400/20" />
                        <ValidationMessage For="@(() => projectFilter.Code)" class="mt-1 text-xs text-red-600 dark:text-red-400" />
                    </div>

                    <div class="min-w-0">
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-300">
                            @ResourceIdentity.customer
                        </label>
                        <InputSelect @bind-Value="projectFilter.CustomerId"
                                     class="h-9 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-blue-400 dark:focus:ring-blue-400/20">
                            <option value=""></option>
                            @if (Customers != null)
                            {
                                @foreach (var customer in Customers)
                                {
                                    <option value="@customer.Id">@customer.Name</option>
                                }
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => projectFilter.CustomerId)" class="mt-1 text-xs text-red-600 dark:text-red-400" />
                    </div>

                    <div class="min-w-0">
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-300">
                            @ResourceApp.isVisible
                        </label>
                        <label class="inline-flex h-9 w-full items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 text-sm text-slate-700 shadow-sm whitespace-nowrap dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300">
                            <InputCheckbox @bind-Value="@projectFilter.IsVisible"
                                           class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 dark:border-slate-600 dark:bg-slate-800 dark:text-blue-400" />
                            <span>@ResourceApp.isVisible</span>
                        </label>
                    </div>

                    <div class="min-w-0">
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-300">
                            @CalcResource.startDate 1
                        </label>
                        <InputDate @bind-Value="@projectFilter.StartDate1"
                                   class="h-9 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-blue-400 dark:focus:ring-blue-400/20" />
                        <ValidationMessage For="@(() => projectFilter.StartDate1)" class="mt-1 text-xs text-red-600 dark:text-red-400" />
                    </div>

                    <div class="min-w-0">
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-300">
                            @CalcResource.startDate 2
                        </label>
                        <InputDate @bind-Value="@projectFilter.StartDate2"
                                   class="h-9 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-blue-400 dark:focus:ring-blue-400/20" />
                        <ValidationMessage For="@(() => projectFilter.StartDate2)" class="mt-1 text-xs text-red-600 dark:text-red-400" />
                    </div>

                    <div class="min-w-0">
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-300">
                            @CalcResource.endDate 1
                        </label>
                        <InputDate @bind-Value="@projectFilter.EndDate1"
                                   class="h-9 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-blue-400 dark:focus:ring-blue-400/20" />
                        <ValidationMessage For="@(() => projectFilter.EndDate1)" class="mt-1 text-xs text-red-600 dark:text-red-400" />
                    </div>

                    <div class="min-w-0">
                        <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-300">
                            @CalcResource.endDate 2
                        </label>
                        <InputDate @bind-Value="@projectFilter.EndDate2"
                                   class="h-9 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-blue-400 dark:focus:ring-blue-400/20" />
                        <ValidationMessage For="@(() => projectFilter.EndDate2)" class="mt-1 text-xs text-red-600 dark:text-red-400" />
                    </div>
                </div>
            </div>
        }
    </EditForm>

    <!-- Results -->
    <div class="overflow-hidden rounded border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-900">
        <div class="flex flex-col gap-2 border-b border-slate-200 bg-slate-50 px-4 py-3 sm:flex-row sm:items-center sm:justify-between dark:border-slate-700 dark:bg-slate-800/70">
            <div>
                <h6 class="text-sm font-semibold text-slate-900 dark:text-slate-100">
                    @AppLoc["searchResults"]
                </h6>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                    @AppLoc["projectsCount", projects?.Count ?? 0]
                </p>
            </div>

            <div class="inline-flex w-fit items-center rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-300">
                @(IsLoading ? AppLoc["loading"] : AppLoc["ready"])
            </div>
        </div>

        @if (IsLoading)
        {
            <div class="px-4 py-10 text-center text-sm text-slate-500 dark:text-slate-400">
                @AppLoc["loading"]
            </div>
        }
        else if (projects == null || !projects.Any())
        {
            <div class="px-4 py-10 text-center text-sm text-slate-500 dark:text-slate-400">
                @AppLoc["noProjectsFound"]
            </div>
        }
        else
        {
            <!-- Mobile cards -->
            <div class="grid gap-3 p-4 lg:hidden">
                @foreach (var project in projects)
                {
                    <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900/80">
                        <div class="flex items-start justify-between gap-3">
                            <div class="min-w-0">
                                <button class="text-left text-sm font-semibold text-blue-700 underline decoration-transparent underline-offset-4 transition hover:decoration-current dark:text-blue-400"
                                        @onclick="async () => await ProjectSelected(project)"
                                        disabled="@IsLoading">
                                    @project.Name
                                </button>

                                <div class="mt-1 text-xs text-slate-500 dark:text-slate-400">
                                    @project.Code
                                </div>
                            </div>
                        </div>

                        <div class="mt-4 grid grid-cols-2 gap-3 text-sm">
                            <div>
                                <div class="text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">
                                    @CalcResource.startDate
                                </div>
                                <div class="mt-1 text-slate-700 dark:text-slate-300">
                                    @project.StartDate.ToString(ConstValues.DateFormat)
                                </div>
                            </div>

                            <div>
                                <div class="text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">
                                    @CalcResource.endDate
                                </div>
                                <div class="mt-1 text-slate-700 dark:text-slate-300">
                                    @project.EndDate.ToString(ConstValues.DateFormat)
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Desktop table -->
            <div class="hidden overflow-x-auto lg:block">
                <table class="min-w-full divide-y divide-slate-200 dark:divide-slate-700">
                    <thead class="bg-slate-100 dark:bg-slate-800">
                        <tr>
                            <th class="px-4 py-3 text-left text-sm font-semibold text-slate-700 dark:text-slate-200">
                                @CalcResource.name
                            </th>
                            <th class="px-4 py-3 text-left text-sm font-semibold text-slate-700 dark:text-slate-200">
                                @CalcResource.code
                            </th>
                            <th class="px-4 py-3 text-left text-sm font-semibold text-slate-700 dark:text-slate-200">
                                @CalcResource.startDate
                            </th>
                            <th class="px-4 py-3 text-left text-sm font-semibold text-slate-700 dark:text-slate-200">
                                @CalcResource.endDate
                            </th>
                        </tr>
                    </thead>

                    <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                        @foreach (var project in projects)
                        {
                            <tr class="transition hover:bg-slate-50 dark:hover:bg-slate-800/60">
                                <td class="px-4 py-3 align-middle">
                                    <button class="text-left text-sm font-medium text-blue-700 underline decoration-transparent underline-offset-4 transition hover:decoration-current dark:text-blue-400"
                                            @onclick="async () => await ProjectSelected(project)"
                                            disabled="@IsLoading">
                                        @project.Name
                                    </button>
                                </td>
                                <td class="px-4 py-3 text-sm text-slate-700 dark:text-slate-300">
                                    @project.Code
                                </td>
                                <td class="px-4 py-3 text-sm text-slate-700 dark:text-slate-300">
                                    @project.StartDate.ToString(ConstValues.DateFormat)
                                </td>
                                <td class="px-4 py-3 text-sm text-slate-700 dark:text-slate-300">
                                    @project.EndDate.ToString(ConstValues.DateFormat)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    ProjectFilter projectFilter = new();
    List<ListDTO>? Customers;
    List<SearchProjectsMVVM>? projects;
    bool DetailsDiv = false;
    bool IsLoading = true;

    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback CallBack { get; set; }

    void ToggleDetails()
    {
        DetailsDiv = !DetailsDiv;
    }

    async Task HandleSubmitAsync()
    {
        IsLoading = true;
        StateHasChanged();

        projects = await Repo.Project.FilterAsync(projectFilter);

        IsLoading = false;
    }

    async Task ProjectSelected(SearchProjectsMVVM pro)
    {
        ListProjectMVVM o = new();
        FolderMVVM? folder = UoWService?.Folder?.State?.FoldersList?.FirstOrDefault(x => x.Id == pro.FolderId);

        if (folder == null || pro == null)
            return;

        PropertyCopier.CopyPropertiesTo(pro, o);
        await Folder.NewFolder(folder);
        await Folder.NewProject(o);
        Modal.Close();
    }

    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;
        Customers = await Repo.Org.GetVisibleOrIdAsync();
        IsLoading = false;
    }
}
