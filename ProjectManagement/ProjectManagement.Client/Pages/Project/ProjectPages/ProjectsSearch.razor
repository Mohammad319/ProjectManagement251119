@using ProjectManagement.Client.Services.Folder
@using ProjectManagement.Client.Shared.MVVM.Calculation
@using ProjectManagement.Client.Shared.MVVM.Folder
@using ProjectManagement.Client.Shared.Model.Project
@using ProjectManagement.Client.Shared.Repositories.Organisation
@using ProjectManagement.Shared.DTO.App.List
@using ProjectManagement.Shared.DTO.Organisation
@using ProjectManagement.Shared.DTO.Project
@using ProjectManagement.Shared.Enums
@inherits AppComponentBase

<div class="flex flex-col gap-3">

    <!-- Search bar -->
    <div class="flex gap-2">
        <input type="text"
               @bind="SearchText"
               @bind:event="oninput"
               @onkeyup="OnKeyUp"
               placeholder="@CalcLoc[nameof(CalcResource.searchNameOrCodePlaceholder)]"
               class="h-9 flex-1 rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:placeholder:text-slate-500 dark:focus:border-blue-400 dark:focus:ring-blue-400/20" />
        <button type="button"
                @onclick="SearchAsync"
                disabled="@IsLoading"
                class="inline-flex h-9 shrink-0 items-center justify-center gap-2 rounded-lg bg-blue-600 px-4 text-sm font-medium text-white transition hover:bg-blue-700 disabled:cursor-not-allowed disabled:opacity-60 dark:bg-blue-500 dark:hover:bg-blue-600">
            <span aria-hidden="true">@((MarkupString)Icons.Search)</span>
            <span>@AppLoc["search"]</span>
        </button>
    </div>

    <!-- Filter row -->
    <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
        <!-- Type filter -->
        <div>
            <label class="mb-1 block text-xs font-semibold text-slate-600 dark:text-slate-400">
                @CalcLoc[nameof(CalcResource.typeFilter)]
            </label>
            <select @bind="TypeFilter"
                    class="h-8 w-full rounded-lg border border-slate-300 bg-white px-2 text-xs text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-blue-400 dark:focus:ring-blue-400/20">
                <option value="@SearchTypeFilter.All">@CalcLoc[nameof(CalcResource.allTypes)]</option>
                <option value="@SearchTypeFilter.Folders">@CalcLoc[nameof(CalcResource.foldersLabel)]</option>
                <option value="@SearchTypeFilter.Projects">@CalcLoc[nameof(CalcResource.projectsLabel)]</option>
                <option value="@SearchTypeFilter.Calculations">@CalcLoc[nameof(CalcResource.calculationsLabel)]</option>
            </select>
        </div>

        <!-- Match operator -->
        <div>
            <label class="mb-1 block text-xs font-semibold text-slate-600 dark:text-slate-400">
                @CalcLoc[nameof(CalcResource.matchType)]
            </label>
            <select @bind="MatchOperator"
                    title="@MatchOperatorHelp"
                    class="h-8 w-full rounded-lg border border-slate-300 bg-white px-2 text-xs text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-blue-400 dark:focus:ring-blue-400/20">
                <option value="smart" title="@CalcLoc[nameof(CalcResource.matchSmartTip)]">@CalcLoc[nameof(CalcResource.matchSmart)]</option>
                <option value="%var%" title="@CalcLoc[nameof(CalcResource.matchContainsTip)]">@CalcLoc[nameof(CalcResource.matchContains)]</option>
                <option value="==" title="@CalcLoc[nameof(CalcResource.matchEqualsTip)]">@CalcLoc[nameof(CalcResource.matchEquals)]</option>
                <option value="var%" title="@CalcLoc[nameof(CalcResource.matchStartsWithTip)]">@CalcLoc[nameof(CalcResource.matchStartsWith)]</option>
                <option value="%var" title="@CalcLoc[nameof(CalcResource.matchEndsWithTip)]">@CalcLoc[nameof(CalcResource.matchEndsWith)]</option>
                <option value="~" title="@CalcLoc[nameof(CalcResource.matchSimilarTip)]">@CalcLoc[nameof(CalcResource.matchSimilar)]</option>
            </select>
            <p class="mt-1 text-[10px] leading-tight text-slate-400 dark:text-slate-500">@MatchOperatorHelp</p>
        </div>

        <!-- Calc status filter -->
        <div>
            <label class="mb-1 block text-xs font-semibold text-slate-600 dark:text-slate-400">
                @CalcLoc[nameof(CalcResource.calculationStatus)]
            </label>
            <select @bind="CalcStatusFilter"
                    class="h-8 w-full rounded-lg border border-slate-300 bg-white px-2 text-xs text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-blue-400 dark:focus:ring-blue-400/20">
                <option value="">@AppLoc["allStatuses"]</option>
                @foreach (var s in AvailableCalcStatuses)
                {
                    <option value="@s">@s</option>
                }
            </select>
        </div>

        <!-- Archive checkbox -->
        <div class="flex flex-col justify-end">
            <label class="inline-flex h-8 cursor-pointer items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 text-xs font-medium text-slate-700 shadow-sm dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300">
                <input type="checkbox"
                       @bind="IncludeArchived"
                       class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 dark:border-slate-600 dark:bg-slate-800 dark:text-blue-400" />
                <span>@CalcLoc[nameof(CalcResource.includeArchived)]</span>
            </label>
        </div>
    </div>

    <!-- Deadline filters (projects only) -->
    @if (TypeFilter == SearchTypeFilter.All || TypeFilter == SearchTypeFilter.Projects)
    {
        <div class="grid grid-cols-2 gap-2">
            <div>
                <label class="mb-1 block text-xs font-semibold text-slate-600 dark:text-slate-400">
                    Frågor/svar senast
                </label>
                <input type="date"
                       @bind="TenderQADate"
                       class="h-8 w-full rounded-lg border border-slate-300 bg-white px-2 text-xs text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-blue-400 dark:focus:ring-blue-400/20" />
            </div>
            <div>
                <label class="mb-1 block text-xs font-semibold text-slate-600 dark:text-slate-400">
                    @CalcLoc[nameof(CalcResource.tenderDeadline)]
                </label>
                <input type="date"
                       @bind="TenderDeadlineDate"
                       class="h-8 w-full rounded-lg border border-slate-300 bg-white px-2 text-xs text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-blue-400 dark:focus:ring-blue-400/20" />
            </div>
        </div>
    }

    <!-- Results -->
    @if (HasSearched)
    {
        <div class="overflow-hidden rounded-lg border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-900">

            <!-- Result summary header -->
            <div class="flex items-center justify-between border-b border-slate-200 bg-slate-50 px-4 py-2.5 dark:border-slate-700 dark:bg-slate-800/70">
                <span class="text-sm font-semibold text-slate-800 dark:text-slate-100">
                    @AppLoc["searchResults"]
                </span>
                @if (IsLoading)
                {
                    <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-600 dark:bg-slate-700 dark:text-slate-300">@AppLoc["loading"]</span>
                }
                else
                {
                    <span class="text-xs text-slate-500 dark:text-slate-400">
                        @string.Format(CalcLoc[nameof(CalcResource.resultSummaryFormat)], FolderResults.Count, ProjectResults.Count, CalcResults.Count)
                    </span>
                }
            </div>

            @if (IsLoading)
            {
                <div class="px-4 py-10 text-center text-sm text-slate-500 dark:text-slate-400">
                    @AppLoc["loading"]
                </div>
            }
            else if (!FolderResults.Any() && !ProjectResults.Any() && !CalcResults.Any())
            {
                <div class="px-4 py-8 text-center">
                    <p class="text-sm font-medium text-slate-700 dark:text-slate-200">@CalcLoc[nameof(CalcResource.noResultsFound)]</p>
                    <p class="mt-1 text-xs text-slate-400 dark:text-slate-500">@CalcLoc[nameof(CalcResource.checkSpellingOrFilter)]</p>
                </div>

                @* Fuzzy fallback: show similar results for strict operators that found nothing *@
                @if (!string.IsNullOrWhiteSpace(SearchText) &&
                     (FuzzyFolderResults.Any() || FuzzyProjectResults.Any() || FuzzyCalcResults.Any()))
                {
                    <div class="border-t border-slate-200 dark:border-slate-700">
                        <div class="bg-amber-50/80 px-4 py-2 dark:bg-amber-950/30">
                            <span class="text-xs font-semibold text-amber-700 dark:text-amber-400">
                                @CalcLoc[nameof(CalcResource.similarResults)]
                            </span>
                        </div>
                        <div class="divide-y divide-slate-100 dark:divide-slate-800">
                            @foreach (var folder in FuzzyFolderResults.Take(5))
                            {
                                <button type="button"
                                        @onclick="async () => await FolderSelected(folder.Item)"
                                        class="flex w-full items-center gap-3 px-4 py-2 text-left transition hover:bg-slate-50 dark:hover:bg-slate-800/60">
                                    <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-md bg-emerald-100 text-emerald-700 dark:bg-emerald-950/50 dark:text-emerald-300">
                                        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                            <path d="M10 4H4c-1.11 0-2 .89-2 2v12c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2h-8l-2-2z"/>
                                        </svg>
                                    </span>
                                    <div class="min-w-0 flex-1">
                                        <div class="truncate text-xs font-medium text-slate-700 dark:text-slate-200">@folder.Item.Name</div>
                                        <span class="text-[10px] text-slate-400">Mapp · @SimilarBadge</span>
                                    </div>
                                </button>
                            }
                            @foreach (var entry in FuzzyProjectResults.Take(5))
                            {
                                <button type="button"
                                        @onclick="async () => await ProjectSelected(entry.Item)"
                                        class="flex w-full items-center gap-3 px-4 py-2 text-left transition hover:bg-slate-50 dark:hover:bg-slate-800/60">
                                    <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-md bg-sky-100 text-sky-700 dark:bg-sky-950/50 dark:text-sky-300">
                                        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4.5 5.5h15v13h-15z" />
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 9h8M8 13h3M14 13h2M8 16h8" />
                                        </svg>
                                    </span>
                                    <div class="min-w-0 flex-1">
                                        <div class="truncate text-xs font-medium text-slate-700 dark:text-slate-200">@entry.Item.Name</div>
                                        <span class="text-[10px] text-slate-400">Projekt · @SimilarBadge</span>
                                    </div>
                                </button>
                            }
                            @foreach (var entry in FuzzyCalcResults.Take(5))
                            {
                                <button type="button"
                                        @onclick="async () => await CalcSelected(entry.Calc, entry.Project, entry.Folder)"
                                        class="flex w-full items-center gap-3 px-4 py-2 text-left transition hover:bg-slate-50 dark:hover:bg-slate-800/60">
                                    <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300">
                                        <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                            <rect x="4" y="3" width="16" height="18" rx="2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 8h8M8 12h5M8 16h3"/>
                                        </svg>
                                    </span>
                                    <div class="min-w-0 flex-1">
                                        <div class="truncate text-xs font-medium text-slate-700 dark:text-slate-200">@entry.Calc.Name</div>
                                        <span class="text-[10px] text-slate-400">Kalkyl · @entry.Project.Name · @entry.Folder.Name · @SimilarBadge</span>
                                    </div>
                                </button>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="divide-y divide-slate-100 dark:divide-slate-800">

                    <!-- Folders section -->
                    @if (FolderResults.Any())
                    {
                        <div>
                            <div class="bg-slate-50/80 px-4 py-1.5 dark:bg-slate-800/50">
                                <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">
                                    @CalcLoc[nameof(CalcResource.foldersLabel)]
                                </span>
                            </div>
                            @foreach (var hit in FolderResults)
                            {
                                <button type="button"
                                        @onclick="async () => await FolderSelected(hit.Item)"
                                        class="flex w-full items-center gap-3 px-4 py-2.5 text-left transition hover:bg-slate-50 dark:hover:bg-slate-800/60">
                                    <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-emerald-100 text-emerald-700 dark:bg-emerald-950/50 dark:text-emerald-300">
                                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                            <path d="M10 4H4c-1.11 0-2 .89-2 2v12c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2h-8l-2-2z"/>
                                        </svg>
                                    </span>
                                    <div class="min-w-0 flex-1">
                                        <div class="truncate text-sm font-medium text-slate-800 dark:text-slate-100">@hit.Item.Name</div>
                                        <div class="flex flex-wrap items-center gap-1.5 text-[11px] text-slate-400 dark:text-slate-500">
                                            <span class="font-medium text-slate-500 dark:text-slate-400">Mapp</span>
                                            @if (!hit.Item.IsVisible)
                                            {
                                                <span class="text-amber-500">· @AppLoc["archived"]</span>
                                            }
                                            @if (hit.Fuzzy)
                                            {
                                                <span>· @SimilarBadge</span>
                                            }
                                        </div>
                                    </div>
                                </button>
                            }
                        </div>
                    }

                    <!-- Projects section -->
                    @if (ProjectResults.Any())
                    {
                        <div>
                            <div class="bg-slate-50/80 px-4 py-1.5 dark:bg-slate-800/50">
                                <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">
                                    @CalcLoc[nameof(CalcResource.projectsLabel)]
                                </span>
                            </div>
                            @foreach (var hit in ProjectResults)
                            {
                                var project = hit.Item;
                                <button type="button"
                                        @onclick="async () => await ProjectSelected(project)"
                                        class="flex w-full items-center gap-3 px-4 py-2.5 text-left transition hover:bg-slate-50 dark:hover:bg-slate-800/60"
                                        disabled="@IsLoading">
                                    <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-sky-100 text-sky-700 dark:bg-sky-950/50 dark:text-sky-300">
                                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4.5 5.5h15v13h-15z" />
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 9h8M8 13h3M14 13h2M8 16h8" />
                                        </svg>
                                    </span>
                                    <div class="min-w-0 flex-1">
                                        <div class="truncate text-sm font-medium text-slate-800 dark:text-slate-100">@project.Name</div>
                                        <div class="flex flex-wrap items-center gap-1.5 text-[11px] text-slate-400 dark:text-slate-500">
                                            <span class="font-medium text-slate-500 dark:text-slate-400">Projekt</span>
                                            @if (!string.IsNullOrWhiteSpace(project.Code))
                                            {
                                                <span>· @project.Code</span>
                                            }
                                            @{
                                                var projectFolder = GetFolderForProject(project);
                                            }
                                            @if (projectFolder != null)
                                            {
                                                <span>· @projectFolder.Name</span>
                                            }
                                            @if (project.TenderDeadline != default)
                                            {
                                                <span>· @CalcLoc[nameof(CalcResource.tenderDeadline)]: @project.TenderDeadline.ToString("yyyy-MM-dd")</span>
                                            }
                                            @if (project.IsArchived)
                                            {
                                                <span class="text-amber-500">· @AppLoc["archived"]</span>
                                            }
                                            @if (hit.Fuzzy)
                                            {
                                                <span>· @SimilarBadge</span>
                                            }
                                        </div>
                                    </div>
                                </button>
                            }
                        </div>
                    }

                    <!-- Calculations section -->
                    @if (CalcResults.Any())
                    {
                        <div>
                            <div class="bg-slate-50/80 px-4 py-1.5 dark:bg-slate-800/50">
                                <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">
                                    @CalcLoc[nameof(CalcResource.calculationsLabel)]
                                </span>
                            </div>
                            @foreach (var hit in CalcResults)
                            {
                                var calc = hit.Calc;
                                var project = hit.Project;
                                var folder = hit.Folder;
                                <button type="button"
                                        @onclick="async () => await CalcSelected(calc, project, folder)"
                                        class="flex w-full items-center gap-3 px-4 py-2.5 text-left transition hover:bg-slate-50 dark:hover:bg-slate-800/60">
                                    <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300">
                                        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                            <rect x="4" y="3" width="16" height="18" rx="2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 8h8M8 12h5M8 16h3"/>
                                        </svg>
                                    </span>
                                    <div class="min-w-0 flex-1">
                                        <div class="truncate text-sm font-medium text-slate-800 dark:text-slate-100">@calc.Name</div>
                                        <div class="flex flex-wrap items-center gap-1.5 text-[11px] text-slate-400 dark:text-slate-500">
                                            <span class="font-medium text-slate-500 dark:text-slate-400">Kalkyl</span>
                                            @if (!string.IsNullOrWhiteSpace(calc.Code))
                                            {
                                                <span>· @calc.Code</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(calc.Status))
                                            {
                                                <span class="inline-flex items-center gap-1 rounded bg-slate-100 px-1 py-0.5 font-medium text-slate-600 dark:bg-slate-700 dark:text-slate-300">
                                                    <span class="h-1.5 w-1.5 rounded-full"
                                                          style="background-color:@GetCalculationStatusColor(calc)"></span>
                                                    @calc.Status
                                                </span>
                                            }
                                            <span>· @project.Name · @folder.Name</span>
                                            @if (hit.Fuzzy)
                                            {
                                                <span>· @SimilarBadge</span>
                                            }
                                        </div>
                                    </div>
                                </button>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private string SearchText = string.Empty;
    private string MatchOperator = "smart";
    private SearchTypeFilter TypeFilter = SearchTypeFilter.All;
    private string CalcStatusFilter = string.Empty;
    private bool IncludeArchived = false;
    private DateTime? TenderQADate = null;
    private DateTime? TenderDeadlineDate = null;

    private bool IsLoading = false;
    private bool HasSearched = false;

    // Normalized search text, recomputed once per search for the scoring helpers.
    private string _ns = string.Empty;
    // Project candidates fetched from the server during the current search (reused by the fuzzy fallback).
    private List<SearchProjectsMVVM> _projectCandidates = [];

    private sealed record Hit<T>(int Score, bool Fuzzy, T Item);
    private sealed record CalcHit(int Score, bool Fuzzy, ListCalculationMVVM Calc, ListProjectMVVM Project, FolderMVVM Folder);

    private List<Hit<FolderMVVM>> FolderResults = [];
    private List<Hit<SearchProjectsMVVM>> ProjectResults = [];
    private List<CalcHit> CalcResults = [];

    private List<Hit<FolderMVVM>> FuzzyFolderResults = [];
    private List<Hit<SearchProjectsMVVM>> FuzzyProjectResults = [];
    private List<CalcHit> FuzzyCalcResults = [];

    // Score tiers: 100 = exact, 90 = starts-with, 85 = ends-with, 80 = contains, 1-70 = fuzzy.
    private const int ContainsScore = 80;

    [Parameter] public EventCallback CallBack { get; set; }

    private enum SearchTypeFilter { All, Folders, Projects, Calculations }

    private string SimilarBadge => CalcLoc[nameof(CalcResource.similarMatchBadge)];

    private string MatchOperatorHelp => MatchOperator switch
    {
        "%var%" => CalcLoc[nameof(CalcResource.matchContainsTip)],
        "==" => CalcLoc[nameof(CalcResource.matchEqualsTip)],
        "var%" => CalcLoc[nameof(CalcResource.matchStartsWithTip)],
        "%var" => CalcLoc[nameof(CalcResource.matchEndsWithTip)],
        "~" => CalcLoc[nameof(CalcResource.matchSimilarTip)],
        _ => CalcLoc[nameof(CalcResource.matchSmartTip)],
    };

    private IEnumerable<string> AvailableCalcStatuses =>
        (UoWService?.Folder?.State?.FoldersList ?? [])
            .SelectMany(f => f.Projects)
            .SelectMany(p => p.Calculations)
            .Select(c => c.Status)
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .Distinct()
            .OrderBy(s => s);

    private static string GetCalculationStatusColor(ListCalculationMVVM calculation)
        => string.IsNullOrWhiteSpace(calculation.StatusColor) ? "#0ea5e9" : calculation.StatusColor;

    private FolderMVVM? GetFolderForProject(SearchProjectsMVVM project)
        => (UoWService?.Folder?.State?.FoldersList ?? [])
            .FirstOrDefault(f => f.Id == project.FolderId);

    private async Task OnKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SearchAsync();
    }

    private async Task SearchAsync()
    {
        if (string.IsNullOrWhiteSpace(SearchText) && string.IsNullOrWhiteSpace(CalcStatusFilter)
            && TenderQADate == null && TenderDeadlineDate == null)
            return;

        IsLoading = true;
        HasSearched = true;
        StateHasChanged();

        try
        {
            FolderResults = [];
            ProjectResults = [];
            CalcResults = [];
            FuzzyFolderResults = [];
            FuzzyProjectResults = [];
            FuzzyCalcResults = [];
            _projectCandidates = [];

            // Normalize the search text once for all field comparisons.
            _ns = Normalize(SearchText);
            var hasText = _ns.Length > 0;

            var folders = UoWService?.Folder?.State?.FoldersList ?? [];

            // Folder search (client-side, name only — folders have no other text fields)
            if (TypeFilter is SearchTypeFilter.All or SearchTypeFilter.Folders)
                FolderResults = ScoreFolders(folders);

            // Project search (server provides candidates, scoring/fuzzy done client-side across all fields)
            if (TypeFilter is SearchTypeFilter.All or SearchTypeFilter.Projects)
                ProjectResults = await ScoreProjectsAsync(hasText);

            // Calculation search (client-side from loaded data)
            if (TypeFilter is SearchTypeFilter.All or SearchTypeFilter.Calculations)
                CalcResults = ScoreCalculations(folders, hasText);

            // Fuzzy fallback for the strict operators: only when nothing matched.
            // Smart and "Liknande stavning" already fold fuzzy hits into the main results.
            bool strict = MatchOperator is "%var%" or "==" or "var%" or "%var";
            if (strict && hasText &&
                FolderResults.Count == 0 && ProjectResults.Count == 0 && CalcResults.Count == 0)
            {
                if (TypeFilter is SearchTypeFilter.All or SearchTypeFilter.Folders)
                    FuzzyFolderResults = FuzzyFolders(folders);
                if (TypeFilter is SearchTypeFilter.All or SearchTypeFilter.Projects)
                    FuzzyProjectResults = FuzzyProjects(_projectCandidates);
                if (TypeFilter is SearchTypeFilter.All or SearchTypeFilter.Calculations)
                    FuzzyCalcResults = FuzzyCalcs(folders);
            }
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // ── Result builders ───────────────────────────────────────────────

    private List<Hit<FolderMVVM>> ScoreFolders(IEnumerable<FolderMVVM> folders)
    {
        if (_ns.Length == 0) return [];

        var hits = new List<Hit<FolderMVVM>>();
        foreach (var f in folders)
        {
            if (!IncludeArchived && !f.IsVisible) continue;
            var score = FieldScore(f.Name, MatchOperator);
            if (score > 0)
                hits.Add(new Hit<FolderMVVM>(score, IsFuzzy(score), f));
        }
        return hits.OrderByDescending(h => h.Score).ThenBy(h => h.Item.Name).ToList();
    }

    private async Task<List<Hit<SearchProjectsMVVM>>> ScoreProjectsAsync(bool hasText)
    {
        _projectCandidates = await FetchProjectCandidatesAsync();

        if (!hasText)
        {
            // No text – the server already applied the archive/date filters; show all candidates.
            return _projectCandidates
                .Select(p => new Hit<SearchProjectsMVVM>(0, false, p))
                .OrderBy(p => p.Item.Name)
                .ToList();
        }

        var hits = new List<Hit<SearchProjectsMVVM>>();
        foreach (var p in _projectCandidates)
        {
            var (score, fuzzy) = Evaluate(ProjectFields(p), MatchOperator);
            if (score > 0)
                hits.Add(new Hit<SearchProjectsMVVM>(score, fuzzy, p));
        }
        return hits.OrderByDescending(h => h.Score).ThenBy(h => h.Item.Name).ToList();
    }

    private async Task<List<SearchProjectsMVVM>> FetchProjectCandidatesAsync()
    {
        try
        {
            // Fetch all projects in scope (with archive/date filters); text matching is done
            // client-side so we can search every field and apply fuzzy matching.
            var filter = new ProjectFilter
            {
                Name = string.Empty,
                IsArchived = IncludeArchived ? null : false,
            };

            if (TenderDeadlineDate.HasValue)
                filter.EndDate1 = TenderDeadlineDate.Value;
            if (TenderQADate.HasValue)
                filter.StartDate1 = TenderQADate.Value;

            return await Repo.Project.FilterAsync(filter);
        }
        catch
        {
            return [];
        }
    }

    private List<CalcHit> ScoreCalculations(IEnumerable<FolderMVVM> folders, bool hasText)
    {
        var hasStatus = !string.IsNullOrWhiteSpace(CalcStatusFilter);
        if (!hasText && !hasStatus) return [];

        var hits = new List<CalcHit>();
        foreach (var folder in folders)
        {
            if (!IncludeArchived && !folder.IsVisible) continue;

            foreach (var project in folder.Projects)
            {
                if (!IncludeArchived && project.IsArchived) continue;
                if (!project.CalculationsLoaded) continue;

                foreach (var calc in project.Calculations)
                {
                    if (!IncludeArchived && calc.IsArchived) continue;

                    if (hasStatus && !string.Equals(calc.Status, CalcStatusFilter, StringComparison.OrdinalIgnoreCase))
                        continue;

                    int score = 0;
                    bool fuzzy = false;
                    if (hasText)
                    {
                        (score, fuzzy) = Evaluate(CalcFields(calc), MatchOperator);
                        if (score == 0) continue;
                    }

                    hits.Add(new CalcHit(score, fuzzy, calc, project, folder));
                }
            }
        }

        return hits.OrderByDescending(h => h.Score).ThenBy(h => h.Calc.Name).ToList();
    }

    // ── Fuzzy fallback builders (strict operators that found nothing) ──

    private List<Hit<FolderMVVM>> FuzzyFolders(IEnumerable<FolderMVVM> folders) =>
        folders
            .Where(f => IncludeArchived || f.IsVisible)
            .Select(f => new Hit<FolderMVVM>(FieldScore(f.Name, "~"), true, f))
            .Where(h => h.Score > 0)
            .OrderByDescending(h => h.Score)
            .Take(10)
            .ToList();

    private List<Hit<SearchProjectsMVVM>> FuzzyProjects(IEnumerable<SearchProjectsMVVM> candidates) =>
        candidates
            .Select(p => new Hit<SearchProjectsMVVM>(Evaluate(ProjectFields(p), "~").Score, true, p))
            .Where(h => h.Score > 0)
            .OrderByDescending(h => h.Score)
            .Take(10)
            .ToList();

    private List<CalcHit> FuzzyCalcs(IEnumerable<FolderMVVM> folders)
    {
        var results = new List<CalcHit>();
        foreach (var folder in folders)
        {
            if (!IncludeArchived && !folder.IsVisible) continue;
            foreach (var project in folder.Projects)
            {
                if (!IncludeArchived && project.IsArchived) continue;
                if (!project.CalculationsLoaded) continue;
                foreach (var calc in project.Calculations)
                {
                    if (!IncludeArchived && calc.IsArchived) continue;
                    var score = Evaluate(CalcFields(calc), "~").Score;
                    if (score > 0)
                        results.Add(new CalcHit(score, true, calc, project, folder));
                }
            }
        }
        return results.OrderByDescending(h => h.Score).Take(10).ToList();
    }

    private static IEnumerable<string?> ProjectFields(SearchProjectsMVVM p)
    {
        yield return p.Name;
        yield return p.Code;
        yield return p.Status;
        yield return p.Organisation;
        yield return p.ProcurementName;
        yield return p.ProcurementNumber;
        yield return p.CustomerReference;
        yield return p.AddressText;
        yield return p.Responsible;
    }

    private static IEnumerable<string?> CalcFields(ListCalculationMVVM c)
    {
        yield return c.Name;
        yield return c.Code;
        yield return c.Status;
    }

    // ── Matching logic ────────────────────────────────────────────────

    // Best score across all of an item's fields, plus whether the best hit was fuzzy.
    private (int Score, bool Fuzzy) Evaluate(IEnumerable<string?> fields, string op)
    {
        var best = 0;
        foreach (var f in fields)
        {
            var sc = FieldScore(f, op);
            if (sc > best) best = sc;
            if (best >= 100) break;
        }
        return (best, IsFuzzy(best));
    }

    // A hit is "fuzzy/similar" when it only matched via Levenshtein (below the contains tier).
    private static bool IsFuzzy(int score) => score > 0 && score < ContainsScore;

    private int FieldScore(string? value, string op)
    {
        var v = Normalize(value);
        if (v.Length == 0 || _ns.Length == 0) return 0;

        return op switch
        {
            "==" => v == _ns ? 100 : 0,
            "var%" => v.StartsWith(_ns, StringComparison.Ordinal) ? 90 : 0,
            "%var" => v.EndsWith(_ns, StringComparison.Ordinal) ? 85 : 0,
            "%var%" => v.Contains(_ns, StringComparison.Ordinal) ? ContainsScore : 0,
            // "~" (Liknande stavning) and "smart" both fold exact/contains/fuzzy together.
            _ => SmartScore(v),
        };
    }

    // Cheap tiers first (exact, starts-with, contains); fuzzy only when those fail.
    private int SmartScore(string v)
    {
        if (v == _ns) return 100;
        if (v.StartsWith(_ns, StringComparison.Ordinal)) return 90;
        if (v.Contains(_ns, StringComparison.Ordinal)) return ContainsScore;
        return FuzzyTier(v);
    }

    // Token-aware fuzzy: compare the search against the whole value and each word.
    private int FuzzyTier(string v)
    {
        var best = FuzzyPair(v, _ns);
        if (v.IndexOf(' ') >= 0)
        {
            foreach (var token in v.Split(' ', StringSplitOptions.RemoveEmptyEntries))
            {
                var sc = FuzzyPair(token, _ns);
                if (sc > best) best = sc;
            }
        }
        return best;
    }

    private static int FuzzyPair(string a, string b)
    {
        if (a.Length == 0 || b.Length == 0) return 0;

        var distance = LevenshteinDistance(a, b);
        var maxLen = Math.Max(a.Length, b.Length);
        if (distance > MaxFuzzyDistance(maxLen)) return 0;

        var similarity = 1.0 - (double)distance / maxLen;
        return (int)(similarity * 70);
    }

    // Relative tolerance: short words allow ~1 error, longer words ~2-3.
    private static int MaxFuzzyDistance(int length)
        => length <= 4 ? 1 : length <= 8 ? 2 : 3;

    private static readonly System.Text.RegularExpressions.Regex SeparatorRegex =
        new(@"[\s\-_/\\.,;:()\[\]{}]+", System.Text.RegularExpressions.RegexOptions.Compiled);

    // Trim, lower-case, collapse whitespace, and treat hyphens/punctuation as separators.
    // Swedish characters (å/ä/ö) are preserved so normal Swedish search keeps working.
    private static string Normalize(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return string.Empty;
        var lowered = value.Trim().ToLowerInvariant();
        return SeparatorRegex.Replace(lowered, " ").Trim();
    }

    private static int LevenshteinDistance(string s, string t)
    {
        if (s.Length == 0) return t.Length;
        if (t.Length == 0) return s.Length;

        var d = new int[s.Length + 1, t.Length + 1];
        for (var i = 0; i <= s.Length; i++) d[i, 0] = i;
        for (var j = 0; j <= t.Length; j++) d[0, j] = j;

        for (var i = 1; i <= s.Length; i++)
            for (var j = 1; j <= t.Length; j++)
                d[i, j] = Math.Min(
                    Math.Min(d[i - 1, j] + 1, d[i, j - 1] + 1),
                    d[i - 1, j - 1] + (s[i - 1] == t[j - 1] ? 0 : 1));

        return d[s.Length, t.Length];
    }

    // ── Navigation ────────────────────────────────────────────────────

    private async Task FolderSelected(FolderMVVM folder)
    {
        await Folder.NewFolder(folder);
        await Modal.CloseAsync();
    }

    private async Task ProjectSelected(SearchProjectsMVVM pro)
    {
        var folder = UoWService?.Folder?.State?.FoldersList?.FirstOrDefault(x => x.Id == pro.FolderId);
        if (folder == null) return;

        var projectMvvm = new ListProjectMVVM();
        PropertyCopier.CopyPropertiesTo(pro, projectMvvm);
        await Folder.NewFolder(folder);
        await Folder.NewProject(projectMvvm);
        await Modal.CloseAsync();
    }

    private async Task CalcSelected(ListCalculationMVVM calc, ListProjectMVVM project, FolderMVVM folder)
    {
        await Folder.NewFolder(folder);
        await Folder.NewProject(project);
        await Modal.CloseAsync();
    }
}
