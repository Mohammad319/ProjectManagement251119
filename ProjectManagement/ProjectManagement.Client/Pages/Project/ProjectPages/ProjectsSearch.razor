@using ProjectManagement.Client.Services.Folder
@using ProjectManagement.Client.Shared.MVVM.Folder;
@using ProjectManagement.Client.Shared.Repositories.Organisation
@using ProjectManagement.Shared.DTO.App.List
@using ProjectManagement.Shared.DTO.Organisation
@using ProjectManagement.Shared.DTO.Project;
@using ProjectManagement.Client.Shared.Model.Project
@inherits AppComponentBase
@using ProjectManagement.Shared.Enums

<style>
    .maxWidth {
    max-width: 200px;
    }
</style>
<div class="@CssClasses.Modal.Body">
    <EditForm id="myForm" Model="@projectFilter" OnValidSubmit="async () => await HandleSubmitAsync()">
        <DataAnnotationsValidator />
        <div class="@CssClasses.Grid.Col.MD4">
            <div class="@CssClasses.Grid.Span.MD2">
                <label class="@CssClasses.Form.Label">@CalcResource.name</label>
                <InputText class="@CssClasses.Input.Text" @bind-Value="@projectFilter.Name" />
                <ValidationMessage For="(() => projectFilter.Name)" />
            </div>
            @if (DetailsDiv)
            {
                <div>
                    <label class="@CssClasses.Form.Label"></label>
                    <InputSelect @bind-Value="projectFilter.NameOperator" class="@CssClasses.Input.Text">
                        <option value="%var%" selected>%Var%</option>
                        <option value="==">==</option>
                        <option value="!=">!=</option>
                        <option value="%var">%Var</option>
                        <option value="var%">Var%</option>
                    </InputSelect>
                    <ValidationMessage For="(() => projectFilter.NameOperator)" />
                </div>
                <div>
                    <label class="@CssClasses.Form.Label">@CalcResource.startDate 1: </label>
                    <InputDate class="@CssClasses.Input.Text" @bind-Value="@projectFilter.StartDate1"></InputDate>
                    <ValidationMessage For="@(() => projectFilter.StartDate1)" />
                </div>
                <div>
                    <label class="@CssClasses.Form.Label">@CalcResource.startDate 2: </label>
                    <InputDate class="@CssClasses.Input.Text" @bind-Value="@projectFilter.StartDate2"></InputDate>
                    <ValidationMessage For="@(() => projectFilter.StartDate2)" />
                </div>

                <div>
                    <label class="@CssClasses.Form.Label">@CalcResource.endDate 1</label>
                    <InputDate class="@CssClasses.Input.Text" @bind-Value="@projectFilter.EndDate1"></InputDate>
                    <ValidationMessage For="@(() => projectFilter.EndDate1)" />
                </div>
                <div>
                    <label class="@CssClasses.Form.Label">@CalcResource.endDate 2</label>
                    <InputDate class="@CssClasses.Input.Text" @bind-Value="@projectFilter.EndDate2"></InputDate>
                    <ValidationMessage For="@(() => projectFilter.EndDate2)" />
                </div>
                <div>
                    <label class="@CssClasses.Form.Label">@CalcResource.code</label>
                    <InputText class="@CssClasses.Input.Text" @bind-Value="@projectFilter.Code" />
                    <ValidationMessage For="@(() => projectFilter.Code)" />
                </div>
                <div>
                    <label class="@CssClasses.Form.Label">@CalcResource.status</label>
                    <InputSelect @bind-Value="projectFilter.StatusId" class="@CssClasses.Input.Text">
                        <option selected></option>
                        @if (Statuses != null)
                        {
                            foreach (var status in Statuses)
                            {
                                <option value="@status.Id">@status.Name</option>
                            }
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => projectFilter.StatusId)" />
                </div>
                <div>
                    <label class="@CssClasses.Form.Label">@ResourceIdentity.customer</label>
                    <InputSelect @bind-Value="projectFilter.CustomerId" class="@CssClasses.Input.Text">
                        @if (Customers != null) foreach (var customer in Customers)
                            {
                                <option value="@customer.Id">@customer.Name</option>
                            }}
                    </InputSelect>
                    <ValidationMessage For="@(() => projectFilter.CustomerId)" />
                </div>
                    <div class="@CssClasses.Form.CheckWrapperM">
                        <InputCheckbox class="@CssClasses.Input.Check" @bind-Value="@projectFilter.IsVisible" />
                        <label class="@CssClasses.Form.Label">@ResourceApp.isVisible</label>
                    </div>
            }
            <div>
                <button type="submit" form="myForm" class="@CssClasses.Btn.Solid.Primary" disabled="@IsLoading"><span>@((MarkupString)Icons.Search)</span></button>
                <button class="@CssClasses.Btn.Solid.Primary" disabled="@IsLoading" @onclick="() => DetailsDiv = !DetailsDiv"> <span class="oi @(DetailsDiv?"oi-arrow-top":"oi-arrow-bottom") "></span> </button>
                <button class="@CssClasses.Btn.Solid.Danger" disabled="@IsLoading" @onclick="async () => await CallBack.InvokeAsync()">@ResourceApp.cancel</button>
            </div>
        </div>
    </EditForm>

    <table class ="@CssClasses.Table.Tab">
        <thead class="@CssClasses.Table.Thead">
            <tr>
                <th class="@CssClasses.Table.TH">@CalcResource.name</th>
                <th class="@CssClasses.Table.TH">@CalcResource.code</th>
                <th class="@CssClasses.Table.TH">@CalcResource.startDate</th>
                <th class="@CssClasses.Table.TH">@CalcResource.endDate</th>
            </tr>
        </thead>
        <tbody class="@CssClasses.Table.TBody">
            @if (projects != null)
                foreach (var project in projects)
                {
                    <tr>
                        <td scope="row">
                            <button class="@CssClasses.Btn.Link" @onclick="async ()=> await ProjectSelected(project)" disabled="@IsLoading">@project.Name</button>
                        </td>
                        <td>@project.Code</td>
                        <td>@project.StartDate.ToString(ConstValues.DateFormat)</td>
                        <td>@project.EndDate.ToString(ConstValues.DateFormat)</td>
                    </tr>
                }
        </tbody>
    </table>
</div>

@code {
    ProjectFilter projectFilter = new ProjectFilter();
    List<ListOrderDTO>? Statuses;
    List<ListDTO>? Customers;
    List<SearchProjectsMVVM>? projects;
    bool DetailsDiv = false;
    bool IsLoading = true;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback CallBack { get; set; }
    async Task HandleSubmitAsync()
    {
        projects = await Repo.Project.FilterAsync(projectFilter);
        IsLoading = false;
    }


    async Task ProjectSelected(SearchProjectsMVVM pro)
    {
        ListProjectMVVM o = new();
        FolderMVVM? folder = new();
        folder = UoWService?.Folder?.State?.FoldersList?.FirstOrDefault(x => x.Id == pro.FolderId);
        if (folder == null || pro == null)
        {
            return;
        }
        PropertyCopier.CopyPropertiesTo(pro, o);
        await Folder.NewFolder(folder);
        await Folder.NewProject(o);

        //UoWService.Folder.FoldersRefresh();
        Modal.Close();
    }
    protected async override Task OnInitializedAsync()
    {
        IsLoading = true;
        @* Statuses = await Repo.Status.GetLocalAsync(); *@
        Customers = await Repo.Org.GetVisibleOrIdAsync();
        IsLoading = false;
    }
}
