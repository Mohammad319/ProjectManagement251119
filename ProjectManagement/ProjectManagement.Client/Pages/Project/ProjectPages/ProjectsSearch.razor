@using ProjectManagement.Client.Services.Folder
@using ProjectManagement.Client.Shared.MVVM.Folder;
@using ProjectManagement.Client.Shared.Repositories.Organisation
@using ProjectManagement.Shared.DTO.App.List
@using ProjectManagement.Shared.DTO.Organisation
@using ProjectManagement.Shared.DTO.Project;
@using ProjectManagement.Client.Shared.Model.Project
@inherits AppComponentBase
@using ProjectManagement.Shared.Enums

<div class="space-y-0 flex flex-col gap-4">
    <EditForm id="myForm" Model="@projectFilter" OnValidSubmit="async () => await HandleSubmitAsync()" class="rounded-xl border border-slate-200 bg-slate-50 p-4">
        <DataAnnotationsValidator />

        <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
            <h5 class="m-0 text-lg font-bold">Projects Search</h5>
            <button class="px-2 py-1 bg-blue-600 text-white rounded hover:bg-blue-700 dark:bg-blue-500 inline-flex items-center gap-2" type="button" disabled="@IsLoading" @onclick="() => DetailsDiv = !DetailsDiv">
                <span class="oi @(DetailsDiv ? "oi-arrow-top" : "oi-arrow-bottom")"></span>
                <span>@(DetailsDiv ? "Hide details" : "Show details")</span>
            </button>
        </div>

        <div class="grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-4">
            <div class="min-w-0 md:col-span-2 xl:col-span-4">
                <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.name</label>
                <InputText class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" @bind-Value="@projectFilter.Name" />
                <ValidationMessage For="(() => projectFilter.Name)" />
            </div>

            @if (DetailsDiv)
            {
                <div class="min-w-0">
                    <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.name</label>
                    <InputSelect @bind-Value="projectFilter.NameOperator" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white">
                        <option value="%var%" selected>%Var%</option>
                        <option value="==">==</option>
                        <option value="!=">!=</option>
                        <option value="%var">%Var</option>
                        <option value="var%">Var%</option>
                    </InputSelect>
                    <ValidationMessage For="(() => projectFilter.NameOperator)" />
                </div>

                <div class="min-w-0">
                    <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.startDate 1</label>
                    <InputDate class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" @bind-Value="@projectFilter.StartDate1"></InputDate>
                    <ValidationMessage For="@(() => projectFilter.StartDate1)" />
                </div>

                <div class="min-w-0">
                    <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.startDate 2</label>
                    <InputDate class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" @bind-Value="@projectFilter.StartDate2"></InputDate>
                    <ValidationMessage For="@(() => projectFilter.StartDate2)" />
                </div>

                <div class="min-w-0">
                    <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.endDate 1</label>
                    <InputDate class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" @bind-Value="@projectFilter.EndDate1"></InputDate>
                    <ValidationMessage For="@(() => projectFilter.EndDate1)" />
                </div>

                <div class="min-w-0">
                    <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.endDate 2</label>
                    <InputDate class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" @bind-Value="@projectFilter.EndDate2"></InputDate>
                    <ValidationMessage For="@(() => projectFilter.EndDate2)" />
                </div>

                <div class="min-w-0">
                    <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.code</label>
                    <InputText class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" @bind-Value="@projectFilter.Code" />
                    <ValidationMessage For="@(() => projectFilter.Code)" />
                </div>

                <div class="min-w-0">
                    <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@ResourceIdentity.customer</label>
                    <InputSelect @bind-Value="projectFilter.CustomerId" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white">
                        <option></option>
                        @if (Customers != null)
                        {
                            foreach (var customer in Customers)
                            {
                                <option value="@customer.Id">@customer.Name</option>
                            }
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => projectFilter.CustomerId)" />
                </div>

                <div class="flex items-center gap-2 mt-1 md:mt-6 flex items-center gap-2 pt-7">
                    <InputCheckbox class="h-4 w-4 text-blue-600 rounded focus:ring-blue-500 dark:text-blue-400" @bind-Value="@projectFilter.IsVisible" />
                    <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@ResourceApp.isVisible</label>
                </div>
            }
        </div>

        <div class="mt-4 flex flex-wrap gap-2">
            <button type="submit" form="myForm" class="px-2 py-1 bg-blue-600 text-white rounded hover:bg-blue-700 dark:bg-blue-500" disabled="@IsLoading"><span>@((MarkupString)Icons.Search)</span> Search</button>
            <button class="px-2 py-1 bg-red-600 text-white rounded hover:bg-red-700 dark:bg-red-500" type="button" disabled="@IsLoading" @onclick="async () => await CallBack.InvokeAsync()">@ResourceApp.cancel</button>
        </div>
    </EditForm>

    <div class="overflow-auto rounded-xl border border-slate-200 bg-white">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-600">
            <thead class="bg-gray-100 dark:bg-gray-700">
                <tr>
                    <th class="p-1 text-left text-sm font-semibold">@CalcResource.name</th>
                    <th class="p-1 text-left text-sm font-semibold">@CalcResource.code</th>
                    <th class="p-1 text-left text-sm font-semibold">@CalcResource.startDate</th>
                    <th class="p-1 text-left text-sm font-semibold">@CalcResource.endDate</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 hover:divide-gray-200 dark:divide-gray-700">
                @if (projects != null)
                    foreach (var project in projects)
                    {
                        <tr>
                            <td scope="row">
                                <button class="text-[18px] text-neutral-800 underline hover:text-neutral-900 transition dark:text-neutral-300 dark:hover:text-neutral-100" @onclick="async ()=> await ProjectSelected(project)" disabled="@IsLoading">@project.Name</button>
                            </td>
                            <td>@project.Code</td>
                            <td>@project.StartDate.ToString(ConstValues.DateFormat)</td>
                            <td>@project.EndDate.ToString(ConstValues.DateFormat)</td>
                        </tr>
                    }
            </tbody>
        </table>
    </div>
</div>

@code {
    ProjectFilter projectFilter = new ProjectFilter();
    List<ListDTO>? Customers;
    List<SearchProjectsMVVM>? projects;
    bool DetailsDiv = false;
    bool IsLoading = true;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback CallBack { get; set; }
    async Task HandleSubmitAsync()
    {
        projects = await Repo.Project.FilterAsync(projectFilter);
        IsLoading = false;
    }


    async Task ProjectSelected(SearchProjectsMVVM pro)
    {
        ListProjectMVVM o = new();
        FolderMVVM? folder = new();
        folder = UoWService?.Folder?.State?.FoldersList?.FirstOrDefault(x => x.Id == pro.FolderId);
        if (folder == null || pro == null)
        {
            return;
        }
        PropertyCopier.CopyPropertiesTo(pro, o);
        await Folder.NewFolder(folder);
        await Folder.NewProject(o);

        //UoWService.Folder.FoldersRefresh();
        Modal.Close();
    }
    protected async override Task OnInitializedAsync()
    {
        IsLoading = true;
        Customers = await Repo.Org.GetVisibleOrIdAsync();
        IsLoading = false;
    }
}
