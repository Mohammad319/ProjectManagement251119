@using ProjectManagement.Shared.DTO.Transfer
@using Microsoft.AspNetCore.Authorization
@inherits AppComponentBase
@attribute [Authorize(Roles = PMRolesConst.Tenant.Users)]
@inject IJSRuntime JS

<div class="space-y-4 text-slate-800 dark:text-slate-100">

    <div class="rounded-lg border border-slate-200 bg-slate-50 p-3 text-sm dark:border-slate-800 dark:bg-slate-950">
        <div class="font-semibold">@CalcName</div>
        <div class="mt-1 text-xs text-slate-500 dark:text-slate-400">
            @CalcTypeLabel · Version @VersionNumber.ToString("D2")
        </div>
    </div>

    @if (IsPrivate)
    {
        <div class="rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-800 dark:border-amber-900/60 dark:bg-amber-950/30 dark:text-amber-200">
            Kalkylen är privat och kan inte exporteras som extern kopia. Gör kalkylen delad först om den ska kunna exporteras.
        </div>
    }
    else
    {
        <div>
            <label class="mb-1 block text-xs font-medium text-slate-600 dark:text-slate-300">Meddelande till mottagare</label>
            <textarea rows="3"
                      class="w-full rounded-lg border border-slate-300 bg-white px-2 py-1.5 text-sm outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500/30 dark:border-slate-600 dark:bg-slate-950 dark:text-slate-100"
                      placeholder="Skriv ett meddelande som följer med kopian..."
                      @bind="_message"></textarea>
        </div>
    }

    <div class="flex items-center justify-end gap-2">
        <button type="button"
                class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200"
                @onclick="Modal.CloseAsync">Avbryt</button>
        <button type="button"
                class="inline-flex items-center gap-1.5 rounded-lg bg-sky-600 px-3 py-1.5 text-sm font-semibold text-white transition hover:bg-sky-700 disabled:cursor-not-allowed disabled:opacity-50"
                disabled="@(IsPrivate || _busy)"
                @onclick="DownloadAsync">
            Ladda ner kopia
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public int CalcId { get; set; }
    [Parameter] public string CalcName { get; set; } = string.Empty;
    [Parameter] public string CalcTypeLabel { get; set; } = string.Empty;
    [Parameter] public int VersionNumber { get; set; } = 1;
    [Parameter] public bool IsPrivate { get; set; }

    private string _message = string.Empty;
    private bool _busy;

    private async Task DownloadAsync()
    {
        if (_busy || IsPrivate) return;
        _busy = true;
        try
        {
            var request = new AtacostCalculationExportRequest
            {
                Message = string.IsNullOrWhiteSpace(_message) ? null : _message.Trim()
            };

            var bytes = await Repo.Calculation.ExportCopyAsync(CalcId, request);
            if (bytes is null || bytes.Length == 0)
            {
                MHD.Notifications(ToastType.Add, false);
                return;
            }

            var fileName = $"ATACOST_Kalkyl_{SafeName(CalcName)}_{DateTime.Now:yyyy-MM-dd}.atacost";
            await JS.InvokeVoidAsync("atacostTransfer.download", fileName, Convert.ToBase64String(bytes));

            MHD.Notifications(ToastType.Add, true);
            await Modal.CloseAsync();
        }
        catch (Exception ex)
        {
            await ClientLog.ErrorAsync("Calculation copy export failed", ex: ex);
            MHD.Notifications(ToastType.Add, false);
        }
        finally
        {
            _busy = false;
        }
    }

    private static string SafeName(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "kalkyl";
        var cleaned = new string(name.Where(ch => !Path.GetInvalidFileNameChars().Contains(ch) && ch != ' ').ToArray());
        return string.IsNullOrWhiteSpace(cleaned) ? "kalkyl" : cleaned;
    }
}
