@using ProjectManagement.Client.Shared.MVVM.Calculation
@using ProjectManagement.Shared.DTO.General
@using ProjectManagement.Shared.DTO.Project
@using ProjectManagement.Shared.Helper
@using ProjectManagement.Shared.Models.Account
@using Microsoft.AspNetCore.Authorization
@inherits AppComponentBase
@attribute [Authorize(Roles = PMRolesConst.Tenant.AdminManger)]

<div class="flex max-h-[calc(100dvh-9rem)] flex-col text-slate-800 dark:text-slate-100">

    @* ── Sticky topp: projektinfo ligger kvar vid scroll ──────────────── *@
    <div class="shrink-0 border-b border-slate-200 pb-2 dark:border-slate-700">
        <div class="truncate text-sm text-slate-600 dark:text-slate-300" title="@ProjectName">
            <span class="font-semibold text-slate-800 dark:text-slate-100">Projekt:</span> @ProjectName
        </div>
    </div>

    @if (_loadFailed)
    {
        @* Hela dialogen kunde inte laddas – visa lokalt fel i stället för det globala felet. *@
        <div class="mt-3 rounded-lg border border-rose-200 bg-rose-50 px-3 py-3 text-sm text-rose-700 dark:border-rose-900/70 dark:bg-rose-950/40 dark:text-rose-300">
            <div class="font-semibold">Delning och behörighet kunde inte laddas. Försök igen.</div>
            <button type="button"
                    class="mt-2 inline-flex items-center rounded border border-rose-300 bg-white px-2.5 py-1 text-xs font-semibold text-rose-700 hover:bg-rose-100 dark:border-rose-800 dark:bg-rose-950 dark:text-rose-200"
                    @onclick="ReloadAllAsync">Försök igen</button>
        </div>
    }
    else
    {
    <div class="min-h-0 flex-1 space-y-3 overflow-y-auto pt-3 pr-0.5">

        @* ── Åtkomstöversikt (hopfällbar – kompakt som standard) ────────── *@
        <div class="rounded-lg border border-slate-200 bg-white px-3 py-2 dark:border-slate-700 dark:bg-slate-950">
            <button type="button"
                    class="flex w-full items-center justify-between gap-2 text-left"
                    aria-expanded="@_overviewOpen"
                    @onclick="() => _overviewOpen = !_overviewOpen">
                <span class="shrink-0 text-[11px] font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Åtkomstöversikt</span>
                <span class="flex min-w-0 items-center gap-2">
                    @if (!_overviewOpen)
                    {
                        <span class="truncate text-[11px] text-slate-400">@OverviewSummary()</span>
                    }
                    <svg class="h-3 w-3 shrink-0 text-slate-400 transition-transform @(_overviewOpen ? "rotate-180" : "")" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                    </svg>
                </span>
            </button>
            @if (_overviewOpen)
            {
                <div class="mt-2 space-y-2.5 border-t border-slate-100 pt-2 text-sm dark:border-slate-800">

                    @if (_overviewPartial)
                    {
                        <div class="rounded border border-amber-200 bg-amber-50 px-2 py-1.5 text-[11px] text-amber-700 dark:border-amber-900/60 dark:bg-amber-950/30 dark:text-amber-300">
                            Åtkomstöversikten kunde inte laddas helt. Vissa avdelningar visas som blandad åtkomst.
                        </div>
                    }

                    @* Ägare / ansvariga *@
                    @if (HasOwnerResponsible)
                    {
                        <div>
                            <div class="mb-0.5 text-[11px] font-semibold text-slate-600 dark:text-slate-300">Ägare / ansvariga</div>
                            <div class="text-slate-600 dark:text-slate-300">@ProjectResponsible · Projektansvarig</div>
                        </div>
                    }

                    @* Avdelningsåtkomst (projektets egen avdelning) *@
                    <div>
                        <div class="mb-0.5 text-[11px] font-semibold text-slate-600 dark:text-slate-300">Avdelningsåtkomst</div>
                        @if (ProjectDepartmentId is int ownDeptId && ProjectDepartmentName is { } depName)
                        {
                            <div class="text-slate-600 dark:text-slate-300">@DeptAccessLine(depName, ownDeptId, null, "Alla tillgängliga kalkyler")</div>
                        }
                        else
                        {
                            <div class="text-slate-400">Projektet saknar avdelning.</div>
                        }
                    </div>

                    @* Delade personer (grupperade efter åtkomstnivå) *@
                    @{ var userShares = _shares.Where(s => IsShareActive(s) && s.RecipientType == ProjectShareRecipientType.User).ToList(); }
                    @if (userShares.Count > 0)
                    {
                        <div>
                            <div class="mb-0.5 text-[11px] font-semibold text-slate-600 dark:text-slate-300">Delade personer</div>
                            @{
                                var canEdit = userShares.Where(s => s.Role == PMRolesConst.Tenant.Manger).ToList();
                                var canView = userShares.Where(s => s.Role != PMRolesConst.Tenant.Manger).ToList();
                            }
                            @if (canEdit.Count > 0)
                            {
                                <div class="ml-1 mt-0.5 text-[10px] font-semibold uppercase tracking-wide text-slate-400">Kan ändra</div>
                                @foreach (var s in canEdit)
                                {
                                    <div class="ml-2 text-slate-600 dark:text-slate-300" title="@CalcNamesTooltip(s)">@s.RecipientName · @OverviewCalcText(s)</div>
                                }
                            }
                            @if (canView.Count > 0)
                            {
                                <div class="ml-1 mt-0.5 text-[10px] font-semibold uppercase tracking-wide text-slate-400">Kan visa</div>
                                @foreach (var s in canView)
                                {
                                    <div class="ml-2 text-slate-600 dark:text-slate-300" title="@CalcNamesTooltip(s)">@s.RecipientName · @OverviewCalcText(s)</div>
                                }
                            }
                        </div>
                    }

                    @* Delade avdelningar *@
                    @{ var deptShares = _shares.Where(s => IsShareActive(s) && s.RecipientType == ProjectShareRecipientType.Department).ToList(); }
                    @if (deptShares.Count > 0)
                    {
                        <div>
                            <div class="mb-0.5 text-[11px] font-semibold text-slate-600 dark:text-slate-300">Delade avdelningar</div>
                            @foreach (var s in deptShares)
                            {
                                <div class="text-slate-600 dark:text-slate-300" title="@CalcNamesTooltip(s)">@DeptAccessLine(s.RecipientName, s.DepartmentId, s.Role, OverviewCalcText(s))</div>
                            }
                        </div>
                    }

                    @if (userShares.Count == 0 && deptShares.Count == 0)
                    {
                        <div class="text-[11px] text-slate-400">Ingen extra delning – projektet är bara tillgängligt via avdelningsåtkomst.</div>
                    }
                </div>
            }
        </div>

        @* ── Delat med (visas FÖRE formuläret "Dela med") ──────────────── *@
        <div>
            <div class="mb-1 text-[11px] font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Delat med</div>
            @if (_shares.Count == 0)
            {
                <p class="rounded border border-dashed border-slate-300 px-2 py-3 text-center text-xs text-slate-400 dark:border-slate-700">
                    Projektet är inte delat med någon ännu.
                </p>
            }
            else
            {
                <div class="overflow-x-auto rounded-lg border border-slate-200 dark:border-slate-700">
                    <table class="min-w-full divide-y divide-slate-200 text-sm dark:divide-slate-700">
                        <thead class="bg-slate-100 dark:bg-slate-800">
                            <tr>
                                <th class="px-2 py-1.5 text-left font-medium text-slate-700 dark:text-slate-200">Mottagare</th>
                                <th class="px-2 py-1.5 text-left font-medium text-slate-700 dark:text-slate-200">Mottagartyp</th>
                                <th class="px-2 py-1.5 text-left font-medium text-slate-700 dark:text-slate-200">Åtkomstnivå</th>
                                <th class="px-2 py-1.5 text-left font-medium text-slate-700 dark:text-slate-200">Kalkyler</th>
                                <th class="px-2 py-1.5 text-left font-medium text-slate-700 dark:text-slate-200">Giltighet</th>
                                <th class="px-2 py-1.5 text-right font-medium text-slate-700 dark:text-slate-200">Åtgärder</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                            @foreach (var s in _shares)
                            {
                                var share = s;
                                <tr class="align-top hover:bg-slate-50 dark:hover:bg-slate-800/60">
                                    <td class="px-2 py-1.5 text-slate-800 dark:text-slate-200">@share.RecipientName</td>
                                    <td class="px-2 py-1.5 text-slate-500 dark:text-slate-400">@(share.RecipientType == ProjectShareRecipientType.User ? "Person" : "Avdelning")</td>
                                    <td class="px-2 py-1.5 text-slate-500 dark:text-slate-400">@AccessLevelLabel(share.Role)</td>
                                    <td class="px-2 py-1.5 text-slate-600 dark:text-slate-300">
                                        @if (ShowCalcExpander(share))
                                        {
                                            <div class="flex items-center gap-1.5">
                                                <span>@share.CalculationIds.Count kalkyler</span>
                                                <button type="button"
                                                        class="text-[11px] font-semibold text-sky-700 hover:text-sky-900 dark:text-sky-300"
                                                        @onclick="() => ToggleCalcExpand(share.Id)">
                                                    @(_expandedCalcShareId == share.Id ? "Dölj" : "Visa")
                                                </button>
                                            </div>
                                            @if (_expandedCalcShareId == share.Id)
                                            {
                                                <ul class="mt-1 space-y-0.5">
                                                    @foreach (var name in CalcNames(share))
                                                    {
                                                        <li class="text-[11px] text-slate-500 dark:text-slate-400">@name</li>
                                                    }
                                                </ul>
                                            }
                                        }
                                        else
                                        {
                                            <span title="@CalcNamesTooltip(share)">@CalcSummary(share)</span>
                                        }
                                    </td>
                                    <td class="px-2 py-1.5 text-slate-500 dark:text-slate-400">
                                        @if (IsShareExpired(share))
                                        {
                                            <span class="inline-flex rounded-full bg-amber-100 px-2 py-0.5 text-[10px] font-semibold text-amber-700 dark:bg-amber-950/50 dark:text-amber-300">Utgången</span>
                                        }
                                        else
                                        {
                                            <span>@ValidityText(share)</span>
                                        }
                                    </td>
                                    <td class="px-2 py-1.5">
                                        <div class="flex items-center justify-end gap-1">
                                            <button type="button"
                                                    class="inline-flex h-7 items-center rounded border border-sky-600 px-2 text-xs text-sky-600 transition hover:bg-sky-600 hover:text-white dark:border-sky-400 dark:text-sky-300"
                                                    @onclick="() => EditShareAsync(share)">Ändra</button>
                                            <button type="button"
                                                    class="inline-flex h-7 items-center rounded border border-red-600 px-2 text-xs text-red-600 transition hover:bg-red-600 hover:text-white dark:border-red-400 dark:text-red-300"
                                                    @onclick="() => RemoveAsync(share)">Ta bort</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        @* ── Dela med / Ändra delning (tvåkolumnslayout på bred skärm) ──── *@
        <div class="rounded-lg border border-slate-200 bg-slate-50 p-3 dark:border-slate-700 dark:bg-slate-900/60">
            <div class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
                @(_editingId.HasValue ? "Ändra delning" : "Dela med")
            </div>

            <div class="grid gap-4 md:grid-cols-2">

                @* ── VÄNSTER: mottagare ──────────────────────────────────── *@
                <div class="space-y-3">

                    @* Mottagartyp *@
                    <div>
                        <label class="mb-1 block text-xs font-medium text-slate-600 dark:text-slate-300">Mottagartyp</label>
                        <div class="inline-flex overflow-hidden rounded-lg border border-slate-300 dark:border-slate-600">
                            <button type="button"
                                    disabled="@_editingId.HasValue"
                                    class="@RecipientTabClass(ProjectShareRecipientType.User)"
                                    @onclick="() => SetRecipientType(ProjectShareRecipientType.User)">Person</button>
                            <button type="button"
                                    disabled="@_editingId.HasValue"
                                    class="@RecipientTabClass(ProjectShareRecipientType.Department)"
                                    @onclick="() => SetRecipientType(ProjectShareRecipientType.Department)">Avdelning</button>
                        </div>
                    </div>

                    @if (_recipientType == ProjectShareRecipientType.User)
                    {
                        @if (_editingId.HasValue)
                        {
                            @* Vid ändring är mottagaren låst – endast åtkomstnivå/kalkyler ändras. *@
                            <div>
                                <label class="mb-1 block text-xs font-medium text-slate-600 dark:text-slate-300">Person</label>
                                <div class="rounded-lg border border-slate-300 bg-slate-100 px-2 py-1.5 text-sm text-slate-700 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200">
                                    @EditingRecipientName
                                </div>
                            </div>
                        }
                        else
                        {
                            <div>
                                <label class="mb-1 block text-xs font-medium text-slate-600 dark:text-slate-300">Filtrera personer efter avdelning</label>
                                <select class="w-full rounded-lg border border-slate-300 bg-white px-2 py-1.5 text-sm dark:border-slate-600 dark:bg-slate-950 dark:text-slate-100"
                                        value="@_userFilterDeptId" @onchange="OnUserFilterChanged">
                                    <option value="0">Alla avdelningar</option>
                                    @foreach (var d in _departments)
                                    {
                                        <option value="@d.Id">@d.Name</option>
                                    }
                                    <option value="-1">Utan avdelning</option>
                                </select>
                            </div>
                            <div>
                                <div class="mb-1 flex items-center justify-between gap-2">
                                    <label class="text-xs font-medium text-slate-600 dark:text-slate-300">Personer</label>
                                    @if (_selectedUserIds.Count > 0)
                                    {
                                        <span class="text-[10px] font-semibold text-sky-700 dark:text-sky-300">Valda personer (@_selectedUserIds.Count)</span>
                                    }
                                </div>
                                @if (_userOptions.Count == 0)
                                {
                                    <p class="rounded border border-dashed border-slate-300 px-2 py-2 text-center text-[11px] text-slate-400 dark:border-slate-700">
                                        Inga personer i urvalet.
                                    </p>
                                }
                                else
                                {
                                    <div class="max-h-40 space-y-0.5 overflow-y-auto rounded border border-slate-300 bg-white p-1 dark:border-slate-600 dark:bg-slate-950">
                                        @foreach (var u in _userOptions)
                                        {
                                            var user = u;
                                            var blockedAsViewer = _role == PMRolesConst.Tenant.Manger && user.IsViewer;
                                            var disabled = user.AlreadyDirect || blockedAsViewer;
                                            var tip = user.AlreadyDirect ? user.AccessNote
                                                : blockedAsViewer ? "Personen har systemrollen Visare och kan bara få åtkomstnivån Kan visa."
                                                : user.AccessNote;
                                            <label class="flex items-center gap-2 rounded px-1.5 py-1 text-sm @(disabled ? "opacity-50" : "hover:bg-slate-50 dark:hover:bg-slate-800")"
                                                   title="@tip">
                                                <input type="checkbox"
                                                       class="h-4 w-4 rounded border-slate-300 text-sky-600 focus:ring-sky-500 disabled:cursor-not-allowed dark:border-slate-600 dark:bg-slate-800"
                                                       checked="@_selectedUserIds.Contains(user.Id)"
                                                       disabled="@disabled"
                                                       @onchange="e => ToggleUser(user.Id, e.Value is bool b && b)" />
                                                <span class="min-w-0 flex-1 truncate text-slate-700 dark:text-slate-200">@user.Name</span>
                                                @if (user.IsViewer)
                                                {
                                                    <span class="shrink-0 cursor-help rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-semibold text-slate-500 dark:bg-slate-800 dark:text-slate-400"
                                                          title="Personen har systemrollen Visare och kan bara få åtkomstnivån Kan visa.">Visare</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(user.ShortStatus))
                                                {
                                                    <span class="shrink-0 text-[10px] text-slate-400" title="@user.AccessNote">@user.ShortStatus</span>
                                                }
                                            </label>
                                        }
                                    </div>
                                    @if (_selectedUserIds.Count > 0)
                                    {
                                        <div class="mt-1.5 flex max-h-16 flex-wrap gap-1 overflow-y-auto">
                                            @foreach (var id in _selectedUserIds)
                                            {
                                                var pid = id;
                                                <span class="inline-flex items-center gap-1 rounded-full bg-sky-100 px-2 py-0.5 text-[11px] font-medium text-sky-800 dark:bg-sky-950/60 dark:text-sky-200">
                                                    <span class="max-w-[140px] truncate">@UserName(pid)</span>
                                                    <button type="button" class="text-sky-600 hover:text-sky-900 dark:text-sky-300" @onclick="() => ToggleUser(pid, false)" aria-label="Ta bort">×</button>
                                                </span>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div>
                            <label class="mb-1 block text-xs font-medium text-slate-600 dark:text-slate-300">Välj avdelning</label>
                            <select class="w-full rounded-lg border border-slate-300 bg-white px-2 py-1.5 text-sm dark:border-slate-600 dark:bg-slate-950 dark:text-slate-100"
                                    disabled="@_editingId.HasValue"
                                    value="@_departmentId" @onchange="e => _departmentId = ParseNullableInt(e.Value)">
                                <option value="">Välj avdelning...</option>
                                @foreach (var d in _departments)
                                {
                                    <option value="@d.Id" disabled="@(DeptOptionDisabled(d.Id))">@d.Name@(DeptOptionSuffix(d.Id))</option>
                                }
                            </select>
                            @if (DuplicateDepartment)
                            {
                                <p class="mt-1.5 rounded border border-amber-200 bg-amber-50 px-2 py-1.5 text-[11px] text-amber-700 dark:border-amber-900/60 dark:bg-amber-950/30 dark:text-amber-300">
                                    Avdelningen har redan en delning. Använd <span class="font-semibold">Ändra</span> i tabellen ovan.
                                </p>
                            }
                        </div>
                    }
                </div>

                @* ── HÖGER: åtkomstnivå + kalkyler + åtgärd ───────────────── *@
                <div class="flex flex-col gap-3">

                    @* Åtkomstnivå i detta projekt *@
                    <div>
                        <label class="mb-1 block text-xs font-medium text-slate-600 dark:text-slate-300">Åtkomstnivå i detta projekt</label>
                        <select class="w-full rounded-lg border border-slate-300 bg-white px-2 py-1.5 text-sm dark:border-slate-600 dark:bg-slate-950 dark:text-slate-100"
                                value="@_role" @onchange="OnRoleChanged"
                                title="@(DisableEditOption ? "Personen har systemrollen Visare och kan bara få åtkomstnivån Kan visa." : null)">
                            <option value="@PMRolesConst.Tenant.Viewer">Kan visa</option>
                            <option value="@PMRolesConst.Tenant.Manger" disabled="@DisableEditOption">Kan ändra</option>
                        </select>
                    </div>

                    @* Giltighet *@
                    <div>
                        <label class="mb-1 block text-xs font-medium text-slate-600 dark:text-slate-300">Giltighet</label>
                        <div class="space-y-1.5 rounded-lg border border-slate-200 bg-white px-2 py-2 text-sm dark:border-slate-700 dark:bg-slate-950">
                            <label class="flex cursor-pointer items-center gap-2">
                                <input type="radio"
                                       name="project-share-validity"
                                       class="h-4 w-4 border-slate-300 text-sky-600 focus:ring-sky-500"
                                       checked="@(!_useEndDate)"
                                       @onchange="() => SetUseEndDate(false)" />
                                <span>Tills vidare</span>
                            </label>
                            <label class="flex cursor-pointer items-center gap-2">
                                <input type="radio"
                                       name="project-share-validity"
                                       class="h-4 w-4 border-slate-300 text-sky-600 focus:ring-sky-500"
                                       checked="@_useEndDate"
                                       @onchange="() => SetUseEndDate(true)" />
                                <span>Till datum</span>
                            </label>
                            @if (_useEndDate)
                            {
                                <input type="date"
                                       class="mt-1 w-full rounded border border-slate-300 bg-white px-2 py-1 text-sm dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100"
                                       min="@TodayInputValue"
                                       value="@ValidUntilInputValue"
                                       @onchange="OnValidUntilChanged" />
                                @if (!_validUntil.HasValue)
                                {
                                    <p class="text-[11px] text-amber-600 dark:text-amber-400">Välj ett slutdatum.</p>
                                }
                                else if (_validUntil.Value.Date < DateTime.UtcNow.Date)
                                {
                                    <p class="text-[11px] text-rose-600 dark:text-rose-400">Slutdatum kan inte ligga bakåt i tiden.</p>
                                }
                            }
                        </div>
                    </div>

                    @* Kalkyler *@
                    <div>
                        <div class="mb-1 flex items-center justify-between gap-2">
                            <label class="text-xs font-medium text-slate-600 dark:text-slate-300">Välj kalkyler som ska delas</label>
                            <button type="button"
                                    class="text-[11px] font-semibold text-sky-700 hover:text-sky-900 disabled:opacity-40 dark:text-sky-300"
                                    title="Väljer alla kalkyler som kan delas. Privata kalkyler ingår inte."
                                    disabled="@(!HasShareableCalcs)"
                                    @onclick="SelectAllShareable">Välj alla tillgängliga kalkyler</button>
                        </div>

                        @if (_calcs.Count == 0)
                        {
                            <p class="rounded border border-dashed border-slate-300 px-2 py-3 text-center text-xs text-slate-400 dark:border-slate-700">
                                Det finns inga kalkyler i projektet.
                            </p>
                        }
                        else
                        {
                            @if (!HasShareableCalcs)
                            {
                                <p class="mb-1 rounded border border-dashed border-slate-300 px-2 py-2 text-center text-[11px] text-slate-400 dark:border-slate-700">
                                    Inga tillgängliga kalkyler att dela.
                                </p>
                            }
                            <div class="max-h-48 space-y-1 overflow-y-auto rounded border border-slate-200 bg-white p-1.5 dark:border-slate-700 dark:bg-slate-950">
                                @foreach (var c in _calcs)
                                {
                                    var calc = c;
                                    <label class="flex items-center gap-2 rounded px-1.5 py-1 text-sm @(calc.IsPrivate ? "opacity-60" : "hover:bg-slate-50 dark:hover:bg-slate-800")">
                                        <input type="checkbox"
                                               class="h-4 w-4 rounded border-slate-300 text-sky-600 focus:ring-sky-500 disabled:cursor-not-allowed dark:border-slate-600 dark:bg-slate-800"
                                               checked="@_selectedCalcIds.Contains(calc.Id)"
                                               disabled="@calc.IsPrivate"
                                               @onchange="e => ToggleCalc(calc.Id, e.Value is bool b && b)" />
                                        <span class="font-mono text-[11px] text-slate-400">V.@(calc.VersionNumber.ToString("D2"))</span>
                                        <span class="min-w-0 flex-1 truncate text-slate-700 dark:text-slate-200">@calc.Name</span>
                                        @if (calc.IsPrivate)
                                        {
                                            <span class="shrink-0 rounded-full bg-amber-100 px-2 py-0.5 text-[10px] font-semibold text-amber-700 dark:bg-amber-950/50 dark:text-amber-300">Privat</span>
                                        }
                                    </label>
                                }
                            </div>
                        }

                        @if (HasShareableCalcs && SelectedShareableCalcCount == 0)
                        {
                            <p class="mt-1 text-[11px] text-amber-600 dark:text-amber-400">Välj minst en kalkyl.</p>
                        }
                    </div>

                    @* Åtgärd – längst ner till höger i formulärsektionen *@
                    <div class="mt-auto flex items-center justify-end gap-2 pt-1">
                        @if (_editingId.HasValue)
                        {
                            <button type="button"
                                    class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-200"
                                    @onclick="ResetForm">Avbryt</button>
                        }
                        <button type="button"
                                class="inline-flex items-center gap-1.5 rounded-lg bg-sky-600 px-3 py-1.5 text-sm font-semibold text-white transition hover:bg-sky-700 disabled:cursor-not-allowed disabled:opacity-50"
                                disabled="@(!CanSave || _saving)"
                                title="@(CanSave ? null : SaveDisabledReason)"
                                @onclick="SaveAsync">
                            <span aria-hidden="true">@((MarkupString)Icons.PermissionShield)</span>
                            @(_editingId.HasValue ? "Spara delning" : "Lägg till delning")
                        </button>
                    </div>
                </div>
            </div>
        </div>

    </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public Guid ProjectId { get; set; }
    [Parameter] public string ProjectName { get; set; } = string.Empty;
    // The project's owning department — recipients in it already have access "via avdelningsåtkomst".
    [Parameter] public int? ProjectDepartmentId { get; set; }
    // Optional: project responsible (shown under "Ägare / ansvariga" when present). No new data model.
    [Parameter] public string? ProjectResponsible { get; set; }
    [Parameter] public EventCallback OnCompleted { get; set; }

    private List<ProjectShareListItemDTO> _shares = [];
    private List<ListCalculationMVVM> _calcs = [];
    private List<ListDTO> _departments = [];
    private List<UserOption> _userOptions = [];
    // Department member composition: deptId → (editors = system Användare, viewers = rest). Missing ⇒ "Blandad åtkomst".
    private readonly Dictionary<int, (int Editors, int Viewers)> _deptComposition = [];
    // Names for selected-person chips that may not be in the current filtered list.
    private readonly Dictionary<int, string> _userNameCache = [];
    // System-role lookup so the Visare cap holds even for persons selected under another filter.
    private readonly Dictionary<int, bool> _userIsViewerCache = [];

    // Form state
    private int? _editingId;
    private ProjectShareRecipientType _recipientType = ProjectShareRecipientType.User;
    private int _userFilterDeptId;          // 0 = alla, -1 = utan avdelning, >0 = avdelning
    private readonly HashSet<int> _selectedUserIds = [];
    private int? _departmentId;
    private string _role = PMRolesConst.Tenant.Viewer;
    private bool _useEndDate;
    private DateTime? _validUntil;
    private readonly HashSet<int> _selectedCalcIds = [];
    private bool _saving;
    // Åtkomstöversikten är hopfälld som standard (kompakt) – sammanfattning visas i rubrikraden.
    private bool _overviewOpen;
    // Vilken delnings kalkyler som är expanderade i "Delat med"-tabellen (null = ingen).
    private int? _expandedCalcShareId;

    // Loading/error state
    private bool _loadFailed;     // whole dialog couldn't load
    private bool _overviewPartial; // overview couldn't be computed fully (some dept fetches failed)

    private bool HasOwnerResponsible => !string.IsNullOrWhiteSpace(ProjectResponsible);

    // Projektets egen avdelning – recipients i den har redan avdelningsåtkomst.
    private string? ProjectDepartmentName =>
        ProjectDepartmentId is int id ? _departments.FirstOrDefault(d => d.Id == id)?.Name : null;

    private int ShareableCalcCount => _calcs.Count(c => !c.IsPrivate);

    // Kort sammanfattning för den hopfällda åtkomstöversikten.
    private string OverviewSummary()
    {
        var parts = new List<string>();
        if (ProjectDepartmentName is { } dn)
            parts.Add(dn);

        var users = _shares.Count(s => IsShareActive(s) && s.RecipientType == ProjectShareRecipientType.User);
        var depts = _shares.Count(s => IsShareActive(s) && s.RecipientType == ProjectShareRecipientType.Department);
        if (users > 0) parts.Add($"{users} delade personer");
        if (depts > 0) parts.Add($"{depts} delade avdelningar");
        if (users == 0 && depts == 0) parts.Add("Endast avdelningsåtkomst");

        return string.Join(" · ", parts);
    }

    // Åtkomstöversiktens kalkyltext per delning: "Alla tillgängliga kalkyler" eller "n/total kalkyler".
    private string OverviewCalcText(ProjectShareListItemDTO share)
    {
        var total = ShareableCalcCount;
        var n = share.CalculationIds.Count;
        if (n == 0) return "Saknar kalkyler";
        if (total > 0 && n >= total) return "Alla tillgängliga kalkyler";
        if (total > 0) return $"{n}/{total} kalkyler";
        return n == 1 ? "1 kalkyl" : $"{n} kalkyler";
    }

    private string EditingRecipientName =>
        _editingId is int id ? _shares.FirstOrDefault(s => s.Id == id)?.RecipientName ?? "—" : "—";

    private UserOption? EditingUser =>
        _editingId is not null && _selectedUserIds.Count == 1
            ? _userOptions.FirstOrDefault(u => u.Id == _selectedUserIds.First())
            : null;

    // "Kan ändra" is disabled only while editing a single system Visare (multiselect handles the rest per person).
    private bool DisableEditOption => _editingId is not null && EditingUser?.IsViewer == true;

    private bool HasShareableCalcs => _calcs.Any(c => !c.IsPrivate);

    // Antal valda kalkyler som faktiskt går att dela (privata räknas aldrig).
    private int SelectedShareableCalcCount => _selectedCalcIds.Count(id => _calcs.Any(c => c.Id == id && !c.IsPrivate));

    private bool DuplicateDepartment =>
        _editingId is null &&
        _recipientType == ProjectShareRecipientType.Department &&
        _departmentId is > 0 &&
        _shares.Any(s => s.RecipientType == ProjectShareRecipientType.Department && s.DepartmentId == _departmentId);

    private bool CanSave =>
        !string.IsNullOrWhiteSpace(_role) &&
        HasValidValidity &&
        !DuplicateDepartment &&
        // En delning måste innehålla minst en kalkyl – annars ger den ingen faktisk åtkomst.
        SelectedShareableCalcCount > 0 &&
        (_recipientType == ProjectShareRecipientType.User
            ? _selectedUserIds.Count > 0
            : _departmentId is > 0);

    // Orsak till varför "Lägg till delning" är inaktiv – visas som tooltip på knappen.
    private string? SaveDisabledReason
    {
        get
        {
            if (_recipientType == ProjectShareRecipientType.User && _selectedUserIds.Count == 0)
                return "Välj minst en person.";
            if (_recipientType == ProjectShareRecipientType.Department && _departmentId is not > 0)
                return "Välj en avdelning.";
            if (DuplicateDepartment)
                return "Avdelningen har redan en delning. Använd Ändra i tabellen.";
            if (_useEndDate && !_validUntil.HasValue)
                return "Välj ett slutdatum.";
            if (_useEndDate && _validUntil!.Value.Date < DateTime.UtcNow.Date)
                return "Slutdatum kan inte ligga bakåt i tiden.";
            if (SelectedShareableCalcCount == 0)
                return "Välj minst en kalkyl.";
            if (string.IsNullOrWhiteSpace(_role))
                return "Välj åtkomstnivå.";
            return null;
        }
    }

    private string UserName(int id) =>
        _userNameCache.TryGetValue(id, out var n) ? n : $"#{id}";

    protected override Task OnInitializedAsync() => ReloadAllAsync();

    private async Task ReloadAllAsync()
    {
        _loadFailed = false;
        _overviewPartial = false;
        try
        {
            _departments = await Repo.Departments.GetDepartmentsAsListAsync() ?? [];
            var all = await Repo.Calculation.GetAsync(ProjectId) ?? [];
            _calcs = CalculationVersionSelector.SelectCurrentVersions(all)
                .OrderByDescending(c => c.Order)
                .ToList();
            await ReloadSharesAsync();
            await LoadDeptCompositionAsync();
            await ReloadUserOptionsAsync();
        }
        catch (Exception ex)
        {
            // Whole dialog couldn't load — show a local error instead of the global blazor-error-ui.
            _loadFailed = true;
            await ClientLog.ErrorAsync("ProjectShareUI failed to load.", ProjectId.ToString(), ex);
        }
        StateHasChanged();
    }

    private async Task ReloadSharesAsync()
    {
        _shares = await Repo.ProjectShare.GetByProjectAsync(ProjectId) ?? [];
        StateHasChanged();
    }

    // Build per-department member composition for the access overview. Individual department fetch
    // failures are tolerated (e.g. a non-tenant-wide admin): the dept is shown as "Blandad åtkomst".
    private async Task LoadDeptCompositionAsync()
    {
        _deptComposition.Clear();
        var anyFailed = false;

        // Only the departments that the overview actually needs lines for.
        var neededIds = new HashSet<int>();
        if (ProjectDepartmentId is int own) neededIds.Add(own);
        foreach (var s in _shares.Where(s => s.RecipientType == ProjectShareRecipientType.Department && s.DepartmentId is > 0))
            neededIds.Add(s.DepartmentId!.Value);

        foreach (var deptId in neededIds)
        {
            try
            {
                var users = await Repo.Departments.GetUsersAuthAsListAsync(deptId) ?? [];
                int editors = users.Count(u => u.Role == PMRolesConst.Tenant.Manger);
                int total = users.Count;
                _deptComposition[deptId] = (editors, total - editors);
            }
            catch (Exception ex)
            {
                anyFailed = true;
                await ClientLog.ErrorAsync($"ProjectShareUI: could not load members for department {deptId}.", ProjectId.ToString(), ex);
            }
        }

        _overviewPartial = anyFailed;
    }

    private void OnRoleChanged(ChangeEventArgs e)
    {
        _role = e.Value?.ToString() ?? PMRolesConst.Tenant.Viewer;
        // A system Visare can never be granted "Kan ändra": drop any selected viewers when switching.
        if (_role == PMRolesConst.Tenant.Manger)
            _selectedUserIds.RemoveWhere(id => _userIsViewerCache.GetValueOrDefault(id));
    }

    private void SetRecipientType(ProjectShareRecipientType type)
    {
        if (_editingId.HasValue) return;
        _recipientType = type;
        _selectedUserIds.Clear();
        _departmentId = null;
    }

    private async Task OnUserFilterChanged(ChangeEventArgs e)
    {
        _userFilterDeptId = int.TryParse(e.Value?.ToString(), out var v) ? v : 0;
        await ReloadUserOptionsAsync();
    }

    private void ToggleUser(int id, bool on)
    {
        if (on) _selectedUserIds.Add(id);
        else _selectedUserIds.Remove(id);
    }

    private void ToggleCalcExpand(int shareId) =>
        _expandedCalcShareId = _expandedCalcShareId == shareId ? null : shareId;

    private async Task ReloadUserOptionsAsync()
    {
        List<UserAuthModel> raw;

        if (_userFilterDeptId > 0)
        {
            raw = await SafeGetUsersAsync(_userFilterDeptId);
        }
        else
        {
            // "Alla avdelningar": aggregate per department (each fetch is allowed for any admin).
            var byId = new Dictionary<int, UserAuthModel>();
            foreach (var d in _departments)
            {
                foreach (var u in await SafeGetUsersAsync(d.Id))
                    if (u.UserId is > 0)
                        byId.TryAdd(u.UserId.Value, u);
            }

            // "Utan avdelning": only tenant-wide admins can fetch the full set (did = 0); fold those
            // users in and, for the "none" filter, keep only the department-less ones.
            foreach (var u in await SafeGetUsersAsync(0))
                if (u.UserId is > 0)
                    byId.TryAdd(u.UserId.Value, u);

            raw = byId.Values.ToList();

            if (_userFilterDeptId == -1)
                raw = raw.Where(u => u.DepartmentId is null).ToList();
        }

        _userOptions = raw
            .Where(u => u.UserId is > 0)
            .Select(BuildUserOption)
            .OrderBy(u => u.Name)
            .ToList();

        foreach (var o in _userOptions)
        {
            _userNameCache[o.Id] = o.Name;
            _userIsViewerCache[o.Id] = o.IsViewer;
        }

        StateHasChanged();
    }

    // Department-member fetch that never throws — a failure just yields no users for that department.
    private async Task<List<UserAuthModel>> SafeGetUsersAsync(int departmentId)
    {
        try
        {
            return await Repo.Departments.GetUsersAuthAsListAsync(departmentId) ?? [];
        }
        catch (Exception ex)
        {
            await ClientLog.ErrorAsync($"ProjectShareUI: could not load users for filter {departmentId}.", ProjectId.ToString(), ex);
            return [];
        }
    }

    private UserOption BuildUserOption(UserAuthModel u)
    {
        var id = u.UserId!.Value;
        var name = string.IsNullOrWhiteSpace(u.FullName.Trim())
            ? (string.IsNullOrWhiteSpace(u.Email) ? u.Username : u.Email)
            : u.FullName.Trim();

        // Why the recipient already has access — short status badge + full text in tooltip so admins
        // don't create duplicates. (UI text only; no permission logic here.)
        string? note = null;
        string? shortStatus = null;
        bool alreadyDirect = false;

        var direct = _shares.FirstOrDefault(s => s.RecipientType == ProjectShareRecipientType.User && s.UserId == id);
        if (direct is not null)
        {
            note = $"Redan delad som {AccessLevelLabel(direct.Role)}";
            shortStatus = "Redan delad";
            alreadyDirect = true;
        }
        else if (u.DepartmentId is int own && ProjectDepartmentId.HasValue && own == ProjectDepartmentId.Value)
        {
            // In the project's own department — no separate share needed.
            note = "Har redan avdelningsåtkomst";
            shortStatus = "Avdelningsåtkomst";
        }
        else if (u.DepartmentId is int dep &&
                 _shares.Any(s => s.RecipientType == ProjectShareRecipientType.Department && s.DepartmentId == dep))
        {
            var depName = _departments.FirstOrDefault(d => d.Id == dep)?.Name ?? "avdelning";
            note = $"Har redan åtkomst via avdelning {depName}";
            shortStatus = "Avdelningsåtkomst";
        }

        return new UserOption { Id = id, Name = name, Role = u.Role ?? string.Empty, DepartmentId = u.DepartmentId, AccessNote = note, ShortStatus = shortStatus, AlreadyDirect = alreadyDirect };
    }

    private bool DepartmentAlreadyShared(int deptId) =>
        _shares.Any(s => s.RecipientType == ProjectShareRecipientType.Department && s.DepartmentId == deptId);

    private bool IsProjectOwnDepartment(int deptId) =>
        ProjectDepartmentId.HasValue && ProjectDepartmentId.Value == deptId;

    // The project's own department and already-shared departments don't need a (new) share.
    private bool DeptOptionDisabled(int deptId) =>
        _editingId is null && (DepartmentAlreadyShared(deptId) || IsProjectOwnDepartment(deptId));

    private string DeptOptionSuffix(int deptId) =>
        IsProjectOwnDepartment(deptId) ? " · Har redan avdelningsåtkomst"
        : DepartmentAlreadyShared(deptId) ? " · Redan delad"
        : string.Empty;

    private void ToggleCalc(int id, bool on)
    {
        if (on) _selectedCalcIds.Add(id);
        else _selectedCalcIds.Remove(id);
    }

    private void SelectAllShareable()
    {
        foreach (var c in _calcs.Where(c => !c.IsPrivate))
            _selectedCalcIds.Add(c.Id);
    }

    private async Task SaveAsync()
    {
        if (!CanSave || _saving) return;
        _saving = true;
        try
        {
            // Privata kalkyler kan aldrig delas – filtrera bort dem defensivt.
            var calcIds = _selectedCalcIds.Where(id => _calcs.Any(c => c.Id == id && !c.IsPrivate)).ToList();

            bool ok;
            if (_recipientType == ProjectShareRecipientType.Department || _editingId is not null)
            {
                ok = await UpsertOneAsync(BuildDto(_editingId, calcIds));
            }
            else
            {
                // Multiselect: one share per selected person, same access level + calcs.
                ok = true;
                foreach (var uid in _selectedUserIds.ToList())
                {
                    // Cap effective permission: a system Visare can never be assigned "Kan ändra".
                    var role = _userIsViewerCache.GetValueOrDefault(uid) ? PMRolesConst.Tenant.Viewer : _role;
                    ok &= await UpsertOneAsync(new ProjectShareUpsertDTO
                    {
                        Id = null,
                        RecipientType = ProjectShareRecipientType.User,
                        UserId = uid,
                        DepartmentId = null,
                        Role = role,
                        ValidUntil = SelectedValidUntil,
                        CalculationIds = calcIds
                    });
                }
            }

            if (ok)
            {
                ResetForm();
                await ReloadSharesAsync();
                await LoadDeptCompositionAsync();
                await ReloadUserOptionsAsync();
                if (OnCompleted.HasDelegate)
                    await OnCompleted.InvokeAsync();
            }
            MHD.Notifications(ToastType.Update, ok);
        }
        finally
        {
            _saving = false;
        }
    }

    private ProjectShareUpsertDTO BuildDto(int? id, List<int> calcIds)
    {
        // Cap effective permission for the edited single user too.
        var role = DisableEditOption ? PMRolesConst.Tenant.Viewer : _role;
        return new ProjectShareUpsertDTO
        {
            Id = id,
            RecipientType = _recipientType,
            UserId = _recipientType == ProjectShareRecipientType.User ? _selectedUserIds.FirstOrDefault() : null,
            DepartmentId = _recipientType == ProjectShareRecipientType.Department ? _departmentId : null,
            Role = role,
            ValidUntil = SelectedValidUntil,
            CalculationIds = calcIds
        };
    }

    private async Task<bool> UpsertOneAsync(ProjectShareUpsertDTO dto)
        => await Repo.ProjectShare.UpsertAsync(ProjectId, dto) > 0;

    private async Task EditShareAsync(ProjectShareListItemDTO share)
    {
        _editingId = share.Id;
        _recipientType = share.RecipientType;
        _role = string.IsNullOrWhiteSpace(share.Role) ? PMRolesConst.Tenant.Viewer : share.Role;
        _validUntil = share.ValidUntil?.Date;
        _useEndDate = _validUntil.HasValue;
        _departmentId = share.RecipientType == ProjectShareRecipientType.Department ? share.DepartmentId : null;

        _selectedUserIds.Clear();
        if (share.RecipientType == ProjectShareRecipientType.User && share.UserId is int uid)
            _selectedUserIds.Add(uid);

        _selectedCalcIds.Clear();
        foreach (var cid in share.CalculationIds)
            _selectedCalcIds.Add(cid);

        if (_recipientType == ProjectShareRecipientType.User)
        {
            // Load across all departments so the shared user is present (for the system-role cap).
            _userFilterDeptId = 0;
            await ReloadUserOptionsAsync();
        }
        StateHasChanged();
    }

    private void ResetForm()
    {
        _editingId = null;
        _recipientType = ProjectShareRecipientType.User;
        _userFilterDeptId = 0;
        _selectedUserIds.Clear();
        _departmentId = null;
        _role = PMRolesConst.Tenant.Viewer;
        _useEndDate = false;
        _validUntil = null;
        _selectedCalcIds.Clear();
    }

    private void RemoveAsync(ProjectShareListItemDTO share)
    {
        MHD.DeleteMessage(share.RecipientName, EventCallback.Factory.Create(this, () => ConfirmRemoveAsync(share)));
    }

    private async Task ConfirmRemoveAsync(ProjectShareListItemDTO share)
    {
        bool ok = await Repo.ProjectShare.DeleteAsync(share.Id);
        if (ok)
        {
            if (_editingId == share.Id) ResetForm();
            await ReloadSharesAsync();
            await LoadDeptCompositionAsync();
            await ReloadUserOptionsAsync();
            if (OnCompleted.HasDelegate)
                await OnCompleted.InvokeAsync();
        }
        MHD.Notifications(ToastType.Delete, ok);
    }

    // ── "Delat med" table helpers ────────────────────────────────────
    // Visa "n kalkyler · Visa" bara när det finns fler än en kalkyl och inte alla delbara ingår.
    private bool ShowCalcExpander(ProjectShareListItemDTO share)
    {
        var n = share.CalculationIds.Count;
        if (n <= 1) return false;
        if (ShareableCalcCount > 0 && n >= ShareableCalcCount) return false; // "Alla tillgängliga kalkyler"
        return true;
    }

    private IEnumerable<string> CalcNames(ProjectShareListItemDTO share) =>
        share.CalculationIds
            .Select(id => _calcs.FirstOrDefault(c => c.Id == id))
            .Where(c => c is not null)
            .Select(c => $"V.{c!.VersionNumber:D2} {c.Name}");

    private string CalcSummary(ProjectShareListItemDTO share)
    {
        var ids = share.CalculationIds;
        if (ids.Count == 0) return "Saknar kalkyler";
        if (ids.Count == 1)
        {
            var c = _calcs.FirstOrDefault(x => x.Id == ids[0]);
            return c is null ? "1 kalkyl" : $"V.{c.VersionNumber:D2} {c.Name}";
        }
        // "Alla tillgängliga kalkyler" när allt delbart ingår.
        if (ShareableCalcCount > 0 && ids.Count >= ShareableCalcCount) return "Alla tillgängliga kalkyler";
        return $"{ids.Count} kalkyler";
    }

    private string? CalcNamesTooltip(ProjectShareListItemDTO share)
    {
        if (share.CalculationIds.Count <= 1) return null;
        return string.Join("\n", CalcNames(share));
    }

    // Avdelningsåtkomstrad med blandad åtkomst: "Namn · 5 kan ändra · 3 kan visa · <kalkyltext>".
    // shareRole == null ⇒ projektets egen avdelning (normal avdelningsåtkomst).
    private string DeptAccessLine(string name, int? deptId, string? shareRole, string calcText)
    {
        if (deptId is int id && _deptComposition.TryGetValue(id, out var comp))
        {
            int editors, viewers;
            if (shareRole == PMRolesConst.Tenant.Viewer)
            {
                // Hela avdelningen delas som Kan visa ⇒ ingen kan ändra.
                editors = 0;
                viewers = comp.Editors + comp.Viewers;
            }
            else
            {
                // Egen avdelning eller delad som Kan ändra ⇒ maxregeln gäller per systemroll.
                editors = comp.Editors;
                viewers = comp.Viewers;
            }
            return $"{name} · {editors} kan ändra · {viewers} kan visa · {calcText}";
        }
        return $"{name} · Blandad åtkomst · {calcText}";
    }

    private bool HasValidValidity =>
        !_useEndDate || (_validUntil.HasValue && _validUntil.Value.Date >= DateTime.UtcNow.Date);

    private DateTime? SelectedValidUntil => _useEndDate ? _validUntil?.Date : null;
    private static string TodayInputValue => DateTime.UtcNow.Date.ToString("yyyy-MM-dd");
    private string ValidUntilInputValue => _validUntil?.ToString("yyyy-MM-dd") ?? string.Empty;

    private static bool IsShareExpired(ProjectShareListItemDTO share) =>
        share.ValidUntil.HasValue && share.ValidUntil.Value.Date < DateTime.UtcNow.Date;

    private static bool IsShareActive(ProjectShareListItemDTO share) => !IsShareExpired(share);

    private static string ValidityText(ProjectShareListItemDTO share) =>
        share.ValidUntil.HasValue ? $"Till {share.ValidUntil.Value:yyyy-MM-dd}" : "Tills vidare";

    private void SetUseEndDate(bool useEndDate)
    {
        _useEndDate = useEndDate;
        if (!useEndDate)
            _validUntil = null;
    }

    private void OnValidUntilChanged(ChangeEventArgs e) =>
        _validUntil = DateTime.TryParse(e.Value?.ToString(), out var value) ? value.Date : null;

    private static int? ParseNullableInt(object? value)
        => int.TryParse(value?.ToString(), out var n) && n > 0 ? n : null;

    private string RecipientTabClass(ProjectShareRecipientType type) =>
        _recipientType == type
            ? "px-3 py-1.5 text-xs font-semibold bg-sky-600 text-white disabled:opacity-60"
            : "px-3 py-1.5 text-xs font-medium bg-white text-slate-600 hover:bg-slate-50 disabled:opacity-60 dark:bg-slate-900 dark:text-slate-300";

    // UI-etikett för åtkomstnivån i detta projekt. Internt återanvänds systemrolls-enumvärdena.
    private static string AccessLevelLabel(string role) => role switch
    {
        PMRolesConst.Tenant.Manger => "Kan ändra",
        PMRolesConst.Tenant.Admin => "Kan ändra",
        _ => "Kan visa"
    };

    private sealed class UserOption
    {
        public int Id { get; init; }
        public string Name { get; init; } = string.Empty;
        public string Role { get; init; } = string.Empty;
        public int? DepartmentId { get; init; }
        public string? AccessNote { get; init; }
        public string? ShortStatus { get; init; }
        public bool AlreadyDirect { get; init; }
        public bool IsViewer => Role == PMRolesConst.Tenant.Viewer;
    }
}
