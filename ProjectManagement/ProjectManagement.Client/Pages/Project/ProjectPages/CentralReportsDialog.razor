            ? _projects.Select(e => e.Project.Inspector).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s)
            : _calculations.Select(e => e.Calculation.Inspector).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s);

    private IEnumerable<int> AvailableYears =>
        BuildIncomeRows().Select(r => r.Year)
            .Concat(_projects.Select(e => e.Project.TenderDeadline).Where(d => d != default && d.Year > 2000).Select(d => d.Year))
