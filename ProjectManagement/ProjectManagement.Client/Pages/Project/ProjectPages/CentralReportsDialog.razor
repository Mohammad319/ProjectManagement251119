    // ── Table render fragments ────────────────────────────────────────

    private RenderFragment CalculationTable(IEnumerable<CalculationEntry> entries)
    {
        var cols = CalcAllColumns.Where(c => _visibleCalcColumns.Contains(c)).ToList();
        return @<div class="@TableContainerClass">
            <table class="@TableClass">
                <thead class="@TableHeadClass"><tr>@foreach (var c in cols) { <th>@GetCalcColumnLabel(c)</th> }</tr></thead>
                <tbody class="@TableBodyClass">
                    @{ var ci = 0; }
                    @foreach (var e in entries)
                    {
                        <tr class="@(ci++ % 2 == 0 ? "" : "bg-slate-50/70 dark:bg-slate-900/30")">
                            @foreach (var c in cols) { <td>@GetCalcCellValue(e, c)</td> }
                        </tr>
                    }
                </tbody>
            </table>
        </div>;
    }

    private RenderFragment ProjectTable(IEnumerable<ProjectEntry> entries)
    {
        var cols = ProjAllColumns.Where(c => _visibleProjColumns.Contains(c)).ToList();
        return @<div class="@TableContainerClass">
            <table class="@TableClass">
                <thead class="@TableHeadClass"><tr>@foreach (var c in cols) { <th>@GetProjColumnLabel(c)</th> }</tr></thead>
                <tbody class="@TableBodyClass">
                    @{ var pi = 0; }
                    @foreach (var e in entries)
                    {
                        <tr class="@(pi++ % 2 == 0 ? "" : "bg-slate-50/70 dark:bg-slate-900/30")">
                            @foreach (var c in cols) { <td>@GetProjCellValue(e, c)</td> }
                        </tr>
                    }
                </tbody>
            </table>
        </div>;
    }

    private RenderFragment HitRateProjectTable() => @<div class="@TableContainerClass">
        <table class="@TableClass">
            <thead class="@TableHeadClass">
                <tr><th>Mapp</th><th>Projekt</th><th>Projektstatus</th><th>Anbudsdeadline</th><th>Kalkylansvarig</th><th>Granskare</th></tr>
            </thead>
            <tbody class="@TableBodyClass">
                @{ var hi = 0; }
                @foreach (var e in HitRateProjectEntries)
                {
                    <tr class="@(hi++ % 2 == 0 ? "" : "bg-slate-50/70 dark:bg-slate-900/30")">
                        <td>@e.Folder.Name</td><td>@e.Project.Name</td><td>@e.Project.Status</td>
                        <td>@FormatDate(e.Project.TenderDeadline)</td><td>@e.Project.Responsible</td><td>@e.Project.Inspector</td>
