    private static ReportExportHeader ToExportHeader(ExportModel export) =>
        new(export.Title, export.Sections, export.Kpis);

    private ExportModel BuildExport() => _activeView switch
    {
        ReportView.Income => BuildIncomeExport(),
        ReportView.HitRate => BuildHitRateExport(),
        ReportView.Calculations => BuildCalcExport(),
        ReportView.Projects => BuildProjExport(),
        ReportView.BidComparison => BuildBidExport(),
        _ => BuildCalcExport()
    };

    private ExportModel BuildIncomeExport()
    {
        // Export mirrors the on-screen layout: only calc columns; project info appears
        // as a project-section row before each project's calc rows.
        var cols = IncomeCalcColumns.Where(c => _visibleIncomeColumns.Contains(c)).ToList();
        var headers = new List<string>();
        foreach (var c in cols)
        {
            headers.Add(GetIncomeColumnLabel(c));
            if (c == IncomeReportColumn.Year && _showQuarters)
            { headers.Add("Q1"); headers.Add("Q2"); headers.Add("Q3"); headers.Add("Q4"); }
        }

        var sections = new List<ReportExportSection>
        {
            new("Urval:", [_incomeSelectionLine, _incomeSelectionFilters, ExportIncludeNote]),
            new("Rapportfilter:", [BuildIncomeReportFilterLine()])
        };
        var included = IncludedFilteredIncomeRows.ToList();
        var exportRows = BuildIncomeExportRowsDynamic(cols).ToList();
        var sourceRows = BuildIncomeTableRows()
            .Where(r => r.Kind != IncomeTableRowKind.Data || !_excludedRowKeys.Contains(r.RowKey)).ToList();
        var dataIndexes = sourceRows.Select((row, index) => (row, index))
            .Where(x => x.row.Kind == IncomeTableRowKind.Data).Select(x => x.index).ToList();
        var exportIndexes = new Dictionary<IncomeReportColumn, int>();
        var exportIndex = 0;
        foreach (var col in cols)
        {
            exportIndexes[col] = exportIndex++;
            if (col == IncomeReportColumn.Year && _showQuarters) exportIndex += 4;
        }
        string? IncomeSumFormula(IncomeReportColumn col) =>
            dataIndexes.Count > 0 && exportIndexes.TryGetValue(col, out var ci)
                ? $"SUM({ExcelRange(ci, dataIndexes[0], dataIndexes[^1])})"
                : null;
        var kpis = new List<ReportExportKpi>
        {
            new(L("revenue"), included.Sum(r => r.Amount), IncomeSumFormula(IncomeReportColumn.Amount), "money"),
            new(L("forecast"), included.Sum(r => r.Forecast), IncomeSumFormula(IncomeReportColumn.Forecast), "money"),
            new("Projekt", included.Select(r => r.Entry.Project.Id).Distinct().Count().ToString()),
            // The grouped export contains project header rows between calculations;
            // keep this distinct count static rather than emitting an unsafe COUNTA formula.
            new("Kalkyler", included.Select(r => r.Entry.Calculation.Id).Distinct().Count(), null, "integer")
        };
        return new(L("incomeOverview"), headers.ToArray(), exportRows, sections, kpis);
    }

    private string BuildIncomeReportFilterLine()
    {
        var parts = new List<string>();
        if (!string.IsNullOrEmpty(_selectedFolderId))
        {
            var f = AvailableFolders.FirstOrDefault(x => x.Id.ToString() == _selectedFolderId);
            if (f is not null) parts.Add($"Mapp: {f.Name}");
        }
        if (!string.IsNullOrEmpty(_selectedProjectId) && !string.IsNullOrWhiteSpace(_projectSearch))
            parts.Add($"Projekt: {_projectSearch}");
        parts.Add($"År: {(string.IsNullOrWhiteSpace(_selectedYear) ? "Alla" : _selectedYear)}");
        parts.Add($"Kvartal: {(_selectedQuarter == 0 ? "Alla" : $"Q{_selectedQuarter}")}");
        parts.Add($"Kalkylstatus: {(_selectedStatuses.Count == 0 ? "Alla" : string.Join(", ", _selectedStatuses))}");
        parts.Add($"Deltyp: {(int.TryParse(_selectedSubType, out var st) ? SubTypeLabel((IncomeSubType)st) : "Alla")}");
        parts.Add($"Intäktskälla: {(Enum.TryParse<CalculationVersionType>(_selectedIncomeSource, out var src) ? TypeLabel(src) : L("automatic"))}");
        if (Enum.TryParse<CalculationVersionType>(_selectedCalculationType, out var ct))
            parts.Add($"Kalkyltyp: {TypeLabel(ct)}");
        if (Enum.TryParse<CalculationRole>(_selectedCalculationRole, out var role))
            parts.Add($"Kalkylroll: {GetCalculationRoleLabel(role)}");
        var resp = _selectedResponsibles.Where(r => r != MissingPersonValue).ToList();
        if (resp.Count > 0) parts.Add($"Kalkylansvarig: {string.Join(", ", resp)}");
        var insp = _selectedInspectors.Where(r => r != MissingPersonValue).ToList();
        if (insp.Count > 0) parts.Add($"Granskare: {string.Join(", ", insp)}");
        parts.Add(_selectedArchiveMode switch { "all" => "Arkiverade inkluderade", "archived" => "Enbart arkiverade", _ => "Arkiverade ej inkluderade" });
        return string.Join(" · ", parts);
    }

    private IEnumerable<IEnumerable<object?>> BuildIncomeExportRowsDynamic(List<IncomeReportColumn> cols)
    {
        var sourceRows = BuildIncomeTableRows()
            .Where(r => r.Kind != IncomeTableRowKind.Data || !_excludedRowKeys.Contains(r.RowKey))
            .ToList();
        var dataIndexes = sourceRows.Select((row, index) => (row, index))
            .Where(x => x.row.Kind == IncomeTableRowKind.Data).Select(x => x.index).ToList();
        var firstData = dataIndexes.Count > 0 ? dataIndexes[0] : -1;
        var lastData = dataIndexes.Count > 0 ? dataIndexes[^1] : -1;

        var columnIndexes = new Dictionary<IncomeReportColumn, int>();
        var quarterIndexes = new Dictionary<int, int>();
        var exportColumn = 0;
        foreach (var col in cols)
        {
            columnIndexes[col] = exportColumn++;
            if (col == IncomeReportColumn.Year && _showQuarters)
                for (var quarter = 1; quarter <= 4; quarter++) quarterIndexes[quarter] = exportColumn++;
        }

        for (var rowIndex = 0; rowIndex < sourceRows.Count; rowIndex++)
        {
            var row = sourceRows[rowIndex];
            var cells = new List<object?>();
            if (row.Kind == IncomeTableRowKind.Data)
            {
                foreach (var c in cols)
                {
                    if (c == IncomeReportColumn.Amount)
                    {
                        var formula = quarterIndexes.Count == 4
                            ? $"SUM({ExcelCell(quarterIndexes[1], rowIndex)}:{ExcelCell(quarterIndexes[4], rowIndex)})"
                            : null;
                        cells.Add(new ReportExcelCell(row.Amount, formula, "money"));
                    }
                    else if (c == IncomeReportColumn.Probability)
                    {
                        cells.Add(new ReportExcelCell(row.Probability / 100m, null, "percent"));
                    }
                    else if (c == IncomeReportColumn.Forecast &&
                             columnIndexes.TryGetValue(IncomeReportColumn.Amount, out var amountCol) &&
                             columnIndexes.TryGetValue(IncomeReportColumn.Probability, out var probabilityCol))
                    {
                        cells.Add(new ReportExcelCell(row.Forecast,
                            $"{ExcelCell(amountCol, rowIndex)}*{ExcelCell(probabilityCol, rowIndex)}", "money"));
                    }
                    else
                    {
                        cells.Add(GetIncomeDataCellValue(row, c));
                    }
                    if (c == IncomeReportColumn.Year && _showQuarters)
                    {
                        cells.Add(new ReportExcelCell(row.Q1, null, "money"));
                        cells.Add(new ReportExcelCell(row.Q2, null, "money"));
                        cells.Add(new ReportExcelCell(row.Q3, null, "money"));
                        cells.Add(new ReportExcelCell(row.Q4, null, "money"));
                    }
                }
            }
            else if (row.Kind == IncomeTableRowKind.ProjectHeader)
            {
                // Project section row: title + selected project fields + summary in the first cell.
                var label = IncomeProjectHeaderTitle(row);
                var fields = BuildIncomeProjectFields(row);
                if (!string.IsNullOrWhiteSpace(fields)) label += " — " + fields;
                label += " · " + IncomeProjectSummary(row);
                bool first = true;
                foreach (var c in cols)
                {
                    cells.Add(first ? label : "");
                    first = false;
                    if (c == IncomeReportColumn.Year && _showQuarters)
                    { cells.Add(""); cells.Add(""); cells.Add(""); cells.Add(""); }
                }
            }
            else
            {
                bool first = true;
                foreach (var c in cols)
                {
                    if (first) { cells.Add(row.SummaryLabel); first = false; }
                    else if (c == IncomeReportColumn.Amount)
                        cells.Add(BuildIncomeSummaryFormulaCell(row, c, row.Amount, columnIndexes, firstData, lastData));
                    else if (c == IncomeReportColumn.Forecast)
                        cells.Add(BuildIncomeSummaryFormulaCell(row, c, row.Forecast, columnIndexes, firstData, lastData));
                    else cells.Add("");
                    if (c == IncomeReportColumn.Year && _showQuarters)
                    {
                        cells.Add(BuildIncomeSummaryFormulaCell(row, null, row.Q1, columnIndexes, firstData, lastData, quarterIndexes.GetValueOrDefault(1)));
                        cells.Add(BuildIncomeSummaryFormulaCell(row, null, row.Q2, columnIndexes, firstData, lastData, quarterIndexes.GetValueOrDefault(2)));
                        cells.Add(BuildIncomeSummaryFormulaCell(row, null, row.Q3, columnIndexes, firstData, lastData, quarterIndexes.GetValueOrDefault(3)));
                        cells.Add(BuildIncomeSummaryFormulaCell(row, null, row.Q4, columnIndexes, firstData, lastData, quarterIndexes.GetValueOrDefault(4)));
                    }
                }
            }
            yield return cells;
        }
    }

    private static ReportExcelCell BuildIncomeSummaryFormulaCell(
        IncomeTableRow row,
        IncomeReportColumn? valueColumn,
        decimal value,
        IReadOnlyDictionary<IncomeReportColumn, int> columns,
        int firstData,
        int lastData,
        int? explicitValueColumn = null)
    {
        if (firstData < 0 || lastData < firstData)
            return new(value, null, "money");

        var valueIndex = explicitValueColumn ?? (valueColumn.HasValue && columns.TryGetValue(valueColumn.Value, out var ci) ? ci : -1);
        if (valueIndex < 0)
            return new(value, null, "money");

        var valueRange = ExcelRange(valueIndex, firstData, lastData);
        string? formula = row.Kind switch
        {
            IncomeTableRowKind.GrandTotal => $"SUM({valueRange})",
            IncomeTableRowKind.SubTypeTotal when columns.TryGetValue(IncomeReportColumn.SubType, out var subtypeIndex) =>
                $"SUMIF({ExcelRange(subtypeIndex, firstData, lastData)},\"{ExcelFormulaText(row.SummaryLabel.Replace("Summa ", ""))}\",{valueRange})",
            IncomeTableRowKind.YearTotal when columns.TryGetValue(IncomeReportColumn.Year, out var yearIndex) =>
                $"SUMIF({ExcelRange(yearIndex, firstData, lastData)},{row.Year},{valueRange})",
            _ => null
        };
        return new(value, formula, "money");
    }

    private static string ExcelCell(int zeroBasedColumn, int exportRowIndex) =>
        $"{ExcelColumnName(zeroBasedColumn)}{{row:{exportRowIndex}}}";

    private static string ExcelRange(int zeroBasedColumn, int firstExportRow, int lastExportRow) =>
        $"{ExcelCell(zeroBasedColumn, firstExportRow)}:{ExcelCell(zeroBasedColumn, lastExportRow)}";

    private static string ExcelColumnName(int zeroBasedColumn)
    {
        var value = zeroBasedColumn + 1;
        var name = string.Empty;
        while (value > 0)
        {
            value--;
            name = (char)('A' + value % 26) + name;
            value /= 26;
        }
        return name;
    }

    private static string ExcelFormulaText(string value) => value.Replace("\"", "\"\"");

    private ExportModel BuildHitRateExport()
    {
        var dataCols = HitRateAllColumns.Where(c => c != HitRateReportColumn.RowNumber && _visibleHitRateColumns.Contains(c)).ToList();
        string[] headers = [.. dataCols.Select(GetHitRateColumnLabel), "Utfall"];
        var sections = new List<ReportExportSection>
        {
            new("Projekturval:", [_hitRateSelectionLine, _hitRateSelectionFilters, ExportIncludeNote]),
            new("Beräkning:", [HitRateBasisLine])
        };
        var included = HitRateTableProjects.Where(e => RowIncluded(HitRateRowKey(e))).ToList();
        var outcomeColumn = dataCols.Count;
        var outcomeRange = included.Count > 0 ? ExcelRange(outcomeColumn, 0, included.Count - 1) : null;
        var wonLabel = HitRateResultLabel(BidHitRateResult.Won);
        var lostLabel = HitRateResultLabel(BidHitRateResult.Lost);
        var wonFormula = outcomeRange is null ? null : $"COUNTIF({outcomeRange},\"{ExcelFormulaText(wonLabel)}\")";
        var lostFormula = outcomeRange is null ? null : $"COUNTIF({outcomeRange},\"{ExcelFormulaText(lostLabel)}\")";
        var kpis = new List<ReportExportKpi>
        {
            new("Vunna", WonCount, wonFormula, "integer"),
            new("Förlorade", LostCount, lostFormula, "integer"),
            new("Hit rate / träffsäkerhet", DecidedCount == 0 ? null : HitRate / 100m,
                wonFormula is null ? null : $"IFERROR(({wonFormula})/(({wonFormula})+({lostFormula})),\"\")", "percent")
        };
        var rows = included.Select(e =>
            dataCols.Select(c => (object?)GetHitRateCellValue(e, c))
                .Append(HitRateResultLabel(e.Result)));
        return new(L("hitRate"), headers, rows, sections, kpis);
    }

    private ExportModel BuildCalcExport()
    {
        var cols = CalcAllColumns.Where(c => c != CalcReportColumn.RowNumber && _visibleCalcColumns.Contains(c)).ToList();
        var headers = cols.Select(GetCalcColumnLabel).ToArray();
        var sections = new List<ReportExportSection>
        {
            new("Kalkylurval:", [_calcReportSelectionLine, _calcReportSelectionFilters, ExportIncludeNote])
        };
        var data = IncludedCalcReportList;
        var rows = data
            .Select(e => cols.Select(c => (object?)GetCalcCellValue(e, c)));
        var kpis = new List<ReportExportKpi>();
        if (cols.IndexOf(CalcReportColumn.Calculation) is var nameIndex and >= 0)
            kpis.Add(new("Antal kalkyler", data.Count, data.Count == 0 ? null : $"COUNTA({ExcelRange(nameIndex, 0, data.Count - 1)})", "integer"));
        if (cols.IndexOf(CalcReportColumn.Archived) is var archivedIndex and >= 0)
            kpis.Add(new("Antal arkiverade", data.Count(e => e.Calculation.IsArchived), data.Count == 0 ? null : $"COUNTIF({ExcelRange(archivedIndex, 0, data.Count - 1)},\"{ExcelFormulaText(L("archived"))}\")", "integer"));
        if (cols.IndexOf(CalcReportColumn.Private) is var privateIndex and >= 0)
            kpis.Add(new("Antal privata", data.Count(e => e.Calculation.IsPrivate), data.Count == 0 ? null : $"COUNTIF({ExcelRange(privateIndex, 0, data.Count - 1)},\"Privat\")", "integer"));
        return new(L("calculationListReport"), headers, rows, sections, kpis);
    }

    private ExportModel BuildProjExport()
    {
        var cols = ProjAllColumns.Where(c => c != ProjReportColumn.RowNumber && _visibleProjColumns.Contains(c)).ToList();
        var headers = cols.Select(GetProjColumnLabel).ToArray();
        var sections = new List<ReportExportSection>
        {
            new("Projekturval:", [_projReportSelectionLine, _projReportSelectionFilters, ExportIncludeNote])
        };
        var data = IncludedProjReportProjects;
        var rows = data
            .Select(e => cols.Select(c => (object?)GetProjCellValue(e, c)));
        var kpis = new List<ReportExportKpi>();
        if (cols.IndexOf(ProjReportColumn.Project) is var nameIndex and >= 0)
            kpis.Add(new("Antal projekt", data.Count, data.Count == 0 ? null : $"COUNTA({ExcelRange(nameIndex, 0, data.Count - 1)})", "integer"));
        if (cols.IndexOf(ProjReportColumn.Archived) is var archivedIndex and >= 0)
            kpis.Add(new("Antal arkiverade", data.Count(e => e.Project.IsArchived), data.Count == 0 ? null : $"COUNTIF({ExcelRange(archivedIndex, 0, data.Count - 1)},\"{ExcelFormulaText(L("archived"))}\")", "integer"));
        if (cols.IndexOf(ProjReportColumn.Shared) is var sharedIndex and >= 0)
            kpis.Add(new("Antal delade", data.Count(e => e.Project.IsShared), data.Count == 0 ? null : $"COUNTIF({ExcelRange(sharedIndex, 0, data.Count - 1)},\"Ja\")", "integer"));
        return new(L("projectListReport"), headers, rows, sections, kpis);
    }

    private ExportModel BuildBidExport()
    {
        var cols = BidExportColumns.ToList();
        var headers = cols.Select(GetBidColumnLabel).ToArray();
        // Only rows kept via "Ta med" are exported.
        var data = FilteredBidRows.Where(r => RowIncluded(BidRowKey(r))).ToList();
        var sections = new List<ReportExportSection>
        {
            new("Projekturval:", [_bidReportSelectionLine, _bidReportSelectionFilters, ExportIncludeNote]),
            new("Anbudsfilter:", [BuildBidReportFilterLine()])
        };
        var projectIndex = cols.IndexOf(BidReportColumn.Project);
        var bidderIndex = cols.IndexOf(BidReportColumn.Bidder);
        var awardedIndex = cols.IndexOf(BidReportColumn.Awarded);
        var rejectedIndex = cols.IndexOf(BidReportColumn.Rejected);
        var amountIndex = cols.IndexOf(BidReportColumn.Amount);
        var deductionIndex = cols.IndexOf(BidReportColumn.Deduction);
        var comparisonIndex = cols.IndexOf(BidReportColumn.Comparison);
        var deviationIndex = cols.IndexOf(BidReportColumn.Deviation);
        var kpis = new List<ReportExportKpi>
        {
            new("Projekt med anbud", BidProjectsWithBids.ToString()),
            new("Antal anbud", BidCount, bidderIndex < 0 || data.Count == 0 ? null : $"COUNTA({ExcelRange(bidderIndex, 0, data.Count - 1)})", "integer"),
            new("Antal anbudsgivare", BidderCount.ToString()),
            new("Tilldelade anbud", AwardedCount, awardedIndex < 0 || data.Count == 0 ? null : $"COUNTIF({ExcelRange(awardedIndex, 0, data.Count - 1)},\"Ja\")", "integer"),
            new("Förkastade anbud", data.Count(r => r.Row.Status == BidStatus.Rejected), rejectedIndex < 0 || data.Count == 0 ? null : $"COUNTIF({ExcelRange(rejectedIndex, 0, data.Count - 1)},\"Ja\")", "integer")
        };
        var exportRows = data.Select((r, rowIndex) => cols.Select(c =>
        {
            if (c == BidReportColumn.Deduction)
                return (object?)new ReportExcelCell((r.Row.DeductionPercent ?? 0) / 100m, null, "percent");
            if (c == BidReportColumn.Amount)
                return new ReportExcelCell(r.Row.Amount, null, "money");
            if (c == BidReportColumn.Comparison && amountIndex >= 0 && deductionIndex >= 0)
                return new ReportExcelCell(r.Row.ComparisonAmount,
                    $"{ExcelCell(amountIndex, rowIndex)}*(1-{ExcelCell(deductionIndex, rowIndex)})", "money");
            if (c == BidReportColumn.Deviation && comparisonIndex >= 0 && projectIndex >= 0 && data.Count > 0)
            {
                var comparisonRange = ExcelRange(comparisonIndex, 0, data.Count - 1);
                var projectRange = ExcelRange(projectIndex, 0, data.Count - 1);
                var best = HasOwnCompany && bidderIndex >= 0
                    ? $"MINIFS({comparisonRange},{projectRange},{ExcelCell(projectIndex, rowIndex)},{ExcelRange(bidderIndex, 0, data.Count - 1)},\"{ExcelFormulaText(_ownCompanyName)}\")"
                    : $"MINIFS({comparisonRange},{projectRange},{ExcelCell(projectIndex, rowIndex)})";
                return new ReportExcelCell(BidDeviationValue(r) / 100m,
                    $"IFERROR(({ExcelCell(comparisonIndex, rowIndex)}-{best})/{best},\"\")", "percent");
            }
            return (object?)GetBidCellValue(r, c);
        }));
        return new("Anbudsjämförelse", headers, exportRows, sections, kpis);
    }

    private string BuildBidReportFilterLine()
    {
        var parts = new List<string>
        {
            $"Anbudsgivare: {(_selectedBidders.Count == 0 ? "Alla" : string.Join(", ", _selectedBidders))}"
        };
        if (HasOwnCompany) parts.Add($"Jämför mot: {_ownCompanyName}");
        parts.Add($"Tilldelade: {_awardedFilter switch { "awarded" => "Endast tilldelade", "notawarded" => "Endast ej tilldelade", _ => "Alla" }}");
        parts.Add($"Visa förkastade: {(_showRejectedBids ? "Ja" : "Nej")}");
        return string.Join(" · ", parts);
    }

    // ── Helpers ───────────────────────────────────────────────────────

    private static string GetChainKey(ListCalculationMVVM c, IReadOnlyDictionary<int, ListCalculationMVVM> lookup)
    {
        var cur = c; var visited = new HashSet<int>();
        while (cur.SourceCalculationId is int sid && visited.Add(cur.Id) && lookup.TryGetValue(sid, out var src)) cur = src;
        return cur.Id.ToString();
    }

    private static int SourcePriority(CalculationVersionType t) => t switch { CalculationVersionType.Production => 3, CalculationVersionType.Contract => 2, _ => 1 };

    private string TypeLabel(CalculationVersionType t) => t switch
    {
        CalculationVersionType.Production => L("productionCalculation"),
        CalculationVersionType.Contract => L("contractCalculation"),
        _ => L("tenderCalculation")
    };

    private static string SubTypeLabel(IncomeSubType t) => t switch { IncomeSubType.Option => "Option", IncomeSubType.ATA => "ÄTA", _ => "Grunddel" };

    private static readonly CalculationRole[] CalculationRoles =
    [
        CalculationRole.MainBid, CalculationRole.SubObject, CalculationRole.Option,
        CalculationRole.ChangeOrder, CalculationRole.InternalObject, CalculationRole.Custom
    ];

    private static string GetCalculationRoleLabel(CalculationRole r) => r switch
    {
        CalculationRole.MainBid => "Huvudkalkyl / Huvudanbud", CalculationRole.SubObject => "Delobjekt",
        CalculationRole.Option => "Option", CalculationRole.ChangeOrder => "ÄTA",
        CalculationRole.InternalObject => "Internt objekt", CalculationRole.Custom => "Egen roll",
        _ => "Huvudkalkyl / Huvudanbud"
    };

    private string HitRateResultLabel(BidHitRateResult r) => r switch { BidHitRateResult.Won => L("won"), BidHitRateResult.Lost => L("lost"), _ => L("undecided") };

    private static bool HasIncome(IncomeBase income) =>
        income.Q1 != 0 || income.Q2 != 0 || income.Q3 != 0 || income.Q4 != 0;

    private int CurrentCalculationCount(ListProjectMVVM project) =>
        _calculations.Count(e => e.Project.Id == project.Id && MatchesArchive(!e.Calculation.IsArchived));

    private static string FormatMoney(decimal v) => v.ToString("N0");
    private static string FormatDate(DateTime v) => v == default ? "-" : v.ToString("yyyy-MM-dd");
    private string L(string key) => AppLoc[key].Value;

    private sealed record ProjectEntry(FolderMVVM Folder, ListProjectMVVM Project);
    private sealed record CalculationEntry(FolderMVVM Folder, ListProjectMVVM Project, ListCalculationMVVM Calculation, string ChainKey);
    private sealed record ProjectHitRateEntry(FolderMVVM Folder, ListProjectMVVM Project, BidHitRateResult Result);
    private sealed record IncomeRow(CalculationEntry Entry, int Year, IncomeSubType SubType, decimal Q1, decimal Q2, decimal Q3, decimal Q4, decimal Amount, decimal Forecast, int Probability)
    {
        public string ChainKey => $"{Entry.Project.Id}:{Entry.ChainKey}";
    }
    private sealed record ExportModel(
        string Title,
        string[] Columns,
        IEnumerable<IEnumerable<object?>> Rows,
        IReadOnlyList<ReportExportSection>? Sections = null,
        IReadOnlyList<ReportExportKpi>? Kpis = null);
}
