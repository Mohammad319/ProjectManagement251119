    private void LockProjReportProjects()
    {
        _lockedProjReportProjects = FilteredProjects.ToList();
        var count = _lockedProjReportProjects.Count;
        var deptName = CurrentDepartmentName;
        var filters = new List<string>();

        if (!string.IsNullOrEmpty(_selectedFolderId))
        {
            var f = AvailableFolders.FirstOrDefault(x => x.Id.ToString() == _selectedFolderId);
            if (f is not null) filters.Add($"Mapp: {f.Name}");
        }
        if (_selectedProjectStatuses.Count > 0) filters.Add($"Projektstatus: {string.Join(", ", _selectedProjectStatuses)}");
        var nonMissingResp = _selectedResponsibles.Where(r => r != MissingPersonValue).ToList();
        if (nonMissingResp.Count > 0) filters.Add($"Kalkylansvarig: {string.Join(", ", nonMissingResp)}");
        var nonMissingInsp = _selectedInspectors.Where(r => r != MissingPersonValue).ToList();
        if (nonMissingInsp.Count > 0) filters.Add($"Granskare: {string.Join(", ", nonMissingInsp)}");
        filters.Add(_selectedArchiveMode switch { "all" => "Arkiverade inkluderade", "archived" => "Enbart arkiverade", _ => "Arkiverade ej inkluderade" });

        bool hasFilter = filters.Count > 1 || !string.IsNullOrEmpty(_selectedFolderId) || _selectedProjectStatuses.Count > 0;
        if (!hasFilter && string.IsNullOrEmpty(_selectedFolderId))
            _projReportSelectionLine = $"Rapporten baseras på alla projekt i {deptName}.";
        else if (!hasFilter && !string.IsNullOrEmpty(_selectedFolderId))
        {
            var f = AvailableFolders.FirstOrDefault(x => x.Id.ToString() == _selectedFolderId);
            _projReportSelectionLine = $"Rapporten baseras på alla projekt i {f?.Name ?? deptName}.";
        }
        else
            _projReportSelectionLine = $"Rapporten baseras på {count} projekt från aktuell projektlista.";
        _projReportSelectionFilters = string.Join(" · ", filters);
    }

