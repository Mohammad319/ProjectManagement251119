    private sealed record BidRow(
        ProjectBidComparisonRowDTO Row,
        ListProjectMVVM? Project,
        string ProjectName,
        string FolderName);

    private void LockBidComparison()
    {
        // Exakt det låsta projekturvalet från projektlistan (LockedProjectIds) styr vilka
        // projekt som ingår – samma urval som övriga projektbaserade rapportflikar.
        var projectById = _projects
            .GroupBy(e => e.Project.Id)
            .ToDictionary(g => g.Key, g => g.First());
        var allowed = projectById.Keys.ToHashSet();

        // Avvikelse % beräknas dynamiskt (mot lägsta jämförelsesumma eller mot valt
        // "Jämför mot"-företag), så den är inte låst här – se BidProjectReference.
        _lockedBidRows = _bidRowsRaw
            .Where(r => allowed.Contains(r.ProjectId))
            .Select(r =>
            {
                projectById.TryGetValue(r.ProjectId, out var pe);
                return new BidRow(r, pe?.Project, pe?.Project.Name ?? "-", pe?.Folder.Name ?? "-");
            })
            .OrderBy(r => r.ProjectName)
            .ThenByDescending(r => r.Row.IsAwarded)
            .ThenBy(r => r.Row.Placement ?? int.MaxValue)
            .ThenBy(r => r.Row.ComparisonAmount ?? decimal.MaxValue)
            .ToList();

        _bidReportSelectionLine = string.IsNullOrWhiteSpace(_projReportSelectionLine)
            ? $"Rapporten baseras på {allowed.Count} projekt från aktuell projektlista."
            : _projReportSelectionLine;
        _bidReportSelectionFilters = _projReportSelectionFilters;
    }

