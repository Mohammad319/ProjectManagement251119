    private async Task ExportExcelAsync()
    {
        var export = BuildExport();
        var name = _activeView switch
        {
            ReportView.Income => "intaktsoversikt",
            ReportView.HitRate => "hit-rate-traffsakerhet",
            ReportView.Calculations => "kalkyllista",
            ReportView.Projects => "projektlista",
            ReportView.BidComparison => "anbudsjamforelse",
            _ => $"rapport-{_activeView}"
        };
        await ReportExportInterop.ExportExcelAsync(JS, name, ToExportHeader(export), export.Columns, export.Rows);
    }

    private async Task ExportPdfAsync()
    {
        var export = BuildExport();
        await ReportExportInterop.PrintAsync(JS, ToExportHeader(export), export.Columns, export.Rows, pdfMode: true);
    }

    private async Task PrintAsync()
    {
        var export = BuildExport();
