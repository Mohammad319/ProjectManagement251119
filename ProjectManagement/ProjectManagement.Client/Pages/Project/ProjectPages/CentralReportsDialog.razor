    // ── Calc report lock ──────────────────────────────────────────────

    private void LockCalcReportList()
    {
        // When the calling list passed an explicit calculation selection, the report must show
        // exactly those calculations (same filtered urval as the right-panel kalkyllista), not
        // re-run its own filter. The locked ids already reflect the list's filters + version mode.
        if (LockedCalculationIds is not null)
        {
            _lockedCalcShowAllVersions = LockedShowAllVersions ?? _showAllVersions;
            var idSet = LockedCalculationIds.ToHashSet();
            _lockedCalcReportList = _allVersions
                .Where(e => idSet.Contains(e.Calculation.Id))
                .GroupBy(e => e.Calculation.Id)
                .Select(g => g.First())
                .ToList();

            var versionInfoLocked = _lockedCalcShowAllVersions ? "alla versioner" : "aktuella versioner";
            _calcReportSelectionLine = $"Kalkyllistan baseras på {_lockedCalcReportList.Count} kalkyler ({versionInfoLocked}) från aktuell lista.";
            _calcReportSelectionFilters = SelectionFilterSummary ?? string.Empty;
            return;
        }

        _lockedCalcShowAllVersions = _showAllVersions;
        _lockedCalcReportList = FilteredCalculations.ToList();
        var count = _lockedCalcReportList.Count;
        var filters = new List<string>();

        if (!string.IsNullOrEmpty(_selectedFolderId))
        {
            var f = AvailableFolders.FirstOrDefault(x => x.Id.ToString() == _selectedFolderId);
            if (f is not null) filters.Add($"Mapp: {f.Name}");
        }
        if (!string.IsNullOrEmpty(_selectedProjectId)) filters.Add($"Projekt: {_projectSearch}");
        if (!string.IsNullOrWhiteSpace(_selectedCalculationType)) filters.Add($"Kalkyltyp: {_selectedCalculationType}");
        if (_selectedStatuses.Count > 0) filters.Add($"Kalkylstatus: {string.Join(", ", _selectedStatuses)}");
        var nonMissingResp = _selectedResponsibles.Where(r => r != MissingPersonValue).ToList();
        if (nonMissingResp.Count > 0) filters.Add($"Kalkylansvarig: {string.Join(", ", nonMissingResp)}");
        var nonMissingInsp = _selectedInspectors.Where(r => r != MissingPersonValue).ToList();
        if (nonMissingInsp.Count > 0) filters.Add($"Granskare: {string.Join(", ", nonMissingInsp)}");
        filters.Add(_selectedArchiveMode switch { "all" => "Arkiverade inkluderade", "archived" => "Enbart arkiverade", _ => "Arkiverade ej inkluderade" });

        var versionInfo = _lockedCalcShowAllVersions ? "alla versioner" : "aktuella versioner";
        bool hasFilter = filters.Count > 1 || !string.IsNullOrEmpty(_selectedFolderId) || !string.IsNullOrEmpty(_selectedProjectId)
            || !string.IsNullOrWhiteSpace(_selectedCalculationType) || _selectedStatuses.Count > 0;
        _calcReportSelectionLine = hasFilter
            ? $"Kalkyllistan baseras på {count} kalkyler ({versionInfo}) från aktuell lista."
            : $"Kalkyllistan baseras på alla kalkyler ({versionInfo}) i {CurrentDepartmentName}.";
        _calcReportSelectionFilters = string.Join(" · ", filters);
    }

