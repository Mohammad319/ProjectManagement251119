    private static string FormatSignedPercent(decimal v) => (v > 0 ? "+" : "") + v.ToString("0.#") + " %";
    private static string FormatNullableMoney(decimal? v) => v.HasValue ? FormatMoney(v.Value) : "-";

    // ── Avvikelse % (dynamisk referens per projekt) ───────────────────
    // Utan valt "Jämför mot"-företag: referens = lägsta jämförelsesumma i projektet.
    // Med valt företag: referens = det företagets jämförelsesumma i projektet (null
    // om företaget saknas i projektet → "-" för raderna i det projektet).
    private string? _bidRefSig;
    private Dictionary<Guid, decimal?> _bidRefMap = new();
    private IReadOnlyDictionary<Guid, decimal?> BidProjectReference
    {
        get
        {
            var sig = $"{_ownCompanyName}|{_lockedBidRows.Count}";
            if (sig != _bidRefSig) { _bidRefMap = BuildBidReference(); _bidRefSig = sig; }
            return _bidRefMap;
        }
    }

    private Dictionary<Guid, decimal?> BuildBidReference()
    {
        var dict = new Dictionary<Guid, decimal?>();
        foreach (var g in _lockedBidRows.GroupBy(r => r.Row.ProjectId))
        {
            decimal? reference;
            if (HasOwnCompany)
            {
                var refRow = g.FirstOrDefault(r => r.Row.IsValid && r.Row.ComparisonAmount.HasValue &&
                    string.Equals(r.Row.BidderName, _ownCompanyName, StringComparison.OrdinalIgnoreCase));
                reference = refRow?.Row.ComparisonAmount;
            }
            else
            {
                var valid = g.Where(r => r.Row.IsValid && r.Row.ComparisonAmount.HasValue)
                    .Select(r => r.Row.ComparisonAmount!.Value).ToList();
                reference = valid.Count > 0 ? valid.Min() : (decimal?)null;
            }
            dict[g.Key] = reference;
        }
        return dict;
    }

    private decimal? BidDeviationValue(BidRow r)
    {
        if (!r.Row.IsValid || !r.Row.ComparisonAmount.HasValue) return null;
        if (!BidProjectReference.TryGetValue(r.Row.ProjectId, out var refn) || refn is not { } reference || reference <= 0)
            return null;
        return (r.Row.ComparisonAmount.Value - reference) / reference * 100m;
    }

    private string BidDeviationText(BidRow r)
    {
        if (r.Row.Status == BidStatus.Rejected) return "Förkastat";
        var d = BidDeviationValue(r);
        return d.HasValue ? FormatSignedPercent(d.Value) : "-";
    }

