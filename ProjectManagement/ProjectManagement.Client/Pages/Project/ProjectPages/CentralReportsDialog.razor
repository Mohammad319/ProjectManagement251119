    private const string TableClass = "min-w-full table-auto text-left text-xs [&_td]:whitespace-nowrap [&_td]:px-3 [&_td]:py-2 [&_th]:whitespace-nowrap [&_th]:px-3 [&_th]:py-2";
    private const string TableHeadClass = "sticky top-0 z-10 bg-slate-50 text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:bg-slate-900 dark:text-slate-400";
    private const string TableBodyClass = "divide-y divide-slate-100 text-slate-700 dark:divide-slate-800 dark:text-slate-200";

    private string TabClass(string key) =>
        key == _activeView
            ? "rounded-md bg-sky-600 px-2.5 py-1.5 text-xs font-semibold text-white shadow-sm"
            : "rounded-md px-2.5 py-1.5 text-xs font-semibold text-slate-600 transition hover:bg-white dark:text-slate-300 dark:hover:bg-slate-800";

    private async Task ExportExcelAsync()
    {
        var export = BuildExport();
        await ReportExportInterop.ExportExcelAsync(JS, $"rapport-{_activeView}", export.Title, export.Columns, export.Rows);
    }

    private async Task ExportPdfAsync()
    {
        var export = BuildExport();
        await ReportExportInterop.PrintAsync(JS, export.Title, export.Columns, export.Rows, pdfMode: true);
    }

    private async Task PrintAsync()
    {
        var export = BuildExport();
        await ReportExportInterop.PrintAsync(JS, export.Title, export.Columns, export.Rows);
    }

    private ExportModel BuildExport() => _activeView switch
    {
        ReportView.Income => new(L("incomeOverview"),
            _showQuarters
                ? [L("folder"), L("project"), L("calculation"), L("source"), L("status"), L("year"), "Deltyp", "Q1", "Q2", "Q3", "Q4", L("revenue"), L("probability"), L("forecast")]
                : [L("folder"), L("project"), L("calculation"), L("source"), L("status"), L("year"), "Deltyp", L("revenue"), L("probability"), L("forecast")],
            FilteredIncomeRows.Select(row => _showQuarters
                ? new object?[] { row.Entry.Folder.Name, row.Entry.Project.Name, row.Entry.Calculation.Name, TypeLabel(row.Entry.Calculation.CalculationType), row.Entry.Calculation.Status, row.Year, SubTypeLabel(row.SubType), row.Q1, row.Q2, row.Q3, row.Q4, row.Amount, $"{row.Probability} %", row.Forecast }
                : new object?[] { row.Entry.Folder.Name, row.Entry.Project.Name, row.Entry.Calculation.Name, TypeLabel(row.Entry.Calculation.CalculationType), row.Entry.Calculation.Status, row.Year, SubTypeLabel(row.SubType), row.Amount, $"{row.Probability} %", row.Forecast })),
        ReportView.Projects => new(L("projectListReport"), [L("folder"), L("project"), L("code"), L("status"), L("calculationCount"), L("startDate"), L("endDate")],
            FilteredProjects.Select(entry => new object?[] { entry.Folder.Name, entry.Project.Name, entry.Project.Code, entry.Project.Status, CurrentCalculationCount(entry.Project), FormatDate(entry.Project.StartDate), FormatDate(entry.Project.EndDate) })),
        ReportView.HitRate => new(L("hitRate"), [L("folder"), L("project"), "Projektstatus", "Utfall", "Anbudsdeadline", L("calculationResponsible"), L("reviewer")],
            HitRateProjectEntries.Select(entry => new object?[] { entry.Folder.Name, entry.Project.Name, entry.Project.Status, HitRateResultLabel(entry.Result), FormatDate(entry.Project.TenderDeadline), entry.Project.Responsible, entry.Project.Inspector })),
        _ => BuildCalculationExport(L("calculationListReport"), FilteredCalculations)
    };

    private ExportModel BuildCalculationExport(string title, IEnumerable<CalculationEntry> entries) =>
        new(title, [L("folder"), L("project"), L("calculation"), L("version"), L("type"), L("status"), L("responsible"), L("reviewer")],
            entries.Select(entry => new object?[] { entry.Folder.Name, entry.Project.Name, entry.Calculation.Name, $"V.{entry.Calculation.VersionNumber:D2}", TypeLabel(entry.Calculation.CalculationType), entry.Calculation.Status, entry.Calculation.Responsible, entry.Calculation.Inspector }));

    private static string GetChainKey(ListCalculationMVVM calculation, IReadOnlyDictionary<int, ListCalculationMVVM> lookup)
    {
        var current = calculation;
        var visited = new HashSet<int>();
        while (current.SourceCalculationId is int sourceId && visited.Add(current.Id) && lookup.TryGetValue(sourceId, out var source))
            current = source;
        return current.Id.ToString();
    }

    private static int SourcePriority(CalculationVersionType type) => type switch
    {
        CalculationVersionType.Production => 3,
        CalculationVersionType.Contract => 2,
        _ => 1
    };

    private string TypeLabel(CalculationVersionType type) => type switch
    {
        CalculationVersionType.Production => L("productionCalculation"),
        CalculationVersionType.Contract => L("contractCalculation"),
        _ => L("tenderCalculation")
    };

    private static string SubTypeLabel(IncomeSubType subType) => subType switch
    {
        IncomeSubType.Option => "Option",
        IncomeSubType.ATA => "ÄTA",
        _ => "Grunddel"
    };

    private static readonly CalculationRole[] CalculationRoles =
    [
        CalculationRole.MainBid,
        CalculationRole.SubObject,
        CalculationRole.Option,
        CalculationRole.ChangeOrder,
        CalculationRole.InternalObject,
        CalculationRole.Custom
