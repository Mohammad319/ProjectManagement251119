    private IEnumerable<FolderMVVM> AvailableFolders =>
        _projects.Select(e => e.Folder).DistinctBy(f => f.Id).OrderBy(f => f.Name);

    private IEnumerable<ProjectEntry> AvailableProjects =>
        _projects.Where(e => string.IsNullOrWhiteSpace(_selectedFolderId) || e.Folder.Id.ToString() == _selectedFolderId)
            .DistinctBy(e => e.Project.Id).OrderBy(e => e.Project.Name);

    private IEnumerable<ProjectEntry> ProjectSearchResults =>
        AvailableProjects.Where(e =>
            string.IsNullOrWhiteSpace(_projectSearch) ||
            e.Project.Name.Contains(_projectSearch, StringComparison.OrdinalIgnoreCase) ||
            e.Project.Code.Contains(_projectSearch, StringComparison.OrdinalIgnoreCase) ||
            e.Folder.Name.Contains(_projectSearch, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<string> AvailableCalcStatuses =>
        _calculations.Select(e => e.Calculation.Status).Where(s => !string.IsNullOrWhiteSpace(s))
            .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s);

    private IEnumerable<string> AvailableProjectStatuses =>
        _projects.Select(e => e.Project.Status).Where(s => !string.IsNullOrWhiteSpace(s))
            .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s);

    private IEnumerable<string> AvailableResponsibles =>
        _activeView is ReportView.HitRate or ReportView.Projects
            ? _projects.Select(e => e.Project.Responsible).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s)
            : _calculations.Select(e => e.Calculation.Responsible).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s);

    private IEnumerable<string> AvailableInspectors =>
        _activeView is ReportView.HitRate or ReportView.Projects
            ? _projects.Select(e => e.Project.Inspector).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s)
            : _calculations.Select(e => e.Calculation.Inspector).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s);

    private IEnumerable<int> AvailableYears =>
        BuildIncomeRows().Select(r => r.Year)
            .Concat(_projects.Select(e => e.Project.TenderDeadline).Where(d => d != default && d.Year > 2000).Select(d => d.Year))
            .Distinct().OrderBy(y => y);

