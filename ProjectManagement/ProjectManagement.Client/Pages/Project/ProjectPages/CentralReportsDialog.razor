    private IEnumerable<CalculationEntry> ActiveCalcPool =>
        _activeView == ReportView.Calculations && _showAllVersions ? _allVersions : _calculations;

    private IEnumerable<CalculationEntry> BaseFilteredCalculations => ActiveCalcPool.Where(MatchesCalculation);
    private IEnumerable<CalculationEntry> FilteredCalculations => BaseFilteredCalculations.Where(MatchesCalculationYear);
    private IEnumerable<IncomeRow> FilteredIncomeRows => BuildIncomeRows().Where(MatchesIncome);
    private IEnumerable<IncomeRow> IncludedFilteredIncomeRows => FilteredIncomeRows.Where(r => !_excludedRowKeys.Contains(IncomeRowKey(r)));

    private IEnumerable<ProjectHitRateEntry> HitRateProjectEntries =>
        _projects
            .Where(e =>
                MatchesFolder(e.Folder) &&
                MatchesProject(e.Project) &&
                MatchesArchive(e.Project.IsVisible) &&
                MatchesHitRateYear(e.Project) &&
                MatchesHitRateQuarter(e.Project) &&
                MatchesProjectResponsible(e.Project) &&
                MatchesProjectInspector(e.Project))
            .Select(e => new ProjectHitRateEntry(e.Folder, e.Project, BidHitRateClassifier.ClassifyProject(e.Project)))
            .Where(e => e.Result != BidHitRateResult.Excluded);

    private int SubmittedCount => HitRateProjectEntries.Count();
    private int WonCount => HitRateProjectEntries.Count(e => e.Result == BidHitRateResult.Won);
    private int LostCount => HitRateProjectEntries.Count(e => e.Result == BidHitRateResult.Lost);
    private int UndecidedCount => HitRateProjectEntries.Count(e => e.Result == BidHitRateResult.Undecided);
    private decimal HitRate => WonCount + LostCount == 0 ? 0 : (decimal)WonCount / (WonCount + LostCount) * 100m;

    // ── Lifecycle ─────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        _activeView = InitialView;
        _selectedYear = string.IsNullOrEmpty(InitialYear) ? DateTime.Now.Year.ToString() : InitialYear;
        _selectedCalculationType = InitialCalculationType;
        _selectedCalculationRole = InitialCalculationRole;
        if (!string.IsNullOrWhiteSpace(InitialStatus)) _selectedStatuses.Add(InitialStatus);
        if (!string.IsNullOrWhiteSpace(InitialResponsible)) _selectedResponsibles.Add(InitialResponsible);
        if (!string.IsNullOrWhiteSpace(InitialInspector)) _selectedInspectors.Add(InitialInspector);
        _selectedFolderId = FolderScope?.Id.ToString() ?? string.Empty;
        _selectedProjectId = ProjectScope?.Id.ToString() ?? string.Empty;
        await LoadAsync();

        if (!string.IsNullOrWhiteSpace(_selectedProjectId))
        {
            var found = AvailableProjects.FirstOrDefault(p => p.Project.Id.ToString() == _selectedProjectId);
            if (found is not null) _projectSearch = ProjectDisplayLabel(found);
        }

        _isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _prefsLoaded) return;
        _prefsLoaded = true;
        bool stateChanged = false;
        stateChanged |= await LoadColumnPrefsAsync<CalcReportColumn>(CalcColumnsStorageKey, _visibleCalcColumns);
        stateChanged |= await LoadColumnPrefsAsync<ProjReportColumn>(ProjColumnsStorageKey, _visibleProjColumns);
        if (stateChanged) await InvokeAsync(StateHasChanged);
    }

    private async Task<bool> LoadColumnPrefsAsync<T>(string key, HashSet<T> target) where T : struct, Enum
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", key);
            if (string.IsNullOrWhiteSpace(json)) return false;
            var indices = System.Text.Json.JsonSerializer.Deserialize<int[]>(json);
            if (indices?.Length > 0)
            {
                target.Clear();
                foreach (var i in indices)
                    if (Enum.IsDefined(typeof(T), i))
                        target.Add((T)(object)i);
                return true;
            }
        }
        catch { }
        return false;
    }

    private async Task SaveColumnsAsync<T>(string key, HashSet<T> source) where T : struct, Enum
    {
        try
        {
            var indices = source.Select(c => (int)(object)c).ToArray();
            await JS.InvokeVoidAsync("localStorage.setItem", key, System.Text.Json.JsonSerializer.Serialize(indices));
        }
        catch { }
    }

    private async Task LoadAsync()
    {
        var folders = FolderScope is null ? Folder.State.FoldersList : [FolderScope];
        foreach (var folder in folders)
        {
            var projects = Folder.State.OtherDepartment
                ? await Repo.Project.GetOtherDepartmentAsync(folder.Id, includeArchived: true)
                : await Repo.Project.GetByFolderIdAsync(folder.Id, includeArchived: true);

            foreach (var project in projects.Where(p => ProjectScope is null || p.Id == ProjectScope.Id))
            {
                _projects.Add(new ProjectEntry(folder, project));
                await LoadCalculationsAsync(folder, project);
            }
        }

        foreach (var calc in _calculations)
        {
            try { _posts[calc.Calculation.Id] = await Repo.Calculation.GetPostAsync(calc.Calculation.Id); }
            catch (Exception ex) { await ClientLog.ErrorAsync("Loading calculation report data failed", ex: ex); }
        }
    }

    private async Task LoadCalculationsAsync(FolderMVVM folder, ListProjectMVVM project)
    {
        List<ListCalculationMVVM> all;
        if (Folder.State.OtherDepartment)
        {
            all = CalculationVersionSelector.FilterFamiliesByCurrentVisibility(
                await Repo.Calculation.GetShareCalculationsAsync(project.Id), includeArchived: true).ToList();
        }
        else
        {
            all = await Repo.Calculation.GetAsync(project.Id);
            all.AddRange(await Repo.Calculation.GetAsync(project.Id, isVisible: false));
            all = all.DistinctBy(c => c.Id).ToList();
        }

        var lookup = all.ToDictionary(c => c.Id);
        foreach (var c in all)
            _allVersions.Add(new CalculationEntry(folder, project, c, GetChainKey(c, lookup)));
        foreach (var c in CalculationVersionSelector.SelectCurrentVersions(all))
            _calculations.Add(new CalculationEntry(folder, project, c, GetChainKey(c, lookup)));
    }

    // ── Income logic ──────────────────────────────────────────────────

    private IEnumerable<IncomeRow> BuildIncomeRows()
    {
        foreach (var group in BaseFilteredCalculations.GroupBy(e => $"{e.Project.Id}:{e.ChainKey}"))
        {
            var sel = ChooseIncomeSource(group);
            if (sel is null || !_posts.TryGetValue(sel.Calculation.Id, out var post)) continue;
            foreach (var income in post.Income ?? [])
            {
                if (income.Year <= 0 || !HasIncome(income)) continue;
                var amount = income.Q1 + income.Q2 + income.Q3 + income.Q4;
                var prob = sel.Calculation.Priority is > 0 and <= 100 ? sel.Calculation.Priority : 100;
                yield return new IncomeRow(sel, income.Year, income.SubType, income.Q1, income.Q2, income.Q3, income.Q4, amount, amount * prob / 100m, prob);
            }
        }
    }

    private static string IncomeRowKey(IncomeRow r) => $"{r.Entry.Calculation.Id}:{r.Year}:{(int)r.SubType}";
    private void ToggleRowInclusion(string key) { if (!_excludedRowKeys.Remove(key)) _excludedRowKeys.Add(key); }

    private IReadOnlyList<IncomeTableRow> BuildIncomeTableRows()
    {
        var result = new List<IncomeTableRow>();
        var incl = IncludedFilteredIncomeRows.ToList();
        var all = FilteredIncomeRows.ToList();

        foreach (var pg in all.GroupBy(r => r.Entry.Project.Id))
        {
            bool fp = true;
            foreach (var cg in pg.GroupBy(r => r.Entry.Calculation.Id))
            {
                bool fc = true;
                foreach (var row in cg)
                {
                    result.Add(new IncomeTableRow
                    {
                        Kind = IncomeTableRowKind.Data, RowKey = IncomeRowKey(row),
                        FolderName = row.Entry.Folder.Name, ProjectName = row.Entry.Project.Name,
                        CalcName = row.Entry.Calculation.Name, SourceLabel = TypeLabel(row.Entry.Calculation.CalculationType),
                        Status = row.Entry.Calculation.Status, Year = row.Year, SubTypeText = SubTypeLabel(row.SubType),
                        Q1 = row.Q1, Q2 = row.Q2, Q3 = row.Q3, Q4 = row.Q4,
                        Amount = row.Amount, Probability = row.Probability, Forecast = row.Forecast,
                        IsFirstForProject = fp, IsFirstForCalc = fc
                    });
                    fp = false; fc = false;
                }
            }
            var inclP = incl.Where(r => r.Entry.Project.Id == pg.Key).ToList();
            if (pg.Count() > 1 && inclP.Count > 0)
                result.Add(new IncomeTableRow { Kind = IncomeTableRowKind.ProjectSum, SummaryLabel = $"Summa projekt: {pg.First().Entry.Project.Name}", Q1 = inclP.Sum(r => r.Q1), Q2 = inclP.Sum(r => r.Q2), Q3 = inclP.Sum(r => r.Q3), Q4 = inclP.Sum(r => r.Q4), Amount = inclP.Sum(r => r.Amount), Forecast = inclP.Sum(r => r.Forecast) });
        }

        if (incl.Count > 1)
        {
            result.Add(new IncomeTableRow { Kind = IncomeTableRowKind.GrandTotal, SummaryLabel = "Totalt", Q1 = incl.Sum(r => r.Q1), Q2 = incl.Sum(r => r.Q2), Q3 = incl.Sum(r => r.Q3), Q4 = incl.Sum(r => r.Q4), Amount = incl.Sum(r => r.Amount), Forecast = incl.Sum(r => r.Forecast) });
            if (string.IsNullOrEmpty(_selectedSubType) && incl.Select(r => r.SubType).Distinct().Count() > 1)
                foreach (var sg in incl.GroupBy(r => r.SubType).OrderBy(g => g.Key))
                    result.Add(new IncomeTableRow { Kind = IncomeTableRowKind.SubTypeTotal, SummaryLabel = $"Summa {SubTypeLabel(sg.Key)}", Q1 = sg.Sum(r => r.Q1), Q2 = sg.Sum(r => r.Q2), Q3 = sg.Sum(r => r.Q3), Q4 = sg.Sum(r => r.Q4), Amount = sg.Sum(r => r.Amount), Forecast = sg.Sum(r => r.Forecast) });
        }
        return result;
    }

    private static string IncomeRowClass(IncomeTableRowKind kind) => kind switch
    {
        IncomeTableRowKind.GrandTotal => "border-t-2 border-slate-400 bg-white font-bold text-slate-900 dark:border-slate-500 dark:bg-slate-950 dark:text-slate-100",
        IncomeTableRowKind.SubTypeTotal => "bg-slate-50 text-xs italic text-slate-500 dark:bg-slate-900/40 dark:text-slate-400",
        _ => "bg-slate-50 font-semibold italic text-slate-600 dark:bg-slate-900/60 dark:text-slate-300"
    };

    private CalculationEntry? ChooseIncomeSource(IEnumerable<CalculationEntry> entries)
    {
        var cands = entries;
        if (Enum.TryParse<CalculationVersionType>(_selectedIncomeSource, out var rt))
            cands = cands.Where(e => e.Calculation.CalculationType == rt);
        return cands
            .OrderByDescending(e => _selectedIncomeSource == "auto" ? SourcePriority(e.Calculation.CalculationType) : 0)
            .ThenByDescending(e => e.Calculation.UpdatedAt ?? e.Calculation.CreatedAt)
            .ThenByDescending(e => e.Calculation.Id)
            .FirstOrDefault();
    }

    // ── Matching ──────────────────────────────────────────────────────

    private bool MatchesCalculation(CalculationEntry entry)
    {
        var c = entry.Calculation;
        if (!MatchesFolder(entry.Folder) || !MatchesProject(entry.Project) || !MatchesArchive(c.IsVisible)) return false;
        if (!string.IsNullOrWhiteSpace(_selectedCalculationType) && c.CalculationType.ToString() != _selectedCalculationType) return false;
        if (Enum.TryParse<CalculationRole>(_selectedCalculationRole, out var role) && c.CalculationRole != role) return false;
        if (_selectedStatuses.Count > 0 && !_selectedStatuses.Contains(c.Status ?? string.Empty)) return false;
        if (!MatchesPersonField(c.Responsible, _selectedResponsibles)) return false;
        if (!MatchesPersonField(c.Inspector, _selectedInspectors)) return false;
        return true;
    }

    private bool MatchesIncome(IncomeRow row)
    {
        if (!string.IsNullOrWhiteSpace(_selectedYear) && int.TryParse(_selectedYear, out var yr) && row.Year != yr) return false;
        if (!string.IsNullOrWhiteSpace(_selectedSubType) && int.TryParse(_selectedSubType, out var st) && (int)row.SubType != st) return false;
        return _selectedQuarter switch { 1 => row.Q1 != 0, 2 => row.Q2 != 0, 3 => row.Q3 != 0, 4 => row.Q4 != 0, _ => true };
    }

    private bool MatchesCalculationYear(CalculationEntry entry)
    {
        if (string.IsNullOrWhiteSpace(_selectedYear) || !int.TryParse(_selectedYear, out var yr)) return true;
        var c = entry.Calculation;
        return c.StartDate.Year == yr || c.EndDate.Year == yr || (c.TenderDeadline != default && c.TenderDeadline.Year == yr);
    }

    private bool MatchesFolder(FolderMVVM folder) =>
        string.IsNullOrWhiteSpace(_selectedFolderId) || folder.Id.ToString() == _selectedFolderId;

    private bool MatchesProject(ListProjectMVVM project) =>
        string.IsNullOrWhiteSpace(_selectedProjectId) || project.Id.ToString() == _selectedProjectId;

    private bool MatchesArchive(bool isVisible) => _selectedArchiveMode switch { "all" => true, "archived" => !isVisible, _ => isVisible };

    private bool MatchesProjectStatus(ListProjectMVVM project) =>
        _selectedProjectStatuses.Count == 0 || _selectedProjectStatuses.Contains(project.Status ?? string.Empty);

    private bool MatchesHitRateYear(ListProjectMVVM project)
    {
        if (string.IsNullOrWhiteSpace(_selectedYear) || !int.TryParse(_selectedYear, out var yr)) return true;
        if (project.TenderDeadline != default && project.TenderDeadline.Year == yr) return true;
        return project.StartDate.Year == yr || project.EndDate.Year == yr;
    }

    private bool MatchesHitRateQuarter(ListProjectMVVM project)
    {
        if (_selectedQuarter == 0) return true;
        if (project.TenderDeadline == default) return true;
        return ((project.TenderDeadline.Month - 1) / 3) + 1 == _selectedQuarter;
    }

    private bool MatchesPersonField(string? value, HashSet<string> selected)
    {
        if (selected.Count == 0) return true;
        var v = value ?? string.Empty;
        return string.IsNullOrWhiteSpace(v) ? selected.Contains(MissingPersonValue) : selected.Contains(v);
    }

    private bool MatchesProjectResponsible(ListProjectMVVM p) => MatchesPersonField(p.Responsible, _selectedResponsibles);
    private bool MatchesProjectInspector(ListProjectMVVM p) => MatchesPersonField(p.Inspector, _selectedInspectors);

    // ── Event handlers ────────────────────────────────────────────────

    private void OnFolderChanged(ChangeEventArgs e)
    {
        _selectedFolderId = e.Value?.ToString() ?? string.Empty;
        _selectedProjectId = string.Empty; _projectSearch = string.Empty;
    }

    private void ToggleStatus(string s, bool v) { if (v) _selectedStatuses.Add(s); else _selectedStatuses.Remove(s); }
    private void ToggleProjectStatus(string s, bool v) { if (v) _selectedProjectStatuses.Add(s); else _selectedProjectStatuses.Remove(s); }
    private void ToggleResponsible(string s, bool v) { if (v) _selectedResponsibles.Add(s); else _selectedResponsibles.Remove(s); }
    private void ToggleInspector(string s, bool v) { if (v) _selectedInspectors.Add(s); else _selectedInspectors.Remove(s); }

    private async Task ToggleCalcColumn(CalcReportColumn col, bool include)
    {
        if (include) _visibleCalcColumns.Add(col); else _visibleCalcColumns.Remove(col);
        await SaveColumnsAsync(CalcColumnsStorageKey, _visibleCalcColumns);
    }
    private async Task SaveCalcColumnsAsync() => await SaveColumnsAsync(CalcColumnsStorageKey, _visibleCalcColumns);

    private async Task ToggleProjColumn(ProjReportColumn col, bool include)
    {
        if (include) _visibleProjColumns.Add(col); else _visibleProjColumns.Remove(col);
        await SaveColumnsAsync(ProjColumnsStorageKey, _visibleProjColumns);
    }
    private async Task SaveProjColumnsAsync() => await SaveColumnsAsync(ProjColumnsStorageKey, _visibleProjColumns);

    private void OnProjectSearchInput(ChangeEventArgs e)
    {
        _projectSearch = e.Value?.ToString() ?? string.Empty;
        _showProjectDropdown = true;
        if (string.IsNullOrWhiteSpace(_projectSearch)) _selectedProjectId = string.Empty;
    }

    private void SelectProject(ProjectEntry? entry)
    {
        _selectedProjectId = entry?.Project.Id.ToString() ?? string.Empty;
        _projectSearch = entry is not null ? ProjectDisplayLabel(entry) : string.Empty;
        _showProjectDropdown = false;
    }

    private void CloseProjectDropdown() => _showProjectDropdown = false;

    private void OnProjectKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") { _showProjectDropdown = false; _selectedProjectId = string.Empty; _projectSearch = string.Empty; }
    }

    private string ProjectDisplayLabel(ProjectEntry e)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(e.Project.Code)) parts.Add(e.Project.Code);
        if (!string.IsNullOrWhiteSpace(e.Project.Name)) parts.Add(e.Project.Name);
        if (!string.IsNullOrWhiteSpace(e.Folder.Name)) parts.Add(e.Folder.Name);
        return string.Join(" – ", parts);
    }

