@using Microsoft.JSInterop
@using ProjectManagement.Client.Helper
@using ProjectManagement.Client.Shared.MVVM.Calculation
@using ProjectManagement.Client.Shared.MVVM.Folder
@using ProjectManagement.Shared.Base.Calculation
@using ProjectManagement.Shared.DTO.Calculation
@using ProjectManagement.Shared.Enums
@using ProjectManagement.Shared.Helper
@inject IJSRuntime JS
@inherits AppComponentBase

<div class="space-y-3 text-slate-800 dark:text-slate-100">
    <div class="flex flex-wrap gap-1 rounded-lg border border-slate-200 bg-slate-50 p-1 dark:border-slate-700 dark:bg-slate-900">
        @foreach (var report in ReportTabs)
        {
            <button type="button"
                    class="@TabClass(report.Key)"
                    @onclick="() => _activeView = report.Key">
                @report.Label
            </button>
        }
    </div>

    @if (_isLoading)
    {
        <BlazorMHD.UI.Components.Feedback.Loading.MhdLoading />
    }
    else
    {
        <div class="grid grid-cols-2 gap-2 rounded-lg border border-slate-200 bg-white p-3 shadow-sm dark:border-slate-800 dark:bg-slate-950 md:grid-cols-4 xl:grid-cols-6">
            <div>
                <label class="@LabelClass">@AppLoc["department"]</label>
                <select class="@SelectClass" disabled>
                    <option>@CurrentDepartmentName</option>
                </select>
            </div>
            <div>
                <label class="@LabelClass">@AppLoc["folder"]</label>
                <select class="@SelectClass" @bind="_selectedFolderId">
                    <option value="">@AppLoc["allFolders"]</option>
                    @foreach (var folder in AvailableFolders)
                    {
                        <option value="@folder.Id">@folder.Name</option>
                    }
                </select>
            </div>
            <div class="relative">
                <label class="@LabelClass">@AppLoc["project"]</label>
                <input type="text"
                       class="@SelectClass"
                       placeholder="@AppLoc["allProjects"]"
                       value="@_projectSearch"
                       @oninput="OnProjectSearchInput"
                       @onfocus="() => _showProjectDropdown = true"
                       @onkeydown="OnProjectKeyDown"
                       autocomplete="off" />
                @if (_showProjectDropdown)
                {
                    <div class="fixed inset-0 z-40" @onclick="CloseProjectDropdown"></div>
                    <div class="absolute z-50 mt-0.5 max-h-52 w-full overflow-auto rounded-md border border-slate-200 bg-white shadow-lg dark:border-slate-700 dark:bg-slate-900">
                        <div class="cursor-pointer px-3 py-1.5 text-xs text-slate-500 hover:bg-sky-50 dark:hover:bg-sky-950/30"
                             @onclick="() => SelectProject(null)">
                            @AppLoc["allProjects"]
                        </div>
                        @foreach (var entry in ProjectSearchResults)
                        {
                            var entryCapture = entry;
                            <div class="cursor-pointer px-3 py-1.5 text-xs text-slate-800 hover:bg-sky-50 dark:text-slate-200 dark:hover:bg-sky-950/30"
                                 @onclick="() => SelectProject(entryCapture)">
                                @ProjectDisplayLabel(entryCapture)
                            </div>
                        }
                    </div>
                }
            </div>
            @if (_activeView != ReportView.HitRate)
            {
                <div>
                    <label class="@LabelClass">@AppLoc["calculationType"]</label>
                    <select class="@SelectClass" @bind="_selectedCalculationType">
                        <option value="">@AppLoc["allCalculationTypes"]</option>
                        <option value="@CalculationVersionType.Tender">@AppLoc["tenderCalculation"]</option>
                        <option value="@CalculationVersionType.Contract">@AppLoc["contractCalculation"]</option>
                        <option value="@CalculationVersionType.Production">@AppLoc["productionCalculation"]</option>
                    </select>
                </div>
            }
            <div>
                <label class="@LabelClass">@(_activeView == ReportView.HitRate ? "Projektstatus" : AppLoc["status"].Value)</label>
                <select class="@SelectClass" @bind="_selectedStatus">
                    <option value="">@AppLoc["allStatuses"]</option>
                    @if (_activeView == ReportView.HitRate)
                    {
                        @foreach (var status in AvailableProjectStatuses)
                        {
                            <option value="@status">@status</option>
                        }
                    }
                    else
                    {
                        @foreach (var status in AvailableStatuses)
                        {
                            <option value="@status">@status</option>
                        }
                    }
                </select>
            </div>
            @if (_activeView != ReportView.HitRate)
            {
                <div>
                    <label class="@LabelClass">Kalkylroll</label>
                    <select class="@SelectClass" @bind="_selectedCalculationRole">
                        <option value="">@AppLoc["allItems"]</option>
                        @foreach (var role in CalculationRoles)
                        {
                            <option value="@role">@GetCalculationRoleLabel(role)</option>
                        }
                    </select>
                </div>
            }
            <div>
                <label class="@LabelClass">@AppLoc["year"]</label>
                <select class="@SelectClass" @bind="_selectedYear">
                    <option value="">@AppLoc["allYears"]</option>
                    @foreach (var year in AvailableYears)
                    {
                        <option value="@year">@year</option>
                    }
                </select>
            </div>
            <div>
                <label class="@LabelClass">@AppLoc["quarter"]</label>
                <select class="@SelectClass" @bind="_selectedQuarter">
                    <option value="0">@AppLoc["allQuarters"]</option>
                    <option value="1">Q1</option>
                    <option value="2">Q2</option>
                    <option value="3">Q3</option>
                    <option value="4">Q4</option>
                </select>
            </div>
            <div>
                <label class="@LabelClass">@AppLoc["calculationResponsible"]</label>
                <input class="@SelectClass" @bind="_selectedResponsible" @bind:event="oninput" />
            </div>
            <div>
                <label class="@LabelClass">@AppLoc["reviewer"]</label>
                <input class="@SelectClass" @bind="_selectedInspector" @bind:event="oninput" />
            </div>
            <div>
                <label class="@LabelClass">@AppLoc["archivedItems"]</label>
                <select class="@SelectClass" @bind="_selectedArchiveMode">
                    <option value="active">@AppLoc["notArchived"]</option>
                    <option value="all">@AppLoc["allItems"]</option>
                    <option value="archived">@AppLoc["archivedOnly"]</option>
                </select>
            </div>
            @if (_activeView != ReportView.HitRate)
            {
                <div>
                    <label class="@LabelClass">@AppLoc["incomeSource"]</label>
                    <select class="@SelectClass" @bind="_selectedIncomeSource">
                        <option value="auto">@AppLoc["automatic"]</option>
                        <option value="@CalculationVersionType.Tender">@AppLoc["tenderCalculation"]</option>
                        <option value="@CalculationVersionType.Contract">@AppLoc["contractCalculation"]</option>
                        <option value="@CalculationVersionType.Production">@AppLoc["productionCalculation"]</option>
                    </select>
                </div>
            }
            @if (_activeView == ReportView.Income)
            {
                <div>
                    <label class="@LabelClass">Deltyp</label>
                    <select class="@SelectClass" @bind="_selectedSubType">
                        <option value="">@AppLoc["allItems"]</option>
                        <option value="@((int)IncomeSubType.Grunddel)">Grunddel</option>
                        <option value="@((int)IncomeSubType.Option)">Option</option>
                        <option value="@((int)IncomeSubType.ATA)">ÄTA</option>
                    </select>
                </div>
            }
        </div>

        <div class="flex flex-wrap justify-between gap-2">
            <p class="text-xs text-slate-500 dark:text-slate-400">
                @if (_activeView == ReportView.HitRate)
                {
                    <span>Hit rate baseras på Projektstatus och räknas en gång per projekt/upphandling. Kalkylstatus, Kalkyltyp och Inkomstkälla påverkar inte huvud-Hit rate.</span>
                }
                else
                {
                    @AppLoc["reportCurrentVersionRule"]
                }
            </p>
            <div class="flex flex-wrap gap-1.5">
                <button type="button" class="@ActionButtonClass" @onclick="ExportExcelAsync">@AppLoc["exportExcel"]</button>
                <button type="button" class="@ActionButtonClass" @onclick="ExportPdfAsync">@AppLoc["exportPdf"]</button>
                <button type="button" class="@ActionButtonClass" @onclick="PrintAsync">@AppLoc["print"]</button>
            </div>
        </div>

        @if (_activeView == ReportView.Income)
        {
            <div class="flex flex-wrap items-center justify-between gap-2">
                <div class="grid grid-cols-2 gap-2 md:grid-cols-4">
                    <div class="@TotalCardClass"><span>@AppLoc["revenue"]</span><strong>@FormatMoney(FilteredIncomeRows.Sum(r => r.Amount))</strong></div>
                    <div class="@TotalCardClass"><span>@AppLoc["forecast"]</span><strong>@FormatMoney(FilteredIncomeRows.Sum(r => r.Forecast))</strong></div>
                    <div class="@TotalCardClass"><span>Projekt</span><strong>@FilteredIncomeRows.Select(r => r.Entry.Project.Id).Distinct().Count()</strong></div>
                    <div class="@TotalCardClass"><span>@AppLoc["rows"]</span><strong>@FilteredIncomeRows.Count()</strong></div>
                </div>
                <button type="button"
                        class="@(_showQuarters ? "inline-flex h-8 items-center rounded-lg bg-sky-600 px-3 text-xs font-semibold text-white shadow-sm transition hover:bg-sky-700" : ActionButtonClass)"
                        @onclick="() => _showQuarters = !_showQuarters">
                    @(_showQuarters ? "Dölj Q1–Q4" : "Visa Q1–Q4")
                </button>
            </div>
            <div class="@TableContainerClass">
                <table class="@TableClass">
                    <thead class="@TableHeadClass">
                        <tr>
                            <th>@AppLoc["folder"]</th>
                            <th>@AppLoc["project"]</th>
                            <th>@AppLoc["calculation"]</th>
                            <th>@AppLoc["source"]</th>
                            <th>@AppLoc["status"]</th>
                            <th>@AppLoc["year"]</th>
                            <th>Deltyp</th>
                            @if (_showQuarters) { <th>Q1</th><th>Q2</th><th>Q3</th><th>Q4</th> }
                            <th>@AppLoc["revenue"]</th>
                            <th>@AppLoc["probability"]</th>
                            <th>@AppLoc["forecast"]</th>
                        </tr>
                    </thead>
                    <tbody class="@TableBodyClass">
                        @foreach (var row in BuildIncomeTableRows())
                        {
                            @if (row.Kind == IncomeTableRowKind.Data)
                            {
                                <tr>
                                    <td>@(row.IsFirstForProject ? row.FolderName : "")</td>
                                    <td>@(row.IsFirstForProject ? row.ProjectName : "")</td>
                                    <td>@(row.IsFirstForCalc ? row.CalcName : "")</td>
                                    <td>@(row.IsFirstForCalc ? row.SourceLabel : "")</td>
                                    <td>@(row.IsFirstForCalc ? row.Status : "")</td>
                                    <td>@row.Year</td>
                                    <td>@row.SubTypeText</td>
                                    @if (_showQuarters) { <td>@FormatMoney(row.Q1)</td><td>@FormatMoney(row.Q2)</td><td>@FormatMoney(row.Q3)</td><td>@FormatMoney(row.Q4)</td> }
                                    <td>@FormatMoney(row.Amount)</td>
                                    <td>@row.Probability %</td>
                                    <td class="font-semibold">@FormatMoney(row.Forecast)</td>
                                </tr>
                            }
                            else
                            {
                                <tr class="@IncomeRowClass(row.Kind)">
                                    <td colspan="@(_showQuarters ? 7 : 3)">@row.SummaryLabel</td>
                                    @if (_showQuarters) { <td>@FormatMoney(row.Q1)</td><td>@FormatMoney(row.Q2)</td><td>@FormatMoney(row.Q3)</td><td>@FormatMoney(row.Q4)</td> }
                                    <td>@FormatMoney(row.Amount)</td>
                                    <td></td>
                                    <td>@FormatMoney(row.Forecast)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
        else if (_activeView == ReportView.HitRate)
        {
            <div class="grid grid-cols-2 gap-2 md:grid-cols-5">
                <div class="@TotalCardClass"><span>@AppLoc["submitted"]</span><strong>@SubmittedCount</strong></div>
                <div class="@TotalCardClass"><span>@AppLoc["won"]</span><strong>@WonCount</strong></div>
                <div class="@TotalCardClass"><span>@AppLoc["lost"]</span><strong>@LostCount</strong></div>
                <div class="@TotalCardClass"><span>@AppLoc["undecided"]</span><strong>@UndecidedCount</strong></div>
                <div class="@TotalCardClass"><span>@AppLoc["hitRate"]</span><strong>@HitRate.ToString("N1") %</strong></div>
            </div>
            @HitRateProjectTable()
        }
        else if (_activeView == ReportView.Calculations)
        {
            @CalculationTable(FilteredCalculations)
        }
        else if (_activeView == ReportView.Projects)
        {
            @ProjectTable()
        }
    }
</div>

@code {
    public static class ReportView
    {
        public const string Income = "income";
        public const string HitRate = "hit-rate";
        public const string Calculations = "calculations";
        public const string Projects = "projects";
        public const string Export = "export";
    }

    private enum IncomeTableRowKind { Data, ProjectSum, GrandTotal, SubTypeTotal }

    private sealed class IncomeTableRow
    {
        public IncomeTableRowKind Kind { get; init; }
        public string FolderName { get; init; } = "";
        public string ProjectName { get; init; } = "";
        public string CalcName { get; init; } = "";
        public string SourceLabel { get; init; } = "";
        public string Status { get; init; } = "";
        public int Year { get; init; }
        public string SubTypeText { get; init; } = "";
        public decimal Q1 { get; init; }
        public decimal Q2 { get; init; }
        public decimal Q3 { get; init; }
        public decimal Q4 { get; init; }
        public decimal Amount { get; init; }
        public int Probability { get; init; }
        public decimal Forecast { get; init; }
        public bool IsFirstForProject { get; init; }
        public bool IsFirstForCalc { get; init; }
        public string SummaryLabel { get; init; } = "";
    }

    [Parameter] public FolderMVVM? FolderScope { get; set; }
    [Parameter] public ListProjectMVVM? ProjectScope { get; set; }
    [Parameter] public string InitialView { get; set; } = ReportView.Income;
    [Parameter] public string InitialStatus { get; set; } = string.Empty;
    [Parameter] public string InitialYear { get; set; } = string.Empty;
    [Parameter] public string InitialCalculationType { get; set; } = string.Empty;
    [Parameter] public string InitialCalculationRole { get; set; } = string.Empty;
    [Parameter] public string InitialResponsible { get; set; } = string.Empty;
    [Parameter] public string InitialInspector { get; set; } = string.Empty;

    private bool _isLoading = true;
    private string _activeView = ReportView.Income;
    private string _selectedFolderId = string.Empty;
    private string _selectedProjectId = string.Empty;
    private string _selectedCalculationType = string.Empty;
    private string _selectedCalculationRole = string.Empty;
    private string _selectedStatus = string.Empty;
    private string _selectedYear = string.Empty;
    private int _selectedQuarter;
    private string _selectedResponsible = string.Empty;
    private string _selectedInspector = string.Empty;
    private string _selectedArchiveMode = "active";
    private string _selectedIncomeSource = "auto";
    private string _selectedSubType = string.Empty;
    private bool _showQuarters;
    private string _projectSearch = string.Empty;
    private bool _showProjectDropdown;

    private readonly List<ProjectEntry> _projects = [];
    private readonly List<CalculationEntry> _calculations = [];
    private readonly Dictionary<int, CalculationPostDTO> _posts = [];

    private const string LabelClass = "mb-1 block text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400";
    private const string SelectClass = "h-8 w-full rounded-md border border-slate-300 bg-white px-2 text-xs text-slate-800 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 disabled:bg-slate-100 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:disabled:bg-slate-800";
    private const string ActionButtonClass = "inline-flex h-8 items-center rounded-lg border border-slate-300 bg-white px-2.5 text-xs font-semibold text-slate-700 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800";
    private const string TotalCardClass = "flex flex-col gap-1 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs text-slate-500 shadow-sm dark:border-slate-800 dark:bg-slate-950 dark:text-slate-400 [&_strong]:text-base [&_strong]:text-slate-900 dark:[&_strong]:text-slate-100";

    private IReadOnlyList<(string Key, string Label)> ReportTabs =>
    [
        (ReportView.Income, L("incomeOverview")),
        (ReportView.HitRate, L("hitRate")),
        (ReportView.Calculations, L("calculationListReport")),
        (ReportView.Projects, L("projectListReport"))
    ];

    private IEnumerable<FolderMVVM> AvailableFolders =>
        _projects.Select(entry => entry.Folder).DistinctBy(f => f.Id).OrderBy(f => f.Name);

    private IEnumerable<ProjectEntry> AvailableProjects =>
        _projects.Where(entry => string.IsNullOrWhiteSpace(_selectedFolderId) || entry.Folder.Id.ToString() == _selectedFolderId)
            .DistinctBy(entry => entry.Project.Id)
            .OrderBy(entry => entry.Project.Name);

    private IEnumerable<ProjectEntry> ProjectSearchResults =>
        AvailableProjects.Where(entry =>
            string.IsNullOrWhiteSpace(_projectSearch) ||
            entry.Project.Name.Contains(_projectSearch, StringComparison.OrdinalIgnoreCase) ||
            entry.Project.Code.Contains(_projectSearch, StringComparison.OrdinalIgnoreCase) ||
            entry.Folder.Name.Contains(_projectSearch, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<string> AvailableStatuses =>
        _calculations.Select(entry => entry.Calculation.Status)
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(s => s);

    private IEnumerable<string> AvailableProjectStatuses =>
        _projects.Select(entry => entry.Project.Status)
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(s => s);

    private IEnumerable<int> AvailableYears =>
        BuildIncomeRows().Select(r => r.Year)
            .Concat(_projects
                .Select(e => e.Project.TenderDeadline)
                .Where(d => d != default && d.Year > 2000)
                .Select(d => d.Year))
            .Distinct()
            .OrderBy(y => y);

    private string CurrentDepartmentName =>
        Folder.State.Departments.FirstOrDefault(d => d.Id == Folder.State.SelectedDepartmentId)?.Name
        ?? L("currentDepartment");

    private IEnumerable<ProjectEntry> FilteredProjects =>
        _projects.Where(entry =>
            MatchesFolder(entry.Folder) &&
            MatchesProject(entry.Project) &&
            MatchesArchive(entry.Project.IsVisible));

    private IEnumerable<CalculationEntry> BaseFilteredCalculations =>
        _calculations.Where(MatchesCalculation);

    private IEnumerable<CalculationEntry> FilteredCalculations =>
        BaseFilteredCalculations.Where(MatchesCalculationYear);

    private IEnumerable<IncomeRow> FilteredIncomeRows =>
        BuildIncomeRows().Where(MatchesIncome);

    private IEnumerable<ProjectHitRateEntry> HitRateProjectEntries =>
        _projects
            .Where(entry =>
                MatchesFolder(entry.Folder) &&
                MatchesProject(entry.Project) &&
                MatchesArchive(entry.Project.IsVisible) &&
                MatchesHitRateStatus(entry.Project) &&
                MatchesHitRateYear(entry.Project) &&
                MatchesHitRateResponsible(entry.Project) &&
                MatchesHitRateInspector(entry.Project))
            .Select(entry => new ProjectHitRateEntry(
                entry.Folder,
                entry.Project,
                BidHitRateClassifier.ClassifyProject(entry.Project)))
            .Where(entry => entry.Result != BidHitRateResult.Excluded);

    private int SubmittedCount => HitRateProjectEntries.Count();
    private int WonCount => HitRateProjectEntries.Count(e => e.Result == BidHitRateResult.Won);
    private int LostCount => HitRateProjectEntries.Count(e => e.Result == BidHitRateResult.Lost);
    private int UndecidedCount => HitRateProjectEntries.Count(e => e.Result == BidHitRateResult.Undecided);
    private decimal HitRate => WonCount + LostCount == 0 ? 0 : (decimal)WonCount / (WonCount + LostCount) * 100m;

    protected override async Task OnInitializedAsync()
    {
        _activeView = InitialView;
        _selectedStatus = InitialStatus;
        _selectedYear = string.IsNullOrEmpty(InitialYear) ? DateTime.Now.Year.ToString() : InitialYear;
        _selectedCalculationType = InitialCalculationType;
        _selectedCalculationRole = InitialCalculationRole;
        _selectedResponsible = InitialResponsible;
        _selectedInspector = InitialInspector;
        _selectedFolderId = FolderScope?.Id.ToString() ?? string.Empty;
        _selectedProjectId = ProjectScope?.Id.ToString() ?? string.Empty;
        await LoadAsync();

        if (!string.IsNullOrWhiteSpace(_selectedProjectId))
        {
            var entry = AvailableProjects.FirstOrDefault(p => p.Project.Id.ToString() == _selectedProjectId);
            if (entry is not null)
                _projectSearch = ProjectDisplayLabel(entry);
        }

        _isLoading = false;
    }

    private async Task LoadAsync()
    {
        var folders = FolderScope is null ? Folder.State.FoldersList : [FolderScope];
        foreach (var folder in folders)
        {
            var projects = Folder.State.OtherDepartment
                ? await Repo.Project.GetOtherDepartmentAsync(folder.Id, includeArchived: true)
                : await Repo.Project.GetByFolderIdAsync(folder.Id, includeArchived: true);

            foreach (var project in projects.Where(p => ProjectScope is null || p.Id == ProjectScope.Id))
            {
                _projects.Add(new ProjectEntry(folder, project));
                await LoadCalculationsAsync(folder, project);
            }
        }

        foreach (var calculation in _calculations)
        {
            try
            {
                _posts[calculation.Calculation.Id] = await Repo.Calculation.GetPostAsync(calculation.Calculation.Id);
            }
            catch (Exception ex)
            {
                await ClientLog.ErrorAsync("Loading calculation report data failed", ex: ex);
            }
        }
    }

    private async Task LoadCalculationsAsync(FolderMVVM folder, ListProjectMVVM project)
    {
        List<ListCalculationMVVM> all;
        if (Folder.State.OtherDepartment)
        {
            all = CalculationVersionSelector
                .FilterFamiliesByCurrentVisibility(
                    await Repo.Calculation.GetShareCalculationsAsync(project.Id),
                    includeArchived: true)
                .ToList();
        }
        else
        {
            all = await Repo.Calculation.GetAsync(project.Id);
            all.AddRange(await Repo.Calculation.GetAsync(project.Id, isVisible: false));
            all = all.DistinctBy(c => c.Id).ToList();
        }

        var lookup = all.ToDictionary(c => c.Id);
        foreach (var calculation in CalculationVersionSelector.SelectCurrentVersions(all))
            _calculations.Add(new CalculationEntry(folder, project, calculation, GetChainKey(calculation, lookup)));
    }

    private IEnumerable<IncomeRow> BuildIncomeRows()
    {
        foreach (var group in BaseFilteredCalculations.GroupBy(entry => $"{entry.Project.Id}:{entry.ChainKey}"))
        {
            var selected = ChooseIncomeSource(group);
            if (selected is null || !_posts.TryGetValue(selected.Calculation.Id, out var post))
                continue;

            foreach (var income in post.Income ?? [])
            {
                if (income.Year <= 0 || !HasIncome(income))
                    continue;

                var amount = income.Q1 + income.Q2 + income.Q3 + income.Q4;
                var probability = selected.Calculation.Priority is > 0 and <= 100 ? selected.Calculation.Priority : 100;
                yield return new IncomeRow(
                    selected,
                    income.Year,
                    income.SubType,
                    income.Q1,
                    income.Q2,
                    income.Q3,
                    income.Q4,
                    amount,
                    amount * probability / 100m,
                    probability);
            }
        }
    }

    private IReadOnlyList<IncomeTableRow> BuildIncomeTableRows()
    {
        var result = new List<IncomeTableRow>();
        var rows = FilteredIncomeRows.ToList();

        foreach (var projectGroup in rows.GroupBy(r => r.Entry.Project.Id))
        {
            var firstP = true;
            foreach (var calcGroup in projectGroup.GroupBy(r => r.Entry.Calculation.Id))
            {
                var firstC = true;
                foreach (var row in calcGroup)
                {
                    result.Add(new IncomeTableRow
                    {
                        Kind = IncomeTableRowKind.Data,
                        FolderName = row.Entry.Folder.Name,
                        ProjectName = row.Entry.Project.Name,
                        CalcName = row.Entry.Calculation.Name,
                        SourceLabel = TypeLabel(row.Entry.Calculation.CalculationType),
                        Status = row.Entry.Calculation.Status,
                        Year = row.Year,
                        SubTypeText = SubTypeLabel(row.SubType),
                        Q1 = row.Q1, Q2 = row.Q2, Q3 = row.Q3, Q4 = row.Q4,
                        Amount = row.Amount,
                        Probability = row.Probability,
                        Forecast = row.Forecast,
                        IsFirstForProject = firstP,
                        IsFirstForCalc = firstC
                    });
                    firstP = false;
                    firstC = false;
                }
            }

            if (projectGroup.Count() > 1)
            {
                result.Add(new IncomeTableRow
                {
                    Kind = IncomeTableRowKind.ProjectSum,
                    SummaryLabel = $"Summa: {projectGroup.First().Entry.Project.Name}",
                    Q1 = projectGroup.Sum(r => r.Q1),
                    Q2 = projectGroup.Sum(r => r.Q2),
                    Q3 = projectGroup.Sum(r => r.Q3),
                    Q4 = projectGroup.Sum(r => r.Q4),
                    Amount = projectGroup.Sum(r => r.Amount),
                    Forecast = projectGroup.Sum(r => r.Forecast)
                });
            }
        }

        if (rows.Count > 1)
        {
            result.Add(new IncomeTableRow
            {
                Kind = IncomeTableRowKind.GrandTotal,
                SummaryLabel = "Totalt",
                Q1 = rows.Sum(r => r.Q1),
                Q2 = rows.Sum(r => r.Q2),
                Q3 = rows.Sum(r => r.Q3),
                Q4 = rows.Sum(r => r.Q4),
                Amount = rows.Sum(r => r.Amount),
                Forecast = rows.Sum(r => r.Forecast)
            });

            if (string.IsNullOrEmpty(_selectedSubType) && rows.Select(r => r.SubType).Distinct().Count() > 1)
            {
                foreach (var sg in rows.GroupBy(r => r.SubType).OrderBy(g => g.Key))
                {
                    result.Add(new IncomeTableRow
                    {
                        Kind = IncomeTableRowKind.SubTypeTotal,
                        SummaryLabel = $"Summa {SubTypeLabel(sg.Key)}",
                        Q1 = sg.Sum(r => r.Q1),
                        Q2 = sg.Sum(r => r.Q2),
                        Q3 = sg.Sum(r => r.Q3),
                        Q4 = sg.Sum(r => r.Q4),
                        Amount = sg.Sum(r => r.Amount),
                        Forecast = sg.Sum(r => r.Forecast)
                    });
                }
            }
        }

        return result;
    }

    private static string IncomeRowClass(IncomeTableRowKind kind) => kind switch
    {
        IncomeTableRowKind.GrandTotal => "border-t-2 border-slate-400 bg-white font-bold text-slate-900 dark:border-slate-500 dark:bg-slate-950 dark:text-slate-100",
        IncomeTableRowKind.SubTypeTotal => "bg-slate-50 text-xs italic text-slate-500 dark:bg-slate-900/40 dark:text-slate-400",
        _ => "bg-slate-50 font-semibold italic text-slate-600 dark:bg-slate-900/60 dark:text-slate-300"
    };

    private CalculationEntry? ChooseIncomeSource(IEnumerable<CalculationEntry> entries)
    {
        var candidates = entries;
        if (Enum.TryParse<CalculationVersionType>(_selectedIncomeSource, out var requestedType))
            candidates = candidates.Where(entry => entry.Calculation.CalculationType == requestedType);

        return candidates
            .OrderByDescending(entry => _selectedIncomeSource == "auto" ? SourcePriority(entry.Calculation.CalculationType) : 0)
            .ThenByDescending(entry => entry.Calculation.UpdatedAt ?? entry.Calculation.CreatedAt)
            .ThenByDescending(entry => entry.Calculation.Id)
            .FirstOrDefault();
    }

    private bool MatchesCalculation(CalculationEntry entry)
    {
        var calculation = entry.Calculation;
        if (!MatchesFolder(entry.Folder) || !MatchesProject(entry.Project) || !MatchesArchive(calculation.IsVisible))
            return false;
        if (!string.IsNullOrWhiteSpace(_selectedCalculationType) && calculation.CalculationType.ToString() != _selectedCalculationType)
            return false;
        if (Enum.TryParse<CalculationRole>(_selectedCalculationRole, out var calculationRole) && calculation.CalculationRole != calculationRole)
            return false;
        if (!string.IsNullOrWhiteSpace(_selectedStatus) && !string.Equals(calculation.Status, _selectedStatus, StringComparison.OrdinalIgnoreCase))
            return false;
        if (!string.IsNullOrWhiteSpace(_selectedResponsible) && !calculation.Responsible.Contains(_selectedResponsible, StringComparison.OrdinalIgnoreCase))
            return false;
        if (!string.IsNullOrWhiteSpace(_selectedInspector) && !calculation.Inspector.Contains(_selectedInspector, StringComparison.OrdinalIgnoreCase))
            return false;
        return true;
    }

    private bool MatchesIncome(IncomeRow row)
    {
        if (!string.IsNullOrWhiteSpace(_selectedYear) && int.TryParse(_selectedYear, out var year) && row.Year != year)
            return false;
        if (!string.IsNullOrWhiteSpace(_selectedSubType) && int.TryParse(_selectedSubType, out var subTypeInt) && (int)row.SubType != subTypeInt)
            return false;
        return _selectedQuarter switch
        {
            1 => row.Q1 != 0,
            2 => row.Q2 != 0,
            3 => row.Q3 != 0,
            4 => row.Q4 != 0,
            _ => true
        };
    }

    private bool MatchesCalculationYear(CalculationEntry entry)
    {
        if (string.IsNullOrWhiteSpace(_selectedYear) || !int.TryParse(_selectedYear, out var year))
            return true;

        var calculation = entry.Calculation;
        return calculation.StartDate.Year == year ||
               calculation.EndDate.Year == year ||
               (calculation.TenderDeadline != default && calculation.TenderDeadline.Year == year);
    }

    private bool MatchesFolder(FolderMVVM folder) =>
        string.IsNullOrWhiteSpace(_selectedFolderId) || folder.Id.ToString() == _selectedFolderId;

    private bool MatchesProject(ListProjectMVVM project) =>
        string.IsNullOrWhiteSpace(_selectedProjectId) || project.Id.ToString() == _selectedProjectId;

    private bool MatchesArchive(bool isVisible) => _selectedArchiveMode switch
    {
        "all" => true,
        "archived" => !isVisible,
        _ => isVisible
    };

    private bool MatchesHitRateStatus(ListProjectMVVM project) =>
        string.IsNullOrWhiteSpace(_selectedStatus) ||
        string.Equals(project.Status, _selectedStatus, StringComparison.OrdinalIgnoreCase);

    private bool MatchesHitRateYear(ListProjectMVVM project)
    {
        if (string.IsNullOrWhiteSpace(_selectedYear) || !int.TryParse(_selectedYear, out var year))
            return true;
        if (project.TenderDeadline != default && project.TenderDeadline.Year == year)
            return true;
        return project.StartDate.Year == year || project.EndDate.Year == year;
    }

    private bool MatchesHitRateResponsible(ListProjectMVVM project) =>
        string.IsNullOrWhiteSpace(_selectedResponsible) ||
        project.Responsible.Contains(_selectedResponsible, StringComparison.OrdinalIgnoreCase);

    private bool MatchesHitRateInspector(ListProjectMVVM project) =>
        string.IsNullOrWhiteSpace(_selectedInspector) ||
        project.Inspector.Contains(_selectedInspector, StringComparison.OrdinalIgnoreCase);

    private void OnProjectSearchInput(ChangeEventArgs e)
    {
        _projectSearch = e.Value?.ToString() ?? string.Empty;
        _showProjectDropdown = true;
        if (string.IsNullOrWhiteSpace(_projectSearch))
            _selectedProjectId = string.Empty;
    }

    private void SelectProject(ProjectEntry? entry)
    {
        if (entry is null)
        {
            _selectedProjectId = string.Empty;
            _projectSearch = string.Empty;
        }
        else
        {
            _selectedProjectId = entry.Project.Id.ToString();
            _projectSearch = ProjectDisplayLabel(entry);
        }
        _showProjectDropdown = false;
    }

    private void CloseProjectDropdown() => _showProjectDropdown = false;

    private void OnProjectKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _showProjectDropdown = false;
            _selectedProjectId = string.Empty;
            _projectSearch = string.Empty;
        }
    }

    private string ProjectDisplayLabel(ProjectEntry entry)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(entry.Project.Code))
            parts.Add(entry.Project.Code);
        if (!string.IsNullOrWhiteSpace(entry.Project.Name))
            parts.Add(entry.Project.Name);
        if (!string.IsNullOrWhiteSpace(entry.Folder.Name))
            parts.Add(entry.Folder.Name);
        return string.Join(" – ", parts);
    }

