    private RenderFragment ColumnPanelImpl<T>(T[] allCols, HashSet<T> visible, Func<T, string> getLabel,
        Func<T, bool, Task> toggle, Action selectAll, Action selectDefault,
        bool panelVisible, Action<bool> setPanelVisible, bool openUp = false)
        where T : struct, Enum
    {
        var panelClass = openUp
            ? "absolute bottom-full right-0 z-50 mb-1 w-64 overflow-auto rounded-md border border-slate-200 bg-white p-2 shadow-lg dark:border-slate-700 dark:bg-slate-900"
            : "absolute right-0 z-50 mt-0.5 w-64 overflow-auto rounded-md border border-slate-200 bg-white p-2 shadow-lg dark:border-slate-700 dark:bg-slate-900";

        return @<div class="relative">
            <button type="button"
                    class="@(visible.Count < allCols.Length ? "inline-flex h-8 items-center rounded-lg bg-sky-50 border border-sky-300 px-2.5 text-xs font-semibold text-sky-700 transition hover:bg-sky-100 dark:bg-sky-950/30 dark:border-sky-700 dark:text-sky-300" : ActionButtonClass)"
                    @onclick="() => setPanelVisible(!panelVisible)">
                @AppLoc["columnSelection"] @(visible.Count < allCols.Length ? $"({visible.Count}/{allCols.Length})" : "")
            </button>
            @if (panelVisible)
            {
                <div class="fixed inset-0 z-40" @onclick="() => setPanelVisible(false)"></div>
                <div class="@panelClass" style="max-height:min(22rem, calc(100vh - 8rem))">
                    <p class="mb-1.5 text-[10px] font-semibold text-slate-400">@AppLoc["visibleColumns"]</p>
                    @foreach (var col in allCols) { var cc = col;
                        <label class="flex cursor-pointer items-center gap-2 rounded px-2 py-1 text-xs text-slate-700 hover:bg-slate-50 dark:text-slate-200 dark:hover:bg-slate-800">
                            <input type="checkbox" class="h-3.5 w-3.5 rounded border-slate-300" checked="@visible.Contains(cc)" @onchange="e => toggle(cc, (bool)(e.Value ?? false))" />
                            <span>@getLabel(cc)</span>
                        </label>
                    }
                    <div class="mt-1.5 flex gap-1 border-t border-slate-100 pt-1.5 dark:border-slate-800">
                        <button type="button" class="flex-1 rounded bg-slate-50 px-2 py-1 text-[10px] font-medium text-slate-600 hover:bg-slate-100 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700" @onclick="() => selectAll()">@AppLoc["allItems"]</button>
                        <button type="button" class="flex-1 rounded bg-slate-50 px-2 py-1 text-[10px] font-medium text-slate-600 hover:bg-slate-100 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700" @onclick="() => selectDefault()">@AppLoc["defaultValue"]</button>
                    </div>
                </div>
            }
        </div>;
    }

    // ── Computed ──────────────────────────────────────────────────────

    private IReadOnlyList<(string Key, string Label)> ReportTabs =>
    [
        (ReportView.Income, L("incomeOverview")),
        (ReportView.HitRate, L("hitRate")),
        (ReportView.Calculations, L("calculationListReport")),
        (ReportView.Projects, L("projectListReport"))
    ];

    private IEnumerable<FolderMVVM> AvailableFolders =>
        _projects.Select(e => e.Folder).DistinctBy(f => f.Id).OrderBy(f => f.Name);

    private IEnumerable<ProjectEntry> AvailableProjects =>
        _projects.Where(e => string.IsNullOrWhiteSpace(_selectedFolderId) || e.Folder.Id.ToString() == _selectedFolderId)
            .DistinctBy(e => e.Project.Id).OrderBy(e => e.Project.Name);

    private IEnumerable<ProjectEntry> ProjectSearchResults =>
        AvailableProjects.Where(e =>
            string.IsNullOrWhiteSpace(_projectSearch) ||
            e.Project.Name.Contains(_projectSearch, StringComparison.OrdinalIgnoreCase) ||
            e.Project.Code.Contains(_projectSearch, StringComparison.OrdinalIgnoreCase) ||
            e.Folder.Name.Contains(_projectSearch, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<string> AvailableCalcStatuses =>
        _calculations.Select(e => e.Calculation.Status).Where(s => !string.IsNullOrWhiteSpace(s))
            .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s);

    private IEnumerable<string> AvailableProjectStatuses =>
        _projects.Select(e => e.Project.Status).Where(s => !string.IsNullOrWhiteSpace(s))
            .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s);

    private IEnumerable<string> AvailableResponsibles =>
        _activeView is ReportView.HitRate or ReportView.Projects
            ? _projects.Select(e => e.Project.Responsible).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s)
            : _calculations.Select(e => e.Calculation.Responsible).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s);

    private IEnumerable<string> AvailableInspectors =>
        _activeView is ReportView.HitRate or ReportView.Projects
            ? _projects.Select(e => e.Project.Inspector).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s)
            : _calculations.Select(e => e.Calculation.Inspector).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s);

