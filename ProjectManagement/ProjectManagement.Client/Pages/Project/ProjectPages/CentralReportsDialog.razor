    private IEnumerable<FolderMVVM> AvailableFolders =>
        _projects.Select(e => e.Folder).DistinctBy(f => f.Id).OrderBy(f => f.Name);

    private IEnumerable<ProjectEntry> AvailableProjects =>
        _projects.Where(e => string.IsNullOrWhiteSpace(_selectedFolderId) || e.Folder.Id.ToString() == _selectedFolderId)
            .DistinctBy(e => e.Project.Id).OrderBy(e => e.Project.Name);

    private IEnumerable<ProjectEntry> ProjectSearchResults =>
        AvailableProjects.Where(e =>
            string.IsNullOrWhiteSpace(_projectSearch) ||
            e.Project.Name.Contains(_projectSearch, StringComparison.OrdinalIgnoreCase) ||
            e.Project.Code.Contains(_projectSearch, StringComparison.OrdinalIgnoreCase) ||
            e.Folder.Name.Contains(_projectSearch, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<string> AvailableCalcStatuses =>
        _calculations.Select(e => e.Calculation.Status).Where(s => !string.IsNullOrWhiteSpace(s))
