            <tbody class="@TableBodyClass">
                @foreach (var entry in entries)
                {
                    <tr><td>@entry.Folder.Name</td><td>@entry.Project.Name</td><td>@entry.Calculation.Name</td><td>V.@entry.Calculation.VersionNumber.ToString("D2")</td><td>@TypeLabel(entry.Calculation.CalculationType)</td><td>@entry.Calculation.Status</td><td>@entry.Calculation.Responsible</td><td>@entry.Calculation.Inspector</td></tr>
                }
            </tbody>
        </table>
    </div>;

    private RenderFragment HitRateProjectTable() => @<div class="@TableContainerClass">
