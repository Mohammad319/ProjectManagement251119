        var kpis = new List<ReportExportKpi>
        {
            new("Inlämnade", SubmittedCount.ToString()),
            new("Vunna", WonCount.ToString()),
            new("Förlorade", LostCount.ToString()),
            new("Ej beslutade", UndecidedCount.ToString()),
            new("Hit rate / träffsäkerhet", WonCount + LostCount == 0 ? "–" : $"{HitRate:N1} %")
        };
        var rows = HitRateTableProjects
            .Select(e => dataCols.Select(c => (object?)GetHitRateCellValue(e, c)));
        return new(L("hitRate"), headers, rows, sections, kpis);
    }

