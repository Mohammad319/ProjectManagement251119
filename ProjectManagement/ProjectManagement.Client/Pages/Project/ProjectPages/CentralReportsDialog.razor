    // ── Income logic ──────────────────────────────────────────────────

    private IEnumerable<IncomeRow> BuildIncomeRows()
    {
        foreach (var group in BaseFilteredCalculations.GroupBy(e => $"{e.Project.Id}:{e.ChainKey}"))
        {
            var sel = ChooseIncomeSource(group);
            if (sel is null || !_posts.TryGetValue(sel.Calculation.Id, out var post)) continue;
            foreach (var income in post.Income ?? [])
            {
                if (income.Year <= 0 || !HasIncome(income)) continue;
                var amount = income.Q1 + income.Q2 + income.Q3 + income.Q4;
                var prob = sel.Calculation.Priority is > 0 and <= 100 ? sel.Calculation.Priority : 100;
                yield return new IncomeRow(sel, income.Year, income.SubType, income.Q1, income.Q2, income.Q3, income.Q4, amount, amount * prob / 100m, prob);
            }
        }
    }

    private static string IncomeRowKey(IncomeRow r) => $"{r.Entry.Calculation.Id}:{r.Year}:{(int)r.SubType}";
    private void ToggleRowInclusion(string key) { if (!_excludedRowKeys.Remove(key)) _excludedRowKeys.Add(key); }

    private IReadOnlyList<IncomeTableRow> BuildIncomeTableRows()
    {
        var result = new List<IncomeTableRow>();
        var incl = IncludedFilteredIncomeRows.ToList();
        var all = FilteredIncomeRows.ToList();

        foreach (var pg in all.GroupBy(r => r.Entry.Project.Id))
        {
            bool fp = true;
            foreach (var cg in pg.GroupBy(r => r.Entry.Calculation.Id))
            {
                bool fc = true;
                foreach (var row in cg)
                {
                    result.Add(new IncomeTableRow
                    {
                        Kind = IncomeTableRowKind.Data, RowKey = IncomeRowKey(row),
                        FolderName = row.Entry.Folder.Name, ProjectName = row.Entry.Project.Name,
                        CalcName = row.Entry.Calculation.Name, SourceLabel = TypeLabel(row.Entry.Calculation.CalculationType),
                        Status = row.Entry.Calculation.Status, Year = row.Year, SubTypeText = SubTypeLabel(row.SubType),
                        Q1 = row.Q1, Q2 = row.Q2, Q3 = row.Q3, Q4 = row.Q4,
                        Amount = row.Amount, Probability = row.Probability, Forecast = row.Forecast,
                        IsFirstForProject = fp, IsFirstForCalc = fc,
                        ProjectCode = fp ? row.Entry.Project.Code : "",
                        ProjectType = fp ? row.Entry.Project.Type : "",
                        ProjStatus = fp ? row.Entry.Project.Status : "",
                        Organisation = fp ? row.Entry.Project.Organisation : "",
                        Developer = fp ? row.Entry.Project.Developer : "",
                        CalcCode = fc ? row.Entry.Calculation.Code : "",
                        CalcVersion = fc ? $"V.{row.Entry.Calculation.VersionNumber:D2}" : "",
                        CalcTypeName = fc ? TypeLabel(row.Entry.Calculation.CalculationType) : "",
                        CalcRoleName = fc ? GetCalculationRoleLabel(row.Entry.Calculation.CalculationRole) : "",
                        Responsible = fc ? row.Entry.Calculation.Responsible ?? "" : "",
                        Inspector = fc ? row.Entry.Calculation.Inspector ?? "" : "",
                        TenderDeadlineText = fc ? FormatDate(row.Entry.Calculation.TenderDeadline) : "",
                        PublicationDateText = fp ? (row.Entry.Project.PublicationDate.HasValue ? row.Entry.Project.PublicationDate.Value.ToString("yyyy-MM-dd") : "") : "",
                        DecisionDateText = fp ? (row.Entry.Project.DecisionDate.HasValue ? row.Entry.Project.DecisionDate.Value.ToString("yyyy-MM-dd") : "") : "",
                        Contract = fp ? row.Entry.Project.Contract : "",
                        Compensation = fp ? row.Entry.Project.Compensation : "",
                        ProcurementName = fp ? row.Entry.Project.ProcurementName : "",
                        ProcurementProcedure = fp ? row.Entry.Project.ProcurementProcedure : "",
                        ArchivedText = !row.Entry.Calculation.IsArchived ? "" : L("archived"),
                    });
                    fp = false; fc = false;
                }
            }
            var inclP = incl.Where(r => r.Entry.Project.Id == pg.Key).ToList();
            if (pg.Count() > 1 && inclP.Count > 0)
                result.Add(new IncomeTableRow { Kind = IncomeTableRowKind.ProjectSum, SummaryLabel = $"Summa projekt: {pg.First().Entry.Project.Name}", Q1 = inclP.Sum(r => r.Q1), Q2 = inclP.Sum(r => r.Q2), Q3 = inclP.Sum(r => r.Q3), Q4 = inclP.Sum(r => r.Q4), Amount = inclP.Sum(r => r.Amount), Forecast = inclP.Sum(r => r.Forecast) });
        }

        if (incl.Count > 1)
        {
            result.Add(new IncomeTableRow { Kind = IncomeTableRowKind.GrandTotal, SummaryLabel = "Totalt", Q1 = incl.Sum(r => r.Q1), Q2 = incl.Sum(r => r.Q2), Q3 = incl.Sum(r => r.Q3), Q4 = incl.Sum(r => r.Q4), Amount = incl.Sum(r => r.Amount), Forecast = incl.Sum(r => r.Forecast) });
            if (string.IsNullOrEmpty(_selectedSubType) && incl.Select(r => r.SubType).Distinct().Count() > 1)
                foreach (var sg in incl.GroupBy(r => r.SubType).OrderBy(g => g.Key))
                    result.Add(new IncomeTableRow { Kind = IncomeTableRowKind.SubTypeTotal, SummaryLabel = $"Summa {SubTypeLabel(sg.Key)}", Q1 = sg.Sum(r => r.Q1), Q2 = sg.Sum(r => r.Q2), Q3 = sg.Sum(r => r.Q3), Q4 = sg.Sum(r => r.Q4), Amount = sg.Sum(r => r.Amount), Forecast = sg.Sum(r => r.Forecast) });
        }
        return result;
    }

    private static string IncomeRowClass(IncomeTableRowKind kind) => kind switch
    {
        IncomeTableRowKind.GrandTotal => "border-t-2 border-slate-400 bg-white font-bold text-slate-900 dark:border-slate-500 dark:bg-slate-950 dark:text-slate-100",
        IncomeTableRowKind.SubTypeTotal => "bg-slate-50 text-xs italic text-slate-500 dark:bg-slate-900/40 dark:text-slate-400",
        _ => "bg-slate-50 font-semibold italic text-slate-600 dark:bg-slate-900/60 dark:text-slate-300"
    };

    private CalculationEntry? ChooseIncomeSource(IEnumerable<CalculationEntry> entries)
    {
        var cands = entries;
        if (Enum.TryParse<CalculationVersionType>(_selectedIncomeSource, out var rt))
            cands = cands.Where(e => e.Calculation.CalculationType == rt);
        return cands
            .OrderByDescending(e => _selectedIncomeSource == "auto" ? SourcePriority(e.Calculation.CalculationType) : 0)
            .ThenByDescending(e => e.Calculation.UpdatedAt ?? e.Calculation.CreatedAt)
            .ThenByDescending(e => e.Calculation.Id)
            .FirstOrDefault();
    }

    // ── Matching ──────────────────────────────────────────────────────

    private bool MatchesCalculation(CalculationEntry entry)
    {
        var c = entry.Calculation;
        if (!MatchesFolder(entry.Folder) || !MatchesProject(entry.Project) || !MatchesArchive(!c.IsArchived)) return false;
        if (!string.IsNullOrWhiteSpace(_selectedCalculationType) && c.CalculationType.ToString() != _selectedCalculationType) return false;
        if (Enum.TryParse<CalculationRole>(_selectedCalculationRole, out var role) && c.CalculationRole != role) return false;
        if (_selectedStatuses.Count > 0 && !_selectedStatuses.Contains(c.Status ?? string.Empty)) return false;
        if (!MatchesPersonField(c.Responsible, _selectedResponsibles)) return false;
        if (!MatchesPersonField(c.Inspector, _selectedInspectors)) return false;
        return true;
    }

    private bool MatchesIncome(IncomeRow row)
    {
        if (!string.IsNullOrWhiteSpace(_selectedYear) && int.TryParse(_selectedYear, out var yr) && row.Year != yr) return false;
        if (!string.IsNullOrWhiteSpace(_selectedSubType) && int.TryParse(_selectedSubType, out var st) && (int)row.SubType != st) return false;
        return _selectedQuarter switch { 1 => row.Q1 != 0, 2 => row.Q2 != 0, 3 => row.Q3 != 0, 4 => row.Q4 != 0, _ => true };
    }

    private bool MatchesCalculationYear(CalculationEntry entry)
    {
        if (string.IsNullOrWhiteSpace(_selectedYear) || !int.TryParse(_selectedYear, out var yr)) return true;
        var c = entry.Calculation;
        return c.StartDate.Year == yr || c.EndDate.Year == yr || (c.TenderDeadline != default && c.TenderDeadline.Year == yr);
    }

    private bool MatchesFolder(FolderMVVM folder) =>
        string.IsNullOrWhiteSpace(_selectedFolderId) || folder.Id.ToString() == _selectedFolderId;

    private bool MatchesProject(ListProjectMVVM project) =>
        string.IsNullOrWhiteSpace(_selectedProjectId) || project.Id.ToString() == _selectedProjectId;

    private bool MatchesArchive(bool isVisible) => _selectedArchiveMode switch { "all" => true, "archived" => !isVisible, _ => isVisible };

    private bool MatchesProjectStatus(ListProjectMVVM project) =>
        _selectedProjectStatuses.Count == 0 || _selectedProjectStatuses.Contains(project.Status ?? string.Empty);

    private bool MatchesHitRateYear(ListProjectMVVM project)
    {
        if (string.IsNullOrWhiteSpace(_selectedYear) || !int.TryParse(_selectedYear, out var yr)) return true;
        if (project.TenderDeadline != default && project.TenderDeadline.Year == yr) return true;
        return project.StartDate.Year == yr || project.EndDate.Year == yr;
    }

    private bool MatchesHitRateQuarter(ListProjectMVVM project)
    {
        if (_selectedQuarter == 0) return true;
        if (project.TenderDeadline == default) return true;
        return ((project.TenderDeadline.Month - 1) / 3) + 1 == _selectedQuarter;
    }

    private bool MatchesPersonField(string? value, HashSet<string> selected)
    {
        if (selected.Count == 0) return true;
        var v = value ?? string.Empty;
        return string.IsNullOrWhiteSpace(v) ? selected.Contains(MissingPersonValue) : selected.Contains(v);
    }

    private bool MatchesProjectResponsible(ListProjectMVVM p) => MatchesPersonField(p.Responsible, _selectedResponsibles);
    private bool MatchesProjectInspector(ListProjectMVVM p) => MatchesPersonField(p.Inspector, _selectedInspectors);

