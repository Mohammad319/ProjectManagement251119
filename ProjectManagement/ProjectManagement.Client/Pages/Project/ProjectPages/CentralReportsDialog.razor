    protected override async Task OnInitializedAsync()
    {
        if (Host is ReportHost host)
        {
            var availability = GetReportAvailability(host);
            var availabilityMap = availability.ToDictionary(a => a.View);

            // Viewer (Visare) must not see bid data: disable the Anbudsjämförelse tab. Its backend
            // endpoint is editor-gated anyway, so leaving it enabled would only yield an empty/403 tab.
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            if (authState.User.IsInRole(PMRolesConst.Tenant.Viewer)
                && availabilityMap.TryGetValue(ReportView.BidComparison, out var bidAvail) && bidAvail.Enabled)
            {
                availabilityMap[ReportView.BidComparison] =
                    bidAvail with { Enabled = false, DisabledReason = "Du saknar behörighet till anbudsjämförelse." };
            }

            _availability = availabilityMap;

            // Om vald flik inte är tillgänglig: välj första tillgängliga rapportflik.
            _activeView = IsViewEnabled(InitialView) ? InitialView : availability.First(a => IsViewEnabled(a.View)).View;
        }
        else
        {
            _activeView = InitialView;
        }
        _selectedYear = string.IsNullOrEmpty(InitialYear) ? DateTime.Now.Year.ToString() : InitialYear;
        _selectedCalculationType = InitialCalculationType;
        _selectedCalculationRole = InitialCalculationRole;
        if (!string.IsNullOrWhiteSpace(InitialStatus)) _selectedStatuses.Add(InitialStatus);
        if (!string.IsNullOrWhiteSpace(InitialResponsible)) _selectedResponsibles.Add(InitialResponsible);
        if (!string.IsNullOrWhiteSpace(InitialInspector)) _selectedInspectors.Add(InitialInspector);
        _selectedFolderId = FolderScope?.Id.ToString() ?? string.Empty;
        _selectedProjectId = ProjectScope?.Id.ToString() ?? string.Empty;
        await LoadAsync();
        if (IsViewEnabled(ReportView.Income)) BuildIncomeSelectionInfo();
        if (IsViewEnabled(ReportView.Projects)) LockProjReportProjects();
        if (IsViewEnabled(ReportView.HitRate)) LockHitRateProjects();
        if (IsViewEnabled(ReportView.Calculations)) LockCalcReportList();
        if (IsViewEnabled(ReportView.BidComparison)) LockBidComparison();

        if (!string.IsNullOrWhiteSpace(_selectedProjectId))
        {
            var found = AvailableProjects.FirstOrDefault(p => p.Project.Id.ToString() == _selectedProjectId);
            if (found is not null) _projectSearch = ProjectDisplayLabel(found);
        }

        _isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _prefsLoaded) return;
        _prefsLoaded = true;
        bool stateChanged = false;
        try
        {
            var collapsed = await JS.InvokeAsync<string?>("localStorage.getItem", SelectionCollapsedStorageKey);
            if (collapsed == "1") { _selectionCollapsed = true; stateChanged = true; }
        }
        catch { }
        stateChanged |= await LoadColumnPrefsAsync<CalcReportColumn>(CalcColumnsStorageKey, _visibleCalcColumns);
        stateChanged |= await LoadColumnPrefsAsync<ProjReportColumn>(ProjColumnsStorageKey, _visibleProjColumns);
        stateChanged |= await LoadColumnPrefsAsync<IncomeReportColumn>(IncomeColumnsStorageKey, _visibleIncomeColumns);
        stateChanged |= await LoadColumnPrefsAsync<HitRateReportColumn>(HitRateColumnsStorageKey, _visibleHitRateColumns);
        stateChanged |= await LoadColumnPrefsAsync<BidReportColumn>(BidColumnsStorageKey, _visibleBidColumns);
        if (stateChanged) await InvokeAsync(StateHasChanged);
    }

    private async Task<bool> LoadColumnPrefsAsync<T>(string key, HashSet<T> target) where T : struct, Enum
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", key);
            if (string.IsNullOrWhiteSpace(json)) return false;
            var indices = System.Text.Json.JsonSerializer.Deserialize<int[]>(json);
            if (indices?.Length > 0)
            {
                target.Clear();
                foreach (var i in indices)
                    if (Enum.IsDefined(typeof(T), i))
                        target.Add((T)(object)i);
                return true;
            }
        }
        catch { }
        return false;
    }

    private async Task SaveColumnsAsync<T>(string key, HashSet<T> source) where T : struct, Enum
    {
        try
        {
            var indices = source.Select(c => (int)(object)c).ToArray();
            await JS.InvokeVoidAsync("localStorage.setItem", key, System.Text.Json.JsonSerializer.Serialize(indices));
        }
        catch { }
    }

    private async Task LoadAsync()
    {
        var folders = FolderScope is null ? Folder.State.FoldersList : [FolderScope];
        foreach (var folder in folders)
        {
            var projects = Folder.State.OtherDepartment
                ? await Repo.Project.GetOtherDepartmentAsync(folder.Id, includeArchived: true)
                : await Repo.Project.GetByFolderIdAsync(folder.Id, includeArchived: true);

            foreach (var project in projects.Where(p =>
                (ProjectScope is null && LockedProjectIds is null) ||
                p.Id == ProjectScope?.Id ||
                (LockedProjectIds is not null && LockedProjectIds.Contains(p.Id))))
            {
                _projects.Add(new ProjectEntry(folder, project));
                await LoadCalculationsAsync(folder, project);
            }
        }

        // Intäktsdata behövs bara om Intäktsöversikt-fliken är tillgänglig.
        if (IsViewEnabled(ReportView.Income))
        {
            foreach (var calc in _calculations)
            {
                try { _posts[calc.Calculation.Id] = await Repo.Calculation.GetPostAsync(calc.Calculation.Id); }
                catch (Exception ex) { await ClientLog.ErrorAsync("Loading calculation report data failed", ex: ex); }
            }
        }

        // Anbudsdata hämtas i EN samlad query för alla filtrerade projekt (ej N+1).
        if (IsViewEnabled(ReportView.BidComparison) && _projects.Count > 0)
        {
            try
            {
                var ids = _projects.Select(e => e.Project.Id).Distinct().ToList();
                _bidRowsRaw = await Repo.ProjectBid.GetComparisonAsync(ids);
            }
            catch (Exception ex) { await ClientLog.ErrorAsync("Loading bid comparison data failed", ex: ex); }
        }
    }

    private async Task LoadCalculationsAsync(FolderMVVM folder, ListProjectMVVM project)
    {
        List<ListCalculationMVVM> all;
        if (Folder.State.OtherDepartment)
        {
            all = CalculationVersionSelector.FilterFamiliesByCurrentVisibility(
                await Repo.Calculation.GetShareCalculationsAsync(project.Id), includeArchived: true).ToList();
        }
        else
        {
            all = await Repo.Calculation.GetAsync(project.Id);
            all.AddRange(await Repo.Calculation.GetAsync(project.Id, isArchived: true));
            all = all.DistinctBy(c => c.Id).ToList();
        }

        var lookup = all.ToDictionary(c => c.Id);
        foreach (var c in all)
            _allVersions.Add(new CalculationEntry(folder, project, c, GetChainKey(c, lookup)));
        foreach (var c in CalculationVersionSelector.SelectCurrentVersions(all))
            _calculations.Add(new CalculationEntry(folder, project, c, GetChainKey(c, lookup)));
    }

