            ? _projects.Select(e => e.Project.Responsible).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s)
            : _calculations.Select(e => e.Calculation.Responsible).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s);

    private IEnumerable<string> AvailableInspectors =>
