            ? "rounded-md bg-sky-600 px-2.5 py-1.5 text-xs font-semibold text-white shadow-sm"
            : "rounded-md px-2.5 py-1.5 text-xs font-semibold text-slate-600 transition hover:bg-white dark:text-slate-300 dark:hover:bg-slate-800";

    // ── Export ────────────────────────────────────────────────────────

    private async Task ExportExcelAsync()
    {
        var export = BuildExport();
        var name = _activeView switch
        {
            ReportView.Income => "intaktsoversikt",
            ReportView.HitRate => "traffsakerhet",
            ReportView.Calculations => "kalkyllista",
            ReportView.Projects => "projektlista",
            _ => $"rapport-{_activeView}"
        };
        await ReportExportInterop.ExportExcelAsync(JS, name, export.Title, export.Columns, export.Rows);
    }

    private async Task ExportPdfAsync()
    {
        var export = BuildExport();
        await ReportExportInterop.PrintAsync(JS, export.Title, export.Columns, export.Rows, pdfMode: true);
    }

    private async Task PrintAsync()
    {
        var export = BuildExport();
        await ReportExportInterop.PrintAsync(JS, export.Title, export.Columns, export.Rows);
    }

    private ExportModel BuildExport() => _activeView switch
    {
        ReportView.Income => BuildIncomeExport(),
        ReportView.HitRate => BuildHitRateExport(),
        ReportView.Calculations => BuildCalcExport(),
        ReportView.Projects => BuildProjExport(),
        _ => BuildCalcExport()
    };

    private ExportModel BuildIncomeExport()
    {
        string[] cols = _showQuarters
            ? [L("folder"), L("project"), L("calculation"), "Källa", "Kalkylstatus", L("year"), "Deltyp", "Q1", "Q2", "Q3", "Q4", "Intäkt", "Sannolikhet", "Prognos"]
            : [L("folder"), L("project"), L("calculation"), "Källa", "Kalkylstatus", L("year"), "Deltyp", "Intäkt", "Sannolikhet", "Prognos"];
        return new(L("incomeOverview"), cols, BuildIncomeExportRows());
    }

    private IEnumerable<IEnumerable<object?>> BuildIncomeExportRows()
    {
        foreach (var row in BuildIncomeTableRows())
        {
            if (row.Kind == IncomeTableRowKind.Data)
                yield return _showQuarters
                    ? new object?[] { row.FolderName, row.ProjectName, row.CalcName, row.SourceLabel, row.Status, row.Year, row.SubTypeText, row.Q1, row.Q2, row.Q3, row.Q4, row.Amount, $"{row.Probability} %", row.Forecast }
                    : new object?[] { row.FolderName, row.ProjectName, row.CalcName, row.SourceLabel, row.Status, row.Year, row.SubTypeText, row.Amount, $"{row.Probability} %", row.Forecast };
            else
                yield return _showQuarters
                    ? new object?[] { row.SummaryLabel, "", "", "", "", "", "", row.Q1, row.Q2, row.Q3, row.Q4, row.Amount, "", row.Forecast }
                    : new object?[] { row.SummaryLabel, "", "", "", "", "", "", row.Amount, "", row.Forecast };
        }
    }

    private ExportModel BuildHitRateExport()
    {
        string[] cols = ["Mapp / KPI", "Projekt / Värde", "Projektstatus", "Anbudsdeadline", "Kalkylansvarig", "Granskare"];
        var rows = new List<IEnumerable<object?>>();
        rows.Add(new object?[] { "Inlämnade:", SubmittedCount, "", "", "", "" });
        rows.Add(new object?[] { "Vunna:", WonCount, "", "", "", "" });
        rows.Add(new object?[] { "Förlorade:", LostCount, "", "", "", "" });
        rows.Add(new object?[] { "Ej beslutade:", UndecidedCount, "", "", "", "" });
        rows.Add(new object?[] { "Hit rate / träffsäkerhet:", $"{HitRate:N1} %", "", "", "", "" });
        rows.Add(new object?[] { "", "", "", "", "", "" });
        foreach (var e in HitRateProjectEntries)
            rows.Add(new object?[] { e.Folder.Name, e.Project.Name, e.Project.Status, FormatDate(e.Project.TenderDeadline), e.Project.Responsible, e.Project.Inspector });
        return new(L("hitRate"), cols, rows);
    }

    private ExportModel BuildCalcExport()
    {
        var cols = CalcAllColumns.Where(c => _visibleCalcColumns.Contains(c)).ToList();
        return new(L("calculationListReport"),
            cols.Select(GetCalcColumnLabel).ToArray(),
            FilteredCalculations.Select(e => (IEnumerable<object?>)cols.Select(c => (object?)GetCalcCellValue(e, c)).ToArray()));
    }

    private ExportModel BuildProjExport()
    {
        var cols = ProjAllColumns.Where(c => _visibleProjColumns.Contains(c)).ToList();
        return new(L("projectListReport"),
            cols.Select(GetProjColumnLabel).ToArray(),
            FilteredProjects.Select(e => (IEnumerable<object?>)cols.Select(c => (object?)GetProjCellValue(e, c)).ToArray()));
    }

    // ── Helpers ───────────────────────────────────────────────────────

    private static string GetChainKey(ListCalculationMVVM c, IReadOnlyDictionary<int, ListCalculationMVVM> lookup)
    {
        var cur = c; var visited = new HashSet<int>();
        while (cur.SourceCalculationId is int sid && visited.Add(cur.Id) && lookup.TryGetValue(sid, out var src)) cur = src;
        return cur.Id.ToString();
    }

    private static int SourcePriority(CalculationVersionType t) => t switch { CalculationVersionType.Production => 3, CalculationVersionType.Contract => 2, _ => 1 };

    private string TypeLabel(CalculationVersionType t) => t switch
    {
        CalculationVersionType.Production => L("productionCalculation"),
        CalculationVersionType.Contract => L("contractCalculation"),
        _ => L("tenderCalculation")
    };

    private static string SubTypeLabel(IncomeSubType t) => t switch { IncomeSubType.Option => "Option", IncomeSubType.ATA => "ÄTA", _ => "Grunddel" };

    private static readonly CalculationRole[] CalculationRoles =
    [
        CalculationRole.MainBid, CalculationRole.SubObject, CalculationRole.Option,
        CalculationRole.ChangeOrder, CalculationRole.InternalObject, CalculationRole.Custom
    ];

    private static string GetCalculationRoleLabel(CalculationRole r) => r switch
    {
        CalculationRole.MainBid => "Huvudkalkyl / Huvudanbud", CalculationRole.SubObject => "Delobjekt",
        CalculationRole.Option => "Option", CalculationRole.ChangeOrder => "ÄTA",
        CalculationRole.InternalObject => "Internt objekt", CalculationRole.Custom => "Egen roll",
        _ => "Huvudkalkyl / Huvudanbud"
    };

    private string HitRateResultLabel(BidHitRateResult r) => r switch { BidHitRateResult.Won => L("won"), BidHitRateResult.Lost => L("lost"), _ => L("undecided") };

    private static bool HasIncome(IncomeBase income) =>
        income.Q1 != 0 || income.Q2 != 0 || income.Q3 != 0 || income.Q4 != 0;

    private int CurrentCalculationCount(ListProjectMVVM project) =>
        _calculations.Count(e => e.Project.Id == project.Id && MatchesArchive(e.Calculation.IsVisible));

    private static string FormatMoney(decimal v) => v.ToString("N0");
    private static string FormatDate(DateTime v) => v == default ? "-" : v.ToString("yyyy-MM-dd");
    private string L(string key) => AppLoc[key].Value;

    private sealed record ProjectEntry(FolderMVVM Folder, ListProjectMVVM Project);
    private sealed record CalculationEntry(FolderMVVM Folder, ListProjectMVVM Project, ListCalculationMVVM Calculation, string ChainKey);
    private sealed record ProjectHitRateEntry(FolderMVVM Folder, ListProjectMVVM Project, BidHitRateResult Result);
    private sealed record IncomeRow(CalculationEntry Entry, int Year, IncomeSubType SubType, decimal Q1, decimal Q2, decimal Q3, decimal Q4, decimal Amount, decimal Forecast, int Probability)
    {
        public string ChainKey => $"{Entry.Project.Id}:{Entry.ChainKey}";
    }
    private sealed record ExportModel(string Title, string[] Columns, IEnumerable<IEnumerable<object?>> Rows);
}
