    // Hopfällbar "Urval"-ruta. Visar full information öppen, kompakt sammanfattning stängd.
    private RenderFragment SelectionBox(string title, string line, string? filters, string? emphasisLine, string note) => @<div class="rounded-lg border border-sky-200 bg-sky-50 px-3 py-2 text-xs text-sky-800 dark:border-sky-800/50 dark:bg-sky-950/30 dark:text-sky-200">
        <button type="button" class="flex w-full items-center justify-between gap-2 text-left" @onclick="ToggleSelectionCollapsed" aria-expanded="@(!_selectionCollapsed)" title="@(_selectionCollapsed ? "Visa urval" : "Dölj urval")">
            @if (_selectionCollapsed)
            {
                <span class="min-w-0 truncate"><span class="font-semibold">@(title):</span> @CompactSelection(line, filters)</span>
            }
            else
            {
                <span class="font-semibold">@title</span>
            }
            <span class="flex shrink-0 items-center gap-1 font-medium text-sky-700 dark:text-sky-300">
                @(_selectionCollapsed ? "Visa" : "Dölj")
                <svg class="h-3 w-3 transition-transform @(_selectionCollapsed ? "" : "rotate-180")" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
            </span>
        </button>
        @if (!_selectionCollapsed)
        {
            <div class="mt-1">
                <p>@line</p>
                @if (!string.IsNullOrWhiteSpace(filters))
                {
                    <p class="mt-1 text-sky-700 dark:text-sky-300">@filters</p>
                }
                @if (!string.IsNullOrWhiteSpace(emphasisLine))
                {
                    <p class="mt-1.5 font-medium text-sky-800 dark:text-sky-200">@emphasisLine</p>
                }
                <p class="mt-1.5 italic text-slate-500 dark:text-slate-400">@note</p>
            </div>
        }
    </div>;

    private static string CompactSelection(string line, string? filters) =>
        string.Join(" · ", new[] { line, filters }.Where(s => !string.IsNullOrWhiteSpace(s)));

