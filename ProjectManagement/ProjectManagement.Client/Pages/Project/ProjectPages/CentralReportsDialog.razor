    private RenderFragment ProjectTable() => @<div class="@TableContainerClass">
        <table class="@TableClass">
            <thead class="@TableHeadClass"><tr><th>@AppLoc["folder"]</th><th>@AppLoc["project"]</th><th>@AppLoc["code"]</th><th>@AppLoc["status"]</th><th>@AppLoc["calculationCount"]</th><th>@AppLoc["startDate"]</th><th>@AppLoc["endDate"]</th></tr></thead>
