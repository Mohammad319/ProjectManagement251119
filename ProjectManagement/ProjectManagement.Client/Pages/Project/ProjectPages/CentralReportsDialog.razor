@using Microsoft.JSInterop
@using ProjectManagement.Client.Helper
@using ProjectManagement.Client.Shared.MVVM.Calculation
@using ProjectManagement.Client.Shared.MVVM.Folder
@using ProjectManagement.Shared.Base.Calculation
@using ProjectManagement.Shared.DTO.Calculation
@using ProjectManagement.Shared.DTO.Project
@using ProjectManagement.Shared.Enums
@using ProjectManagement.Shared.Helper
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthProvider
@inherits AppComponentBase

<div class="flex max-h-[calc(100dvh-10rem)] flex-col gap-3 text-slate-800 dark:text-slate-100">
    <div class="flex shrink-0 flex-wrap gap-1 rounded-lg border border-slate-200 bg-slate-50 p-1 dark:border-slate-700 dark:bg-slate-900">
        @foreach (var report in ReportTabs)
        {
            var avail = AvailabilityFor(report.Key);
            <button type="button" class="@TabClass(report.Key, avail.Enabled)"
                    disabled="@(!avail.Enabled)"
                    title="@(avail.Enabled ? null : avail.DisabledReason)"
                    @onclick="() => SetActiveView(report.Key)">
                @report.Label
            </button>
        }
    </div>

    @if (_isLoading)
    {
        <MhdLoading />
    }
    else
    {
        @if (_activeView == ReportView.Income)
        {
            @* ── Urval visas före filter ── *@
            @SelectionBox("Urval", _incomeSelectionLine, _incomeSelectionFilters, null, "Stäng rapporten och ändra listans filter om du vill ändra urvalet.")

            @* ── Filter: rubrik och fält i samma sammanhängande kort ── *@
            <div class="rounded-lg border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-950">
                <button type="button"
                        class="flex w-full items-center justify-between px-3 py-2 text-left text-xs transition hover:bg-slate-50 dark:hover:bg-slate-900 @(_incomeFiltersExpanded ? "rounded-t-lg border-b border-slate-200 dark:border-slate-800" : "rounded-lg")"
                        aria-expanded="@_incomeFiltersExpanded"
                        @onclick="() => _incomeFiltersExpanded = !_incomeFiltersExpanded">
                    <span><strong>Filter</strong><span class="ml-2 text-slate-500 dark:text-slate-400">@IncomeFilterSummary</span></span>
                    <span class="font-semibold text-sky-600 dark:text-sky-400">@(_incomeFiltersExpanded ? "Dölj" : "Visa")</span>
                </button>
                <div class="@(_incomeFiltersExpanded ? "grid" : "hidden") grid-cols-2 gap-2 p-3 md:grid-cols-4 xl:grid-cols-6">

                @* Kalkyltyp – bara Intäktsöversikt och Kalkyllista *@
            @if (_activeView is ReportView.Income or ReportView.Calculations)
            {
                <div>
                    <label class="@LabelClass">@AppLoc["calculationType"]</label>
                    <select class="@SelectClass" @bind="_selectedCalculationType">
                        <option value="">@AppLoc["allCalculationTypes"]</option>
                        <option value="@CalculationVersionType.Tender">@AppLoc["tenderCalculation"]</option>
                        <option value="@CalculationVersionType.Contract">@AppLoc["contractCalculation"]</option>
                        <option value="@CalculationVersionType.Production">@AppLoc["productionCalculation"]</option>
                    </select>
                </div>
            }

            @* Kalkylstatus – bara Intäktsöversikt och Kalkyllista *@
            @if (_activeView is ReportView.Income or ReportView.Calculations)
            {
                <div class="relative">
                    <label class="@LabelClass">Kalkylstatus</label>
                    <button type="button" class="@SelectClass flex items-center justify-between text-left"
                            @onclick="() => _showStatusDropdown = !_showStatusDropdown">
                        <span class="truncate">@(_selectedStatuses.Count == 0 ? AppLoc["allStatuses"].Value : $"{_selectedStatuses.Count} {AppLoc["selected"].Value}")</span>
                        @ChevronSvg
                    </button>
                    @if (_showStatusDropdown)
                    {
                        <div class="fixed inset-0 z-40" @onclick="() => _showStatusDropdown = false"></div>
                        <div class="absolute z-50 mt-0.5 min-w-full overflow-auto rounded-md border border-slate-200 bg-white shadow-lg dark:border-slate-700 dark:bg-slate-900" style="max-height:12rem">
                            <label class="flex cursor-pointer items-center gap-2 px-3 py-1.5 text-xs hover:bg-sky-50 dark:hover:bg-sky-950/30">
                                <input type="checkbox" class="h-3.5 w-3.5 rounded border-slate-300" checked="@(_selectedStatuses.Count == 0)" @onchange="() => _selectedStatuses.Clear()" />
                                <span class="text-slate-500 dark:text-slate-400">@AppLoc["allStatuses"]</span>
                            </label>
                            @foreach (var s in AvailableCalcStatuses) { var sv = s;
                                <label class="flex cursor-pointer items-center gap-2 px-3 py-1.5 text-xs text-slate-800 hover:bg-sky-50 dark:text-slate-200 dark:hover:bg-sky-950/30">
                                    <input type="checkbox" class="h-3.5 w-3.5 rounded border-slate-300" checked="@_selectedStatuses.Contains(sv)" @onchange="e => ToggleStatus(sv, (bool)(e.Value ?? false))" />
                                    <span>@sv</span>
                                </label>
                            }
                        </div>
                    }
                </div>
            }

            @* Projektstatus – bara Projektlista *@
            @if (_activeView == ReportView.Projects)
            {
                <div class="relative">
                    <label class="@LabelClass">Projektstatus</label>
                    <button type="button" class="@SelectClass flex items-center justify-between text-left"
                            @onclick="() => _showProjectStatusDropdown = !_showProjectStatusDropdown">
                        <span class="truncate">@(_selectedProjectStatuses.Count == 0 ? AppLoc["allStatuses"].Value : $"{_selectedProjectStatuses.Count} {AppLoc["selected"].Value}")</span>
                        @ChevronSvg
                    </button>
                    @if (_showProjectStatusDropdown)
                    {
                        <div class="fixed inset-0 z-40" @onclick="() => _showProjectStatusDropdown = false"></div>
                        <div class="absolute z-50 mt-0.5 min-w-full overflow-auto rounded-md border border-slate-200 bg-white shadow-lg dark:border-slate-700 dark:bg-slate-900" style="max-height:12rem">
                            <label class="flex cursor-pointer items-center gap-2 px-3 py-1.5 text-xs hover:bg-sky-50 dark:hover:bg-sky-950/30">
                                <input type="checkbox" class="h-3.5 w-3.5 rounded border-slate-300" checked="@(_selectedProjectStatuses.Count == 0)" @onchange="() => _selectedProjectStatuses.Clear()" />
                                <span class="text-slate-500 dark:text-slate-400">@AppLoc["allStatuses"]</span>
                            </label>
                            @foreach (var s in AvailableProjectStatuses) { var sv = s;
                                <label class="flex cursor-pointer items-center gap-2 px-3 py-1.5 text-xs text-slate-800 hover:bg-sky-50 dark:text-slate-200 dark:hover:bg-sky-950/30">
                                    <input type="checkbox" class="h-3.5 w-3.5 rounded border-slate-300" checked="@_selectedProjectStatuses.Contains(sv)" @onchange="e => ToggleProjectStatus(sv, (bool)(e.Value ?? false))" />
                                    <span>@sv</span>
                                </label>
                            }
                        </div>
                    }
                </div>
            }

            @* Kalkylroll – bara Intäktsöversikt och Kalkyllista *@
            @if (_activeView is ReportView.Income or ReportView.Calculations)
            {
                <div>
                    <label class="@LabelClass">Kalkylroll</label>
                    <select class="@SelectClass" @bind="_selectedCalculationRole">
                        <option value="">@AppLoc["allItems"]</option>
                        @foreach (var role in CalculationRoles) { <option value="@role">@GetCalculationRoleLabel(role)</option> }
                    </select>
                </div>
            }

            @* År *@
            <div>
                <label class="@LabelClass">@AppLoc["year"]</label>
                <select class="@SelectClass" @bind="_selectedYear">
                    <option value="">@AppLoc["allYears"]</option>
                    @foreach (var year in AvailableYears) { <option value="@year">@year</option> }
                </select>
            </div>

            @* Kvartal *@
            <div>
                <label class="@LabelClass">@AppLoc["quarter"]</label>
                <select class="@SelectClass" @bind="_selectedQuarter">
                    <option value="0">@AppLoc["allQuarters"]</option>
                    <option value="1">Q1</option><option value="2">Q2</option>
                    <option value="3">Q3</option><option value="4">Q4</option>
                </select>
            </div>

            @* Kalkylansvarig – multi-select *@
            <div class="relative">
                <label class="@LabelClass">@AppLoc["calculationResponsible"]</label>
                <button type="button" class="@SelectClass flex items-center justify-between text-left"
                        @onclick="() => _showResponsibleDropdown = !_showResponsibleDropdown">
                    <span class="truncate">@(_selectedResponsibles.Count == 0 ? AppLoc["allItems"].Value : $"{_selectedResponsibles.Count} {AppLoc["selected"].Value}")</span>
                    @ChevronSvg
                </button>
                @if (_showResponsibleDropdown)
                {
                    <div class="fixed inset-0 z-40" @onclick="() => _showResponsibleDropdown = false"></div>
                    <div class="absolute z-50 mt-0.5 min-w-full overflow-auto rounded-md border border-slate-200 bg-white shadow-lg dark:border-slate-700 dark:bg-slate-900" style="max-height:12rem">
                        @PersonDropdownHeader(_selectedResponsibles, () => _selectedResponsibles.Clear())
                        @PersonDropdownMissing(_selectedResponsibles, v => ToggleResponsible(v, true), v => ToggleResponsible(v, false))
                        @foreach (var p in AvailableResponsibles) { var pv = p;
                            <label class="flex cursor-pointer items-center gap-2 px-3 py-1.5 text-xs text-slate-800 hover:bg-sky-50 dark:text-slate-200 dark:hover:bg-sky-950/30">
                                <input type="checkbox" class="h-3.5 w-3.5 rounded border-slate-300" checked="@_selectedResponsibles.Contains(pv)" @onchange="e => ToggleResponsible(pv, (bool)(e.Value ?? false))" />
                                <span>@pv</span>
                            </label>
                        }
                    </div>
                }
            </div>

            @* Granskare – multi-select *@
            <div class="relative">
                <label class="@LabelClass">@AppLoc["reviewer"]</label>
                <button type="button" class="@SelectClass flex items-center justify-between text-left"
                        @onclick="() => _showInspectorDropdown = !_showInspectorDropdown">
                    <span class="truncate">@(_selectedInspectors.Count == 0 ? AppLoc["allItems"].Value : $"{_selectedInspectors.Count} {AppLoc["selected"].Value}")</span>
                    @ChevronSvg
                </button>
                @if (_showInspectorDropdown)
                {
                    <div class="fixed inset-0 z-40" @onclick="() => _showInspectorDropdown = false"></div>
                    <div class="absolute z-50 mt-0.5 min-w-full overflow-auto rounded-md border border-slate-200 bg-white shadow-lg dark:border-slate-700 dark:bg-slate-900" style="max-height:12rem">
                        @PersonDropdownHeader(_selectedInspectors, () => _selectedInspectors.Clear())
                        @PersonDropdownMissing(_selectedInspectors, v => ToggleInspector(v, true), v => ToggleInspector(v, false))
                        @foreach (var p in AvailableInspectors) { var pv = p;
                            <label class="flex cursor-pointer items-center gap-2 px-3 py-1.5 text-xs text-slate-800 hover:bg-sky-50 dark:text-slate-200 dark:hover:bg-sky-950/30">
                                <input type="checkbox" class="h-3.5 w-3.5 rounded border-slate-300" checked="@_selectedInspectors.Contains(pv)" @onchange="e => ToggleInspector(pv, (bool)(e.Value ?? false))" />
                                <span>@pv</span>
                            </label>
                        }
                    </div>
                }
            </div>

            @* Arkiverade *@
            <div>
                <label class="@LabelClass">@AppLoc["archivedItems"]</label>
                <select class="@SelectClass" @bind="_selectedArchiveMode">
                    <option value="active">@AppLoc["notArchived"]</option>
                    <option value="all">@AppLoc["allItems"]</option>
                    <option value="archived">@AppLoc["archivedOnly"]</option>
                </select>
            </div>

            @* Intäktskälla – bara Intäktsöversikt *@
            @if (_activeView == ReportView.Income)
            {
                <div>
                    <label class="@LabelClass">@AppLoc["incomeSource"]</label>
                    <select class="@SelectClass" @bind="_selectedIncomeSource">
                        <option value="auto">@AppLoc["automatic"]</option>
                        <option value="@CalculationVersionType.Tender">@AppLoc["tenderCalculation"]</option>
                        <option value="@CalculationVersionType.Contract">@AppLoc["contractCalculation"]</option>
                        <option value="@CalculationVersionType.Production">@AppLoc["productionCalculation"]</option>
                    </select>
                </div>
                <div>
                    <label class="@LabelClass">Deltyp</label>
                    <select class="@SelectClass" @bind="_selectedSubType">
                        <option value="">@AppLoc["allItems"]</option>
                        <option value="@((int)IncomeSubType.Grunddel)">Grunddel</option>
                        <option value="@((int)IncomeSubType.Option)">Option</option>
                        <option value="@((int)IncomeSubType.ATA)">ÄTA</option>
                    </select>
                </div>
            }
                </div>
            </div>

            @* ═══ INTÄKTSÖVERSIKT ═══ *@
            <div class="flex flex-nowrap items-center justify-between gap-2">
                <div class="grid min-w-0 grid-cols-2 gap-2 md:grid-cols-4">
                    <div class="@TotalCardClass"><span>@AppLoc["revenue"]</span><strong>@FormatMoney(IncludedFilteredIncomeRows.Sum(r => r.Amount))</strong></div>
                    <div class="@TotalCardClass"><span>@AppLoc["forecast"]</span><strong>@FormatMoney(IncludedFilteredIncomeRows.Sum(r => r.Forecast))</strong></div>
                    <div class="@TotalCardClass"><span>Projekt</span><strong>@IncludedFilteredIncomeRows.Select(r => r.Entry.Project.Id).Distinct().Count()</strong></div>
                    <div class="@TotalCardClass">
                        <span class="inline-flex items-center gap-1">
                            Kalkyler
                            @if (IncomeVersionInfoRelevant)
                            {
                                <button type="button" class="inline-flex h-4 w-4 items-center justify-center rounded-full border border-slate-300 text-[10px] font-bold text-slate-500 hover:border-sky-400 hover:text-sky-600 dark:border-slate-600 dark:text-slate-400"
                                        title="Aktuell version används per kalkylfamilj. Intäkt räknas en gång per kalkylkedja."
                                        aria-label="Information om versioner och kalkylkedjor">i</button>
                            }
                        </span>
                        <strong>@IncludedFilteredIncomeRows.Select(r => r.Entry.Calculation.Id).Distinct().Count()</strong>
                    </div>
                </div>
                <div class="flex flex-nowrap items-center gap-1.5 shrink-0">
                    <button type="button"
                            class="@(_showQuarters ? "inline-flex h-8 items-center rounded-lg bg-sky-600 px-3 text-xs font-semibold text-white shadow-sm transition hover:bg-sky-700" : ActionButtonClass)"
                            @onclick="() => _showQuarters = !_showQuarters">
                        @(_showQuarters ? "Dölj Q1–Q4" : "Visa Q1–Q4")
                    </button>
                    @IncomeColumnPanel()
                    <button type="button" class="@ActionButtonClass" @onclick="ExportExcelAsync">@AppLoc["exportExcel"]</button>
                    <button type="button" class="@ActionButtonClass" @onclick="ExportPdfAsync">@AppLoc["exportPdf"]</button>
                    <button type="button" class="@ActionButtonClass" @onclick="PrintAsync">@AppLoc["print"]</button>
                </div>
            </div>
            var _incCalcCols = IncomeCalcColumns.Where(c => _visibleIncomeColumns.Contains(c)).ToList();
            var _incShowRowNo = _visibleIncomeColumns.Contains(IncomeReportColumn.RowNumber);
            var _incShowQ = _showQuarters && _incCalcCols.Contains(IncomeReportColumn.Year);
            var _incColSpan = 1 + (_incShowRowNo ? 1 : 0) + _incCalcCols.Count + (_incShowQ ? 4 : 0);
            <div class="@TableContainerClass">
                <table class="@TableClass">
                    <thead class="@TableHeadClass">
                        <tr>
                            <th class="w-8 text-center" title="@IncludeColumnTooltip"><span aria-hidden="true">☑</span><span class="sr-only">@IncludeColumnTooltip</span></th>
                            @if (_incShowRowNo) { <th class="w-10 text-right text-slate-400">#</th> }
                            @for (int hi = 0; hi < _incCalcCols.Count; hi++)
                            {
                                var hcol = _incCalcCols[hi];
                                <th class="@(IsIncomeColumnNumeric(hcol) ? "text-right" : "")" title="@GetIncomeColumnTitle(hcol)">@GetIncomeColumnLabel(hcol)</th>
                                if (hcol == IncomeReportColumn.Year && _showQuarters)
                                {
                                    <th class="text-right">Q1</th><th class="text-right">Q2</th><th class="text-right">Q3</th><th class="text-right">Q4</th>
                                }
                            }
                        </tr>
                    </thead>
                    <tbody class="@TableBodyClass">
                        @{ var dri = 0; var incRowNo = 0; }
                        @foreach (var row in BuildIncomeTableRows())
                        {
                            if (row.Kind == IncomeTableRowKind.Data)
                            {
                                var excl = _excludedRowKeys.Contains(row.RowKey);
                                var incNo = ++incRowNo;
                                <tr class="@(dri++ % 2 == 0 ? "" : "bg-slate-50/70 dark:bg-slate-900/30") @(excl ? "opacity-40" : "")">
                                    <td class="text-center"><input type="checkbox" class="h-3.5 w-3.5 rounded border-slate-300 text-sky-600" title="@IncludeRowTooltip" aria-label="@IncludeRowTooltip" checked="@(!excl)" @onchange="() => ToggleRowInclusion(row.RowKey)" /></td>
                                    @if (_incShowRowNo) { <td class="text-right text-slate-400">@incNo</td> }
                                    @for (int di = 0; di < _incCalcCols.Count; di++)
                                    {
                                        var dcol = _incCalcCols[di];
                                        <td class="@GetIncomeTdClass(dcol)">@GetIncomeDataCellValue(row, dcol)</td>
                                        if (dcol == IncomeReportColumn.Year && _showQuarters)
                                        {
                                            <td class="text-right">@FormatMoney(row.Q1)</td><td class="text-right">@FormatMoney(row.Q2)</td><td class="text-right">@FormatMoney(row.Q3)</td><td class="text-right">@FormatMoney(row.Q4)</td>
                                        }
                                    }
                                </tr>
                            }
                            else if (row.Kind == IncomeTableRowKind.ProjectHeader)
                            {
                                var _projFields = BuildIncomeProjectFields(row);
                                <tr class="border-t border-slate-200 bg-slate-100/80 dark:border-slate-700 dark:bg-slate-800/60">
                                    <td colspan="@_incColSpan" class="!py-1.5">
                                        <span class="font-semibold text-slate-700 dark:text-slate-100">@IncomeProjectHeaderTitle(row)</span>
                                        @if (!string.IsNullOrWhiteSpace(_projFields))
                                        {
                                            <span class="ml-2 text-[11px] font-normal text-slate-500 dark:text-slate-400">@_projFields</span>
                                        }
                                        <span class="ml-2 text-[11px] font-normal text-slate-500 dark:text-slate-400">@IncomeProjectSummary(row)</span>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                <tr class="@IncomeRowClass(row.Kind)">
                                    <td></td>
                                    @if (_incShowRowNo) { <td></td> }
                                    @for (int si = 0; si < _incCalcCols.Count; si++)
                                    {
                                        var scol = _incCalcCols[si];
                                        if (si == 0)
                                        {
                                            <td>@row.SummaryLabel</td>
                                        }
                                        else if (scol == IncomeReportColumn.Amount)
                                        {
                                            <td class="text-right">@FormatMoney(row.Amount)</td>
                                        }
                                        else if (scol == IncomeReportColumn.Forecast)
                                        {
                                            <td class="text-right font-semibold">@FormatMoney(row.Forecast)</td>
                                        }
                                        else
                                        {
                                            <td></td>
                                        }
                                        if (scol == IncomeReportColumn.Year && _showQuarters)
                                        {
                                            <td class="text-right">@FormatMoney(row.Q1)</td><td class="text-right">@FormatMoney(row.Q2)</td><td class="text-right">@FormatMoney(row.Q3)</td><td class="text-right">@FormatMoney(row.Q4)</td>
                                        }
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }

        @* ═══ HIT RATE ═══ *@
        else if (_activeView == ReportView.HitRate)
        {
            @SelectionBox("Projekturval", _hitRateSelectionLine, _hitRateSelectionFilters, HitRateBasisLine, "Stäng rapporten och ändra projektlistans filter om du vill ändra urvalet.")

            @if (_lockedHitRateProjects.Count == 0)
            {
                <p class="rounded-lg border border-slate-200 bg-white p-4 text-xs text-slate-500 dark:border-slate-800 dark:bg-slate-950">Inga projekt matchar aktuellt urval.</p>
            }
            else
            {
                <div class="grid grid-cols-3 gap-2">
                    <div class="@TotalCardClass"><span>Vunna</span><strong>@WonCount</strong></div>
                    <div class="@TotalCardClass"><span>Förlorade</span><strong>@LostCount</strong></div>
                    <div class="@TotalCardClass"><span>Hit rate / träffsäkerhet</span><strong>@HitRateDisplay</strong></div>
                </div>
                @if (DecidedCount == 0)
                {
                    <p class="text-xs text-slate-500 dark:text-slate-400">Hit rate kan inte beräknas eftersom inga vunna eller förlorade projekt finns i urvalet.</p>
                }
                <div class="flex flex-nowrap items-center justify-between gap-2">
                    <span class="text-xs text-slate-400">@DecidedCount vunna/förlorade</span>
                    <div class="flex flex-nowrap items-center gap-1.5 shrink-0">
                        @HitRateColumnPanel()
                        <button type="button" class="@ActionButtonClass" @onclick="ExportExcelAsync">@AppLoc["exportExcel"]</button>
                        <button type="button" class="@ActionButtonClass" @onclick="ExportPdfAsync">@AppLoc["exportPdf"]</button>
                        <button type="button" class="@ActionButtonClass" @onclick="PrintAsync">@AppLoc["print"]</button>
                    </div>
                </div>
                @HitRateProjectTable()
            }
        }

        @* ═══ KALKYLLISTA ═══ *@
        else if (_activeView == ReportView.Calculations)
        {
            @SelectionBox("Kalkylurval", _calcReportSelectionLine, _calcReportSelectionFilters, null, "Stäng rapporten och ändra filtren om du vill ändra urvalet.")

            @if (_lockedCalcReportList.Count == 0)
            {
                <p class="rounded-lg border border-slate-200 bg-white p-4 text-xs text-slate-500 dark:border-slate-800 dark:bg-slate-950">Inga kalkyler matchar aktuellt urval.</p>
            }
            else
            {
                <div class="flex flex-nowrap items-center justify-between gap-2">
                    <span class="text-xs text-slate-400">@IncludedCalcReportList.Count @AppLoc["rows"].Value.ToLower()</span>
                    <div class="flex flex-nowrap items-center gap-1.5 shrink-0">
                        @CalcColumnPanel()
                        <button type="button" class="@ActionButtonClass" @onclick="ExportExcelAsync">@AppLoc["exportExcel"]</button>
                        <button type="button" class="@ActionButtonClass" @onclick="ExportPdfAsync">@AppLoc["exportPdf"]</button>
                        <button type="button" class="@ActionButtonClass" @onclick="PrintAsync">@AppLoc["print"]</button>
                    </div>
                </div>
                @CalculationTable(_lockedCalcReportList)
            }
        }

        @* ═══ PROJEKTLISTA ═══ *@
        else if (_activeView == ReportView.Projects)
        {
            @SelectionBox("Projekturval", _projReportSelectionLine, _projReportSelectionFilters, null, "Stäng rapporten och ändra projektlistans filter om du vill ändra urvalet.")

            @if (_lockedProjReportProjects.Count == 0)
            {
                <p class="rounded-lg border border-slate-200 bg-white p-4 text-xs text-slate-500 dark:border-slate-800 dark:bg-slate-950">Inga projekt matchar aktuellt urval.</p>
            }
            else
            {
                <div class="flex flex-nowrap items-center justify-between gap-2">
                    <span class="text-xs text-slate-400">@IncludedProjReportProjects.Count projekt</span>
                    <div class="flex flex-nowrap items-center gap-1.5 shrink-0">
                        @ProjColumnPanel()
                        <button type="button" class="@ActionButtonClass" @onclick="ExportExcelAsync">@AppLoc["exportExcel"]</button>
                        <button type="button" class="@ActionButtonClass" @onclick="ExportPdfAsync">@AppLoc["exportPdf"]</button>
                        <button type="button" class="@ActionButtonClass" @onclick="PrintAsync">@AppLoc["print"]</button>
                    </div>
                </div>
                @ProjectTable(_lockedProjReportProjects)
            }
        }

        @* ═══ ANBUDSJÄMFÖRELSE ═══ *@
        else if (_activeView == ReportView.BidComparison)
        {
            @SelectionBox("Projekturval", _bidReportSelectionLine, _bidReportSelectionFilters, null, "Stäng rapporten och ändra projektlistans filter om du vill ändra urvalet.")

            @if (_lockedBidRows.Count == 0)
            {
                <div class="rounded-lg border border-slate-200 bg-white p-4 text-xs text-slate-500 dark:border-slate-800 dark:bg-slate-950">
                    <p class="font-medium text-slate-600 dark:text-slate-300">Inga anbud hittades för aktuellt projekturval.</p>
                    <p class="mt-1">Kontrollera att projekten har registrerade anbud eller ändra projektlistans filter.</p>
                </div>
            }
            else
            {
                <div class="grid grid-cols-2 gap-2 md:grid-cols-4">
                    <div class="@TotalCardClass"><span>Projekt med anbud</span><strong>@BidProjectsWithBids</strong></div>
                    <div class="@TotalCardClass"><span>Antal anbud</span><strong>@BidCount</strong></div>
                    <div class="@TotalCardClass"><span>Antal anbudsgivare</span><strong>@BidderCount</strong></div>
                    <div class="@TotalCardClass"><span>Tilldelade anbud</span><strong>@AwardedCount</strong></div>
                </div>
                @* Separat KPI-rad för valt jämförelseföretag ("Jämför mot"). *@
                @if (HasOwnCompany)
                {
                    <div class="grid grid-cols-2 gap-2 md:grid-cols-3">
                        <div class="@TotalCardClass"><span>Anbud för @_ownCompanyName</span><strong>@OwnBidCount</strong></div>
                        <div class="@TotalCardClass"><span>Tilldelningar</span><strong>@OwnAwardedCount</strong></div>
                        <div class="@TotalCardClass"><span>Genomsnittlig placering</span><strong>@OwnAvgPlacement</strong></div>
                    </div>
                }

                <div class="flex flex-nowrap items-center justify-between gap-2">
                    <div class="flex flex-nowrap items-center gap-1.5 min-w-0">
                        @* Anbudsgivare – multi-select *@
                        <div class="relative w-48 min-w-0 shrink">
                            <button type="button" class="@SelectClass flex h-8 w-full items-center justify-between text-left" @onclick="() => _showBidderDropdown = !_showBidderDropdown">
                                <span class="truncate">@(_selectedBidders.Count == 0 ? "Alla anbudsgivare" : $"{_selectedBidders.Count} valda")</span>
                                @ChevronSvg
                            </button>
                            @if (_showBidderDropdown)
                            {
                                <div class="fixed inset-0 z-40" @onclick="() => _showBidderDropdown = false"></div>
                                <div class="absolute z-50 mt-0.5 min-w-full overflow-auto rounded-md border border-slate-200 bg-white shadow-lg dark:border-slate-700 dark:bg-slate-900" style="max-height:14rem">
                                    <label class="flex cursor-pointer items-center gap-2 px-3 py-1.5 text-xs hover:bg-sky-50 dark:hover:bg-sky-950/30">
                                        <input type="checkbox" class="h-3.5 w-3.5 rounded border-slate-300" checked="@(_selectedBidders.Count == 0)" @onchange="() => _selectedBidders.Clear()" />
                                        <span class="text-slate-500 dark:text-slate-400">Alla anbudsgivare</span>
                                    </label>
                                    @foreach (var b in AvailableBidders) { var bv = b;
                                        <label class="flex cursor-pointer items-center gap-2 px-3 py-1.5 text-xs text-slate-800 hover:bg-sky-50 dark:text-slate-200 dark:hover:bg-sky-950/30">
                                            <input type="checkbox" class="h-3.5 w-3.5 rounded border-slate-300" checked="@_selectedBidders.Contains(bv)" @onchange="e => ToggleBidder(bv, (bool)(e.Value ?? false))" />
                                            <span>@bv</span>
                                        </label>
                                    }
                                </div>
                            }
                        </div>

                        @* Jämför mot (referensföretag — påverkar endast rapportens jämförelseberäkning) *@
                        <div class="relative w-48 min-w-0 shrink">
                            <button type="button" class="@SelectClass flex h-8 w-full items-center justify-between text-left" @onclick="() => _showOwnCompanyDropdown = !_showOwnCompanyDropdown">
                                <span class="truncate">@(HasOwnCompany ? $"Jämför mot: {_ownCompanyName}" : "Jämför mot: inget")</span>
                                @ChevronSvg
                            </button>
                            @if (_showOwnCompanyDropdown)
                            {
                                <div class="fixed inset-0 z-40" @onclick="() => _showOwnCompanyDropdown = false"></div>
                                <div class="absolute z-50 mt-0.5 min-w-full overflow-auto rounded-md border border-slate-200 bg-white shadow-lg dark:border-slate-700 dark:bg-slate-900" style="max-height:14rem">
                                    <label class="flex cursor-pointer items-center gap-2 px-3 py-1.5 text-xs hover:bg-sky-50 dark:hover:bg-sky-950/30">
                                        <input type="radio" name="ownco" class="h-3.5 w-3.5" checked="@(!HasOwnCompany)" @onchange="() => { _ownCompanyName = string.Empty; _showOwnCompanyDropdown = false; }" />
                                        <span class="text-slate-500 dark:text-slate-400">Inget</span>
                                    </label>
                                    @foreach (var b in AvailableBidders) { var bv = b;
                                        <label class="flex cursor-pointer items-center gap-2 px-3 py-1.5 text-xs text-slate-800 hover:bg-sky-50 dark:text-slate-200 dark:hover:bg-sky-950/30">
                                            <input type="radio" name="ownco" class="h-3.5 w-3.5" checked="@(string.Equals(_ownCompanyName, bv, StringComparison.OrdinalIgnoreCase))" @onchange="() => { _ownCompanyName = bv; _showOwnCompanyDropdown = false; }" />
                                            <span>@bv</span>
                                        </label>
                                    }
                                </div>
                            }
                        </div>

                        @* Tilldelad / ej tilldelad *@
                        <select class="@SelectClass h-8 w-44 min-w-0 shrink" @bind="_awardedFilter">
                            <option value="all">Alla anbud</option>
                            <option value="awarded">Endast tilldelade</option>
                            <option value="notawarded">Endast ej tilldelade</option>
                        </select>

                        @* Visa förkastade *@
                        <label class="inline-flex h-8 shrink-0 cursor-pointer items-center gap-1.5 whitespace-nowrap rounded-lg border border-slate-300 bg-white px-2.5 text-xs font-medium text-slate-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200">
                            <input type="checkbox" class="h-3.5 w-3.5 rounded border-slate-300" checked="@_showRejectedBids" @onchange="e => _showRejectedBids = (bool)(e.Value ?? false)" />
                            Visa förkastade
                        </label>
                    </div>

                    <div class="flex flex-nowrap items-center gap-1.5 shrink-0">
                        @BidColumnPanel()
                        <button type="button" class="@ActionButtonClass" @onclick="ExportExcelAsync">@AppLoc["exportExcel"]</button>
                        <button type="button" class="@ActionButtonClass" @onclick="ExportPdfAsync">@AppLoc["exportPdf"]</button>
                        <button type="button" class="@ActionButtonClass" @onclick="PrintAsync">@AppLoc["print"]</button>
                    </div>
                </div>

                @if (!FilteredBidRows.Any())
                {
                    <p class="rounded-lg border border-slate-200 bg-white p-4 text-xs text-slate-500 dark:border-slate-800 dark:bg-slate-950">Inga anbud matchar aktuella anbudsfilter.</p>
                }
                else
                {
                    @* Grupperad per projekt: Projekt/Mapp visas i gruppheader, anbuden under. *@
                    var rowCols = BidRowColumns.ToList();
                    var showRowNo = _visibleBidColumns.Contains(BidReportColumn.RowNumber);
                    var colSpan = 1 + (showRowNo ? 1 : 0) + rowCols.Count;
                    var groups = FilteredBidRows
                        .GroupBy(r => r.Row.ProjectId)
                        .OrderBy(g => g.First().ProjectName, StringComparer.CurrentCultureIgnoreCase)
                        .ToList();
                    <div class="@TableContainerClass">
                        <table class="@TableClass">
                            <thead class="@TableHeadClass"><tr>
                                <th class="w-8 text-center" title="@IncludeColumnTooltip"><span aria-hidden="true">☑</span><span class="sr-only">@IncludeColumnTooltip</span></th>
                                @if (showRowNo) { <th class="w-10 text-right text-slate-400">#</th> }
                                @foreach (var c in rowCols) { <th>@GetBidColumnLabel(c)</th> }
                            </tr></thead>
                            <tbody class="@TableBodyClass">
                                @{ var bidRowNo = 0; }
                                @foreach (var g in groups)
                                {
                                    var head = g.First();
                                    var validInGroup = g.Where(r => r.Row.IsValid && r.Row.ComparisonAmount.HasValue).ToList();
                                    var lowestInGroup = validInGroup.Count > 0 ? validInGroup.Min(r => r.Row.ComparisonAmount!.Value) : (decimal?)null;
                                    var awardedNames = g.Where(r => r.Row.IsAwarded).Select(r => r.Row.BidderName).ToList();
                                    <tr class="border-t border-slate-200 bg-slate-100/80 dark:border-slate-700 dark:bg-slate-800/60">
                                        <td colspan="@colSpan" class="!py-1.5">
                                            <span class="font-semibold text-slate-700 dark:text-slate-100">@head.ProjectName</span>
                                            <span class="text-slate-400"> · @head.FolderName</span>
                                            <span class="ml-2 text-[11px] font-normal text-slate-500 dark:text-slate-400">
                                                @g.Count() anbud · lägst jämförelsesumma @(lowestInGroup.HasValue ? FormatMoney(lowestInGroup.Value) : "–") · tilldelad: @(awardedNames.Count > 0 ? string.Join(", ", awardedNames) : "–")
                                            </span>
                                        </td>
                                    </tr>
                                    @foreach (var r in g)
                                    {
                                        var key = BidRowKey(r); var inc = RowIncluded(key); bidRowNo++;
                                        var rejected = r.Row.Status == BidStatus.Rejected;
                                        <tr class="@(IsOwnCompany(r) ? "bg-sky-50/70 dark:bg-sky-950/20" : "") @(rejected ? "text-slate-400 dark:text-slate-500" : "") @(inc ? "" : "opacity-40")">
                                            <td class="text-center"><input type="checkbox" class="h-3.5 w-3.5 rounded border-slate-300 text-sky-600" title="@IncludeRowTooltip" aria-label="@IncludeRowTooltip" checked="@inc" @onchange="() => ToggleRowInclusion(key)" /></td>
                                            @if (showRowNo) { <td class="text-right text-slate-400">@bidRowNo</td> }
                                            @foreach (var c in rowCols)
                                            {
                                                @if (c == BidReportColumn.Bidder)
                                                {
                                                    <td>
                                                        <span class="font-medium text-slate-700 dark:text-slate-200">@r.Row.BidderName</span>
                                                        @if (IsOwnCompany(r))
                                                        {
                                                            <span class="ml-1.5 inline-flex rounded-full bg-sky-100 px-1.5 py-0.5 text-[10px] font-semibold text-sky-700 dark:bg-sky-950/50 dark:text-sky-300">Eget</span>
                                                        }
                                                    </td>
                                                }
                                                else if (c == BidReportColumn.Awarded)
                                                {
                                                    <td class="text-center">
                                                        @if (r.Row.IsAwarded)
                                                        {
                                                            <span class="font-semibold text-emerald-600 dark:text-emerald-400" title="Tilldelad">✓</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-slate-300 dark:text-slate-600">–</span>
                                                        }
                                                    </td>
                                                }
                                                else if (c == BidReportColumn.BidStatus)
                                                {
                                                    <td>
                                                        @if (rejected)
                                                        {
                                                            <span class="inline-flex rounded-full bg-red-100 px-1.5 py-0.5 text-[10px] font-semibold text-red-700 dark:bg-red-950/50 dark:text-red-300" title="@r.Row.RejectionReason">Förkastat</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="inline-flex rounded-full bg-slate-100 px-1.5 py-0.5 text-[10px] font-semibold text-slate-600 dark:bg-slate-800 dark:text-slate-300">Giltigt</span>
                                                        }
                                                    </td>
                                                }
                                                else if (c == BidReportColumn.Deviation)
                                                {
                                                    <td>@BidDeviationText(r)</td>
                                                }
                                                else
                                                {
                                                    <td>@GetBidCellValue(r, c)</td>
                                                }
                                            }
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                    <p class="text-xs text-slate-400">@FilteredBidRows.Count() anbud</p>
                }
            }
        }
    }
</div>

@code {
    public static class ReportView
    {
        public const string Income = "income";
        public const string HitRate = "hit-rate";
        public const string Calculations = "calculations";
        public const string Projects = "projects";
        public const string BidComparison = "bid-comparison";
        public const string Export = "export";
    }

    // ── Shared report availability (used by dropdowns and dialog tabs) ─

    public enum ReportHost { Projects, Calculations }

    public sealed record ReportAvailability(string View, string LabelKey, bool Enabled, string? DisabledReason);

    public const string ShowProjectsFirstTooltip = "Visa projekt först för att använda denna rapport.";
    public const string ShowProjectsFirstIncomeTooltip = "Visa projekt först för att använda Intäktsöversikt.";
    public const string ShowProjectsFirstBidTooltip = "Visa projekt först för att använda Anbudsjämförelse.";
    public const string ShowCalculationsFirstTooltip = "Visa kalkyler först för att använda denna rapport.";

    public static IReadOnlyList<ReportAvailability> GetReportAvailability(ReportHost host) => host switch
    {
        ReportHost.Calculations =>
        [
            new(ReportView.Calculations, "calculationListReport", true, null),
            new(ReportView.Income, "incomeOverview", false, ShowProjectsFirstIncomeTooltip),
            new(ReportView.HitRate, "hitRate", false, ShowProjectsFirstTooltip),
            new(ReportView.BidComparison, "bidComparison", false, ShowProjectsFirstBidTooltip),
            new(ReportView.Projects, "projectListReport", false, ShowProjectsFirstTooltip)
        ],
        _ =>
        [
            new(ReportView.Income, "incomeOverview", true, null),
            new(ReportView.HitRate, "hitRate", true, null),
            new(ReportView.BidComparison, "bidComparison", true, null),
            new(ReportView.Projects, "projectListReport", true, null),
            new(ReportView.Calculations, "calculationListReport", false, ShowCalculationsFirstTooltip)
        ]
    };

    public static bool IsReportEnabled(ReportHost host, string view) =>
        GetReportAvailability(host).FirstOrDefault(a => a.View == view)?.Enabled ?? false;

    private enum IncomeTableRowKind { Data, ProjectHeader, ProjectSum, GrandTotal, SubTypeTotal, YearTotal }

    private enum CalcReportColumn
    {
        Folder, Project, Calculation, Version, CalcType, CalcStatus, CalcRole,
        Responsible, Inspector, TenderQA, TenderDeadline, Priority, CreatedAt, UpdatedAt, Archived,
        Code, Private,
        // Appended last to keep existing stored column-pref indices stable.
        RowNumber
    }

    private enum ProjReportColumn
    {
        Folder, Project, Code, ProjStatus, CalcCount,
        StartDate, EndDate, TenderDeadline, TenderQA,
        Responsible, Inspector, ProjectType, Contract,
        Organisation, ProcurementName, Archived,
        ProcurementProcedure, Compensation, ProcurementNumber,
        Developer, PublicationDate, DecisionDate, CreatedAt, UpdatedAt,
        // Appended last to keep existing stored column-pref indices stable.
        RowNumber,
        // "Delat" – Ja/Nej whether the project is internally shared. Appended after RowNumber
        // so existing stored column-pref indices stay stable.
        Shared
    }

    private static readonly CalcReportColumn[] CalcAllColumns = Enum.GetValues<CalcReportColumn>();
    private static readonly CalcReportColumn[] CalcDefaultColumns =
    [
        CalcReportColumn.RowNumber,
        CalcReportColumn.Folder, CalcReportColumn.Project, CalcReportColumn.Calculation,
        CalcReportColumn.Version, CalcReportColumn.CalcType, CalcReportColumn.CalcStatus,
        CalcReportColumn.Responsible, CalcReportColumn.Inspector
    ];

    private static readonly ProjReportColumn[] ProjAllColumns = Enum.GetValues<ProjReportColumn>();
    private static readonly ProjReportColumn[] ProjDefaultColumns =
    [
        ProjReportColumn.RowNumber,
        ProjReportColumn.Folder, ProjReportColumn.Project, ProjReportColumn.Code,
        ProjReportColumn.ProjStatus, ProjReportColumn.CalcCount,
        ProjReportColumn.StartDate, ProjReportColumn.EndDate,
        ProjReportColumn.TenderDeadline, ProjReportColumn.Responsible, ProjReportColumn.Inspector
    ];

    private enum IncomeReportColumn
    {
        Folder, Project, Calculation, Source, CalcStatus, Year, SubType, Amount, Probability, Forecast,
        ProjectCode, ProjectType, ProjStatus, Organisation, Developer,
        CalcCode, Version, CalcType, CalcRole, Responsible, Inspector,
        TenderDeadline, PublicationDate, DecisionDate,
        Contract, Compensation, ProcurementName, ProcurementProcedure, Archived,
        // Appended last to keep existing stored column-pref indices stable.
        RowNumber
    }

    private static readonly IncomeReportColumn[] IncomeAllColumns = Enum.GetValues<IncomeReportColumn>();
    private static readonly IncomeReportColumn[] IncomeDefaultColumns =
    [
        IncomeReportColumn.RowNumber,
        IncomeReportColumn.Folder, IncomeReportColumn.Project, IncomeReportColumn.Calculation,
        IncomeReportColumn.Source, IncomeReportColumn.CalcStatus, IncomeReportColumn.Year,
        IncomeReportColumn.SubType, IncomeReportColumn.Amount, IncomeReportColumn.Probability,
        IncomeReportColumn.Forecast
    ];

    // Intäktsöversikt: projektfält visas i projektsektionen (gruppraden), kalkylfält på
    // kalkylraderna. Kolumnvalet delas upp i dessa grupper. RowNumber är en visningskolumn.
    private static readonly IncomeReportColumn[] IncomeProjectColumns =
    [
        IncomeReportColumn.Folder, IncomeReportColumn.Project, IncomeReportColumn.ProjStatus,
        IncomeReportColumn.Organisation, IncomeReportColumn.Developer, IncomeReportColumn.ProjectCode,
        IncomeReportColumn.ProjectType, IncomeReportColumn.Contract, IncomeReportColumn.Compensation,
        IncomeReportColumn.ProcurementName, IncomeReportColumn.ProcurementProcedure,
        IncomeReportColumn.PublicationDate, IncomeReportColumn.DecisionDate, IncomeReportColumn.Archived
    ];

    private static readonly IncomeReportColumn[] IncomeCalcColumns =
    [
        IncomeReportColumn.Calculation, IncomeReportColumn.Source, IncomeReportColumn.CalcStatus,
        IncomeReportColumn.Year, IncomeReportColumn.SubType, IncomeReportColumn.Amount,
        IncomeReportColumn.Probability, IncomeReportColumn.Forecast,
        IncomeReportColumn.CalcCode, IncomeReportColumn.Version, IncomeReportColumn.CalcType,
        IncomeReportColumn.CalcRole, IncomeReportColumn.Responsible, IncomeReportColumn.Inspector,
        IncomeReportColumn.TenderDeadline
    ];

    private static readonly (string Label, IncomeReportColumn[] Cols)[] IncomeColumnGroups =
    [
        ("Projektuppgifter", IncomeProjectColumns),
        ("Kalkyluppgifter", IncomeCalcColumns),
        ("Övrigt", [IncomeReportColumn.RowNumber])
    ];

    private static bool IsIncomeProjectColumn(IncomeReportColumn c) => Array.IndexOf(IncomeProjectColumns, c) >= 0;

    private enum HitRateReportColumn
    {
        Project, ProjStatus, ProjectType, Folder, Responsible, Inspector, TenderDeadline,
        Code, Organisation, Developer, Contract, Compensation, ProcurementName, ProcurementProcedure,
        PublicationDate, DecisionDate, UpdatedAt, CreatedAt, Archived, TenderQA,
        // Appended last to keep existing stored column-pref indices stable.
        RowNumber
    }

    private static readonly HitRateReportColumn[] HitRateAllColumns = Enum.GetValues<HitRateReportColumn>();
    private static readonly HitRateReportColumn[] HitRateDefaultColumns =
    [
        HitRateReportColumn.RowNumber,
        HitRateReportColumn.Project, HitRateReportColumn.ProjStatus, HitRateReportColumn.ProjectType,
        HitRateReportColumn.Folder, HitRateReportColumn.Responsible, HitRateReportColumn.Inspector,
        HitRateReportColumn.TenderDeadline
    ];

    private enum BidReportColumn
    {
        Project, Folder, Bidder, OwnCompany, BidStatus, Amount, Deduction, Comparison,
        Deviation, Placement, Awarded, Rejected, RejectionReason,
        // Valbara
        ProjectCode, ProjectType, ProjStatus, Organisation, Developer, TenderDeadline,
        EvaluationModel, TotalPoints, Note, CreatedAt, UpdatedAt,
        // Appended last to keep existing stored column-pref indices stable.
        RowNumber
    }

    private static readonly BidReportColumn[] BidAllColumns = Enum.GetValues<BidReportColumn>();
    private static readonly BidReportColumn[] BidDefaultColumns =
    [
        BidReportColumn.RowNumber,
        BidReportColumn.Project, BidReportColumn.Folder, BidReportColumn.Bidder,
        BidReportColumn.Placement, BidReportColumn.Awarded, BidReportColumn.BidStatus,
        BidReportColumn.Amount, BidReportColumn.Deduction, BidReportColumn.Comparison,
        BidReportColumn.Deviation
    ];

    // Project/Folder become group headers and OwnCompany becomes a badge, so they
    // are not offered as toggleable columns; RowNumber stays selectable.
    private static readonly BidReportColumn[] BidPanelColumns =
        BidAllColumns.Where(c => c is not (BidReportColumn.Project or BidReportColumn.Folder or BidReportColumn.OwnCompany)).ToArray();

    // Logical render order for the grouped on-screen table rows (Placering &
    // Tilldelning sit right after Anbudsgivare). Project/Folder/OwnCompany/RowNumber
    // are handled structurally and excluded here.
    private static readonly BidReportColumn[] BidRowColumnOrder =
    [
        BidReportColumn.Bidder, BidReportColumn.Placement, BidReportColumn.Awarded, BidReportColumn.BidStatus,
        BidReportColumn.Amount, BidReportColumn.Deduction, BidReportColumn.Comparison, BidReportColumn.Deviation,
        BidReportColumn.ProjectCode, BidReportColumn.ProjectType, BidReportColumn.ProjStatus, BidReportColumn.Organisation,
        BidReportColumn.Developer, BidReportColumn.TenderDeadline, BidReportColumn.EvaluationModel, BidReportColumn.TotalPoints,
        BidReportColumn.Note, BidReportColumn.Rejected, BidReportColumn.RejectionReason, BidReportColumn.CreatedAt, BidReportColumn.UpdatedAt
    ];

    // Flat export keeps Project/Folder as ordinary columns (no grouping in Excel/PDF).
    private static readonly BidReportColumn[] BidExportColumnOrder =
        new[] { BidReportColumn.Project, BidReportColumn.Folder }.Concat(BidRowColumnOrder).ToArray();

    private const string MissingPersonValue = "__missing__";
    private const string CalcColumnsStorageKey = "ReportCalcColumnsV2";
    private const string ProjColumnsStorageKey = "ReportProjColumnsV2";
    private const string IncomeColumnsStorageKey = "RevenueOverviewColumnsV1";
    private const string HitRateColumnsStorageKey = "HitRateColumnsV1";
    private const string BidColumnsStorageKey = "BidComparisonColumnsV1";

    private sealed class IncomeTableRow
    {
        public IncomeTableRowKind Kind { get; init; }
        public string RowKey { get; init; } = "";
        public string FolderName { get; init; } = "";
        public string ProjectName { get; init; } = "";
        public string CalcName { get; init; } = "";
        public string SourceLabel { get; init; } = "";
        public string Status { get; init; } = "";
        public int Year { get; init; }
        public string SubTypeText { get; init; } = "";
        public decimal Q1 { get; init; }
        public decimal Q2 { get; init; }
        public decimal Q3 { get; init; }
        public decimal Q4 { get; init; }
        public decimal Amount { get; init; }
        public int Probability { get; init; }
        public decimal Forecast { get; init; }
        public bool IsFirstForProject { get; init; }
        public bool IsFirstForCalc { get; init; }
        public int CalcCount { get; init; }
        public string SummaryLabel { get; init; } = "";
        // Optional columns
        public string ProjectCode { get; init; } = "";
        public string ProjectType { get; init; } = "";
        public string ProjStatus { get; init; } = "";
        public string Organisation { get; init; } = "";
        public string Developer { get; init; } = "";
        public string CalcCode { get; init; } = "";
        public string CalcVersion { get; init; } = "";
        public string CalcTypeName { get; init; } = "";
        public string CalcRoleName { get; init; } = "";
        public string Responsible { get; init; } = "";
        public string Inspector { get; init; } = "";
        public string TenderDeadlineText { get; init; } = "";
        public string PublicationDateText { get; init; } = "";
        public string DecisionDateText { get; init; } = "";
        public string Contract { get; init; } = "";
        public string Compensation { get; init; } = "";
        public string ProcurementName { get; init; } = "";
        public string ProcurementProcedure { get; init; } = "";
        public string ArchivedText { get; init; } = "";
    }

    [Parameter] public FolderMVVM? FolderScope { get; set; }
    [Parameter] public ListProjectMVVM? ProjectScope { get; set; }
    [Parameter] public string InitialView { get; set; } = ReportView.Income;
    [Parameter] public string InitialStatus { get; set; } = string.Empty;
    [Parameter] public string InitialYear { get; set; } = string.Empty;
    [Parameter] public string InitialCalculationType { get; set; } = string.Empty;
    [Parameter] public string InitialCalculationRole { get; set; } = string.Empty;
    [Parameter] public string InitialResponsible { get; set; } = string.Empty;
    [Parameter] public string InitialInspector { get; set; } = string.Empty;
    [Parameter] public IReadOnlyList<Guid>? LockedProjectIds { get; set; }
    /// <summary>Exact calculation ids selected by the calling list (after that list's filters).
    /// When set, the Kalkyllista report uses precisely these calculations instead of re-filtering.</summary>
    [Parameter] public IReadOnlyList<int>? LockedCalculationIds { get; set; }
    /// <summary>Whether the calling calculation list had "Visa alla versioner" enabled.</summary>
    [Parameter] public bool? LockedShowAllVersions { get; set; }
    [Parameter] public string? SelectionSummaryLine { get; set; }
