    private string IncomeFilterSummary
    {
        get
        {
            var parts = new List<string>();
            if (!string.IsNullOrWhiteSpace(_selectedYear)) parts.Add($"År {_selectedYear}");
            if (_selectedQuarter > 0) parts.Add($"Q{_selectedQuarter}");
            if (!string.IsNullOrWhiteSpace(_selectedCalculationType)) parts.Add("Kalkyltyp");
            if (!string.IsNullOrWhiteSpace(_selectedCalculationRole)) parts.Add("Kalkylroll");
            if (_selectedStatuses.Count > 0) parts.Add("Kalkylstatus");
            if (_selectedResponsibles.Count > 0) parts.Add("Kalkylansvarig");
            if (_selectedInspectors.Count > 0) parts.Add("Granskare");
            if (_selectedArchiveMode != "active") parts.Add("Arkiverade");
            if (_selectedIncomeSource != "auto") parts.Add("Intäktskälla");
            if (!string.IsNullOrWhiteSpace(_selectedSubType)) parts.Add("Deltyp");
            return parts.Count switch
            {
                0 => "Standard",
                <= 2 => string.Join(" · ", parts),
                _ => $"{parts.Count} aktiva filter"
            };
        }
    }

