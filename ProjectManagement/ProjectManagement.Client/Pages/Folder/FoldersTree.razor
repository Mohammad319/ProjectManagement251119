                                        <span class="flex h-6 w-6 items-center justify-center rounded-md @(isQuarterSelected ? "bg-violet-200 text-violet-800 ring-1 ring-violet-300 dark:bg-violet-900/60 dark:text-violet-200 dark:ring-violet-700" : "bg-violet-100 text-violet-700 ring-1 ring-violet-200 dark:bg-violet-950/50 dark:text-violet-300 dark:ring-violet-800")">
                                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 5h16M4 10h16M4 15h16M4 20h16" />
                                            </svg>
                                        </span>
                                        <span class="truncate text-[12px] font-bold @(isQuarterSelected ? "text-violet-900 dark:text-violet-100" : "text-slate-700 dark:text-slate-100")"
                                              title="@($"{quarterGroup.Label} ({quarterGroup.Calculations.Count})")">
                                            @quarterGroup.Label
                                        </span>
                                    </div>

                                    @if (quarterExpanded)
                                    {
                                        @groupContent(quarterGroup)
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        @groupContent(group)
                    }
                }
            </div>
        }
    </div>
}
