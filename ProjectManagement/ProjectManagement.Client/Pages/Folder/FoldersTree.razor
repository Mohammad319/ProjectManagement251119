@using ProjectManagement.Client.Shared.MVVM.Calculation
@using ProjectManagement.Client.Shared.MVVM.Folder
@inherits AppComponentBase
@inject AuthenticationStateProvider AuthenticationStateProvider

@if (GroupingMode == ProjectTreeGroupingMode.FolderStructure)
{
<div id="folderTable" class="select-none space-y-1 text-sm" @oncontextmenu:preventDefault="true">
    @if (IsManualOrderMode)
    {
        <div class="sticky top-0 z-20 mb-1 flex items-center gap-1 rounded-lg border border-amber-200 bg-amber-50/95 p-1 shadow-sm backdrop-blur dark:border-amber-900/60 dark:bg-amber-950/70">
            <button type="button"
                    class="h-7 rounded-md bg-emerald-600 px-2 text-xs font-semibold text-white transition hover:bg-emerald-700 disabled:cursor-not-allowed disabled:opacity-50"
                    disabled="@(!HasManualOrderChanges)"
                    @onclick="SaveManualOrderAsync">
                @AppLoc["saveOrder"]
            </button>
            <button type="button"
                    class="h-7 rounded-md border border-slate-200 bg-white px-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
                    @onclick="CancelManualOrderAsync">
                @AppLoc["cancelOrder"]
            </button>
        </div>
    }

    @{
        var isWholeDeptSelectedFs = _selectedGroupKey == "hela-avdelningen";
    }
    <div class="sticky top-0 z-10 bg-slate-50 dark:bg-slate-950/60 flex items-center gap-1 px-0.5 py-0.5 mb-0.5">
        <div class="group flex flex-1 min-w-0 items-center gap-1.5 px-1.5 py-1 rounded-md cursor-pointer transition-all duration-150 active:scale-95 @TreeRowFocusClass @(isWholeDeptSelectedFs ? TreeSelectedRowClass : "bg-white dark:bg-slate-900/70 hover:bg-slate-100/80 dark:hover:bg-slate-800/70")"
             @onclick="SelectWholeDepartmentAsync"
             @oncontextmenu:preventDefault
             @oncontextmenu="ContextHelaAvdelning"
             role="button"
             tabindex="0">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-md @(isWholeDeptSelectedFs ? TreeIconSelectedClass : TreeIconIdleClass)">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M2 3h6v6H2zM10 3h6v6h-6zM2 12h6v6H2zM10 12h6v6h-6z" />
                </svg>
            </span>
            <span class="truncate text-[13px] font-semibold @(isWholeDeptSelectedFs ? "text-sky-900 dark:text-sky-100" : "text-slate-800 group-hover:text-slate-900 dark:text-slate-100 dark:group-hover:text-slate-100")">
                Hela avdelningen
            </span>
        </div>
        <button type="button"
                class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-500 shadow-sm transition hover:bg-slate-100 hover:text-slate-900 disabled:cursor-not-allowed disabled:opacity-40 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800"
                @onclick="CycleExpandAsync"
                title="@TreeExpandButtonTooltip"
                aria-label="@TreeExpandButtonTooltip"
                disabled="@IsReorderMode">
            @switch (_cycleStep)
            {
                case 0:
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
                    </svg>
                    break;
                case 1:
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 3l-7 7-7-7"/>
                    </svg>
                    break;
                case 2:
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 21l7-7 7 7"/>
                    </svg>
                    break;
                default:
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 15l7-7 7 7"/>
                    </svg>
                    break;
            }
        </button>
    </div>

    @{
        var sortedFolders = GetSortedFolders(UoWService.Folder.State.FoldersList).ToList();
    }

    @foreach (var folder in sortedFolders)
    {
        var isFolderSelected = Folder.State.FolderSelected?.Id == folder.Id;
        var isFolderArchived = !folder.IsVisible;

        var folderClasses = new List<string>
        {
            "group",
            "grid grid-cols-[1rem_1.5rem_1fr] items-center gap-1.5 px-1.5 py-1 rounded-md cursor-pointer",
            "transition-all duration-150",
            "active:scale-95",
            TreeRowFocusClass
        };

        if (isFolderSelected)
            folderClasses.Add(TreeSelectedRowClass);
        else if (folder.ShowProjects)
            folderClasses.Add(TreeExpandedRowClass);
        else
            folderClasses.Add(TreeNormalRowClass);

        if (isFolderArchived)
            folderClasses.Add("text-slate-500 grayscale dark:text-slate-400");

        if (folder.IsDragOver)
            folderClasses.Add("ring-1 ring-sky-500 bg-sky-50 dark:bg-sky-950/40");

        <div @key="folder.Id"
             @oncontextmenu:preventDefault
             @oncontextmenu="() => Context(folder)"
             @ondrop="async _ => await HandleDrop(folder)"
             @ondragenter="() => OnDragEnterFolder(folder)"
             @ondragleave="() => OnDragLeaveFolder(folder)"
             @ondragover:preventDefault
             @ondragstart="() => CalcDraging = folder"
             draggable="@(SortMode != ProjectTreeSortMode.Manual)"
             @onclick="async () => await SeFolder(folder)"
             role="button"
             tabindex="0"
             title="@GetFolderTitle(folder)"
             class="@string.Join(" ", folderClasses)">

            <!-- Expand folder – chevron only when the folder actually has children -->
            @if (!FolderHasChildren(folder))
            {
                <span class="h-4 w-4 shrink-0"></span>
            }
            else if (IsNodeLoading(GetFolderKey(folder)))
            {
                <span class="flex h-4 w-4 shrink-0 items-center justify-center">
                    <svg class="h-3.5 w-3.5 animate-spin text-sky-500" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
                    </svg>
                </span>
            }
            else
            {
                <button @onclick:stopPropagation="true"
                        @onclick="async () => await CollapseFolder(folder)"
                        class="flex h-4 w-4 shrink-0 items-center justify-center rounded text-slate-400 transition-colors duration-150 group-hover:bg-slate-100 group-hover:text-slate-600 dark:text-slate-500 dark:group-hover:bg-slate-800/60 dark:group-hover:text-slate-300"
                        title="@(folder.ShowProjects ? "Fäll ihop" : "Expandera")">
                    <svg xmlns="http://www.w3.org/2000/svg"
                         class="@($"h-3.5 w-3.5 transform transition-transform duration-200 {(folder.ShowProjects ? "rotate-90" : "rotate-0")}")"
                         fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                </button>
            }

            <!-- Folder / ort -->
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-md @(isFolderSelected ? TreeIconSelectedClass : isFolderArchived ? TreeIconArchivedClass : TreeIconIdleClass)">
                @if (folder.ShowProjects)
                {
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M20 6H12l-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H4V8h16v10z"/>
                    </svg>
                }
                else
                {
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M10 4H4c-1.11 0-2 .89-2 2v12c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2h-8l-2-2z"/>
                    </svg>
                }
            </span>

            <span class="min-w-0 flex items-center gap-1.5">
                @if (IsManualOrderMode)
                {
                    <span class="flex shrink-0 items-center gap-0.5">
                        <button type="button" class="@ManualOrderButtonClass" disabled="@(!CanMoveUp(sortedFolders, folder))" title="@AppLoc["moveUp"]" @onclick:stopPropagation="true" @onclick="() => MoveFolder(folder, -1)">↑</button>
                        <button type="button" class="@ManualOrderButtonClass" disabled="@(!CanMoveDown(sortedFolders, folder))" title="@AppLoc["moveDown"]" @onclick:stopPropagation="true" @onclick="() => MoveFolder(folder, 1)">↓</button>
                    </span>
                }
                <span class="truncate text-[13px] font-semibold leading-5 @(isFolderArchived ? "text-slate-500 dark:text-slate-400" : "text-slate-800 group-hover:text-slate-900 dark:text-slate-100 dark:group-hover:text-slate-100") @(isFolderSelected ? "text-sky-900 dark:text-sky-100" : "")">
                    @folder.Name
                </span>
                <span class="shrink-0 text-[11px] font-medium text-slate-400 dark:text-slate-500" aria-label="@GetFolderProjectCountLabel(folder)">
                    (@GetFolderProjectCount(folder))
                </span>
            </span>

        </div>

        <!-- Projects -->
        @if (folder.ShowProjects && folder.Projects is not null)
        {
            <div class="ml-4 space-y-1 pl-2">
                @{
                    var sortedProjects = GetSortedProjects(folder.Projects).ToList();
                    var projectsExpanded = IsProjectsExpanded(folder) || IsSelectedProjectHidden(sortedProjects);
                    var visibleProjects = projectsExpanded ? sortedProjects : sortedProjects.Take(ProjectPreviewLimit).ToList();
                }

                @foreach (var project in visibleProjects)
                {
                    var isProjectSelected = Folder.State.ProjectSelected?.Id == project.Id;
                    var isProjectArchived = project.IsArchived;
                    var isProjectOpen = project.ShowCalculations;

                    var projectClasses = new List<string>
                    {
                        "group relative",
                        "grid grid-cols-[1rem_1.5rem_1fr] items-center gap-1.5 pl-2.5 pr-1.5 py-1 rounded-md cursor-pointer",
                        "transition-all duration-150",
                        "active:scale-95",
                        TreeRowFocusClass
                    };

                    if (isProjectSelected)
                        projectClasses.Add(TreeSelectedRowClass);
                    else if (isProjectOpen)
                        projectClasses.Add(TreeExpandedRowClass);
                    else
                        projectClasses.Add(TreeNormalRowClass);

                    if (isProjectArchived)
                        projectClasses.Add("text-slate-500 grayscale dark:text-slate-400");

                    if (project.IsDragOver)
                        projectClasses.Add("ring-1 ring-sky-500 bg-sky-50 dark:bg-sky-950/40");

                    <div @key="project.Id"
                         @oncontextmenu:preventDefault
                         @oncontextmenu="async () => await ContextProject(folder, project)"
                         @ondrop="async _ => await HandleDrop(project)"
                         @ondragleave="() => project.IsDragOver = false"
                         @ondragover="() => project.IsDragOver = CalcDraging is ListProjectMVVM"
                         @ondragstart="() => CalcDraging = project"
                         draggable="@(SortMode != ProjectTreeSortMode.Manual)"
                         @onclick="async () => await SetProject(folder, project)"
                         role="button"
                         tabindex="0"
                         title="@GetProjectTitle(project)"
                         class="@string.Join(" ", projectClasses)">

                        <!-- Project status (alternative 3: thin colored left line) -->
                        <span class="@ProjectStatusLineClass"
                              style="background-color:@GetProjectStatusColor(project)"
                              title="@GetProjectStatusTitle(project)"></span>

                        <!-- Expand project – chevron only when the project actually has calculations -->
                        @if (!ProjectHasChildren(project))
                        {
                            <span class="h-4 w-4 shrink-0"></span>
                        }
                        else if (IsNodeLoading(GetProjectKey(project)))
                        {
                            <span class="flex h-4 w-4 shrink-0 items-center justify-center">
                                <svg class="h-3.5 w-3.5 animate-spin text-sky-500" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
                                </svg>
                            </span>
                        }
                        else
                        {
                            <button @onclick:stopPropagation="true"
                                    @onclick="async () => await CollapseProject(project)"
                                    class="flex h-4 w-4 shrink-0 items-center justify-center rounded text-slate-400 transition-colors duration-150 group-hover:bg-sky-100 group-hover:text-sky-700 dark:text-slate-500 dark:group-hover:bg-sky-950/60 dark:group-hover:text-sky-300"
                                    title="@(project.ShowCalculations ? "Fäll ihop" : "Expandera")">
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     class="h-3.5 w-3.5 transform transition-transform duration-200 @( project.ShowCalculations ? "rotate-90" : "rotate-0")"
                                     fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                </svg>
                            </button>
                        }

                        <!-- Project Icon -->
                        <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-md @(isProjectSelected ? TreeIconSelectedClass : isProjectArchived ? TreeIconArchivedClass : TreeProjectIconIdleClass)">
                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4.5 5.5h15v13h-15z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 9h8M8 13h3M14 13h2M8 16h8" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M6.5 3.5v4M17.5 16.5v4" />
                            </svg>
                        </span>

                        <span class="min-w-0 flex items-center gap-1.5">
                            @if (IsManualOrderMode)
                            {
                                <span class="flex shrink-0 items-center gap-0.5">
                                    <button type="button" class="@ManualOrderButtonClass" disabled="@(!CanMoveUp(sortedProjects, project))" title="@AppLoc["moveUp"]" @onclick:stopPropagation="true" @onclick="() => MoveProject(folder.Projects, project, -1)">↑</button>
                                    <button type="button" class="@ManualOrderButtonClass" disabled="@(!CanMoveDown(sortedProjects, project))" title="@AppLoc["moveDown"]" @onclick:stopPropagation="true" @onclick="() => MoveProject(folder.Projects, project, 1)">↓</button>
                                </span>
                            }
                            <span class="truncate text-[13px] leading-5 @(isProjectArchived ? "text-slate-500 dark:text-slate-400" : "text-slate-700 group-hover:text-slate-900 dark:text-slate-200 dark:group-hover:text-slate-100") @(isProjectSelected ? "font-semibold text-sky-900 dark:text-sky-100" : isProjectOpen ? "font-semibold text-slate-800 dark:text-slate-100" : "font-medium")">
                                @project.Name
                            </span>
                            <span class="shrink-0 text-[11px] font-medium text-slate-400 dark:text-slate-500" aria-label="@GetProjectCalculationCountLabel(project)">
                                (@GetProjectCalculationCount(project))
                            </span>
                        </span>

                    </div>

                    <!-- Calculations -->
                    <div class="ml-4 space-y-1 pl-2
                                   overflow-hidden transition-all duration-200 ease-in-out
                                   @(project.ShowCalculations ? " max-h-[5000px] opacity-100" : "max-h-0 opacity-0")">
                        @{
                            var sortedCalculations = GetSortedCalculations(project.Calculations).ToList();
                            var calcsExpanded = IsCalcsExpanded(project) || IsSelectedCalculationHidden(sortedCalculations);
                            var visibleCalculations = calcsExpanded ? sortedCalculations : sortedCalculations.Take(CalculationPreviewLimit).ToList();
                        }

                        @foreach (var cal in visibleCalculations)
                        {
                            var calcSelected = Calc?.Id == cal.Id;
                            var calcClasses = new List<string>
                            {
                                "group grid grid-cols-[1.5rem_minmax(0,1fr)] items-center gap-1.5 px-1.5 py-1 rounded-md cursor-pointer transition-all duration-150 " + TreeRowFocusClass,
                                "bg-slate-50/80 dark:bg-slate-900/60",
                                "hover:bg-slate-100/80 dark:hover:bg-slate-800/70",
                                "active:scale-95"
                            };

                            if (calcSelected)
                                calcClasses.Add(GetCalculationSelectedClass(cal));

                            <div @key="cal.Id"
                                 @oncontextmenu:preventDefault
                                 @oncontextmenu="async () => await ContextCalc(folder, project, cal)"
                                 @onclick="async () => await NewCalculations(folder, project, cal)"
                                 role="button"
                                 tabindex="0"
                                 class="@string.Join(" ", calcClasses)">
                                <span class="flex h-5 w-5 shrink-0 items-center justify-center"
                                      title="@($"{CalcResource.calculation}{(string.IsNullOrWhiteSpace(cal.Status) ? string.Empty : $": {cal.Status}")}")">
                                    <span class="@CalculationIndicatorBaseClass" style="background-color:@GetCalculationStatusColor(cal)" title="@GetCalculationStatusTitle(cal)"></span>
                                </span>

                                <span class="min-w-0 flex items-center gap-1.5">
                                    @if (IsManualOrderMode)
                                    {
                                        <span class="flex shrink-0 items-center gap-0.5">
                                            <button type="button" class="@ManualOrderButtonClass" disabled="@(!CanMoveUp(sortedCalculations, cal))" title="@AppLoc["moveUp"]" @onclick:stopPropagation="true" @onclick="() => MoveCalculation(project.Calculations, cal, -1)">↑</button>
                                            <button type="button" class="@ManualOrderButtonClass" disabled="@(!CanMoveDown(sortedCalculations, cal))" title="@AppLoc["moveDown"]" @onclick:stopPropagation="true" @onclick="() => MoveCalculation(project.Calculations, cal, 1)">↓</button>
                                        </span>
                                    }
                                    <span title="@cal.Name"
                                          class="truncate text-[13px] font-normal leading-5 @GetCalculationTextClass(cal, calcSelected)">
                                        @cal.Name
                                    </span>
                                </span>
                            </div>
                        }

                        @* Visa alla kalkyler – endast när projektet har fler kalkyler än gränsen *@
                        @if (!calcsExpanded && sortedCalculations.Count > CalculationPreviewLimit)
                        {
                            <button type="button"
                                    class="@ShowMoreLinkClass"
                                    @onclick:stopPropagation="true"
                                    @onclick="() => ShowAllCalculations(project)">
                                @AppLoc["showAllCalculationsCount", sortedCalculations.Count]
                            </button>
                        }
                    </div>
                }

                @* Visa alla projekt – endast när mappen har fler projekt än gränsen *@
                @if (!projectsExpanded && sortedProjects.Count > ProjectPreviewLimit)
                {
                    <button type="button"
                            class="@ShowMoreLinkClass"
                            @onclick:stopPropagation="true"
                            @onclick="() => ShowAllProjects(folder)">
                        @AppLoc["showAllProjectsCount", sortedProjects.Count]
                    </button>
                }
            </div>
        }
    }

    @* Empty state – inga mappar finns i avdelningen *@
    @if (sortedFolders.Count == 0 && !IsManualOrderMode)
    {
        <div class="rounded-xl border border-dashed border-slate-300 bg-white px-4 py-8 text-center dark:border-slate-700 dark:bg-slate-900">
            <p class="text-sm font-semibold text-slate-700 dark:text-slate-200">Inga mappar hittades</p>
            <p class="mt-1 text-xs leading-5 text-slate-500 dark:text-slate-400">Skapa en ny mapp för att börja arbeta.</p>
            @if (OnCreateNewFolder.HasDelegate)
            {
                <button type="button"
                        class="mt-4 inline-flex h-8 items-center gap-1.5 rounded-lg border border-emerald-200 bg-emerald-50 px-3 text-xs font-semibold text-emerald-700 shadow-sm transition hover:bg-emerald-100 hover:text-emerald-900 dark:border-emerald-900/60 dark:bg-emerald-950/30 dark:text-emerald-300 dark:hover:bg-emerald-950/50"
                        @onclick="async () => await OnCreateNewFolder.InvokeAsync()">
                    <span aria-hidden="true">+</span>
                    <span>Ny mapp</span>
                </button>
            }
        </div>
    }
</div>
}
else if (GroupingMode == ProjectTreeGroupingMode.Projects)
{
    var allProjectEntries = GetAllProjectsForProjectView().ToList();
    var isAllProjectsSelected = _selectedGroupKey == "hela-avdelningen";

    <div id="folderTable" class="select-none space-y-1 text-sm" @oncontextmenu:preventDefault="true">
        <div class="sticky top-0 z-10 bg-slate-50 dark:bg-slate-950/60 flex items-center gap-1 px-0.5 py-0.5 mb-0.5">
            <div class="group flex flex-1 min-w-0 items-center gap-1.5 px-1.5 py-1 cursor-pointer rounded-md transition-all duration-150 @TreeRowFocusClass @(isAllProjectsSelected ? TreeSelectedRowClass : "bg-white dark:bg-slate-900/70 hover:bg-slate-100/80 dark:hover:bg-slate-800/70")"
                 @onclick="async () => await SelectWholeDepartmentAsync()"
                 role="button"
                 tabindex="0">
                <span class="flex h-6 w-6 items-center justify-center rounded-md @(isAllProjectsSelected ? TreeIconSelectedClass : TreeIconIdleClass)">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M2 3h6v6H2zM10 3h6v6h-6zM2 12h6v6H2zM10 12h6v6h-6z" />
                    </svg>
                </span>
                <span class="truncate text-[13px] font-semibold @(isAllProjectsSelected ? "text-sky-900 dark:text-sky-100" : "text-slate-800 dark:text-slate-100")">
                    Hela avdelningen
                </span>
            </div>
        </div>

        <div class="ml-1 space-y-1 pl-2">
                @foreach (var (projFolder, project) in allProjectEntries)
                {
                    var isProjSelected = Folder.State.ProjectSelected?.Id == project.Id;
                    var isProjArchived = project.IsArchived;
                    var projViewClasses = new List<string>
                    {
                        "group grid grid-cols-[1rem_1.5rem_1fr] items-center gap-1.5 px-1.5 py-1 rounded-md cursor-pointer transition-all duration-150 " + TreeRowFocusClass,
                        "bg-slate-50 dark:bg-slate-900/70",
                        "hover:bg-slate-100/80 dark:hover:bg-slate-800/70",
                        "active:scale-95",
                        TreeRowFocusClass
                    };
                    if (isProjArchived)
                        projViewClasses.Add("border border-slate-200 bg-slate-100/80 text-slate-500 grayscale dark:border-slate-800 dark:bg-slate-900/50 dark:text-slate-400");
                    if (isProjSelected)
                        projViewClasses.Add(TreeSelectedRowClass);

                    <div @key="project.Id"
                         @oncontextmenu:preventDefault
                         @oncontextmenu="async () => await ContextProject(projFolder, project)"
                         @onclick="async () => await SelectProject(projFolder, project)"
                         role="button"
                         tabindex="0"
                         class="@string.Join(" ", projViewClasses)">
                        <span class="h-4 w-4 shrink-0"></span>
                        <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-md @(isProjArchived ? TreeIconArchivedClass : isProjSelected ? TreeIconSelectedClass : TreeProjectIconIdleClass)"
                              title="@CalcResource.project">
                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4.5 5.5h15v13h-15z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 9h8M8 13h3M14 13h2M8 16h8" />
