@using ProjectManagement.Client.Shared.Model.Project
@using ProjectManagement.Shared.DTO.Folder
@inherits AppComponentBase

@inject ProjectManagement.Client.Shared.Repositories.Folder.IFolderRepository _folderRepo

<EditForm id="myForm"
          class="space-y-4 p-3 text-slate-800 dark:text-slate-100"
          Model="@PostFolder"
          OnValidSubmit="async()=> await HandleSubmitAsync()">
    <DataAnnotationsValidator />

    <MhdCard Elevated="true" Compact="true" Class="mb-1">
        <div class="rounded border border-slate-200 bg-slate-50 px-3 py-2 dark:border-slate-700 dark:bg-slate-800/70">
            <h6 class="text-sm font-semibold text-slate-900 dark:text-slate-100">@ResourceLoc.folder</h6>
            <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">@CalcResource.name, @ResourceApp.isVisible, Color</p>
        </div>
    </MhdCard>

    <MhdCard Elevated="true" Compact="true" Class="mb-1">
    <div class="grid grid-cols-1 items-end gap-3 lg:grid-cols-[minmax(0,1fr)_auto_140px]">
        <div class="flex min-w-0 flex-col gap-1">
            <label for="folderName" class="text-sm font-medium text-slate-700 dark:text-slate-200">
                @CalcResource.name:
            </label>
            <InputText id="folderName"
                       class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white"
                       @bind-Value="PostFolder.Name" />
            <ValidationMessage For="@(() => PostFolder.Name)" />
        </div>

        <div class="flex items-center gap-2 rounded border border-slate-200 bg-slate-50 px-2 py-1 whitespace-nowrap dark:border-slate-700 dark:bg-slate-800/50">
            <InputCheckbox class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 dark:border-slate-600 dark:bg-slate-900"
                           @bind-Value="@PostFolder.IsVisible" />
            <label class="text-sm font-medium text-slate-700 dark:text-slate-200">
                @ResourceApp.isVisible
            </label>
        </div>

        <div class="flex flex-col gap-1">
            <label class="text-sm font-medium text-slate-700 dark:text-slate-200">Color</label>
            <div class="flex items-center gap-2">
                <InputText type="color"
                           class="h-9 w-full cursor-pointer rounded border border-slate-300 bg-white p-1 dark:border-slate-700 dark:bg-slate-900"
                           @bind-value="PostFolder.Color" />
                <span class="h-8 w-8 rounded-md border border-slate-300 shadow-sm dark:border-slate-600"
                      style="background-color:@PostFolder.Color"></span>
            </div>
            <ValidationMessage For="@(() => PostFolder.Color)" />
        </div>
    </div>
    </MhdCard>
</EditForm>

<div class="flex items-center justify-end gap-2 border-t border-slate-200 px-3 py-2 dark:border-slate-700">
    <button type="submit"
            class="inline-flex items-center justify-center rounded-lg border border-emerald-600 px-4 py-2 text-sm font-medium text-emerald-700 transition hover:bg-emerald-600 hover:text-white disabled:cursor-not-allowed disabled:opacity-60 dark:border-emerald-500 dark:text-emerald-400 dark:hover:bg-emerald-500 dark:hover:text-slate-900"
            form="myForm"
            disabled="@btnSubmitDisabled">
        @ResourceApp.save
    </button>

    <button type="button"
            class="inline-flex items-center justify-center rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-100 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-800"
            @onclick="Modal.Close">
        @ResourceApp.cancel
    </button>
</div>

@code {
    [Parameter] public EventCallback<FolderModel> OnClickCallback { get; set; }
    bool btnSubmitDisabled;
    [Parameter] public FolderModel FolderForm { get; set; } = default!;
    PostFolderDTO PostFolder = new PostFolderDTO();

    protected override void OnInitialized()
    {
        PostFolder.Color = FolderForm.Color;
        PostFolder.Name = FolderForm.Name;
        PostFolder.IsVisible = FolderForm.IsVisible;
    }

    private async Task HandleSubmitAsync()
    {
        btnSubmitDisabled = true;

        if (FolderForm.Id != Guid.Empty)
        {
            if (await _folderRepo.UpdateAsync(FolderForm.Id, PostFolder))
            {
                FolderForm.Color = PostFolder.Color;
                FolderForm.Name = PostFolder.Name;
                FolderForm.IsVisible = PostFolder.IsVisible;
                await OnClickCallback.InvokeAsync(FolderForm);
                MHD.Notifications(ToastType.Update, true);
            }
            else
            {
                MHD.Notifications(ToastType.Update);
            }
        }
        else
        {
            FolderForm.Id = await _folderRepo.CreateAsync(PostFolder);
            if (FolderForm.Id != Guid.Empty)
            {
                FolderForm.Color = PostFolder.Color;
                FolderForm.Name = PostFolder.Name;
                FolderForm.IsVisible = PostFolder.IsVisible;
                await OnClickCallback.InvokeAsync(FolderForm);
            }

            MHD.Notifications(ToastType.Add, FolderForm.Id != Guid.Empty);
        }

        await OnClickCallback.InvokeAsync(null);
    }
}
