@using ProjectManagement.Client.Shared.Model.Project
@using ProjectManagement.Shared.DTO.Folder
@inherits AppComponentBase
@inject IJSRuntime JS
@inject ProjectManagement.Client.Shared.Repositories.Folder.IFolderRepository _folderRepo
@inject ProjectManagement.Client.Shared.Repositories.Project.IProjectRepository _projectRepo
<EditForm id="@DialogFormId"
          class="w-full max-w-3xl space-y-4 p-3 text-slate-800 dark:text-slate-100"
          Model="@PostFolder"
          OnValidSubmit="async()=> await HandleSubmitAsync()">
    <DataAnnotationsValidator />
    <FormValidationSummary />

    <div class="grid grid-cols-2 gap-3 lg:grid-cols-12">
        <div class="col-span-2 flex min-w-0 flex-col gap-1.5 lg:col-span-8">
            <label for="folderName" class="text-sm font-medium text-slate-700 dark:text-slate-200">
                @CalcResource.name:
            </label>
            <InputText id="folderName"
                       class="h-10 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
                       @bind-Value="PostFolder.Name" />
        </div>

        <div class="col-span-2 flex min-w-0 flex-col gap-1.5 lg:col-span-4">
            <label aria-hidden="true" class="select-none text-sm font-medium text-transparent">
                @AppLoc["active"]
            </label>
            <label for="folderVisible"
                   class="flex h-10 w-full items-center gap-2 rounded-lg border border-slate-200 bg-slate-50 px-3 dark:border-slate-700 dark:bg-slate-800/50">
                <InputCheckbox id="folderVisible"
                               class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 dark:border-slate-600 dark:bg-slate-900"
                               @bind-Value="@PostFolder.IsVisible" />
                <span class="truncate text-sm font-medium text-slate-700 dark:text-slate-200">
                    @(PostFolder.IsVisible ? AppLoc["active"] : AppLoc["archived"])
                </span>
            </label>
        </div>

    </div>
</EditForm>

@code {
    public const string DialogFormId = "folderForm";
    [Parameter] public EventCallback<FolderModel> OnClickCallback { get; set; }
    bool btnSubmitDisabled;
    [Parameter] public FolderModel FolderForm { get; set; } = default!;
    [Parameter] public int? TargetDepartmentId { get; set; }
    PostFolderDTO PostFolder = new PostFolderDTO();

    protected override void OnInitialized()
    {
        PostFolder.Color = FolderForm.Color;
        PostFolder.Name = FolderForm.Name;
        PostFolder.IsVisible = FolderForm.IsVisible;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("eval", "setTimeout(()=>{var el=document.getElementById('folderName');if(el){el.focus();el.select();}},50)");
    }

    private async Task HandleSubmitAsync()
    {
        if (ShouldConfirmArchiveFolder() && await HasActiveProjectsAsync())
        {
            MHD.MessageYesNo(
                AppLoc["archiveFolderTitle"],
                AppLoc["archiveFolderConfirm"],
                BlazorMHD.UI.Core.DesignSystem.MhdState.Warning,
                EventCallback.Factory.Create(this, SubmitAsync));
            return;
        }

        await SubmitAsync();
    }

    private bool ShouldConfirmArchiveFolder() =>
        FolderForm.Id != Guid.Empty &&
        FolderForm.IsVisible &&
        !PostFolder.IsVisible;

    private async Task<bool> HasActiveProjectsAsync()
    {
        var projects = await _projectRepo.GetByFolderIdAsync(FolderForm.Id, includeArchived: false);
        return projects.Any();
    }

    private async Task SubmitAsync()
    {
        if (btnSubmitDisabled)
            return;

        btnSubmitDisabled = true;
        var shouldReenable = true;

        if (FolderForm.Id != Guid.Empty)
        {
            if (await _folderRepo.UpdateAsync(FolderForm.Id, PostFolder))
            {
                FolderForm.Color = PostFolder.Color;
                FolderForm.Name = PostFolder.Name;
                FolderForm.IsVisible = PostFolder.IsVisible;
                await OnClickCallback.InvokeAsync(FolderForm);
                MHD.Notifications(ToastType.Update, true);
                shouldReenable = false;
            }
            else
            {
                MHD.Notifications(ToastType.Update);
            }
        }
        else
        {
            FolderForm.Id = TargetDepartmentId.HasValue
                ? await _folderRepo.CreateAsync(PostFolder, TargetDepartmentId.Value)
                : await _folderRepo.CreateAsync(PostFolder);

            if (FolderForm.Id != Guid.Empty)
            {
                FolderForm.Color = PostFolder.Color;
                FolderForm.Name = PostFolder.Name;
                FolderForm.IsVisible = PostFolder.IsVisible;
                await OnClickCallback.InvokeAsync(FolderForm);
                shouldReenable = false;
            }

            MHD.Notifications(ToastType.Add, FolderForm.Id != Guid.Empty);
        }
        if (shouldReenable)
            btnSubmitDisabled = false;
    }
}
