@using BlazorMHD.UI.Components.Feedback.Splitter
@using BlazorMHD.UI.Components.Data.DropdownPanel
@using BlazorMHD.UI.Core.DesignSystem
@using ContextMenuMHD
@using ProjectManagement.Client.Helper
@using ProjectManagement.Client.Pages.Project.ProjectPages
@using ProjectManagement.Client.Shared.SharedComponent
@attribute [Authorize]
@inherits AppComponentBase
@implements IDisposable
@inject AuthenticationStateProvider AuthenticationStateProvider

<HorizontalSplitter Class="h-full w-full border border-zinc-200 dark:border-zinc-800 rounded-2xl"
                        InitialPaneWidth="200"
                        MinLeftWidth="25"
                        MinRightWidth="260"
                        SplitterThickness="6"
                        LiveResize="true"
                        CollapsedLeftWidth="36"
                        StorageKey="folders-layout-horizontal-splitter"
                        ShowCollapseButton="true"
                        IsLeftCollapsed="@(!SideBarVisible)"
                        CollapseButtonTitle="@AppLoc["hidePanelTree"]"
                        ExpandButtonTitle="@AppLoc["showPanelTree"]"
                        OnCollapseLeft="async () => await SetSideBarVisible(false)"
                        OnExpandLeft="async () => await SetSideBarVisible(true)">

        <LeftContent>

            <div class="flex h-full flex-col border-r border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-950/60" @oncontextmenu:preventDefault="true">

                <div class="border-b border-slate-200 px-1.5 py-1.5 dark:border-slate-800">
                    @if (HasDepartmentAccess)
                    {
                        <div class="flex items-center gap-1.5">

                            @* Department dropdown *@
                            <select class="flex-1 min-w-0 rounded-lg border border-slate-300 bg-white px-2 py-1.5 text-sm font-medium text-slate-800 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 disabled:cursor-default disabled:bg-slate-100 disabled:text-slate-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:disabled:bg-slate-900/60 dark:disabled:text-slate-400"
                                    aria-label="@ResourceApp.department"
                                    title="@ResourceApp.department"
                                    value="@SelectedDepartmentValue"
                                    disabled="@(Folder.State.Departments.Count == 1)"
                                    @onchange="OnDepartmentChanged">
                                @if (!SelectedDepartmentId.HasValue)
                                {
                                    <option value="" disabled>@AppLoc["selectDepartment"]</option>
                                }
                                @foreach (var department in Folder.State.Departments)
                                {
                                    <option value="@department.Id">@department.Name</option>
                                }
                            </select>

                            @* Sök (ikon-only) *@
                            <button type="button"
                                    class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-500 shadow-sm transition hover:bg-slate-100 hover:text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800"
                                    @onclick="ModalSeachForm"
                                    title="Sök"
                                    aria-label="Sök">
                                <span aria-hidden="true">@((MarkupString)Icons.Search)</span>
                            </button>

                            @* Ordna (☰) – Träd och sortering *@
                            <div title="Ordna träd">
                                <MhdDropdownPanel @ref="_filterPanel"
                                                  Text="☰"
                                                  BadgeCount="@ActiveTreeFilterCount"
                                                  BadgeClass="bg-blue-500 text-white dark:bg-blue-600"
                                                  Size="MhdSize.Sm"
                                                  PanelWidth="w-72"
                                                  PanelWidthPx="288">
                                    <div class="space-y-2.5">

                                        @* Panel header *@
                                        <div class="flex items-center justify-between pb-1 border-b border-slate-200 dark:border-slate-700">
                                            <span class="text-[11px] font-semibold text-slate-500 dark:text-slate-400">Träd och sortering</span>
                                            <button type="button"
                                                    class="flex h-5 w-5 items-center justify-center rounded text-slate-400 hover:bg-slate-100 hover:text-slate-600 dark:text-slate-500 dark:hover:bg-slate-800 dark:hover:text-slate-300"
                                                    title="Stäng"
                                                    @onclick="() => _filterPanel?.ClosePanel()">
                                                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                                                </svg>
                                            </button>
                                        </div>

                                        @* Trädvy *@
                                        <div>
                                            <label class="mb-1 block text-[11px] font-semibold text-slate-500 dark:text-slate-400">
                                                Trädvy
                                            </label>
                                            <select class="w-full rounded-lg border border-slate-300 bg-white px-2 py-1.5 text-xs font-medium text-slate-800 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 disabled:cursor-default disabled:bg-slate-100 disabled:text-slate-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100 dark:disabled:bg-slate-900/60 dark:disabled:text-slate-400"
                                                    value="@TreeGroupingMode"
                                                    disabled="@(!SelectedDepartmentId.HasValue || _isReorderMode)"
                                                    @onchange="OnTreeGroupingModeChanged">
                                                <option value="@ProjectTreeGroupingMode.FolderStructure">Mappstruktur</option>
                                                <option value="@ProjectTreeGroupingMode.Projects">Projekt</option>
                                            </select>
                                        </div>

                                        @* Sortera efter *@
                                        <div>
                                            <label class="mb-1 block text-[11px] font-semibold text-slate-500 dark:text-slate-400"
                                                   title="@AppLoc["sortTooltip"]">
                                                @AppLoc["sort"]
                                            </label>
                                            <select class="w-full rounded-lg border border-slate-300 bg-white px-2 py-1.5 text-xs font-medium text-slate-800 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 disabled:cursor-default disabled:bg-slate-100 disabled:text-slate-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100 dark:disabled:bg-slate-900/60 dark:disabled:text-slate-400"
                                                    value="@TreeSortMode"
                                                    disabled="@(!SelectedDepartmentId.HasValue || _isReorderMode)"
                                                    @onchange="OnTreeSortModeChanged">
                                                @if (TreeGroupingMode == ProjectTreeGroupingMode.FolderStructure)
                                                {
                                                    <option value="@ProjectTreeSortMode.Manual">Manuell ordning</option>
                                                }
                                                <option value="@ProjectTreeSortMode.NameAscending">Namn A–Ö</option>
                                                <option value="@ProjectTreeSortMode.NameDescending">Namn Ö–A</option>
                                                <option value="@ProjectTreeSortMode.CreatedNewest">Skapad nyast först</option>
                                                <option value="@ProjectTreeSortMode.CreatedOldest">Skapad äldst först</option>
                                                <option value="@ProjectTreeSortMode.ModifiedNewest">Senast ändrad först</option>
                                                <option value="@ProjectTreeSortMode.LastOpenedNewest">Senast öppnad först</option>
                                            </select>

                                            @* Ändra ordning – visas vid Manuell ordning + Mappstruktur *@
                                            @if (TreeGroupingMode == ProjectTreeGroupingMode.FolderStructure &&
                                                 TreeSortMode == ProjectTreeSortMode.Manual &&
                                                 SelectedDepartmentId.HasValue)
                                            {
                                                <button type="button"
                                                        class="mt-1.5 inline-flex h-7 w-full items-center justify-center gap-1.5 rounded-lg border border-slate-300 bg-white px-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
                                                        title="Flytta mappar, projekt och kalkyler upp eller ner"
                                                        disabled="@_isReorderMode"
                                                        @onclick="StartReorderModeAsync">
                                                    <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4M17 8v12m0 0l4-4m-4 4l-4-4" />
                                                    </svg>
                                                    Ändra ordning
                                                </button>
                                            }
                                        </div>

                                        @* Visa arkiverade *@
                                        @if (SelectedDepartmentId.HasValue)
                                        {
                                            <label class="flex items-center gap-2 rounded-lg px-1 py-1 text-xs font-medium text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800">
                                                <input type="checkbox"
                                                       class="h-4 w-4 rounded border-slate-300 text-emerald-600 focus:ring-emerald-500 dark:border-slate-600 dark:bg-slate-950"
                                                       checked="@UoWService.Folder.ShowArchived"
                                                       @onchange="async _ => await ToggleArchivedAsync()" />
                                                <span>@AppLoc["showArchived"]</span>
                                            </label>
                                        }

                                        @* Återställ *@
                                        <button type="button"
                                                class="inline-flex h-8 w-full items-center justify-center rounded-lg border border-slate-200 bg-slate-50 px-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-100 disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-200 dark:hover:bg-slate-800"
                                                title="Återställ träd och sortering"
                                                disabled="@(ActiveTreeFilterCount == 0 && !_isReorderMode)"
                                                @onclick="ResetTreeFiltersAsync">
                                            Återställ
                                        </button>

                                    </div>
                                </MhdDropdownPanel>
                            </div>

                        </div>
                    }
                </div>

                <div class="min-h-0 flex-1 overflow-auto px-1 py-1.5">
                    @if (!HasDepartmentAccess)
                    {
                        <div class="rounded-xl border border-dashed border-slate-300 bg-white px-4 py-8 text-center dark:border-slate-700 dark:bg-slate-900">
                            <p class="text-sm font-semibold text-slate-700 dark:text-slate-200">@AppLoc["noDepartmentsTitle"]</p>
                            <p class="mt-1 text-xs leading-5 text-slate-500 dark:text-slate-400">@AppLoc["noDepartmentsHint"]</p>
                        </div>
                    }
                    else if (!SelectedDepartmentId.HasValue)
                    {
                        <div class="rounded-xl border border-dashed border-slate-300 bg-white px-2 py-6 text-center text-sm text-slate-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-400">
                            @AppLoc["selectDepartment"]
                        </div>
                    }
                    else
                    {
                        <FoldersTree GroupingMode="@TreeGroupingMode"
                                     SortMode="@TreeSortMode"
                                     IsReorderMode="@_isReorderMode"
                                     OnExitManualOrder="ExitManualOrderAsync"
                                     OnGroupSelected="OnGroupSelectedAsync"
                                     OnCreateNewFolder="@(() => ModalForm(new() { IsVisible = true }))" />
                    }
                </div>
            </div>

        </LeftContent>

        <RightContent>
            <div class="h-full overflow-auto bg-white dark:bg-slate-900">
                @if (Folder.State.Calculation != null)
                {
                    <ProjectManagement.Client.Pages.Calculation.CalculationPageUI @key="Folder.State.Calculation.Id" />
                }
                else if (Folder.State.ProjectSelected != null)
                {
                    <div class="h-full min-h-0 overflow-hidden">
                        <ProjectManagement.Client.Pages.Project.ProjectPages.ProjectsCalculationList @key="Folder.State.ProjectSelected.Id" />
                    </div>
                }
                else if (Folder.State.FolderSelected != null)
                {
                    <div class="h-full min-h-0 overflow-hidden">
                        <ProjectsUI @key="Folder.State.FolderSelected.Id"
                                    OnToggleArchived="ToggleArchivedAsync" />
                    </div>
                }
                else if (_selectedGroupInfo != null && _selectedGroupInfo.Key == "hela-avdelningen")
                {
                    <div class="h-full min-h-0 overflow-hidden">
                        <ProjectsUI @key="_selectedGroupInfo.Key"
                                    IsDepartmentScope="true"
                                    DepartmentName="@(Folder.State.Departments.FirstOrDefault(d => d.Id == SelectedDepartmentId)?.Name)"
                                    OnToggleArchived="ToggleArchivedAsync" />
                    </div>
                }
                else if (_selectedGroupInfo != null)
                {
                    <div>
                        <ProjectManagement.Client.Pages.Project.ProjectPages.GroupCalculationList
                            Info="_selectedGroupInfo"
                            @key="_selectedGroupInfo.Key" />
                    </div>
                }
                else
                {
                    <div class="flex h-full min-h-[60vh] items-center justify-center p-6">
                        <div class="max-w-xl rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-6 py-10 text-center dark:border-slate-700 dark:bg-slate-950/60">
                            <div class="text-xs font-semibold text-slate-500 dark:text-slate-400">@AppLoc["workspace"]</div>
                            <h3 class="mt-2 text-lg font-semibold text-slate-900 dark:text-slate-100">@AppLoc["selectFolderOrProject"]</h3>
                            <p class="mt-2 text-sm leading-6 text-slate-500 dark:text-slate-400">
                                @AppLoc["folderSelectionHint"]
                            </p>
                        </div>
                    </div>
                }
            </div>
        </RightContent>
    </HorizontalSplitter>
