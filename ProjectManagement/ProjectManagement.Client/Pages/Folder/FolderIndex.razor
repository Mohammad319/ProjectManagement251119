@using BlazorMHD.UI.Components.Feedback.Splitter
@using ContextMenuMHD
@using ProjectManagement.Client.Helper
@using ProjectManagement.Client.Pages.Project.ProjectPages
@using ProjectManagement.Client.Shared.SharedComponent
@attribute [Authorize]
@inherits AppComponentBase
@implements IDisposable
@inject AuthenticationStateProvider AuthenticationStateProvider

<HorizontalSplitter Class="h-full w-full border border-zinc-200 dark:border-zinc-800 rounded-2xl"
                    InitialPaneWidth="200"
                    MinLeftWidth="25"
                    MinRightWidth="260"
                    SplitterThickness="6"
                    LiveResize="true"
                    
                    StorageKey="folders-layout-horizontal-splitter">

        <LeftContent>
            @if (SideBarVisible)
            {
                <div class="flex h-full flex-col border-r border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-950/60">
                    <div class="space-y-2 border-b border-slate-200 px-1.5 py-2 dark:border-slate-800">
                    @*     <div class="flex items-start justify-between gap-1">
    
                            <button type="button"
                                    class="inline-flex h-9 w-9 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-500 shadow-sm transition hover:bg-slate-100 hover:text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-slate-100"
                                    @onclick="() => SideBarVisible = false"
                                    title="Hide sidebar"
                                    aria-label="Hide sidebar">
                                @((MarkupString)Icons.ChevronLeft)
                            </button>
                        </div> *@

                        <div>
                            <label class="mb-1 block text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
                                @ResourceApp.department
                            </label>

                            @if (HasDepartmentAccess)
                            {
                                <select class="w-full rounded-lg border border-slate-300 bg-white px-2 py-1.5 text-sm font-medium text-slate-800 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 disabled:cursor-default disabled:bg-slate-100 disabled:text-slate-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:disabled:bg-slate-900/60 dark:disabled:text-slate-400"
                                        value="@SelectedDepartmentValue"
                                        disabled="@(Folder.State.Departments.Count == 1)"
                                        @onchange="OnDepartmentChanged">
                                    <option value="">Välj avdelning</option>
                                    @foreach (var department in Folder.State.Departments)
                                    {
                                        <option value="@department.Id">@department.Name</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <div class="rounded-lg border border-amber-200 bg-amber-50 px-2 py-2 text-xs font-medium text-amber-800 dark:border-amber-900/60 dark:bg-amber-950/30 dark:text-amber-200">
                                    Ingen avdelning tillgänglig.
                                </div>
                            }
                        </div>

                        <div>
                            <label class="mb-1 block text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
                                Gruppera efter
                            </label>
                            <select class="w-full rounded-lg border border-slate-300 bg-white px-2 py-1.5 text-sm font-medium text-slate-800 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 disabled:cursor-default disabled:bg-slate-100 disabled:text-slate-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:disabled:bg-slate-900/60 dark:disabled:text-slate-400"
                                    value="@TreeGroupingMode"
                                    disabled="@(!SelectedDepartmentId.HasValue)"
                                    @onchange="OnTreeGroupingModeChanged">
                                <option value="@ProjectTreeGroupingMode.FolderStructure">Mappstruktur</option>
                                <option value="@ProjectTreeGroupingMode.Year">År</option>
                                <option value="@ProjectTreeGroupingMode.Quarter">Kvartal</option>
                            </select>
                        </div>

                        <div>
                            <label class="mb-1 block text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
                                Sortera
                            </label>
                            <select class="w-full rounded-lg border border-slate-300 bg-white px-2 py-1.5 text-sm font-medium text-slate-800 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 disabled:cursor-default disabled:bg-slate-100 disabled:text-slate-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:disabled:bg-slate-900/60 dark:disabled:text-slate-400"
                                    value="@TreeSortMode"
                                    disabled="@(!SelectedDepartmentId.HasValue)"
                                    @onchange="OnTreeSortModeChanged">
                                <option value="@ProjectTreeSortMode.NameAscending">Namn A-Ö</option>
                                <option value="@ProjectTreeSortMode.NameDescending">Namn Ö-A</option>
                                <option value="@ProjectTreeSortMode.CreatedNewest">Skapad nyast först</option>
                                <option value="@ProjectTreeSortMode.CreatedOldest">Skapad äldst först</option>
                                <option value="@ProjectTreeSortMode.ModifiedNewest">Senast ändrad först</option>
                                <option value="@ProjectTreeSortMode.Status">Status</option>
                            </select>
                        </div>

                        <AuthorizeView Roles="@PMRolesConst.Tenant.SuperManger">
                            <div class="mt-0 flex flex-wrap gap-2">
                                <button type="button"
                                        class="inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white px-1.5 py-1 text-sm font-medium text-slate-700 shadow-sm transition hover:bg-slate-100 hover:text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
                                        @onclick="ModalSeachForm"
                                        title="@AppLoc["searchProjects"]">
                                    <span aria-hidden="true">@((MarkupString)Icons.Search)</span>
                                </button>

                                @if (!Folder.State.OtherDepartment && SelectedDepartmentId.HasValue)
                                {
                                    <button type="button"
                                        class="inline-flex items-center gap-1 rounded-xl border border-emerald-200 bg-emerald-50 px-2 py-1 text-xs font-semibold text-emerald-700 shadow-sm transition hover:bg-emerald-100 hover:text-emerald-900 dark:border-emerald-900/60 dark:bg-emerald-950/30 dark:text-emerald-300 dark:hover:bg-emerald-950/50"
                                        @onclick="() => ModalForm(new() { IsVisible = true })"
                                        title="Ny mapp">
                                        <span aria-hidden="true">@((MarkupString)Icons.Plus)</span>
                                        <span>Ny mapp</span>
                                    </button>
                                }
                            </div>
                        </AuthorizeView>

                        @if (SelectedDepartmentId.HasValue)
                        {
                            <button type="button"
                                    class="inline-flex w-full items-center justify-center gap-1 rounded-lg border px-2 py-1.5 text-xs font-semibold shadow-sm transition @(UoWService.Folder.ShowArchived ? "border-slate-400 bg-slate-200 text-slate-800 hover:bg-slate-300 dark:border-slate-600 dark:bg-slate-700 dark:text-slate-100" : "border-slate-200 bg-white text-slate-600 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800")"
                                    @onclick="async () => await ToggleArchivedAsync()"
                                    title="Visa arkiverade">
                                <span aria-hidden="true">▣</span>
                                <span>Visa arkiverade</span>
                            </button>
                        }
                    </div>

                    <div class="min-h-0 flex-1 overflow-auto px-1 py-1.5">
                        @if (!HasDepartmentAccess)
                        {
                            <div class="rounded-xl border border-dashed border-amber-300 bg-amber-50 px-2 py-6 text-center text-sm font-medium text-amber-800 dark:border-amber-900/60 dark:bg-amber-950/30 dark:text-amber-200">
                                Ingen avdelning tillgänglig.
                            </div>
                        }
                        else if (!SelectedDepartmentId.HasValue)
                        {
                            <div class="rounded-xl border border-dashed border-slate-300 bg-white px-2 py-6 text-center text-sm text-slate-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-400">
                                Välj avdelning
                            </div>
                        }
                        else if (UoWService.Folder.State.FoldersList != null && UoWService.Folder.State.FoldersList.Any())
                        {
                            <FoldersTree GroupingMode="@TreeGroupingMode" SortMode="@TreeSortMode"></FoldersTree>
                        }
                        else
                        {
                            <div class="rounded-2xl border border-dashed border-slate-300 bg-white px-1 py-8 text-center text-sm text-slate-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-400">
                                @AppLoc["noFoldersAvailable"]
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="flex h-full items-start justify-center border-r border-slate-200 bg-slate-50 px-2 py-3 dark:border-slate-800 dark:bg-slate-950/60">
                    <button type="button"
                            class="inline-flex h-9 w-9 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-500 shadow-sm transition hover:bg-slate-100 hover:text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-slate-100"
                            @onclick="() => SideBarVisible = true"
                            title="@AppLoc["openSidebar"]"
                            aria-label="@AppLoc["openSidebar"]">
                        @((MarkupString)Icons.ChevronRight)
                    </button>
                </div>
            }
        </LeftContent>

        <RightContent>
            <div class="h-full overflow-auto bg-white dark:bg-slate-900">
                @if (Folder.State.Calculation != null)
                {
                        <ProjectManagement.Client.Pages.Calculation.CalculationPageUI @key="Folder.State.Calculation.Id" />
                  
                }
                else if (Folder.State.ProjectSelected != null)
                {
                    <div>
                        <ProjectManagement.Client.Pages.Project.ProjectPages.ProjectsCalculationList @key="Folder.State.ProjectSelected.Id" />
                    </div>
                }
                else if (Folder.State.FolderSelected != null)
                {
                    <div>
                        <ProjectsUI @key="Folder.State.FolderSelected.Id" />
                    </div>
                }
                else
                {
                    <div class="flex h-full min-h-[60vh] items-center justify-center p-6">
                        <div class="max-w-xl rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-6 py-10 text-center dark:border-slate-700 dark:bg-slate-950/60">
                            <div class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">@AppLoc["workspace"]</div>
                            <h3 class="mt-2 text-lg font-semibold text-slate-900 dark:text-slate-100">@AppLoc["selectFolderOrProject"]</h3>
                            <p class="mt-2 text-sm leading-6 text-slate-500 dark:text-slate-400">
                                @AppLoc["folderSelectionHint"]
                            </p>
                        </div>
                    </div>
                }
            </div>
        </RightContent>
    </HorizontalSplitter>

