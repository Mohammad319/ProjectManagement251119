@using BlazorMHD.UI.Components.Feedback.Splitter
@using ContextMenuMHD
@using ProjectManagement.Client.Helper
@using ProjectManagement.Client.Pages.Project.ProjectPages
@using ProjectManagement.Client.Shared.SharedComponent
@attribute [Authorize]
@inherits AppComponentBase
@implements IDisposable
@inject AuthenticationStateProvider AuthenticationStateProvider

<HorizontalSplitter Class="h-[80vh] border border-zinc-200 dark:border-zinc-800 rounded-2xl"
                    InitialPaneWidth="200"
                    MinLeftWidth="25"
                    MinRightWidth="260"
                    SplitterThickness="6"
                    LiveResize="true"
                    
                    StorageKey="folders-layout-horizontal-splitter">

        <LeftContent>
            @if (SideBarVisible)
            {
                <div class="flex h-full flex-col border-r border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-950/60">
                    <div class="border-b border-slate-200 px-1 py-1 dark:border-slate-800">
                    @*     <div class="flex items-start justify-between gap-1">
    
                            <button type="button"
                                    class="inline-flex h-9 w-9 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-500 shadow-sm transition hover:bg-slate-100 hover:text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-slate-100"
                                    @onclick="() => SideBarVisible = false"
                                    title="Hide sidebar"
                                    aria-label="Hide sidebar">
                                @((MarkupString)Icons.ChevronLeft)
                            </button>
                        </div> *@

                        <AuthorizeView Roles="@PMRolesConst.Tenant.SuperManger">
                            <div class="mt-0 flex flex-wrap gap-2">
                                <button type="button"
                                        class="inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white px-1.5 py-1 text-sm font-medium text-slate-700 shadow-sm transition hover:bg-slate-100 hover:text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
                                        @onclick="ModalSeachForm"
                                        title="@AppLoc["searchProjects"]">
                                    <span aria-hidden="true">@((MarkupString)Icons.Search)</span>
                                </button>

                                <button type="button"
                                    class="inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white px-1.5 py-1 text-sm font-medium text-slate-700 shadow-sm transition hover:bg-slate-100 hover:text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
                                    @onclick="GetDepartmentAsync"
                                        title="@ResourceApp.department">
                                    <span aria-hidden="true">@((MarkupString)Icons.Department)</span>
                                </button>

                                @if (!Folder.State.OtherDepartment)
                                {
                                    <button type="button"
                                        class="inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white px-1.5 py-1 text-sm font-medium text-slate-700 shadow-sm transition hover:bg-slate-100 hover:text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
                                        @onclick="() => ModalForm(new() { IsVisible = UoWService.Folder.IsVisible })"
                                            title="@AppLoc[LocalizerConst.New, ResourceLoc.folder]">
                                        <span aria-hidden="true">@((MarkupString)Icons.Plus)</span>
                                    </button>

                                    <button type="button"
                                        class="inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white px-1.5 py-1 text-sm font-medium text-slate-700 shadow-sm transition hover:bg-slate-100 hover:text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
                                        @onclick="UoWService.Folder.LoadHiddenVisibleFoldersAsync"
                                            title="@AppLoc["visibilityFilter"]">
                                        <span aria-hidden="true">@((MarkupString)(Icons.GetVisibleIcon(UoWService.Folder.IsVisible)))</span>
                                    </button>
                                }
                            </div>
                        </AuthorizeView>
                    </div>

                    @if (Folder.State.OtherDepartment)
                    {
                        <div class="border-b border-slate-200 px-3 py-2 text-xs font-medium text-slate-500 dark:border-slate-800 dark:text-slate-400 sm:px-4">
                            @ResourceApp.depSharedFolders
                        </div>
                    }

                    @if (Folder.State.Departments != null && (Folder.State.OtherDepartment || Admin))
                    {
                        <div class="border-b border-slate-200 px-1.5 py-1 dark:border-slate-800">
                            <select class="w-full rounded-xl border border-slate-300 bg-white px-1.5 py-1 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
                                    @onchange="async e => await UoWService.Folder.LoadFoldersByDepartmentAsync(e.Value?.ToString() ?? string.Empty)">
                                <option value="0"></option>
                                @foreach (var department in Folder.State.Departments)
                                {
                                    <option value="@department.Id">@department.Name</option>
                                }
                            </select>
                        </div>
                    }

                    <div class="min-h-0 flex-1 overflow-auto px-1 py-1.5">
                        @if (UoWService.Folder.State.FoldersList != null && UoWService.Folder.State.FoldersList.Any())
                        {
                            <FoldersTree></FoldersTree>
                        }
                        else
                        {
                            <div class="rounded-2xl border border-dashed border-slate-300 bg-white px-1 py-8 text-center text-sm text-slate-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-400">
                                @AppLoc["noFoldersAvailable"]
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="flex h-full items-start justify-center border-r border-slate-200 bg-slate-50 px-2 py-3 dark:border-slate-800 dark:bg-slate-950/60">
                    <button type="button"
                            class="inline-flex h-9 w-9 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-500 shadow-sm transition hover:bg-slate-100 hover:text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-slate-100"
                            @onclick="() => SideBarVisible = true"
                            title="@AppLoc["openSidebar"]"
                            aria-label="@AppLoc["openSidebar"]">
                        @((MarkupString)Icons.ChevronRight)
                    </button>
                </div>
            }
        </LeftContent>

        <RightContent>
            <div class="h-full overflow-auto bg-white dark:bg-slate-900">
                @if (Folder.State.Calculation != null)
                {
                        <ProjectManagement.Client.Pages.Calculation.CalculationPageUI @key="Folder.State.Calculation.Id" />
                  
                }
                else if (Folder.State.ProjectSelected != null)
                {
                    <div>
                        <ProjectManagement.Client.Pages.Project.ProjectPages.ProjectsCalculationList @key="Folder.State.ProjectSelected.Id" />
                    </div>
                }
                else if (Folder.State.FolderSelected != null)
                {
                    <div>
                        <ProjectsUI @key="Folder.State.FolderSelected.Id" />
                    </div>
                }
                else
                {
                    <div class="flex h-full min-h-[60vh] items-center justify-center p-6">
                        <div class="max-w-xl rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-6 py-10 text-center dark:border-slate-700 dark:bg-slate-950/60">
                            <div class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">@AppLoc["workspace"]</div>
                            <h3 class="mt-2 text-lg font-semibold text-slate-900 dark:text-slate-100">@AppLoc["selectFolderOrProject"]</h3>
                            <p class="mt-2 text-sm leading-6 text-slate-500 dark:text-slate-400">
                                @AppLoc["folderSelectionHint"]
                            </p>
                        </div>
                    </div>
                }
            </div>
        </RightContent>
    </HorizontalSplitter>

