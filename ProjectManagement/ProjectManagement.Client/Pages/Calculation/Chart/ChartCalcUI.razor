@* CalculationCharts.razor *@
@using System
@using System.Linq
@using System.Collections.Generic
@using Microsoft.Extensions.Localization
@using pax.BlazorChartJs

@using ProjectManagement.Client.Services.Calculation
@using ProjectManagement.Client.Services.Folder
@using ProjectManagement.Client.Shared.ResourceFiles.APP
@using ProjectManagement.Client.Shared.MVVM.Calculation

@inject FolderState Container
@inject CalculationService CalcService
@inject IStringLocalizer<ResourceApp> AppLoc

<div class="w-full space-y-1">
    <div class="grid grid-cols-1 gap-1 md:grid-cols-2 xl:grid-cols-4">
        <div class="rounded-lg border border-slate-200 bg-white p-1 shadow-sm dark:border-slate-700 dark:bg-slate-900">
            <div class="relative min-h-[220px]">
                <ChartComponent ChartJsConfig="NetCostTotalyPieCfg" />
            </div>
        </div>

        <div class="rounded-lg border border-slate-200 bg-white p-1 shadow-sm dark:border-slate-700 dark:bg-slate-900">
            <div class="relative min-h-[220px]">
                <ChartComponent ChartJsConfig="NetCostTotalyOHPieCfg" />
            </div>
        </div>

        <div class="rounded-lg border border-slate-200 bg-white p-1 shadow-sm dark:border-slate-700 dark:bg-slate-900">
            <div class="relative min-h-[220px]">
                <ChartComponent ChartJsConfig="EVCfg" />
            </div>
        </div>

        <div class="rounded-lg border border-slate-200 bg-white p-1 shadow-sm dark:border-slate-700 dark:bg-slate-900">
            <div class="relative min-h-[220px]">
                <ChartComponent ChartJsConfig="SumPieCfg" />
            </div>
        </div>
    </div>

    <div class="mt-1">
        <div class="rounded-lg border border-slate-200 bg-white p-1 shadow-sm dark:border-slate-700 dark:bg-slate-900">
            <div class="relative min-h-[320px]">
                <ChartComponent ChartJsConfig="BarCfg" />
            </div>
        </div>
    </div>
</div>

@code {
    // للوصول إلى دوال التنسيق نفسها التي لديك
    TemplateMVVM? Template => Container.Calculation?.Template;

    // تكوينات الرسوم
    private ChartJsConfig? NetCostTotalyPieCfg;
    private ChartJsConfig? NetCostTotalyOHPieCfg;
    private ChartJsConfig? EVCfg;
    private ChartJsConfig? SumPieCfg;
    private ChartJsConfig? BarCfg;

    private readonly List<string> ColorsChart = new();

    protected override void OnInitialized()
    {
        GenerateRandomColors();

        var factors = Container.Calculation?.Factors?.ToList() ?? new List<Factors>();
        var netCostTotaly = factors.Select(x => Template?.Format(x.NetCostTotaly) ?? 0m).ToList();
        var netCostTotalyOH = factors.Select(x => Template?.Format(x.NetCostTotalyOH) ?? 0m).ToList();
        var earningsValue = factors.Select(x => Template?.Format(x.EarningsValue) ?? 0m).ToList();

        NetCostTotalyPieCfg = CreatePieConfig(netCostTotaly, CalcResource.totalNetCost);
        NetCostTotalyOHPieCfg = CreatePieConfig(netCostTotalyOH, CalcResource.netCalOH);
        EVCfg = CreatePieConfig(earningsValue, CalcResource.earning);
        SumPieCfg = CreateSumPieConfig();

        BarCfg = CreateBarConfig(netCostTotaly, netCostTotalyOH, earningsValue);
    }

    // ===== Helpers =====
    private void GenerateRandomColors()
    {
        var rng = new Random();
        string Hex() => $"#{rng.Next(0x1000000):X6}";
        ColorsChart.Clear();

        // عدد ألوان يساوي عدد العوامل + ألوان إضافية للـ Bar
        int needed = Math.Max(3, Container.Calculation?.Factors?.Count() ?? 0);
        for (int i = 0; i < needed; i++) ColorsChart.Add(Hex());
    }

    private List<string> FactorLabels() =>
        (Container.Calculation?.Factors ?? Enumerable.Empty<Factors>())
            .Select(f => f.ResName + (string.IsNullOrWhiteSpace(f.Sort) ? "" : $" ({f.Sort})"))
            .ToList();

    private ChartJsConfig CreatePieConfig(IReadOnlyList<decimal> data, string title)
    {
        return new ChartJsConfig
        {
            Type = ChartType.pie,
            Data = new ChartJsData
            {
                Labels = new List<string>(FactorLabels()),
                Datasets = new List<ChartJsDataset>
                {
                    new PieDataset
                    {
                        // PieDataset لا يحتوي Label في pax.BlazorChartJs
                        Data = data.Select(x => (object)x).ToList(),
                        BackgroundColor = new List<string>(ColorsChart.Take(data.Count))
                    }
                }
            },
            Options = new()
            {
                Responsive = true,
                Plugins = new()
                {
                    Title = new() { Display = true, Text = title }
                }
            }
        };
    }

    private ChartJsConfig CreateSumPieConfig()
    {
        var factors = Container.Calculation?.Factors ?? Enumerable.Empty<Factors>();
        var sumNet = Template?.Format(factors.Sum(x => x.NetCostTotaly)) ?? 0m;
        var sumOH = Template?.Format(factors.Sum(x => x.NetCostTotalyOH)) ?? 0m;
        var sumEV = Template?.Format(factors.Sum(x => x.EarningsValue)) ?? 0m;

        return new ChartJsConfig
        {
            Type = ChartType.pie,
            Data = new ChartJsData
            {
                Labels = new List<string> { CalcResource.totalNetCost, CalcResource.netCalOH, CalcResource.earning },
                Datasets = new List<ChartJsDataset>
                {
                    new PieDataset
                    {
                        Data = new List<object> { sumNet, sumOH, sumEV },
                        BackgroundColor = new List<string>(ColorsChart.Take(3))
                    }
                }
            },
            Options = new()
            {
                Responsive = true,
                Plugins = new()
                {
                    Title = new() { Display = true, Text = CalcResource.sum }
                }
            }
        };
    }

    private ChartJsConfig CreateBarConfig(
        IReadOnlyList<decimal> netCostTotaly,
        IReadOnlyList<decimal> netCostTotalyOH,
        IReadOnlyList<decimal> earningsValue)
    {
        var labels = new List<string>(FactorLabels())
        {
            CalcResource.sum
        };

        var sumNet = netCostTotaly.Sum();
        var sumOH = netCostTotalyOH.Sum();
        var sumEV = earningsValue.Sum();

        var dsNet = new BarDataset
        {
            Label = CalcResource.totalNetCost,
            Data = netCostTotaly.Concat(new[] { sumNet }).Select(x => (object)x).ToList(),
            BackgroundColor = Enumerable.Repeat(ColorsChart[0], labels.Count).ToList()
        };

        var dsOH = new BarDataset
        {
            Label = CalcResource.netCalOH,
            Data = netCostTotalyOH.Concat(new[] { sumOH }).Select(x => (object)x).ToList(),
            BackgroundColor = Enumerable.Repeat(ColorsChart[1], labels.Count).ToList()
        };

        var dsEV = new BarDataset
        {
            Label = CalcResource.earning,
            Data = earningsValue.Concat(new[] { sumEV }).Select(x => (object)x).ToList(),
            BackgroundColor = Enumerable.Repeat(ColorsChart[2], labels.Count).ToList()
        };

        return new ChartJsConfig
        {
            Type = ChartType.bar,
            Data = new ChartJsData
            {
                Labels = labels,
                Datasets = new List<ChartJsDataset> { dsNet, dsOH, dsEV }
            },
            Options = new()
            {
                Responsive = true,
                Plugins = new()
                {
                    Title = new() { Display = true, Text = AppLoc["calculationChart"].Value },
                    Tooltip = new() { Mode = "index", Intersect = false }
                },
                Scales = new()
                {
                    X = new() { Stacked = true },
                    Y = new() { Stacked = true }
                }
            }
        };
    }
}
