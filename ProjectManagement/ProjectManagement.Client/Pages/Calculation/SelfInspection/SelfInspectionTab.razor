@using Microsoft.AspNetCore.Components.Authorization
@using ProjectManagement.Client.Shared.Model.Application
@using ProjectManagement.Shared.Base.Application
@using ProjectManagement.Shared.Constant
@inherits AppComponentBase
@inject AuthenticationStateProvider AuthenticationStateProvider

@* Egenkontroll i kalkylen: användaren väljer egenkontrollmallar (byggda i Inställningar)
   och fyller i dem här. Detta är IFYLLNADSVYN — mallbyggaren finns bara i Inställningar. *@

@if (_open is not null)
{
    <SelfInspectionFillUI Instance="_open"
                          ReadOnly="@(!_canEdit)"
                          OnBack="CloseFillAsync" />
}
else
{
    <div class="flex h-full min-h-0 flex-col gap-2 overflow-y-auto p-2 text-sm">
        <div class="flex flex-wrap items-center justify-between gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 dark:border-slate-700 dark:bg-slate-900">
            <div>
                <h3 class="text-sm font-semibold text-slate-800 dark:text-slate-100">Egenkontroll</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400">Egenkontroller för denna kalkyl, skapade från mallar i Inställningar.</p>
            </div>
            @if (_canEdit)
            {
                <button type="button"
                        class="inline-flex items-center gap-1.5 rounded-md bg-sky-600 px-3 py-1.5 text-sm font-medium text-white transition hover:bg-sky-700 dark:bg-sky-500 dark:hover:bg-sky-400"
                        @onclick="TogglePicker">
                    + Lägg till egenkontroll
                </button>
            }
        </div>

        @if (_pickerOpen)
        {
            <div class="rounded-lg border border-sky-200 bg-sky-50/60 p-3 dark:border-sky-900/60 dark:bg-sky-950/20">
                <div class="mb-2 text-sm font-semibold text-slate-800 dark:text-slate-100">Välj mall</div>
                @if (_templates.Count == 0)
                {
                    <div class="text-sm text-slate-500 dark:text-slate-400">
                        Det finns inga synliga egenkontrollmallar. Skapa mallar under Inställningar → Egenkontroll.
                    </div>
                }
                else
                {
                    <div class="space-y-1">
                        @foreach (var template in _templates)
                        {
                            <div class="flex items-center justify-between gap-2 rounded-md border border-slate-200 bg-white px-3 py-2 dark:border-slate-700 dark:bg-slate-900">
                                <div class="min-w-0">
                                    <div class="truncate font-medium text-slate-800 dark:text-slate-100">@template.Name</div>
                                    <div class="text-xs text-slate-500 dark:text-slate-400">@template.Data.TemplateType</div>
                                </div>
                                <button type="button"
                                        class="shrink-0 rounded-md border border-sky-300 bg-white px-3 py-1 text-xs font-medium text-sky-700 transition hover:bg-sky-100 disabled:opacity-50 dark:border-sky-700 dark:bg-slate-950 dark:text-sky-300 dark:hover:bg-sky-950/40"
                                        disabled="@_busy"
                                        @onclick="() => CreateFromTemplateAsync(template)">
                                    Välj mall
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>
        }

        @if (_loading)
        {
            <div class="rounded-lg border border-slate-200 bg-white p-3 dark:border-slate-700 dark:bg-slate-900"><MhdLoading /></div>
        }
        else if (_items.Count == 0)
        {
            <div class="rounded-lg border border-dashed border-slate-300 bg-white px-4 py-8 text-center dark:border-slate-700 dark:bg-slate-900">
                <div class="text-sm font-medium text-slate-700 dark:text-slate-200">Det finns ingen egenkontroll för denna kalkyl ännu.</div>
                @if (_canEdit)
                {
                    <button type="button"
                            class="mt-3 inline-flex items-center gap-1.5 rounded-md bg-sky-600 px-3 py-1.5 text-sm font-medium text-white transition hover:bg-sky-700 dark:bg-sky-500 dark:hover:bg-sky-400"
                            @onclick="TogglePicker">
                        + Lägg till egenkontroll
                    </button>
                }
            </div>
        }
        else
        {
            <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-900">
                <table class="min-w-full text-sm">
                    <thead class="bg-slate-50 dark:bg-slate-800/80">
                        <tr class="text-left text-xs font-semibold text-slate-600 dark:text-slate-200">
                            <th class="px-3 py-2">Namn</th>
                            <th class="px-3 py-2">Status</th>
                            <th class="px-3 py-2">Kontrollpunkter</th>
                            <th class="px-3 py-2">Klara punkter</th>
                            <th class="px-3 py-2">Senast ändrad</th>
                            <th class="px-3 py-2 text-right">Åtgärder</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                        @foreach (var item in _items)
                        {
                            var progress = SelfInspectionProgress.For(item);
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40">
                                <td class="px-3 py-2">
                                    <button type="button"
                                            class="text-left font-medium text-sky-600 underline-offset-2 hover:underline dark:text-sky-300"
                                            @onclick="() => OpenFill(item)">
                                        @item.Name
                                    </button>
                                    <div class="text-xs text-slate-500 dark:text-slate-400">@item.Application.Data.TemplateType</div>
                                </td>
                                <td class="px-3 py-2">
                                    <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium @StatusBadgeClass(progress.Status)">
                                        @progress.Status
                                    </span>
                                </td>
                                <td class="px-3 py-2 text-slate-600 dark:text-slate-300">@progress.Total</td>
                                <td class="px-3 py-2 text-slate-600 dark:text-slate-300">
                                    @progress.Done av @progress.Total
                                    @if (progress.Total > 0)
                                    {
                                        <span class="text-xs text-slate-400"> (@progress.Percent %)</span>
                                    }
                                </td>
                                <td class="px-3 py-2 text-slate-600 dark:text-slate-300">@item.LastUpdate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="px-3 py-2">
                                    <div class="flex items-center justify-end gap-1.5">
                                        <button type="button"
                                                class="rounded-md border border-slate-300 px-2.5 py-1 text-xs font-medium text-slate-700 transition hover:bg-slate-50 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-800"
                                                @onclick="() => OpenFill(item)">
                                            @(_canEdit ? "Fyll i" : "Öppna")
                                        </button>
                                        @if (_canEdit)
                                        {
                                            <button type="button"
                                                    class="rounded-md border border-rose-300 px-2.5 py-1 text-xs font-medium text-rose-600 transition hover:bg-rose-50 dark:border-rose-800 dark:text-rose-400 dark:hover:bg-rose-950/40"
                                                    @onclick="() => AskRemove(item)">
                                                Ta bort
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@code {
    private List<ApplicationValuesModel> _items = [];
    private List<ApplicationModel> _templates = [];
    private ApplicationValuesModel? _open;
    private bool _loading = true;
    private bool _busy;
    private bool _pickerOpen;
    private bool _canEdit;

    private int CalculationId => Folder?.State?.Calculation?.Id ?? 0;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _canEdit = PMRolesConst.Tenant.AdminManger.Split(',').Any(authState.User.IsInRole);

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            _items = CalculationId > 0
                ? await Repo.Application.GetCalcAppValuesAsync(CalculationId)
                : [];
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task TogglePicker()
    {
        _pickerOpen = !_pickerOpen;
        if (_pickerOpen && _templates.Count == 0)
        {
            // Only visible templates can be chosen.
            _templates = await Repo.Application.GetApplicationsAsync(withNoneVisible: false);
        }
    }

    private async Task CreateFromTemplateAsync(ApplicationModel template)
    {
        if (_busy || CalculationId <= 0)
            return;

        _busy = true;
        try
        {
            var instance = new ApplicationValuesModel
            {
                CalculationId = CalculationId,
                ApplicationId = template.Id,
                Name = template.Name,
                LastUpdate = DateTime.Now
            };

            var id = await Repo.Application.CreateAsync(instance);
            if (id > 0)
            {
                MHD.ToastInfo("Egenkontrollen har lagts till i kalkylen.", string.Empty, true);
                _pickerOpen = false;
                await LoadAsync();

                var created = _items.FirstOrDefault(x => x.Id == id);
                if (created is not null)
                    OpenFill(created);
            }
            else
            {
                MHD.Notifications(ToastType.Add, false);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private void OpenFill(ApplicationValuesModel item) => _open = item;

    private async Task CloseFillAsync()
    {
        _open = null;
        await LoadAsync();
    }

    private void AskRemove(ApplicationValuesModel item)
    {
        MHD.MessageYesNo(
            "Ta bort egenkontroll",
            "Vill du ta bort denna egenkontroll från kalkylen? Ifyllda svar tas bort.",
            BlazorMHD.UI.Core.DesignSystem.MhdState.Danger,
            EventCallback.Factory.Create(this, () => ConfirmRemoveAsync(item)));
    }

    private async Task ConfirmRemoveAsync(ApplicationValuesModel item)
    {
        var ok = await Repo.Application.DeleteAsync(item.Id);
        MHD.Notifications(ToastType.Delete, ok);
        if (ok)
            await LoadAsync();
    }

    private static string StatusBadgeClass(string status) => status switch
    {
        "Klar" => "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300",
        "Pågår" => "bg-sky-100 text-sky-700 dark:bg-sky-900/40 dark:text-sky-300",
        _ => "bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300"
    };
}
