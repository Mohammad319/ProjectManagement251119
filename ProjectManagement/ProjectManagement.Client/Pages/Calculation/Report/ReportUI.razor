@using ProjectManagement.Client.Pages.Calculation.Table
@using ProjectManagement.Client.Pages.Calculation.Table.SectionsList
@inherits AppComponentBase
@attribute [Authorize(Roles = PMRolesConst.Tenant.Users)]

<div class="tableFixHead" style="height:calc(100vh - 106px)">
    <div class="flex flex-wrap items-center gap-2 rounded-xl border border-slate-200 bg-white/95 px-3 py-2 shadow-sm backdrop-blur-sm dark:border-slate-700 dark:bg-slate-900/95">

        <button class="inline-flex h-6 items-center gap-1 rounded-md bg-sky-600 px-2 text-[11px] font-semibold text-white transition hover:bg-sky-700 focus:outline-none focus:ring-2 focus:ring-sky-400/70 dark:bg-sky-500 dark:hover:bg-sky-600"
                id="print"
                onclick="pmPrintPageWithCompany()">
            <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 9V2h12v7" />
                <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" />
                <rect x="6" y="14" width="12" height="8" />
            </svg>
            @ResourceApp.print
        </button>

        <span class="h-4 w-px bg-slate-200 dark:bg-slate-700"></span>

        <label class="inline-flex h-6 items-center gap-1 rounded-md border border-slate-200 bg-slate-50 px-2 text-[11px] font-medium text-slate-600 dark:border-slate-700 dark:bg-slate-800/60 dark:text-slate-300">
            <input type="number"
                   class="w-12 bg-transparent text-center text-[11px] text-slate-800 outline-none dark:text-slate-100"
                   value="@scaleX"
                   min="10" max="200" step="5"
                   @onchange="(e) => scaleX = double.TryParse(e.Value?.ToString(), out var p) ? p : scaleX" />
            <span class="text-slate-400">%</span>
        </label>

        <span class="h-4 w-px bg-slate-200 dark:bg-slate-700"></span>

        <label class="inline-flex h-6 cursor-pointer items-center gap-1.5 rounded-md border border-slate-200 bg-slate-50 px-2 text-[11px] font-medium text-slate-700 transition hover:border-sky-400 hover:text-sky-700 dark:border-slate-700 dark:bg-slate-800/60 dark:text-slate-300 dark:hover:border-sky-500">
            <input type="checkbox" class="h-3 w-3 rounded border-slate-300 text-sky-600 focus:ring-sky-400 dark:border-slate-600 dark:bg-slate-800" @bind="TemplateVisible[0]" />
            @CalcResource.netCal
        </label>

        <label class="inline-flex h-6 cursor-pointer items-center gap-1.5 rounded-md border border-slate-200 bg-slate-50 px-2 text-[11px] font-medium text-slate-700 transition hover:border-sky-400 hover:text-sky-700 dark:border-slate-700 dark:bg-slate-800/60 dark:text-slate-300 dark:hover:border-sky-500">
            <input type="checkbox" class="h-3 w-3 rounded border-slate-300 text-sky-600 focus:ring-sky-400 dark:border-slate-600 dark:bg-slate-800" @bind="TemplateVisible[1]" />
            @ResourceLoc.summarySheet
        </label>
    </div>

    <div id="section-to-print" style="transform-origin:top left;transform:scale(@((scaleX / 100.0).ToString("F2", System.Globalization.CultureInfo.InvariantCulture)));left:0;top:0;margin-top:8px">
        @if (TemplateVisible[0])
        {
            <div class="NettableDiv">
                <CalcDataGrid></CalcDataGrid>
            </div>
        }
        @if (TemplateVisible[1])
        {
            <SummarySheet IsReport="true"></SummarySheet>
        }
    </div>
</div>

@code {
    bool[] TemplateVisible = new[] { true, true };
    double scaleX = 100;

    protected override void OnInitialized()
    {
        TemplateConst.Col0 = 0;
    }
}
