@using ProjectManagement.Client.Pages.Calculation.Table
@using ProjectManagement.Client.Pages.Calculation.Table.SectionsList
@inherits AppComponentBase
@attribute [Authorize(Roles = PMRolesConst.Tenant.Users)]

<div class="tableFixHead" style="height:calc(100vh - 106px)">
    <div class="flex flex-wrap items-center gap-3 rounded-lg border border-slate-200 bg-white/95 px-3 py-2 text-sm text-slate-700 shadow-sm dark:border-slate-700 dark:bg-slate-900/95 dark:text-slate-200">
        <label class="inline-flex items-center gap-1 text-xs font-medium sm:text-sm">
            <input type="number"
                   class="w-[75px] rounded border border-slate-300 bg-white px-2 py-1 text-slate-800 outline-none focus:border-sky-500 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100"
                   value="100"
                   maxlength="6"
                   @onchange="(e)=> scaleX = double.TryParse(e.Value?.ToString(), out var parsed) ? parsed : scaleX" />%
        </label>

        <button class="inline-flex items-center rounded-md bg-sky-600 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-sky-700 focus:outline-none focus:ring-2 focus:ring-sky-400/70 dark:bg-sky-500 dark:hover:bg-sky-600"
                id="print"
                onclick="window.print()">
            @ResourceApp.print
        </button>

        <label class="inline-flex items-center gap-2 text-xs font-medium sm:text-sm">
            <input type="checkbox" class="h-4 w-4 rounded border-slate-300 text-sky-600 focus:ring-sky-400 dark:border-slate-600 dark:bg-slate-800" @bind="TemplateVisible[0]" />
            @CalcResource.netCal
        </label>

        <label class="inline-flex items-center gap-2 text-xs font-medium sm:text-sm">
            <input type="checkbox" class="h-4 w-4 rounded border-slate-300 text-sky-600 focus:ring-sky-400 dark:border-slate-600 dark:bg-slate-800" @bind="TemplateVisible[1]" />
            @ResourceLoc.summarySheet
        </label>
    </div>

    <div id="section-to-print" style="transform:rotate(@(deg)deg);left:0px;top:150px;">
        @if (TemplateVisible[0])
        {
            <div class="NettableDiv">
                <CalcDataGrid></CalcDataGrid>
            </div>
        }
        @if (TemplateVisible[1])
        {
            <SummarySheet IsReport="true"></SummarySheet>
        }
    </div>
</div>

@code {
    int deg = 0;
    bool[] TemplateVisible = new[] { true, true };
    double scaleX = 100;
    void Scale()
    {
        if (deg == 270)
        {
            deg = 0;
            return;
        }
        deg = deg + 90;
        if (deg == 0) { }
    }
    protected override void OnInitialized()
    {
        TemplateConst.Col0 = 0;
    }
}
