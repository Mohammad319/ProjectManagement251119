@using ProjectManagement.Client.Shared.MVVM.Calculation
@using ProjectManagement.Shared.Base.Calculation
@using ProjectManagement.Shared.DTO.Calculation
@using ProjectManagement.Shared.Enums
@inherits AppComponentBase

<div class="text-slate-800 dark:text-slate-100">
    @if (Incomes != null)
    {
        <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-900/40">
            <table class="min-w-full border-collapse text-xs text-left">
                <thead>
                    <tr>
                        <th class="bg-slate-50 px-2 py-2 w-8 dark:bg-slate-800/80">
                            <button type="button" @onclick="AddIncome"
                                    class="inline-flex items-center rounded border border-emerald-500 px-1.5 py-1 text-emerald-700 hover:bg-emerald-50 dark:border-emerald-500 dark:text-emerald-300 dark:hover:bg-emerald-900/30"
                                    title="Lägg till intäktsrad">
                                @((MarkupString)Icons.Plus)
                            </button>
                        </th>
                        <th class="bg-slate-50 px-2 py-2 w-20 whitespace-nowrap font-semibold text-slate-600 dark:bg-slate-800/80 dark:text-slate-300">@ResourceLoc.year</th>
                        <th class="bg-slate-50 px-2 py-2 min-w-[160px] font-semibold text-slate-600 dark:bg-slate-800/80 dark:text-slate-300">Beskrivning</th>
                        <th class="bg-slate-50 px-2 py-2 w-28 font-semibold text-slate-600 dark:bg-slate-800/80 dark:text-slate-300">Deltyp</th>
                        <th class="border-l border-slate-200 bg-sky-50/70 px-2 py-2 min-w-[140px] text-right font-semibold text-slate-600 dark:border-slate-700 dark:bg-sky-900/20 dark:text-slate-300">Q1</th>
                        <th class="bg-sky-50/70 px-2 py-2 min-w-[140px] text-right font-semibold text-slate-600 dark:bg-sky-900/20 dark:text-slate-300">Q2</th>
                        <th class="bg-sky-50/70 px-2 py-2 min-w-[140px] text-right font-semibold text-slate-600 dark:bg-sky-900/20 dark:text-slate-300">Q3</th>
                        <th class="bg-sky-50/70 px-2 py-2 min-w-[140px] text-right font-semibold text-slate-600 dark:bg-sky-900/20 dark:text-slate-300">Q4</th>
                        <th class="border-l border-slate-200 bg-amber-50/70 px-2 py-2 min-w-[160px] text-right font-semibold text-slate-600 dark:border-slate-700 dark:bg-amber-900/20 dark:text-slate-300">Årssumma</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 dark:divide-slate-700">
                    @foreach (var income in Incomes)
                    {
                        <tr class="hover:bg-slate-50/70 dark:hover:bg-slate-800/40">
                            <td class="px-2 py-1">
                                <AuthorizeView Roles="@PMRolesConst.Tenant.AdminManger">
                                    <button type="button" @onclick="() => Remove(income)"
                                            class="inline-flex items-center rounded border border-rose-300 px-1.5 py-1 text-rose-600 hover:bg-rose-50 dark:border-rose-700 dark:text-rose-400 dark:hover:bg-rose-900/20">
                                        @((MarkupString)Icons.DeleteSVG)
                                    </button>
                                </AuthorizeView>
                            </td>
                            <td class="px-2 py-1">
                                <input type="number" min="@MinYear" value="@income.Year"
                                       @onchange="e => SetIncomeYear(income, e.Value)"
                                       class="@InputBase w-16" />
                            </td>
                            <td class="px-2 py-1">
                                <input type="text" placeholder="Beskrivning (valfri)"
                                       value="@income.Description"
                                       @onchange="e => income.Description = e.Value?.ToString()"
                                       class="@InputBase w-full min-w-[110px]" />
                            </td>
                            <td class="px-2 py-1">
                                <select value="@((int)income.SubType)" @onchange="e => SetSubType(income, e.Value)"
                                        class="@InputBase w-full">
                                    <option value="0">Grunddel</option>
                                    <option value="1">Option</option>
                                    <option value="2">ÄTA</option>
                                </select>
                            </td>
                            <td class="border-l border-slate-100 px-1.5 py-1 dark:border-slate-800">
                                <input type="number" value="@DisplayQ(income, income.Q1)"
                                       @onchange="e => OnQChanged(income, 1, e.Value)"
                                       class="@InputBase w-full text-right" />
                            </td>
                            <td class="px-1.5 py-1">
                                <input type="number" value="@DisplayQ(income, income.Q2)"
                                       @onchange="e => OnQChanged(income, 2, e.Value)"
                                       class="@InputBase w-full text-right" />
                            </td>
                            <td class="px-1.5 py-1">
                                <input type="number" value="@DisplayQ(income, income.Q3)"
                                       @onchange="e => OnQChanged(income, 3, e.Value)"
                                       class="@InputBase w-full text-right" />
                            </td>
                            <td class="px-1.5 py-1">
                                <input type="number" value="@DisplayQ(income, income.Q4)"
                                       @onchange="e => OnQChanged(income, 4, e.Value)"
                                       class="@InputBase w-full text-right" />
                            </td>
                            <td class="border-l border-slate-100 px-1.5 py-1 dark:border-slate-800">
                                <input type="number" value="@DisplayYearly(income)"
                                       @onchange="e => DistributeYearly(income, e.Value)"
                                       class="@InputBase @InputSumExtra w-full text-right font-medium" />
                            </td>
                        </tr>
                    }
                </tbody>
                @if (Incomes.Count >= 2)
                {
                    <tfoot class="border-t-2 border-slate-200 text-xs dark:border-slate-600">
                        @foreach (var grp in SubTypeGroups.Where(g => g.Count >= 2))
                        {
                            <tr class="bg-slate-50 italic text-slate-500 dark:bg-slate-800/50 dark:text-slate-400">
                                <td></td>
                                <td colspan="3" class="px-2 py-1 text-right">Summa @SubTypeLabel(grp.SubType)</td>
                                <td class="border-l border-slate-100 px-1.5 py-1 text-right dark:border-slate-800">@FmtSum(grp.Q1)</td>
                                <td class="px-1.5 py-1 text-right">@FmtSum(grp.Q2)</td>
                                <td class="px-1.5 py-1 text-right">@FmtSum(grp.Q3)</td>
                                <td class="px-1.5 py-1 text-right">@FmtSum(grp.Q4)</td>
                                <td class="border-l border-slate-100 px-1.5 py-1 text-right font-semibold dark:border-slate-800">@FmtSum(grp.Q1 + grp.Q2 + grp.Q3 + grp.Q4)</td>
                            </tr>
                        }
                        <tr class="bg-slate-100 font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-200">
                            <td></td>
                            <td colspan="3" class="px-2 py-1.5 text-right">Totalt alla år</td>
                            <td class="border-l border-slate-200 px-1.5 py-1.5 text-right dark:border-slate-600">@FmtSum(Incomes.Sum(i => i.Q1))</td>
                            <td class="px-1.5 py-1.5 text-right">@FmtSum(Incomes.Sum(i => i.Q2))</td>
                            <td class="px-1.5 py-1.5 text-right">@FmtSum(Incomes.Sum(i => i.Q3))</td>
                            <td class="px-1.5 py-1.5 text-right">@FmtSum(Incomes.Sum(i => i.Q4))</td>
                            <td class="border-l border-slate-200 px-1.5 py-1.5 text-right font-bold dark:border-slate-600">@FmtSum(Incomes.Sum(i => i.Q1 + i.Q2 + i.Q3 + i.Q4))</td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    }
</div>

@code {
    [Parameter] public List<IncomeBase>? Incomes { get; set; }
    [Parameter] public int? MinYear { get; set; }

    private readonly HashSet<IncomeBase> _newEmptyRows = [];

    private const string InputBase = "rounded border border-slate-300 bg-white px-2 py-1 text-xs text-slate-800 focus:outline-none focus:ring-1 focus:ring-sky-500 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100";
    private const string InputSumExtra = "bg-amber-50/40 dark:bg-amber-900/10";

    private sealed record SubTypeGroup(IncomeSubType SubType, int Count, decimal Q1, decimal Q2, decimal Q3, decimal Q4);

    private IEnumerable<SubTypeGroup> SubTypeGroups =>
        (Incomes ?? [])
            .GroupBy(i => i.SubType)
            .Select(g => new SubTypeGroup(g.Key, g.Count(),
                g.Sum(i => i.Q1), g.Sum(i => i.Q2),
                g.Sum(i => i.Q3), g.Sum(i => i.Q4)));

    protected override void OnParametersSet()
    {
        Incomes ??= [];
        if (MinYear.HasValue)
            Incomes.RemoveAll(income => income.Year > 0 && income.Year < MinYear.Value);
        _newEmptyRows.RemoveWhere(row => !Incomes.Contains(row));
    }

    void AddIncome()
    {
        Incomes ??= [];
        var nextYear = Incomes.Count > 0
            ? Incomes.Max(i => i.Year) + 1
            : DateTime.Today.Year;
        var newRow = new IncomeListDTO { Year = nextYear };
        _newEmptyRows.Add(newRow);
        Incomes.Add(newRow);
    }

    void SetIncomeYear(IncomeBase income, object? value)
    {
        if (!int.TryParse(value?.ToString(), out var year)) return;
        income.Year = MinYear.HasValue && year < MinYear.Value ? MinYear.Value : year;
    }

    void SetSubType(IncomeBase income, object? value)
    {
        if (int.TryParse(value?.ToString(), out var v) && Enum.IsDefined(typeof(IncomeSubType), v))
            income.SubType = (IncomeSubType)v;
    }

    void OnQChanged(IncomeBase income, int quarter, object? value)
    {
        if (!decimal.TryParse(value?.ToString(), System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture, out var v))
            decimal.TryParse(value?.ToString(), out v);
        _newEmptyRows.Remove(income);
        switch (quarter)
        {
            case 1: income.Q1 = v; break;
            case 2: income.Q2 = v; break;
            case 3: income.Q3 = v; break;
            case 4: income.Q4 = v; break;
        }
    }

    void DistributeYearly(IncomeBase income, object? value)
    {
        if (!decimal.TryParse(value?.ToString(), System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture, out var total))
            if (!decimal.TryParse(value?.ToString(), out total))
                return;
        _newEmptyRows.Remove(income);
        var q = Math.Floor(total / 4);
        income.Q1 = q;
        income.Q2 = q;
        income.Q3 = q;
        income.Q4 = total - 3 * q;
    }

    decimal? DisplayQ(IncomeBase income, decimal value) =>
        _newEmptyRows.Contains(income) ? (decimal?)null : value;

    decimal? DisplayYearly(IncomeBase income) =>
        _newEmptyRows.Contains(income) ? (decimal?)null : income.Q1 + income.Q2 + income.Q3 + income.Q4;

    static string FmtSum(decimal v) => v.ToString("N0");

    static string SubTypeLabel(IncomeSubType s) => s switch
    {
        IncomeSubType.Option => "Option",
        IncomeSubType.ATA => "ÄTA",
        _ => "Grunddel"
    };

    void Remove(IncomeBase income)
    {
        MHD.DeleteMessage(string.Empty, EventCallback.Factory.Create(this, () => ConfirmRemove(income)));
    }

    bool ConfirmRemove(IncomeBase income)
    {
        _newEmptyRows.Remove(income);
        Incomes?.Remove(income);
        return true;
    }
}
