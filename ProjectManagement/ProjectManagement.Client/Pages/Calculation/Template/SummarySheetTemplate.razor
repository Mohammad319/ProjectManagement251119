@using Microsoft.Extensions.Localization
@using ProjectManagement.Client.Shared.MVVM.Calculation
@using ProjectManagement.Client.Shared.Model.Project.Calculation
@using ProjectManagement.Shared.DTO.Calculation.Template
@inherits AppComponentBase

@inject IStringLocalizer<ResourceLoc> Localizer
@inject IStringLocalizer<CalcResource> CalcLoc

@if (Temp != null)
{
    <style>
        #summarySheet table {
            border-top: 1px @Temp.SummarySheet.Color.BorderStyle @Temp.SummarySheet.Color.Border;
            border-left: 1px @Temp.SummarySheet.Color.BorderStyle @Temp.SummarySheet.Color.Border;
            border-collapse: collapse;
        }

        #summarySheet td,
        #summarySheet th {
            border-right: 1px @Temp.SummarySheet.Color.BorderStyle @Temp.SummarySheet.Color.Border;
        }

        #summarySheet tr {
            border-bottom: 1px @Temp.SummarySheet.Color.BorderStyle @Temp.SummarySheet.Color.Border;
        }
    </style>

    <div id="summarySheet" class="rounded-2xl border border-slate-200 bg-white p-4 text-xs shadow-sm dark:border-slate-700 dark:bg-slate-900 md:text-sm">
        <div class="flex flex-col gap-2 border-b border-slate-200 pb-4 dark:border-slate-700 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <h3 class="text-sm font-semibold text-slate-800 dark:text-slate-100">
                    .summarySheet
                </h3>
                <p class="mt-1 text-[11px] text-slate-500 dark:text-slate-400">
                    Layout / Design
                </p>
            </div>

            <span class="text-[11px] text-slate-500 dark:text-slate-400">
                @Localizer["preview"]
            </span>
        </div>

        <div class="mt-4 grid gap-5 xl:grid-cols-[minmax(0,1fr)_320px]">
            <div class="min-w-0 space-y-4">
                <div>
                    <div class="mb-2 text-[11px] font-medium text-slate-500 dark:text-slate-400">
                        .columnsWidth
                    </div>

                    <div class="overflow-x-auto rounded-xl border border-slate-200 bg-slate-50/60 dark:border-slate-700 dark:bg-slate-900/60">
                        <table class="min-w-max text-[11px]">
                            <thead class="bg-slate-100 dark:bg-slate-800/80">
                                <tr>
                                    @foreach (var item in Temp.SummarySheet.Columns)
                                    {
                                        <th class="whitespace-nowrap px-2 py-1.5 text-left font-semibold">
                                            @CalcLoc[NetColumnLoc.SummaryKey[item.Id]]
                                        </th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="bg-white dark:bg-slate-900/80">
                                    @foreach (var item in Temp.SummarySheet.Columns)
                                    {
                                        <td class="px-2 py-1.5">
                                            <div class="flex items-center gap-1">
                                                <input type="number"
                                                       class="w-16 rounded border border-slate-300 bg-white px-1 py-0 text-right text-[11px] focus:outline-none focus:ring-1 focus:ring-blue-400 dark:border-slate-600 dark:bg-slate-900"
                                                       @bind="item.Width" />
                                                <span class="text-[10px] text-slate-400">px</span>
                                            </div>
                                        </td>
                                    }
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="rounded-xl border border-dashed border-slate-200 p-3 dark:border-slate-700">
                    <div class="mb-2 flex items-center justify-between gap-2">
                        <span class="text-[11px] font-medium text-slate-700 dark:text-slate-200">
                            Preview
                        </span>
                        <span class="text-[10px] text-slate-500 dark:text-slate-400">
                            .summarySheet
                        </span>
                    </div>

                    <div class="overflow-x-auto rounded bg-slate-50/70 p-2 dark:bg-slate-900/70">
                        <table class="min-w-max text-[11px]" style="color:@Temp.SummarySheet.Color.Text;">
                            <colgroup>
                                @foreach (var item in Temp.SummarySheet.Columns)
                                {
                                    <col style="width:@(item.Width + "px")" />
                                }
                            </colgroup>
                            <thead style="background-color:@Temp.SummarySheet.Color.Header;">
                                <tr>
                                    @foreach (var item in Temp.SummarySheet.Columns)
                                    {
                                        <th class="whitespace-nowrap px-2 py-1 text-left font-semibold">
                                            @CalcLoc[NetColumnLoc.SummaryKey[item.Id]]
                                        </th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                <tr style="background-color:@Temp.SummarySheet.Color.Factor;">
                                    @foreach (var item in Temp.SummarySheet.Columns)
                                    {
                                        <td class="whitespace-nowrap px-2 py-1">
                                            @GetPreviewCellContent(item.Id, isSumRow: false)
                                        </td>
                                    }
                                </tr>

                                <tr style="background-color:@Temp.SummarySheet.Color.Sum; font-weight:600;">
                                    @foreach (var item in Temp.SummarySheet.Columns)
                                    {
                                        <td class="whitespace-nowrap px-2 py-1">
                                            @GetPreviewCellContent(item.Id, isSumRow: true)
                                        </td>
                                    }
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="space-y-3">
                <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-3 dark:border-slate-700 dark:bg-slate-800/40">
                    <label class="mb-1 block text-[11px] font-medium text-slate-700 dark:text-slate-200">
                        @AppFormatResource.borderType
                    </label>
                    <select @bind="Temp.SummarySheet.Color.BorderStyle"
                            class="w-full rounded-lg border border-slate-300 bg-white px-2 py-2 text-[11px] text-slate-900 focus:outline-none focus:ring-1 focus:ring-blue-400 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100">
                        @foreach (var item in TemplateConst.BorderStyles)
                        {
                            <option value="@item">@Localizer[item]</option>
                        }
                    </select>
                </div>

                <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-1">
                    <div class="@ColorRowClass">
                        <label class="@ColorLabelClass">@AppFormatResource.bolder</label>
                        <div class="flex items-center gap-2">
                            <input type="color" class="@ColorInputClass" @bind="Temp.SummarySheet.Color.Border" />
                            <span class="truncate text-[11px] text-slate-500 dark:text-slate-400">@Temp.SummarySheet.Color.Border</span>
                        </div>
                    </div>

                    <div class="@ColorRowClass">
                        <label class="@ColorLabelClass">@AppFormatResource.font</label>
                        <div class="flex items-center gap-2">
                            <input type="color" class="@ColorInputClass" @bind="Temp.SummarySheet.Color.Text" />
                            <span class="truncate text-[11px] text-slate-500 dark:text-slate-400">@Temp.SummarySheet.Color.Text</span>
                        </div>
                    </div>

                    <div class="@ColorRowClass">
                        <label class="@ColorLabelClass">@ResourceApp.header</label>
                        <div class="flex items-center gap-2">
                            <input type="color" class="@ColorInputClass" @bind="Temp.SummarySheet.Color.Header" />
                            <span class="truncate text-[11px] text-slate-500 dark:text-slate-400">@Temp.SummarySheet.Color.Header</span>
                        </div>
                    </div>

                    <div class="@ColorRowClass">
                        <label class="@ColorLabelClass">@CalcResource.factor</label>
                        <div class="flex items-center gap-2">
                            <input type="color" class="@ColorInputClass" @bind="Temp.SummarySheet.Color.Factor" />
                            <span class="truncate text-[11px] text-slate-500 dark:text-slate-400">@Temp.SummarySheet.Color.Factor</span>
                        </div>
                    </div>

                    <div class="@ColorRowClass">
                        <label class="@ColorLabelClass">@CalcResource.sum</label>
                        <div class="flex items-center gap-2">
                            <input type="color" class="@ColorInputClass" @bind="Temp.SummarySheet.Color.Sum" />
                            <span class="truncate text-[11px] text-slate-500 dark:text-slate-400">@Temp.SummarySheet.Color.Sum</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private const string ColorRowClass =
        "rounded-xl border border-slate-200 bg-slate-50/70 p-3 dark:border-slate-700 dark:bg-slate-800/40";

    private const string ColorLabelClass =
        "mb-1 block text-[11px] font-medium text-slate-700 dark:text-slate-200";

    private const string ColorInputClass =
        "h-8 w-12 rounded border border-slate-300 bg-transparent p-0.5 dark:border-slate-600";

    [Parameter] public TemplateListPostDTO Temp { get; set; } = new TemplateListPostDTO();

    private string GetPreviewCellContent(SummarySheetColumnId titleKey, bool isSumRow)
    {
        var title = NetColumnLoc.SummaryKey[titleKey];

        if (isSumRow)
        {
            if (title.Contains("Name", StringComparison.OrdinalIgnoreCase))
                return $"{title} (Total)";
            if (title.Contains("Cost", StringComparison.OrdinalIgnoreCase))
                return "123 456.00";
            if (title.Contains("Factor", StringComparison.OrdinalIgnoreCase))
                return "1.23";

            return "…";
        }

        if (title.Contains("Name", StringComparison.OrdinalIgnoreCase))
            return $"{title} A";
        if (title.Contains("Cost", StringComparison.OrdinalIgnoreCase))
            return "12 345.00";
        if (title.Contains("Factor", StringComparison.OrdinalIgnoreCase))
            return "1.10";

        return "Sample";
    }
}