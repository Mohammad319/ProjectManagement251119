@using ProjectManagement.Client.Constant
@using ProjectManagement.Client.Services.Calculation
@using ProjectManagement.Client.Shared.MVVM.Calculation
@using ProjectManagement.Client.Shared.Model.Project.Calculation
@using ProjectManagement.Shared.DTO.Calculation.Template
@using ProjectManagement.Shared.DTO.Identity
@using System.Security.Claims
@inherits AppComponentBase

@if (TemplateUpdate != null)
{
    <section class="mx-auto max-w-[1600px] space-y-5">
        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
            <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
                <div class="min-w-0">
                    <div class="flex flex-wrap items-center gap-2">
                        <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">
                            @ResourceLoc.templates
                        </h2>

                        <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-medium text-slate-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300">
                            @CalcResource.name
                        </span>
                    </div>

                    <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
                        @AppLoc["templateDetailsDescription"]
                    </p>
                </div>

                <div class="flex flex-wrap items-center gap-2">
                    <button type="submit"
                            form="netTable"
                            disabled="@btnSubmitDisabled"
                            class="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-600 px-4 py-2 text-sm font-medium text-white shadow-sm transition hover:bg-emerald-700 disabled:cursor-not-allowed disabled:opacity-50">
                        @if (btnSubmitDisabled)
                        {
                            <span class="h-4 w-4 animate-spin rounded-full border-2 border-white/40 border-t-white"></span>
                        }
                        <span>@ResourceApp.save</span>
                    </button>

                    <button type="button"
                            @onclick="async () => await Callback.InvokeAsync(false)"
                            class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-600 dark:bg-slate-950 dark:text-slate-200 dark:hover:bg-slate-800">
                        <span aria-hidden="true">@((MarkupString)Icons.Back)</span>
                        <span>@AppLoc["back"]</span>
                    </button>
                </div>
            </div>
        </div>

        <EditForm Model="@TemplateUpdate" id="netTable" OnValidSubmit="HandleSubmitAsync">
            <DataAnnotationsValidator />

            <fieldset disabled="@btnSubmitDisabled" class="grid gap-5 xl:grid-cols-[320px_minmax(0,1fr)]">
                <div class="min-w-0">
                    <div class="sticky top-4 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
                        <div class="mb-4">
                            <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">
                                @AppLoc["templateSettings"]
                            </h3>
                            <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
                                @AppLoc["templateSettingsDescription"]
                            </p>
                        </div>

                        <div class="space-y-4">
                            <div>
                                <label class="mb-1.5 block text-sm font-medium text-slate-700 dark:text-slate-200">
                                    @CalcResource.name
                                </label>
                                <InputText @bind-Value="TemplateUpdate.Name"
                                           class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-500/20 dark:border-slate-600 dark:bg-slate-950 dark:text-slate-100" />
                                <ValidationMessage For="@(() => TemplateUpdate.Name)" class="mt-1 block text-xs text-rose-500" />
                            </div>

                            <div>
                                <label class="mb-1.5 block text-sm font-medium text-slate-700 dark:text-slate-200">
                                    @ResourceApp.date
                                </label>
                                <InputSelect @bind-Value="TemplateUpdate.DateFormat"
                                             class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-500/20 dark:border-slate-600 dark:bg-slate-950 dark:text-slate-100">
                                    <option value="dd.MM.yyyy">dd.MM.yyyy</option>
                                    <option value="dd/MM/yyyy">dd/MM/yyyy</option>
                                    <option value="dd-MM-yyyy">dd-MM-yyyy</option>
                                    <option value="dd MM yyyy">dd MM yyyy</option>
                                    <option value="yyyy.MM.dd">yyyy.MM.dd</option>
                                    <option value="yyyy/MM/dd">yyyy/MM/dd</option>
                                    <option value="yyyy-MM-dd">yyyy-MM-dd</option>
                                    <option value="yyyy MM dd">yyyy MM dd</option>
                                </InputSelect>
                            </div>

                            <div>
                                <label class="mb-1.5 block text-sm font-medium text-slate-700 dark:text-slate-200">
                                    @AppLoc["numberFormat"]
                                </label>
                                <InputSelect @bind-Value="TemplateUpdate.MathRound"
                                             class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-500/20 dark:border-slate-600 dark:bg-slate-950 dark:text-slate-100">
                                    <option value="0">0</option>
                                    <option value="1">0.0</option>
                                    <option value="2">0.00</option>
                                    <option value="3">0.000</option>
                                    <option value="4">0.0000</option>
                                    <option value="5">0.00000</option>
                                </InputSelect>
                            </div>

                            <div>
                                <label class="mb-1.5 block text-sm font-medium text-slate-700 dark:text-slate-200">
                                    @CalcResource.Currency
                                </label>
                                <InputText @bind-Value="TemplateUpdate.Currency"
                                           class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-500/20 dark:border-slate-600 dark:bg-slate-950 dark:text-slate-100" />
                                <ValidationMessage For="@(() => TemplateUpdate.Currency)" class="mt-1 block text-xs text-rose-500" />
                            </div>
                        </div>

                        <div class="mt-5 border-t border-slate-200 pt-4 dark:border-slate-700">
                            <div class="grid grid-cols-2 gap-2 text-xs">
                                <div class="rounded-xl bg-slate-50 px-3 py-2 dark:bg-slate-800/70">
                                    <div class="text-slate-500 dark:text-slate-400">@ResourceApp.date</div>
                                    <div class="mt-1 truncate font-medium text-slate-900 dark:text-slate-100">
                                        @(string.IsNullOrWhiteSpace(TemplateUpdate.DateFormat) ? "-" : TemplateUpdate.DateFormat)
                                    </div>
                                </div>

                                <div class="rounded-xl bg-slate-50 px-3 py-2 dark:bg-slate-800/70">
                                    <div class="text-slate-500 dark:text-slate-400">@AppLoc["round"]</div>
                                    <div class="mt-1 font-medium text-slate-900 dark:text-slate-100">
                                        @TemplateUpdate.MathRound
                                    </div>
                                </div>

                                <div class="col-span-2 rounded-xl bg-slate-50 px-3 py-2 dark:bg-slate-800/70">
                                    <div class="text-slate-500 dark:text-slate-400">@CalcResource.Currency</div>
                                    <div class="mt-1 truncate font-medium text-slate-900 dark:text-slate-100">
                                        @(string.IsNullOrWhiteSpace(TemplateUpdate.Currency) ? "-" : TemplateUpdate.Currency)
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="min-w-0 space-y-5">
                    <NelCalculationTemplate2 Temp="TemplateUpdate" />
                    <SummarySheetTemplate Temp="TemplateUpdate" />
                </div>
            </fieldset>
        </EditForm>
    </section>
}

@code {
    TemplateListPostDTO TemplateUpdate = new();

    [Parameter] public TemplateMVVM TempForm { get; set; } = default!;
    [Parameter] public EventCallback<bool> Callback { get; set; }

    bool btnSubmitDisabled = false;

    protected override void OnInitialized()
    {
        TempForm.CopyPropertiesTo(TemplateUpdate);
    }

    async Task HandleSubmitAsync()
    {
        if (btnSubmitDisabled)
            return;

        bool refresh = false;
        btnSubmitDisabled = true;

        try
        {
            if (TempForm.Id > 0)
            {
                refresh = await Repo.Template.UpdateAsync(TemplateUpdate, TempForm.Id);
                CalcService.RequestGridRefresh(CalculationGridRefreshKind.View);
            }
            else if (await Repo.Template.CreateAsync(TemplateUpdate) != null)
            {
                refresh = true;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            btnSubmitDisabled = false;
        }

        await Callback.InvokeAsync(refresh);
    }
}
