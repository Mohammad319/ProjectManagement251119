@using BlazorMHD.UI.Core.Services
@using Microsoft.AspNetCore.Components.Authorization
@using ProjectManagement.Client.Services.Calculation
@using ProjectManagement.Client.Shared.MVVM.Calculation
@using ProjectManagement.Shared.DTO.Calculation.Template
@inherits AppComponentBase
@inject DialogService dialogService
@inject AuthenticationStateProvider AuthStateProvider

@if (Form != null)
{
    <section class="space-y-1">
        @RenderForm()

        @if (Calc.TemplateId > 0)
        {
                <div class="flex flex-wrap items-center justify-end gap-1">
                    <button type="button"
                            @onclick="HandleSubmitAsync"
                            class="inline-flex items-center justify-center rounded-xl bg-emerald-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-emerald-700 disabled:cursor-not-allowed disabled:opacity-50"
                            form="netTable"
                            disabled="@btnSubmitDisabled">
                        @ResourceApp.save
                    </button>
                    <button type="button"
                            @onclick="() => Form = null"
                            class="inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-950 dark:text-slate-200 dark:hover:bg-slate-800">
                        @ResourceLoc.templates
                    </button>
                </div>
        }
    </section>
}
else
{
    <div class="mt-2 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">
        <table class="min-w-full border-collapse text-xs">
            <thead class="bg-slate-50 dark:bg-slate-800/70">
                <tr class="border-b border-slate-200 dark:border-slate-700">
                    <th class="w-[160px] px-3 py-2 text-start text-[11px] font-semibold uppercase tracking-wide text-slate-600 dark:text-slate-300">
                        Action
                    </th>
                    <th class="px-3 py-2 text-start text-[11px] font-semibold uppercase tracking-wide text-slate-600 dark:text-slate-300">
                        Template
                    </th>
                </tr>
            </thead>

            <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                <tr class="transition-colors hover:bg-slate-50 dark:hover:bg-slate-800/70">
                    <td class="w-[200px] px-3 py-2">
                        <button disabled="@(Calc.TemplateId == 0 || Calc.TemplateId == null || Loading)"
                                @onclick="async () => await SetDefaultAsync(new TemplateMVVM())"
                                class="inline-flex items-center gap-1 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-[11px] font-medium text-slate-700 transition hover:bg-slate-50 hover:text-slate-900 disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800 dark:hover:text-white">
                            @ResourceApp.setAsDefault
                        </button>
                    </td>

                    <td class="px-3 py-2 text-[11px] font-medium text-slate-800 dark:text-slate-100">
                        <div class="flex items-center gap-2">
                            <span>@ResourceApp._default</span>

                            @if (Calc.TemplateId == 0 || Calc.TemplateId == null)
                            {
                                <span class="inline-flex items-center rounded-full bg-emerald-100 px-2 py-0.5 text-[10px] font-semibold text-emerald-700 dark:bg-emerald-900 dark:text-emerald-200">
                                    @ResourceApp._default
                                </span>
                            }
                        </div>
                    </td>
                </tr>

                @if (List != null)
                {
                    foreach (var item in List)
                    {
                        var isCurrent = Calc.TemplateId == item.Id;

                        <tr class="transition-colors hover:bg-slate-50 dark:hover:bg-slate-800/70">
                            <td class="w-[200px] px-3 py-2">
                                <button disabled="@(isCurrent || Loading)"
                                        @onclick="async () => await SetDefaultAsync(item)"
                                        class="inline-flex items-center gap-1 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-[11px] font-medium text-slate-700 transition hover:bg-slate-50 hover:text-slate-900 disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800 dark:hover:text-white">
                                    @ResourceApp.setAsDefault
                                </button>
                            </td>

                            <td class="px-3 py-2 text-[11px] font-medium text-slate-800 dark:text-slate-100">
                                <div class="flex items-center gap-2">
                                    <span>@item.Name</span>

                                    @if (isCurrent)
                                    {
                                        <span class="inline-flex items-center rounded-full bg-emerald-100 px-2 py-0.5 text-[10px] font-semibold text-emerald-700 dark:bg-emerald-900 dark:text-emerald-200">
                                            @ResourceApp._default
                                        </span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

}
@code {
    [Parameter] public int Tab { get; set; } = 0;
    TemplateListPostDTO? Form;
    void CallBack(bool refrsh)
    {
        Refresh();
        Form = null;
    }

    RenderFragment RenderForm() => __builder =>
    {
        if (Form is null) return;
        if (Tab == 1)
            __builder.AddContent(0, (RenderFragment)(b => b.AddContent(0, @<NelCalculationTemplate2 Temp="Form" ShowColumnSettings="false" />)));
        else if (Tab == 3)
            __builder.AddContent(1, @<SummarySheetTemplate Temp="Form" />);
    };

    List<TemplateMVVM> List = [];
    bool btnSubmitDisabled = false;
    bool Loading = true;

    async Task<int?> GetUserDepartmentIdAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var claim = authState.User.Claims.FirstOrDefault(x => x.Type == PMClaimsConst.DepartmentId);

        if (claim == null || !int.TryParse(claim.Value, out int departmentId) || departmentId <= 0)
            return null;

        return departmentId;
    }

    void Refresh() => CalcService.RequestGridRefresh(CalculationGridRefreshKind.View);

    protected async override Task OnInitializedAsync()
    {
        Console.WriteLine("TemplateSetDefaultUI OnInitializedAsync");

        List = await Repo.Template.GetAsync() ?? [];
        if ((List == null || !List.Any()))
        {
            MHD.MessageOk(ResourceApp.thereIsNoElements, ResourceApp.thereIsNoElements);
        }
        else if (Calc.TemplateId > 0)
        {
            int? userDepartmentId = await GetUserDepartmentIdAsync();
            Console.WriteLine(userDepartmentId + "--" + Calc.Template?.DepartmentId);
            if (Calc.Template?.DepartmentId == userDepartmentId)
            {
                TemplateListPostDTO zzz = new();
                Calc.Template.CopyPropertiesTo(zzz);
                Form = zzz;
            }
        }
        Loading = false;
    }

    async Task SetDefaultAsync(TemplateMVVM newTemplate)
    {
        var tempNew = await Repo.Template.SetDefaultAsync(Calc.Id, newTemplate.Id);
        Calc.Template = tempNew != null ? tempNew : new TemplateMVVM();
        Calc.TemplateId = newTemplate.Id;
        Refresh();
        Modal.Close();
    }

    async Task HandleSubmitAsync()
    {
        btnSubmitDisabled = true;
        try
        {
            if (Form is not null && Calc.TemplateId.HasValue && await Repo.Template.UpdateAsync(Form, Calc.TemplateId.Value))
                Form.CopyPropertiesTo(Calc.Template);

            Refresh();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }

        dialogService.Close();
    }
}
