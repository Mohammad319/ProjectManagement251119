@using Microsoft.Extensions.Localization
@using ProjectManagement.Client.Shared.MVVM.Calculation
@using ProjectManagement.Client.Shared.SharedComponent
@using ProjectManagement.Shared.Constants
@using ProjectManagement.Shared.DTO.Calculation.Template
@inherits AppComponentBase

@inject IStringLocalizer<ResourceLoc> Localizer
@inject IStringLocalizer<CalcResource> CalcLoc

@if (Temp != null)
{
    <style>
        #netTable table {
            border-top: 1px @Temp.NetCalc.Color.Border @Temp.NetCalc.Color.Text;
            border-left: 1px @Temp.NetCalc.Color.Border @Temp.NetCalc.Color.Text;
            border-collapse: collapse;
        }

        #netTable td,
        #netTable th {
            border-right: 1px @Temp.NetCalc.Color.Border @Temp.NetCalc.Color.Text;
        }

        #netTable tr {
            border-bottom: 1px @Temp.NetCalc.Color.Border @Temp.NetCalc.Color.Text;
        }

        #netTable button:disabled {
            opacity: .35;
            cursor: not-allowed;
        }

        .dragHint {
            cursor: grab;
            opacity: .5;
            user-select: none;
        }

        tr[draggable="true"] .dragHint:active {
            cursor: grabbing;
        }
    </style>

    <form id="netTable"
          class="pr-2 flex flex-col gap-4 md:flex-row md:items-start md:justify-between">

        <!-- Visible Columns -->
        <div class="flex-[6] min-w-[400px] max-w-none max-h-[60vh] overflow-y-auto overflow-x-auto
                bg-white dark:bg-slate-900/60
                border border-slate-200 dark:border-slate-700
                rounded-lg shadow-sm p-2">

            <table class="w-full table-fixed text-xs">
                <colgroup>
                    <col style="width:35px;" />
                    <col style="width:250px;" />
                    <col style="width:200px;" />
                </colgroup>
                <thead>
                    <tr>
                        <td colspan="3"
                            class="bg-slate-100 dark:bg-slate-800 text-[11px] font-semibold text-slate-800 dark:text-slate-100">
                            @ResourceApp.visibleItems
                        </td>
                    </tr>
                    <tr class="bg-slate-50 dark:bg-slate-900/60 text-[11px] text-slate-700 dark:text-slate-200">
                        <td class="text-center">#</td>
                        <th class="text-start font-medium">Name</th>
                        <td class="text-center">Settings</td>
                    </tr>
                </thead>

                <!-- ✅ سحب وإفلات -->
                <DragReorderTBody TItem="NetColumnState"
                                  Items="Temp.NetCalc.Columns"
                                  RowClass="hover:bg-slate-50 dark:hover:bg-slate-800/60 transition-colors">

                    <RowTemplate Context="col">
                        @{
                            var row = Temp.NetCalc.Columns.IndexOf(col);
                            var isFirst = row <= 0;
                            var isLast = row >= Temp.NetCalc.Columns.Count - 1;

                            var title = CalcLoc[NetColumnLoc.Key[col.Id]];
                        }

                        <!-- # + drag -->
                        <td class="text-center align-middle">
                            <span class="dragHint mr-1">⋮⋮</span>
                            @(row + 1)
                        </td>

                        <!-- Name (fixed 300px + truncate + fixed buttons) -->
                        <td class="align-middle">
                            <div class="flex items-center gap-2">

                                <!-- Left buttons (fixed) -->
                                <div class="flex items-center gap-1 shrink-0">
                                    <button type="button"
                                            class="@IconButtonSecondaryClass"
                                            disabled="@isFirst"
                                            title="Move to top"
                                            @onclick="() => MoveToTop(col)">
                                        ⇈
                                    </button>

                                    <button type="button"
                                            class="@IconButtonSecondaryClass"
                                            disabled="@isFirst"
                                            title="Move up"
                                            @onclick="() => MoveUp(col)">
                                        ▲
                                    </button>
                                </div>

                                <!-- Text area (flexible, truncates) -->
                                <div class="flex-1 min-w-0">
                                    <span class="block truncate font-medium" title="@title">
                                        @title
                                    </span>
                                </div>

                                <!-- Right buttons (fixed) -->
                                <div class="flex items-center gap-1 shrink-0">
                                    <button type="button"
                                            class="@IconButtonSecondaryClass"
                                            disabled="@isLast"
                                            title="Move down"
                                            @onclick="() => MoveDown(col)">
                                        ▼
                                    </button>

                                    <button type="button"
                                            class="@IconButtonSecondaryClass"
                                            disabled="@isLast"
                                            title="Move to bottom"
                                            @onclick="() => MoveToBottom(col)">
                                        ⇊
                                    </button>
                                </div>

                            </div>
                        </td>
                        <td class="align-middle">
                            <div class="flex items-center justify-center gap-1 whitespace-nowrap">

                                <!-- Width -->
                                <input class="border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white w-[50px] text-center"
                                       type="number"
                                       title="Width"
                                       @bind="col.Width" />

                                <!-- Freeze -->
                                <button type="button"
                                        class="@IconButtonDangerClass"
                                        title="Freeze column"
                                        @onclick="() => col.Frozen = !col.Frozen">
                                    @(col.Frozen ? "📍" : "📌")
                                </button>

                                <!-- Hide -->
                                <button type="button"
                                        class="@IconButtonPrimaryClass"
                                        title="Hide column"
                                        @onclick="async () => await RemoveAsync(col)">
                                    <span>@((MarkupString)Icons.ChevronRight)</span>
                                </button>

                            </div>
                        </td>
                    </RowTemplate>

                </DragReorderTBody>
            </table>
        </div>
        <!-- Hidden Columns -->
        <div class="flex-[4] min-w-[200px] max-w-none max-h-[60vh] overflow-auto
                bg-white dark:bg-slate-900/60
                border border-slate-200 dark:border-slate-700
                rounded-lg shadow-sm p-2">

            <table class="w-full text-xs">
                <thead>
                    <tr>
                        <td colspan="2"
                            class="bg-slate-100 dark:bg-slate-800 text-[11px] font-semibold text-slate-800 dark:text-slate-100">
                            @ResourceApp.hiddenItems
                        </td>
                    </tr>
                    <tr class="bg-slate-50 dark:bg-slate-900/60 text-[11px] text-slate-700 dark:text-slate-200">
                        <th class="w-[50px] text-center"></th>
                        <th class="w-[260px] text-start font-medium">Name</th>
                    </tr>
                </thead>

                <tbody>
                    @if (TableVisible)
                    {
                        @foreach (var id in HiddenIds)
                        {
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/60 transition-colors">
                                <td class="text-center align-middle">
                                    <button type="button"
                                            class="@IconButtonPrimaryClass"
                                            title="Show column"
                                            @onclick="async () => await AddAsync(id)">
                                        <span>@((MarkupString)Icons.ChevronLeft)</span>
                                    </button>
                                </td>
                                <td class="align-middle">
                                    @CalcLoc[NetColumnLoc.Key[id]]
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Settings -->
        <div class="flex-[3] min-w-[210px] max-w-none max-h-[60vh] overflow-auto
                bg-white dark:bg-slate-900/60
                border border-slate-200 dark:border-slate-700
                rounded-lg shadow-sm p-3">

            <table class="w-full text-xs">
                <tbody class="align-middle">
                    <tr>
                        <td class="py-1 pr-2 align-middle">@AppFormatResource.borderType</td>
                        <td class="py-1 align-middle">
                            <select @bind="Temp.NetCalc.Color.BorderStyle"
                                    class="@SelectInputClass">
                                @foreach (var item in TemplateConst.BorderStyles)
                                {
                                    <option value="@item">@item</option>
                                }
                            </select>
                        </td>
                    </tr>

                    <tr>
                        <td class="py-1 pr-2 align-middle">@AppFormatResource.bolder</td>
                        <td class="py-1 align-middle">
                            <input type="color"
                                   class="h-7 w-16 rounded border border-slate-300 dark:border-slate-600 bg-transparent"
                                   @bind="Temp.NetCalc.Color.Border" />
                        </td>
                    </tr>

                    <tr>
                        <td class="py-1 pr-2 align-middle">@AppFormatResource.font</td>
                        <td class="py-1 align-middle">
                            <input type="color"
                                   class="h-7 w-16 rounded border border-slate-300 dark:border-slate-600 bg-transparent"
                                   @bind="Temp.NetCalc.Color.Text" />
                        </td>
                    </tr>

                    <tr>
                        <td class="py-1 pr-2 align-middle">@ResourceApp.header</td>
                        <td class="py-1 align-middle">
                            <input type="color"
                                   class="h-7 w-16 rounded border border-slate-300 dark:border-slate-600 bg-transparent"
                                   @bind="Temp.NetCalc.Color.Header" />
                        </td>
                    </tr>

                    <tr>
                        <td class="py-1 pr-2 align-middle">@ResourceLoc.task</td>
                        <td class="py-1 align-middle">
                            <input type="color"
                                   class="h-7 w-16 rounded border border-slate-300 dark:border-slate-600 bg-transparent"
                                   @bind="Temp.NetCalc.Color.Task" />
                        </td>
                    </tr>

                    <tr>
                        <td class="py-1 pr-2 align-middle">@ResourceLoc.SubTask</td>
                        <td class="py-1 align-middle">
                            <input type="color"
                                   class="h-7 w-16 rounded border border-slate-300 dark:border-slate-600 bg-transparent"
                                   @bind="Temp.NetCalc.Color.SubTask" />
                        </td>
                    </tr>

                    <tr>
                        <td class="py-1 pr-2 align-middle">@ResourceLoc.resource</td>
                        <td class="py-1 align-middle">
                            <input type="color"
                                   class="h-7 w-16 rounded border border-slate-300 dark:border-slate-600 bg-transparent"
                                   @bind="Temp.NetCalc.Color.Resource" />
                        </td>
                    </tr>

                    <tr>
                        <td class="py-1 pr-2 align-middle">@CalcResource.note</td>
                        <td class="py-1 align-middle">
                            <input type="color"
                                   class="h-7 w-16 rounded border border-slate-300 dark:border-slate-600 bg-transparent"
                                   @bind="Temp.NetCalc.Color.Note" />
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </form>
}

@code {
    private const string IconButtonBaseClass =
        "inline-flex items-center justify-center w-7 h-7 rounded-full border text-[11px] " +
        "transition-all duration-150 hover:scale-105 active:scale-95";

    private const string IconButtonSecondaryClass =
        IconButtonBaseClass + " border-gray-300 text-gray-600 " +
        "hover:bg-gray-100 hover:ring-1 hover:ring-gray-300 " +
        "dark:border-gray-500 dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:ring-gray-500 " +
        "!px-1 !py-0.5 text-[11px]";

    private const string IconButtonPrimaryClass =
        IconButtonBaseClass + " border-blue-300 text-blue-600 " +
        "hover:bg-blue-100 hover:ring-1 hover:ring-blue-300 " +
        "dark:border-blue-400 dark:text-blue-300 dark:hover:bg-blue-900/40 dark:hover:ring-blue-500 " +
        "!px-2 !py-1 text-[11px]";

    private const string IconButtonDangerClass =
        IconButtonBaseClass + " border-red-300 text-red-600 " +
        "hover:bg-red-100 hover:ring-1 hover:ring-red-300 " +
        "dark:border-red-400 dark:text-red-300 dark:hover:bg-red-900/40 dark:hover:ring-red-500 " +
        "!px-2 !py-1 text-[11px]";

    private const string SelectInputClass =
        "w-full border border-gray-300 rounded px-2 py-1 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 " +
        "dark:bg-gray-800 dark:text-white dark:border-gray-600 text-[11px]";

    [Parameter] public TemplateListPostDTO Temp { get; set; } = new();

    private bool TableVisible = true;

    private static readonly IReadOnlyDictionary<NetColumnId, NetColumnState> _defaults =
        TemplateDefaults.NetCalc().ToDictionary(x => x.Id, x => x);

    private IEnumerable<NetColumnId> HiddenIds =>
        Enum.GetValues<NetColumnId>()
            .Where(id => !Temp.NetCalc.Columns.Any(c => c.Id == id));

    private async Task AddAsync(NetColumnId id)
    {
        TableVisible = false;
        await Task.Delay(1);

        if (_defaults.TryGetValue(id, out var def))
        {
            Temp.NetCalc.Columns.Add(new NetColumnState
            {
                Id = def.Id,
                Width = def.Width,
                Frozen = def.Frozen
            });
        }
        else
        {
            Temp.NetCalc.Columns.Add(new NetColumnState { Id = id, Width = 80, Frozen = false });
        }

        TableVisible = true;
    }

    private async Task RemoveAsync(NetColumnState col)
    {
        TableVisible = false;
        await Task.Delay(1);

        if (col != null)
        {
            col.Frozen = false;
            Temp.NetCalc.Columns.Remove(col);
        }

        await Task.Delay(1);
        TableVisible = true;
    }

    // ===== safe move (no index errors) =====
    private void MoveUp(NetColumnState col)
    {
        var list = Temp.NetCalc.Columns;
        var index = list.IndexOf(col);
        if (index <= 0) return;
        list.RemoveAt(index);
        list.Insert(index - 1, col);
    }

    private void MoveDown(NetColumnState col)
    {
        var list = Temp.NetCalc.Columns;
        var index = list.IndexOf(col);
        if (index < 0 || index >= list.Count - 1) return;
        list.RemoveAt(index);
        list.Insert(index + 1, col);
    }

    private void MoveToTop(NetColumnState col)
    {
        var list = Temp.NetCalc.Columns;
        var index = list.IndexOf(col);
        if (index <= 0) return;
        list.RemoveAt(index);
        list.Insert(0, col);
    }

    private void MoveToBottom(NetColumnState col)
    {
        var list = Temp.NetCalc.Columns;
        var index = list.IndexOf(col);
        if (index < 0 || index >= list.Count - 1) return;
        list.RemoveAt(index);
        list.Add(col);
    }
}
