@using Microsoft.Extensions.Localization
@using ProjectManagement.Client.Shared.MVVM.Calculation
@using ProjectManagement.Client.Shared.SharedComponent
@using ProjectManagement.Shared.Constant
@using ProjectManagement.Shared.Constants
@using ProjectManagement.Shared.DTO.Calculation.Template
@inherits AppComponentBase

@inject IStringLocalizer<CalcResource> CalcLoc

@if (Temp != null)
{
    <style>
        .net-template-table {
            border-top: 1px @Temp.NetCalc.Color.BorderStyle @Temp.NetCalc.Color.Border;
            border-left: 1px @Temp.NetCalc.Color.BorderStyle @Temp.NetCalc.Color.Border;
            border-collapse: collapse;
        }

            .net-template-table td,
            .net-template-table th {
                border-right: 1px @Temp.NetCalc.Color.BorderStyle @Temp.NetCalc.Color.Border;
            }

            .net-template-table tr {
                border-bottom: 1px @Temp.NetCalc.Color.BorderStyle @Temp.NetCalc.Color.Border;
            }

            .net-template-table button:disabled {
                opacity: .35;
                cursor: not-allowed;
            }

        .dragHint {
            cursor: grab;
            opacity: .55;
            user-select: none;
        }

        tr[draggable="true"] .dragHint:active {
            cursor: grabbing;
        }
    </style>

    <div class="overflow-x-auto">
        <div class="flex min-w-[1240px] items-start gap-1">
            <section class="w-[480px] flex-none overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">
                <div class="border-b border-slate-200 px-3 py-1 dark:border-slate-700">
                    <div class="flex items-center justify-between gap-3">
                        <div>
                            <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">
                                @ResourceApp.visibleItems
                            </h3>
                            <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
                                @AppLoc["visibleColumnsCount", Temp.NetCalc.Columns.Count]
                            </p>
                        </div>

                        <div class="rounded-full bg-slate-100 px-2.5 py-1 text-[11px] font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-300">
                            @AppLoc["dragAndReorder"]
                        </div>
                    </div>
                </div>

                <div class="max-h-[65vh] overflow-auto">
                    <table class="net-template-table min-w-[460px] table-fixed text-[12px]">
                        <colgroup>
                            <col style="width:35px;" />
                            <col style="width:280px;" />
                            <col style="width:145px;" />
                        </colgroup>

                        <thead class="sticky top-0 z-10">
                            <tr class="bg-slate-100 text-[11px] font-semibold text-slate-800 dark:bg-slate-800 dark:text-slate-100">
                                <th class="px-1 py-0.5 text-center">#</th>
                                <th class="px-1 py-0.5text-start">@CalcResource.name</th>
                                <th class="px-1 py-0.5 text-center">@AppLoc["settings"]</th>
                            </tr>
                        </thead>

                        <DragReorderTBody TItem="NetColumnState"
                                          Items="Temp.NetCalc.Columns"
                                          RowClass="bg-white transition-colors hover:bg-slate-50 dark:bg-slate-900 dark:hover:bg-slate-800/70">
                            <RowTemplate Context="col">
                                @{
                                    var row = Temp.NetCalc.Columns.IndexOf(col);
                                    var isFirst = row <= 0;
                                    var isLast = row >= Temp.NetCalc.Columns.Count - 1;
                                    var title = CalcLoc[NetColumnLoc.Key[col.Id]];
                                }

                                <td class="px-1 py-0.5 text-center align-middle">
                                    <div class="flex items-center justify-center gap-1">
                                        <span class="dragHint text-slate-400 dark:text-slate-500">⋮⋮</span>
                                        <span class="tabular-nums text-slate-700 dark:text-slate-200">@(row + 1)</span>
                                    </div>
                                </td>

                                <td class="px-1 py-0.5align-middle">
                                    <div class="flex items-center gap-2">
                                        <div class="flex shrink-0 items-center gap-1">
                                            <button type="button"
                                                    class="@IconButtonSecondaryClass"
                                                    disabled="@isFirst"
                                                    title="@AppLoc["moveToTop"]"
                                                    @onclick="() => MoveToTop(col)">
                                                ⇈
                                            </button>

                                            <button type="button"
                                                    class="@IconButtonSecondaryClass"
                                                    disabled="@isFirst"
                                                    title="@AppLoc["moveUp"]"
                                                    @onclick="() => MoveUp(col)">
                                                ▲
                                            </button>
                                        </div>

                                        <div class="min-w-0 flex-1">
                                            <div class="truncate font-medium text-slate-800 dark:text-slate-100"
                                                 title="@title">
                                                @title
                                            </div>
                                            <div class="mt-0.5 text-[11px] text-slate-500 dark:text-slate-400">
                                                @col.Id
                                            </div>
                                        </div>

                                        <div class="flex shrink-0 items-center gap-1">
                                            <button type="button"
                                                    class="@IconButtonSecondaryClass"
                                                    disabled="@isLast"
                                                    title="@AppLoc["moveDown"]"
                                                    @onclick="() => MoveDown(col)">
                                                ▼
                                            </button>

                                            <button type="button"
                                                    class="@IconButtonSecondaryClass"
                                                    disabled="@isLast"
                                                    title="@AppLoc["moveToBottom"]"
                                                    @onclick="() => MoveToBottom(col)">
                                                ⇊
                                            </button>
                                        </div>
                                    </div>
                                </td>

                                <td class="px-0.5 py-0.5align-middle">
                                    <div class="flex items-center justify-center gap-1 whitespace-nowrap">
                                        <input class="w-[50px] rounded-lg border border-slate-300 bg-white px-1.5 py-1 text-center text-[11px] text-slate-800 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-white"
                                               type="number"
                                               title="@AppLoc["width"]"
                                               @bind="col.Width" />

                                        <button type="button"
                                                class="@(col.Frozen? IconButtonWarningActiveClass : IconButtonWarningClass)"
                                                title="@AppLoc["freezeColumn"]"
                                                @onclick="() => col.Frozen = !col.Frozen">
                                            @(col.Frozen ? "📍" : "📌")
                                        </button>

                                        <button type="button"
                                                class="@IconButtonPrimaryClass"
                                                title="@AppLoc["hideColumn"]"
                                                @onclick="async () => await RemoveAsync(col)">
                                            <span>@((MarkupString)Icons.ChevronRight)</span>
                                        </button>
                                    </div>
                                </td>
                            </RowTemplate>
                        </DragReorderTBody>
                    </table>
                </div>
            </section>

            <!-- Hidden Columns -->
            <section class="w-[260px] flex-none overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">
                <div class="border-b border-slate-200 px-3 py-1 dark:border-slate-700">
                    <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">
                        @ResourceApp.hiddenItems
                    </h3>
                    <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
                        @AppLoc["hiddenColumnsCount", HiddenIds.Count()]
                    </p>
                </div>

                <div class="max-h-[65vh] overflow-auto">
                    <table class="w-full text-[12px]">
                        <thead class="sticky top-0 z-10 bg-slate-50 dark:bg-slate-900">
                            <tr class="text-[11px] text-slate-700 dark:text-slate-200">
                                <th class="w-[56px] px-1 py-0.5 text-center"></th>
                                <th class="px-1 py-0.5text-start font-medium">@CalcResource.name</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (TableVisible)
                            {
                                @foreach (var id in HiddenIds)
                                {
                                    <tr class="border-t border-slate-200 transition-colors hover:bg-slate-50 dark:border-slate-700 dark:hover:bg-slate-800/70">
                                        <td class="px-1 py-0.5 text-center align-middle">
                                            <button type="button"
                                                    class="@IconButtonPrimaryClass"
                                                    title="@AppLoc["showColumn"]"
                                                    @onclick="async () => await AddAsync(id)">
                                                <span>@((MarkupString)Icons.ChevronLeft)</span>
                                            </button>
                                        </td>

                                        <td class="px-1 py-0.5align-middle">
                                            <div class="font-medium text-slate-800 dark:text-slate-100">
                                                @CalcLoc[NetColumnLoc.Key[id]]
                                            </div>
                                            <div class="mt-0.5 text-[11px] text-slate-500 dark:text-slate-400">
                                                @id
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- Sort -->
            <section class="w-[220px] flex-none overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">
                <div class="border-b border-slate-200 px-3 py-1 dark:border-slate-700">
                    <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">Sort order</h3>
                    <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Default sort column for tasks and resources.</p>
                </div>

                <div class="max-h-[65vh] space-y-3 overflow-auto p-2">
                    @{
                        var taskSortColStr = Temp.NetCalc.Sort.TaskColumn.HasValue
                            ? ((int)Temp.NetCalc.Sort.TaskColumn.Value).ToString()
                            : string.Empty;

                        var resSortColStr = Temp.NetCalc.Sort.ResourceColumn.HasValue
                            ? ((int)Temp.NetCalc.Sort.ResourceColumn.Value).ToString()
                            : string.Empty;
                    }

                    <div class="space-y-1.5">
                        <p class="text-[11px] font-semibold text-slate-600 dark:text-slate-300">@ResourceLoc.task</p>

                        <select class="@SelectInputClass"
                                value="@taskSortColStr"
                                @onchange="e => SetTaskSortColumn(e.Value?.ToString())">
                            <option value="">— No sort —</option>
                            @foreach (var (id, label) in TaskSortColumns)
                            {
                                <option value="@((int)id)">@label</option>
                            }
                        </select>

                        <div class="flex gap-1">
                            <button type="button"
                                    class="@SortBtnClass(!Temp.NetCalc.Sort.TaskDescending)"
                                    @onclick="() => Temp.NetCalc.Sort.TaskDescending = false">
                                ↑ Asc
                            </button>
                            <button type="button"
                                    class="@SortBtnClass(Temp.NetCalc.Sort.TaskDescending)"
                                    @onclick="() => Temp.NetCalc.Sort.TaskDescending = true">
                                ↓ Desc
                            </button>
                        </div>
                    </div>

                    <div class="space-y-1.5">
                        <p class="text-[11px] font-semibold text-slate-600 dark:text-slate-300">@ResourceLoc.resource</p>

                        <select class="@SelectInputClass"
                                value="@resSortColStr"
                                @onchange="e => SetResourceSortColumn(e.Value?.ToString())">
                            <option value="">— No sort —</option>
                            @foreach (var (id, label) in ResourceSortColumns)
                            {
                                <option value="@((int)id)">@label</option>
                            }
                        </select>

                        <div class="flex gap-1">
                            <button type="button"
                                    class="@SortBtnClass(!Temp.NetCalc.Sort.ResourceDescending)"
                                    @onclick="() => Temp.NetCalc.Sort.ResourceDescending = false">
                                ↑ Asc
                            </button>
                            <button type="button"
                                    class="@SortBtnClass(Temp.NetCalc.Sort.ResourceDescending)"
                                    @onclick="() => Temp.NetCalc.Sort.ResourceDescending = true">
                                ↓ Desc
                            </button>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Settings -->
            <section class="w-[220px] flex-none overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">
                <div class="border-b border-slate-200 px-3 py-1 dark:border-slate-700">
                    <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">
                        @AppLoc["appearance"]
                    </h3>
                    <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
                        @AppLoc["tableColorsAndBorderStyle"]
                    </p>
                </div>

                <div class="max-h-[65vh] space-y-1 overflow-auto p-1">
                    <div class="space-y-1">
                        <label class="block text-[11px] font-medium text-slate-600 dark:text-slate-300">
                            @AppFormatResource.borderType
                        </label>
                        <select @bind="Temp.NetCalc.Color.BorderStyle"
                                class="@SelectInputClass">
                            @foreach (var item in TemplateConst.BorderStyles)
                            {
                                <option value="@item">@item</option>
                            }
                        </select>
                    </div>

                    <div class="grid gap-1">
                        <div class="@ColorRowClass">
                            <label class="@ColorLabelClass">@AppFormatResource.bolder</label>
                            <input type="color"
                                   class="@ColorInputClass"
                                   @bind="Temp.NetCalc.Color.Border" />
                        </div>

                        <div class="@ColorRowClass">
                            <label class="@ColorLabelClass">@AppFormatResource.font</label>
                            <input type="color"
                                   class="@ColorInputClass"
                                   @bind="Temp.NetCalc.Color.Text" />
                        </div>

                        <div class="@ColorRowClass">
                            <label class="@ColorLabelClass">@ResourceApp.header</label>
                            <input type="color"
                                   class="@ColorInputClass"
                                   @bind="Temp.NetCalc.Color.Header" />
                        </div>

                        <div class="@ColorRowClass">
                            <label class="@ColorLabelClass">@ResourceLoc.task</label>
                            <input type="color"
                                   class="@ColorInputClass"
                                   @bind="Temp.NetCalc.Color.Task" />
                        </div>

                        <div class="@ColorRowClass">
                            <label class="@ColorLabelClass">OnlyCodeText task</label>
                            <input type="color"
                                   class="@ColorInputClass"
                                   @bind="Temp.NetCalc.Color.TaskCodeName" />
                        </div>

                        <div class="@ColorRowClass">
                            <label class="@ColorLabelClass">@ResourceLoc.SubTask</label>
                            <input type="color"
                                   class="@ColorInputClass"
                                   @bind="Temp.NetCalc.Color.SubTask" />
                        </div>

                        <div class="@ColorRowClass">
                            <label class="@ColorLabelClass">BaseQuantity row</label>
                            <input type="color"
                                   class="@ColorInputClass"
                                   @bind="Temp.NetCalc.Color.TaskDetailBaseQuantity" />
                        </div>

                        <div class="@ColorRowClass">
                            <label class="@ColorLabelClass">@ResourceLoc.resource</label>
                            <input type="color"
                                   class="@ColorInputClass"
                                   @bind="Temp.NetCalc.Color.Resource" />
                        </div>

                        <div class="@ColorRowClass">
                            <label class="@ColorLabelClass">Quantity-driving factor</label>
                            <input type="color"
                                   class="@ColorInputClass"
                                   @bind="Temp.NetCalc.Color.ResourceParameter" />
                        </div>

                        <div class="@ColorRowClass">
                            <label class="@ColorLabelClass">Add-ons / Attachments</label>
                            <input type="color"
                                   class="@ColorInputClass"
                                   @bind="Temp.NetCalc.Color.ResourceAttachment" />
                        </div>

                        <div class="@ColorRowClass">
                            <label class="@ColorLabelClass">Breakdown of hours</label>
                            <input type="color"
                                   class="@ColorInputClass"
                                   @bind="Temp.NetCalc.Color.ResourceTime" />
                        </div>

                        <div class="@ColorRowClass">
                            <label class="@ColorLabelClass">@CalcResource.note</label>
                            <input type="color"
                                   class="@ColorInputClass"
                                   @bind="Temp.NetCalc.Color.Note" />
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>
}

@code {
    private const string IconButtonBaseClass =
        "inline-flex h-7 w-7 items-center justify-center rounded-lg border text-[11px] " +
        "transition duration-150 hover:scale-[1.03] active:scale-95";

    private const string IconButtonSecondaryClass =
        IconButtonBaseClass + " border-slate-300 bg-white text-slate-600 " +
        "hover:bg-slate-100 hover:border-slate-400 " +
        "dark:border-slate-600 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800";

    private const string IconButtonPrimaryClass =
        IconButtonBaseClass + " border-blue-300 bg-blue-50 text-blue-700 " +
        "hover:bg-blue-100 hover:border-blue-400 " +
        "dark:border-blue-500/60 dark:bg-blue-950/40 dark:text-blue-300 dark:hover:bg-blue-900/50";

    private const string IconButtonWarningClass =
        IconButtonBaseClass + " border-amber-300 bg-amber-50 text-amber-700 " +
        "hover:bg-amber-100 hover:border-amber-400 " +
        "dark:border-amber-500/60 dark:bg-amber-950/40 dark:text-amber-300 dark:hover:bg-amber-900/50";

    private const string IconButtonWarningActiveClass =
        IconButtonBaseClass + " border-emerald-300 bg-emerald-50 text-emerald-700 " +
        "hover:bg-emerald-100 hover:border-emerald-400 " +
        "dark:border-emerald-500/60 dark:bg-emerald-950/40 dark:text-emerald-300 dark:hover:bg-emerald-900/50";

    private const string SelectInputClass =
        "w-full rounded-xl border border-slate-300 bg-white px-2 py-1 text-[12px] text-slate-800 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-white";

    private const string ColorRowClass =
        "flex items-center justify-between gap-3 rounded-xl border border-slate-200 bg-slate-50 px-2 py-1 dark:border-slate-700 dark:bg-slate-800/70";

    private const string ColorLabelClass =
        "text-[11px] font-medium text-slate-700 dark:text-slate-200";

    private const string ColorInputClass =
        "h-8 w-14 rounded-md border border-slate-300 bg-transparent p-0.5 dark:border-slate-600";

    [Parameter] public TemplateListPostDTO Temp { get; set; } = new();

    private bool TableVisible = true;

    private static readonly IReadOnlyDictionary<NetColumnId, NetColumnState> _defaults =
        TemplateDefaults.NetCalc().ToDictionary(x => x.Id, x => x);

    private IEnumerable<NetColumnId> HiddenIds =>
        Enum.GetValues<NetColumnId>()
            .Where(id => !Temp.NetCalc.Columns.Any(c => c.Id == id));

    private async Task AddAsync(NetColumnId id)
    {
        TableVisible = false;
        await Task.Delay(1);

        if (_defaults.TryGetValue(id, out var def))
        {
            Temp.NetCalc.Columns.Add(new NetColumnState
            {
                Id = def.Id,
                Width = def.Width,
                Frozen = def.Frozen
            });
        }
        else
        {
            Temp.NetCalc.Columns.Add(new NetColumnState
            {
                Id = id,
                Width = 80,
                Frozen = false
            });
        }

        TableVisible = true;
    }

    private async Task RemoveAsync(NetColumnState col)
    {
        TableVisible = false;
        await Task.Delay(1);

        if (col != null)
        {
            col.Frozen = false;
            Temp.NetCalc.Columns.Remove(col);
        }

        await Task.Delay(1);
        TableVisible = true;
    }

    private void MoveUp(NetColumnState col)
    {
        var list = Temp.NetCalc.Columns;
        var index = list.IndexOf(col);
        if (index <= 0) return;
        list.RemoveAt(index);
        list.Insert(index - 1, col);
    }

    private void MoveDown(NetColumnState col)
    {
        var list = Temp.NetCalc.Columns;
        var index = list.IndexOf(col);
        if (index < 0 || index >= list.Count - 1) return;
        list.RemoveAt(index);
        list.Insert(index + 1, col);
    }

    private void MoveToTop(NetColumnState col)
    {
        var list = Temp.NetCalc.Columns;
        var index = list.IndexOf(col);
        if (index <= 0) return;
        list.RemoveAt(index);
        list.Insert(0, col);
    }

    private void MoveToBottom(NetColumnState col)
    {
        var list = Temp.NetCalc.Columns;
        var index = list.IndexOf(col);
        if (index < 0 || index >= list.Count - 1) return;
        list.RemoveAt(index);
        list.Add(col);
    }

    private static readonly (NetColumnId Id, string Label)[] TaskSortColumns =
    [
        (NetColumnId.Name,          "Name"),
        (NetColumnId.Code,          "Code"),
        (NetColumnId.Quantity,      "Quantity"),
        (NetColumnId.Unit,          "Unit"),
        (NetColumnId.NetCostQ,      "Net cost/Q"),
        (NetColumnId.TotalNetCost,  "Total net cost"),
        (NetColumnId.PriceTotaly,   "Price total"),
        (NetColumnId.ChangeFactor1, "Factor 1"),
        (NetColumnId.ChangeFactor2, "Factor 2"),
        (NetColumnId.Status,        "Status"),
        (NetColumnId.Responsible,   "Responsible"),
    ];

    private static readonly (NetColumnId Id, string Label)[] ResourceSortColumns =
    [
        (NetColumnId.Name,              "Name"),
        (NetColumnId.Quantity,          "Quantity"),
        (NetColumnId.Unit,              "Unit"),
        (NetColumnId.Cost,              "Cost"),
        (NetColumnId.NetCostQ,          "Net cost/Q"),
        (NetColumnId.ChangeFactor1,     "Factor 1"),
        (NetColumnId.Account,           "Account"),
        (NetColumnId.ResourceTypeSystem,"Resource type"),
        (NetColumnId.Status,            "Status"),
    ];

    private static string SortBtnClass(bool active) => active
        ? "flex-1 rounded-lg border border-blue-400 bg-blue-100 px-2 py-1 text-[11px] font-semibold text-blue-800 transition dark:border-blue-500 dark:bg-blue-900/50 dark:text-blue-200"
        : "flex-1 rounded-lg border border-slate-300 bg-white px-2 py-1 text-[11px] text-slate-600 transition hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-300";

    private void SetTaskSortColumn(string? value)
    {
        if (string.IsNullOrEmpty(value))
            Temp.NetCalc.Sort.TaskColumn = null;
        else if (int.TryParse(value, out var intVal))
            Temp.NetCalc.Sort.TaskColumn = (NetColumnId)intVal;
    }

    private void SetResourceSortColumn(string? value)
    {
        if (string.IsNullOrEmpty(value))
            Temp.NetCalc.Sort.ResourceColumn = null;
        else if (int.TryParse(value, out var intVal))
            Temp.NetCalc.Sort.ResourceColumn = (NetColumnId)intVal;
    }
}
