@using ProjectManagement.Client.Shared.MVVM.Calculation
@inherits AppComponentBase
<table class="w-full border-collapse text-slate-900 dark:text-slate-100">
    <thead class="bg-slate-100 dark:bg-slate-800">
        <tr>
            <th class="border border-slate-300 dark:border-slate-700 px-2 py-1 text-start"></th>
            <th class="border border-slate-300 dark:border-slate-700 px-2 py-1 text-start">@CalcResource.cost</th>
            <th class="border border-slate-300 dark:border-slate-700 px-2 py-1 text-start">@CalcResource.baseCost</th>
            <th class="border border-slate-300 dark:border-slate-700 px-2 py-1 text-start">@ResourceApp.date</th>
            <th class="border border-slate-300 dark:border-slate-700 px-2 py-1 text-start">@CalcResource.note</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var offer in Resource?.Offers ?? [])
        {
            <tr class="border-b border-slate-200 dark:border-slate-700">
                <td class="border border-slate-300 dark:border-slate-700 px-2 py-1">@offer.BaseCost</td>
                <td class="border border-slate-300 dark:border-slate-700 px-2 py-1">@offer.Cost</td>
                <td class="border border-slate-300 dark:border-slate-700 px-2 py-1">@offer.Date</td>
                <td class="border border-slate-300 dark:border-slate-700 px-2 py-1">@offer.Comment</td>
            </tr>
        }
    </tbody>
</table>
@code {
    [Parameter] public ResourceListMVVM? Resource { get; set; }
}
