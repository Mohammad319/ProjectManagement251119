@inherits AppComponentBase
@using ProjectManagement.Client.Services.Calculation
@using ProjectManagement.Client.Shared.Constants
@using ProjectManagement.Client.Shared.ViewModel
@inject CalculationFilterPresetStorage FilterPresetStorage

<div class="w-full max-w-lg space-y-3 p-3 text-slate-800 dark:text-slate-100">
    @if (LoadPresetCandidate is not null)
    {
        <div class="rounded-xl border border-emerald-200 bg-emerald-50/70 px-3 py-2.5 dark:border-emerald-800 dark:bg-emerald-950/20">
            <div class="min-w-0">
                <div class="text-[11px] font-semibold uppercase tracking-wide text-emerald-600 dark:text-emerald-400">
                    @AppLoc["filterPreset"]
                </div>
                <div class="truncate text-sm font-semibold text-slate-900 dark:text-slate-100">
                    @LoadPresetCandidate.Name
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="rounded-xl border border-slate-200 bg-slate-50/80 px-3 py-2.5 dark:border-slate-700 dark:bg-slate-900/60">
            <div class="text-sm text-slate-500 dark:text-slate-400">@AppLoc["noPresetSelected"]</div>
        </div>
    }

    <div class="flex flex-wrap gap-2">
        <InputText id="filterPresetName"
                   class="h-9 min-w-0 flex-1 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
                   @bind-Value="PresetName"
                   placeholder="@AppLoc["presetName"]" />
        <button type="button"
                class="inline-flex h-9 shrink-0 items-center justify-center gap-1.5 rounded-lg bg-slate-700 px-3 text-sm font-medium text-white transition hover:bg-slate-800 disabled:cursor-not-allowed disabled:opacity-40 dark:bg-slate-600 dark:hover:bg-slate-500"
                disabled="@string.IsNullOrWhiteSpace(PresetName)"
                @onclick="SavePresetAsync">
            <span class="inline-flex h-4 w-4 items-center justify-center">@((MarkupString)Icons.SaveCloud)</span>
            <span>@ResourceApp.save</span>
        </button>
        @if (SelectedPreset is not null)
        {
            <button type="button"
                    class="inline-flex h-9 shrink-0 items-center justify-center gap-1.5 rounded-lg bg-sky-600 px-3 text-sm font-medium text-white transition hover:bg-sky-700 disabled:cursor-not-allowed disabled:opacity-40"
                    disabled="@string.IsNullOrWhiteSpace(PresetName)"
                    @onclick="UpdateSelectedPresetAsync">
                <span class="inline-flex h-4 w-4 items-center justify-center">@((MarkupString)Icons.SaveCloud)</span>
                <span>@ResourceApp.update</span>
            </button>
        }
    </div>

    <div class="rounded-xl border border-slate-200 bg-slate-50/80 dark:border-slate-700 dark:bg-slate-900/60">
        <div class="flex items-center justify-between border-b border-slate-200 px-3 py-2 dark:border-slate-700">
            <div class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
                @AppLoc["savedPresets"]
            </div>
            <div class="text-xs text-slate-500 dark:text-slate-400">
                @SavedFilters.Presets.Count
            </div>
        </div>

        @if (SavedFilters.Presets.Count == 0)
        {
            <div class="px-3 py-5 text-sm text-slate-500 dark:text-slate-400">
                @AppLoc["noSavedPresetsYet"]
            </div>
        }
        else
        {
            <div class="max-h-72 overflow-auto p-2">
                @foreach (var preset in SavedFilters.Presets)
                {
                    var isSelected = string.Equals(SelectedPresetId, preset.Id, StringComparison.Ordinal);
                    var isActive = string.Equals(SavedFilters.ActivePresetId, preset.Id, StringComparison.Ordinal);

                    <div role="button"
                         tabindex="0"
                         class="@GetPresetRowClass(isSelected, isActive)"
                         @onclick="() => SelectPreset(preset)">
                        <span class="min-w-0 flex-1 text-left">
                            <span class="block truncate text-sm font-medium">@preset.Name</span>
                            <span class="block text-xs text-slate-500 dark:text-slate-400">@FormatSavedAt(preset.SavedAtUtc)</span>
                        </span>
                        <span class="flex shrink-0 items-center gap-2">
                            @if (isActive)
                            {
                                <span class="rounded-full bg-emerald-100 px-2 py-0.5 text-[11px] font-semibold text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300">
                                    @AppLoc["active"]
                                </span>
                            }
                            @if (isSelected)
                            {
                                <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-sky-100 text-sky-700 dark:bg-sky-900/40 dark:text-sky-300"
                                      title="@AppLoc["selected"]">
                                    @((MarkupString)Icons.Check)
                                </span>
                            }
                            <button type="button"
                                    class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-transparent text-slate-400 transition hover:border-red-200 hover:bg-red-50 hover:text-red-600 focus:outline-none focus:ring-2 focus:ring-red-500/20 dark:hover:border-red-800 dark:hover:bg-red-950/40 dark:hover:text-red-300"
                                    title="@AppLoc["deletePreset"]"
                                    @onclick:stopPropagation="true"
                                    @onclick="() => ConfirmDeletePreset(preset)">
                                @((MarkupString)Icons.DeleteSVG)
                            </button>
                        </span>
                    </div>
                }
            </div>
        }
    </div>

    <div class="flex flex-wrap justify-end gap-2 border-t border-slate-200 pt-3 dark:border-slate-700">
        <button type="button"
                class="inline-flex h-9 items-center justify-center gap-1.5 rounded-lg border border-slate-300 px-4 text-sm font-medium text-slate-600 transition hover:bg-slate-100 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800"
                title="@AppLoc["clearFilters"]"
                @onclick="ClearFilterAndPresetAsync">
            <span class="inline-flex h-4 w-4 items-center justify-center">@((MarkupString)Icons.Filter)</span>
            <span>@AppLoc["clearFilters"]</span>
        </button>
        <button type="button"
                class="inline-flex h-9 items-center justify-center rounded-lg border border-slate-300 px-4 text-sm font-medium text-slate-700 transition hover:bg-slate-100 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
                @onclick="CloseDialog">
            @ResourceApp.cancel
        </button>
        <button type="button"
                class="inline-flex h-9 items-center justify-center gap-2 rounded-lg border border-emerald-600 bg-emerald-600 px-4 text-sm font-medium text-white transition hover:bg-emerald-700 disabled:cursor-not-allowed disabled:opacity-50 dark:border-emerald-500 dark:bg-emerald-500 dark:hover:bg-emerald-400 dark:hover:text-slate-900"
                disabled="@(LoadPresetCandidate is null)"
                @onclick="ApplyPresetAndCloseAsync">
            <span class="inline-flex h-4 w-4 items-center justify-center">@((MarkupString)Icons.Check)</span>
            <span>@ResourceApp.Button_Apply</span>
        </button>
    </div>
</div>

@code {
    private CalculationFilterPresetStore SavedFilters = new();
    private string? SelectedPresetId;
    private string PresetName = string.Empty;

    private FilterVM CurrentFilter => Calc.FilterVM ??= new();
    private CalculationFilterPreset? SelectedPreset => CalculationFilterPresetState.GetPreset(SavedFilters, SelectedPresetId);
    private CalculationFilterPreset? LoadPresetCandidate => SelectedPreset ?? CalculationFilterPresetState.GetActivePreset(SavedFilters);

    protected override async Task OnInitializedAsync()
    {
        SavedFilters = await FilterPresetStorage.LoadAsync(Calc.Id);

        var activePreset = CalculationFilterPresetState.GetActivePreset(SavedFilters);
        if (activePreset is not null)
        {
            SelectedPresetId = activePreset.Id;
            PresetName = activePreset.Name;
        }
    }

    private void SelectPreset(CalculationFilterPreset preset)
    {
        SelectedPresetId = preset.Id;
        PresetName = preset.Name;
    }

    private async Task SavePresetAsync()
    {
        if (string.IsNullOrWhiteSpace(PresetName))
            return;

        var preset = CalculationFilterPresetState.SavePreset(SavedFilters, PresetName, CurrentFilter);
        SelectedPresetId = preset.Id;
        PresetName = preset.Name;

        await FilterPresetStorage.SaveAsync(Calc.Id, SavedFilters);
        await InvokeAsync(StateHasChanged);
    }

    private async Task UpdateSelectedPresetAsync()
    {
        var selected = SelectedPreset;
        if (selected is null || string.IsNullOrWhiteSpace(PresetName))
            return;

        var preset = CalculationFilterPresetState.SavePreset(SavedFilters, PresetName, CurrentFilter, selected.Id);
        SelectedPresetId = preset.Id;
        PresetName = preset.Name;

        await FilterPresetStorage.SaveAsync(Calc.Id, SavedFilters);
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadSelectedPresetAsync()
    {
        var preset = SelectedPreset ?? CalculationFilterPresetState.GetActivePreset(SavedFilters);
        if (preset is null)
            return;

        SelectedPresetId = preset.Id;
        PresetName = preset.Name;
        CalculationFilterPresetState.SetActivePreset(SavedFilters, preset.Id);
        await FilterPresetStorage.SaveAsync(Calc.Id, SavedFilters);

        CalcService.GetFilter(CalculationFilterPresetState.CloneFilter(preset.Filter));
        await InvokeAsync(StateHasChanged);
    }

    private async Task ApplyPresetAndCloseAsync()
    {
        if (LoadPresetCandidate is null)
            return;

        await LoadSelectedPresetAsync();
        CloseDialog();
    }

    private void ConfirmDeletePreset(CalculationFilterPreset preset)
    {
        if (preset is null)
            return;

        MHD.MessageYesNo(
            AppLoc["deleteFilterPreset"],
            AppLoc["deleteFilterPresetConfirm", preset.Name],
            BlazorMHD.UI.Core.DesignSystem.MhdState.Danger,
            EventCallback.Factory.Create(this, () => DeletePresetAsync(preset.Id)));
    }

    private async Task DeletePresetAsync(string? presetId)
    {
        var preset = CalculationFilterPresetState.GetPreset(SavedFilters, presetId);
        if (preset is null)
            return;

        var wasSelected = string.Equals(SelectedPresetId, preset.Id, StringComparison.Ordinal);

        if (!CalculationFilterPresetState.RemovePreset(SavedFilters, preset.Id))
            return;

        if (wasSelected)
        {
            SelectedPresetId = SavedFilters.ActivePresetId;
            PresetName = CalculationFilterPresetState.GetActivePreset(SavedFilters)?.Name ?? string.Empty;
        }

        await FilterPresetStorage.SaveAsync(Calc.Id, SavedFilters);
        await InvokeAsync(StateHasChanged);
    }

    private async Task ClearFilterAndPresetAsync()
    {
        Calc.FilterVM = new FilterVM();
        CalculationFilterPresetState.SetActivePreset(SavedFilters, null);
        SelectedPresetId = null;
        PresetName = string.Empty;
        await FilterPresetStorage.SaveAsync(Calc.Id, SavedFilters);
        CalcService.GetFilter(Calc.FilterVM);
        await InvokeAsync(StateHasChanged);
    }

    private void CloseDialog() => Modal.CloseAsync();

    private static string GetPresetRowClass(bool isSelected, bool isActive)
    {
        if (isActive)
            return "mb-1.5 flex w-full cursor-pointer items-center gap-3 rounded-lg border border-emerald-200 bg-emerald-50/70 px-3 py-2 text-left shadow-sm transition hover:border-emerald-300 hover:bg-emerald-50 dark:border-emerald-800 dark:bg-emerald-950/20 dark:hover:border-emerald-700";

        if (isSelected)
            return "mb-1.5 flex w-full cursor-pointer items-center gap-3 rounded-lg border border-sky-300 bg-sky-50 px-3 py-2 text-left shadow-sm dark:border-sky-700 dark:bg-sky-950/40";

        return "mb-1.5 flex w-full cursor-pointer items-center gap-3 rounded-lg border border-transparent bg-white px-3 py-2 text-left shadow-sm transition hover:border-slate-200 hover:bg-slate-100 dark:bg-slate-800 dark:hover:border-slate-700 dark:hover:bg-slate-700/60";
    }

    private static string FormatSavedAt(DateTime savedAtUtc) =>
        savedAtUtc.ToLocalTime().ToString("g");
}
