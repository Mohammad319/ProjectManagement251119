@using ProjectManagement.Client.Constant;
@using BlazorMHD.UI.Core.Services
@using ProjectManagement.Client.Shared.MVVM.Calculation
@using ProjectManagement.Client.Shared.Repositories.Calculation;
@using ProjectManagement.Client.Shared.Repositories.ResourceType;
@using ProjectManagement.Client.Shared.ViewModel;
@using ProjectManagement.Shared.Constant
@using ProjectManagement.Shared.Constants
@using ProjectManagement.Shared.DTO.Calculation
@using ProjectManagement.Shared.DTO.Calculation.Template
@using ProjectManagement.Shared.DTO.ResourceType;

<style>
    .modalFilter {
        display: block;
        position: fixed;
        z-index: 50;
        border-radius: 10px;
        border: 1px solid #d1d5db;
        min-width: 220px;
        width: 260px;
        min-height: 260px;
        background-color: #f9fafb;
        padding: 8px;
        text-align: left;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.35);
        font-size: 12px;
    }

    .dark .modalFilter {
        border-color: #334155;
        background-color: #0f172a;
        color: #e2e8f0;
    }

        .dark .modalFilter .chip {
            background-color: #334155;
            color: #e2e8f0;
        }

        .modalFilter > div:first-child {
            display: flex;
            align-items: center;
            gap: 6px;
            margin-bottom: 6px;
        }

        .modalFilter select,
        .modalFilter input[type="text"] {
            font-size: 12px;
        }

        .modalFilter .closebtn {
            cursor: pointer;
            margin-left: auto;
            font-size: 18px;
            line-height: 1;
            color: #ef4444;
        }

            .modalFilter .closebtn:hover {
                color: #b91c1c;
            }

        .modalFilter > div:nth-child(2) {
            margin-bottom: 6px;
            margin-top: 4px;
        }

        .modalFilter .chip {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 2px 6px;
            margin: 2px;
            border-radius: 9999px;
            background-color: #e5e7eb;
            color: #111827;
            font-size: 11px;
            max-width: 100%;
            white-space: nowrap;
            text-overflow: ellipsis;
            overflow: hidden;
        }

            .modalFilter .chip .closebtn {
                font-size: 13px;
                color: #6b7280;
                margin-left: 2px;
            }

                .modalFilter .chip .closebtn:hover {
                    color: #111827;
                }
</style>

@if (display == "block")
{
    <div class="modalFilter" style="top:@(MouseEvent.ClientY)px;left:@(MouseEvent.ClientX)px;">
        <div>
            @if (FilterAttrStr == "resourceTypeSystem" || FilterAttrStr == "resourceType" || FilterAttrStr == "status")
            {
                <select class="w-full rounded border border-slate-300 bg-white px-2 py-1 text-sm text-slate-900 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100" @onchange="EnterResource">
                    <option></option>
                    @if (FilterAttrStr == "status")
                    {
                        if (Statuses != null)
                        {
                            foreach (var status in Statuses)
                                if (!string.IsNullOrWhiteSpace(status.Name) && !Filter.Status.Any(x => x == status.Name))
                                {
                                    <option value="@status.Name">@status.Name</option>
                                }
                        }
                    }
                    else if (FilterAttrStr == "resourceType")
                    {
                        if (ResourceTypes != null)
                        {
                            foreach (var item in ResourceTypes)
                                if (!string.IsNullOrWhiteSpace(item.Name) && !Filter.Resource.Any(x => x == item.Name))
                                {
                                    <option value="@item.Name">@item.Name</option>
                                }
                        }
                    }
                    else if (FilterAttrStr == "resourceTypeSystem")
                    {
                        foreach (ResourceTypesEnum level in Enum.GetValues(typeof(ResourceTypesEnum)))
                            if (!Filter.ResourceTypeSystem.Any(x => x == level))
                            {
                                <option value="@level">@level</option>
                            }
                    }
                </select>
                <span role="button"
                      class="closebtn float-right"
                      @onclick="() => display = none">
                    &times;
                </span>
            }
            else
            {
                <input class="w-full rounded border border-slate-300 bg-white px-2 py-1 text-sm text-slate-900 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100"
                       style="width:70%;z-index:1000;font-size:12px;height:26px;"
                       max="8"
                       type="text"
                       @bind="fff"
                       @bind:event="oninput"
                       @onkeydown="EnterFilter" />
                <span role="button"
                      class="closebtn float-right"
                      @onclick="() => { fff = string.Empty; display = none; }">
                    &times;
                </span>
            }
        </div>

        <div>
            <select class="w-full rounded border border-slate-300 bg-white px-2 py-1 text-sm text-slate-900 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100"
                    style="font-size:12px;height:26px;"
                    @onchange="FilterTypesFilter">
                @foreach (FilterType level in FilterTypesList1)
                {
                    <option value="@level" selected="@(FilterType == level ? true : false)">@level</option>
                }
            </select>
        </div>

        <div style="display:flex;gap:6px;margin-bottom:6px;">
            <button type="button"
                    class="rounded border border-slate-300 bg-white px-2 py-1 text-xs text-slate-700 hover:bg-slate-100 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
                    @onclick="ClearAllFiltersAsync">
                Clear filter
            </button>
            <button type="button"
                    class="rounded border border-slate-300 bg-white px-2 py-1 text-xs text-slate-700 hover:bg-slate-100 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
                    @onclick="ClearCurrentColumnFilterAsync">
                Clear column
            </button>
        </div>

        <div style="display:flex;justify-content:flex-end;margin-bottom:6px;">
            <button type="button"
                    class="rounded border border-sky-300 bg-sky-50 px-2 py-1 text-xs font-medium text-sky-700 hover:bg-sky-100 dark:border-sky-700 dark:bg-sky-950/40 dark:text-sky-200 dark:hover:bg-sky-900/50"
                    @onclick="ApplyAndCloseAsync">
                Apply &amp; close
            </button>
        </div>

        <div style="overflow:auto;height:130px">
            @if (FilterAttrStr == "resourceTypeSystem")
            {
                foreach (var item2 in Filter.ResourceTypeSystem)
                {
                    <div class="chip">
                        @item2
                        <span role="button"
                              class="closebtn"
                              @onclick="() => RemoveResourceTypeSystemFilterValue(item2)">
                            &times;
                        </span>
                    </div>
                }
            }
            else if (FilterAttrStr == "status")
            {
                foreach (var item2 in Filter.Status)
                {
                    <div class="chip">
                        @item2
                        <span role="button"
                              class="closebtn"
                              @onclick="() => RemoveStatusFilterValue(item2)">
                            &times;
                        </span>
                    </div>
                }
            }
            else if (FilterAttrStr == "resourceType")
            {
                foreach (var item2 in Filter.Resource)
                {
                    <div class="chip">
                        @item2
                        <span role="button"
                              class="closebtn"
                              @onclick="() => RemoveResourceFilterValue(item2)">
                            &times;
                        </span>
                    </div>
                }
            }
            else
            {
                foreach (var item1 in FilterValues)
                {
                    <div class="chip">
                        @item1
                        <span role="button"
                              class="closebtn"
                              @onclick="() => RemoveCurrentStringFilterValue(item1)">
                            &times;
                        </span>
                    </div>
                }
            }
        </div>
    </div>
}

<tr style="@($"background-color:{Template?.NetCalc.Color.Header};font-size:11px;font-weight:normal;height:30px;")"
    id="headerFilter">
    @if (TemplateConst.Col0 > PMValuesConst.MinWidthCol)
    {
        <td class="filter-actions-cell">
            <div class="calc-filter-toolbar" role="toolbar" aria-label="Filter actions">
                <button type="button"
                        class="calc-filter-tool-button calc-filter-tool-button-primary"
                        title="Open filter presets"
                        aria-label="Open filter presets"
                        @onclick="OpenPresetsDialog">
                    @((MarkupString)Icons.Storage)
                </button>
          @*       <button type="button"
                        class="calc-filter-tool-button calc-filter-tool-button-success"
                        title="Apply filter"
                        aria-label="Apply filter"
                        @onclick="ApplyCurrentFilterAsync">
                    @((MarkupString)Icons.SaveCloud)
                </button>
                <button type="button"
                        class="calc-filter-tool-button calc-filter-tool-button-neutral"
                        title="Refresh filter"
                        aria-label="Refresh filter"
                        @onclick="RefreshFilterAsync">
                    @((MarkupString)Icons.RefreshSvg)
                </button> *@
                <button type="button"
                        class="calc-filter-tool-button calc-filter-tool-button-danger"
                        title="Clear filters"
                        aria-label="Clear filters"
                        @onclick="ClearAllFiltersAsync">
                    @((MarkupString)Icons.FilterOff)
                </button>
            </div>
        </td>
    }

    @foreach (var obj in Template?.NetCalc?.Columns?.AsEnumerable() ?? Enumerable.Empty<NetColumnState>())//Template.NetOrder)
    {
        <td @onclick="(e) => EnterCodeClick(e, obj.Id)">
            @if (obj.Id  == NetColumnId.Status)
            {
                foreach (var item1 in Filter.Status)
                {
                    <div class="chip">@item1</div>
                }
            }
            else if (obj.Id == NetColumnId.Code)
            {
                foreach (var item1 in Filter.Code)
                {
                    <div class="chip">@item1</div>
                }
            }
            else if (obj.Id == NetColumnId.Name)
            {
                foreach (var item1 in Filter.Name)
                {
                    <div class="chip">@item1</div>
                }
            }
            else if (obj.Id == NetColumnId.Account)
            {
                foreach (var item1 in Filter.Account)
                {
                    <div class="chip">@item1</div>
                }
            }
            else if (obj.Id == NetColumnId.ResourceType)
            {
                foreach (var item1 in Filter.Resource)
                {
                    <div class="chip">@item1</div>
                }
            }
            else if (obj.Id == NetColumnId.ResourceTypeSystem)
            {
                foreach (var item1 in Filter.ResourceTypeSystem)
                {
                    <div class="chip">@item1</div>
                }
            }
            else if (obj.Id == NetColumnId.ResourceSort)
            {
                foreach (var item1 in Filter.ResourceSort)
                {
                    <div class="chip">@item1</div>
                }
            }
            else if (obj.Id == NetColumnId.Unit)
            {
                foreach (var item1 in Filter.Unit)
                {
                    <div class="chip">@item1</div>
                }
            }
        </td>
    }
</tr>

@code {
    [Inject] private ProjectManagement.Client.Services.Calculation.CalculationService CalcService { get; set; } = default!;
    [Inject] private DialogService DialogService { get; set; } = default!;
    [Inject] private ProjectManagement.Client.Services.Folder.FolderState FolderState { get; set; } = default!;
    [Inject] private ITaskRepository TaskRepository { get; set; } = default!;
    [Inject] private IResourceTypeRepository ResourceTypeRepository { get; set; } = default!;

    string? FilterAttrStr;
    List<string> FilterValues = [];
    FilterType FilterType = FilterType.equals;
    List<FilterType> FilterTypesList1 = [];
    List<ListResourceTypeDTO>? ResourceTypes;
    List<ListOrderDTO>? Statuses;
    string fff = string.Empty;
    string display = "none";
    string none = "none";
    MouseEventArgs MouseEvent = new MouseEventArgs();
    private ProjectManagement.Client.Shared.MVVM.Calculation.CalculationMVVM Calc => FolderState.Calculation ?? throw new InvalidOperationException("TableHeaderFilterDiv requires an active calculation.");
    private ProjectManagement.Client.Shared.MVVM.Calculation.TemplateMVVM Template => Calc.Template;
    private FilterVM Filter => Calc.FilterVM ??= new();

    public async Task EnterFilter(KeyboardEventArgs e)
    {
        if (e.Code == "Enter" || e.Code == "NumpadEnter")
        {
            if (string.IsNullOrEmpty(fff)) return;
            FilterValues.Add(fff.Trim());
            fff = "";
            await ApplyCurrentFilterAsync();
        }
        else if (e.Code == "Esc")
        {
            fff = "";
        }
    }

    async Task EnterResource(ChangeEventArgs e)
    {
        if (string.IsNullOrEmpty(e?.Value?.ToString())) return;

        if (FilterAttrStr == "status")
            Filter.Status.Add(e.Value?.ToString() ?? string.Empty);
        else if (FilterAttrStr == "resourceType")
            Filter.Resource.Add(e.Value?.ToString() ?? string.Empty);
        else if (FilterAttrStr == "resourceTypeSystem")
        {
            var value = e?.Value?.ToString();
            if (string.IsNullOrWhiteSpace(value) || !Enum.TryParse<ResourceTypesEnum>(value, out var f))
                return;

            Filter.ResourceTypeSystem.Add(f);
        }

        await ApplyCurrentFilterAsync();
    }

    protected async override Task OnInitializedAsync()
    {
        Statuses = (await TaskRepository.GetAsync())?.ToList() ?? [];
        ResourceTypes = await ResourceTypeRepository.GetLocalAsync() ?? [];
    }

    public async Task EnterCodeClick(MouseEventArgs e1, NetColumnId i)
    {
        FilterAttrStr = i switch
        {
            NetColumnId.Status => "status",
            NetColumnId.Code => "code",
            NetColumnId.Name => "name",
            NetColumnId.Unit => "unit",
            NetColumnId.Account => "account",
            NetColumnId.ResourceType => "resourceType",
            NetColumnId.ResourceSort => "resourceSort",
            NetColumnId.ResourceTypeSystem => "resourceTypeSystem",
            _ => FilterAttrStr
        };

        if (i == NetColumnId.Status || i == NetColumnId.Code ||
            i == NetColumnId.Name || i == NetColumnId.Unit || i == NetColumnId.Account ||
            i == NetColumnId.ResourceType || i == NetColumnId.ResourceSort || i == NetColumnId.ResourceTypeSystem)
        {
            display = "none";

            FilterTypesList1 = new List<FilterType>()
            {
                FilterType.equals,
                FilterType.noEquals,
                FilterType.contains,
                FilterType.startsWith,
                FilterType.endsWith,
                FilterType.doesNotContains
            };

            fff = string.Empty;
            SyncCurrentFilterSelection();

            await Fixed(e1);
        }
    }

    async Task Fixed(MouseEventArgs e)
    {
        MouseEvent = e;
        await Task.Delay(1);

        if (e.ClientX > 270)
            MouseEvent.ClientX = MouseEvent.ClientX - 250;
        else
            MouseEvent.ClientX = -15;

        MouseEvent.ClientY = MouseEvent.ClientY + 10;
        display = "block";
    }

    public async Task FilterTypesFilter(ChangeEventArgs e)
    {
        var value = e?.Value?.ToString();
        if (string.IsNullOrWhiteSpace(value) || !Enum.TryParse<FilterType>(value, out var f))
            return;

        if (FilterAttrStr == "code")
            Filter.CodeFilterType = f;
        if (FilterAttrStr == "account")
            Filter.AccountFilterType = f;
        if (FilterAttrStr == "name")
            Filter.NameFilterType = f;
        if (FilterAttrStr == "status")
            Filter.StatusFilterType = f;
        if (FilterAttrStr == "resourceType")
            Filter.ResourceFilterType = f;
        if (FilterAttrStr == "resourceTypeSystem")
            Filter.ResourceTypeFilterTypeSystem = f;
        if (FilterAttrStr == "resourceSort")
            Filter.ResourceSortFilterType = f;
        if (FilterAttrStr == "unit")
            Filter.UnitFilterType = f;

        FilterType = f;
        await ApplyCurrentFilterAsync();
    }

    private void SyncCurrentFilterSelection()
    {
        switch (FilterAttrStr)
        {
            case "code":
                FilterValues = Filter.Code;
                FilterType = Filter.CodeFilterType;
                break;
            case "account":
                FilterValues = Filter.Account;
                FilterType = Filter.AccountFilterType;
                break;
            case "name":
                FilterValues = Filter.Name;
                FilterType = Filter.NameFilterType;
                break;
            case "status":
                FilterValues = Filter.Status;
                FilterType = Filter.StatusFilterType;
                break;
            case "resourceType":
                FilterValues = Filter.Resource;
                FilterType = Filter.ResourceFilterType;
                break;
            case "resourceTypeSystem":
                FilterValues = [];
                FilterType = Filter.ResourceTypeFilterTypeSystem;
                break;
            case "resourceSort":
                FilterValues = Filter.ResourceSort;
                FilterType = Filter.ResourceSortFilterType;
                break;
            case "unit":
                FilterValues = Filter.Unit;
                FilterType = Filter.UnitFilterType;
                break;
            default:
                FilterValues = [];
                FilterType = FilterType.equals;
                break;
        }
    }

    private async Task ApplyCurrentFilterAsync()
    {
        CalcService.GetFilter(Filter);
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshFilterAsync()
    {
        CommitPendingTextFilterValue();
        await ApplyCurrentFilterAsync();
    }

    private async Task ApplyAndCloseAsync()
    {
        CommitPendingTextFilterValue();
        await ApplyCurrentFilterAsync();
        display = none;
    }

    private async Task ClearAllFiltersAsync()
    {
        Calc.FilterVM = new FilterVM();
        SyncCurrentFilterSelection();
        fff = string.Empty;
        await ApplyCurrentFilterAsync();
    }

    private async Task ClearCurrentColumnFilterAsync()
    {
        switch (FilterAttrStr)
        {
            case "code":
                Filter.Code.Clear();
                Filter.CodeFilterType = FilterType.equals;
                break;
            case "account":
                Filter.Account.Clear();
                Filter.AccountFilterType = FilterType.equals;
                break;
            case "name":
                Filter.Name.Clear();
                Filter.NameFilterType = FilterType.equals;
                break;
            case "status":
                Filter.Status.Clear();
                Filter.StatusFilterType = FilterType.equals;
                break;
            case "resourceType":
                Filter.Resource.Clear();
                Filter.ResourceFilterType = FilterType.equals;
                break;
            case "resourceTypeSystem":
                Filter.ResourceTypeSystem.Clear();
                Filter.ResourceTypeFilterTypeSystem = FilterType.equals;
                break;
            case "resourceSort":
                Filter.ResourceSort.Clear();
                Filter.ResourceSortFilterType = FilterType.equals;
                break;
            case "unit":
                Filter.Unit.Clear();
                Filter.UnitFilterType = FilterType.equals;
                break;
        }

        SyncCurrentFilterSelection();
        fff = string.Empty;
        await ApplyCurrentFilterAsync();
    }

    private async Task RemoveCurrentStringFilterValue(string value)
    {
        FilterValues.Remove(value);
        await ApplyCurrentFilterAsync();
    }

    private async Task RemoveStatusFilterValue(string value)
    {
        Filter.Status.Remove(value);
        await ApplyCurrentFilterAsync();
    }

    private async Task RemoveResourceFilterValue(string value)
    {
        Filter.Resource.Remove(value);
        await ApplyCurrentFilterAsync();
    }

    private async Task RemoveResourceTypeSystemFilterValue(ResourceTypesEnum value)
    {
        Filter.ResourceTypeSystem.Remove(value);
        await ApplyCurrentFilterAsync();
    }

    private void CommitPendingTextFilterValue()
    {
        if (FilterAttrStr is "status" or "resourceType" or "resourceTypeSystem")
            return;

        if (string.IsNullOrWhiteSpace(fff))
            return;

        var trimmedValue = fff.Trim();
        if (string.IsNullOrWhiteSpace(trimmedValue))
            return;

        if (!FilterValues.Any(x => string.Equals(x, trimmedValue, StringComparison.CurrentCultureIgnoreCase)))
            FilterValues.Add(trimmedValue);

        fff = string.Empty;
    }

    private void OpenPresetsDialog() =>
        DialogService.ShowComponent<CalculationFilterPresetsDialog>(
            "Filter Presets",
            Icons.Storage,
            null,
            MhdDialogSize.Medium,
            btns: [],
            onClosed: null,
            closeOnOverlayClick: true,
            isDraggable: true,
            useOverlay: false);
}
