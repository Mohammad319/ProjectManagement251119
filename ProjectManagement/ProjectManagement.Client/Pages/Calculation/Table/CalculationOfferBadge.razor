@using ProjectManagement.Shared.DTO.Offer

@if (Offer != null && !string.IsNullOrWhiteSpace(BadgeText))
{
    <span class="inline-flex items-center px-1.5 py-0.5 text-[10px] md:text-[11px] rounded-md bg-amber-100 text-amber-800 dark:bg-amber-900 dark:text-amber-100">
        @BadgeText
    </span>

    <span class="ml-0.5 font-bold text-xs text-red-600 hover:text-red-700 cursor-pointer"
          role="button"
          @onclick="TableCoordinator.ClearOfferSelection">
        X
    </span>
}
