@using BlazorMHD.UI.Core.DesignSystem
@using ClosedXML.Excel
@using ProjectManagement.Client.Shared.MVVM.Calculation
@using ProjectManagement.Client.Shared.Model.Project
@using ProjectManagement.Client.Shared.Repositories.Calculation
@using ProjectManagement.Shared.DTO.Calculation
@using System.IO
@inherits AppComponentBase

<div class="space-y-0 " style="--net-task: @UiStyles.Task;--net-subtask: @UiStyles.SubTask;">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-2">
        @if (SheetIsVisible)
        {
            <div>
                <label for="floatingInputGrid">Sheet Nr:</label>
                <input type="number" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" @bind="SheetNr">
            </div>   
        }
        <div>
            <label for="floatingInputGrid">@ResourceApp.StartFromRow:</label>
            <input type="number" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" placeholder="@ResourceApp.StartFromRow" @bind="RowStart" />
        </div>
        <div>
            <div class="flex items-center gap-1 m-5">
                <InputFile type="file"  OnChange="(InputFileChangeEventArgs e) => CheckedChanged(e)"></InputFile>
                @if (workbook != null)
                {
                    <button class="px-2 py-1 bg-blue-600 text-white rounded hover:bg-blue-700 dark:bg-blue-500 mx-1" @onclick="Import" disabled="@wait">@ResourceApp.import</button>
                }
                @if (Sections != null && Sections.Any())
                {
                    <button class="px-2 py-1 bg-blue-600 text-white rounded hover:bg-blue-700 dark:bg-blue-500 mx-1" @onclick="Save" disabled="@wait">@ResourceApp.save</button>
                }
            </div>
        </div>
    </div>
    <div>
        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-600">
            <thead class="bg-gray-100 dark:bg-gray-700">
                <tr>
                    <th class="p-1 text-left text-sm font-semibold" width="80"></th>
                    <th class="p-1 text-left text-sm font-semibold">
                        <input class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" type="number" style="width:45px;" @bind="CodeIndex" />
                        <span>@CalcResource.code</span>
                    </th>
                    <th class="p-1 text-left text-sm font-semibold">
                        <input class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" type="number" style="width:45px;" @bind="NameIndex" />
                        @CalcResource.name
                    </th>
                    <th class="p-1 text-left text-sm font-semibold">
                        <input class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" type="number" style="width:60px;" @bind="UnitIndex" />
                        @CalcResource.unit
                    </th>
                    <th class="p-1 text-left text-sm font-semibold">
                        <input class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" type="number" style="width:45px;" @bind="QuantityIndex" />
                        @CalcResource.quantity
                    </th>
                    <th class="p-1 text-left text-sm font-semibold">
                        <input class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" type="number" style="width:45px;" @bind="PriceIndex" />
                        @CalcResource.price
                    </th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 hover:divide-gray-200 dark:divide-gray-700">
                @if (Sections != null && Sections.Any())
                {
                    @foreach (var Task in Sections)
                    {
                        @TaskRow(Task)
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    RenderFragment TaskRow(TaskPostDTO Task, int left = 0) => __builder =>
    {
        <tr class="@((left == 0 ? "task" : "subTask") + " p-2 hover:bg-gray-100 dark:hover:bg-gray-800")">
            <td class="p-1 text-sm text-gray-800 dark:text-gray-300">
                <span style="margin-left:@(left + "px")" @onclick="() => Sections!.Remove(Task)" role="button">@((MarkupString)Icons.Delete)</span>
                @if (Task.Tasks.Any())
                {
                    <span role="button" @onclick="()=> Task.Colspan = !Task.Colspan" class="ps-2">
                        @((MarkupString)(Icons.RightBottom(Task.Colspan)))
                    </span>
                    }
            </td>
            <td class="p-1 text-sm text-gray-800 dark:text-gray-300"><input class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" type="text" @bind="@Task.Metadata.Code" /></td>
            <td class="p-1 text-sm text-gray-800 dark:text-gray-300"><input class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white"  type="text" @bind="@Task.Name" /></td>
            <td class="p-1 text-sm text-gray-800 dark:text-gray-300"><input  class="p-1 text-sm text-gray-800 dark:text-gray-300" type="text" @bind="@Task.Unit" /></td>
            <td class="p-1 text-sm text-gray-800 dark:text-gray-300"><input  class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" type="number" @bind="@Task.Metadata.Quantity" /></td>
            <td class="p-1 text-sm text-gray-800 dark:text-gray-300"><input class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white"  type="number" @bind="@Task.Metadata.PriceSubDB" /></td>
        </tr>
        if (Task.Colspan)
        {
            if (Task.Tasks != null)
            {
                foreach (var item in Task.Tasks.OrderByDescending(x => x.Order))
                {
                    @TaskRow(item, left + 7)
                }
            }
        }
    };

    void Save() =>
         MHD.MessageYesNo(ResourceApp.save, ResourceApp.DoYouWanTtoSaveTheListInDatabase, 
             MhdState.Primary, EventCallback.Factory.Create(this, () => SaveConfirm()));

    int RowStart = 39;
    string fileUrl = string.Empty;
    List<TaskPostDTO>? Sections;
    bool wait = false;
    int CodeIndex = 1;
    int NameIndex = 2;
    int UnitIndex = 4;
    int QuantityIndex = 5;
    int PriceIndex = 6;
    int SheetNr = 1;
    List<ListOrderDTO>? Statuses;
    bool SheetIsVisible = false;
    async Task SaveConfirm()
    {
        wait = true;
        bool result = await Repo.Task.CreateAsync(Sections, Calc.Id);
        MHD.Notifications(ToastType.Add, result);
        workbook = null;
        wait = false;
        Close();
    }
    XLWorkbook? workbook;
    async Task CheckedChanged(InputFileChangeEventArgs f)
    {
        IBrowserFile File = f.File;
        using MemoryStream memStream = new();
        await File.OpenReadStream(File.Size).CopyToAsync(memStream);
        using XLWorkbook workbook1 = new(memStream);
        workbook = workbook1;
        int count = workbook.Worksheets.Count();
        
        if (count > 0)
        {
            SheetIsVisible = true;
        }
        else
        {
            SheetIsVisible = false;
        }
    }
    private void Import()
    {
        if (workbook == null)
            return;
        wait = true;
        Sections = null;
        Sections = ExcelHelper.Import(SheetNr, workbook, RowStart, CodeIndex, NameIndex, UnitIndex, QuantityIndex, PriceIndex, Calc.OHFactors);
        wait = false;
    }

    protected async override Task OnInitializedAsync()
    {
        Statuses = await Repo.Task.GetAsync(null);
    }

    void Close() => Modal.Close();
}
