    private void InitializeAmountDraftsFromWorkbook(IReadOnlyDictionary<TaskPostDTO, int> rowNumbers, IXLWorksheet sheet)
    {
        foreach (var item in rowNumbers)
        {
            string amount = CellTextDraft(sheet, item.Value, AmountIndex);
            string quantity = CellTextDraft(sheet, item.Value, QuantityIndex);

            if (IsSpreadsheetError(quantity))
                InvalidQuantityDrafts[item.Key] = quantity;

            var taskType = item.Key.Metadata.Type;

            if (taskType == TaskType.FourBarCode)
            {
                AmountDrafts[item.Key] = "-";
            }
            else if (taskType == TaskType.Task || taskType == TaskType.CodeName)
            {
                // kalkylpost and CodeText: no amount display during import
            }
            else if (IsDash(amount))
            {
                AmountDrafts[item.Key] = "-";
            }
            else if (!IsSpreadsheetError(amount) && TryReadDecimal(amount, out decimal amountValue) && amountValue != 0m)
            {
                AmountDrafts[item.Key] = FormatDecimal(amountValue);
            }
        }
    }

    private static string CellTextDraft(IXLWorksheet sheet, int row, int column)
    {
        if (row < 1 || column < 1)
            return string.Empty;

        return (sheet.Cell(row, column).GetFormattedString() ?? string.Empty).Trim();
    }

    private static bool IsLikelyCodeDraft(string text)
    {
        text = NormalizeDraft(text);
        if (string.IsNullOrWhiteSpace(text) || text.Length > 35 || IsLikelyUnitDraft(text))
            return false;

        int whitespaceCount = text.Count(char.IsWhiteSpace);
        if (whitespaceCount > 1)
            return false;

        bool hasDigit = text.Any(char.IsDigit);
        bool hasLetter = text.Any(char.IsLetter);
        bool hasSeparator = text.Any(x => x is '.' or '-' or '_' or '/' or '\\');
        bool allCodeChars = text.All(x => char.IsLetterOrDigit(x) || x is '.' or '-' or '_' or '/' or '\\');
        bool allLettersUpper = text.Where(char.IsLetter).All(char.IsUpper);

        return TryReadDecimal(text, out _)
            || (hasLetter && allCodeChars && text.Length <= 20 && (allLettersUpper || hasDigit || hasSeparator))
            || (hasDigit && (hasLetter || hasSeparator));
    }

    private static bool IsMeaningfulNameDraft(string text)
    {
        text = NormalizeDraft(text);
        return text.Length >= 3 && !TryReadDecimal(text, out _) && !IsLikelyUnitDraft(text);
    }

    private static bool IsLikelyUnitDraft(string text)
    {
        text = NormalizeDraft(text);
        if (string.IsNullOrWhiteSpace(text) || TryReadDecimal(text, out _) || IsDash(text))
            return IsDash(text);

        string key = NormalizeSearch(text).Replace(" ", string.Empty);
        if (KnownUnitKeys.Contains(key))
            return true;

        if (!text.Any(char.IsLower) || text.Contains(':') || text.Contains(';') || text.Contains(',') || text.Length > 8)
            return false;

        int letterCount = key.Count(char.IsLetter);
        int digitCount = key.Count(char.IsDigit);
        return letterCount > 0 && digitCount <= 2 && key.Length <= 8;
    }

    private static bool IsQuantityCell(string text) => IsDash(text) || TryReadDecimal(text, out _);
    private static bool IsPriceCell(string text) => IsDash(text) || TryReadDecimal(text, out _);
    private static bool IsAmountCell(string text) => IsDash(text) || TryReadDecimal(text, out _);

    private static bool IsSpreadsheetError(string? text)
    {
        text = NormalizeDraft(text);
        return text.Length > 1
            && text[0] == '#'
            && (text.Contains('!') || text.Contains("ERROR", StringComparison.OrdinalIgnoreCase) || text.Contains("FEL", StringComparison.OrdinalIgnoreCase));
    }

    private static double Clamp01(double value) => Math.Min(1d, Math.Max(0d, value));

    private static readonly HashSet<string> KnownUnitKeys = new(StringComparer.OrdinalIgnoreCase)
    {
        "m", "m2", "m3", "st", "styck", "kg", "ton", "h", "tim", "dag", "vecka", "manad", "l", "liter",
        "km", "cm", "mm", "par", "set", "pkt", "ls", "rs", "sum", "kr"
    };

    private void InitializeAmountDrafts(IEnumerable<TaskPostDTO>? tasks)
    {
        AmountDrafts.Clear();
        InvalidQuantityDrafts.Clear();
        InitializeAmountDraftsRecursive(tasks);
    }

    private void InitializeAmountDraftsRecursive(IEnumerable<TaskPostDTO>? tasks)
    {
        if (tasks is null)
            return;

        foreach (var task in tasks)
        {
            AmountDrafts[task] = task.Metadata.Type == TaskType.FourBarCode ? "-" : string.Empty;
            InitializeAmountDraftsRecursive(task.Tasks);
        }
    }

    private string FormatUnitDraft(TaskPostDTO task) =>
        TaskTypeRules.DisplaysDashUnit(task.Metadata.Type) ? "-" : task.Unit;

    private string FormatQuantityDraft(TaskPostDTO task) =>
        TaskTypeRules.DisplaysDashQuantity(task.Metadata.Type)
            ? "-"
            : InvalidQuantityDrafts.TryGetValue(task, out string? invalidQuantity)
                ? invalidQuantity
            : FormatDecimal(task.Quantity);

    private string FormatPriceDraft(TaskPostDTO task) =>
        task.Metadata.Type is TaskType.ThreeBarCode or TaskType.FourBarCode
            ? "-"
            : task.Metadata.Type == TaskType.Task
                ? string.Empty
                : FormatDecimal(task.Metadata.PriceSubDB);

    private string FormatAmountDraft(TaskPostDTO task) =>
        AmountDrafts.TryGetValue(task, out var value) ? value : string.Empty;

    private string? GetDashQuantityTooltip(TaskPostDTO task) =>
        task.Metadata.Type == TaskType.ThreeBarCode ? DashQuantityTooltip : null;

    private void OnUnitChanged(TaskPostDTO task, string? value)
    {
        PreviewRequiresImport = true;
        value = NormalizeDraft(value);
        if (IsSpreadsheetError(value))
            value = string.Empty;

        if (!IsDash(value))
            ConvertDashRowToEditableTask(task);

        task.Unit = value;
        MarkPreviewChanged(task);
    }

    private void OnQuantityChanged(TaskPostDTO task, string? value)
    {
        PreviewRequiresImport = true;
        value = NormalizeDraft(value);
        InvalidQuantityDrafts.Remove(task);
        if (IsDash(value))
        {
            ApplyDashGroup(task, includeAmount: false);
            return;
        }

        ConvertDashRowToEditableTask(task);
        if (TryReadDecimal(value, out var quantity))
        {
            task.Quantity = quantity;
            task.Metadata.BaseQuantity = quantity;
            task.Metadata.QuantityParam = ConstValues.FixedQ;
        }
        else
        {
            task.Quantity = null;
            task.Metadata.BaseQuantity = null;
            task.Metadata.QuantityParam = string.Empty;
            if (!string.IsNullOrWhiteSpace(value))
                InvalidQuantityDrafts[task] = value;
        }

        MarkPreviewChanged(task);
    }

    private void OnPriceChanged(TaskPostDTO task, string? value)
    {
        PreviewRequiresImport = true;
        value = NormalizeDraft(value);
        if (IsDash(value))
        {
            ApplyDashGroup(task, includeAmount: false);
            return;
        }

        ConvertDashRowToEditableTask(task);
        task.Metadata.PriceSubDB = TryReadDecimal(value, out var price) && price != 0m ? price : null;
        MarkPreviewChanged(task);
    }

    private void OnAmountChanged(TaskPostDTO task, string? value)
    {
        PreviewRequiresImport = true;
        value = NormalizeDraft(value);
        if (IsDash(value))
        {
            ApplyDashGroup(task, includeAmount: true);
            return;
        }

        AmountDrafts[task] = TryReadDecimal(value, out var amount) && amount != 0m
            ? FormatDecimal(amount)
            : string.Empty;
        if (task.Metadata.Type == TaskType.FourBarCode)
            ApplyDashGroup(task, includeAmount: false);

        MarkPreviewChanged(task);
    }

    private void ApplyDashGroup(TaskPostDTO task, bool includeAmount)
    {
        task.Metadata.Type = includeAmount ? TaskType.FourBarCode : TaskType.ThreeBarCode;
        task.Unit = "-";
        task.Metadata.PriceSubDB = null;
        task.Metadata.QuantityParam = includeAmount ? string.Empty : ConstValues.FixedQ;
        task.Metadata.BaseQuantity = includeAmount ? null : 1m;
        task.Quantity = includeAmount ? null : 1m;
        AmountDrafts[task] = includeAmount ? "-" : FormatAmountDraft(task);
        MarkPreviewChanged(task);
    }

    private void ConvertDashRowToEditableTask(TaskPostDTO task)
    {
        if (task.Metadata.Type is not (TaskType.ThreeBarCode or TaskType.FourBarCode))
            return;

        task.Metadata.Type = TaskType.Task;
        if (task.Unit == "-")
            task.Unit = string.Empty;

        task.Metadata.QuantityParam = ConstValues.FixedQ;
        task.Metadata.BaseQuantity ??= task.Quantity ?? 1m;
        task.Quantity ??= task.Metadata.BaseQuantity;
        AmountDrafts[task] = string.Empty;
    }

    private void AddRowAfter(List<TaskPostDTO> siblings, TaskPostDTO current)
    {
        int index = siblings.IndexOf(current);
        if (index < 0)
            return;

        var task = new TaskPostDTO
        {
            Name = T("Ny post", "New item"),
            Unit = T("Enhet", "Unit"),
            Quantity = 1m,
            Tasks = [],
            Metadata = new TaskMetadata
            {
                Type = TaskType.Task,
                QuantityParam = ConstValues.FixedQ,
                BaseQuantity = 1m,
                IsOH = Calc.OHFactors
            }
        };

        siblings.Insert(index + 1, task);
        AmountDrafts[task] = string.Empty;
        if (OriginalRowNumbers.TryGetValue(current, out string? currentRow))
            OriginalRowNumbers[task] = GetNextInsertedRowNumber(currentRow, siblings);
        OriginalTaskSnapshots[task] = TaskPreviewSnapshot.From(task, AmountDrafts[task]);
        NewTasks.Add(task);
        MarkPreviewChanged(task);
    }

    private void RemoveSection(List<TaskPostDTO> siblings, TaskPostDTO task)
    {
        siblings.Remove(task);
        RemoveTaskStateRecursive(task);
        MarkPreviewChanged();
    }

    private string GetNextInsertedRowNumber(string baseRow, IEnumerable<TaskPostDTO> siblings)
    {
        string prefix = baseRow.Contains('.') ? baseRow[..baseRow.IndexOf('.')] : baseRow;
        int next = siblings
            .Select(x => OriginalRowNumbers.TryGetValue(x, out string? row) ? row : string.Empty)
            .Where(x => x.StartsWith(prefix + ".", StringComparison.Ordinal))
            .Select(x => int.TryParse(x[(prefix.Length + 1)..], NumberStyles.Integer, CultureInfo.InvariantCulture, out int suffix) ? suffix : 0)
            .DefaultIfEmpty(0)
            .Max() + 1;

        return $"{prefix}.{next}";
    }

    private IEnumerable<PreviewMetric> BuildPreviewMetrics()
    {
        var summary = CountTasks(Sections);
        int warnings = FlattenTasksWithDepth(Sections).Count(row => GetTaskDiagnostics(row.Task, row.Depth).Any(x => x.Kind == DiagnosticKind.Warning));
        int changed = ChangedTasks.Count;

        yield return new PreviewMetric($"{T("Totala rader", "Total rows")}: {summary.TotalRows}", T("Importerade rader", "Imported rows"), "rounded bg-slate-100 px-1.5 py-0.5 text-[11px] font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-200");
        yield return new PreviewMetric($"{T("Kalkylposter", "Calc. items")}: {summary.CalculationItems}", T("Inklusive 3- och 4-streckade koder.", "Includes 3- and 4-bar codes."), "rounded bg-slate-100 px-1.5 py-0.5 text-[11px] font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-200");
        yield return new PreviewMetric($"{T("3-streckade koder", "3-bar codes")}: {summary.ThreeBarCode}", T("Mängd räknas som 1 men visas som '-'.", "Quantity counted as 1 but displayed as '-'."), "rounded bg-blue-100 px-1.5 py-0.5 text-[11px] font-semibold text-blue-700 dark:bg-blue-950 dark:text-blue-300");
        yield return new PreviewMetric($"{T("4-streckade koder", "4-bar codes")}: {summary.FourBarCode}", T("Endast kod/namn, inga barn eller resurser.", "Code/name only, no children or resources."), "rounded bg-indigo-100 px-1.5 py-0.5 text-[11px] font-semibold text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300");
        yield return new PreviewMetric($"{T("Rader med varningar", "Rows with warnings")}: {warnings}", T("Rader som behöver granskas innan överföring.", "Rows that need review before transfer."), "rounded bg-amber-100 px-1.5 py-0.5 text-[11px] font-semibold text-amber-700 dark:bg-amber-950 dark:text-amber-300");

        if (changed > 0)
            yield return new PreviewMetric($"{T("Ändrade", "Changed")} {changed}", T("Rader som ändrats manuellt i förhandsgranskningen.", "Rows changed manually in the preview."), "rounded bg-violet-100 px-1.5 py-0.5 text-[11px] font-semibold text-violet-700 dark:bg-violet-950 dark:text-violet-300");
    }

    private IEnumerable<PreviewRow> BuildVisiblePreviewRows()
    {
        if (Sections is null)
            yield break;

        foreach (var row in BuildVisiblePreviewRows(Sections, 0, null))
            yield return row;
    }

    // A sibling counts as a tree-visible node when it has a code or has children.
    // Rows that have neither don't anchor to the tree and must not extend vertical guide lines.
    private static bool IsTreeAnchor(TaskPostDTO task) =>
        !string.IsNullOrWhiteSpace(task.Metadata.Code) || task.Tasks.Any();

    private IEnumerable<PreviewRow> BuildVisiblePreviewRows(List<TaskPostDTO> siblings, int depth, List<TaskPostDTO>? parentSiblings, bool[]? ancestorHasNextSibling = null)
    {
        for (int i = 0; i < siblings.Count; i++)
        {
            var task = siblings[i];
            // In tree view: a sibling only extends the vertical guide line if at least one
            // later sibling will actually render a tree anchor (has code or children).
            // This ensures └─ is used for the last real tree-node and no vertical line
            // continues past it, while code-less rows between anchors are invisible to the guide.
            bool hasNextSibling = IsTreeView
                ? siblings.Skip(i + 1).Any(IsTreeAnchor)
                : i < siblings.Count - 1;
            int effectiveDepth = IsTreeView ? depth : 0;
            bool matches = MatchesPreviewFilter(task, effectiveDepth);
            if (matches)
                yield return new PreviewRow(task, siblings, effectiveDepth, parentSiblings, ancestorHasNextSibling, hasNextSibling);

            bool shouldRecurse = !IsTreeView || HasActivePreviewFilter || task.Colspan;
            if (shouldRecurse && task.Tasks is { Count: > 0 })
            {
                bool[] childAncestorHasNextSibling = new bool[depth + 1];
                if (ancestorHasNextSibling is not null)
                    Array.Copy(ancestorHasNextSibling, childAncestorHasNextSibling, Math.Min(ancestorHasNextSibling.Length, depth));
                childAncestorHasNextSibling[depth] = hasNextSibling;
                foreach (var child in BuildVisiblePreviewRows(task.Tasks, depth + 1, siblings, childAncestorHasNextSibling))
                    yield return child;
            }
        }
    }

    private bool MatchesPreviewFilter(TaskPostDTO task, int depth)
    {
        if (WarningsOnly && !GetTaskDiagnostics(task, depth).Any(x => x.Kind == DiagnosticKind.Warning))
            return false;

        if (!MatchesTypeFilter(task, depth))
            return false;

        string search = NormalizeSearch(PreviewSearchText);
        if (string.IsNullOrWhiteSpace(search))
            return true;

        string haystack = NormalizeSearch($"{task.Metadata.Code} {task.Name} {task.Unit}");
        return haystack.Contains(search, StringComparison.Ordinal);
    }

    private bool MatchesTypeFilter(TaskPostDTO task, int depth) => PreviewTypeFilter switch
    {
        ImportPreviewTypeFilter.All => true,
        ImportPreviewTypeFilter.CalculationItems => task.Metadata.Type is TaskType.Task or TaskType.ThreeBarCode or TaskType.FourBarCode,
        ImportPreviewTypeFilter.Task => task.Metadata.Type == TaskType.Task,
        ImportPreviewTypeFilter.CodeText => task.Metadata.Type == TaskType.CodeName,
        ImportPreviewTypeFilter.ThreeBarCode => task.Metadata.Type == TaskType.ThreeBarCode,
        ImportPreviewTypeFilter.FourBarCode => task.Metadata.Type == TaskType.FourBarCode,
        ImportPreviewTypeFilter.Warnings => GetTaskDiagnostics(task, depth).Any(x => x.Kind == DiagnosticKind.Warning),
        ImportPreviewTypeFilter.Changed => ChangedTasks.Contains(task),
        _ => true
    };

