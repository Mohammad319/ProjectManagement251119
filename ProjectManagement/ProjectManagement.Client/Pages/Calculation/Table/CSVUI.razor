@using BlazorMHD.UI.Core.DesignSystem
@using ClosedXML.Excel
@using ProjectManagement.Client.Shared.MVVM.Calculation
@using ProjectManagement.Client.Shared.Model.Project
@using ProjectManagement.Client.Shared.Repositories.Calculation
@using ProjectManagement.Shared.DTO.Calculation
@using System.IO
@inherits AppComponentBase

<div class="space-y-3 p-3 text-slate-800 dark:text-slate-100" style="--net-task: @UiStyles.Task;--net-subtask: @UiStyles.SubTask;">
    <div class="rounded-xl border border-slate-200 bg-slate-50 p-3 dark:border-slate-700 dark:bg-slate-800/60">
        <div class="grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-4">
            @if (SheetIsVisible)
            {
                <div class="flex flex-col gap-1">
                    <label class="text-sm font-medium text-slate-700 dark:text-slate-300">@AppLoc["sheetNr"]</label>
                    <input type="number"
                           class="h-9 w-full rounded-lg border border-slate-300 bg-white px-2 py-1 text-sm text-slate-900 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 dark:focus:border-blue-400 dark:focus:ring-blue-400/20"
                           @bind="SheetNr" />
                </div>
            }

            <div class="flex flex-col gap-1">
                <label class="text-sm font-medium text-slate-700 dark:text-slate-300">@ResourceApp.StartFromRow</label>
                <input type="number"
                       class="h-9 w-full rounded-lg border border-slate-300 bg-white px-2 py-1 text-sm text-slate-900 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 dark:focus:border-blue-400 dark:focus:ring-blue-400/20"
                       placeholder="@ResourceApp.StartFromRow"
                       @bind="RowStart" />
            </div>

            <div class="flex min-w-0 flex-col gap-1 xl:col-span-2">
                <label class="text-sm font-medium text-slate-700 dark:text-slate-300">@AppLoc["file"]</label>
                <div class="flex flex-wrap items-center gap-2 rounded-lg border border-slate-200 bg-white px-2 py-2 dark:border-slate-700 dark:bg-slate-900">
                    <InputFile type="file" OnChange="(InputFileChangeEventArgs e) => CheckedChanged(e)"></InputFile>

                    @if (workbook != null)
                    {
                        <button type="button"
                                class="inline-flex h-8 items-center justify-center rounded-lg border border-blue-600 bg-blue-600 px-3 text-sm font-medium text-white transition hover:bg-blue-700 disabled:cursor-not-allowed disabled:opacity-60 dark:border-blue-500 dark:bg-blue-500 dark:hover:bg-blue-400 dark:hover:text-slate-900"
                                @onclick="Import"
                                disabled="@wait">
                            @ResourceApp.import
                        </button>
                    }

                    @if (Sections != null && Sections.Any())
                    {
                        <button type="button"
                                class="inline-flex h-8 items-center justify-center rounded-lg border border-emerald-600 bg-emerald-600 px-3 text-sm font-medium text-white transition hover:bg-emerald-700 disabled:cursor-not-allowed disabled:opacity-60 dark:border-emerald-500 dark:bg-emerald-500 dark:hover:bg-emerald-400 dark:hover:text-slate-900"
                                @onclick="Save"
                                disabled="@wait">
                            @ResourceApp.save
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-700">
        <table class="min-w-[780px] w-full border-collapse text-sm">
            <thead class="bg-slate-100 dark:bg-slate-800">
                <tr>
                    <th class="border border-slate-300 px-2 py-2 text-start font-semibold text-slate-700 dark:border-slate-700 dark:text-slate-200" width="84"></th>
                    <th class="border border-slate-300 px-2 py-2 text-start font-semibold text-slate-700 dark:border-slate-700 dark:text-slate-200">
                        <div class="flex items-center gap-2 whitespace-nowrap">
                            <input class="h-8 w-14 rounded-md border border-slate-300 bg-white px-2 text-sm text-slate-900 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 dark:focus:border-blue-400 dark:focus:ring-blue-400/20"
                                   type="number"
                                   @bind="CodeIndex" />
                            <span>@CalcResource.code</span>
                        </div>
                    </th>
                    <th class="border border-slate-300 px-2 py-2 text-start font-semibold text-slate-700 dark:border-slate-700 dark:text-slate-200">
                        <div class="flex items-center gap-2 whitespace-nowrap">
                            <input class="h-8 w-14 rounded-md border border-slate-300 bg-white px-2 text-sm text-slate-900 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 dark:focus:border-blue-400 dark:focus:ring-blue-400/20"
                                   type="number"
                                   @bind="NameIndex" />
                            <span>@CalcResource.name</span>
                        </div>
                    </th>
                    <th class="border border-slate-300 px-2 py-2 text-start font-semibold text-slate-700 dark:border-slate-700 dark:text-slate-200">
                        <div class="flex items-center gap-2 whitespace-nowrap">
                            <input class="h-8 w-16 rounded-md border border-slate-300 bg-white px-2 text-sm text-slate-900 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 dark:focus:border-blue-400 dark:focus:ring-blue-400/20"
                                   type="number"
                                   @bind="UnitIndex" />
                            <span>@CalcResource.unit</span>
                        </div>
                    </th>
                    <th class="border border-slate-300 px-2 py-2 text-start font-semibold text-slate-700 dark:border-slate-700 dark:text-slate-200">
                        <div class="flex items-center gap-2 whitespace-nowrap">
                            <input class="h-8 w-14 rounded-md border border-slate-300 bg-white px-2 text-sm text-slate-900 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 dark:focus:border-blue-400 dark:focus:ring-blue-400/20"
                                   type="number"
                                   @bind="QuantityIndex" />
                            <span>@CalcResource.quantity</span>
                        </div>
                    </th>
                    <th class="border border-slate-300 px-2 py-2 text-start font-semibold text-slate-700 dark:border-slate-700 dark:text-slate-200">
                        <div class="flex items-center gap-2 whitespace-nowrap">
                            <input class="h-8 w-14 rounded-md border border-slate-300 bg-white px-2 text-sm text-slate-900 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 dark:focus:border-blue-400 dark:focus:ring-blue-400/20"
                                   type="number"
                                   @bind="PriceIndex" />
                            <span>@CalcResource.price</span>
                        </div>
                    </th>
                </tr>
            </thead>
            <tbody>
                @if (Sections != null && Sections.Any())
                {
                    @foreach (var Task in Sections)
                    {
                        @TaskRow(Task)
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    RenderFragment TaskRow(TaskPostDTO Task, int left = 0) => __builder =>
    {
        <tr class="@(left == 0 ? "task" : "subTask") border-b border-slate-200 dark:border-slate-700">
            <td class="border border-slate-300 px-2 py-1.5 dark:border-slate-700">
                <div class="flex items-center gap-2" style="margin-left:@($"{left}px")">
                    <span class="cursor-pointer text-slate-500 transition hover:text-red-600 dark:text-slate-400 dark:hover:text-red-400"
                          @onclick="() => Sections!.Remove(Task)"
                          role="button">
                        @((MarkupString)Icons.Delete)
                    </span>

                    @if (Task.Tasks.Any())
                    {
                        <span role="button"
                              @onclick="() => Task.Colspan = !Task.Colspan"
                              class="cursor-pointer text-slate-500 transition hover:text-blue-600 dark:text-slate-400 dark:hover:text-blue-400">
                            @((MarkupString)(Icons.RightBottom(Task.Colspan)))
                        </span>
                    }
                </div>
            </td>
            <td class="border border-slate-300 px-2 py-1.5 dark:border-slate-700">
                <input class="h-8 w-full rounded-md border border-slate-300 bg-white px-2 text-sm text-slate-900 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-blue-400 dark:focus:ring-blue-400/20"
                       type="text"
                       @bind="@Task.Metadata.Code" />
            </td>
            <td class="border border-slate-300 px-2 py-1.5 dark:border-slate-700">
                <input class="h-8 w-full rounded-md border border-slate-300 bg-white px-2 text-sm text-slate-900 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-blue-400 dark:focus:ring-blue-400/20"
                       type="text"
                       @bind="@Task.Name" />
            </td>
            <td class="border border-slate-300 px-2 py-1.5 dark:border-slate-700">
                <input class="h-8 w-full rounded-md border border-slate-300 bg-white px-2 text-sm text-slate-900 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-blue-400 dark:focus:ring-blue-400/20"
                       type="text"
                       @bind="@Task.Unit" />
            </td>
            <td class="border border-slate-300 px-2 py-1.5 dark:border-slate-700">
                <input class="h-8 w-full rounded-md border border-slate-300 bg-white px-2 text-sm text-slate-900 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-blue-400 dark:focus:ring-blue-400/20"
                       type="number"
                       @bind="@Task.Metadata.Quantity" />
            </td>
            <td class="border border-slate-300 px-2 py-1.5 dark:border-slate-700">
                <input class="h-8 w-full rounded-md border border-slate-300 bg-white px-2 text-sm text-slate-900 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-blue-400 dark:focus:ring-blue-400/20"
                       type="number"
                       @bind="@Task.Metadata.PriceSubDB" />
            </td>
        </tr>

        if (Task.Colspan)
        {
            if (Task.Tasks != null)
            {
                foreach (var item in Task.Tasks.OrderByDescending(x => x.Order))
                {
                    @TaskRow(item, left + 7)
                }
            }
        }
    };

    void Save() =>
         MHD.MessageYesNo(ResourceApp.save, ResourceApp.DoYouWanTtoSaveTheListInDatabase,
             MhdState.Primary, EventCallback.Factory.Create(this, () => SaveConfirm()));

    int RowStart = 39;
    string fileUrl = string.Empty;
    List<TaskPostDTO>? Sections;
    bool wait = false;
    int CodeIndex = 1;
    int NameIndex = 2;
    int UnitIndex = 4;
    int QuantityIndex = 5;
    int PriceIndex = 6;
    int SheetNr = 1;
    List<ListOrderDTO>? Statuses;
    bool SheetIsVisible = false;

    async Task SaveConfirm()
    {
        wait = true;
        bool result = await Repo.Task.CreateAsync(Sections, Calc.Id);
        MHD.Notifications(ToastType.Add, result);
        workbook = null;
        wait = false;
        Close();
    }

    XLWorkbook? workbook;

    async Task CheckedChanged(InputFileChangeEventArgs f)
    {
        IBrowserFile File = f.File;
        using MemoryStream memStream = new();
        await File.OpenReadStream(File.Size).CopyToAsync(memStream);
        using XLWorkbook workbook1 = new(memStream);
        workbook = workbook1;
        int count = workbook.Worksheets.Count();

        if (count > 0)
        {
            SheetIsVisible = true;
        }
        else
        {
            SheetIsVisible = false;
        }
    }

    private void Import()
    {
        if (workbook == null)
            return;

        wait = true;
        Sections = null;
        Sections = ExcelHelper.Import(SheetNr, workbook, RowStart, CodeIndex, NameIndex, UnitIndex, QuantityIndex, PriceIndex, Calc.OHFactors);
        wait = false;
    }

    protected async override Task OnInitializedAsync()
    {
        Statuses = await Repo.Task.GetAsync(null);
    }

    void Close() => Modal.Close();
}
