    private void MoveTaskIn(List<TaskPostDTO> siblings, TaskPostDTO task)
    {
        int idx = siblings.IndexOf(task);
        if (idx <= 0) return;
        var prev = siblings[idx - 1];
        siblings.RemoveAt(idx);
        prev.Tasks ??= [];
        prev.Tasks.Add(task);
        prev.Colspan = true;
        MarkPreviewChanged();
    }

    private void MoveTaskOut(List<TaskPostDTO> siblings, TaskPostDTO task, List<TaskPostDTO>? parentSiblings)
    {
        if (parentSiblings is null) return;
        TaskPostDTO? parent = null;
        foreach (var s in parentSiblings)
        {
            if (s.Tasks == siblings) { parent = s; break; }
        }
        if (parent is null) return;
        int parentIdx = parentSiblings.IndexOf(parent);
        siblings.Remove(task);
        parentSiblings.Insert(parentIdx + 1, task);
        MarkPreviewChanged();
    }

    private void OnTreeViewModeChanged(ChangeEventArgs args)
    {
        TreeViewMode = args.Value?.ToString() ?? "all";
        if (TreeViewMode == "all")
        {
            ExpandAll();
            return;
        }

        if (TreeViewMode == "none")
        {
            CollapseAll();
            return;
        }

        if (int.TryParse(TreeViewMode, NumberStyles.Integer, CultureInfo.InvariantCulture, out int level))
            ExpandToLevel(Math.Clamp(level, 1, MaxTreeLevel));
    }

