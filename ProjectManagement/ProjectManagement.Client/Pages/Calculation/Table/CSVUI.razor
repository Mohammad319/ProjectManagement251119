    private List<DiagnosticItem> GetTaskDiagnostics(TaskPostDTO task, int? depth = null)
    {
        var diagnostics = new List<DiagnosticItem>();
        var added = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        string unitDraft = FormatUnitDraft(task);
        string quantityDraft = FormatQuantityDraft(task);
        string priceDraft = FormatPriceDraft(task);
        string amountDraft = FormatAmountDraft(task);
        bool hasName = !string.IsNullOrWhiteSpace(task.Name) && !string.Equals(NormalizeDraft(task.Name), T("Namn saknas", "Name missing"), StringComparison.OrdinalIgnoreCase);
        bool hasUnit = !string.IsNullOrWhiteSpace(unitDraft) && !IsDash(unitDraft);
        bool unitDash = IsDash(unitDraft);
        bool quantityDash = IsDash(quantityDraft);
        bool priceDash = IsDash(priceDraft);
        bool amountDash = IsDash(amountDraft);
        bool hasValidQuantity = TryReadDecimal(quantityDraft, out _);
        bool quantityInvalid = InvalidQuantityDrafts.ContainsKey(task)
            || (!string.IsNullOrWhiteSpace(quantityDraft) && !quantityDash && !hasValidQuantity);
        bool hasQuantity = hasValidQuantity;
        bool regularTask = task.Metadata.Type == TaskType.Task;
        bool hasIncompleteCalculationData = hasUnit || hasQuantity || unitDash || quantityDash || priceDash || amountDash || quantityInvalid;

        void Add(DiagnosticKind kind, string shortSv, string shortEn, string detailSv, string detailEn)
        {
            string shortText = T(shortSv, shortEn);
            if (added.Add(shortText))
                diagnostics.Add(new DiagnosticItem(kind, shortText, T(detailSv, detailEn)));
        }

        // Ogiltig mängd – ENDAST för kvantitetskolumnen
        if (quantityInvalid)
            Add(
                DiagnosticKind.Warning,
                "Ogiltig mängd", "Invalid quantity",
                "Kvantitet innehåller ett ogiltigt numeriskt värde, t.ex. #VÄRDEFEL!.",
                "Quantity contains an invalid numeric value, e.g. #VALUE!.");

        // Namn saknas – när raden har kalkylsignaler men inget namn
        if (!hasName && hasIncompleteCalculationData)
            Add(
                DiagnosticKind.Warning,
                "Namn saknas", "Name missing",
                "Raden innehåller kalkyldata men saknar namn/beskrivning.",
                "The row contains calculation data but no name/description.");

        // Kalkylpost: mängd saknas
        if (regularTask && !hasQuantity && !quantityInvalid && (hasUnit || unitDash) && !quantityDash)
            Add(
                DiagnosticKind.Warning,
                "Mängd saknas", "Quantity missing",
                "Raden har importerats som en kalkylpost. Komplettera vid behov mängden eller ändra typen till 3-streckad kod, 4-streckad kod eller kodtext.",
                "The row was imported as a calculation item. Complete the quantity if needed, or change the type to 3-bar code, 4-bar code, or code text.");

        // Kalkylpost: enhet saknas
        if (regularTask && !hasUnit && !unitDash && hasQuantity && !TaskTypeRules.DisplaysDashUnit(task.Metadata.Type))
            Add(
                DiagnosticKind.Warning,
                "Enhet saknas", "Unit missing",
                "Raden har importerats som en kalkylpost. Komplettera vid behov enheten eller ändra typen till 3-streckad kod, 4-streckad kod eller kodtext.",
                "The row was imported as a calculation item. Complete the unit if needed, or change the type to 3-bar code, 4-bar code, or code text.");

        // 3-streckad kod: varna om appen kompletterade uppgifter och varningen inte avfärdats
        if (task.Metadata.Type == TaskType.ThreeBarCode
            && AppCompletedBarCodeRows.Contains(task)
            && !DismissedBarCodeWarnings.Contains(task))
            Add(
                DiagnosticKind.Warning,
                "3-streckad kod", "3-bar code",
                "Raden har importerats som en 3-streckad kod. Appen fyllde i saknade streck (\"-\") i enhet, mängd eller á-pris. Kontrollera att typen är korrekt.",
                "The row was imported as a 3-bar code. The app filled in missing dashes (\"-\") in unit, quantity, or unit price. Verify the type is correct.");

        // 4-streckad kod: varna om appen kompletterade uppgifter och varningen inte avfärdats
        if (task.Metadata.Type == TaskType.FourBarCode
            && AppCompletedBarCodeRows.Contains(task)
            && !DismissedBarCodeWarnings.Contains(task))
            Add(
                DiagnosticKind.Warning,
                "4-streckad kod", "4-bar code",
                "Raden har importerats som en 4-streckad kod. Appen fyllde i saknade streck (\"-\") i enhet, mängd, á-pris eller belopp. Kontrollera att typen är korrekt.",
                "The row was imported as a 4-bar code. The app filled in missing dashes (\"-\") in unit, quantity, unit price, or amount. Verify the type is correct.");

        // 4-streckad kod ska vara slutrad
        if (task.Metadata.Type == TaskType.FourBarCode && (task.Tasks.Count > 0 || task.Resources.Count > 0))
            Add(
                DiagnosticKind.Warning,
                "Ogiltig struktur", "Invalid structure",
                "4-streckad kod ska vara en slutrad utan underrader.",
                "4-bar code must be a leaf row without children.");

        return diagnostics;
    }

    private double GetRowConfidence(TaskPostDTO task, IReadOnlyList<DiagnosticItem> diagnostics)
    {
        double score = 0.92;
        score -= diagnostics.Count(x => x.Kind == DiagnosticKind.Warning) * 0.22;

        if (ChangedTasks.Contains(task))
            score -= 0.05;

        return Clamp01(score);
    }

