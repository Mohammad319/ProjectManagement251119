    async Task SaveConfirm(bool closeImportWindow = false)
    {
        if (Sections is null || Sections.Count == 0)
        {
            wait = false;
            return;
        }

        try
        {
            wait = true;
            var createdTasks = await Repo.Task.CreateAsync(Sections, Calc.Id);
            bool result = createdTasks.Count > 0;
            if (result)
            {
                await CalcService.AddCreatedTasksOrRefreshAsync(createdTasks);
                transferCompleted = true;
                Sections = null;
                AmountDrafts.Clear();
                InvalidQuantityDrafts.Clear();
                ChangedTasks.Clear();
                NewTasks.Clear();
                OriginalTaskSnapshots.Clear();
                OriginalRowNumbers.Clear();
                ImportMessage = T("Överföringen till kalkylen lyckades!", "Transfer to calculation successful!");
                ImportMessageIsSuccess = true;
                if (closeImportWindow)
                    Close();
            }

            MHD.Notifications(ToastType.Add, result);
        }
        finally
        {
            wait = false;
        }
    }

    XLWorkbook? workbook;
    MemoryStream? workbookStream;

    async Task CheckedChanged(InputFileChangeEventArgs f)
    {
        try
        {
            IBrowserFile File = f.File;
            SelectedFileName = File.Name;
            using MemoryStream memStream = new();
            await File.OpenReadStream(File.Size).CopyToAsync(memStream);
            workbookBytes = memStream.ToArray();

            Sections = null;
            AmountDrafts.Clear();
            InvalidQuantityDrafts.Clear();
            ChangedTasks.Clear();
            NewTasks.Clear();
            OriginalTaskSnapshots.Clear();
            OriginalRowNumbers.Clear();
            PreviewSearchText = string.Empty;
            PreviewTypeFilter = ImportPreviewTypeFilter.All;
            TreeViewMode = "all";
            DisplayMode = "overview";
            WarningsOnly = false;
            PreviewRequiresImport = false;
            ImportMessage = string.Empty;
            ImportMessageIsSuccess = false;
            transferCompleted = false;
            SheetOptions = new();
            SheetIsVisible = false;
            SuggestedLayout = null;

            LoadWorkbook();

            if (workbook != null)
            {
                SheetOptions = ExcelHelper.GetWorksheetOptions(workbook);
                SheetIsVisible = SheetOptions.Any();

                if (SheetIsVisible)
                {
                    var detectedLayout = ExcelHelper.DetectLayout(workbook);
                    if (detectedLayout.IsDetected)
                    {
                        ApplyDetectedLayout(detectedLayout);
                        await SaveLayoutAsync();
                    }
                    else
                    {
                        bool restored = await RestoreSavedLayoutAsync();
                        ImportMessage = restored
                            ? T("Kunde inte identifiera layouten automatiskt. Tidigare sparad layout används.", "Could not detect the layout automatically. The previously saved layout is being used.")
                            : T("Kunde inte identifiera layouten automatiskt. Kontrollera blad, rader och kolumner manuellt.", "Could not detect the layout automatically. Check sheet, rows and columns manually.");
                        ImportMessageIsSuccess = false;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            workbook?.Dispose();
            workbook = null;
            workbookStream?.Dispose();
            workbookStream = null;
            SheetOptions = new();
            SheetIsVisible = false;
            SelectedFileName = string.Empty;
            ImportMessage = T($"Det gick inte att läsa Excel-filen: {ex.Message}", $"Failed to read Excel file: {ex.Message}");
            ImportMessageIsSuccess = false;
        }
    }

    async Task OnSheetChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out int selectedSheet))
        {
            SheetNr = selectedSheet;
            ResetImportedPreview();
            await DetectCurrentSheetAsync(reimportPreview: false);
            await SaveLayoutAsync();
        }
    }

    void OnRowStartChanged(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var row))
            return;

        RowStart = Math.Max(1, row);
        if (RowEnd < RowStart)
            RowEnd = RowStart;

        ResetImportedPreview();
        _ = SaveLayoutAsync();
    }

    private void OnMappingColumnChanged(ref int target, int value)
    {
        target = Math.Max(1, value);
        PreviewRequiresImport = HasImportedPreview;
        if (transferCompleted)
        {
            transferCompleted = false;
            PreviewRequiresImport = false;
        }

        _ = SaveLayoutAsync();
    }

    void OnRowEndChanged(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var row))
            return;

        RowEnd = Math.Max(RowStart, row);
        ResetImportedPreview();
        _ = SaveLayoutAsync();
    }

    private async Task DetectCurrentSheetAsync(bool reimportPreview)
    {
        if (!EnsureWorkbook())
            return;

        bool hadImportedPreview = reimportPreview && HasImportedPreview;
        try
        {
            ImportMessage = T("Identifierar automatiskt...", "Auto-detecting...");
            ImportMessageIsSuccess = false;
            await SetBusyAsync(true);

            XLWorkbook currentWorkbook = workbook!;
            int selectedStartRow = RowStart;
            var detectedLayout = ExcelHelper.DetectLayout(currentWorkbook, SheetNr);
            if (!detectedLayout.IsDetected)
            {
                ImportMessage = T("Inga automatiska förslag hittades för det valda bladet.", "No automatic suggestions were found for the selected sheet.");
                ImportMessageIsSuccess = false;
                return;
            }

            if (selectedStartRow > 1)
                detectedLayout.RowStart = selectedStartRow;

            bool layoutWasAlreadyApplied = LayoutMatchesCurrent(detectedLayout);
            ApplyDetectedLayout(detectedLayout);
            if (hadImportedPreview)
            {
                string actionMessage = BuildLayoutActionMessage(
                    layoutWasAlreadyApplied
                        ? T("Nuvarande inställningar matchar redan automatiska förslag.", "The current settings already match the automatic suggestions.")
                        : T("Automatiska förslag har tillämpats.", "Automatic suggestions applied."),
                    detectedLayout);
                await ImportAsync(manageWait: false, completionPrefix: actionMessage);
            }
            else
            {
                await SaveLayoutAsync();
                ImportMessage = BuildLayoutActionMessage(
                    layoutWasAlreadyApplied
                        ? T("Nuvarande inställningar matchar redan automatiska förslag.", "The current settings already match the automatic suggestions.")
                        : T("Automatiska förslag har tillämpats.", "Automatic suggestions applied."),
                    detectedLayout);
                ImportMessageIsSuccess = true;
            }
        }
        finally
        {
            await SetBusyAsync(false);
        }
    }

    void ApplyDetectedLayout(ExcelImportLayout layout)
    {
        SheetNr = layout.SheetIndex;

        if (!layout.IsDetected)
        {
            return;
        }

        RowStart = layout.RowStart;
        RowEnd = layout.RowEnd;
        CodeIndex = layout.CodeIndex;
        NameIndex = layout.NameIndex;
        UnitIndex = layout.UnitIndex;
        QuantityIndex = layout.QuantityIndex;
        PriceIndex = layout.PriceIndex;
        AmountIndex = layout.AmountIndex;
        SuggestedLayout = layout;
    }

    private async Task ApplySuggestedLayout()
    {
        if (SuggestedLayout is null || !SuggestedLayout.IsDetected)
        {
            await DetectCurrentSheetAsync(reimportPreview: true);
            return;
        }

        try
        {
            ImportMessage = T("Tillämpar förslag...", "Applying suggestions...");
            ImportMessageIsSuccess = false;
            await SetBusyAsync(true);

            bool hadImportedPreview = HasImportedPreview;
            bool layoutWasAlreadyApplied = LayoutMatchesCurrent(SuggestedLayout);
            ApplyDetectedLayout(SuggestedLayout);

            if (hadImportedPreview)
            {
                string actionMessage = BuildLayoutActionMessage(
                    layoutWasAlreadyApplied
                        ? T("Nuvarande inställningar matchar redan förslaget.", "The current settings already match the suggestion.")
                        : T("Förslagen har tillämpats.", "Suggestions applied."),
                    SuggestedLayout);
                await ImportAsync(manageWait: false, completionPrefix: actionMessage);
                return;
            }

            ResetImportedPreview();
            await SaveLayoutAsync();
            ImportMessage = BuildLayoutActionMessage(
                layoutWasAlreadyApplied
                    ? T("Nuvarande inställningar matchar redan förslaget.", "The current settings already match the suggestion.")
                    : T("Förslagen har tillämpats.", "Suggestions applied."),
                SuggestedLayout);
            ImportMessageIsSuccess = true;
        }
        finally
        {
            await SetBusyAsync(false);
        }
    }

    private Task Import() => ImportAsync();

    private async Task ImportAsync(bool manageWait = true, string? completionPrefix = null)
    {
        if (!EnsureWorkbook())
            return;

        if (ColumnMappingWarnings.Count > 0)
        {
            string message = string.Join(Environment.NewLine, ColumnMappingWarnings);
            ImportMessage = message;
            ImportMessageIsSuccess = false;
            MHD.MessageOk("Import", message, MhdState.Warning);
            return;
        }

        try
        {
            XLWorkbook currentWorkbook = workbook!;
            ImportMessage = T("Importerar...", "Importing...");
            ImportMessageIsSuccess = false;
            if (manageWait)
            {
                await SetBusyAsync(true);
            }

            var importResult = ExcelHelper.ImportWithRowNumbers(SheetNr, currentWorkbook, RowStart, RowEnd, CodeIndex, NameIndex, UnitIndex, QuantityIndex, PriceIndex, AmountIndex, Calc.OHFactors);
            Sections = importResult.Tasks;
            InitializeAmountDrafts(Sections);
            InitializeOriginalRows(importResult.RowNumbers);
            InitializeAmountDraftsFromWorkbook(importResult.RowNumbers, currentWorkbook.Worksheet(Math.Clamp(SheetNr, 1, currentWorkbook.Worksheets.Count)));
            CaptureOriginalSnapshots(Sections);
            ChangedTasks.Clear();
            NewTasks.Clear();
            AppCompletedBarCodeRows.Clear();
            foreach (var t in importResult.AppCompletedBarCodeRows) AppCompletedBarCodeRows.Add(t);
            DismissedBarCodeWarnings.Clear();
            transferCompleted = false;
            ImportMessageIsSuccess = false;
            ImportSummary summary = CountTasks(Sections);
            PreviewRequiresImport = false;
            await SaveLayoutAsync();

            if (summary.TotalRows == 0)
            {
                ImportMessage = T(
                    "Inga kalkylposter hittades. Kontrollera blad, rader och kolumner och importera igen.",
                    "No calculation items found. Check sheet, rows and columns and import again.");
                ImportMessageIsSuccess = false;
                MHD.MessageOk("Import", ImportMessage, MhdState.Warning);
                return;
            }

            ImportMessage = T(
                $"Importen är klar!\n\nTotala rader: {summary.TotalRows}\nKalkylposter: {summary.CalculationItems} (inkl. 3- och 4-streckade koder)\n3-streckade koder: {summary.ThreeBarCode}\n4-streckade koder: {summary.FourBarCode}",
                $"Import complete!\n\nTotal rows: {summary.TotalRows}\nCalculation items: {summary.CalculationItems} (incl. 3- and 4-bar codes)\n3-bar codes: {summary.ThreeBarCode}\n4-bar codes: {summary.FourBarCode}");
            if (!string.IsNullOrWhiteSpace(completionPrefix))
                ImportMessage = $"{completionPrefix}{Environment.NewLine}{Environment.NewLine}{ImportMessage}";
            ImportMessageIsSuccess = true;
        }
        catch (Exception ex)
        {
            Sections = null;
            ImportMessage = ex.Message;
            ImportMessageIsSuccess = false;
            MHD.MessageOk("Import", ex.Message, MhdState.Danger);
        }
        finally
        {
            if (manageWait)
            {
                await SetBusyAsync(false);
            }
        }
    }

    private async Task SetBusyAsync(bool value)
    {
        wait = value;
        if (value && !loadingOverlayActive)
        {
            MHD.Loading.Begin();
            loadingOverlayActive = true;
        }
        else if (!value && loadingOverlayActive)
        {
            MHD.Loading.End();
            loadingOverlayActive = false;
        }

        await InvokeAsync(StateHasChanged);
        if (value)
            await Task.Delay(1);
    }

    void Close() => Modal.Close();

    public void Dispose()
    {
        if (loadingOverlayActive)
        {
            MHD.Loading.End();
            loadingOverlayActive = false;
        }

        workbook?.Dispose();
        workbook = null;
        workbookStream?.Dispose();
        workbookStream = null;
    }

    bool EnsureWorkbook()
    {
        if (workbook != null)
            return true;

        if (!HasSelectedFile)
        {
            ImportMessage = T("Välj en Excel-fil först.", "Select an Excel file first.");
            ImportMessageIsSuccess = false;
            return false;
        }

        try
        {
            LoadWorkbook();
            return workbook != null;
        }
        catch (Exception ex)
        {
            workbook?.Dispose();
            workbook = null;
            workbookStream?.Dispose();
            workbookStream = null;
            ImportMessage = T($"Det gick inte att läsa Excel-filen: {ex.Message}", $"Failed to read Excel file: {ex.Message}");
            ImportMessageIsSuccess = false;
            MHD.MessageOk("Import", ImportMessage, MhdState.Danger);
            return false;
        }
    }

    void ResetImportedPreview()
    {
        if (!HasImportedPreview && !transferCompleted)
            return;

        Sections = null;
        AmountDrafts.Clear();
        InvalidQuantityDrafts.Clear();
        ChangedTasks.Clear();
        NewTasks.Clear();
        OriginalTaskSnapshots.Clear();
        OriginalRowNumbers.Clear();
        transferCompleted = false;
        PreviewRequiresImport = false;
        ImportMessage = string.Empty;
        ImportMessageIsSuccess = false;
    }

    private async Task<bool> RestoreSavedLayoutAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", LayoutStorageKey);
            if (string.IsNullOrWhiteSpace(json))
                return false;

            var state = JsonSerializer.Deserialize<ImportLayoutState>(json);
            if (state is null)
                return false;

            int maxSheet = SheetOptions.Count == 0 ? 1 : SheetOptions.Max(x => x.Index);
            SheetNr = Math.Clamp(state.SheetNr, 1, maxSheet);
            RowStart = Math.Max(1, state.RowStart);
            RowEnd = Math.Max(RowStart, state.RowEnd);
            CodeIndex = Math.Max(1, state.CodeIndex);
            NameIndex = Math.Max(1, state.NameIndex);
            UnitIndex = Math.Max(1, state.UnitIndex);
            QuantityIndex = Math.Max(1, state.QuantityIndex);
            PriceIndex = Math.Max(1, state.PriceIndex);
            AmountIndex = Math.Max(1, state.AmountIndex);
            return true;
        }
        catch
        {
            // Non-critical: auto-detection still works without saved layout state.
            return false;
        }
    }

    private async Task ClearSavedLayoutAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.removeItem", LayoutStorageKey);
            if (workbook is not null)
                ApplyDetectedLayout(ExcelHelper.DetectLayout(workbook, SheetNr));

            ImportMessage = T("Sparad importlayout har rensats. Automatisk identifiering används.", "Saved import layout has been cleared. Automatic detection is used.");
            ImportMessageIsSuccess = true;
        }
        catch (Exception ex)
        {
            ImportMessage = T($"Kunde inte rensa sparad layout: {ex.Message}", $"Could not clear saved layout: {ex.Message}");
            ImportMessageIsSuccess = false;
        }
    }

    private async Task SaveLayoutAsync()
    {
        try
        {
            var state = new ImportLayoutState
            {
                SheetNr = SheetNr,
                RowStart = RowStart,
                RowEnd = RowEnd,
                CodeIndex = CodeIndex,
                NameIndex = NameIndex,
                UnitIndex = UnitIndex,
                QuantityIndex = QuantityIndex,
                PriceIndex = PriceIndex,
                AmountIndex = AmountIndex,
                Score = SuggestedLayout?.Score ?? 0
            };

            await JS.InvokeVoidAsync("localStorage.setItem", LayoutStorageKey, JsonSerializer.Serialize(state));
        }
        catch
        {
            // Non-critical persistence.
        }
    }

    void LoadWorkbook()
    {
        if (workbookBytes == null || workbookBytes.Length == 0)
            return;

        workbook?.Dispose();
        workbookStream?.Dispose();
        workbookStream = new MemoryStream(workbookBytes);

        CultureInfo originalCulture = CultureInfo.CurrentCulture;
        try
        {
            CultureInfo.CurrentCulture = CultureInfo.InvariantCulture;
            workbook = new XLWorkbook(workbookStream);
        }
        finally
        {
            CultureInfo.CurrentCulture = originalCulture;
        }
    }

    private bool LayoutMatchesCurrent(ExcelImportLayout layout) =>
        layout.IsDetected
        && SheetNr == layout.SheetIndex
        && RowStart == layout.RowStart
        && RowEnd == layout.RowEnd
        && CodeIndex == layout.CodeIndex
        && NameIndex == layout.NameIndex
        && UnitIndex == layout.UnitIndex
        && QuantityIndex == layout.QuantityIndex
        && PriceIndex == layout.PriceIndex
        && AmountIndex == layout.AmountIndex;

