        string Name,
        string Unit,
        decimal? Quantity,
        decimal? BaseQuantity,
        decimal? Price,
        string Amount)
    {
        public static TaskPreviewSnapshot From(TaskPostDTO task, string amount) =>
            new(
                task.Metadata.Type,
                NormalizeDraft(task.Metadata.Code),
                NormalizeDraft(task.Name),
                NormalizeDraft(task.Unit),
                task.Quantity,
                task.Metadata.BaseQuantity,
                task.Metadata.PriceSubDB,
                NormalizeDraft(amount));

        public void ApplyTo(TaskPostDTO task)
        {
            task.Metadata.Type = Type;
            task.Metadata.Code = Code;
            task.Name = Name;
            task.Unit = Unit;
            task.Quantity = Quantity;
            task.Metadata.BaseQuantity = BaseQuantity;
            task.Metadata.PriceSubDB = Price;
            task.Metadata.QuantityParam = Type == TaskType.ThreeBarCode || Quantity.HasValue
                ? ConstValues.FixedQ
                : string.Empty;
        }
    }

    private sealed class ImportLayoutState
    {
        public int SheetNr { get; set; }
        public int RowStart { get; set; }
        public int RowEnd { get; set; }
        public int CodeIndex { get; set; }
        public int NameIndex { get; set; }
        public int UnitIndex { get; set; }
        public int QuantityIndex { get; set; }
        public int PriceIndex { get; set; }
        public int AmountIndex { get; set; }
        public int Score { get; set; }
    }

    sealed class ImportSummary
    {
        public int TotalRows { get; set; }
        public int CalculationItems { get; set; }
        public int ThreeBarCode { get; set; }
        public int FourBarCode { get; set; }

        public void Add(ImportSummary other)
        {
            TotalRows += other.TotalRows;
            CalculationItems += other.CalculationItems;
            ThreeBarCode += other.ThreeBarCode;
            FourBarCode += other.FourBarCode;
        }
    }
}
