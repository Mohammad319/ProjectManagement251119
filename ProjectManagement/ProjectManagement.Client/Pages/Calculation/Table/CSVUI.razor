    {
        string sheet = string.IsNullOrWhiteSpace(layout.SheetName)
            ? layout.SheetIndex.ToString(CultureInfo.InvariantCulture)
            : $"{layout.SheetIndex}. {layout.SheetName}";

        return string.Join(Environment.NewLine, new[]
        {
            title,
            $"{T("Blad", "Sheet")}: {sheet}",
            $"{T("Rader", "Rows")}: {layout.RowStart}-{layout.RowEnd}",
            $"{T("Kolumner", "Columns")}: {T("Kod", "Code")} {layout.CodeIndex}, {T("Namn", "Name")} {layout.NameIndex}, {T("Enhet", "Unit")} {layout.UnitIndex}, {T("Kvantitet", "Quantity")} {layout.QuantityIndex}, {T("Á-pris", "Unit price")} {layout.PriceIndex}, {T("Belopp", "Amount")} {layout.AmountIndex}"
        });
    }

    private string GetLayoutSuggestion(string field)
    {
        if (SuggestedLayout is null || !SuggestedLayout.IsDetected)
            return string.Empty;

        int? value = GetSuggestedLayoutValue(field);
        return value.HasValue ? $"{T("Förslag", "Suggestion")}: {value.Value}" : string.Empty;
    }

    private int? GetSuggestedLayoutValue(string field)
    {
        if (SuggestedLayout is null || !SuggestedLayout.IsDetected)
            return null;

        return field switch
        {
            nameof(SheetNr) => SuggestedLayout.SheetIndex,
            nameof(RowStart) => SuggestedLayout.RowStart,
            nameof(RowEnd) => SuggestedLayout.RowEnd,
            nameof(CodeIndex) => SuggestedLayout.CodeIndex,
            nameof(NameIndex) => SuggestedLayout.NameIndex,
            nameof(UnitIndex) => SuggestedLayout.UnitIndex,
            nameof(QuantityIndex) => SuggestedLayout.QuantityIndex,
            nameof(PriceIndex) => SuggestedLayout.PriceIndex,
            nameof(AmountIndex) => SuggestedLayout.AmountIndex,
            _ => null
        };
    }

    private int? GetCurrentLayoutValue(string field) => field switch
    {
        nameof(SheetNr) => SheetNr,
        nameof(RowStart) => RowStart,
        nameof(RowEnd) => RowEnd,
        nameof(CodeIndex) => CodeIndex,
        nameof(NameIndex) => NameIndex,
        nameof(UnitIndex) => UnitIndex,
        nameof(QuantityIndex) => QuantityIndex,
        nameof(PriceIndex) => PriceIndex,
        nameof(AmountIndex) => AmountIndex,
        _ => null
    };

    private bool DiffersFromSuggestion(string field) =>
        GetSuggestedLayoutValue(field) is int suggested
        && GetCurrentLayoutValue(field) is int current
        && suggested != current;

    private string GetLayoutSuggestionClass(string field) =>
        DiffersFromSuggestion(field)
            ? "truncate text-[10px] font-semibold text-amber-600 dark:text-amber-300"
            : "truncate text-[10px] font-normal text-blue-600 dark:text-blue-300";

    private string GetMappingInputClass(string field)
    {
        const string baseClass = "h-7 w-full rounded-lg border bg-white px-2 py-0.5 text-xs text-slate-900 outline-none transition focus:ring-2 dark:bg-slate-900 dark:text-slate-100";
        return DiffersFromSuggestion(field)
            ? $"{baseClass} border-amber-300 focus:border-amber-500 focus:ring-amber-500/20 dark:border-amber-700 dark:focus:border-amber-400 dark:focus:ring-amber-400/20"
            : $"{baseClass} border-slate-300 focus:border-blue-500 focus:ring-blue-500/20 dark:border-slate-600 dark:focus:border-blue-400 dark:focus:ring-blue-400/20";
    }

    private List<string> BuildColumnMappingWarnings()
    {
        var fields = new (string Label, int Column)[]
