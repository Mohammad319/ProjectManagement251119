    private string GetOriginalRowNumber(TaskPostDTO task) =>
        OriginalRowNumbers.TryGetValue(task, out string? row) ? row : string.Empty;

    private void InitializeOriginalRows(IReadOnlyDictionary<TaskPostDTO, int> rowNumbers)
    {
        OriginalRowNumbers.Clear();
        foreach (var item in rowNumbers)
            OriginalRowNumbers[item.Key] = item.Value.ToString(CultureInfo.InvariantCulture);
    }

    private void CaptureOriginalSnapshots(IEnumerable<TaskPostDTO>? tasks)
    {
        OriginalTaskSnapshots.Clear();
        CaptureOriginalSnapshotsRecursive(tasks);
    }

    private void CaptureOriginalSnapshotsRecursive(IEnumerable<TaskPostDTO>? tasks)
    {
        if (tasks is null)
            return;

        foreach (var task in tasks)
        {
            OriginalTaskSnapshots[task] = TaskPreviewSnapshot.From(task, FormatAmountDraft(task));
            CaptureOriginalSnapshotsRecursive(task.Tasks);
        }
