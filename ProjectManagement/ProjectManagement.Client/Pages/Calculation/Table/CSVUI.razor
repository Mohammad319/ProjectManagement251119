    private void MarkPreviewChanged(TaskPostDTO? task = null)
    {
        if (task is not null)
        {
            if (!OriginalTaskSnapshots.TryGetValue(task, out var snapshot))
                OriginalTaskSnapshots[task] = TaskPreviewSnapshot.From(task, FormatAmountDraft(task));

            if (OriginalTaskSnapshots.TryGetValue(task, out snapshot)
                && snapshot.Equals(TaskPreviewSnapshot.From(task, FormatAmountDraft(task))))
            {
                ChangedTasks.Remove(task);
            }
            else
            {
                ChangedTasks.Add(task);
            }
        }

        if (transferCompleted)
            ImportMessage = T(
                "Förhandsgranskningen har ändrats. Importera filen på nytt för att överföra en ny version.",
                "The preview has changed. Re-import the file to transfer a new version.");
        else if (ImportMessageIsSuccess)
            ImportMessage = string.Empty;

        ImportMessageIsSuccess = false;
    }

    private static string NormalizeDraft(string? value) => (value ?? string.Empty).Trim();
    private static bool IsDash(string? value) => NormalizeDraft(value) == "-";

    private static bool LooksLikePotentialChildCode(string? code)
    {
        code = NormalizeDraft(code);
        if (string.IsNullOrWhiteSpace(code))
            return false;

        if (code.Any(c => c is '.' or '-' or '_' or '/' or '\\'))
            return true;

        string compact = new(code.Where(char.IsLetterOrDigit).ToArray());
        return compact.Length > 1;
    }

    private static string NormalizeSearch(string? value)
    {
        value = NormalizeDraft(value);
        if (value.Length == 0)
            return string.Empty;

        var builder = new StringBuilder(value.Length);
        foreach (char c in value.ToLowerInvariant().Normalize(NormalizationForm.FormD))
        {
            var category = CharUnicodeInfo.GetUnicodeCategory(c);
            if (category == UnicodeCategory.NonSpacingMark)
                continue;

            builder.Append(char.IsLetterOrDigit(c) ? c : ' ');
        }

        return string.Join(' ', builder.ToString().Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));
    }

    private static string FormatDecimal(decimal? value) =>
        value.HasValue ? value.Value.ToString("0.###", CultureInfo.InvariantCulture) : string.Empty;

    private string FormatFourBarPost(int count) =>
        count == 1 ? T("fyrstreckad post", "four-bar item") : T("fyrstreckade poster", "four-bar items");

    private static bool TryReadDecimal(string? text, out decimal value)
    {
        text = NormalizeDraft(text).Replace(" ", string.Empty);
        return decimal.TryParse(text, NumberStyles.Number, CultureInfo.CurrentCulture, out value)
            || decimal.TryParse(text, NumberStyles.Number, CultureInfo.InvariantCulture, out value)
            || decimal.TryParse(text, NumberStyles.Number, CultureInfo.GetCultureInfo("sv-SE"), out value)
            || decimal.TryParse(text, NumberStyles.Number, CultureInfo.GetCultureInfo("en-US"), out value);
    }

    static ImportSummary CountTasks(List<TaskPostDTO>? tasks)
    {
        if (tasks == null)
            return new ImportSummary();

        ImportSummary summary = new();
        foreach (TaskPostDTO task in tasks)
        {
            summary.TotalRows++;
            if (task.Metadata.Type is TaskType.Task or TaskType.ThreeBarCode or TaskType.FourBarCode)
                summary.CalculationItems++;
            if (task.Metadata.Type == TaskType.ThreeBarCode)
                summary.ThreeBarCode++;
            else if (task.Metadata.Type == TaskType.FourBarCode)
                summary.FourBarCode++;

            summary.Add(CountTasks(task.Tasks));
        }

        return summary;
    }

