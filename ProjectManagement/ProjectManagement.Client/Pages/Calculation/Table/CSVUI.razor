@using BlazorMHD.UI.Core.DesignSystem
@using BlazorMHD.UI.Core.Services
@using ClosedXML.Excel
@using Microsoft.JSInterop
@using ProjectManagement.Shared.Base.Calculation
@using ProjectManagement.Shared.DTO.Calculation
@using System.Globalization
@using System.IO
@using System.Text
@using System.Text.Json
@inherits AppComponentBase
@implements IDisposable
@inject IJSRuntime JS

<div class="flex h-full flex-col gap-1 text-slate-800 dark:text-slate-100" style="--net-task: @UiStyles.Task;--net-subtask: @UiStyles.SubTask;">
    <div class="flex min-w-0 flex-wrap items-center gap-1.5 rounded-xl border border-slate-200 bg-slate-50 px-2 py-1.5 dark:border-slate-700 dark:bg-slate-800/60">

        <label for="excel-import-file"
               class="inline-flex h-7 shrink-0 cursor-pointer items-center justify-center rounded-lg border border-slate-300 bg-white px-5 text-xs font-medium text-slate-700 transition hover:border-blue-500 hover:text-blue-600 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 dark:hover:border-blue-400 dark:hover:text-blue-300">
            @T("Välj fil", "Select file")
        </label>
        <InputFile id="excel-import-file" class="hidden" type="file" accept=".xlsx,.xls"
                   OnChange="(InputFileChangeEventArgs e) => CheckedChanged(e)" />

        <span class="shrink-0 truncate text-xs text-slate-500 dark:text-slate-400" style="max-width:480px">@SelectedFileLabel</span>

        @if (SheetIsVisible)
        {
            <span class="shrink-0 text-slate-300 dark:text-slate-600">|</span>
            <span class="shrink-0 text-[10px] font-medium text-slate-500 dark:text-slate-400">@T("Blad", "Sheet")</span>
            <select class="@GetMappingInputClass(nameof(SheetNr)) !h-6 !w-auto !min-w-[8rem] !shrink-0 !py-0 !text-[11px]"
                    title="@GetLayoutSuggestion(nameof(SheetNr))"
                    value="@SheetNr"
                    @onchange="OnSheetChanged">
                @foreach (var sheet in SheetOptions)
                {
                    <option value="@sheet.Index">@sheet.DisplayName</option>
                }
            </select>
        }

        @if (HasSelectedFile)
        {
            <span class="shrink-0 text-slate-300 dark:text-slate-600">|</span>
            <span class="shrink-0 text-[10px] font-medium text-slate-500 dark:text-slate-400">@T("Rad", "Row")</span>
            <input type="number"
                   class="@GetMappingInputClass(nameof(RowStart)) !h-6 !w-16 !shrink-0 !py-0 !text-[11px]"
                   title="@GetLayoutSuggestion(nameof(RowStart))"
                   value="@RowStart" @onchange="OnRowStartChanged" />
            <span class="shrink-0 text-[10px] text-slate-400">–</span>
            <input type="number"
                   class="@GetMappingInputClass(nameof(RowEnd)) !h-6 !w-16 !shrink-0 !py-0 !text-[11px]"
                   title="@GetLayoutSuggestion(nameof(RowEnd))"
                   value="@RowEnd" @onchange="OnRowEndChanged" />
        }

        @if (CanImport)
        {
            <button type="button"
                    class="inline-flex h-7 shrink-0 items-center justify-center rounded-lg border border-blue-600 bg-blue-600 px-2.5 text-xs font-medium text-white transition hover:bg-blue-700 disabled:cursor-not-allowed disabled:opacity-60 dark:border-blue-500 dark:bg-blue-500 dark:hover:bg-blue-400 dark:hover:text-slate-900"
                    @onclick="Import" disabled="@wait">
                @(wait ? T("Arbetar...", "Working...") : T("Importera", "Import"))
            </button>
        }

        @if (CanTransferToCalculation)
        {
            <button type="button"
                    class="inline-flex h-7 shrink-0 items-center justify-center rounded-lg border border-emerald-600 bg-emerald-600 px-2.5 text-xs font-medium text-white transition hover:bg-emerald-700 disabled:cursor-not-allowed disabled:opacity-60 dark:border-emerald-500 dark:bg-emerald-500 dark:hover:bg-emerald-400 dark:hover:text-slate-900"
                    @onclick="Save" disabled="@wait">
                @(wait ? T("Överför data till kalkyl...", "Transferring data to calculation...") : T("Överför data till kalkyl", "Transfer data to calculation"))
            </button>
        }

        @if (HasSelectedFile && SuggestedLayout is { IsDetected: true } && HasLayoutSuggestionDifference)
        {
            <button type="button"
                    class="inline-flex h-7 shrink-0 items-center justify-center rounded-lg border border-slate-300 bg-white px-2.5 text-xs font-medium text-slate-700 transition hover:border-emerald-500 hover:text-emerald-700 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200"
                    title="@T("Appen föreslår automatiskt blad, radintervall och kolumner för kod, namn, enhet, kvantitet, á-pris och belopp. Du kan ändra alla värden manuellt om något inte stämmer.", "The app automatically suggests sheet, row range and columns for code, name, unit, quantity, unit price and amount. You can change all values manually if something is incorrect.")"
                    @onclick="ApplySuggestedLayout" disabled="@wait">
                @T("Använd förslag", "Apply suggestion")
            </button>
        }

        @if (!string.IsNullOrWhiteSpace(ImportMessage))
        {
            <span class="ml-auto shrink-0 cursor-default rounded-full @ImportMessageBadgeClass px-2 py-0.5 text-[11px] font-semibold"
                  title="@ImportMessage">
                @ImportMessageFirstLine
            </span>
        }

        @if (HasSelectedFile)
        {
            <div class="basis-full"></div>
            @MappingField(T("Kod", "Code"), nameof(CodeIndex), CodeIndex, v => OnMappingColumnChanged(ref CodeIndex, v))
            @MappingField(T("Namn", "Name"), nameof(NameIndex), NameIndex, v => OnMappingColumnChanged(ref NameIndex, v))
            @MappingField(T("Enhet", "Unit"), nameof(UnitIndex), UnitIndex, v => OnMappingColumnChanged(ref UnitIndex, v))
            @MappingField(T("Kvantitet", "Quantity"), nameof(QuantityIndex), QuantityIndex, v => OnMappingColumnChanged(ref QuantityIndex, v))
            @MappingField(T("Á-pris", "Unit price"), nameof(PriceIndex), PriceIndex, v => OnMappingColumnChanged(ref PriceIndex, v))
            @MappingField(T("Belopp", "Amount"), nameof(AmountIndex), AmountIndex, v => OnMappingColumnChanged(ref AmountIndex, v))
        }
    </div>

    @if (HasSelectedFile)
    {
        <div class="flex-1 min-h-0 flex flex-col overflow-hidden rounded-xl border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-900">
            @if (ColumnMappingWarnings.Count > 0)
            {
                <div class="shrink-0 flex items-center gap-2 border-b border-amber-100 bg-amber-50 px-3 py-1 text-xs font-medium text-amber-800 dark:border-amber-900/40 dark:bg-amber-950/30 dark:text-amber-300">
                    <svg class="h-3 w-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
                    </svg>
                    <span>@string.Join(" ", ColumnMappingWarnings)</span>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(ImportMessage) && !ImportMessageIsSuccess)
            {
                <div class="shrink-0 flex items-center gap-2 border-b border-slate-200 bg-slate-50 px-3 py-1 text-xs font-medium text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200">
                    <svg class="h-3 w-3 shrink-0 text-amber-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m0 3.75h.008v.008H12V16.5Zm-9.303-.374c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126Z" />
                    </svg>
                    <span class="truncate" title="@ImportMessage">@ImportMessageFirstLine</span>
                </div>
            }
            @if (HasImportedPreview)
            {

                    var _s = CountTasks(Sections);
                    int _w = 0, _tasks = 0, _codeText = 0;
                    foreach (var _r in FlattenTasksWithDepth(Sections))
                    {
                        if (_r.Task.Metadata.Type == TaskType.Task) _tasks++;
                        else if (_r.Task.Metadata.Type == TaskType.CodeName) _codeText++;
                        if (GetTaskDiagnostics(_r.Task, _r.Depth).Any(x => x.Kind == DiagnosticKind.Warning)) _w++;
                    }
                    int _changed = ChangedTasks.Count;

                <div class="relative z-30 shrink-0 flex min-w-0 flex-wrap items-center gap-1.5 border-b border-slate-200 bg-white px-2 py-1.5 dark:border-slate-700 dark:bg-slate-900">
                    <input type="search"
                           class="h-7 w-36 shrink-0 rounded-lg border border-slate-300 bg-white px-2 text-xs text-slate-900 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100"
                           placeholder="@T("Sök...", "Search...")"
                           value="@PreviewSearchText"
                           @oninput="OnPreviewSearchChanged" />
                    <select class="h-7 @(IsTreeView ? "w-36" : "w-72") shrink-0 rounded-lg border border-slate-300 bg-white px-2 text-xs text-slate-900 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 disabled:cursor-not-allowed disabled:bg-slate-100 disabled:text-slate-500 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:disabled:bg-slate-800/60"
                            value="@PreviewTypeFilter"
                            @onchange="OnPreviewTypeFilterChanged"
                            disabled="@IsTreeView">
                        <option value="@ImportPreviewTypeFilter.All">@T("Alla rader", "All rows") (@_s.TotalRows)</option>
                        @if (!IsTreeView)
                        {
                            <option value="@ImportPreviewTypeFilter.CalculationItems">@T("Kalkylposter inkl. 3- och 4-streckad kod", "Calc. items incl. 3- and 4-bar") (@_s.CalculationItems)</option>
                            <option value="@ImportPreviewTypeFilter.Task">@T("Kalkylposter", "Calculation items") (@_tasks)</option>
                            <option value="@ImportPreviewTypeFilter.ThreeBarCode">@T("3-streckade koder", "3-bar codes") (@_s.ThreeBarCode)</option>
                            <option value="@ImportPreviewTypeFilter.FourBarCode">@T("4-streckade koder", "4-bar codes") (@_s.FourBarCode)</option>
                            <option value="@ImportPreviewTypeFilter.Warnings">@T("Rader med varningar", "Rows with warnings") (@_w)</option>
                            <option value="@ImportPreviewTypeFilter.Changed">@T("Ändrade rader", "Changed rows") (@_changed)</option>
                        }
                    </select>
                    <select class="h-7 shrink-0 rounded-lg border border-slate-300 bg-white px-2 text-xs text-slate-900 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100"
                            value="@DisplayMode"
                            @onchange="OnDisplayModeChanged"
                            title="@T("Välj visningsläge", "Select display mode")">
                        <option value="overview">@T("Översikt", "Overview")</option>
                        <option value="tree">@T("Trädvy", "Tree view")</option>
                    </select>
                    @if (IsTreeView)
                    {
                        <select class="h-7 shrink-0 rounded-lg border border-slate-300 bg-white px-2 text-xs text-slate-900 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100"
                                value="@TreeViewMode"
                                @onchange="OnTreeViewModeChanged"
                                title="@T("Visa nivå", "Show level")">
                            <option value="all">@T("Expandera alla", "Expand all")</option>
                            <option value="none">@T("Fäll ihop alla", "Collapse all")</option>
                            @for (int level = 1; level <= MaxTreeLevel; level++)
                            {
                                <option value="@level.ToString(CultureInfo.InvariantCulture)">@T($"Nivå {level}", $"Level {level}")</option>
                            }
                        </select>
                    }
                    @if (!IsTreeView)
                    {
                        <button type="button"
                                class="@ToolbarButtonClass @(WarningsOnly ? "!border-amber-500 !text-amber-700 dark:!border-amber-400 dark:!text-amber-300" : "") disabled:cursor-not-allowed disabled:opacity-45"
                                disabled="@(!HasWarningRows)"
                                @onclick="ShowOnlyWarnings">
                            @T("Endast varningar", "Only warnings")
                        </button>
                        <button type="button" class="@ToolbarButtonClass" @onclick="ShowOnlyCalculationItems">@T("Endast kalkylposter", "Only calc. items")</button>
                    }
                </div>
            }
            <div class="flex-1 min-h-0 overflow-y-auto overflow-x-hidden bg-white dark:bg-slate-900">
                @if (HasImportedPreview)
                {
                <table class="w-full table-fixed border-collapse text-sm">
                    <colgroup>
                        <col style="width:54px" />
                        <col style="@CodeColumnStyle" />
                        <col />
                        <col style="width:58px" />
                        <col style="width:76px" />
                        <col style="width:62px" />
                        <col style="width:62px" />
                        <col style="width:100px" />
                        <col style="width:96px" />
                        <col style="width:120px" />
                    </colgroup>
                    <thead class="csv-thead-sticky sticky top-0 z-20 bg-slate-100 dark:bg-slate-800">
                        <tr>
                            <th class="border border-slate-300 px-1 py-1 text-center font-semibold text-slate-700 dark:border-slate-700 dark:text-slate-200">
                                <span title="@T("Visar ursprungligt radnummer från Excel-filen.", "Shows the original row number from the Excel file.")">@T("Radnr", "Row no.")</span>
                            </th>
                            <th class="border border-slate-300 px-2 py-1 text-start font-semibold text-slate-700 dark:border-slate-700 dark:text-slate-200">
                                @CalcResource.code
                            </th>
                            <th class="border border-slate-300 px-2 py-1 text-start font-semibold text-slate-700 dark:border-slate-700 dark:text-slate-200">
                                @CalcResource.name
                            </th>
                            <th class="border border-slate-300 px-2 py-1 text-start font-semibold text-slate-700 dark:border-slate-700 dark:text-slate-200">
                                @CalcResource.unit
                            </th>
                            <th class="border border-slate-300 px-2 py-1 text-start font-semibold text-slate-700 dark:border-slate-700 dark:text-slate-200">
                                @CalcResource.quantity
                            </th>
                            <th class="border border-slate-300 px-2 py-1 text-start font-semibold text-slate-700 dark:border-slate-700 dark:text-slate-200">
                                @T("Á-pris", "Unit price")
                            </th>
                            <th class="border border-slate-300 px-2 py-1 text-start font-semibold text-slate-700 dark:border-slate-700 dark:text-slate-200">
                                @T("Belopp", "Amount")
                            </th>
                            <th class="border border-slate-300 px-2 py-1 text-start font-semibold text-slate-700 dark:border-slate-700 dark:text-slate-200">
                                @T("Typ", "Type")
                            </th>
                            <th class="border border-slate-300 px-1 py-1 text-center font-semibold text-slate-700 dark:border-slate-700 dark:text-slate-200">@T("Status", "Status")</th>
                            <th class="border border-slate-300 pl-2 pr-4 py-1 text-center font-semibold text-slate-700 dark:border-slate-700 dark:text-slate-200">
                                @T("Varningar", "Warnings")
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (VisiblePreviewRows.Any())
                        {
                            @foreach (var row in VisiblePreviewRows)
                            {
                                @TaskRow(row)
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="10" class="border border-dashed border-slate-300 px-3 py-8 text-center text-sm text-slate-500 dark:border-slate-700 dark:text-slate-400">
                                    @T("Inga rader matchar filtret.", "No rows match the filter.")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                }
            </div>
        </div>
    }
</div>

@code {
    RenderFragment TaskRow(PreviewRow row) => __builder =>
    {
        var Task = row.Task;
        var siblings = row.Siblings;
        var diagnostics = GetTaskDiagnostics(Task, row.Depth);
        bool hasCode = !string.IsNullOrWhiteSpace(Task.Metadata.Code);
        bool hasChildren = Task.Tasks.Any();
        bool showTreeAnchor = IsTreeView && (hasCode || hasChildren);

        <tr class="@GetPreviewRowClass(row)">
            <td class="border border-slate-300 px-1.5 py-0.5 text-xs font-medium text-slate-500 dark:border-slate-700 dark:text-slate-400">
                @GetOriginalRowNumber(Task)
            </td>
            <td class="border border-slate-300 px-1 py-0.5 dark:border-slate-700">
                @if (IsTreeView)
                {
                    <div class="relative flex h-6 min-w-0 items-center" style="padding-left:@($"{GetTreeIndentPx(row.Depth)}px")">
                        @if (showTreeAnchor)
                        {
                            @for (int g = 0; g < row.Depth; g++)
                            {
                                @if (row.AncestorHasNextSibling?[g] == true)
                                {
                                    <span class="@TreeConnectorVerticalClass"
                                          style="left:@($"{GetTreeGuideLeftPx(g)}px")"></span>
                                }
                            }
                            @if (row.Depth > 0)
                            {
                                <span class="@TreeConnectorCurrentTopClass"
                                      style="left:@($"{GetTreeGuideLeftPx(row.Depth - 1)}px");height:calc(50% - 0.25rem)"></span>
                                @if (row.HasNextSibling)
                                {
                                    <span class="@TreeConnectorCurrentBottomClass"
                                          style="left:@($"{GetTreeGuideLeftPx(row.Depth - 1)}px");height:calc(50% - 0.25rem)"></span>
                                }
                                <span class="@TreeConnectorHorizontalClass"
                                      style="left:@($"{GetTreeGuideLeftPx(row.Depth - 1)}px")"></span>
                            }
                        }
                        @if (!HasActivePreviewFilter && hasChildren)
                        {
                            <button type="button"
                                    @onclick="() => Task.Colspan = !Task.Colspan"
                                    class="relative z-[1] inline-flex h-5 w-5 shrink-0 items-center justify-center rounded border border-slate-300 bg-white/90 text-base font-bold leading-none text-slate-600 transition hover:border-slate-400 hover:bg-slate-100 hover:text-slate-900 dark:border-slate-600 dark:bg-slate-800/80 dark:text-slate-300 dark:hover:border-slate-400 dark:hover:bg-slate-700 dark:hover:text-slate-100">
                                @(Task.Colspan ? "−" : "+")
                            </button>
                        }
                        else
                        {
                            <span class="relative z-[1] inline-block h-5 w-5 shrink-0"></span>
                        }
                        <input class="relative z-[1] h-5 min-w-[2.5rem] max-w-[8rem] flex-shrink truncate rounded border border-slate-300 bg-white px-1 text-xs text-slate-900 outline-none transition focus:border-blue-400 focus:ring-1 focus:ring-blue-400/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-blue-500 dark:focus:ring-blue-500/20"
                               type="text"
                               value="@Task.Metadata.Code"
                               title="@Task.Metadata.Code"
                               @onchange="args => OnCodeChanged(Task, args.Value?.ToString())" />
                    </div>
                }
                else
                {
                    <input class="h-6 w-full truncate rounded-md border border-slate-300 bg-white px-1.5 text-xs text-slate-900 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-blue-400 dark:focus:ring-blue-400/20"
                           type="text"
                           value="@Task.Metadata.Code"
                           title="@Task.Metadata.Code"
                           @onchange="args => OnCodeChanged(Task, args.Value?.ToString())" />
                }
            </td>
            <td class="border border-slate-300 px-1 py-0.5 dark:border-slate-700">
                <div class="flex min-w-0 items-center gap-1">
                    <input class="h-6 min-w-0 flex-1 truncate rounded-md border border-slate-300 bg-white px-1.5 text-xs text-slate-900 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-blue-400 dark:focus:ring-blue-400/20"
                           type="text"
                           value="@Task.Name"
                           title="@Task.Name"
                           @onchange="args => OnNameChanged(Task, args.Value?.ToString())" />
                    <button type="button"
                            class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-md border border-slate-200 bg-white text-xs font-semibold text-slate-500 transition hover:border-blue-300 hover:text-blue-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:border-blue-700 dark:hover:text-blue-300"
                            title="@T("Visa fullständig text", "Show full text")"
                            @onclick="() => ShowFullText(Task)">
                        …
                    </button>
                </div>
            </td>
            <td class="border border-slate-300 px-1 py-0.5 dark:border-slate-700">
                <input class="@PreviewInputClass"
                       type="text"
                       value="@FormatUnitDraft(Task)"
                       @onchange="args => OnUnitChanged(Task, args.Value?.ToString())" />
            </td>
            <td class="border border-slate-300 px-1 py-0.5 dark:border-slate-700">
                <input class="@PreviewInputClass"
                       type="text"
                       value="@FormatQuantityDraft(Task)"
                       title="@GetDashQuantityTooltip(Task)"
                       @onchange="args => OnQuantityChanged(Task, args.Value?.ToString())" />
            </td>
            <td class="border border-slate-300 px-1 py-0.5 dark:border-slate-700">
                <input class="@PreviewInputClass"
                       type="text"
                       value="@FormatPriceDraft(Task)"
                       @onchange="args => OnPriceChanged(Task, args.Value?.ToString())" />
            </td>
            <td class="border border-slate-300 px-1 py-0.5 dark:border-slate-700">
                <input class="@PreviewInputClass"
                       type="text"
                       value="@FormatAmountDraft(Task)"
                       @onchange="args => OnAmountChanged(Task, args.Value?.ToString())" />
            </td>
            <td class="border border-slate-300 px-1 py-0.5 dark:border-slate-700">
                <select class="@GetTaskTypeSelectClass(Task, diagnostics)"
                        value="@Task.Metadata.Type"
                        title="@GetTaskTypeReason(Task)"
                        @onchange="args => OnTaskTypeChanged(Task, args.Value?.ToString())">
                    <option value="@TaskType.Task">@T("Kalkylpost", "Calculation item")</option>
                    <option value="@TaskType.CodeName">@T("Kodtext", "Code text")</option>
                    <option value="@TaskType.ThreeBarCode">@T("3-streckad", "3-bar")</option>
                    <option value="@TaskType.FourBarCode">@T("4-streckad", "4-bar")</option>
                </select>
            </td>
            <td class="border border-slate-300 px-1 py-0.5 text-center dark:border-slate-700">
                <div class="flex items-center justify-center gap-1">
                    @if (NewTasks.Contains(Task))
                    {
                        <span class="inline-flex h-6 w-6 items-center justify-center rounded-md bg-emerald-100 text-[10px] font-semibold text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300" title="@T("Ny rad", "New row")">N</span>
                    }
                    else if (ChangedTasks.Contains(Task))
                    {
                        <span class="inline-flex h-6 w-6 items-center justify-center rounded-md bg-violet-100 text-[10px] font-semibold text-violet-700 dark:bg-violet-950 dark:text-violet-300" title="@T("Ändrad manuellt", "Changed manually")">Ä</span>
                    }
                    @if (ChangedTasks.Contains(Task) && !NewTasks.Contains(Task))
                    {
                        <button type="button"
                                class="inline-flex h-6 w-6 items-center justify-center rounded-md border border-slate-300 bg-white text-slate-700 transition hover:border-violet-500 hover:text-violet-700 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200"
                                title="@T("Återställ rad", "Restore row")"
                                @onclick="() => RestorePreviewRow(Task)">
                            ↺
                        </button>
                    }
                    <button type="button"
