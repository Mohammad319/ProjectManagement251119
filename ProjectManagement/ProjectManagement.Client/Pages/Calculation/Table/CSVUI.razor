    private void RestorePreviewRow(TaskPostDTO task)
    {
        if (!OriginalTaskSnapshots.TryGetValue(task, out var snapshot))
            return;

        snapshot.ApplyTo(task);
        AmountDrafts[task] = snapshot.Amount;
        ChangedTasks.Remove(task);
        ImportMessageIsSuccess = false;
    }

    private void NormalizeTaskForType(TaskPostDTO task)
    {
        switch (task.Metadata.Type)
        {
            case TaskType.CodeName:
                task.Unit = string.Empty;
                task.Quantity = null;
                task.Metadata.BaseQuantity = null;
                task.Metadata.QuantityParam = string.Empty;
                task.Metadata.PriceSubDB = null;
                AmountDrafts[task] = string.Empty;
                break;
            case TaskType.ThreeBarCode:
                task.Unit = "-";
                task.Quantity = 1m;
                task.Metadata.BaseQuantity = 1m;
                task.Metadata.QuantityParam = ConstValues.FixedQ;
                task.Metadata.PriceSubDB = null;
                if (!AmountDrafts.ContainsKey(task) || AmountDrafts[task] == "-")
                    AmountDrafts[task] = string.Empty;
                break;
            case TaskType.FourBarCode:
                task.Unit = "-";
                task.Quantity = null;
                task.Metadata.BaseQuantity = null;
                task.Metadata.QuantityParam = string.Empty;
                task.Metadata.PriceSubDB = null;
                foreach (var child in task.Tasks)
                    RemoveTaskStateRecursive(child);
                task.Tasks.Clear();
                task.Resources.Clear();
                AmountDrafts[task] = "-";
                break;
            default:
                if (task.Unit == "-")
                    task.Unit = string.Empty;
                task.Quantity ??= 1m;
                task.Metadata.BaseQuantity ??= task.Quantity;
                task.Metadata.QuantityParam = ConstValues.FixedQ;
                AmountDrafts[task] = string.Empty;
                break;
        }
    }

    private static double TokenOverlapScore(string left, string right)
    {
        var tokens = SplitSearchTokens(left);
        if (tokens.Count == 0)
            return 0;

        int hits = tokens.Count(token => right.Contains(token, StringComparison.Ordinal));
        return hits / (double)tokens.Count;
    }

    private static List<string> SplitSearchTokens(string value) =>
        NormalizeSearch(value)
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(x => x.Length > 1)
            .Distinct()
            .ToList();

    private static IEnumerable<TaskPostDTO> FlattenTasks(IEnumerable<TaskPostDTO>? tasks)
    {
        if (tasks is null)
            yield break;

        foreach (var task in tasks)
        {
            yield return task;

            foreach (var child in FlattenTasks(task.Tasks))
                yield return child;
        }
    }

    private static IEnumerable<PreviewRow> FlattenTasksWithDepth(IEnumerable<TaskPostDTO>? tasks, int depth = 0)
    {
        if (tasks is null)
            yield break;

        foreach (var task in tasks)
        {
            yield return new PreviewRow(task, [], depth);

            foreach (var child in FlattenTasksWithDepth(task.Tasks, depth + 1))
                yield return child;
        }
    }

    private void RemoveTaskStateRecursive(TaskPostDTO task)
    {
        AmountDrafts.Remove(task);
        InvalidQuantityDrafts.Remove(task);
        ChangedTasks.Remove(task);
        NewTasks.Remove(task);
        OriginalTaskSnapshots.Remove(task);
        OriginalRowNumbers.Remove(task);

        foreach (var child in task.Tasks)
            RemoveTaskStateRecursive(child);
    }

