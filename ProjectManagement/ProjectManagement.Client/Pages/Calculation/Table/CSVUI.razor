    private string GetTaskTypeReason(TaskPostDTO task)
    {
        string dashDetail = BuildDashPatternText(task);
        return task.Metadata.Type switch
        {
            TaskType.CodeName => T($"Kodtext: raden innehåller text/information utan kalkylvärden.{dashDetail}", $"Code text: the row contains text/information without calculation values.{dashDetail}"),
            TaskType.ThreeBarCode => T($"3-streckad: streck i Enhet, Kvantitet och Á-pris. Intern mängd räknas som 1.{dashDetail}", $"3-bar: dashes in Unit, Quantity and Unit price. Internal quantity is counted as 1.{dashDetail}"),
            TaskType.FourBarCode => T($"4-streckad: streck i Enhet, Kvantitet, Á-pris och Belopp. Ska vara slutrad.{dashDetail}", $"4-bar: dashes in Unit, Quantity, Unit price and Amount. Must be a leaf row.{dashDetail}"),
            _ => T($"Kalkylpost: raden behandlas som kalkylrad med namn och kalkyldata.{dashDetail}", $"Calculation item: the row is treated as a calculation row with name and calculation data.{dashDetail}")
        };
    }

    private string BuildDashPatternText(TaskPostDTO task)
    {
        var parts = new List<string>();
        if (IsDash(FormatUnitDraft(task)))
            parts.Add(T("enhet", "unit"));
        if (IsDash(FormatQuantityDraft(task)))
            parts.Add(T("mängd", "quantity"));
        if (IsDash(FormatPriceDraft(task)))
            parts.Add(T("pris", "price"));
        if (IsDash(FormatAmountDraft(task)))
            parts.Add(T("belopp", "amount"));

        return parts.Count == 0
            ? string.Empty
            : T($" Detekterade streck ({parts.Count}): {string.Join(", ", parts)}.",
                $" Detected dashes ({parts.Count}): {string.Join(", ", parts)}.");
    }

