    private string BuildTransferConfirmationMessage()
    {
        var summary = CountTasks(Sections);
        int warnings = FlattenTasksWithDepth(Sections).Count(row => GetTaskDiagnostics(row.Task, row.Depth).Any(x => x.Kind == DiagnosticKind.Warning));

        var message = new StringBuilder();
        message.AppendLine(T("Vill du överföra datan till kalkylen?", "Do you want to transfer the data to the calculation?"));
        message.AppendLine();
        message.AppendLine($"{T("Totala rader", "Total rows")}: {summary.TotalRows}");
        message.AppendLine($"{T("Kalkylposter", "Calculation items")}: {summary.CalculationItems} {T("(inkl. 3- och 4-streckade koder)", "(incl. 3- and 4-bar codes)")}");
        message.AppendLine($"{T("3-streckade koder", "3-bar codes")}: {summary.ThreeBarCode}");
        message.AppendLine($"{T("4-streckade koder", "4-bar codes")}: {summary.FourBarCode}");
        message.AppendLine($"{T("Rader med varningar", "Rows with warnings")}: {warnings}");

        return message.ToString();
    }

