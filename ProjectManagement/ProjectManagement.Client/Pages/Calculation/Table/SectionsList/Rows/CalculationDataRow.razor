<tr class="calc-data-row"
    @onclick="OnClick"
    @oncontextmenu="OnContextMenu"
    @oncontextmenu:preventDefault
    style="@RowStyle">
    <CalculationHierarchyCell IndentPx="Left"
                              CanToggle="CanToggle"
                              IsExpanded="IsExpanded"
                              ShowPlaceholder="ShowHierarchyPlaceholder"
                              OnToggle="OnToggle" />

    @Cells
</tr>

<NotesRows Notes="Notes"
           LeadingColumns="1"
           ValueColumns="ValueColumns" />
