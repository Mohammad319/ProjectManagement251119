@using ProjectManagement.Shared.DTO.Calculation
@using ProjectManagement.Client.Shared.MVVM.Calculation
@inherits CalculationSelectableRowComponentBase

<CalculationDataRow RowStyle="@RowStyle"
                    Left="Left"
                    CanToggle="HasDetails"
                    IsExpanded="IsDetailsOpen"
                    OnToggle="ToggleDetails"
                    ShowHierarchyPlaceholder="Left > 0"
                    OnClick="Click"
                    OnContextMenu="Context"
                    Cells="_resourceCells"
                    Notes="Resource.Data?.UpperNote"
                    ValueColumns="Colmuns.Count" />

@if (HasDetails && IsDetailsOpen)
{
    <ResourceDetailRows Resource="Resource"
                        Colmuns="Colmuns"
                        Left="Left"
                        MaxFractionDigits="MaxFractionDigits"
                        Color="Color" />
}
