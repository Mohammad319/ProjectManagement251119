@using ProjectManagement.Shared.DTO.Calculation
@using ProjectManagement.Client.Shared.MVVM.Calculation
@inherits AppComponentBase

<tr @onclick="Click"
    @oncontextmenu="Context"
    @oncontextmenu:preventDefault
    style="@Resource.Style(Template.NetCalc?.Color?.Resource, Resource.Active)">
    <td></td>

    @if (Template.NetCalc?.Columns is not null)
    {
        @foreach (var col in Template.NetCalc.Columns)
        {
            @Colmuns[(int)col.Id].ResRender(Resource)
        }
    }
</tr>

@if (Resource.Data?.UpperNote != null && CalcService.ShowComments)
{
    @Note(Resource.Data.UpperNote, 3, Template.NetCalc?.Columns?.Count ?? 0)
}

@code {
    [Parameter] public ResourceListMVVM Resource { get; set; } = default!;
    [Parameter] public int Left { get; set; } = 0;
    [Parameter] public List<CalcColmunDefinition<TaskListMVVM, ResourceListMVVM>> Colmuns { get; set; } = default!;

    void Click() =>
        TableRenderHelpers.HandleItemSelected(Resource.Id, Resource.Quantity, CalculationItemType.resource);

    protected override void OnParametersSet()
    {
        // مع Virtualize قد يتم إعادة استخدام نفس component لصفوف مختلفة،
        // لذلك نعيد ربط الإجراء مع المورد الحالي في كل تحديث للـ Parameters.
        var currentResource = Resource;
        currentResource.OfferClick = () => UoWService.Resource.HandleOfferAsync(currentResource);
    }

    async Task Context()
    {
        // ❗ هذا كان مكلف: FirstOrDefault + Any على كل Task وكل Resources
        // الأفضل: استخدم TaskId مباشرة إن كانت متاحة على Resource
        // إذا Resource عنده TaskId استخدمه:
        // int taskId = Resource.TaskId ?? 0;

        // لو ما عندك TaskId، على الأقل اجعل البحث أسرع:
        int taskId = 0;
        for (int i = 0; i < Calc.Tasks.Count; i++)
        {
            var t = Calc.Tasks[i];
            if (t.Resources != null)
            {
                for (int j = 0; j < t.Resources.Count; j++)
                {
                    if (t.Resources[j].Id == Resource.Id)
                    {
                        taskId = t.Id;
                        i = Calc.Tasks.Count; // break outer
                        break;
                    }
                }
            }
        }

        await UoWService.Resource.Context(Resource, taskId);
    }

    public static RenderFragment Note(List<string> notes, int col1, int col2) => builder =>
    {
        var seq = 0;
        foreach (var note in notes)
        {
            builder.OpenElement(seq++, "tr");
            builder.AddAttribute(seq++, "class", "netNote");

            builder.OpenElement(seq++, "td");
            builder.AddAttribute(seq++, "class", "NettdDiv bg-white dark:bg-black");
            builder.AddAttribute(seq++, "colspan", col1);
            builder.AddAttribute(seq++, "style", $"width:{TemplateConst.Col0}px;");
            builder.CloseElement();

            builder.OpenElement(seq++, "td");
            builder.AddAttribute(seq++, "colspan", col2);
            builder.AddContent(seq++, note);
            builder.CloseElement();

            builder.CloseElement();
        }
    };
}
