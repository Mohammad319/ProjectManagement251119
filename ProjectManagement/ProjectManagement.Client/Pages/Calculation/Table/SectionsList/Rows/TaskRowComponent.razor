@using ProjectManagement.Shared.DTO.Calculation
@using ProjectManagement.Client.Shared.MVVM.Calculation
@inherits CalculationSelectableRowComponentBase

<CalculationDataRow RowStyle="@RowStyle"
                    Left="Left"
                    CanToggle="HasDescendants"
                    IsExpanded="Task.Ui.CollSpan"
                    ShowHierarchyPlaceholder="Left > 0"
                    OnClick="RowClick"
                    OnContextMenu="RowContext"
                    OnToggle="ToggleCollapse"
                    Cells="_taskCells"
                    Notes="Task.Metadata?.UpperNote"
                    ValueColumns="Colmuns.Count" />

@if (HasConversionParameters)
{
    <TaskDetailRows Task="Task"
                    Colmuns="Colmuns"
                    Left="Left"
                    Color="Color" />
}
