<td>
    <div class="flex items-center gap-1" style="@IndentStyle">
        @if (CanToggle)
        {
            <span role="button"
                  @onclick="HandleToggle"
                  @onclick:stopPropagation="true"
                  class="@ToggleClass">
                @(IsExpanded ? "−" : "+")
            </span>
        }
        else if (ShowPlaceholder)
        {
            <span class="block w-5 h-5 shrink-0"></span>
        }
    </div>
</td>
