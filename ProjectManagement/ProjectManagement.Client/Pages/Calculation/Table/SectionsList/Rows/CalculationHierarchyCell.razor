<td>
    <div class="flex items-center" style="@IndentStyle">
        @if (CanToggle)
        {
            <span class="@ToggleClass"
                  role="button"
                  @onclick="HandleToggle"
                  @onclick:stopPropagation="true">
                @((MarkupString)Icons.TopBottom(IsExpanded))
            </span>
        }
        else if (ShowPlaceholder)
        {
            <span class="block w-5 h-5 shrink-0"></span>
        }
    </div>
</td>
