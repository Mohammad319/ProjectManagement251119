﻿@using Project.Component.Calculation.Table;
@using ProjectManagement.Client.Shared.MVVM.Calculation
@using ProjectManagement.Client.Shared.MVVM.Folder;
@using ProjectManagement.Client.Shared.Model.Project
@using ProjectManagement.Client.Shared.Model.Project.Calculation;
@using ProjectManagement.Shared.DTO.Calculation
@using ProjectManagement.Shared.DTO.Project
@inherits AppComponentBase

<div class="flex flex-wrap w-[96%] gap-4 text-sm text-gray-800 dark:text-gray-100">

    <!-- Left column -->
    <div class="flex-1 min-w-[300px]">
        <div class="grid grid-cols-[auto_1fr] gap-x-2 gap-y-1">
            <span class="font-medium">@CalcResource.calculation:</span>
            <span>(@Calc.Code) @Calc.Name</span>

            <span class="font-medium">@ResourceApp.organisation:</span>
            <span>@Calc.Company</span>

            <span class="font-medium">@CalcResource.project:</span>
            <span>(@Folder?.State?.ProjectSelected?.Code) @Folder?.State?.ProjectSelected?.Name</span>

            <span class="font-medium">@CalcResource.responsible:</span>
            <span>@Folder?.State?.ProjectSelected?.Responsible</span>

            <span class="font-medium">@ResourceIdentity.addUser:</span>
            <span>@Calc.Address</span>
        </div>
    </div>

    <!-- Right column -->
    <div class="flex-1 min-w-[300px]">
        <div class="grid grid-cols-[auto_1fr] gap-x-2 gap-y-1">
            <span class="font-medium">@ResourceApp.supervisor:</span>
            <span>@Calc.Supervisor</span>

            <span class="font-medium">@ResourceIdentity.customer:</span>
            <span>@Calc.Customer</span>

            <span class="font-medium">@ResourceApp.typeOfCompensation:</span>
            <span>@Calc.Compensation</span>
        </div>
    </div>

</div>

