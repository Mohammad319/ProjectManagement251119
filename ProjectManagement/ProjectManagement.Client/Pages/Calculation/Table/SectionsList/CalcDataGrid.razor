@using Microsoft.Extensions.Localization
@using Calculation.Table.Header
@using ProjectManagement.Client.Helper
@using ProjectManagement.Client.Pages.Calculation.Table.SectionsList.Rows
@using ProjectManagement.Client.Shared.MVVM.Calculation
@using ProjectManagement.Shared.DTO.Calculation.Template
@inject IStringLocalizer<CalcResource> CalcLoc

<div class="calc-grid-shell" dir="ltr">
    <div class="divNetCalc">
        <table tabindex="0"
               dir="ltr"
               @onkeydown="HandleKeyDown"
               @onkeyup="HandleKeyUp"
               id="resizeMe"
               class="resizable-table">
            <thead>
                <tr id="header-row">
                    @if (TH1ISvisible)
                    {
                        <th @key="Template.StartCol1"
                            id="h1"
                            class="draggable-table"
                            data-pm-frozen="true"
                            style="width:@(Template.StartCol1 + "px;")">
                            <span role="button" @onclick="ShFilter" class="text-outline-info">
                                @((MarkupString)Icons.Filter)
                            </span>
                        </th>
                    }
                    else
                    {
                        <th id="h1" class="draggable-table" data-pm-frozen="true"></th>
                    }

                    @for (int i = 0; i < HeaderColumns.Count; i++)
                    {
                        <th id="@("h" + (i + 2))"
                            class="@GetHeaderCssClass(i)"
                            data-pm-frozen="@GetFrozenHeaderAttribute(HeaderColumns[i].Id)"
                            style="width:@(HeaderColumns[i].Width)px;">
                            @CalcLoc[NetColumnLoc.Key[HeaderColumns[i].Id]]
                        </th>
                    }
                </tr>
                @if (Calc.FilterVM != null)
                {
                    <ProjectManagement.Client.Pages.Calculation.Table.Header.TableHeaderFilterDiv />
                }
            </thead>

            <tbody>
               

                @if (TryBuildSummaryTotals(out var summaryTotals))
                {
                    var summaryLabelColumnId = GetSummaryLabelColumnId();

                    <tr class="calc-summary-row">
                        <td class="calc-summary-row-leading"
                            data-pm-frozen="true">
                            @(summaryLabelColumnId is null ? CalcLoc["sum"] : string.Empty)
                        </td>

                        @for (int i = 0; i < HeaderColumns.Count; i++)
                        {
                            var columnId = HeaderColumns[i].Id;
                            var value = GetSummaryCellValue(columnId, summaryTotals);
                            var label = summaryLabelColumnId == columnId ? CalcLoc["sum"] : string.Empty;

                            <td class="@GetSummaryCellCssClass(columnId, summaryLabelColumnId)"
                                data-pm-frozen="@GetFrozenHeaderAttribute(columnId)">
                                @(string.IsNullOrWhiteSpace(value) ? label : value)
                            </td>
                        }
                    </tr>
                }

                <Virtualize @ref="virtualizeComponent"
                            SpacerElement="tr"
                            TItem="FlatItem"
                            Context="item"
                            ItemsProvider="LoadItems"
                            ItemSize="22"
                            OverscanCount="6">
                    <ItemContent>
                        @if (item.IsTask && Calc.ShowTasks)
                        {
                            var taskId = item.Task!.Id;
                            <TaskRowComponent @key="item.Key"
                                              Task="item.Task"
                                              ActiveParent="item.ParentActive"
                                              OnCollapseToggle="ToggleCollSpan"
                                              ShowActiveToggle="true"
                                              IsItemActive="item.Task.Active"
                                              OnToggleActive="async () => await ToggleTaskActiveById(taskId)"
                                              Colors="Template.NetCalc?.Color"
                                              Left="@(item.Depth * 10)"
                                              Colmuns="Columns" />
                        }
                        else if (item.IsResource && Calc.ShowResources)
                        {
                            var resourceId = item.Resource!.Id;
                            <ResourceRowComponent @key="item.Key"
                                                  Resource="item.Resource"
                                                  TaskBranchActive="item.ParentActive"
                                                  ShowActiveToggle="true"
                                                  IsItemActive="item.Resource.Active"
                                                  OnToggleActive="async () => await ToggleResourceActiveById(resourceId)"
                                                  Colors="Template.NetCalc?.Color"
                                                  Left="@(item.Depth * 10)"
                                                  MaxFractionDigits="Template.MathRound"
                                                  Colmuns="Columns" />
                        }
                    </ItemContent>
                </Virtualize>
            </tbody>
        </table>
    </div>
</div>
