<div class="relative">
    <span class="inline-flex items-center rounded px-2 py-1 text-slate-700 hover:bg-slate-100 cursor-pointer dark:text-slate-200 dark:hover:bg-slate-800"
          @onclick="ToggleDropdown">
        🧾 @ResourceApp.DisplayOptions
    </span>

    @if (IsOpen)
    {
        <div class="absolute z-50 mt-1 w-56 bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700 rounded-md shadow-lg text-sm">
            <div class="px-3 py-2 border-b border-gray-100 dark:border-slate-700 font-semibold">
                @ResourceApp.DisplayOptions
            </div>

            <label class="flex items-center gap-2 px-3 py-2 cursor-pointer hover:bg-gray-50 dark:hover:bg-slate-700">
                <input type="checkbox"
                       class="rounded"
                       checked
                       @bind-value="Calc.ShowTasks"
                       @bind-value:event="onchange"
                       @bind-value:after="NotifyStructureRefresh" />
                <span>@ResourceLoc.task</span>
            </label>

            <label class="flex items-center gap-2 px-3 py-2 cursor-pointer hover:bg-gray-50 dark:hover:bg-slate-700">
                <input type="checkbox"
                       class="rounded"
                       checked
                       @bind-value="Calc.ShowResources"
                       @bind-value:event="onchange"
                       @bind-value:after="NotifyStructureRefresh" />
                <span>@ResourceLoc.resource</span>
            </label>

            <label class="flex items-center gap-2 px-3 py-2 cursor-pointer hover:bg-gray-50 dark:hover:bg-slate-700">
                <input type="checkbox"
                       class="rounded"
                       checked
                       @bind-value="CalcService.ShowComments"
                       @bind-value:event="onchange" />
                <span>@CalcResource.note</span>
            </label>

            <label class="flex items-center gap-2 px-3 py-2 cursor-pointer hover:bg-gray-50 dark:hover:bg-slate-700">
                <input type="checkbox"
                       class="rounded"
                       checked
                       @bind-value="CalcService.ShowResourceVariables"
                       @bind-value:event="onchange" />
                <span>@AppLoc["storageVariables"]</span>
            </label>

            <label class="flex items-center gap-2 px-3 py-2 cursor-pointer hover:bg-gray-50 dark:hover:bg-slate-700 border-t border-gray-100 dark:border-slate-700">
                <input type="checkbox"
                       class="rounded"
                       @bind-value="Calc.OnlyActive"
                       @bind-value:event="onchange"
                       @bind-value:after="NotifyStructureRefresh" />
                <span>@ResourceLoc.onlyActive</span>
            </label>

            <div class="border-t border-gray-100 dark:border-slate-700 px-3 py-2">
                <button type="button"
                        class="w-full inline-flex items-center justify-center gap-2 rounded-lg bg-sky-600 px-3 py-1.5 text-xs font-medium text-white transition hover:bg-sky-700"
                        @onclick="OpenPresetsDialog">
                    @((MarkupString)Icons.SaveCloud)
                    <span>@AppLoc["displayPresets"]</span>
                </button>
            </div>
        </div>
    }
</div>
