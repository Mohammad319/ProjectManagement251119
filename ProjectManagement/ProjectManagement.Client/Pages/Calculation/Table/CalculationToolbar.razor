@using ContextMenuMHD
@using ProjectManagement.Client.Helper
@using ProjectManagement.Client.Shared.MVVM.Calculation

<div id="tit" class="flex flex-nowrap items-center gap-0.5 px-1 whitespace-nowrap shrink-0 text-[13px] leading-none">
    <span class="inline-flex items-center rounded text-slate-700 hover:bg-slate-100 cursor-pointer dark:text-slate-200 dark:hover:bg-slate-800"
          @onclick="() => TableCoordinator.ShowTaskForm(new TaskListMVVM())"
          title="@AppLoc[LocalizerConst.New, ResourceLoc.task]">
        @Icons.Plus2
    </span>

    <AuthorizeView Roles="@PMRolesConst.Tenant.AdminManger" Context="authContext">
        <Authorized>
            @if (Calc.Tap1)
            {
                <span title="@ResourceApp.importFromFile"
                      class="inline-flex items-center rounded text-slate-700 hover:bg-slate-100 cursor-pointer dark:text-slate-200 dark:hover:bg-slate-800"
                      @onclick="TableCoordinator.ShowImportDialog">
                    @((MarkupString)Icons.ImportFromFile)
                </span>

                <span class="inline-flex items-center rounded text-slate-700 hover:bg-slate-100 cursor-pointer dark:text-slate-200 dark:hover:bg-slate-800"
                      title="@ResourceLoc.template"
                      @onclick="TableCoordinator.ShowTemplateDialog">
                    @((MarkupString)Icons.Template)
                </span>

                <span title="@ResourceApp.reOrder"
                      class="inline-flex items-center rounded text-slate-700 hover:bg-slate-100 cursor-pointer dark:text-slate-200 dark:hover:bg-slate-800"
                      @onclick="() => TableCoordinator.ShowTaskReorderDialog()">
                    @((MarkupString)Icons.ReorderRows)
                </span>
            }

            @if (InteractionState.SelectedItems.Count != 0)
            {
                <span class="inline-flex items-center rounded text-slate-700 hover:bg-slate-100 cursor-pointer dark:text-slate-200 dark:hover:bg-slate-800"
                      @onclick="TableCoordinator.UnselectAll"
                      title="@ResourceLoc.unselectAll">
                    @((MarkupString)Icons.NotSelected)
                </span>
            }

            @if (CanPasteTasks)
            {
                <span class="inline-flex items-center rounded text-slate-700 hover:bg-slate-100 cursor-pointer dark:text-slate-200 dark:hover:bg-slate-800"
                      @onclick="() => TableCoordinator.PasteAsync(0)"
                      title="@ResourceApp.paste">
                    @((MarkupString)Icons.Paste)
                </span>
            }

            @if (CalcService.Offer != null)
            {
                <CalculationOfferBadge Offer="CalcService.Offer" />
            }
        </Authorized>
    </AuthorizeView>

    @* <CalculationDisplayOptions /> *@

    <span class="inline-flex items-center rounded text-slate-700 hover:bg-slate-100 cursor-pointer dark:text-slate-200 dark:hover:bg-slate-800"
          @onclick="TableCoordinator.ToggleOH">
        @(Calc.OHFactors ? "OH" : CalcResource.netCal)
    </span>

    <span class="inline-flex items-center rounded text-slate-700 hover:bg-slate-100 cursor-pointer dark:text-slate-200 dark:hover:bg-slate-800"
          title="@CalcResource.quantity"
          @onclick="TableCoordinator.ShowQuantityDialog">
        @((MarkupString)Icons.ResetQuantity)
    </span>
</div>
