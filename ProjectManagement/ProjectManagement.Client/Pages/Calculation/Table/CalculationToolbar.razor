@using ContextMenuMHD
@using ProjectManagement.Client.Helper
@using ProjectManagement.Client.Shared.MVVM.Calculation
@using ProjectManagement.Shared.DTO.Calculation.Template

<div id="tit" class="flex flex-nowrap items-center gap-0.5 px-1 whitespace-nowrap shrink-0 text-[13px] leading-none">
    <span class="inline-flex items-center rounded text-slate-700 hover:bg-slate-100 cursor-pointer dark:text-slate-200 dark:hover:bg-slate-800"
          @onclick="() => TableCoordinator.ShowTaskForm(new TaskListMVVM())"
          title="@AppLoc[LocalizerConst.New, ResourceLoc.task]">
        @Icons.Plus2
    </span>

    <AuthorizeView Roles="@PMRolesConst.Tenant.AdminManger" Context="authContext">
        <Authorized>
            @if (Calc.Tap1)
            {
                <span title="@ResourceApp.importFromFile"
                      class="inline-flex items-center rounded text-slate-700 hover:bg-slate-100 cursor-pointer dark:text-slate-200 dark:hover:bg-slate-800"
                      @onclick="TableCoordinator.ShowImportDialog">
                    @((MarkupString)Icons.ImportFromFile)
                </span>

                <div class="inline-flex min-w-0 items-center gap-1 rounded px-1 text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800">
                    <span class="pointer-events-none inline-flex items-center"
                          title="@ResourceLoc.template">
                        @((MarkupString)Icons.Template)
                    </span>

                    <select class="min-w-[4rem] max-w-[9rem] cursor-pointer bg-transparent text-[12px] leading-none text-slate-700 outline-none disabled:cursor-wait dark:bg-slate-900 dark:text-slate-100"
                            title="@ResourceLoc.templates"
                            aria-label="@ResourceLoc.templates"
                            data-testid="toolbar-template-select"
                            value="@SelectedTemplateValue"
                            @onchange="OnTemplateChangedAsync"
                            disabled="@IsTemplateSelectionDisabled">
                        <option class="bg-white text-slate-900 dark:bg-slate-900 dark:text-slate-100" value="">@ResourceApp._default</option>

                        @foreach (var template in TemplateOptions)
                        {
                            <option class="bg-white text-slate-900 dark:bg-slate-900 dark:text-slate-100" value="@template.Id">@template.Name</option>
                        }
                    </select>
                </div>

                <div class="inline-flex min-w-0 items-center gap-1 rounded px-1 text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800">
                    <span class="pointer-events-none inline-flex items-center"
                          title="@AppLoc["columnTemplate"]">
                        @((MarkupString)Icons.Template)
                    </span>

                    <select class="min-w-[4rem] max-w-[9rem] cursor-pointer bg-transparent text-[12px] leading-none text-slate-700 outline-none disabled:cursor-wait dark:bg-slate-900 dark:text-slate-100"
                            title="@AppLoc["columnTemplate"]"
                            aria-label="@AppLoc["columnTemplate"]"
                            value="@SelectedTemplateColumnValue"
                            @onchange="OnTemplateColumnChangedAsync"
                            disabled="@IsTemplateColumnSelectionDisabled">
                        <option class="bg-white text-slate-900 dark:bg-slate-900 dark:text-slate-100" value="">@ResourceApp._default</option>

                        @foreach (var templateColumn in TemplateColumnOptions)
                        {
                            <option class="bg-white text-slate-900 dark:bg-slate-900 dark:text-slate-100" value="@templateColumn.Id">@templateColumn.Name</option>
                        }
                    </select>
                </div>

                <div class="inline-flex min-w-0 items-center gap-0.5 rounded px-1 text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800">
                    <select class="min-w-[4.5rem] max-w-[8rem] cursor-pointer bg-transparent text-[12px] leading-none text-slate-700 outline-none disabled:cursor-wait dark:bg-slate-900 dark:text-slate-100"
                            title="@AppLoc["resourceSort"]"
                            aria-label="@AppLoc["resourceSort"]"
                            value="@ResourceSortColumnValue"
                            @onchange="OnResourceSortColumnChangedAsync"
                            disabled="@IsUpdatingSort">
                        <option class="bg-white text-slate-900 dark:bg-slate-900 dark:text-slate-100" value="">@AppLoc["resource"]</option>
                        @foreach (var (id, label) in ResourceSortColumns)
                        {
                            <option class="bg-white text-slate-900 dark:bg-slate-900 dark:text-slate-100" value="@((int)id)">@label</option>
                        }
                    </select>

                    <button type="button"
                            class="@GetSortDirectionClass(!Calc.Sort.ResourceDescending)"
                            title="@AppLoc["resourceAscending"]"
                            disabled="@IsUpdatingSort"
                            @onclick="() => SetResourceSortDescendingAsync(false)">
                        ↑
                    </button>
                    <button type="button"
                            class="@GetSortDirectionClass(Calc.Sort.ResourceDescending)"
                            title="@AppLoc["resourceDescending"]"
                            disabled="@IsUpdatingSort"
                            @onclick="() => SetResourceSortDescendingAsync(true)">
                        ↓
                    </button>
                </div>

                <span title="@ResourceApp.reOrder"
                      class="inline-flex items-center rounded text-slate-700 hover:bg-slate-100 cursor-pointer dark:text-slate-200 dark:hover:bg-slate-800"
                      @onclick="() => TableCoordinator.ShowTaskReorderDialog()">
                    @((MarkupString)Icons.ReorderRows)
                </span>
            }

            @if (InteractionState.SelectedItems.Count != 0)
            {
                <span class="inline-flex items-center rounded text-slate-700 hover:bg-slate-100 cursor-pointer dark:text-slate-200 dark:hover:bg-slate-800"
                      @onclick="TableCoordinator.UnselectAll"
                      title="@ResourceLoc.unselectAll">
                    @((MarkupString)Icons.NotSelected)
                </span>
            }

            @if (CanPasteTasks)
            {
                <span class="inline-flex items-center rounded text-slate-700 hover:bg-slate-100 cursor-pointer dark:text-slate-200 dark:hover:bg-slate-800"
                      @onclick="() => TableCoordinator.PasteAsync(0)"
                      title="@ResourceApp.paste">
                    @((MarkupString)Icons.Paste)
                </span>
            }

            @if (CalcService.Offer != null)
            {
                <CalculationOfferBadge Offer="CalcService.Offer" />
            }
        </Authorized>
    </AuthorizeView>

    @* <CalculationDisplayOptions /> *@

    <div class="inline-flex min-w-0 items-center gap-1 rounded px-1 text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800">
        <select class="min-w-[5rem] max-w-[10rem] cursor-pointer bg-transparent text-[12px] leading-none text-slate-700 outline-none dark:bg-slate-900 dark:text-slate-100"
                title="@FactorDisplayTitle"
                aria-label="@FactorDisplayTitle"
                value="@SelectedFactorDisplayValue"
                @onchange="OnFactorDisplayChanged">
            <option class="bg-white text-slate-900 dark:bg-slate-900 dark:text-slate-100" value="@((int)CalculationFactorDisplayMode.NetCal)">@CalcResource.netCal</option>
            <option class="bg-white text-slate-900 dark:bg-slate-900 dark:text-slate-100" value="@((int)CalculationFactorDisplayMode.OH)">OH</option>
            <option class="bg-white text-slate-900 dark:bg-slate-900 dark:text-slate-100" value="@((int)CalculationFactorDisplayMode.All)">@($"{CalcResource.netCal} + OH")</option>
        </select>
    </div>

    <span class="inline-flex items-center rounded text-slate-700 hover:bg-slate-100 cursor-pointer dark:text-slate-200 dark:hover:bg-slate-800"
          title="@CalcResource.quantity"
          @onclick="TableCoordinator.ShowQuantityDialog">
        @((MarkupString)Icons.ResetQuantity)
    </span>
</div>
