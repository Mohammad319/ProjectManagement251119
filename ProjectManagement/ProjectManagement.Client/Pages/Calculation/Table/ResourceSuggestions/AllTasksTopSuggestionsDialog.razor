@using ProjectManagement.Client.Shared.MVVM.Calculation
@using ProjectManagement.Client.Shared.ResourceFiles.Calculation
@using ProjectManagement.Shared.DTO.Calculation
@using ProjectManagement.Shared.Base.Calculation
@using ProjectManagement.Shared.Helper.ProjectAppStorage
@using ProjectManagement.Shared.Helper.Text
@using Microsoft.JSInterop
@using System.Text.Json
@using System.Globalization
@inherits AppComponentBase
@inject IJSRuntime JS

<div class="flex flex-col gap-3 min-h-0">

    <!-- ── Toolbar ── -->
    <div class="flex flex-wrap items-center gap-4 rounded border border-gray-200 bg-gray-50 px-4 py-2 dark:border-gray-700 dark:bg-gray-900">

        <label class="flex cursor-pointer items-center gap-2 text-sm font-medium text-gray-700 dark:text-gray-300">
            <input type="checkbox" checked="@_showSystem"
                   @onchange="async e => await OnSourceFilterChangedAsync(true, (bool)(e.Value ?? false))"
                   class="h-4 w-4 cursor-pointer accent-blue-600" />
            <span class="rounded bg-blue-100 px-1.5 py-0.5 text-xs font-semibold text-blue-700 dark:bg-blue-950 dark:text-blue-300">BlueprintTask</span>
            <span>@CalcResource.resourceTypeSystem</span>
        </label>

        <label class="flex cursor-pointer items-center gap-2 text-sm font-medium text-gray-700 dark:text-gray-300">
            <input type="checkbox" checked="@_showTenant"
                   @onchange="async e => await OnSourceFilterChangedAsync(false, (bool)(e.Value ?? false))"
                   class="h-4 w-4 cursor-pointer accent-emerald-600" />
            <span class="rounded bg-emerald-100 px-1.5 py-0.5 text-xs font-semibold text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300">TenantTask</span>
            <span>@CalcResource.resourceType</span>
        </label>

        <div class="relative flex-1">
            <input type="search"
                   placeholder="Filter tasks..."
                   value="@_taskFilter"
                   @oninput="OnTaskFilterChangedAsync"
                   class="w-full rounded border border-gray-300 bg-white py-1 pl-7 pr-3 text-sm text-gray-700 placeholder-gray-400 focus:border-blue-400 focus:outline-none dark:border-gray-600 dark:bg-gray-800 dark:text-gray-200 dark:placeholder-gray-500" />
            <svg class="pointer-events-none absolute left-1.5 top-1.5 h-4 w-4 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
            </svg>
        </div>

        <div class="flex shrink-0 items-center gap-1.5">
            <label class="text-xs font-medium text-gray-500 dark:text-gray-400 whitespace-nowrap">Min score</label>
            <input type="range" min="0" max="100" step="5"
                   value="@((int)(_minScore * 100))"
                   @oninput="OnMinScoreChangedAsync"
                   class="w-24 accent-blue-600" />
            <span class="w-8 text-right text-xs font-semibold text-gray-600 dark:text-gray-300">
                @(_minScore > 0 ? $"{(int)(_minScore * 100)}%" : "All")
            </span>
        </div>

        <button class="inline-flex h-8 items-center rounded border border-gray-300 bg-white px-3 text-sm font-medium text-gray-700 hover:border-blue-500 hover:text-blue-600 disabled:cursor-not-allowed disabled:opacity-50 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-200"
                disabled="@(_loading || _saving)" @onclick="LoadAsync">
            @AppLoc["update"]
        </button>

        <button class="inline-flex h-8 items-center rounded border border-emerald-600 bg-emerald-600 px-3 text-sm font-medium text-white hover:bg-emerald-700 disabled:cursor-not-allowed disabled:opacity-50 dark:border-emerald-500 dark:bg-emerald-500"
                disabled="@(_loading || _saving || !_hasLoaded || !HasAnySelected)"
                @onclick="SaveAllAsync">
            @ResourceApp.save
        </button>

    </div>

    @if (_hasLoaded && _missingTasksCount > 0)
    {
        <div class="flex items-center gap-2 rounded border border-amber-200 bg-amber-50 px-3 py-1.5 text-xs text-amber-700 dark:border-amber-800 dark:bg-amber-950/30 dark:text-amber-400">
            <svg class="h-3.5 w-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
            </svg>
            <span>@_missingTasksCount @(_missingTasksCount == 1 ? "task has" : "tasks have") no suggestions</span>
        </div>
    }

    <!-- ── States ── -->
    @if (_loading)
    {
        <div class="py-12"><BlazorMHD.UI.Components.Feedback.Loading.MhdLoading /></div>
    }
    else if (!_hasLoaded)
    {
        <div class="rounded border border-dashed border-gray-300 px-3 py-10 text-center text-sm text-gray-400 dark:border-gray-700 dark:text-gray-500">
            @AppLoc["update"]
        </div>
    }
    else if (VisibleEntries.Count == 0)
    {
        <div class="rounded border border-dashed border-gray-300 px-3 py-10 text-center text-sm text-gray-500 dark:border-gray-700 dark:text-gray-400">
            @NoVisibleEntriesMessage
        </div>
    }
    else
    {
        <div class="flex flex-col gap-2 overflow-y-auto">
            @foreach (var entry in VisibleEntries)
            {
                var selIdx   = entry.SelectedIndex;
                var selSug   = selIdx.HasValue ? entry.Suggestions[selIdx.Value] : null;
                var isLoad   = selIdx.HasValue && entry.LoadingSet.Contains(selIdx.Value);
                var selRows  = selIdx.HasValue ? entry.GetRows(selIdx.Value) : null;

                <div class="overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm dark:border-gray-700 dark:bg-gray-900">

                    <!-- ── Task row ── -->
                    <div class="flex min-w-0 items-start gap-2 px-3 py-2.5">

                        <!-- original task identity -->
                        <div class="min-w-0 flex-[1_1_18rem]">
                            <div class="flex flex-wrap items-center gap-1.5">
                                @if (!string.IsNullOrWhiteSpace(entry.Task.Code))
                                {
                                    <span class="shrink-0 rounded bg-gray-200 px-1.5 py-0.5 font-mono text-xs font-semibold text-gray-700 dark:bg-gray-700 dark:text-gray-200">@entry.Task.Code</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(entry.Task.Unit))
                                {
                                    <span class="shrink-0 rounded bg-gray-100 px-1.5 py-0.5 text-xs text-gray-500 ring-1 ring-gray-300 dark:bg-gray-800 dark:text-gray-400 dark:ring-gray-600">@entry.Task.Unit</span>
                                }
                                @if (entry.Task.Quantity is > 0)
                                {
                                    <span class="shrink-0 rounded bg-gray-100 px-1.5 py-0.5 text-xs font-medium text-gray-600 ring-1 ring-gray-300 dark:bg-gray-800 dark:text-gray-300 dark:ring-gray-600">@entry.Task.Quantity?.ToString("0.###", CultureInfo.InvariantCulture)</span>
                                }
                            </div>
                            <div class="mt-1 min-w-0 overflow-hidden whitespace-normal text-sm font-semibold leading-snug text-gray-800 dark:text-gray-100"
                                 style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;"
                                 title="@entry.Task.Name">
                                @entry.Task.Name
                            </div>
                        </div>

                        <!-- score bar for selected suggestion -->
                        @if (selSug is not null)
                        {
                            <div class="flex shrink-0 items-center gap-1">
                                <div class="h-1.5 w-12 overflow-hidden rounded-full bg-gray-200 dark:bg-gray-700">
                                    <div class="h-full rounded-full @GetScoreColorClass(selSug.Score)"
                                         style="width:@((selSug.Score * 100).ToString("0", CultureInfo.InvariantCulture))%"></div>
                                </div>
                                <span class="w-8 shrink-0 text-right text-xs font-semibold @GetScoreTextClass(selSug.Score)">@selSug.Score.ToString("0%", CultureInfo.InvariantCulture)</span>
                            </div>
                            <span class="shrink-0 rounded px-1.5 py-0.5 text-[10px] font-semibold @GetSourceBadgeClass(selSug.Source)">@selSug.Source</span>
                            @if (UsesParentContext(selSug))
                            {
                                <span class="shrink-0 rounded bg-indigo-50 px-1.5 py-0.5 text-[10px] font-semibold text-indigo-700 ring-1 ring-indigo-200 dark:bg-indigo-950/40 dark:text-indigo-300 dark:ring-indigo-800"
                                      title="@selSug.Reason">
                                    Parent context
                                </span>
                            }
                            <SuggestionScoreDetails Details="selSug.ScoreDetails" MaxItems="4" />
                        }

                        <!-- suggestions dropdown -->
                        <select class="min-w-0 flex-[1_1_22rem] rounded border border-gray-300 bg-white px-2 py-1 text-xs text-gray-700 focus:border-blue-400 focus:outline-none dark:border-gray-600 dark:bg-gray-800 dark:text-gray-200"
                                title="@(selSug is not null ? BuildOptionText(selIdx ?? 0, selSug) : null)"
                                @onchange="async e => { if (int.TryParse(e.Value?.ToString(), out var idx)) await SelectSuggestionAsync(entry, idx); }">
                            @for (var i = 0; i < entry.Suggestions.Count; i++)
                            {
                                var optIdx = i;
                                var sug    = entry.Suggestions[optIdx];
                                <option value="@optIdx" selected="@(selIdx == optIdx)">@BuildOptionText(optIdx, sug)</option>
                            }
                        </select>

                        <!-- toggle resources -->
                        @if (isLoad)
                        {
                            <span class="shrink-0 px-1 text-xs text-gray-400 dark:text-gray-500">…</span>
                        }
                        else
                        {
                            <button class="flex h-7 w-7 shrink-0 items-center justify-center rounded border border-gray-300 text-gray-500 transition hover:border-blue-400 hover:text-blue-600 dark:border-gray-600 dark:text-gray-400 @(entry.ResourcesExpanded ? "border-blue-400 bg-blue-50 text-blue-600 dark:bg-blue-950/30" : "")"
                                    title="@(entry.ResourcesExpanded ? "Hide resources" : "Show resources")"
                                    @onclick="() => ToggleExpandAsync(entry)">
                                <span class="text-[10px] font-bold leading-none">@(entry.ResourcesExpanded ? "▼" : "▶")</span>
                            </button>
                        }

                        @if (selSug is not null)
                        {
                            <div class="flex shrink-0 items-center gap-1">
                                <select value="@FeedbackSelectValue(entry, selSug)"
                                        disabled="@entry.FeedbackSaving"
                                        title="Suggestion feedback"
                                        @onchange="e => OnFeedbackSelected(entry, selSug, e.Value?.ToString())"
                                        class="@FeedbackSelectClass(entry, selSug)">
                                    <option value="">Feedback</option>
                                    <option value="@TaskResourceSuggestionFeedbackKind.Accepted">Good</option>
                                    <option value="@TaskResourceSuggestionFeedbackKind.Rejected">Bad</option>
                                    <option value="@TaskResourceSuggestionFeedbackKind.WrongUnit">Unit</option>
                                    <option value="@TaskResourceSuggestionFeedbackKind.MissingResources">Missing</option>
                                    <option value="@TaskResourceSuggestionFeedbackKind.WrongResourceType">Type</option>
                                </select>
                                <button class="rounded border border-blue-600 px-2 py-1 text-xs font-medium text-blue-700 hover:bg-blue-50 disabled:opacity-40 dark:border-blue-400 dark:text-blue-300 dark:hover:bg-blue-950"
                                        disabled="@(entry.FeedbackSaving || !entry.GetPendingFeedback(selSug).HasValue)"
                                        title="Save feedback"
                                        @onclick="() => SavePendingFeedbackAsync(entry, selSug)">
                                    Save
                                </button>
                            </div>
                        }

                    </div>

                    <!-- ── Resources panel ── -->
                    @if (entry.ResourcesExpanded)
                    {
                        @if (isLoad)
                        {
                            <div class="border-t border-gray-100 px-4 py-3 dark:border-gray-800">
                                <BlazorMHD.UI.Components.Feedback.Loading.MhdLoading />
                            </div>
                        }
                        else if (selRows is { Count: 0 })
                        {
                            <div class="border-t border-gray-100 px-4 py-2 text-xs text-gray-400 dark:border-gray-800 dark:text-gray-500">@CalcResource.suggestionNoResults</div>
                        }
                        else if (selRows is not null)
                        {
                            var convRule   = selSug is not null ? GetConversionRule(entry.Task.Unit, selSug.SourceTaskUnit) : null;
                            var userParams = convRule?.Params.Where(p => p.Source == ParamSource.User).ToList() ?? [];
                            var hasResPrm  = convRule?.Params.Any(p => p.Source == ParamSource.Resource) ?? false;
                            var canCompute = convRule == null || (!hasResPrm && userParams.All(p => entry.ConversionParams.ContainsKey(p.Key)));
                            var convQty    = selSug is not null ? GetConvertedQty(entry, selSug.SourceTaskUnit) : (entry.Task.Quantity ?? 0m);

                            <!-- ── Unit conversion panel ── -->
                            @if (convRule is not null)
                            {
                                <div class="border-b border-amber-200 bg-amber-50 px-3 py-2 dark:border-amber-900/40 dark:bg-amber-950/20">
                                    <div class="flex flex-wrap items-center gap-3">

                                        <span class="shrink-0 text-xs font-semibold text-amber-700 dark:text-amber-400">
                                            ⚠ @UnitRulesCatalog.BuildKey(entry.Task.Unit) → @UnitRulesCatalog.BuildKey(selSug!.SourceTaskUnit)
                                        </span>

                                        <span class="shrink-0 rounded bg-amber-100 px-2 py-0.5 font-mono text-[11px] font-semibold text-amber-800 ring-1 ring-amber-200 dark:bg-amber-950/40 dark:text-amber-300 dark:ring-amber-800">
                                            @BuildFormulaText(entry.Task.Quantity ?? 0m, entry.Task.Unit, convRule)
                                        </span>

                                        @foreach (var param in userParams)
                                        {
                                            var p = param;
                                            <div class="flex items-center gap-1">
                                                <label class="shrink-0 text-xs text-amber-700 dark:text-amber-400">@GetParamLabel(p.Key)</label>
                                                <input type="number" step="0.001" placeholder="0"
                                                       value="@(entry.ConversionParams.TryGetValue(p.Key, out var pv) ? pv.ToString("0.###", CultureInfo.InvariantCulture) : "")"
                                                       @onchange="e => OnConvParamChanged(entry, p.Key, e.Value?.ToString(), selSug!.SourceTaskUnit)"
                                                       class="w-20 rounded border border-amber-300 bg-white px-1.5 py-0.5 text-xs text-gray-900 focus:border-amber-500 focus:outline-none dark:border-amber-700 dark:bg-gray-800 dark:text-gray-100" />
                                            </div>
                                        }

                                        @if (canCompute && convQty != (entry.Task.Quantity ?? 0m))
                                        {
                                            <span class="rounded bg-amber-200 px-2 py-0.5 text-xs font-bold text-amber-900 dark:bg-amber-900/50 dark:text-amber-200">
                                                = @convQty.ToString("0.###", CultureInfo.InvariantCulture) @UnitRulesCatalog.BuildKey(selSug!.SourceTaskUnit)
                                            </span>
                                        }

                                        @if (hasResPrm)
                                        {
                                            <span class="text-[11px] italic text-amber-600 dark:text-amber-500">* density comes from resource</span>
                                        }

                                    </div>
                                </div>
                            }
                            <div class="overflow-x-auto border-t border-gray-100 dark:border-gray-800">
                                <table class="w-full text-sm">
                                    <thead class="border-b border-slate-200 bg-slate-50 text-xs dark:border-slate-800 dark:bg-slate-950">
                                        <tr>
                                            <th class="w-10 px-2 py-1.5"></th>
                                            <th class="min-w-[10rem] px-2 py-1.5 text-left font-medium text-slate-500 dark:text-slate-400">@CalcResource.name</th>
                                            <th class="px-2 py-1.5 text-left font-medium text-slate-500 dark:text-slate-400">@CalcResource.type</th>
                                            <th class="px-2 py-1.5 text-left font-medium text-slate-500 dark:text-slate-400">@CalcResource.unit</th>
                                            <th class="w-16 px-2 py-1.5 text-center font-medium text-slate-500 dark:text-slate-400">@CalcResource.active</th>
                                            <th class="w-24 px-2 py-1.5 text-right font-medium text-slate-500 dark:text-slate-400">@CalcResource.cost</th>
                                            <th class="w-24 px-2 py-1.5 text-right font-medium text-slate-500 dark:text-slate-400">@CalcResource.baseCost</th>
                                            <th class="w-24 px-2 py-1.5 text-right font-medium text-slate-500 dark:text-slate-400">@CalcResource.changeFactor1</th>
                                            <th class="w-20 px-2 py-1.5 text-center font-medium text-slate-500 dark:text-slate-400">CapTask</th>
                                            <th class="w-24 px-2 py-1.5 text-right font-medium text-slate-500 dark:text-slate-400">@CalcResource.co2</th>
                                            <th class="w-24 px-2 py-1.5 text-right font-medium text-slate-500 dark:text-slate-400">@CalcResource.cap</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in selRows)
                                        {
                                            <tr style="@ResourceRowStyle" class="border-b border-slate-100 transition-opacity dark:border-slate-800 @(row.Included ? "" : "opacity-40")">
                                                <td class="px-2 py-1.5 text-center align-middle">
                                                    <button class="flex h-6 w-6 items-center justify-center rounded border text-sm font-bold leading-none transition
                                                                   @(row.Included
                                                                       ? "border-red-300 text-red-500 hover:bg-red-50 dark:border-red-700 dark:text-red-400"
                                                                       : "border-emerald-400 text-emerald-600 hover:bg-emerald-50 dark:border-emerald-600 dark:text-emerald-400")"
                                                            @onclick="() => row.Included = !row.Included">
                                                        @(row.Included ? "−" : "+")
                                                    </button>
                                                </td>
                                                <td class="px-2 py-1.5 align-middle">
                                                    <input type="text" value="@row.Name"
                                                           @onchange="e => row.Name = e.Value?.ToString() ?? row.Name"
                                                           disabled="@(!row.Included)" class="@InputCls" />
                                                </td>
                                                <td class="px-2 py-1.5 align-middle text-slate-500 dark:text-slate-400">@row.Resource.ResType</td>
                                                <td class="px-2 py-1.5 align-middle text-slate-500 dark:text-slate-400">@(string.IsNullOrWhiteSpace(row.Resource.Unit) ? "—" : row.Resource.Unit)</td>
                                                <td class="px-2 py-1.5 text-center align-middle">
                                                    <input type="checkbox" checked="@row.IsActive"
                                                           @onchange="e => row.IsActive = (bool)(e.Value ?? true)"
                                                           disabled="@(!row.Included)" class="h-4 w-4 cursor-pointer accent-blue-600" />
                                                </td>
                                                <td class="px-2 py-1.5 align-middle">
                                                    <input type="number" step="0.01"
                                                           value="@row.Cost.ToString("0.##", CultureInfo.InvariantCulture)"
                                                           @onchange="e => { if (decimal.TryParse(e.Value?.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var v)) row.Cost = v; }"
                                                           disabled="@(!row.Included)" class="@NumInputCls" />
                                                </td>
                                                <td class="px-2 py-1.5 align-middle">
                                                    <input type="number" step="0.01"
                                                           value="@(row.BaseCost?.ToString("0.##", CultureInfo.InvariantCulture) ?? "")"
                                                           @onchange="e => { if (decimal.TryParse(e.Value?.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var v)) row.BaseCost = v; else row.BaseCost = null; }"
                                                           disabled="@(!row.Included)" class="@NumInputCls" />
                                                </td>
                                                <td class="px-2 py-1.5 text-right align-middle">
                                                    @if (row.HasParameters)
                                                    {
                                                        <span class="rounded bg-blue-50 px-1.5 py-0.5 text-xs font-semibold text-blue-700 dark:bg-blue-950 dark:text-blue-300">
                                                            @row.ChangeFactor1.ToString("0.####", CultureInfo.InvariantCulture)
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <input type="number" step="0.0001"
                                                               value="@row.ChangeFactor1.ToString("0.####", CultureInfo.InvariantCulture)"
                                                               @onchange="e => { if (decimal.TryParse(e.Value?.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var v)) row.ChangeFactor1 = v; }"
                                                               disabled="@(!row.Included)" class="@NumInputCls" />
                                                    }
                                                </td>
                                                <td class="px-2 py-1.5 text-center align-middle">
                                                    <input type="checkbox" checked="@row.CapFromTask"
                                                           @onchange="e => row.CapFromTask = (bool)(e.Value ?? false)"
                                                           disabled="@(!row.Included)" class="h-4 w-4 cursor-pointer accent-emerald-600" />
                                                </td>
                                                <td class="px-2 py-1.5 align-middle">
                                                    <input type="number" step="0.01"
                                                           value="@(row.CO2?.ToString("0.##", CultureInfo.InvariantCulture) ?? "")"
                                                           @onchange="e => { if (double.TryParse(e.Value?.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var v)) row.CO2 = v; else row.CO2 = null; }"
                                                           disabled="@(!row.Included)" class="@NumInputCls" />
                                                </td>
                                                <td class="px-2 py-1.5 align-middle">
                                                    <input type="number" step="0.0001"
                                                           value="@row.CapWaste.ToString("0.####", CultureInfo.InvariantCulture)"
                                                           @onchange="e => { if (decimal.TryParse(e.Value?.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var v)) row.CapWaste = v; }"
                                                           disabled="@(!row.Included)" class="@NumInputCls" />
                                                </td>
                                            </tr>

                                            @foreach (var p in row.Resource.Data.Parameters)
                                            {
                                                <tr style="background-color:rgb(248,250,252);box-shadow:inset 3px 0 0 rgba(148,163,184,0.55);"
                                                    class="@(row.Included ? "" : "opacity-40")">
                                                    <td class="border-t border-slate-200/60 px-2 py-1.5"></td>
                                                    <td class="border-t border-slate-200/60 px-2 py-1.5 align-middle">
                                                        <div class="flex min-w-0 items-start gap-2 pl-4">
                                                            <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-slate-400"></span>
                                                            <span class="truncate text-[11px] text-slate-700">@p.Name</span>
                                                        </div>
                                                    </td>
                                                    <td class="border-t border-slate-200/60 px-2 py-1.5"><span class="text-[11px] text-slate-400">Param</span></td>
                                                    <td class="border-t border-slate-200/60 px-2 py-1.5"><span class="text-[11px] text-slate-600">@(string.IsNullOrWhiteSpace(p.Unit) ? "—" : p.Unit)</span></td>
                                                    <td class="border-t border-slate-200/60 px-2 py-1.5 text-center align-middle">
                                                        <input type="checkbox" checked="@p.IsActive"
                                                               @onchange="e => { p.IsActive = (bool)(e.Value ?? true); row.RecomputeChangeFactor1(); }"
                                                               disabled="@(!row.Included)" class="h-3.5 w-3.5 cursor-pointer accent-blue-600" />
                                                    </td>
                                                    <td class="border-t border-slate-200/60 px-2 py-1.5"></td>
                                                    <td class="border-t border-slate-200/60 px-2 py-1.5"></td>
                                                    <td class="border-t border-slate-200/60 px-2 py-1.5 text-right align-middle">
                                                        <input type="number" step="0.0001"
                                                               value="@p.Value.ToString("0.####", CultureInfo.InvariantCulture)"
                                                               @onchange="e => { if (decimal.TryParse(e.Value?.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var v)) { p.Value = v; row.RecomputeChangeFactor1(); } }"
                                                               disabled="@(!row.Included)" class="@SmallNumInputCls" />
                                                    </td>
                                                    <td class="border-t border-slate-200/60 px-2 py-1.5"></td>
                                                    <td class="border-t border-slate-200/60 px-2 py-1.5"></td>
                                                    <td class="border-t border-slate-200/60 px-2 py-1.5"></td>
                                                </tr>
                                            }

                                            @foreach (var a in row.Resource.Data.AddOns)
                                            {
                                                <tr style="background-color:rgb(239,246,255);box-shadow:inset 3px 0 0 rgba(59,130,246,0.55);"
                                                    class="@(row.Included ? "" : "opacity-40")">
                                                    <td class="border-t border-slate-200/60 px-2 py-1.5"></td>
