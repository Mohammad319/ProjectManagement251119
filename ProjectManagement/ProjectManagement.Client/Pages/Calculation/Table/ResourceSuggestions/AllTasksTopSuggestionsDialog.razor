@using ProjectManagement.Client.Shared.MVVM.Calculation
@using ProjectManagement.Client.Shared.ResourceFiles.Calculation
@using ProjectManagement.Shared.DTO.Calculation
@using ProjectManagement.Shared.Base.Calculation
@using ProjectManagement.Shared.Helper.ProjectAppStorage
@using System.Globalization
@inherits AppComponentBase

<div class="flex flex-col gap-3 min-h-0">

    <!-- ── Toolbar ── -->
    <div class="flex flex-wrap items-center gap-4 rounded border border-gray-200 bg-gray-50 px-4 py-2 dark:border-gray-700 dark:bg-gray-900">

        <label class="flex cursor-pointer items-center gap-2 text-sm font-medium text-gray-700 dark:text-gray-300">
            <input type="checkbox" checked="@_showSystem"
                   @onchange="e => _showSystem = (bool)(e.Value ?? false)"
                   class="h-4 w-4 cursor-pointer accent-blue-600" />
            <span class="rounded bg-blue-100 px-1.5 py-0.5 text-xs font-semibold text-blue-700 dark:bg-blue-950 dark:text-blue-300">BlueprintTask</span>
            <span>@CalcResource.resourceTypeSystem</span>
        </label>

        <label class="flex cursor-pointer items-center gap-2 text-sm font-medium text-gray-700 dark:text-gray-300">
            <input type="checkbox" checked="@_showTenant"
                   @onchange="e => _showTenant = (bool)(e.Value ?? false)"
                   class="h-4 w-4 cursor-pointer accent-emerald-600" />
            <span class="rounded bg-emerald-100 px-1.5 py-0.5 text-xs font-semibold text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300">TenantTask</span>
            <span>@CalcResource.resourceType</span>
        </label>

        <div class="flex-1"></div>

        <button class="inline-flex h-8 items-center rounded border border-gray-300 bg-white px-3 text-sm font-medium text-gray-700 hover:border-blue-500 hover:text-blue-600 disabled:cursor-not-allowed disabled:opacity-50 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-200"
                disabled="@(_loading || _saving)" @onclick="LoadAsync">
            @AppLoc["update"]
        </button>

        <button class="inline-flex h-8 items-center rounded border border-emerald-600 bg-emerald-600 px-3 text-sm font-medium text-white hover:bg-emerald-700 disabled:cursor-not-allowed disabled:opacity-50 dark:border-emerald-500 dark:bg-emerald-500"
                disabled="@(_loading || _saving || !_hasLoaded || !HasAnySelected)"
                @onclick="SaveAllAsync">
            @ResourceApp.save
        </button>

    </div>

    <!-- ── States ── -->
    @if (_loading)
    {
        <div class="py-12"><BlazorMHD.UI.Components.Feedback.Loading.MhdLoading /></div>
    }
    else if (!_hasLoaded)
    {
        <div class="rounded border border-dashed border-gray-300 px-3 py-10 text-center text-sm text-gray-400 dark:border-gray-700 dark:text-gray-500">
            @AppLoc["update"]
        </div>
    }
    else if (VisibleEntries.Count == 0)
    {
        <div class="rounded border border-dashed border-gray-300 px-3 py-10 text-center text-sm text-gray-500 dark:border-gray-700 dark:text-gray-400">
            @CalcResource.suggestionNoResults
        </div>
    }
    else
    {
        <div class="flex flex-col gap-2 overflow-y-auto">
            @foreach (var entry in VisibleEntries)
            {
                var selIdx   = entry.SelectedIndex;
                var selSug   = selIdx.HasValue ? entry.Suggestions[selIdx.Value] : null;
                var isLoad   = selIdx.HasValue && entry.LoadingSet.Contains(selIdx.Value);
                var selRows  = selIdx.HasValue ? entry.GetRows(selIdx.Value) : null;

                <div class="overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm dark:border-gray-700 dark:bg-gray-900">

                    <!-- ── Task row ── -->
                    <div class="flex min-w-0 items-center gap-2 px-3 py-2.5">

                        <!-- original task identity -->
                        @if (!string.IsNullOrWhiteSpace(entry.Task.Code))
                        {
                            <span class="shrink-0 rounded bg-gray-200 px-1.5 py-0.5 font-mono text-xs font-semibold text-gray-700 dark:bg-gray-700 dark:text-gray-200">@entry.Task.Code</span>
                        }
                        <span class="w-44 shrink-0 truncate text-sm font-semibold text-gray-800 dark:text-gray-100" title="@entry.Task.Name">@entry.Task.Name</span>
                        @if (!string.IsNullOrWhiteSpace(entry.Task.Unit))
                        {
                            <span class="shrink-0 rounded bg-gray-100 px-1.5 py-0.5 text-xs text-gray-500 ring-1 ring-gray-300 dark:bg-gray-800 dark:text-gray-400 dark:ring-gray-600">@entry.Task.Unit</span>
                        }
                        @if (entry.Task.Quantity is > 0)
                        {
                            <span class="shrink-0 rounded bg-gray-100 px-1.5 py-0.5 text-xs font-medium text-gray-600 ring-1 ring-gray-300 dark:bg-gray-800 dark:text-gray-300 dark:ring-gray-600">@entry.Task.Quantity?.ToString("0.###", CultureInfo.InvariantCulture)</span>
                        }

                        <!-- divider -->
                        <div class="mx-1 h-4 w-px shrink-0 bg-gray-200 dark:bg-gray-700"></div>

                        <!-- score bar for selected suggestion -->
                        @if (selSug is not null)
                        {
                            <div class="flex shrink-0 items-center gap-1">
                                <div class="h-1.5 w-12 overflow-hidden rounded-full bg-gray-200 dark:bg-gray-700">
                                    <div class="h-full rounded-full @GetScoreColorClass(selSug.Score)"
                                         style="width:@((selSug.Score * 100).ToString("0", CultureInfo.InvariantCulture))%"></div>
                                </div>
                                <span class="w-8 shrink-0 text-right text-xs font-semibold @GetScoreTextClass(selSug.Score)">@selSug.Score.ToString("0%", CultureInfo.InvariantCulture)</span>
                            </div>
                            <span class="shrink-0 rounded px-1.5 py-0.5 text-[10px] font-semibold @GetSourceBadgeClass(selSug.Source)">@selSug.Source</span>
                        }

                        <!-- suggestions dropdown -->
                        <select class="min-w-0 flex-1 rounded border border-gray-300 bg-white px-2 py-1 text-xs text-gray-700 focus:border-blue-400 focus:outline-none dark:border-gray-600 dark:bg-gray-800 dark:text-gray-200"
                                @onchange="async e => { if (int.TryParse(e.Value?.ToString(), out var idx)) await SelectSuggestionAsync(entry, idx); }">
                            @for (var i = 0; i < entry.Suggestions.Count; i++)
                            {
                                var optIdx = i;
                                var sug    = entry.Suggestions[optIdx];
                                <option value="@optIdx" selected="@(selIdx == optIdx)">@BuildOptionText(optIdx, sug)</option>
                            }
                        </select>

                        <!-- toggle resources -->
                        @if (isLoad)
                        {
                            <span class="shrink-0 px-1 text-xs text-gray-400 dark:text-gray-500">…</span>
                        }
                        else
                        {
                            <button class="flex h-7 w-7 shrink-0 items-center justify-center rounded border border-gray-300 text-gray-500 transition hover:border-blue-400 hover:text-blue-600 dark:border-gray-600 dark:text-gray-400 @(entry.ResourcesExpanded ? "border-blue-400 bg-blue-50 text-blue-600 dark:bg-blue-950/30" : "")"
                                    title="@(entry.ResourcesExpanded ? "Hide resources" : "Show resources")"
                                    @onclick="() => ToggleExpandAsync(entry)">
                                <span class="text-[10px] font-bold leading-none">@(entry.ResourcesExpanded ? "▼" : "▶")</span>
                            </button>
                        }

                    </div>

                    <!-- ── Resources panel ── -->
                    @if (entry.ResourcesExpanded)
                    {
                        @if (isLoad)
                        {
                            <div class="border-t border-gray-100 px-4 py-3 dark:border-gray-800">
                                <BlazorMHD.UI.Components.Feedback.Loading.MhdLoading />
                            </div>
                        }
                        else if (selRows is { Count: 0 })
                        {
                            <div class="border-t border-gray-100 px-4 py-2 text-xs text-gray-400 dark:border-gray-800 dark:text-gray-500">@CalcResource.suggestionNoResults</div>
                        }
                        else if (selRows is not null)
                        {
                            var convRule   = selSug is not null ? GetConversionRule(entry.Task.Unit, selSug.SourceTaskUnit) : null;
                            var userParams = convRule?.Params.Where(p => p.Source == ParamSource.User).ToList() ?? [];
                            var hasResPrm  = convRule?.Params.Any(p => p.Source == ParamSource.Resource) ?? false;
                            var canCompute = convRule == null || (!hasResPrm && userParams.All(p => entry.ConversionParams.ContainsKey(p.Key)));
                            var convQty    = selSug is not null ? GetConvertedQty(entry, selSug.SourceTaskUnit) : (entry.Task.Quantity ?? 0m);

                            <!-- ── Unit conversion panel ── -->
                            @if (convRule is not null)
                            {
                                <div class="border-b border-amber-200 bg-amber-50 px-3 py-2 dark:border-amber-900/40 dark:bg-amber-950/20">
                                    <div class="flex flex-wrap items-center gap-3">

                                        <span class="shrink-0 text-xs font-semibold text-amber-700 dark:text-amber-400">
                                            ⚠ @UnitRulesCatalog.BuildKey(entry.Task.Unit) → @UnitRulesCatalog.BuildKey(selSug!.SourceTaskUnit)
                                        </span>

                                        <span class="shrink-0 rounded bg-amber-100 px-2 py-0.5 font-mono text-[11px] font-semibold text-amber-800 ring-1 ring-amber-200 dark:bg-amber-950/40 dark:text-amber-300 dark:ring-amber-800">
                                            @BuildFormulaText(entry.Task.Quantity ?? 0m, entry.Task.Unit, convRule)
                                        </span>

                                        @foreach (var param in userParams)
                                        {
                                            var p = param;
                                            <div class="flex items-center gap-1">
                                                <label class="shrink-0 text-xs text-amber-700 dark:text-amber-400">@GetParamLabel(p.Key)</label>
                                                <input type="number" step="0.001" placeholder="0"
                                                       value="@(entry.ConversionParams.TryGetValue(p.Key, out var pv) ? pv.ToString("0.###", CultureInfo.InvariantCulture) : "")"
                                                       @onchange="e => OnConvParamChanged(entry, p.Key, e.Value?.ToString(), selSug!.SourceTaskUnit)"
                                                       class="w-20 rounded border border-amber-300 bg-white px-1.5 py-0.5 text-xs text-gray-900 focus:border-amber-500 focus:outline-none dark:border-amber-700 dark:bg-gray-800 dark:text-gray-100" />
                                            </div>
                                        }

                                        @if (canCompute && convQty != (entry.Task.Quantity ?? 0m))
                                        {
                                            <span class="rounded bg-amber-200 px-2 py-0.5 text-xs font-bold text-amber-900 dark:bg-amber-900/50 dark:text-amber-200">
                                                = @convQty.ToString("0.###", CultureInfo.InvariantCulture) @UnitRulesCatalog.BuildKey(selSug!.SourceTaskUnit)
                                            </span>
                                        }

                                        @if (hasResPrm)
                                        {
                                            <span class="text-[11px] italic text-amber-600 dark:text-amber-500">* density comes from resource</span>
                                        }

                                    </div>
                                </div>
                            }
                            <div class="overflow-x-auto border-t border-gray-100 dark:border-gray-800">
                                <table class="w-full text-sm">
                                    <thead class="border-b border-slate-200 bg-slate-50 text-xs dark:border-slate-800 dark:bg-slate-950">
                                        <tr>
                                            <th class="w-10 px-2 py-1.5"></th>
                                            <th class="min-w-[10rem] px-2 py-1.5 text-left font-medium text-slate-500 dark:text-slate-400">@CalcResource.name</th>
                                            <th class="px-2 py-1.5 text-left font-medium text-slate-500 dark:text-slate-400">@CalcResource.type</th>
                                            <th class="px-2 py-1.5 text-left font-medium text-slate-500 dark:text-slate-400">@CalcResource.unit</th>
                                            <th class="w-16 px-2 py-1.5 text-center font-medium text-slate-500 dark:text-slate-400">@CalcResource.active</th>
                                            <th class="w-24 px-2 py-1.5 text-right font-medium text-slate-500 dark:text-slate-400">@CalcResource.cost</th>
                                            <th class="w-24 px-2 py-1.5 text-right font-medium text-slate-500 dark:text-slate-400">@CalcResource.baseCost</th>
                                            <th class="w-24 px-2 py-1.5 text-right font-medium text-slate-500 dark:text-slate-400">@CalcResource.changeFactor1</th>
                                            <th class="w-20 px-2 py-1.5 text-center font-medium text-slate-500 dark:text-slate-400">CapTask</th>
                                            <th class="w-24 px-2 py-1.5 text-right font-medium text-slate-500 dark:text-slate-400">@CalcResource.co2</th>
                                            <th class="w-24 px-2 py-1.5 text-right font-medium text-slate-500 dark:text-slate-400">@CalcResource.cap</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in selRows)
                                        {
                                            <tr style="@GetResourceRowStyle()" class="border-b border-slate-100 transition-opacity dark:border-slate-800 @(row.Included ? "" : "opacity-40")">
                                                <td class="px-2 py-1.5 text-center align-middle">
                                                    <button class="flex h-6 w-6 items-center justify-center rounded border text-sm font-bold leading-none transition
                                                                   @(row.Included
                                                                       ? "border-red-300 text-red-500 hover:bg-red-50 dark:border-red-700 dark:text-red-400"
                                                                       : "border-emerald-400 text-emerald-600 hover:bg-emerald-50 dark:border-emerald-600 dark:text-emerald-400")"
                                                            @onclick="() => row.Included = !row.Included">
                                                        @(row.Included ? "−" : "+")
                                                    </button>
                                                </td>
                                                <td class="px-2 py-1.5 align-middle">
                                                    <input type="text" value="@row.Name"
                                                           @onchange="e => row.Name = e.Value?.ToString() ?? row.Name"
                                                           disabled="@(!row.Included)" class="@InputCls" />
                                                </td>
                                                <td class="px-2 py-1.5 align-middle text-slate-500 dark:text-slate-400">@row.Resource.ResType</td>
                                                <td class="px-2 py-1.5 align-middle text-slate-500 dark:text-slate-400">@(string.IsNullOrWhiteSpace(row.Resource.Unit) ? "—" : row.Resource.Unit)</td>
                                                <td class="px-2 py-1.5 text-center align-middle">
                                                    <input type="checkbox" checked="@row.IsActive"
                                                           @onchange="e => row.IsActive = (bool)(e.Value ?? true)"
                                                           disabled="@(!row.Included)" class="h-4 w-4 cursor-pointer accent-blue-600" />
                                                </td>
                                                <td class="px-2 py-1.5 align-middle">
                                                    <input type="number" step="0.01"
                                                           value="@row.Cost.ToString("0.##", CultureInfo.InvariantCulture)"
                                                           @onchange="e => { if (decimal.TryParse(e.Value?.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var v)) row.Cost = v; }"
                                                           disabled="@(!row.Included)" class="@NumInputCls" />
                                                </td>
                                                <td class="px-2 py-1.5 align-middle">
                                                    <input type="number" step="0.01"
                                                           value="@(row.BaseCost?.ToString("0.##", CultureInfo.InvariantCulture) ?? "")"
                                                           @onchange="e => { if (decimal.TryParse(e.Value?.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var v)) row.BaseCost = v; else row.BaseCost = null; }"
                                                           disabled="@(!row.Included)" class="@NumInputCls" />
                                                </td>
                                                <td class="px-2 py-1.5 text-right align-middle">
                                                    @if (row.HasParameters)
                                                    {
                                                        <span class="rounded bg-blue-50 px-1.5 py-0.5 text-xs font-semibold text-blue-700 dark:bg-blue-950 dark:text-blue-300">
                                                            @row.ChangeFactor1.ToString("0.####", CultureInfo.InvariantCulture)
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <input type="number" step="0.0001"
                                                               value="@row.ChangeFactor1.ToString("0.####", CultureInfo.InvariantCulture)"
                                                               @onchange="e => { if (decimal.TryParse(e.Value?.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var v)) row.ChangeFactor1 = v; }"
                                                               disabled="@(!row.Included)" class="@NumInputCls" />
                                                    }
                                                </td>
                                                <td class="px-2 py-1.5 text-center align-middle">
                                                    <input type="checkbox" checked="@row.CapFromTask"
                                                           @onchange="e => row.CapFromTask = (bool)(e.Value ?? false)"
                                                           disabled="@(!row.Included)" class="h-4 w-4 cursor-pointer accent-emerald-600" />
                                                </td>
                                                <td class="px-2 py-1.5 align-middle">
                                                    <input type="number" step="0.01"
                                                           value="@(row.CO2?.ToString("0.##", CultureInfo.InvariantCulture) ?? "")"
                                                           @onchange="e => { if (double.TryParse(e.Value?.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var v)) row.CO2 = v; else row.CO2 = null; }"
                                                           disabled="@(!row.Included)" class="@NumInputCls" />
                                                </td>
                                                <td class="px-2 py-1.5 align-middle">
                                                    <input type="number" step="0.0001"
                                                           value="@row.CapWaste.ToString("0.####", CultureInfo.InvariantCulture)"
                                                           @onchange="e => { if (decimal.TryParse(e.Value?.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var v)) row.CapWaste = v; }"
                                                           disabled="@(!row.Included)" class="@NumInputCls" />
                                                </td>
                                            </tr>

                                            @foreach (var p in row.Resource.Data.Parameters)
                                            {
                                                <tr style="background-color:rgb(248,250,252);box-shadow:inset 3px 0 0 rgba(148,163,184,0.55);"
                                                    class="@(row.Included ? "" : "opacity-40")">
                                                    <td class="border-t border-slate-200/60 px-2 py-1.5"></td>
                                                    <td class="border-t border-slate-200/60 px-2 py-1.5 align-middle">
                                                        <div class="flex min-w-0 items-start gap-2 pl-4">
                                                            <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-slate-400"></span>
                                                            <span class="truncate text-[11px] text-slate-700">@p.Name</span>
                                                        </div>
                                                    </td>
                                                    <td class="border-t border-slate-200/60 px-2 py-1.5"><span class="text-[11px] text-slate-400">Param</span></td>
                                                    <td class="border-t border-slate-200/60 px-2 py-1.5"><span class="text-[11px] text-slate-600">@(string.IsNullOrWhiteSpace(p.Unit) ? "—" : p.Unit)</span></td>
                                                    <td class="border-t border-slate-200/60 px-2 py-1.5 text-center align-middle">
                                                        <input type="checkbox" checked="@p.IsActive"
                                                               @onchange="e => { p.IsActive = (bool)(e.Value ?? true); row.RecomputeChangeFactor1(); }"
                                                               disabled="@(!row.Included)" class="h-3.5 w-3.5 cursor-pointer accent-blue-600" />
                                                    </td>
                                                    <td class="border-t border-slate-200/60 px-2 py-1.5"></td>
                                                    <td class="border-t border-slate-200/60 px-2 py-1.5"></td>
                                                    <td class="border-t border-slate-200/60 px-2 py-1.5 text-right align-middle">
                                                        <input type="number" step="0.0001"
                                                               value="@p.Value.ToString("0.####", CultureInfo.InvariantCulture)"
                                                               @onchange="e => { if (decimal.TryParse(e.Value?.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var v)) { p.Value = v; row.RecomputeChangeFactor1(); } }"
                                                               disabled="@(!row.Included)" class="@SmallNumInputCls" />
                                                    </td>
                                                    <td class="border-t border-slate-200/60 px-2 py-1.5"></td>
                                                    <td class="border-t border-slate-200/60 px-2 py-1.5"></td>
                                                    <td class="border-t border-slate-200/60 px-2 py-1.5"></td>
                                                </tr>
                                            }

                                            @foreach (var a in row.Resource.Data.AddOns)
                                            {
                                                <tr style="background-color:rgb(239,246,255);box-shadow:inset 3px 0 0 rgba(59,130,246,0.55);"
                                                    class="@(row.Included ? "" : "opacity-40")">
                                                    <td class="border-t border-slate-200/60 px-2 py-1.5"></td>
                                                    <td class="border-t border-slate-200/60 px-2 py-1.5 align-middle">
                                                        <div class="flex min-w-0 items-start gap-2 pl-4">
                                                            <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-blue-500"></span>
                                                            <span class="truncate text-[11px] text-slate-700">@a.Name</span>
                                                        </div>
                                                    </td>
                                                    <td class="border-t border-slate-200/60 px-2 py-1.5"><span class="text-[11px] text-slate-400">@a.Type</span></td>
                                                    <td class="border-t border-slate-200/60 px-2 py-1.5"><span class="text-[11px] text-slate-600">@(string.IsNullOrWhiteSpace(a.Unit) ? "—" : a.Unit)</span></td>
                                                    <td class="border-t border-slate-200/60 px-2 py-1.5 text-center align-middle">
                                                        <input type="checkbox" checked="@a.IsActive"
                                                               @onchange="e => a.IsActive = (bool)(e.Value ?? true)"
                                                               disabled="@(!row.Included)" class="h-3.5 w-3.5 cursor-pointer accent-blue-600" />
                                                    </td>
                                                    <td class="border-t border-slate-200/60 px-2 py-1.5 align-middle">
                                                        <input type="number" step="0.01" value="@a.Cost.ToString("0.##", CultureInfo.InvariantCulture)"
                                                               @onchange="e => { if (decimal.TryParse(e.Value?.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var v)) a.Cost = v; }"
                                                               disabled="@(!row.Included)" class="@SmallNumInputCls" />
                                                    </td>
                                                    <td class="border-t border-slate-200/60 px-2 py-1.5 align-middle">
                                                        <input type="number" step="0.01" value="@a.BaseCost.ToString("0.##", CultureInfo.InvariantCulture)"
                                                               @onchange="e => { if (decimal.TryParse(e.Value?.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var v)) a.BaseCost = v; }"
                                                               disabled="@(!row.Included)" class="@SmallNumInputCls" />
                                                    </td>
                                                    <td class="border-t border-slate-200/60 px-2 py-1.5 text-right align-middle">
                                                        <span class="text-[11px] font-medium text-slate-700">@a.Factor.ToString("0.####", CultureInfo.InvariantCulture)</span>
                                                    </td>
                                                    <td class="border-t border-slate-200/60 px-2 py-1.5"></td>
                                                    <td class="border-t border-slate-200/60 px-2 py-1.5"></td>
                                                    <td class="border-t border-slate-200/60 px-2 py-1.5"></td>
                                                </tr>
                                            }

                                            @foreach (var t in row.Resource.Data.Times)
                                            {
                                                <tr style="background-color:rgb(241,245,249);box-shadow:inset 3px 0 0 rgba(100,116,139,0.55);"
                                                    class="@(row.Included ? "" : "opacity-40")">
                                                    <td class="border-t border-slate-200/60 px-2 py-1.5"></td>
                                                    <td class="border-t border-slate-200/60 px-2 py-1.5 align-middle">
                                                        <div class="flex min-w-0 items-start gap-2 pl-4">
                                                            <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-slate-500"></span>
                                                            <span class="truncate text-[11px] text-slate-700">@t.Name</span>
                                                        </div>
                                                    </td>
                                                    <td class="border-t border-slate-200/60 px-2 py-1.5"><span class="text-[11px] text-slate-400">Time</span></td>
                                                    <td class="border-t border-slate-200/60 px-2 py-1.5"><span class="text-[11px] text-slate-600">@(string.IsNullOrWhiteSpace(t.Unit) ? "—" : t.Unit)</span></td>
                                                    <td class="border-t border-slate-200/60 px-2 py-1.5 text-center align-middle">
                                                        <input type="checkbox" checked="@t.IsActive"
                                                               @onchange="e => t.IsActive = (bool)(e.Value ?? true)"
                                                               disabled="@(!row.Included)" class="h-3.5 w-3.5 cursor-pointer accent-blue-600" />
                                                    </td>
                                                    <td class="border-t border-slate-200/60 px-2 py-1.5 align-middle">
                                                        <input type="number" step="0.01" value="@t.Cost.ToString("0.##", CultureInfo.InvariantCulture)"
                                                               @onchange="e => { if (decimal.TryParse(e.Value?.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var v)) t.Cost = v; }"
                                                               disabled="@(!row.Included)" class="@SmallNumInputCls" />
                                                    </td>
                                                    <td class="border-t border-slate-200/60 px-2 py-1.5"></td>
                                                    <td class="border-t border-slate-200/60 px-2 py-1.5 text-right align-middle">
                                                        <input type="number" step="0.01"
                                                               value="@(t.Percentage?.ToString("0.##", CultureInfo.InvariantCulture) ?? "")"
                                                               @onchange="e => { if (decimal.TryParse(e.Value?.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var v)) t.Percentage = v; else t.Percentage = null; }"
                                                               disabled="@(!row.Included)" class="@SmallNumInputCls" />
                                                    </td>
                                                    <td class="border-t border-slate-200/60 px-2 py-1.5"></td>
                                                    <td class="border-t border-slate-200/60 px-2 py-1.5"></td>
                                                    <td class="border-t border-slate-200/60 px-2 py-1.5 text-right align-middle">
                                                        <span class="text-[11px] font-medium text-slate-700">@t.Quantity.ToString("0.###", CultureInfo.InvariantCulture)</span>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else if (selIdx.HasValue)
                        {
                            <div class="border-t border-gray-100 px-4 py-3 dark:border-gray-800">
                                <BlazorMHD.UI.Components.Feedback.Loading.MhdLoading />
                            </div>
                        }
                    }

                </div>
            }
        </div>
    }

</div>

@code {
    [Parameter, EditorRequired] public CalculationMVVM CalcModel { get; set; } = default!;
    [Parameter] public IReadOnlyList<TaskListMVVM>? Tasks { get; set; }

    private bool _showSystem = true;
    private bool _showTenant = true;
    private bool _loading;
    private bool _saving;
    private bool _hasLoaded;
    private List<TaskEntry> _entries = [];

    private const string InputCls         = "w-full min-w-[8rem] rounded border border-gray-200 bg-transparent px-1.5 py-0.5 text-gray-900 focus:border-blue-400 focus:outline-none disabled:cursor-default dark:border-gray-700 dark:text-gray-100";
    private const string NumInputCls      = "w-full rounded border border-gray-200 bg-transparent px-1.5 py-0.5 text-right text-gray-900 focus:border-blue-400 focus:outline-none disabled:cursor-default dark:border-gray-700 dark:text-gray-100";
    private const string SmallNumInputCls = "w-20 rounded border border-slate-200 bg-white px-1 py-0.5 text-right text-[11px] text-slate-800 focus:border-blue-400 focus:outline-none disabled:cursor-default dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200";

    private List<TaskEntry> VisibleEntries => _entries.Where(e => e.Suggestions.Count > 0).ToList();
    private bool HasAnySelected => _entries.Any(e => e.SelectedIndex.HasValue);

    private static string GetResourceRowStyle() => "box-shadow: inset 3px 0 0 rgba(34,197,94,0.35);";

    private static UnitRule? GetConversionRule(string taskUnit, string sourceUnit)
    {
        var from = UnitRulesCatalog.BuildKey(taskUnit);
        var to   = UnitRulesCatalog.BuildKey(sourceUnit);
        if (string.IsNullOrWhiteSpace(from) || string.IsNullOrWhiteSpace(to)) return null;
        if (string.Equals(from, to, StringComparison.OrdinalIgnoreCase)) return null;
        return UnitRulesCatalog.TryGet(from, to, out var rule) ? rule : null;
    }

    private static decimal GetConvertedQty(TaskEntry entry, string sourceUnit)
    {
        var raw  = entry.Task.Quantity ?? 0m;
        var rule = GetConversionRule(entry.Task.Unit, sourceUnit);
        if (rule == null) return raw;
        if (rule.Params.Any(p => p.Source == ParamSource.Resource)) return raw;

        var d = new Dictionary<ParamName, decimal>();
        foreach (var p in rule.Params.Where(x => x.Source == ParamSource.User))
        {
            if (!entry.ConversionParams.TryGetValue(p.Key, out var v)) return raw;
            d[p.Key] = v;
        }
        try   { return rule.Compute(raw, d); }
        catch { return raw; }
    }

    private void OnConvParamChanged(TaskEntry entry, ParamName key, string? rawValue, string sourceUnit)
    {
        if (decimal.TryParse(rawValue, NumberStyles.Any, CultureInfo.InvariantCulture, out var v))
            entry.ConversionParams[key] = v;
        else
            entry.ConversionParams.Remove(key);

        if (entry.SelectedIndex.HasValue)
        {
            var rows = entry.GetRows(entry.SelectedIndex.Value);
            if (rows is not null)
            {
                var convQty = GetConvertedQty(entry, sourceUnit);
                foreach (var row in rows)
                    row.ApplyCostRole(convQty);
            }
        }
        StateHasChanged();
    }

    private static string GetParamLabel(ParamName p) => p switch
    {
        ParamName.Thickness => "Depth/Thickness (m)",
        ParamName.Width     => "Width (m)",
        ParamName.Length    => "Length (m)",
        ParamName.Density   => "Density (t/m³)",
        _                   => p.ToString()
    };

    private static string BuildFormulaText(decimal taskQuantity, string taskUnit, UnitRule rule)
    {
        var parts = new List<string>
        {
            $"{taskQuantity.ToString("0.###", CultureInfo.InvariantCulture)} {UnitRulesCatalog.BuildKey(taskUnit)}"
        };

        parts.AddRange(rule.Params.Select(p => p.Key switch
        {
            ParamName.Thickness => "Depth",
            ParamName.Width     => "Width",
            ParamName.Length    => "Length",
            ParamName.Density   => "Density",
            _                   => p.Key.ToString()
        }));

        return string.Join(" x ", parts);
    }

    protected override Task OnInitializedAsync() => Task.CompletedTask;

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();

        var leafTasks = GetLeafTasksInOrder();

        var entries = await System.Threading.Tasks.Task.WhenAll(leafTasks.Select(async task =>
        {
            var all = await Repo.Resource.GetSuggestionsAsync(task.Id, 10, includeResources: false);
            var filtered = all
                .Where(s =>
                    (_showSystem && s.Source == TaskResourceSuggestionSource.BlueprintTask) ||
                    (_showTenant && s.Source == TaskResourceSuggestionSource.TenantTask))
                .OrderByDescending(s => s.Score)
                .Take(10)
                .ToList();
            var entry = new TaskEntry(task, filtered);
            if (entry.Suggestions.Count > 0)
                entry.SelectedIndex = 0;
            return entry;
        }));

        _entries = entries.ToList();
        _hasLoaded = true;
        _loading = false;
    }

    private async Task EnsureResourcesLoadedAsync(TaskEntry entry, int index)
    {
        if (entry.ResourceCache.ContainsKey(index) || entry.LoadingSet.Contains(index))
            return;

        entry.LoadingSet.Add(index);
        StateHasChanged();

        var sug = entry.Suggestions[index];
        var resources = await Repo.Resource.GetSuggestionResourcesAsync(sug.SourceTaskId, sug.Source);
        var rows = resources.Select(r => new ResourceRow(r)).ToList();
        var convertedQty = GetConvertedQty(entry, sug.SourceTaskUnit);
        foreach (var row in rows) row.ApplyCostRole(convertedQty);
        entry.ResourceCache[index] = rows;
        entry.LoadingSet.Remove(index);
        StateHasChanged();
    }

    private async Task SelectSuggestionAsync(TaskEntry entry, int index)
    {
        entry.SelectedIndex = index;
        if (entry.ResourcesExpanded)
            await EnsureResourcesLoadedAsync(entry, index);
        StateHasChanged();
    }

    private async Task ToggleExpandAsync(TaskEntry entry)
    {
        entry.ResourcesExpanded = !entry.ResourcesExpanded;
        if (entry.ResourcesExpanded && entry.SelectedIndex.HasValue)
            await EnsureResourcesLoadedAsync(entry, entry.SelectedIndex.Value);
        StateHasChanged();
    }

    private async Task SaveAllAsync()
    {
        _saving = true;
        StateHasChanged();

        foreach (var entry in _entries)
        {
            if (!entry.SelectedIndex.HasValue)
                continue;

            await EnsureResourcesLoadedAsync(entry, entry.SelectedIndex.Value);

            var toSave = (entry.GetRows(entry.SelectedIndex.Value) ?? [])
                .Where(r => r.Included)
                .Select(r =>
                {
                    r.Resource.Name               = r.Name;
                    r.Resource.IsActive           = r.IsActive;
                    r.Resource.Cost               = r.Cost;
                    r.Resource.BaseCost           = r.BaseCost;
                    r.Resource.Data.ChangeFactor1 = r.ChangeFactor1;
                    r.Resource.Data.CapFromTask   = r.CapFromTask;
                    r.Resource.Data.CO2           = r.CO2;
                    r.Resource.Data.CapWaste      = r.CapWaste;
                    return r.Resource;
                })
                .ToList();

            if (toSave.Count > 0)
                await Repo.Resource.CreateAsync(toSave, entry.Task.Id);
        }

        MHD.Notifications(ToastType.Add, true);
        _saving = false;
        Modal.Close();
    }

    private List<TaskListMVVM> GetLeafTasksInOrder()
    {
        if (Tasks is { Count: > 0 })
            return Tasks
                .Where(task => task.Type != TaskType.CodeName && task.Tasks.Count == 0)
                .DistinctBy(task => task.Id)
                .OrderBy(task => task.SortOrder)
                .ToList();

        var result = new List<TaskListMVVM>();
        foreach (var root in CalcModel.RootTasks)
            CollectLeaves(root, result);
        return result;
    }

    private static void CollectLeaves(TaskListMVVM task, List<TaskListMVVM> result)
    {
        if (task.Tasks.Count == 0)
        {
            if (task.Type != TaskType.CodeName)
                result.Add(task);
            return;
        }
        foreach (var child in task.Tasks.OrderBy(t => t.SortOrder))
            CollectLeaves(child, result);
    }

    private static string BuildOptionText(int idx, TaskResourceSuggestionDTO sug)
    {
        var sb = new System.Text.StringBuilder();
        sb.Append($"#{idx + 1}  {sug.Score.ToString("0%", CultureInfo.InvariantCulture)}");
        if (!string.IsNullOrWhiteSpace(sug.SourceTaskName))
            sb.Append($"  ·  {sug.SourceTaskName}");
        if (sug.SourceTaskQuantity is > 0)
            sb.Append($"  ·  {sug.SourceTaskQuantity.Value.ToString("0.###", CultureInfo.InvariantCulture)}");
        if (!string.IsNullOrWhiteSpace(sug.SourceTaskUnit))
            sb.Append($" {sug.SourceTaskUnit}");
        return sb.ToString();
    }

    private static string GetSourceBadgeClass(TaskResourceSuggestionSource source) => source switch
    {
        TaskResourceSuggestionSource.BlueprintTask => "bg-blue-100 text-blue-700 dark:bg-blue-950 dark:text-blue-300",
        TaskResourceSuggestionSource.TenantTask    => "bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300",
        _                                          => "bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-300"
    };

    private static string GetScoreColorClass(double score) => score switch
    {
        >= 0.80 => "bg-green-500",
        >= 0.55 => "bg-yellow-400",
        _       => "bg-red-400"
    };

    private static string GetScoreTextClass(double score) => score switch
    {
        >= 0.80 => "text-green-600 dark:text-green-400",
        >= 0.55 => "text-yellow-600 dark:text-yellow-400",
        _       => "text-red-500 dark:text-red-400"
    };

    // ── Models ───────────────────────────────────────────────────────────────

    private sealed class TaskEntry
    {
        public TaskListMVVM Task { get; }
        public List<TaskResourceSuggestionDTO> Suggestions { get; }
        public int?  SelectedIndex     { get; set; }
        public bool  ResourcesExpanded { get; set; }

        public Dictionary<ParamName, decimal>     ConversionParams { get; } = new();
        public Dictionary<int, List<ResourceRow>> ResourceCache    { get; } = [];
        public HashSet<int>                       LoadingSet       { get; } = [];

        public List<ResourceRow>? GetRows(int index) => ResourceCache.TryGetValue(index, out var r) ? r : null;

        public TaskEntry(TaskListMVVM task, IEnumerable<TaskResourceSuggestionDTO> suggestions)
        {
            Task        = task;
            Suggestions = suggestions.ToList();
        }
    }

    private sealed class ResourceRow
    {
        public ResourcePostDTO Resource  { get; }
        public bool    Included          { get; set; } = true;
        public string  Name              { get; set; }
        public bool    IsActive          { get; set; }
        public decimal Cost              { get; set; }
        public decimal? BaseCost         { get; set; }
        public decimal ChangeFactor1     { get; set; }
        public bool    CapFromTask       { get; set; }
        public double? CO2               { get; set; }
        public decimal CapWaste          { get; set; }

        public bool HasParameters => Resource.Data.Parameters.Count > 0;
        public bool HasAddOns     => Resource.Data.AddOns.Count > 0;
        public bool HasTimes      => Resource.Data.Times.Count > 0;

        public void ApplyCostRole(decimal convertedTaskQty)
        {
            if (Resource.CostRole is { Count: > 0 })
            {
                var role = Resource.CostRole.FirstOrDefault(r => r.Min <= convertedTaskQty && convertedTaskQty <= r.Max);
                if (role?.Value is not null) Cost = role.Value.Value;
            }
        }

        public ResourceRow(ResourcePostDTO resource)
        {
            Resource    = resource;
            Name        = resource.Name;
            IsActive    = resource.IsActive;
            Cost        = resource.Cost;
            BaseCost    = resource.BaseCost;
            CapFromTask = resource.Data.CapFromTask;
            CO2         = resource.Data.CO2;
            CapWaste    = resource.Data.CapWaste;
            RecomputeChangeFactor1();
        }

        public void RecomputeChangeFactor1()
        {
            if (!HasParameters) { ChangeFactor1 = Resource.Data.ChangeFactor1; return; }
            var product = 1m;
            foreach (var p in Resource.Data.Parameters.Where(p => p.IsActive))
                product = Math.Round(product * p.Value, 4, MidpointRounding.AwayFromZero);
            ChangeFactor1 = product;
        }
    }
}
