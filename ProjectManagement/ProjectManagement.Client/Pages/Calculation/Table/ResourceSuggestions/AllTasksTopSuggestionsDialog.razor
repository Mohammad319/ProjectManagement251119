</div>

@code {
    [Parameter, EditorRequired] public CalculationMVVM CalcModel { get; set; } = default!;
    [Parameter] public IReadOnlyList<TaskListMVVM>? Tasks { get; set; }

    private bool _showSystem = true;
    private bool _showTenant = true;
    private bool _loading;
    private bool _saving;
    private bool _hasLoaded;
    private List<TaskEntry> _entries = [];
    private string _taskFilter = string.Empty;
    private double _minScore = 0;

    private List<TaskEntry>? _visibleCache;
    private string _lastTaskFilter = "\0";
    private double _lastMinScore   = -1;
    private int _loadVersion;
    private string UiStateStorageKey => $"all-task-resource-suggestions-ui:{CalcModel.Id}";

    private const string InputCls         = "w-full min-w-[8rem] rounded border border-gray-200 bg-transparent px-1.5 py-0.5 text-gray-900 focus:border-blue-400 focus:outline-none disabled:cursor-default dark:border-gray-700 dark:text-gray-100";
    private const string NumInputCls      = "w-full rounded border border-gray-200 bg-transparent px-1.5 py-0.5 text-right text-gray-900 focus:border-blue-400 focus:outline-none disabled:cursor-default dark:border-gray-700 dark:text-gray-100";
    private const string SmallNumInputCls = "w-20 rounded border border-slate-200 bg-white px-1 py-0.5 text-right text-[11px] text-slate-800 focus:border-blue-400 focus:outline-none disabled:cursor-default dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200";

    private int _missingTasksCount;
    private string NoVisibleEntriesMessage => _entries.Count == 0
        ? "No eligible leaf tasks were found for resource suggestions."
        : BuildNoVisibleEntriesMessage();

    private List<TaskEntry> VisibleEntries
    {
        get
        {
            if (_visibleCache is null
                || _lastTaskFilter != _taskFilter
                || _lastMinScore   != _minScore)
            {
                _visibleCache   = ComputeVisibleEntries();
                _lastTaskFilter = _taskFilter;
                _lastMinScore   = _minScore;
            }
            return _visibleCache;
        }
    }

    private List<TaskEntry> ComputeVisibleEntries()
    {
        var entries = _entries.Where(e => e.Suggestions.Count > 0);

        if (_minScore > 0)
            entries = entries.Where(e => e.Suggestions[0].Score >= _minScore);

        if (!string.IsNullOrWhiteSpace(_taskFilter))
        {
            var q = _taskFilter.Trim();
            entries = entries.Where(e =>
                FuzzySearchHelper.Score(q, e.Task.Name) >= FuzzySearchHelper.Threshold ||
                (!string.IsNullOrWhiteSpace(e.Task.Code) && e.Task.Code.Contains(q, StringComparison.OrdinalIgnoreCase)));
        }
        return entries.ToList();
    }
    private bool HasAnySelected => _entries.Any(e => e.SelectedIndex.HasValue);

    private const string ResourceRowStyle = "box-shadow: inset 3px 0 0 rgba(34,197,94,0.35);";

    private static UnitRule? GetConversionRule(string taskUnit, string sourceUnit)
    {
        var from = UnitRulesCatalog.BuildKey(taskUnit);
        var to   = UnitRulesCatalog.BuildKey(sourceUnit);
        if (string.IsNullOrWhiteSpace(from) || string.IsNullOrWhiteSpace(to)) return null;
        if (string.Equals(from, to, StringComparison.OrdinalIgnoreCase)) return null;
        return UnitRulesCatalog.TryGet(from, to, out var rule) ? rule : null;
    }

    private static decimal GetConvertedQty(TaskEntry entry, string sourceUnit)
    {
        var raw  = entry.Task.Quantity ?? 0m;
        var rule = GetConversionRule(entry.Task.Unit, sourceUnit);
        if (rule == null) return raw;
        if (rule.Params.Any(p => p.Source == ParamSource.Resource)) return raw;

        var d = new Dictionary<ParamName, decimal>();
        foreach (var p in rule.Params.Where(x => x.Source == ParamSource.User))
        {
            if (!entry.ConversionParams.TryGetValue(p.Key, out var v)) return raw;
            d[p.Key] = v;
        }
        try   { return rule.Compute(raw, d); }
        catch { return raw; }
    }

    private void OnConvParamChanged(TaskEntry entry, ParamName key, string? rawValue, string sourceUnit)
    {
        if (decimal.TryParse(rawValue, NumberStyles.Any, CultureInfo.InvariantCulture, out var v))
            entry.ConversionParams[key] = v;
        else
            entry.ConversionParams.Remove(key);

        if (entry.SelectedIndex.HasValue)
        {
            var rows = entry.GetRows(entry.SelectedIndex.Value);
            if (rows is not null)
            {
                var convQty = GetConvertedQty(entry, sourceUnit);
                foreach (var row in rows)
                    row.ApplyCostRole(convQty);
            }
        }
        StateHasChanged();
    }

    private static string GetParamLabel(ParamName p) => p switch
    {
        ParamName.Thickness => "Depth/Thickness (m)",
        ParamName.Width     => "Width (m)",
        ParamName.Length    => "Length (m)",
        ParamName.Density   => "Density (t/m³)",
        _                   => p.ToString()
    };

    private static string BuildFormulaText(decimal taskQuantity, string taskUnit, UnitRule rule)
    {
        var parts = new List<string>
        {
            $"{taskQuantity.ToString("0.###", CultureInfo.InvariantCulture)} {UnitRulesCatalog.BuildKey(taskUnit)}"
        };

        parts.AddRange(rule.Params.Select(p => p.Key switch
        {
            ParamName.Thickness => "Depth",
            ParamName.Width     => "Width",
            ParamName.Length    => "Length",
            ParamName.Density   => "Density",
            _                   => p.Key.ToString()
        }));

        return string.Join(" x ", parts);
    }

    protected override async Task OnInitializedAsync()
        => await LoadUiStateAsync();

    private async Task OnTaskFilterChangedAsync(ChangeEventArgs e)
    {
        _taskFilter = e.Value?.ToString() ?? string.Empty;
        _visibleCache = null;
        await SaveUiStateAsync();
    }

    private async Task OnMinScoreChangedAsync(ChangeEventArgs e)
    {
        _minScore = int.TryParse(e.Value?.ToString(), out var v) ? v / 100d : 0d;
        _visibleCache = null;
        await SaveUiStateAsync();
    }

    private async Task OnSourceFilterChangedAsync(bool isSystemSource, bool value)
    {
        if (isSystemSource)
            _showSystem = value;
        else
            _showTenant = value;

        if (!_showSystem && !_showTenant)
        {
            if (isSystemSource)
                _showSystem = true;
            else
                _showTenant = true;
        }

        if (_hasLoaded)
            await LoadAsync();
        else
            _visibleCache = null;
        await SaveUiStateAsync();
    }

    private async Task LoadAsync()
    {
        var loadVersion = ++_loadVersion;
        _loading = true;
        StateHasChanged();

        var leafTasks = GetLeafTasksInOrder();
        var taskIds = leafTasks.Select(t => t.Id).ToList();

        var bulkResults = await Repo.Resource.GetBulkSuggestionsAsync(taskIds, maxResultsPerTask: 10);
        if (loadVersion != _loadVersion)
            return;

        _entries = leafTasks.Select(task =>
        {
            var all = bulkResults.TryGetValue(task.Id, out var suggestions) ? suggestions : [];
            var filtered = all
                .Where(s =>
                    (_showSystem && s.Source == TaskResourceSuggestionSource.BlueprintTask) ||
                    (_showTenant && s.Source == TaskResourceSuggestionSource.TenantTask))
                .OrderByDescending(s => s.Score)
                .Take(10)
                .ToList();
            var entry = new TaskEntry(task, filtered);
            if (entry.Suggestions.Count > 0)
                entry.SelectedIndex = 0;
            return entry;
        }).ToList();

        _visibleCache = null;
        _missingTasksCount = _entries.Count(e => e.Suggestions.Count == 0);
        _hasLoaded = true;
        _loading = false;
    }

    private string BuildNoVisibleEntriesMessage()
    {
        if (!_showSystem && !_showTenant)
            return "Both suggestion sources are disabled.";
        if (_entries.All(e => e.Suggestions.Count == 0))
            return "No matching source tasks with resources were found above the suggestion threshold.";
        if (!string.IsNullOrWhiteSpace(_taskFilter))
            return $"Suggestions were loaded, but none match \"{_taskFilter}\".";
        if (_minScore > 0)
            return $"Suggestions were loaded, but all visible candidates are below {(_minScore * 100).ToString("0", CultureInfo.InvariantCulture)}%.";
        return "Suggestions were loaded, but the current filters hide them. Try lowering Min score, clearing search, or enabling both sources.";
    }

    private async Task LoadUiStateAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", UiStateStorageKey);
            if (string.IsNullOrWhiteSpace(json))
                return;
            var state = JsonSerializer.Deserialize<SuggestionFilterState>(json);
            if (state is null)
                return;
            _showSystem = state.ShowSystem;
            _showTenant = state.ShowTenant;
            if (!_showSystem && !_showTenant)
                _showSystem = true;
            _taskFilter = state.FilterText ?? string.Empty;
            _minScore = Math.Clamp(state.MinScore, 0d, 1d);
        }
        catch { }
    }

    private async Task SaveUiStateAsync()
    {
        try
        {
            var state = new SuggestionFilterState
            {
                ShowSystem = _showSystem,
                ShowTenant = _showTenant,
                FilterText = _taskFilter,
                MinScore = _minScore
            };
            await JS.InvokeVoidAsync("localStorage.setItem", UiStateStorageKey, JsonSerializer.Serialize(state));
        }
        catch { }
    }

    private async Task EnsureResourcesLoadedAsync(TaskEntry entry, int index)
    {
        if (entry.ResourceCache.ContainsKey(index) || entry.LoadingSet.Contains(index))
            return;

        entry.LoadingSet.Add(index);
        StateHasChanged();

        var sug = entry.Suggestions[index];
        var resources = await Repo.Resource.GetSuggestionResourcesAsync(sug.SourceTaskId, sug.Source);
        var rows = resources.Select(r => new ResourceRow(r)).ToList();
        var convertedQty = GetConvertedQty(entry, sug.SourceTaskUnit);
        foreach (var row in rows) row.ApplyCostRole(convertedQty);
        entry.ResourceCache[index] = rows;
        entry.LoadingSet.Remove(index);
        StateHasChanged();
    }

    private async Task SelectSuggestionAsync(TaskEntry entry, int index)
    {
        entry.SelectedIndex = index;
        if (entry.ResourcesExpanded)
            await EnsureResourcesLoadedAsync(entry, index);
        StateHasChanged();
    }

    private async Task ToggleExpandAsync(TaskEntry entry)
    {
        entry.ResourcesExpanded = !entry.ResourcesExpanded;
        if (entry.ResourcesExpanded && entry.SelectedIndex.HasValue)
            await EnsureResourcesLoadedAsync(entry, entry.SelectedIndex.Value);
        StateHasChanged();
    }

    private async Task SaveAllAsync()
    {
        _saving = true;
        StateHasChanged();

        var entriesToSave = _entries.Where(e => e.SelectedIndex.HasValue).ToList();

        // Load all resources in parallel before sequential save
        await Task.WhenAll(entriesToSave.Select(e => EnsureResourcesLoadedAsync(e, e.SelectedIndex!.Value)));

        foreach (var entry in entriesToSave)
        {
            var toSave = (entry.GetRows(entry.SelectedIndex!.Value) ?? [])
                .Where(r => r.Included)
                .Select(r =>
                {
                    r.Resource.Name               = r.Name;
                    r.Resource.IsActive           = r.IsActive;
                    r.Resource.Cost               = r.Cost;
                    r.Resource.BaseCost           = r.BaseCost;
                    r.Resource.Data.ChangeFactor1 = r.ChangeFactor1;
                    r.Resource.Data.CapFromTask   = r.CapFromTask;
                    r.Resource.Data.CO2           = r.CO2;
                    r.Resource.Data.CapWaste      = r.CapWaste;
                    return r.Resource;
                })
                .ToList();

            if (toSave.Count > 0)
            {
                await Repo.Resource.CreateAsync(toSave, entry.Task.Id);
                await RecordFeedbackAsync(entry, entry.Suggestions[entry.SelectedIndex!.Value], TaskResourceSuggestionFeedbackKind.Accepted, notify: false);
            }
        }

        MHD.Notifications(ToastType.Add, true);
        _saving = false;
        Modal.Close();
    }

    private async Task RecordFeedbackAsync(
        TaskEntry entry,
        TaskResourceSuggestionDTO suggestion,
        TaskResourceSuggestionFeedbackKind feedback,
        bool notify = true)
    {
        if (entry.FeedbackSaving)
            return;

        if (suggestion.Feedback == feedback)
            return;

        if (suggestion.Feedback.HasValue &&
            suggestion.Feedback.Value != feedback &&
            entry.GetPendingFeedback(suggestion) != feedback)
        {
            entry.SetPendingFeedback(suggestion, feedback);
            StateHasChanged();
            return;
        }

        entry.FeedbackSaving = true;
        StateHasChanged();

        try
        {
            var result = await Repo.Resource.RecordSuggestionFeedbackAsync(BuildFeedbackDto(entry.Task, suggestion, feedback));
            if (result)
            {
                suggestion.Feedback = feedback;
                entry.ClearPendingFeedback(suggestion);
            }
            if (notify)
                MHD.Notifications(ToastType.Update, result);
        }
        finally
        {
            entry.FeedbackSaving = false;
        }
    }

    private static string FeedbackSelectValue(TaskEntry entry, TaskResourceSuggestionDTO suggestion)
        => (entry.GetPendingFeedback(suggestion) ?? suggestion.Feedback)?.ToString() ?? string.Empty;

    private static string FeedbackSelectClass(TaskEntry entry, TaskResourceSuggestionDTO suggestion)
    {
        const string baseClass = "shrink-0 rounded border px-2 py-1 text-xs focus:border-blue-400 focus:outline-none disabled:opacity-50 dark:bg-gray-900";
        if (entry.GetPendingFeedback(suggestion).HasValue)
            return $"{baseClass} border-amber-500 bg-amber-50 text-amber-700 dark:border-amber-600 dark:bg-amber-950/40 dark:text-amber-300";

        return suggestion.Feedback.HasValue
            ? $"{baseClass} border-emerald-500 bg-emerald-50 text-emerald-700 dark:border-emerald-600 dark:bg-emerald-950/40 dark:text-emerald-300"
            : $"{baseClass} border-gray-300 bg-white text-gray-600 dark:border-gray-700 dark:text-gray-300";
    }

    private void OnFeedbackSelected(TaskEntry entry, TaskResourceSuggestionDTO suggestion, string? rawValue)
    {
        if (!Enum.TryParse<TaskResourceSuggestionFeedbackKind>(rawValue, out var feedback))
        {
            entry.ClearPendingFeedback(suggestion);
            return;
        }

        if (suggestion.Feedback == feedback)
            entry.ClearPendingFeedback(suggestion);
        else
            entry.SetPendingFeedback(suggestion, feedback);
    }

    private async Task SavePendingFeedbackAsync(TaskEntry entry, TaskResourceSuggestionDTO suggestion)
    {
        if (entry.GetPendingFeedback(suggestion) is { } feedback)
            await RecordFeedbackAsync(entry, suggestion, feedback);
    }

    private static TaskResourceSuggestionFeedbackDTO BuildFeedbackDto(
        TaskListMVVM task,
        TaskResourceSuggestionDTO suggestion,
        TaskResourceSuggestionFeedbackKind feedback)
        => new()
        {
            TargetTaskId = task.Id,
            TargetTaskName = task.Name,
            TargetTaskCode = task.Code,
            TargetTaskUnit = task.Unit,
            TargetTaskQuantity = task.Quantity,
            SourceTaskId = suggestion.SourceTaskId,
            SourceTaskName = suggestion.SourceTaskName,
            SourceTaskUnit = suggestion.SourceTaskUnit,
            SourceTaskQuantity = suggestion.SourceTaskQuantity,
            Source = suggestion.Source,
            Score = suggestion.Score,
            Feedback = feedback,
            Reason = suggestion.Reason
        };

    private List<TaskListMVVM> GetLeafTasksInOrder()
    {
        if (Tasks is { Count: > 0 })
            return Tasks
                .Where(task => task.Type != TaskType.CodeName && task.Tasks.Count == 0)
                .DistinctBy(task => task.Id)
                .OrderBy(task => task.SortOrder)
                .ToList();

        var result = new List<TaskListMVVM>();
        foreach (var root in CalcModel.RootTasks)
            CollectLeaves(root, result);
        return result;
    }

    private static void CollectLeaves(TaskListMVVM task, List<TaskListMVVM> result)
    {
        if (task.Tasks.Count == 0)
        {
            if (task.Type != TaskType.CodeName)
                result.Add(task);
            return;
        }
        foreach (var child in task.Tasks.OrderBy(t => t.SortOrder))
            CollectLeaves(child, result);
    }

    private static string BuildOptionText(int idx, TaskResourceSuggestionDTO sug)
    {
        var sb = new System.Text.StringBuilder();
        sb.Append($"#{idx + 1}  {sug.Score.ToString("0%", CultureInfo.InvariantCulture)}");
        if (!string.IsNullOrWhiteSpace(sug.SourceTaskName))
            sb.Append($"  ·  {sug.SourceTaskName}");
        if (sug.Source != TaskResourceSuggestionSource.BlueprintTask && sug.SourceTaskQuantity is > 0)
            sb.Append($"  ·  {sug.SourceTaskQuantity.Value.ToString("0.###", CultureInfo.InvariantCulture)}");
        if (sug.Source != TaskResourceSuggestionSource.BlueprintTask && !string.IsNullOrWhiteSpace(sug.SourceTaskUnit))
            sb.Append($" {sug.SourceTaskUnit}");
        if (UsesParentContext(sug))
            sb.Append("  -  Parent context");
        return sb.ToString();
    }

    private static bool UsesParentContext(TaskResourceSuggestionDTO suggestion)
        => suggestion.Reason.Contains("parent code", StringComparison.OrdinalIgnoreCase) ||
           suggestion.Reason.Contains("ancestor code", StringComparison.OrdinalIgnoreCase);

    private static string GetScoreDetailClass(TaskResourceSuggestionScoreDetailDTO detail)
    {
        const string baseClass = "shrink-0 rounded px-1.5 py-0.5 text-[10px] font-semibold ring-1";
        return detail.Kind switch
        {
            "quantity" => $"{baseClass} bg-cyan-50 text-cyan-700 ring-cyan-200 dark:bg-cyan-950/40 dark:text-cyan-300 dark:ring-cyan-800",
            "unit" => $"{baseClass} bg-emerald-50 text-emerald-700 ring-emerald-200 dark:bg-emerald-950/40 dark:text-emerald-300 dark:ring-emerald-800",
            "code" or "context" => $"{baseClass} bg-indigo-50 text-indigo-700 ring-indigo-200 dark:bg-indigo-950/40 dark:text-indigo-300 dark:ring-indigo-800",
            "warning" => $"{baseClass} bg-rose-50 text-rose-700 ring-rose-200 dark:bg-rose-950/40 dark:text-rose-300 dark:ring-rose-800",
            "feedback" => $"{baseClass} bg-amber-50 text-amber-700 ring-amber-200 dark:bg-amber-950/40 dark:text-amber-300 dark:ring-amber-800",
            "ml" => $"{baseClass} bg-violet-50 text-violet-700 ring-violet-200 dark:bg-violet-950/40 dark:text-violet-300 dark:ring-violet-800",
            _ => $"{baseClass} bg-gray-50 text-gray-600 ring-gray-200 dark:bg-gray-800 dark:text-gray-300 dark:ring-gray-700"
        };
    }

    private static string FormatScoreDetailValue(TaskResourceSuggestionScoreDetailDTO detail)
        => detail.Value.HasValue ? $" {detail.Value.Value.ToString("0%", CultureInfo.InvariantCulture)}" : string.Empty;

    private static string FormatScoreDetailTitle(TaskResourceSuggestionScoreDetailDTO detail)
        => $"{detail.Label}{FormatScoreDetailValue(detail)}";

    private static string GetSourceBadgeClass(TaskResourceSuggestionSource source) => source switch
    {
        TaskResourceSuggestionSource.BlueprintTask => "bg-blue-100 text-blue-700 dark:bg-blue-950 dark:text-blue-300",
        TaskResourceSuggestionSource.TenantTask    => "bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300",
        _                                          => "bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-300"
    };

    private static string GetScoreColorClass(double score) => score switch
    {
        >= 0.80 => "bg-green-500",
        >= 0.55 => "bg-yellow-400",
        _       => "bg-red-400"
    };

    private static string GetScoreTextClass(double score) => score switch
    {
        >= 0.80 => "text-green-600 dark:text-green-400",
        >= 0.55 => "text-yellow-600 dark:text-yellow-400",
        _       => "text-red-500 dark:text-red-400"
    };

    // ── Models ───────────────────────────────────────────────────────────────

    private sealed class TaskEntry
    {
        public TaskListMVVM Task { get; }
        public List<TaskResourceSuggestionDTO> Suggestions { get; }
        public int?  SelectedIndex     { get; set; }
        public bool  ResourcesExpanded { get; set; }
        public bool  FeedbackSaving    { get; set; }

        public Dictionary<ParamName, decimal>     ConversionParams { get; } = new();
        public Dictionary<int, List<ResourceRow>> ResourceCache    { get; } = [];
        public HashSet<int>                       LoadingSet       { get; } = [];
        private Dictionary<string, TaskResourceSuggestionFeedbackKind> PendingFeedbackChanges { get; } = [];

        public List<ResourceRow>? GetRows(int index) => ResourceCache.TryGetValue(index, out var r) ? r : null;
        public TaskResourceSuggestionFeedbackKind? GetPendingFeedback(TaskResourceSuggestionDTO suggestion)
            => PendingFeedbackChanges.TryGetValue(BuildSuggestionKey(suggestion), out var feedback) ? feedback : null;
        public void SetPendingFeedback(TaskResourceSuggestionDTO suggestion, TaskResourceSuggestionFeedbackKind feedback)
            => PendingFeedbackChanges[BuildSuggestionKey(suggestion)] = feedback;
        public void ClearPendingFeedback(TaskResourceSuggestionDTO suggestion)
            => PendingFeedbackChanges.Remove(BuildSuggestionKey(suggestion));

        public TaskEntry(TaskListMVVM task, IEnumerable<TaskResourceSuggestionDTO> suggestions)
        {
            Task        = task;
            Suggestions = suggestions.ToList();
        }

        private static string BuildSuggestionKey(TaskResourceSuggestionDTO suggestion)
            => $"{suggestion.Source}:{suggestion.SourceTaskId}";
    }

    private sealed class SuggestionFilterState
    {
        public bool ShowSystem { get; set; } = true;
        public bool ShowTenant { get; set; } = true;
        public string FilterText { get; set; } = string.Empty;
        public double MinScore { get; set; }
    }

    private sealed class ResourceRow
    {
        public ResourcePostDTO Resource  { get; }
        public bool    Included          { get; set; } = true;
        public string  Name              { get; set; }
        public bool    IsActive          { get; set; }
        public decimal Cost              { get; set; }
        public decimal? BaseCost         { get; set; }
        public decimal ChangeFactor1     { get; set; }
        public bool    CapFromTask       { get; set; }
        public double? CO2               { get; set; }
        public decimal CapWaste          { get; set; }

        public bool HasParameters => Resource.Data.Parameters.Count > 0;
        public bool HasAddOns     => Resource.Data.AddOns.Count > 0;
        public bool HasTimes      => Resource.Data.Times.Count > 0;

        public void ApplyCostRole(decimal convertedTaskQty)
        {
            if (Resource.CostRole is { Count: > 0 })
            {
                var role = Resource.CostRole.FirstOrDefault(r => r.Min <= convertedTaskQty && convertedTaskQty <= r.Max);
                if (role?.Value is not null) Cost = role.Value.Value;
            }
        }

        public ResourceRow(ResourcePostDTO resource)
        {
            Resource    = resource;
            Name        = resource.Name;
            IsActive    = resource.IsActive;
            Cost        = resource.Cost;
            BaseCost    = resource.BaseCost;
            CapFromTask = resource.Data.CapFromTask;
            CO2         = resource.Data.CO2;
            CapWaste    = resource.Data.CapWaste;
            RecomputeChangeFactor1();
        }

        public void RecomputeChangeFactor1()
        {
            if (!HasParameters) { ChangeFactor1 = Resource.Data.ChangeFactor1; return; }
            var product = 1m;
            foreach (var p in Resource.Data.Parameters.Where(p => p.IsActive))
                product = Math.Round(product * p.Value, 4, MidpointRounding.AwayFromZero);
            ChangeFactor1 = product;
        }
    }
}
