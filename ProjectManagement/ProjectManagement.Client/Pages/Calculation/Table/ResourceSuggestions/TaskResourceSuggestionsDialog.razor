@using ProjectManagement.Client.Shared.MVVM.Calculation
@using ProjectManagement.Client.Shared.ResourceFiles.Calculation
@using ProjectManagement.Shared.Base.Calculation
@using ProjectManagement.Shared.DTO.Calculation
@using ProjectManagement.Shared.Enums
@using ProjectManagement.Shared.Helper.ProjectAppStorage
@using ProjectManagement.Shared.Helper.Text
@using Microsoft.JSInterop
@using System.Text.Json
@using System.Globalization
@inherits AppComponentBase
@inject IJSRuntime JS

<div class="flex flex-col gap-3">
    @if (!_loading)
    {
        <div class="flex flex-wrap items-center gap-2 rounded border border-gray-200 bg-gray-50 px-3 py-2 dark:border-gray-700 dark:bg-gray-900">
            <label class="flex cursor-pointer items-center gap-1.5 text-xs font-medium text-gray-600 dark:text-gray-300">
                <input type="checkbox" checked="@_showSystem"
                       @onchange="e => OnSourceFilterChanged(ref _showSystem, (bool)(e.Value ?? false))"
                       class="h-4 w-4 cursor-pointer accent-blue-600" />
                <span class="rounded bg-blue-100 px-1.5 py-0.5 text-[10px] font-semibold text-blue-700 dark:bg-blue-950 dark:text-blue-300">@CalcResource.badgeSystem</span>
                <span>@CalcResource.resourceTypeSystem</span>
            </label>

            <label class="flex cursor-pointer items-center gap-1.5 text-xs font-medium text-gray-600 dark:text-gray-300">
                <input type="checkbox" checked="@_showTenant"
                       @onchange="e => OnSourceFilterChanged(ref _showTenant, (bool)(e.Value ?? false))"
                       class="h-4 w-4 cursor-pointer accent-emerald-600" />
                <span class="rounded bg-emerald-100 px-1.5 py-0.5 text-[10px] font-semibold text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300">@CalcResource.badgeCompany</span>
                <span>@CalcResource.resourceType</span>
            </label>

            <div class="relative min-w-[16rem] flex-1">
                <input type="search"
                       placeholder="@CalcResource.filterSuggestions"
                       value="@_filterText"
                       @oninput="OnFilterTextChangedAsync"
                       class="w-full rounded border border-gray-300 bg-white py-1.5 pl-8 pr-3 text-sm text-gray-700 placeholder-gray-400 focus:border-blue-400 focus:outline-none dark:border-gray-600 dark:bg-gray-800 dark:text-gray-200 dark:placeholder-gray-500" />
                <svg class="pointer-events-none absolute left-2 top-2 h-4 w-4 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
                </svg>
                @if (!string.IsNullOrWhiteSpace(_filterText))
                {
                    <span class="absolute right-2 top-1.5 rounded bg-gray-100 px-1.5 py-0.5 text-xs text-gray-500 dark:bg-gray-700 dark:text-gray-400">
                        @FilteredStates.Count / @_states.Count
                    </span>
                }
            </div>

            <div class="flex shrink-0 items-center gap-1.5">
                <label class="whitespace-nowrap text-xs font-medium text-gray-500 dark:text-gray-400">@CalcResource.minScore</label>
                <input type="range" min="0" max="100" step="5"
                       value="@((int)(_minScore * 100))"
                       @oninput="e => OnMinScoreChanged(e.Value?.ToString())"
                       class="w-24 accent-blue-600" />
                <span class="w-8 text-right text-xs font-semibold text-gray-600 dark:text-gray-300">
                    @(_minScore > 0 ? $"{(int)(_minScore * 100)}%" : "All")
                </span>
            </div>

            <button class="inline-flex h-8 items-center rounded border border-gray-300 bg-white px-3 text-sm font-medium text-gray-700 hover:border-blue-500 hover:text-blue-600 disabled:cursor-not-allowed disabled:opacity-50 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-200"
                    disabled="@_loading" @onclick="LoadAsync">
                @AppLoc["update"]
            </button>
        </div>
    }

    @if (_loading)
    {
        <div class="py-4">
            <BlazorMHD.UI.Components.Feedback.Loading.MhdLoading />
        </div>
    }
    else if (_states.Count == 0)
    {
        <div class="rounded border border-dashed border-gray-300 px-3 py-4 text-sm text-gray-500 dark:border-gray-700 dark:text-gray-400">
            @NoSuggestionsMessage
        </div>
    }
    else
    {
        @if (!FilteredStates.Any())
        {
            <div class="rounded border border-dashed border-gray-300 px-3 py-4 text-sm text-gray-500 dark:border-gray-700 dark:text-gray-400">
                @FilteredOutMessage
            </div>
        }

        <div class="flex flex-col gap-3">
            @foreach (var state in DisplayedStates)
            {
                var convRule    = state.GetConversionRule(TaskItem.Unit);
                var userParams  = convRule?.Params.Where(p => p.Source == ParamSource.User).ToList() ?? [];
                var hasResParam = convRule?.Params.Any(p => p.Source == ParamSource.Resource) ?? false;
                var canCompute  = convRule == null || (!hasResParam && userParams.All(p => state.ConversionParams.ContainsKey(p.Key)));
                var convertedQty = state.GetConvertedQty(TaskItem);

                <div class="overflow-hidden rounded border border-gray-200 bg-white shadow-sm dark:border-gray-700 dark:bg-gray-900">

                    <!-- ── Suggestion header ── -->
                    <div class="flex min-w-0 items-start justify-between gap-2 border-b border-gray-100 px-2 py-1.5 dark:border-gray-800">

                        <div class="flex shrink-0 flex-col items-center gap-0.5">
                            <button class="flex h-7 w-7 items-center justify-center rounded border border-gray-300 text-base leading-none text-gray-700 hover:bg-gray-50 disabled:opacity-40 dark:border-gray-700 dark:text-gray-200 dark:hover:bg-gray-800"
                                    disabled="@state.IsLoadingResources"
                                    title="@(state.IsExpanded ? "Collapse resources" : "Load resources")"
                                    @onclick="() => ToggleResourcesAsync(state)">
                                @(state.IsLoadingResources ? "..." : state.IsExpanded ? "-" : "+")
                            </button>
                            @if (state.Suggestion.ResourceCount > 0)
                            {
                                <span class="text-[9px] font-semibold leading-none text-gray-400 dark:text-gray-500">
                                    @state.Suggestion.ResourceCount
                                </span>
                            }
                        </div>

                        <div class="min-w-0 flex-1">
                            <div class="flex min-w-0 flex-col gap-1">

                                <div class="min-w-0 overflow-hidden whitespace-normal text-sm font-semibold leading-snug text-gray-900 dark:text-gray-100"
                                     style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;"
                                     title="@state.Suggestion.SourceTaskName">
                                    @if (!string.IsNullOrWhiteSpace(state.Suggestion.SourceTaskCode))
                                    {
                                        <span class="mr-1 rounded bg-gray-200 px-1.5 py-0.5 font-mono text-xs font-semibold text-gray-700 dark:bg-gray-700 dark:text-gray-200">@state.Suggestion.SourceTaskCode</span>
                                    }
                                    @state.Suggestion.SourceTaskName
                                </div>

                                @if (!string.IsNullOrWhiteSpace(state.Suggestion.SourceTaskParentName))
                                {
                                    <div class="truncate text-xs text-gray-400 dark:text-gray-500"
                                         title="@state.Suggestion.SourceTaskParentName">
                                        ↳ @state.Suggestion.SourceTaskParentName
                                    </div>
                                }

                                <div class="flex min-w-0 flex-wrap items-center gap-2">

                                @if (HasTaskQuantityInfo(state.Suggestion))
                                {
                                    <span class="shrink-0 rounded bg-blue-50 px-1.5 py-0.5 text-xs font-medium text-blue-700 dark:bg-blue-950 dark:text-blue-300">
                                        @FormatTaskQuantity(state.Suggestion)
                                    </span>
                                }

                                @if (convRule is not null)
                                {
                                    <span class="shrink-0 rounded bg-amber-100 px-1.5 py-0.5 text-[10px] font-semibold text-amber-700 dark:bg-amber-950/40 dark:text-amber-400"
                                          title="Unit conversion required">
                                        @UnitRulesCatalog.BuildKey(TaskItem.Unit) → @UnitRulesCatalog.BuildKey(state.Suggestion.SourceTaskUnit ?? "")
                                    </span>
                                }

                                <span class="shrink-0 rounded px-1.5 py-0.5 text-xs font-semibold @GetSourceBadgeClass(state.Suggestion.Source)">
                                    @GetSourceLabel(state.Suggestion.Source)
                                </span>

                                @if (UsesParentContext(state.Suggestion))
                                {
                                    <span class="shrink-0 rounded bg-indigo-50 px-1.5 py-0.5 text-[10px] font-semibold text-indigo-700 ring-1 ring-indigo-200 dark:bg-indigo-950/40 dark:text-indigo-300 dark:ring-indigo-800"
                                          title="@state.Suggestion.Reason">
                                        @CalcResource.parentContext
                                    </span>
                                }

                                <span class="min-w-0 flex-[1_1_10rem] truncate text-xs text-gray-400 dark:text-gray-500"
                                      title="@state.Suggestion.Reason">
                                    @state.Suggestion.Reason
                                </span>

                                <SuggestionScoreDetails Details="state.Suggestion.ScoreDetails" MaxItems="5" />

                                <div class="flex shrink-0 items-center gap-2">
                                    <div class="h-1.5 w-24 overflow-hidden rounded-full bg-gray-200 dark:bg-gray-700">
                                        <div class="h-full rounded-full transition-all @GetScoreColorClass(state.Suggestion.Score)"
                                             style="width:@((state.Suggestion.Score * 100).ToString("0", CultureInfo.InvariantCulture))%">
                                        </div>
                                    </div>
                                    <span class="text-xs font-medium @GetScoreTextClass(state.Suggestion.Score)">
                                    @state.Suggestion.Score.ToString("0%", CultureInfo.InvariantCulture)
                                </span>
                            </div>

                                </div>

                            </div>
                        </div>

                        <div class="flex shrink-0 items-center gap-1">
                            <select value="@FeedbackSelectValue(state)"
                                    disabled="@state.IsRecordingFeedback"
                                    title="@CalcResource.feedbackLabel"
                                    @onchange="e => OnFeedbackSelected(state, e.Value?.ToString())"
                                    class="@FeedbackSelectClass(state)">
                                <option value="">@CalcResource.feedbackLabel</option>
                                <option value="@TaskResourceSuggestionFeedbackKind.Accepted">@CalcResource.feedbackGood</option>
                                <option value="@TaskResourceSuggestionFeedbackKind.Rejected">@CalcResource.feedbackBad</option>
                                <option value="@TaskResourceSuggestionFeedbackKind.WrongUnit">@CalcResource.feedbackUnit</option>
                                <option value="@TaskResourceSuggestionFeedbackKind.MissingResources">@CalcResource.feedbackMissing</option>
                                <option value="@TaskResourceSuggestionFeedbackKind.WrongResourceType">@CalcResource.feedbackType</option>
                            </select>
                            <button class="rounded border border-blue-600 px-2 py-1 text-xs font-medium text-blue-700 hover:bg-blue-50 disabled:opacity-40 dark:border-blue-400 dark:text-blue-300 dark:hover:bg-blue-950"
                                    disabled="@(state.IsRecordingFeedback || !state.PendingFeedbackChange.HasValue)"
                                    title="@CalcResource.feedbackSave"
                                    @onclick="() => SavePendingFeedbackAsync(state)">
                                @CalcResource.feedbackSave
                            </button>
                        </div>

                        @if (state.Suggestion.Score >= 0.85 && !state.IsExpanded)
                        {
                            <button class="shrink-0 rounded border border-emerald-600 bg-emerald-600 px-3 py-1 text-sm font-medium text-white hover:bg-emerald-700 disabled:opacity-40 dark:border-emerald-500 dark:bg-emerald-500"
                                    disabled="@state.IsApplying"
                                    title="@CalcResource.quickAdd"
                                    @onclick="() => QuickApplyAsync(state)">
                                ⚡ @CalcResource.quickAdd
                            </button>
                        }

                        <button class="shrink-0 rounded border border-blue-600 px-3 py-1 text-sm text-blue-700 hover:bg-blue-50 disabled:opacity-40 dark:border-blue-400 dark:text-blue-300 dark:hover:bg-blue-950"
                                disabled="@(state.IsApplying || !state.IsExpanded || state.IsLoadingResources || !state.Rows.Any(r => r.Selected))"
                                @onclick="() => ApplySuggestionAsync(state)">
                            @CalcResource.suggestionAddSelected
                        </button>
                    </div>

                    @if (state.IsExpanded)
                    {
                        if (state.IsLoadingResources)
                        {
                            <div class="py-3">
                                <BlazorMHD.UI.Components.Feedback.Loading.MhdLoading />
                            </div>
                        }
                        else if (state.Rows.Count == 0)
                        {
                            <div class="px-3 py-3 text-sm text-gray-500 dark:text-gray-400">
                                @CalcResource.suggestionNoResults
                            </div>
                        }
                        else
                        {
                            <!-- ── Conversion panel (when units differ) ── -->
                            @if (convRule is not null)
                            {
                                <div class="border-b border-amber-200 bg-amber-50 px-3 py-2 dark:border-amber-900/40 dark:bg-amber-950/20">
                                    <div class="flex flex-wrap items-center gap-3">

                                        <span class="shrink-0 text-xs font-semibold text-amber-700 dark:text-amber-400">
                                            ⚠ @UnitRulesCatalog.BuildKey(TaskItem.Unit) → @UnitRulesCatalog.BuildKey(state.Suggestion.SourceTaskUnit ?? "")
                                        </span>

                                        <span class="shrink-0 rounded bg-amber-100 px-2 py-0.5 font-mono text-[11px] font-semibold text-amber-800 ring-1 ring-amber-200 dark:bg-amber-950/40 dark:text-amber-300 dark:ring-amber-800">
                                            @BuildFormulaText(TaskItem.Quantity ?? 0m, TaskItem.Unit, convRule)
                                        </span>

                                        @foreach (var param in userParams)
                                        {
                                            var p = param;
                                            <div class="flex items-center gap-1">
                                                <label class="shrink-0 text-xs text-amber-700 dark:text-amber-400">@GetParamLabel(p.Key)</label>
                                                <input type="number" step="0.001" placeholder="0"
                                                       value="@(state.ConversionParams.TryGetValue(p.Key, out var pv) ? pv.ToString("0.###", CultureInfo.InvariantCulture) : "")"
                                                       @onchange="e => OnConvParamChanged(state, p.Key, e.Value?.ToString())"
                                                       class="w-20 rounded border border-amber-300 bg-white px-1.5 py-0.5 text-xs text-gray-900 focus:border-amber-500 focus:outline-none dark:border-amber-700 dark:bg-gray-800 dark:text-gray-100" />
                                            </div>
                                        }

                                        @if (canCompute && convertedQty != (TaskItem.Quantity ?? 0m))
                                        {
                                            <span class="rounded bg-amber-200 px-2 py-0.5 text-xs font-bold text-amber-900 dark:bg-amber-900/50 dark:text-amber-200">
                                                = @convertedQty.ToString("0.###", CultureInfo.InvariantCulture) @UnitRulesCatalog.BuildKey(state.Suggestion.SourceTaskUnit ?? "")
                                            </span>
                                        }

                                        @if (hasResParam)
                                        {
                                            <span class="text-[11px] italic text-amber-600 dark:text-amber-500">* density comes from resource</span>
                                        }

                                    </div>
                                </div>
                            }

                            <!-- ── Resources table ── -->
                            <div class="overflow-x-auto">
                                <table class="w-full text-sm">
                                    <thead class="border-b border-gray-100 bg-gray-50 text-xs dark:border-gray-800 dark:bg-gray-950">
                                        <tr>
                                            <th class="w-8 px-2 py-1.5"></th>
                                            <th class="px-2 py-1.5 text-left font-medium text-gray-500 dark:text-gray-400">@CalcResource.name</th>
                                            <th class="px-2 py-1.5 text-left font-medium text-gray-500 dark:text-gray-400">@CalcResource.type</th>
                                            <th class="px-2 py-1.5 text-left font-medium text-gray-500 dark:text-gray-400">@CalcResource.unit</th>
                                            <th class="w-32 px-2 py-1.5 text-right font-medium text-gray-500 dark:text-gray-400">@CalcResource.quantity</th>
                                            <th class="w-32 px-2 py-1.5 text-right font-medium text-gray-500 dark:text-gray-400">@CalcResource.cost</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        @foreach (var row in state.Rows)
                                        {
                                            <tr class="border-b border-gray-50 last:border-0 dark:border-gray-800 @(row.Selected ? "" : "opacity-40")">
                                                <td class="px-2 py-1 text-center">
                                                    <input type="checkbox"
                                                           checked="@row.Selected"
                                                           @onchange="e => row.Selected = (bool)(e.Value ?? false)"
                                                           class="cursor-pointer accent-blue-600" />
                                                </td>

                                                <td class="px-2 py-1">
                                                    <input type="text"
                                                           value="@row.Name"
                                                           @onchange="e => row.Name = e.Value?.ToString() ?? row.Name"
                                                           class="w-full min-w-[8rem] rounded border border-gray-200 bg-transparent px-1.5 py-0.5 text-gray-900 focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:text-gray-100" />
                                                </td>

                                                <td class="px-2 py-1 text-gray-500 dark:text-gray-400">
                                                    @row.Resource.ResType
                                                </td>

                                                <td class="px-2 py-1 text-gray-500 dark:text-gray-400">
                                                    @row.Resource.Unit
                                                </td>

                                                <td class="px-2 py-1">
                                                    <input type="number"
                                                           value="@row.Quantity.ToString("0.00", CultureInfo.InvariantCulture)"
                                                           step="0.01"
                                                           @onchange="e => { if (decimal.TryParse(e.Value?.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var v)) row.Quantity = RoundQuantity(v); }"
                                                           class="w-28 rounded border border-gray-200 bg-transparent px-2 py-0.5 text-right text-gray-900 focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:text-gray-100" />
                                                </td>

                                                <td class="px-2 py-1">
                                                    <div class="flex items-center gap-1">
                                                        <input type="number"
                                                               value="@row.Cost.ToString("0.00", CultureInfo.InvariantCulture)"
                                                               step="0.01"
                                                               @onchange="e => { if (decimal.TryParse(e.Value?.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var v)) row.Cost = v; }"
                                                               class="w-28 rounded border border-gray-200 bg-transparent px-2 py-0.5 text-right text-gray-900 focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:text-gray-100" />
                                                        @if (row.Resource.CostRole.Count > 0)
                                                        {
                                                            <span class="shrink-0 rounded bg-blue-50 px-1 py-0.5 text-[10px] font-semibold text-blue-600 dark:bg-blue-950 dark:text-blue-400" title="Cost from tiered role table">R</span>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }

                </div>
            }
        </div>

        @if (_canShowMore)
        {
            <div class="flex justify-center">
                <button class="rounded border border-gray-300 px-4 py-1.5 text-sm text-gray-600 hover:bg-gray-50 disabled:opacity-40 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800"
                        disabled="@_loading"
                        @onclick="ShowMoreAsync">
                    @CalcResource.suggestionShowMore
                </button>
            </div>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public TaskListMVVM TaskItem { get; set; } = default!;

    private const int PageSize = 30;
    private const int SuggestionFetchLimit = 100;
    private bool _loading = true;
    private int _maxResults = PageSize;
    private bool _showSystem = true;
    private bool _showTenant = true;
    private List<SuggestionState> _states = [];
    private string _filterText = string.Empty;
    private double _minScore;
    private string UiStateStorageKey => $"task-resource-suggestions-ui:{TaskItem.Id}";

    private List<SuggestionState>? _filteredCache;
    private string _lastFilterText = "\0";
    private bool _lastShowSystem = true;
    private bool _lastShowTenant = true;
    private double _lastMinScore = -1d;

    private List<SuggestionState> FilteredStates
    {
        get
        {
            if (_filteredCache is null
                || _lastFilterText != _filterText
                || _lastShowSystem != _showSystem
                || _lastShowTenant != _showTenant
                || Math.Abs(_lastMinScore - _minScore) > double.Epsilon)
            {
                _filteredCache = _states
                    .Where(SourceMatches)
                    .Where(s => s.Suggestion.Score >= _minScore)
                    .Where(s =>
                        string.IsNullOrWhiteSpace(_filterText) ||
                        FuzzySearchHelper.Score(_filterText, s.Suggestion.SourceTaskName) >= FuzzySearchHelper.Threshold)
                    .ToList();
                _lastFilterText = _filterText;
                _lastShowSystem = _showSystem;
                _lastShowTenant = _showTenant;
                _lastMinScore = _minScore;
            }
            return _filteredCache;
        }
    }

    private IEnumerable<SuggestionState> DisplayedStates => FilteredStates.Take(_maxResults);
    private bool _canShowMore => FilteredStates.Count > _maxResults;
    private bool IsEligibleTarget => TaskTypeRules.CanHaveResources(TaskItem.Type) && TaskItem.Tasks.Count == 0;
    private string NoSuggestionsMessage => !IsEligibleTarget
        ? CalcResource.suggestionLeafOnly
        : !_showSystem && !_showTenant
            ? CalcResource.suggestionBothDisabled
            : _minScore > 0
                ? CalcResource.suggestionNoTasksAtScore
                : CalcResource.suggestionNoTasksAboveThreshold;
    private string FilteredOutMessage => BuildFilteredOutMessage();

    protected override async Task OnInitializedAsync()
    {
        await LoadUiStateAsync();
        await LoadAsync();
    }

    private async Task OnFilterTextChangedAsync(ChangeEventArgs e)
    {
        _filterText = e.Value?.ToString() ?? string.Empty;
        _filteredCache = null;
        _maxResults = PageSize;
        await SaveUiStateAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();

        if (!IsEligibleTarget)
        {
            _states = [];
            _filteredCache = null;
            _loading = false;
            return;
        }

        _maxResults = PageSize;
        var previousStates = _states.ToDictionary(x => x.Key);
        var results = await Repo.Resource.GetSuggestionsAsync(TaskItem.Id, SuggestionFetchLimit, includeResources: false);

        _states = results
            .Select(s =>
            {
                if (previousStates.TryGetValue(SuggestionState.BuildKey(s), out var existing))
                {
                    existing.UpdateSuggestion(s);
                    return existing;
                }
                return new SuggestionState(s, TaskItem);
            })
            .ToList();

        _filteredCache = null;
        _loading = false;

        // Auto-expand top suggestion when confidence is high — saves the user a click
        var firstVisible = DisplayedStates.FirstOrDefault();
        if (firstVisible is not null && firstVisible.Suggestion.Score >= 0.85 && !firstVisible.IsExpanded)
            await ToggleResourcesAsync(firstVisible);
    }

    private void ShowMoreAsync() => _maxResults += PageSize;

    private void OnMinScoreChanged(string? rawValue)
    {
        _minScore = int.TryParse(rawValue, out var value) ? value / 100d : 0d;
        _maxResults = PageSize;
        _filteredCache = null;
        _ = SaveUiStateAsync();
    }

    private void OnSourceFilterChanged(ref bool target, bool value)
    {
        target = value;
        if (!_showSystem && !_showTenant)
            target = true;

        _maxResults = PageSize;
        _filteredCache = null;
        _ = SaveUiStateAsync();
    }

    private string BuildFilteredOutMessage()
    {
        if (!_showSystem && !_showTenant)
            return CalcResource.suggestionBothDisabled;
        if (!string.IsNullOrWhiteSpace(_filterText))
            return string.Format(CalcResource.suggestionFilterNoMatch, _filterText);
        if (_minScore > 0)
            return string.Format(CalcResource.suggestionFilterBelowScore, (int)(_minScore * 100));
        return CalcResource.suggestionFilterHidden;
    }

    private async Task LoadUiStateAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", UiStateStorageKey);
            if (string.IsNullOrWhiteSpace(json))
                return;
            var state = JsonSerializer.Deserialize<SuggestionFilterState>(json);
            if (state is null)
                return;
            _showSystem = state.ShowSystem;
            _showTenant = state.ShowTenant;
            if (!_showSystem && !_showTenant)
                _showSystem = true;
            _filterText = state.FilterText ?? string.Empty;
            _minScore = Math.Clamp(state.MinScore, 0d, 1d);
        }
        catch { }
    }

    private async Task SaveUiStateAsync()
    {
        try
        {
            var state = new SuggestionFilterState
            {
                ShowSystem = _showSystem,
                ShowTenant = _showTenant,
                FilterText = _filterText,
                MinScore = _minScore
            };
            await JS.InvokeVoidAsync("localStorage.setItem", UiStateStorageKey, JsonSerializer.Serialize(state));
        }
        catch { }
    }

    private bool SourceMatches(SuggestionState state)
        => (_showSystem && state.Suggestion.Source == TaskResourceSuggestionSource.BlueprintTask) ||
           (_showTenant && state.Suggestion.Source == TaskResourceSuggestionSource.TenantTask);

    private async Task ToggleResourcesAsync(SuggestionState state)
    {
        if (state.IsLoadingResources) return;

        if (state.IsExpanded) { state.IsExpanded = false; return; }

        state.IsExpanded = true;
        if (state.HasLoadedResources) return;

        state.IsLoadingResources = true;
        StateHasChanged();

        try
        {
            var resources = await Repo.Resource.GetSuggestionResourcesAsync(
                state.Suggestion.SourceTaskId,
                state.Suggestion.Source);
            state.SetResources(resources, TaskItem);
        }
        finally
        {
            state.IsLoadingResources = false;
        }
    }

    private void OnConvParamChanged(SuggestionState state, ParamName paramKey, string? rawValue)
    {
        if (decimal.TryParse(rawValue, NumberStyles.Any, CultureInfo.InvariantCulture, out var v))
            state.ConversionParams[paramKey] = v;
        else
            state.ConversionParams.Remove(paramKey);

        state.RecalculateQuantities(TaskItem);
        StateHasChanged();
    }

    private async Task QuickApplyAsync(SuggestionState state)
    {
        if (state.IsApplying) return;

        // Load resources if not yet expanded
        if (!state.IsExpanded || !state.HasLoadedResources)
        {
            state.IsExpanded = true;
            state.IsLoadingResources = true;
            StateHasChanged();
            try
            {
                var resources = await Repo.Resource.GetSuggestionResourcesAsync(
                    state.Suggestion.SourceTaskId,
                    state.Suggestion.Source);
                state.SetResources(resources, TaskItem);
            }
            finally
            {
                state.IsLoadingResources = false;
            }
        }

        // Select all rows then apply
        foreach (var row in state.Rows)
            row.Selected = true;

        await ApplySuggestionAsync(state);
    }

    private async Task ApplySuggestionAsync(SuggestionState state)
    {
        var selectedRows = state.Rows.Where(r => r.Selected).ToList();
        if (state.IsApplying || selectedRows.Count == 0) return;

        state.IsApplying = true;
        StateHasChanged();

        try
        {
            foreach (var row in selectedRows)
            {
                row.Resource.Name     = row.Name;
                row.Resource.Quantity = row.Quantity;
                row.Resource.Cost     = row.Cost;
            }

            var result = await Repo.Resource.CreateAsync(
                selectedRows.Select(r => r.Resource).ToList(),
                TaskItem.Id);

            MHD.Notifications(ToastType.Add, result);
            if (result)
            {
                await RecordFeedbackAsync(state, TaskResourceSuggestionFeedbackKind.Accepted, notify: false);
                Modal.Close();
            }
        }
        finally
        {
            state.IsApplying = false;
        }
    }

    private async Task RecordFeedbackAsync(
        SuggestionState state,
        TaskResourceSuggestionFeedbackKind feedback,
        bool notify = true)
    {
        if (state.IsRecordingFeedback)
            return;

        if (state.Suggestion.Feedback == feedback)
            return;

        if (state.Suggestion.Feedback.HasValue &&
            state.Suggestion.Feedback.Value != feedback &&
            state.PendingFeedbackChange != feedback)
        {
            state.PendingFeedbackChange = feedback;
            StateHasChanged();
            return;
        }

        state.IsRecordingFeedback = true;
        StateHasChanged();

        try
        {
            var result = await Repo.Resource.RecordSuggestionFeedbackAsync(BuildFeedbackDto(state.Suggestion, feedback));
            if (result)
            {
                state.Suggestion.Feedback = feedback;
                state.PendingFeedbackChange = null;
            }
            if (notify)
                MHD.Notifications(ToastType.Update, result);
        }
        finally
        {
            state.IsRecordingFeedback = false;
        }
    }

    private static string FeedbackSelectValue(SuggestionState state)
        => (state.PendingFeedbackChange ?? state.Suggestion.Feedback)?.ToString() ?? string.Empty;

    private static string FeedbackSelectClass(SuggestionState state)
    {
        const string baseClass = "rounded border px-2 py-1 text-xs focus:border-blue-400 focus:outline-none disabled:opacity-50 dark:bg-gray-900";
        if (state.PendingFeedbackChange.HasValue)
            return $"{baseClass} border-amber-500 bg-amber-50 text-amber-700 dark:border-amber-600 dark:bg-amber-950/40 dark:text-amber-300";

        return state.Suggestion.Feedback.HasValue
            ? $"{baseClass} border-emerald-500 bg-emerald-50 text-emerald-700 dark:border-emerald-600 dark:bg-emerald-950/40 dark:text-emerald-300"
            : $"{baseClass} border-gray-300 bg-white text-gray-600 dark:border-gray-700 dark:text-gray-300";
    }

    private void OnFeedbackSelected(SuggestionState state, string? rawValue)
    {
        if (!Enum.TryParse<TaskResourceSuggestionFeedbackKind>(rawValue, out var feedback))
        {
            state.PendingFeedbackChange = null;
            return;
        }

        state.PendingFeedbackChange = state.Suggestion.Feedback == feedback ? null : feedback;
    }

    private async Task SavePendingFeedbackAsync(SuggestionState state)
    {
        if (state.PendingFeedbackChange is { } feedback)
            await RecordFeedbackAsync(state, feedback);
    }

    private TaskResourceSuggestionFeedbackDTO BuildFeedbackDto(
        TaskResourceSuggestionDTO suggestion,
        TaskResourceSuggestionFeedbackKind feedback)
        => new()
        {
            TargetTaskId = TaskItem.Id,
            TargetTaskName = TaskItem.Name,
            TargetTaskCode = TaskItem.Code,
            TargetTaskUnit = TaskItem.Unit,
            TargetTaskQuantity = TaskItem.Quantity,
            SourceTaskId = suggestion.SourceTaskId,
            SourceTaskName = suggestion.SourceTaskName,
            SourceTaskUnit = suggestion.SourceTaskUnit,
            SourceTaskQuantity = suggestion.SourceTaskQuantity,
            Source = suggestion.Source,
            Score = suggestion.Score,
            Feedback = feedback,
            Reason = suggestion.Reason
        };

    private static string GetParamLabel(ParamName p) => p switch
    {
        ParamName.Thickness => "Depth/Thickness (m)",
        ParamName.Width     => "Width (m)",
        ParamName.Length    => "Length (m)",
        ParamName.Density   => "Density (t/m³)",
        _                   => p.ToString()
    };

    private static string BuildFormulaText(decimal taskQuantity, string taskUnit, UnitRule rule)
    {
        var parts = new List<string>
        {
            $"{taskQuantity.ToString("0.###", CultureInfo.InvariantCulture)} {UnitRulesCatalog.BuildKey(taskUnit)}"
        };

        parts.AddRange(rule.Params.Select(p => p.Key switch
        {
            ParamName.Thickness => "Depth",
            ParamName.Width     => "Width",
            ParamName.Length    => "Length",
            ParamName.Density   => "Density",
            _                   => p.Key.ToString()
        }));

        return string.Join(" x ", parts);
    }

