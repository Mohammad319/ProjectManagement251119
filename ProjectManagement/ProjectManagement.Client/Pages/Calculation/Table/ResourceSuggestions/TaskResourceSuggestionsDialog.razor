    private static string FormatScoreDetailValue(TaskResourceSuggestionScoreDetailDTO detail)
        => detail.Value.HasValue ? $" {detail.Value.Value.ToString("0%", CultureInfo.InvariantCulture)}" : string.Empty;

    private static string FormatScoreDetailTitle(TaskResourceSuggestionScoreDetailDTO detail)
        => $"{detail.Label}{FormatScoreDetailValue(detail)}";

    private static string FormatTaskQuantity(TaskResourceSuggestionDTO suggestion)
    {
        var quantity = suggestion.SourceTaskQuantity?.ToString("0.###", CultureInfo.InvariantCulture);
        var unit     = suggestion.SourceTaskUnit?.Trim();
        if (!string.IsNullOrWhiteSpace(quantity) && !string.IsNullOrWhiteSpace(unit))
            return $"{quantity} {unit}";
        return quantity ?? unit ?? string.Empty;
    }

    // ── Models ───────────────────────────────────────────────────────────────

    private sealed class SuggestionState
    {
        public TaskResourceSuggestionDTO Suggestion { get; private set; }
        public List<ResourceEditRow>     Rows        { get; private set; }
        public bool   IsApplying          { get; set; }
        public bool   IsExpanded          { get; set; }
        public bool   IsLoadingResources  { get; set; }
        public bool   IsRecordingFeedback { get; set; }
        public bool   HasLoadedResources  { get; private set; }
        public TaskResourceSuggestionFeedbackKind? PendingFeedbackChange { get; set; }
        public string Key                 => BuildKey(Suggestion);

        public Dictionary<ParamName, decimal> ConversionParams { get; } = new();

        public SuggestionState(TaskResourceSuggestionDTO suggestion, TaskListMVVM task)
        {
            Suggestion = suggestion;
            Rows = suggestion.Resources.Select(r => new ResourceEditRow(r, task, GetConvertedQty(task))).ToList();
            HasLoadedResources = suggestion.Resources.Count > 0;
        }

        public static string BuildKey(TaskResourceSuggestionDTO suggestion)
            => $"{suggestion.Source}:{suggestion.SourceTaskId}";

        public void UpdateSuggestion(TaskResourceSuggestionDTO suggestion)
        {
            Suggestion = suggestion;
            if (PendingFeedbackChange == suggestion.Feedback)
                PendingFeedbackChange = null;
        }

        public void SetResources(IEnumerable<ResourcePostDTO> resources, TaskListMVVM task)
        {
            var converted = GetConvertedQty(task);
            Rows = resources.Select(r => new ResourceEditRow(r, task, converted)).ToList();
            HasLoadedResources = true;
        }

        public void RecalculateQuantities(TaskListMVVM task)
        {
            var converted = GetConvertedQty(task);
            foreach (var row in Rows)
                row.Recalc(task, converted);
        }

        public UnitRule? GetConversionRule(string taskUnit)
        {
            var from = UnitRulesCatalog.BuildKey(taskUnit);
            var to   = UnitRulesCatalog.BuildKey(Suggestion.SourceTaskUnit ?? "");
            if (string.IsNullOrWhiteSpace(from) || string.IsNullOrWhiteSpace(to)) return null;
            if (string.Equals(from, to, StringComparison.OrdinalIgnoreCase)) return null;
            return UnitRulesCatalog.TryGet(from, to, out var rule) ? rule : null;
        }

        public decimal GetConvertedQty(TaskListMVVM task)
        {
            var raw  = task.Quantity ?? 0m;
            var rule = GetConversionRule(task.Unit);
            if (rule == null) return raw;
            if (rule.Params.Any(p => p.Source == ParamSource.Resource)) return raw;

            var d = new Dictionary<ParamName, decimal>();
            foreach (var p in rule.Params.Where(x => x.Source == ParamSource.User))
            {
                if (!ConversionParams.TryGetValue(p.Key, out var v)) return raw;
                d[p.Key] = v;
            }
            try   { return rule.Compute(raw, d); }
            catch { return raw; }
        }
    }

    private sealed class SuggestionFilterState
    {
        public bool ShowSystem { get; set; } = true;
        public bool ShowTenant { get; set; } = true;
        public string FilterText { get; set; } = string.Empty;
        public double MinScore { get; set; }
    }

    private sealed class ResourceEditRow
    {
        public bool           Selected  { get; set; } = true;
        public ResourcePostDTO Resource { get; }
        public string  Name     { get; set; }
        public decimal Quantity { get; set; }
        public decimal Cost     { get; set; }

        public ResourceEditRow(ResourcePostDTO resource, TaskListMVVM task, decimal convertedTaskQty)
        {
            Resource = resource;
            Name     = resource.Name;
            Recalc(task, convertedTaskQty);
        }

        public void Recalc(TaskListMVVM task, decimal convertedTaskQty)
        {
            Quantity = RoundQuantity(CalcQuantity(Resource, task, convertedTaskQty));
            Resource.Quantity = Quantity;
            Cost = GetEffectiveCost(Resource, convertedTaskQty);
        }

        private static decimal CalcQuantity(ResourcePostDTO r, TaskListMVVM task, decimal convertedQty)
        {
            var capWaste = IsCapRes(r) && r.Data.CapFromTask && task.Cap.HasValue
                ? task.Cap.Value
                : r.Data.CapWaste;
            var baseCalc = convertedQty * r.Data.ChangeFactor1 * r.Data.ChangeFactor2;

            if (IsWasteRes(r) && capWaste != 0) return baseCalc * (1 + capWaste / 100);
            if (IsCapRes(r)   && capWaste != 0) return baseCalc / capWaste;
            return baseCalc;
        }

        private static decimal GetEffectiveCost(ResourcePostDTO r, decimal convertedQty)
        {
            if (r.CostRole is { Count: > 0 })
            {
                var role = r.CostRole.FirstOrDefault(x => x.Min <= convertedQty && convertedQty <= x.Max);
                if (role?.Value is not null) return role.Value.Value;
            }
            return r.Cost;
        }

        private static bool IsCapRes(ResourcePostDTO r)
            => r.ResType is ResourceTypesEnum.MachinesAndEquipments or ResourceTypesEnum.Worker;

        private static bool IsWasteRes(ResourcePostDTO r)
            => r.ResType is ResourceTypesEnum.Materials;
    }

    private static decimal RoundQuantity(decimal value)
        => Math.Round(value, 2, MidpointRounding.AwayFromZero);
}
