@using BlazorMHD.UI.Components.Feedback.Splitter
@using ProjectManagement.Client.Pages.Calculation.Table.SectionsList
@using ProjectManagement.Client.Pages.Calculation.Table.Header
@using ProjectManagement.Client.Pages.Project.Storage

<div class="flex h-full min-h-0 flex-col gap-1">
@if (!HasCalculation)
{
    <section class="calc-state-panel calc-state-panel-muted" data-testid="calculation-page-unavailable">
        <div class="calc-state-copy">
            <p class="calc-state-title">@AppLoc["calculationDetailsUnavailable"]</p>
        </div>
    </section>
}
else
{
        <div class="calc-page-header" data-testid="calculation-page-header">
            <CalculationToolbar />

            <section class="calc-status-strip" data-testid="calculation-page-status">
                <div class="calc-status-chips">
                    <span class="calc-status-chip">
                        <span class="calc-status-chip-label">@AppLoc["visibleItems"]</span>
                        <strong>@VisibleItemCountText</strong>
                    </span>

                    <button type="button"
                            data-testid="status-toggle-tasks"
                            class="@GetToggleChipClass(Calc!.ShowTasks)"
                            aria-pressed="@(Calc.ShowTasks ? "true" : "false")"
                            @onclick="ToggleShowTasks">
                        <span class="calc-status-chip-label">@ResourceLoc.task</span>
                        <strong>@TaskCount</strong>
                    </button>

                    <button type="button"
                            data-testid="status-toggle-only-code-text"
                            class="@GetToggleChipClass(Calc!.ShowOnlyCodeTextTasks)"
                            aria-pressed="@(Calc.ShowOnlyCodeTextTasks ? "true" : "false")"
                            @onclick="ToggleShowOnlyCodeTextTasks">
                        <span class="calc-status-chip-label">@AppLoc["onlyCodeText"]</span>
                        <strong>@OnlyCodeTextTaskCount</strong>
                    </button>

                    <button type="button"
                            data-testid="status-toggle-resources"
                            class="@GetToggleChipClass(Calc!.ShowResources)"
                            aria-pressed="@(Calc.ShowResources ? "true" : "false")"
                            @onclick="ToggleShowResources">
                        <span class="calc-status-chip-label">@ResourceLoc.resource</span>
                        <strong>@ResourceCount</strong>
                    </button>

                    <button type="button"
                            data-testid="status-toggle-comments"
                            class="@GetToggleChipClass(CalcService.ShowComments)"
                            aria-pressed="@(CalcService.ShowComments ? "true" : "false")"
                            @onclick="ToggleComments">
                        <span class="calc-status-chip-label">@CalcResource.note</span>
                    </button>

                    <button type="button"
                            data-testid="status-toggle-resource-variables"
                            class="@GetToggleChipClass(CalcService.ShowResourceVariables)"
                            aria-pressed="@(CalcService.ShowResourceVariables ? "true" : "false")"
                            @onclick="ToggleResourceVariables">
                        <span class="calc-status-chip-label">@StorageLoc["storageVariables"]</span>
                    </button>

                    <button type="button"
                            data-testid="status-toggle-only-active"
                            class="@GetToggleChipClass(Calc!.OnlyActive)"
                            aria-pressed="@(Calc.OnlyActive ? "true" : "false")"
                            @onclick="ToggleOnlyActive">
                        <span class="calc-status-chip-label">@ResourceLoc.onlyActive</span>
                    </button>

                    <button type="button"
                            data-testid="status-display-presets"
                            class="calc-status-chip calc-status-chip-toggle"
                            title="@AppLoc["displayPresets"]"
                            @onclick="OpenDisplayPresetsDialog">
                        @((MarkupString)Icons.SaveCloud)
                    </button>

                    @if (SelectedItemCount > 0)
                    {
                        <button type="button"
                                data-testid="status-clear-selection"
                                class="calc-status-chip calc-status-chip-accent calc-status-chip-action"
                                @onclick="ClearSelection">
                            <span class="calc-status-chip-label">@AppLoc["selectedItems"]</span>
                            <strong>@SelectedItemCount</strong>
                        </button>
                    }

                    @if (HasActiveFilters)
                    {
                        <button type="button"
                                data-testid="status-clear-filters"
                                class="calc-status-chip calc-status-chip-action"
                                @onclick="ClearFilters">
                            <span class="calc-status-chip-label">@AppLoc["visibilityFilter"]</span>
                            <strong>@AppLoc["clearFilters"]</strong>
                        </button>
                    }

                </div>
            </section>
        </div>

        @if (ShowEmptyState)
        {
      @*       <section class="calc-state-panel" data-testid="calculation-page-empty">
                <div class="calc-state-copy">
                    <p class="calc-state-title">@AppLoc["calculationTableEmptyState"]</p>
                    <p class="calc-state-hint">@AppLoc["calculationTableEmptyStateHint"]</p>
                </div>
            </section> *@
        }
        else if (ShowNoVisibleRowsState)
        {
            <section class="calc-state-panel calc-state-panel-muted" data-testid="calculation-page-no-visible-rows">
          @*   <div class="calc-state-copy p-5">
                    <p class="calc-state-title">@AppLoc["calculationTableNoVisibleRows"]</p>
                    <p class="calc-state-hint">@NoVisibleRowsHint</p>
                </div> *@

                @if (HasActiveFilters)
                {
                    <button type="button"
                            class="calc-state-action"
                            @onclick="ClearFilters">
                        @AppLoc["clearFilters"]
                    </button>
                }
            </section>
    }

        <VerticalSplitter Class="min-h-0 flex-1 border border-zinc-200 dark:border-zinc-800 rounded-2xl"
                      InitialPaneHeight="400"
                          InitialHeightForBottomPane="false"
                          MinTopHeight="50"
                          MinBottomHeight="25"
                          MaxTopHeight="900"
                          SplitterThickness="6"
                          LiveResize="true"
                          StorageKey="calc-main-vertical-splitter">

            <TopContent>
        
                <div class="divNetCalc"
                     style="--net-text-color:@Template?.NetCalc?.Color?.Text;
                    --net-border-color:@Template?.NetCalc?.Color?.Border;
                    --net-header-bg:@Template?.NetCalc?.Color?.Header;
                    --net-note-color:@Template?.NetCalc?.Color?.Note;
                    --net-inactive-text-color:@Template?.NetCalc?.Color?.InactiveText;
                    --net-border-style:@Template?.NetCalc?.Color?.BorderStyle;">
                    <CalcDataGrid />
                </div>
            

            </TopContent>

            <BottomContent>
                <div class="px-1">
                    <GetFromStorage ParentID="Calc!.Id" CalcType="CalculationItemType.task" />
                </div>
            </BottomContent>
        </VerticalSplitter>
}
</div>
