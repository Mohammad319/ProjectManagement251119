﻿@using BlazorMHD.UI.Components.Feedback.Splitter
@using BlazorMHD.UI.Core.Services
@using ContextMenuMHD
@using ProjectManagement.Client.Helper
@using ProjectManagement.Client.Pages.Calculation.Form
@using ProjectManagement.Client.Pages.Calculation.Table.DragDrop
@using ProjectManagement.Client.Pages.Calculation.Table.SectionsList
@using ProjectManagement.Client.Pages.Project.Storage
@using ProjectManagement.Client.Services.Calculation
@using ProjectManagement.Client.Shared.MVVM.Calculation
@using ProjectManagement.Client.Shared.SharedComponent
@using ProjectManagement.Shared.DTO.Project
@inherits AppComponentBase
@inject IContextMenuBuilderService ContextBuilderService
@inject ContextMenuService ContextMenuService

<div id="tit" class="flex flex-wrap items-center gap-2 px-2">

    <span class="inline-flex items-center rounded px-2 py-1 text-slate-700 hover:bg-slate-100 cursor-pointer dark:text-slate-200 dark:hover:bg-slate-800"
          @onclick="OpenTaskForm"
          title="@AppLoc[LocalizerConst.New, ResourceLoc.task]">
        @Icons.Plus2
    </span>

    <AuthorizeView Roles="@PMRolesConst.Tenant.AdminManger" Context="Auth_1">
        <Authorized>
            @if (Calc.Tap1)
            {
                <span title="@ResourceApp.importFromFile"
                      class="inline-flex items-center rounded px-2 py-1 text-slate-700 hover:bg-slate-100 cursor-pointer dark:text-slate-200 dark:hover:bg-slate-800"
                      @onclick="() => Modal.ShowComponent<CSVUI>(ResourceApp.importFromFile, Icons.ImportFromFile, null, DialogSize.ExtraLarge)">
                    @((MarkupString)Icons.ImportFromFile)
                </span>

                <span class="inline-flex items-center rounded px-2 py-1 text-slate-700 hover:bg-slate-100 cursor-pointer dark:text-slate-200 dark:hover:bg-slate-800"
                      title="@ResourceLoc.template"
                      @onclick="() => Modal.ShowComponent<Pages.Calculation.Template.TemplateSetDefaultUI>(
                      ResourceLoc.templates,
                                            Icons.Template,
                                            new Dictionary<string, object>()
                                            {
                                                [nameof(Pages.Calculation.Template.TemplateSetDefaultUI.Tab)] = 1,
                                            },
                                            DialogSize.ExtraLarge)">
                @((MarkupString)Icons.Template)
            </span>

            <span title="@ResourceApp.reOrder"
                  class="inline-flex items-center rounded px-2 py-1 text-slate-700 hover:bg-slate-100 cursor-pointer dark:text-slate-200 dark:hover:bg-slate-800"
                  @onclick="() => Modal.ShowComponent<DragDropTaskUI>(ResourceApp.reOrder, Icons.ReorderRows, null, DialogSize.ExtraLarge)">
                @((MarkupString)Icons.ReorderRows)
            </span>
                        }

            @if (SelectedData.SelectedItems.Count != 0)
            {
                <span class="inline-flex items-center rounded px-2 py-1 text-slate-700 hover:bg-slate-100 cursor-pointer dark:text-slate-200 dark:hover:bg-slate-800"
                      @onclick="UnSelectedAll"
                      title="@ResourceLoc.unselectAll">
                    @((MarkupString)Icons.NotSelected)
                </span>
            }

            @if (TemporaryData.HasPasteOption(CalculationItemType.task)
                        && (!(TemporaryData.CopyTypeo == CopyType.Move && TemporaryData.OldCalcID == Calc.Id)
                        || TemporaryData.CopyTypeo == CopyType.Copy))
            {
                <span class="inline-flex items-center rounded px-2 py-1 text-slate-700 hover:bg-slate-100 cursor-pointer dark:text-slate-200 dark:hover:bg-slate-800"
                      @onclick="async () => await PasteItem(0)"
                      title="@ResourceApp.paste">
                    @((MarkupString)Icons.Paste)
                </span>
            }

            @if (CalcService.Offer != null)
            {
                <span class="inline-flex items-center px-2 py-1 text-[11px] md:text-xs
                                 rounded-md bg-amber-100 text-amber-800 dark:bg-amber-900 dark:text-amber-100">
                    @(ResourceLoc.offer + $" : {ResourceLoc.category} {CalcService.Offer.SubCategory}>{CalcService.Offer.SubCategory} {ResourceApp.organisation} {CalcService.Offer.Organisation}")
                </span>

                <span class="ml-1 font-bold text-sm text-red-600 hover:text-red-700 cursor-pointer"
                      role="button"
                      @onclick="() => CalcService.Offer = null">
                    X
                </span>
            }
        </Authorized>
    </AuthorizeView>

    <div class="relative">
        <span class="inline-flex items-center rounded px-2 py-1 text-slate-700 hover:bg-slate-100 cursor-pointer dark:text-slate-200 dark:hover:bg-slate-800" @onclick="ToggleFilterDropdown">
            🧾 @ResourceApp.DisplayOptions
        </span>

        @if (IsFilterDropdownOpen)
        {
            <div class="absolute z-50 mt-1 w-56 bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700 rounded-md shadow-lg text-sm">
                <div class="px-3 py-2 border-b border-gray-100 dark:border-slate-700 font-semibold">
                    @ResourceApp.DisplayOptions
                </div>

                <label class="flex items-center gap-2 px-3 py-2 cursor-pointer hover:bg-gray-50 dark:hover:bg-slate-700">
                    <input type="checkbox"
                           class="rounded" checked
                           @bind-value="Calc.ShowTasks"
                           @bind-value:event="onchange"
                           @bind-value:after="@(() => Calc.NotifyGridRefresh(flatListDirty: true))" />
                    <span>@ResourceLoc.task</span>
                </label>

                <label class="flex items-center gap-2 px-3 py-2 cursor-pointer hover:bg-gray-50 dark:hover:bg-slate-700">
                    <input type="checkbox"
                           class="rounded" checked
                           @bind-value="Calc.ShowResources"
                           @bind-value:event="onchange"
                           @bind-value:after="@(() => Calc.NotifyGridRefresh(flatListDirty: true))" />
                    <span>@ResourceLoc.resource</span>
                </label>

                <label class="flex items-center gap-2 px-3 py-2 cursor-pointer hover:bg-gray-50 dark:hover:bg-slate-700">
                    <input type="checkbox"
                           class="rounded" checked
                           @bind-value="CalcService.ShowComments"
                           @bind-value:event="onchange"
                           @bind-value:after="@(() => Calc.NotifyGridRefresh(flatListDirty: true))" />
                    <span>@CalcResource.note</span>
                </label>

                <label class="flex items-center gap-2 px-3 py-2 cursor-pointer hover:bg-gray-50 dark:hover:bg-slate-700 border-t border-gray-100 dark:border-slate-700">
                    <input type="checkbox"
                           class="rounded"
                           @bind-value="Calc.OnlyActive"
                           @bind-value:event="onchange"
                           @bind-value:after="@(() => Calc.NotifyGridRefresh(flatListDirty: true))" />
                    <span>@ResourceLoc.onlyActive</span>
                </label>
            </div>
        }
    </div>

    <span class="inline-flex items-center rounded px-2 py-1 text-slate-700 hover:bg-slate-100 cursor-pointer dark:text-slate-200 dark:hover:bg-slate-800" @onclick="ItemsOnlyOH">
        @(Calc.OHFactors ? "OH" : CalcResource.netCal)
    </span>

    <span class="inline-flex items-center rounded px-2 py-1 text-slate-700 hover:bg-slate-100 cursor-pointer dark:text-slate-200 dark:hover:bg-slate-800"
          title="CalcResource.quantity"
          @onclick="() => Modal.ShowComponent<QuantityListUI>(CalcResource.quantity, Icons.ResetQuantity, null, DialogSize.Medium, DialogButtonsHelper.CreateSaveCancelButtons(QuantityListUI.DialogFormId))">
        @((MarkupString)Icons.ResetQuantity)
    </span>

</div>

<VerticalSplitter Class="h-[80vh] border border-zinc-200 dark:border-zinc-800 rounded-2xl"
                  InitialTopHeight="400"
                  MinTopHeight="50"
                  MinBottomHeight="25"
                  MaxTopHeight="900"
                  SplitterThickness="6"
                  LiveResize="true"
                  StorageKey="calc-main-vertical-splitter">

    <TopContent>
        <div class="divNetCalc"
             style="--net-text-color:@Template?.NetCalc.Color.Text;
                    --net-border-color:@Template?.NetCalc.Color.Border;
                    --net-header-bg:@Template?.NetCalc.Color.Header;
                    --net-note-color:@Template?.NetCalc.Color.Note;
                    --net-border-style:@Template?.NetCalc.Color.BorderStyle;">
            <CalcDataGrid />
        </div>
    </TopContent>

    <BottomContent>
        <div class="px-1">
             <GetFromStorage ParentID="Calc.Id" CalcType="CalculationItemType.task" /> 
        </div>
    </BottomContent>
</VerticalSplitter>

@code {
    private bool IsFilterDropdownOpen;

    private void ToggleFilterDropdown()
    {
        IsFilterDropdownOpen = !IsFilterDropdownOpen;
    }

    private void OpenTaskForm()
    {
        Modal.ShowComponent<TaskFormUI>(
            AppLoc[LocalizerConst.New, ResourceLoc.task],
            Icons.NewTask,
            new Dictionary<string, object> { [nameof(TaskFormUI.Task)] = new TaskListMVVM() },
            DialogSize.ExtraLarge,
            DialogButtonsHelper.CreateSaveCancelButtons(TaskFormUI.DialogFormId));
    }

    private void ItemsOnlyOH()
    {
        Calc.OHFactors = !Calc.OHFactors;
        Calc.NotifyGridRefresh(flatListDirty: true);
    }

    private void UnSelectedAll()
    {
        SelectedData.Reset();
        Calc.NotifyGridRefresh(flatListDirty: false);
    }

    private async Task PasteItem(int taskId)
    {
        var post = new PostStorygeDTO
        {
            copyType = TemporaryData.CopyTypeo!.Value,
            OldCalcID = TemporaryData.OldCalcID,
            NewCalcID = Calc.Id,
            IsOH = Calc.OHFactors,
            ParentID = taskId,
            WithCildren = true,
            Items = TemporaryData.SelectedItems,
            Type = TemporaryData.ItemsType!.Value
        };

        bool result = await Repo.Storage.CreateItem(post);
        if (result)
        {
            SelectedData.Reset();
            MHD.Notifications(ToastType.Info, result);
        }
        else
        {
            MHD.Notifications(ToastType.Danger, false);
        }
    }
}
