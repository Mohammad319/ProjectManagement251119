@using ProjectManagement.Client.Shared.MVVM.Calculation
@using ProjectManagement.Client.Constant
@inherits AppComponentBase

@if (Task?.Resources != null && Task.Resources.Any())
{
    @foreach (var resource in GetOrderedResources())
    {
        <div class="@GetResourceItemClasses(resource)"
             @ondrop="@(() => HandleDropAsync(resource))"
             @ondragover="() => resource.Ui.IsDragOver = true"
             @ondragover:preventDefault
             @ondragleave="@(() => resource.Ui.IsDragOver = false)"
             @ondragstart="@(() => resourceDraging = resource)"
             @ondragend="@(() => resourceDraging = null)"
             draggable="true">

            <!-- Account -->
            <div class="flex w-[160px] text-xs md:text-sm truncate">
                @resource.Account
            </div>

            <!-- Account Code -->
            <div class="flex w-[160px] text-xs md:text-sm truncate">
                @resource.AccountCode
            </div>

            <!-- Name -->
            <div class="flex min-w-[350px] text-xs md:text-sm truncate">
                @resource.Name
            </div>

            <!-- Resource Name -->
            <div class="flex w-[160px] text-xs md:text-sm truncate">
                @resource.ResName
            </div>
        </div>
    }
}
else
{
    <div class="text-xs text-slate-500 dark:text-slate-400">
        @ResourceApp.ThereAreNoItemsToDisplay
    </div>
}

@code {
    private ResourceListMVVM? resourceDraging;

    [Parameter] public TaskListMVVM Task { get; set; } = default!;

    private string GetResourceItemClasses(ResourceListMVVM resource)
    {
        var baseClasses =
            $"flex flex-wrap items-center rounded-md border " +
            "bg-white dark:bg-slate-900 " +
            "border-slate-200 dark:border-slate-700 " +
            "px-2 py-1.5 mb-1.5 cursor-move text-slate-900 dark:text-slate-100 " +
            "transition-colors duration-150 hover:bg-slate-50 dark:hover:bg-slate-800";

        var dragging = resource == resourceDraging
            ? " opacity-60 border-2 border-dashed border-sky-500"
            : string.Empty;

        var dragOver = resource.Ui.IsDragOver
            ? " bg-sky-50 dark:bg-sky-900/50"
            : string.Empty;

        return baseClasses + dragging + dragOver;
    }

    private async Task HandleDropAsync(ResourceListMVVM landingModel)
    {
        try
        {
            if (resourceDraging is not null)
                resourceDraging.Ui.IsDragOver = false;

            landingModel.Ui.IsDragOver = false;

            if (resourceDraging is not null && !ReferenceEquals(resourceDraging, landingModel))
            {
                var orderedResources = GetOrderedResources();
                var newOrder = CalculateDropOrder(orderedResources, resourceDraging, landingModel, x => x.Order);
                if (newOrder == resourceDraging.Order)
                    return;

                resourceDraging.Order = newOrder;

                Task.Resources = Task.Resources
                    .OrderByDescending(x => x.Order)
                    .ThenBy(x => x.Id)
                    .ToList();

                await Repo.Resource.ReOrderAsync(resourceDraging.Id, resourceDraging.Order);
                Calc.NotifyGridRefresh(flatListDirty: true, structureFlatListDirty: true);
            }
        }
        finally
        {
            resourceDraging = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private List<ResourceListMVVM> GetOrderedResources() =>
        Task.Resources
            .Where(x => x.Ui.FilterVisible)
            .OrderByDescending(x => x.Order)
            .ThenBy(x => x.Id)
            .ToList();

    private static int CalculateDropOrder<TItem>(
        IReadOnlyList<TItem> orderedItems,
        TItem dragging,
        TItem landing,
        Func<TItem, int> orderSelector)
    {
        const int step = 100;

        var items = orderedItems
            .Where(x => !EqualityComparer<TItem>.Default.Equals(x, dragging))
            .ToList();

        var landingIndex = items.IndexOf(landing);
        if (landingIndex < 0)
            return orderSelector(dragging);

        var landingOrder = orderSelector(landing);
        var draggingOrder = orderSelector(dragging);

        if (draggingOrder < landingOrder)
        {
            if (landingIndex == 0)
                return landingOrder + step;

            return (orderSelector(items[landingIndex - 1]) + landingOrder) / 2;
        }

        if (landingIndex + 1 < items.Count)
            return (orderSelector(items[landingIndex + 1]) + landingOrder) / 2;

        return Math.Max(0, landingOrder - step);
    }
}
