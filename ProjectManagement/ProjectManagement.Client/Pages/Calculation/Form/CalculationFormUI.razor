@if (_showVersionsDialog)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/50 px-4 py-6">
        <div class="w-full max-w-2xl rounded-lg border border-slate-200 bg-white p-5 shadow-2xl dark:border-slate-700 dark:bg-slate-900">
            <div class="flex items-start justify-between gap-3">
                <div>
                    <h2 class="text-base font-semibold text-slate-900 dark:text-slate-50">@AppLoc["versions"]</h2>
                    <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">@(CalculationUpdate?.Name ?? string.Empty)</p>
                </div>
                <button type="button"
                        class="rounded-md border border-slate-300 px-2 py-1 text-sm text-slate-600 transition hover:bg-slate-50 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800"
                        @onclick="CloseVersionsDialog">
                    @AppLoc["close"]
                </button>
            </div>

            <div class="mt-4 overflow-hidden rounded-md border border-slate-200 dark:border-slate-700">
                <table class="w-full text-sm">
                    <thead class="bg-slate-50 dark:bg-slate-800">
                        <tr>
                            <th class="px-3 py-2 text-left text-xs font-semibold text-slate-600 dark:text-slate-300">@AppLoc["version"]</th>
                            <th class="px-3 py-2 text-left text-xs font-semibold text-slate-600 dark:text-slate-300">@CalcResource.status</th>
                            <th class="px-3 py-2 text-left text-xs font-semibold text-slate-600 dark:text-slate-300">@CalcResource.tenderDeadline</th>
                            <th class="px-3 py-2"></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                        @foreach (var version in CalculationVersions)
                        {
                            <tr class="bg-white dark:bg-slate-900">
                                <td class="px-3 py-2">
                                    <div class="flex flex-wrap items-center gap-1.5">
                                        <span class="font-semibold text-slate-800 dark:text-slate-100">V.@version.VersionNumber.ToString("D2")</span>
                                        @if (version.IsCurrentVersion)
                                        {
                                            <span class="rounded-full bg-emerald-100 px-2 py-0.5 text-[11px] font-semibold text-emerald-700 dark:bg-emerald-950/50 dark:text-emerald-300">@AppLoc["current"]</span>
                                        }
                                    </div>
                                </td>
                                <td class="px-3 py-2 text-xs text-slate-500 dark:text-slate-400">@FormatText(version.Status)</td>
                                <td class="px-3 py-2 text-xs text-slate-500 dark:text-slate-400">
                                    @(version.TenderDeadline == default ? "-" : version.TenderDeadline.ToString("yyyy-MM-dd"))
                                </td>
                                <td class="px-3 py-2 text-right">
                                    <div class="flex flex-wrap justify-end gap-1.5">
                                        <button type="button"
                                                class="rounded-md border border-slate-300 px-2 py-1 text-xs font-medium text-slate-700 transition hover:bg-slate-50 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
                                                @onclick="async () => await OpenVersionAsync(version)">
                                            @AppLoc["open"]
                                        </button>
                                        @if (!version.IsCurrentVersion)
                                        {
                                            <button type="button"
                                                    class="rounded-md border border-violet-300 px-2 py-1 text-xs font-medium text-violet-700 transition hover:bg-violet-50 disabled:cursor-not-allowed disabled:opacity-50 dark:border-violet-800 dark:text-violet-300 dark:hover:bg-violet-950/40"
                                                    disabled="@_isCreatingVersion"
                                                    @onclick="async () => await RestoreAsNewVersionAsync(version)">
                                                @AppLoc["restoreAsNewVersion"]
                                            </button>
                                        }
                                        @if (CanArchiveVersion(version))
                                        {
                                            <button type="button"
                                                    class="rounded-md border border-amber-300 px-2 py-1 text-xs font-medium text-amber-700 transition hover:bg-amber-50 dark:border-amber-800 dark:text-amber-300 dark:hover:bg-amber-950/40"
                                                    @onclick="async () => await ArchiveVersionAsync(version)">
                                                @AppLoc["archiveVersion"]
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!string.IsNullOrWhiteSpace(_versionDialogMessage))
            {
                <div class="mt-4 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-300">
                    @_versionDialogMessage
                </div>
            }
        </div>
    </div>
}

