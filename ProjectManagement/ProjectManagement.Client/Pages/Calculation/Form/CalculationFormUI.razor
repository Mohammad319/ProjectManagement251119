    private void ComputeTimeMonth()
    {
        if (CalculationUpdate.StartDate == default || CalculationUpdate.EndDate == default)
            return;
        var totalDays = (CalculationUpdate.EndDate - CalculationUpdate.StartDate).TotalDays;
        if (totalDays < 0) return;
        CalculationUpdate.TimeMonth = Math.Round((decimal)totalDays / 30.4375m, 1, MidpointRounding.AwayFromZero);
    }

    private enum DateFieldChanged
    {
        StartDate,
        EndDate,
        TimeMonth
    }

    private void OnStartDateChanged() => RecalculateDateFields(DateFieldChanged.StartDate);

    private void OnEndDateChanged() => RecalculateDateFields(DateFieldChanged.EndDate);

    private void OnTimeMonthInputChanged(ChangeEventArgs e)
    {
        var valueText = e.Value?.ToString()?.Trim();
        if (string.IsNullOrWhiteSpace(valueText))
            return;

        if (decimal.TryParse(valueText, NumberStyles.Number, SwedishCulture, out var months) ||
            decimal.TryParse(valueText.Replace(',', '.'), NumberStyles.Number, CultureInfo.InvariantCulture, out months))
        {
            CalculationUpdate.TimeMonth = Math.Round(months, 1, MidpointRounding.AwayFromZero);
            RecalculateDateFields(DateFieldChanged.TimeMonth);
        }
    }

    private void RecalculateDateFields(DateFieldChanged changed)
    {
        if (changed is DateFieldChanged.StartDate or DateFieldChanged.EndDate)
        {
            if (CalculationUpdate.StartDate != default && CalculationUpdate.EndDate != default)
                ComputeTimeMonth();
            else if (CalculationUpdate.StartDate != default && CalculationUpdate.TimeMonth > 0)
                CalculationUpdate.EndDate = AddDecimalMonths(CalculationUpdate.StartDate, CalculationUpdate.TimeMonth);
            else if (CalculationUpdate.EndDate != default && CalculationUpdate.TimeMonth > 0)
                CalculationUpdate.StartDate = AddDecimalMonths(CalculationUpdate.EndDate, -CalculationUpdate.TimeMonth);

            return;
        }

        if (CalculationUpdate.TimeMonth <= 0) return;

        if (CalculationUpdate.StartDate != default)
            CalculationUpdate.EndDate = AddDecimalMonths(CalculationUpdate.StartDate, CalculationUpdate.TimeMonth);
        else if (CalculationUpdate.EndDate != default)
            CalculationUpdate.StartDate = AddDecimalMonths(CalculationUpdate.EndDate, -CalculationUpdate.TimeMonth);
    }

    private static DateTime AddDecimalMonths(DateTime date, decimal months)
    {
        var wholeMonths = decimal.Truncate(months);
        var fraction = months - wholeMonths;
        return date.AddMonths((int)wholeMonths).AddDays((double)(fraction * 30.4375m));
    }

    private static string FormatMonthsInput(decimal months) =>
        Math.Round(months, 1, MidpointRounding.AwayFromZero)
            .ToString("0.#", SwedishCulture);

    private static string FormatMonthsDisplay(decimal months) =>
        $"{FormatMonthsInput(months)} mån";

    private void ResetEditContext()
    {
        editContext = new EditContext(CalculationUpdate);
