    private async Task EnsureResponsibilityDefaultsAsync()
    {
        EnsureResponsibleSlot();

        if (Calculation.Id == 0 && string.IsNullOrWhiteSpace(CalculationResponsible))
        {
            var projectResponsible = Folder.State.ProjectSelected?.Responsible;
            CalculationResponsible = !string.IsNullOrWhiteSpace(projectResponsible)
