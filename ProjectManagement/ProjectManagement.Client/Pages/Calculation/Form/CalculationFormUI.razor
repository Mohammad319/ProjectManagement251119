@code {
    public const string DialogFormId = "calcForm";
    bool btnSubmitDisabled = false;
    private bool _showContractDialog;
    private bool _isCreatingContractCalculation;
    private string _contractDialogMessage = string.Empty;
    private bool _showProductionDialog;
    private bool _isCreatingProductionCalculation;
    private string _productionDialogMessage = string.Empty;
    private bool _showVersionsDialog;
    private bool _isCreatingVersion;
    private string _versionDialogMessage = string.Empty;
    private bool _showApprovalDialog;
    private bool _isApprovingCalculation;
    private int? _pendingApprovalStatusId;
    private string _approvalDialogMessage = string.Empty;
    private string _approvalBlockMessage = string.Empty;
    private string _currentUserDisplayName = string.Empty;
    private bool _isCurrentUserAdmin;
    private int? _originalStatusId;
    private int? _statusBeforeApprovalDialog;
    private bool _statusDropdownOpen;
    private ElementReference _approvalDialogRef;
    private bool _focusApprovalDialog;

    // After a contract/production calculation is created we keep the form open showing the
    // new (editable) calculation, with a success row and an explicit "Öppna kalkyl" button.
    private int? _createdCalcId;
    private string _postCreateInfoKey = "contractCalculationCreatedInfo";
    private string _createBlockMessage = string.Empty;

    [Parameter] public EventCallback<ListCalculationMVVM?> Callback { get; set; }
    // Reloads the parent calculation list/tree WITHOUT closing the dialog. Used after
    // approve-and-lock and after creating a contract/production calculation.
    [Parameter] public EventCallback OnReloadList { get; set; }
    [Parameter] public required ListCalculationMVVM Calculation { get; set; }

    CalculationPostDTO CalculationUpdate = new();
    GetProjectCalcConfigDTO? Config;
    private EditContext? editContext;
    private static readonly CultureInfo SwedishCulture = CultureInfo.GetCultureInfo("sv-SE");
    private List<ListDTO> ResponsibilityUsers { get; set; } = [];

    private int Part { get; set; } = 1;

    private string ActiveKey
    {
        get => Part.ToString();
        set
        {
            if (int.TryParse(value, out var p))
                Part = p;
        }
    }

    private List<NavTabItem> Tabs => new()
    {
        new(){Key = 1.ToString(), Text = AppLoc["calcInfoTab"].Value, Icon = "🧮" },
        new(){Key = 2.ToString(), Text = AppLoc["revenues"].Value, Icon = "💰" },
    };

    private int CalculationIncomeStartYear =>
        CalculationUpdate.StartDate == default
            ? DateTime.Today.Year
            : CalculationUpdate.StartDate.Year;

    private bool IsContentLocked => CalculationUpdate.IsLocked;

    private string CalculationResponsible
    {
        get
        {
            EnsureResponsibleSlot();
            return CalculationUpdate.Responsibles[0];
        }
        set
        {
            EnsureResponsibleSlot();
            CalculationUpdate.Responsibles[0] = value ?? string.Empty;
        }
    }

    private IEnumerable<string> ResponsibilityUserOptions
    {
        get
        {
            var options = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

            foreach (var user in ResponsibilityUsers)
                AddOption(options, user.Name);

            AddOption(options, CalculationResponsible);
            AddOption(options, CalculationUpdate.Inspector);

            return options.OrderBy(x => x);
        }
    }

    private string LockedToggleLabelClass =>
