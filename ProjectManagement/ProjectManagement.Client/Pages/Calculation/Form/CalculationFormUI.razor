            return;
        _statusDropdownOpen = !_statusDropdownOpen;
    }

    private void CloseStatusDropdown() => _statusDropdownOpen = false;

    private void SelectStatus(int statusId)
    {
        CloseStatusDropdown();

        var oldStatusId = CalculationUpdate.StatusId;
        if (statusId == oldStatusId)
            return;

        var selectedStatus = Config?.Statuses.FirstOrDefault(x => x.Id == statusId);
        if (selectedStatus is null)
            return; // status is mandatory — never clear it

        if (CalculationUpdate.IsLocked && !IsAllowedLockedStatus(selectedStatus))
        {
            ResetStatusSelection(oldStatusId);
            return;
        }

        // Any locking status opens the confirm dialog; the status is only applied on confirm.
        if (IsLockingStatus(selectedStatus) &&
            Calculation.Id > 0 &&
            !CalculationUpdate.IsLocked)
        {
            var blockReason = GetApprovalBlockReason();
            if (blockReason is not null)
            {
                _approvalBlockMessage = blockReason;
                ResetStatusSelection(oldStatusId);
                return;
            }

            _approvalBlockMessage = string.Empty;
            _statusBeforeApprovalDialog = oldStatusId;
            _pendingApprovalStatusId = statusId;
            _approvalDialogMessage = string.Empty;
            _showApprovalDialog = true;
            _focusApprovalDialog = true;
            ResetStatusSelection(oldStatusId); // keep UI + model on the previous status until confirmed
            return;
        }

        _approvalBlockMessage = string.Empty;
        CalculationUpdate.StatusId = statusId;
    }

    private void ResetStatusSelection(int? statusId)
    {
        // The custom dropdown reflects CalculationUpdate.StatusId directly, so resetting
        // the model is enough to keep the field, edit model and saved value in sync.
        CalculationUpdate.StatusId = statusId;
    }

    private string? GetApprovalBlockReason()
    {
        if (_isCurrentUserAdmin)
            return null;

        var inspector = CalculationUpdate.Inspector?.Trim();
        var responsible = CalculationUpdate.Responsibles?.ElementAtOrDefault(0)?.Trim();

        if (string.IsNullOrWhiteSpace(inspector) && string.IsNullOrWhiteSpace(responsible))
            return CalcResource.approvalBlockedNoResponsible;

        if (!string.IsNullOrWhiteSpace(inspector))
        {
            return string.Equals(_currentUserDisplayName, inspector, StringComparison.OrdinalIgnoreCase)
                ? null
                : string.Format(CalcResource.approvalBlockedInspectorOnly, inspector);
        }

        return string.Equals(_currentUserDisplayName, responsible, StringComparison.OrdinalIgnoreCase)
            ? null
            : string.Format(CalcResource.approvalBlockedResponsibleOnly, responsible);
    }

    // Every way of dismissing the dialog (Cancel button, X, Escape, click outside) lands
    // here and fully reverts the status change — UI, edit model and the value to be saved.
    private void CancelApprovalDialog()
    {
        if (_isApprovingCalculation)
            return;

        ResetStatusSelection(_statusBeforeApprovalDialog ?? CalculationUpdate.StatusId);
        _pendingApprovalStatusId = null;
        _statusBeforeApprovalDialog = null;
        _approvalDialogMessage = string.Empty;
        _showApprovalDialog = false;
        _focusApprovalDialog = false;
    }

    private void OnApprovalDialogKeyDown(KeyboardEventArgs e)
