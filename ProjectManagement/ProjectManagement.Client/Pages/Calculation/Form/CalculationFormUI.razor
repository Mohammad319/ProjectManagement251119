    protected override Task OnInitializedAsync() => LoadCalculationAsync();

    // Loads (or reloads) the form for the current Calculation.Id. Safe to call again after
    // creating a contract/production calculation so the new calculation is shown in the form.
    private async Task LoadCalculationAsync()
    {
        CalculationUpdate = new CalculationPostDTO();
        ResetEditContext();

        if (CalculationUpdate.Responsibles.Count == 0)
            CalculationUpdate.Responsibles.Add(string.Empty);

        if (Calculation.Id > 0)
        {
            CalculationUpdate = await Repo.Calculation.GetPostAsync(Calculation.Id) ?? new CalculationPostDTO();
        }

        CalculationUpdate.Notes ??= [];
        if (CalculationUpdate.Notes.Count == 0)
            CalculationUpdate.Notes.Add(string.Empty);
        CalculationUpdate.Contacts ??= [];
        CalculationUpdate.Income ??= [];
        CalculationUpdate.Address ??= [];
        await EnsureResponsibilityDefaultsAsync();
        await LoadResponsibilityUsersAsync();

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var authUser = authState.User;
        _currentUserDisplayName = authUser.FindFirst(PMClaimsConst.FullName)?.Value
            ?? authUser.Identity?.Name
            ?? authUser.FindFirst(ClaimTypes.Email)?.Value
            ?? string.Empty;
        _isCurrentUserAdmin = authUser.IsInRole(PMRolesConst.Tenant.Admin);

        if (Calculation.Id == 0)
            await InheritFromProjectAsync();

        Config = await Repo.Calculation.GetConfig(
                CalculationUpdate.ProcurementMethodsId,
                CalculationUpdate.ContractId,
                CalculationUpdate.CompensationId,
                CalculationUpdate.TypeId,
                CalculationUpdate.StatusId
            );

        // Status is mandatory: a new calculation — or legacy data missing a status —
        // falls back to the configured default status (or the first available one).
        if (!CalculationUpdate.StatusId.HasValue)
            CalculationUpdate.StatusId =
                (Config.Statuses.FirstOrDefault(status => status.IsDefault)
                 ?? Config.Statuses.FirstOrDefault())?.Id;

        _originalStatusId = CalculationUpdate.StatusId;
        RecalculateDateFields(DateFieldChanged.EndDate);
        ResetEditContext();
    }

    // Switches the form to a different calculation (e.g. the freshly created contract/
    // production calculation) and reloads its data, keeping the dialog open.
    private async Task LoadCalculationByIdAsync(int id)
    {
        Calculation = new ListCalculationMVVM { Id = id };
        Part = 1;
        await LoadCalculationAsync();
