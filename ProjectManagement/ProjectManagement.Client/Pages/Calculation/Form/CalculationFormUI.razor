@using BlazorMHD.UI.Components.Navigation.Tabs
@using ProjectManagement.Client.Shared.MVVM.Calculation
@using ProjectManagement.Shared.DTO.App
@using ProjectManagement.Shared.DTO.Calculation
@using ProjectManagement.Shared.DTO.General
@using ProjectManagement.Shared.Enums
@using ProjectManagement.Shared.Constant
@using System.Security.Claims
@using System.Globalization
@using ProjectManagement.Shared.Policies
@using BlazorMHD.UI.Core.DesignSystem
@using ProjectManagement.Client.Shared.SharedComponent
@using ProjectManagement.Client.Pages.Project.ProjectPages
@using NavTabItem = BlazorMHD.UI.Core.Navigation.MhdTabItem

@inherits AppComponentBase
@attribute [Authorize(Roles = PMRolesConst.Tenant.AdminManger)]
@inject AuthenticationStateProvider AuthenticationStateProvider

@if (CalculationUpdate != null)
{
    <EditForm id="@DialogFormId"
              @key="editContext"
              class="calculation-form-shell space-y-0"
              EditContext="editContext!"
              OnValidSubmit="async () => await HandleSubmitAsync()">

        <DataAnnotationsValidator />
        <FormValidationSummary />

        @* Sticky tab row *@
        <div class="calculation-form-tabs sticky top-0 z-30 -mx-1 border-b border-slate-200 bg-white/95 px-1 pb-1 pt-0 shadow-sm backdrop-blur dark:border-slate-700 dark:bg-slate-950/95">
            <MhdTabs Items="Tabs"
                     Mode="MhdTabMode.Horizontal"
                     Size="MhdSize.Sm"
                     @bind-ActiveKey="ActiveKey" />
        </div>

        <div class="calculation-form-content">
            @if (Part == 1)
            {
                <div class="relative z-0 pr-1">
                    @* Kalkyl (full). Sedan halva/halva: vänster = Ansvar + Projektplats staplade, höger = Datum. Anteckning (full). *@
                    <div class="flex flex-col gap-3">

                            @* Kalkyl — full bredd *@
                            <section class="rounded-lg border border-slate-200 bg-white p-3 shadow-sm dark:border-slate-700 dark:bg-slate-900">
                                <div class="mb-3 flex items-center justify-between gap-2">
                                    <h3 class="text-sm font-semibold text-slate-800 dark:text-slate-100">@CalcResource.calculation</h3>
                                    @if (CalculationUpdate.Metadata.ImportInfo?.IsImportedCopy == true)
                                    {
                                        <button type="button"
                                                class="rounded-full border border-sky-200 bg-sky-50 px-2 py-0.5 text-[10px] font-semibold text-sky-700 hover:bg-sky-100 dark:border-sky-900 dark:bg-sky-950/40 dark:text-sky-300"
                                                title="Visa importinformation"
                                                @onclick="OpenImportInfoDialog">
                                            Importerad kopia
                                        </button>
                                    }
                                </div>

                                @* Kod (smal) + Namn (bred) *@
                                <div class="mb-3 grid grid-cols-4 gap-3">
                                    <div class="col-span-1">
                                        <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400">@CalcResource.code</label>
                                        <InputText class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 disabled:cursor-not-allowed disabled:bg-slate-100 disabled:text-slate-500 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:disabled:bg-slate-900" @bind-Value="@CalculationUpdate.Code" disabled="@IsContentLocked" />
                                    </div>
                                    <div class="col-span-3">
                                        <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400">@CalcResource.name</label>
                                        <InputText class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 disabled:cursor-not-allowed disabled:bg-slate-100 disabled:text-slate-500 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:disabled:bg-slate-900" @bind-Value="@CalculationUpdate.Name" disabled="@IsContentLocked" />
                                    </div>
                                </div>

                                @* Kalkyltyp + Kalkylroll + Kalkylstatus på samma rad *@
                                <div class="mb-3 grid grid-cols-3 gap-3">
                                    <div>
                                        <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400">@AppLoc["calculationStatus"]</label>
                                        @* Custom dropdown so each status shows its filled status color (a native <option> can't). *@
                                        <div class="relative">
                                            <button type="button"
                                                    @onclick="ToggleStatusDropdown"
                                                    disabled="@IsStatusSelectDisabled"
                                                    class="flex w-full items-center gap-2 rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 disabled:cursor-not-allowed disabled:bg-slate-100 disabled:text-slate-500 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:disabled:bg-slate-900">
                                                <span class="h-2.5 w-2.5 shrink-0 rounded-full ring-1 ring-inset ring-black/10 dark:ring-white/20" style="background-color:@SelectedStatusColor"></span>
                                                <span class="flex-1 truncate text-left @(SelectedStatus is null ? "text-slate-400 dark:text-slate-500" : "")">@(SelectedStatus?.Name ?? "—")</span>
                                                <svg class="h-3 w-3 shrink-0 text-slate-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                                    <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                                                </svg>
                                            </button>
                                            @if (_statusDropdownOpen && Config?.Statuses != null)
                                            {
                                                <div class="fixed inset-0 z-[70]" @onclick="CloseStatusDropdown"></div>
                                                <div class="absolute left-0 top-full z-[90] mt-1 w-full overflow-hidden rounded-xl border border-slate-200 bg-slate-50 shadow-xl dark:border-slate-700 dark:bg-slate-900">
                                                    <div class="mhd-select-scroll max-h-[320px] overflow-y-auto py-1">
                                                        @foreach (var status in AvailableStatuses)
                                                        {
                                                            var statusId = status.Id;
                                                            var isSelectedStatus = status.Id == CalculationUpdate.StatusId;
                                                            <button type="button"
                                                                    class="@(isSelectedStatus ? "flex w-full items-center gap-2 px-3 py-1.5 text-left text-sm font-medium text-sky-700 bg-sky-50 dark:bg-sky-950/40 dark:text-sky-300" : "flex w-full items-center gap-2 px-3 py-1.5 text-left text-sm text-slate-700 transition-colors hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800")"
                                                                    @onclick="() => SelectStatus(statusId)">
                                                                <span class="h-2.5 w-2.5 shrink-0 rounded-full ring-1 ring-inset ring-black/10 dark:ring-white/20" style="background-color:@GetStatusColor(status)"></span>
                                                                <span class="flex-1 truncate">@status.Name</span>
                                                                @if (isSelectedStatus)
                                                                {
                                                                    <svg class="ml-auto h-3.5 w-3.5 shrink-0 text-sky-600 dark:text-sky-400" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
                                                                }
                                                            </button>
                                                        }
                                                    </div>
                                                    @* Soft fade so it's obvious the list continues when it's scrollable. *@
                                                    @if (AvailableStatuses.Count() > 8)
                                                    {
                                                        <div class="pointer-events-none absolute inset-x-0 bottom-0 h-6 rounded-b-xl bg-gradient-to-t from-slate-50 to-transparent dark:from-slate-900"></div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    <div>
                                        <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400">@AppLoc["calculationRole"]</label>
                                        <MhdFormSelect TValue="CalculationRole"
                                                       @bind-Value="CalculationUpdate.CalculationRole"
                                                       Options="CalculationRoleOptions"
                                                       Disabled="@IsContentLocked"
                                                       Title="@AppLoc["calculationRole"]" />
                                    </div>
                                    <div>
                                        <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400">@AppLoc["calculationType"]</label>
                                        @if (CalculationUpdate.IsLocked)
                                        {
                                            <div class="rounded-md border border-amber-200 bg-amber-50 px-2 py-1.5 text-xs text-amber-800 dark:border-amber-900/60 dark:bg-amber-950/30 dark:text-amber-200">
                                                @GetCalculationTypeLabel(CalculationUpdate.CalculationType) @AppLoc["lockedSuffix"]
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="w-full rounded-md border border-slate-300 bg-slate-50 px-2 py-1.5 text-sm text-slate-700 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100">
                                                @GetCalculationTypeLabel(CalculationUpdate.CalculationType)
                                            </div>
                                        }
                                    </div>
                                </div>

                                @if (CalculationUpdate.CalculationRole == CalculationRole.Custom)
                                {
                                    <div class="mb-3">
                                        <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400">@AppLoc["customRoleDescription"]</label>
                                        <InputText class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 disabled:cursor-not-allowed disabled:bg-slate-100 disabled:text-slate-500 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:disabled:bg-slate-900"
                                                   @bind-Value="@CalculationUpdate.CustomCalculationRoleName"
                                                   disabled="@IsContentLocked"
                                                   placeholder="@AppLoc["customRolePlaceholder"]" />
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(_approvalBlockMessage))
                                {
                                    <div class="mb-3 rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-800 dark:border-amber-900/60 dark:bg-amber-950/30 dark:text-amber-300">
                                        @_approvalBlockMessage
                                    </div>
                                }
                                @if (CalculationUpdate.IsLocked)
                                {
                                    <div class="mb-3 text-xs text-amber-700 dark:text-amber-400">
                                        @CalcResource.lockedBecauseApproved
                                    </div>
                                }

                                @* Versionspanel *@
                                <div class="mb-3 rounded-md border border-slate-200 bg-slate-50 px-3 py-2 dark:border-slate-700 dark:bg-slate-950">
                                    @* Allt på en rad oavsett bredd: ingen radbrytning, etiketten kortas av vid behov, knapparna krymper inte. *@
                                    <div class="flex flex-nowrap items-center justify-between gap-2">
                                        <div class="flex min-w-0 items-baseline gap-2 truncate">
                                            <span class="text-sm font-semibold text-slate-800 dark:text-slate-100">V.@CalculationUpdate.VersionNumber.ToString("D2")</span>
                                            <span class="truncate text-xs text-slate-500 dark:text-slate-400">
                                                @(CalculationUpdate.IsCurrentVersion ? AppLoc["currentVersionLabel"].Value : AppLoc["olderVersionLabel"].Value)
                                            </span>
                                        </div>
                                        <div class="flex flex-nowrap items-center gap-2 shrink-0">
                                            @if (CalculationVersions.Count() > 1)
                                            {
                                                <button type="button"
                                                        class="rounded-md border border-slate-300 bg-white px-2 py-1 text-xs font-medium text-slate-700 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
                                                        @onclick="OpenVersionsDialog">
                                                    @AppLoc["showVersions"]
                                                </button>
                                            }
                                            @if (Calculation.Id > 0 && CalculationUpdate.IsCurrentVersion)
                                            {
                                                <button type="button"
                                                        class="rounded-md border border-blue-300 bg-blue-50 px-2 py-1 text-xs font-semibold text-blue-700 transition hover:bg-blue-100 disabled:cursor-not-allowed disabled:opacity-50 dark:border-blue-900/60 dark:bg-blue-950/30 dark:text-blue-300 dark:hover:bg-blue-950/50"
                                                        disabled="@_isCreatingVersion"
                                                        @onclick="CreateNewVersionAsync">
                                                    @AppLoc["newVersionLabel"]
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>

                                @* Moms + vinstchans + arkiverad *@
                                <div class="flex flex-row flex-nowrap items-end gap-2 overflow-x-auto pb-1 max-[430px]:flex-col max-[430px]:items-stretch max-[430px]:overflow-visible">
                                    @* Vinstchans — växer och fyller raden så den tar hela bredden *@
                                    <div class="min-w-[150px] flex-1 max-[430px]:w-full">
                                        <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400"
                                               title="Sannolikhet att vinna">
                                            Vinstchans (@CalculationUpdate.Priority %)
                                        </label>
                                        <input type="range" min="0" max="100" step="1"
                                               class="w-full min-w-0 accent-sky-600 disabled:cursor-not-allowed disabled:opacity-50"
                                               value="@CalculationUpdate.Priority"
                                               disabled="@IsContentLocked"
                                               @oninput="@((args) => CalculationUpdate.Priority = Convert.ToInt16(args.Value))" />
                                    </div>

                                    <div class="w-[68px] shrink-0 max-[430px]:w-full">
                                        <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400">
                                            @AppLoc["vatPercentLabel"]
                                        </label>
                                        <InputNumber class="w-full min-w-0 rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 disabled:cursor-not-allowed disabled:bg-slate-100 disabled:text-slate-500 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:disabled:bg-slate-900"
                                                     @bind-Value="@CalculationUpdate.Tax"
                                                     disabled="@IsContentLocked" />
                                    </div>

                                    <div class="shrink-0 max-[430px]:w-full">
                                        <label class="@LockedToggleLabelClass">
                                            <input type="checkbox"
                                                   class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-500"
                                                   checked="@(CalculationUpdate.IsArchived)"
                                                   disabled="@IsContentLocked"
                                                   @onchange="e => CalculationUpdate.IsArchived = (bool)(e.Value ?? false)" />
                                            <span class="select-none">
                                                @AppLoc["archived"]
                                            </span>
                                        </label>
                                    </div>

                                    @if (Calculation.Id == 0 || CalculationUpdate.IsPrivate)
                                    {
                                        <div class="shrink-0 max-[430px]:w-full">
                                            <label class="@LockedToggleLabelClass">
                                                <InputCheckbox class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-500"
                                                               @bind-Value="@CalculationUpdate.IsPrivate"
                                                               disabled="@IsContentLocked" />
                                                <span class="select-none">
                                                    @ResourceApp._private
                                                </span>
                                            </label>
                                        </div>
                                    }
                                </div>

                            </section>

                            @* Vänster: Ansvar överst, Projektplats under. Höger: Datum. Sida vid sida utom på mobil. *@
                            <div class="grid grid-cols-2 items-start gap-3 max-sm:grid-cols-1">

                                @* Vänster kolumn — Ansvar + Projektplats staplade *@
                                <div class="flex flex-col gap-3">

                                @* Ansvar *@
                                <section class="rounded-lg border border-slate-200 bg-white p-3 shadow-sm dark:border-slate-700 dark:bg-slate-900">
                                    <h3 class="mb-3 text-sm font-semibold text-slate-800 dark:text-slate-100">@AppLoc["responsibility"]</h3>
                                    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                                        <div>
                                            <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400">@AppLoc["calculationResponsible"]</label>
                                            <MhdFormSelect TValue="string"
                                                           @bind-Value="CalculationResponsible"
                                                           Options="ResponsibilityUserSelectOptions"
                                                           Placeholder="Välj ansvarig"
                                                           Disabled="@CalculationUpdate.IsLocked"
                                                           Title="@AppLoc["calculationResponsible"]" />
                                        </div>
                                        <div>
                                            <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400">@AppLoc["reviewer"]</label>
                                            <MhdFormSelect TValue="string"
                                                           @bind-Value="CalculationUpdate.Inspector"
                                                           Options="ResponsibilityUserSelectOptions"
                                                           Placeholder="Ingen granskare"
                                                           Disabled="@CalculationUpdate.IsLocked"
                                                           Title="@AppLoc["reviewer"]" />
                                        </div>
                                        @if (CalculationUpdate.IsLocked)
                                        {
                                            <div class="sm:col-span-2 rounded-md border border-emerald-200 bg-emerald-50 px-3 py-2.5 text-xs dark:border-emerald-900/60 dark:bg-emerald-950/30">
                                                <div class="mb-1.5 inline-flex items-center gap-1.5 rounded-full bg-emerald-100 px-2.5 py-0.5 font-semibold text-emerald-800 dark:bg-emerald-900/50 dark:text-emerald-200">
                                                    <svg class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25z" />
                                                    </svg>
                                                    @CalcResource.lockedAndApproved
                                                </div>
                                                <p class="mb-1.5 text-emerald-800 dark:text-emerald-200">@CalcResource.lockedBecauseApproved</p>
                                                <div class="grid grid-cols-1 gap-0.5 text-emerald-700 dark:text-emerald-300 sm:grid-cols-2">
                                                    <span>@CalcResource.approvedBy @(string.IsNullOrWhiteSpace(CalculationUpdate.ApprovedByName) ? CalcResource.unknownUser : CalculationUpdate.ApprovedByName)</span>
                                                    <span>@CalcResource.approvedDate @FormatDateTime(CalculationUpdate.ApprovedAtUtc)</span>
                                                </div>
                                            </div>
                                        }
                                        @if (CanCreateContractCalculation || CanCreateProductionCalculation)
                                        {
                                            <div class="sm:col-span-2 flex flex-wrap gap-2">
                                                @if (CanCreateContractCalculation)
                                                {
                                                    <button type="button"
                                                            class="rounded-lg border border-sky-500 bg-sky-600 px-3 py-1.5 text-sm font-semibold text-white transition hover:bg-sky-700 dark:border-sky-500 dark:bg-sky-500 dark:hover:bg-sky-600"
                                                            @onclick="OpenContractDialog">
                                                        @AppLoc["createContractCalculation"]
                                                    </button>
                                                }
                                                @if (CanCreateProductionCalculation)
                                                {
                                                    <button type="button"
                                                            class="rounded-lg border border-emerald-500 bg-emerald-600 px-3 py-1.5 text-sm font-semibold text-white transition hover:bg-emerald-700 dark:border-emerald-500 dark:bg-emerald-500 dark:hover:bg-emerald-600"
                                                            @onclick="OpenProductionDialog">
                                                        @AppLoc["createProductionCalculation"]
                                                    </button>
                                                }
                                            </div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(_createBlockMessage))
                                        {
                                            <div class="sm:col-span-2 rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-800 dark:border-amber-900/60 dark:bg-amber-950/30 dark:text-amber-300">
                                                @_createBlockMessage
                                            </div>
                                        }
                                        @if (_createdCalcId.HasValue)
                                        {
                                            <div class="sm:col-span-2 flex flex-col gap-2 rounded-md border border-emerald-200 bg-emerald-50 px-3 py-2.5 dark:border-emerald-900/60 dark:bg-emerald-950/30 sm:flex-row sm:items-center sm:justify-between">
                                                <div class="flex items-start gap-1.5 text-xs text-emerald-800 dark:text-emerald-200">
                                                    <svg class="mt-0.5 h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                                    </svg>
                                                    <span>@AppLoc[_postCreateInfoKey]</span>
                                                </div>
                                                <button type="button"
                                                        class="shrink-0 rounded-lg border border-emerald-500 bg-emerald-600 px-3 py-1.5 text-sm font-semibold text-white transition hover:bg-emerald-700 dark:border-emerald-500 dark:bg-emerald-500 dark:hover:bg-emerald-600"
                                                        @onclick="OpenCreatedCalculationAsync">
                                                    @AppLoc["openCalculation"]
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </section>

                                @* Projektplats *@
                                <section class="rounded-lg border border-slate-200 bg-white p-3 shadow-sm dark:border-slate-700 dark:bg-slate-900">
                                    <h3 class="mb-3 text-sm font-semibold text-slate-800 dark:text-slate-100">@AppLoc["projectLocation"]</h3>
                                    <div class="flex flex-col gap-3">
                                        <div>
                                            <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400">@AppLoc["address"]</label>
                                            <InputText class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 disabled:cursor-not-allowed disabled:bg-slate-100 disabled:text-slate-500 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:disabled:bg-slate-900"
                                                       placeholder="@AppLoc["addressPlaceholder"]"
                                                       disabled="@IsContentLocked"
                                                       @bind-Value="@CalcMainAddress.Street" />
                                        </div>
                                        <div>
                                            <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400">@AppLoc["geoLocation"]</label>
                                            <InputText class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 disabled:cursor-not-allowed disabled:bg-slate-100 disabled:text-slate-500 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:disabled:bg-slate-900"
                                                       placeholder="@AppLoc["geoLocationPlaceholder"]"
                                                       disabled="@IsContentLocked"
                                                       @bind-Value="@CalculationUpdate.Maps" />
                                        </div>
                                    </div>
                                </section>

                                </div>@* end vänster kolumn (Ansvar + Projektplats) *@

                                @* Datum — höger kolumn, halva bredden bredvid Ansvar/Projektplats *@
                                <section class="rounded-lg border border-slate-200 bg-white p-3 shadow-sm dark:border-slate-700 dark:bg-slate-900">
                                    <h3 class="mb-3 text-sm font-semibold text-slate-800 dark:text-slate-100">@ResourceApp.date</h3>
                                    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 [&>*]:min-w-0 [&_input]:min-w-0 [&_select]:min-w-0 [&_input]:w-full [&_select]:w-full">
                                        <div>
                                            <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400"
                                                   title="Sista dag för frågor och svar">Frågor/svar senast</label>
                                            <InputDate class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 disabled:cursor-not-allowed disabled:bg-slate-100 disabled:text-slate-500 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:disabled:bg-slate-900" @bind-Value="@CalculationUpdate.TenderQA" disabled="@IsContentLocked" />
                                            @if (CalculationUpdate.TenderQA != default && CalculationUpdate.TenderQA < DateTime.Today)
                                            {
                                                <p class="mt-0.5 text-[11px] text-amber-600 dark:text-amber-400">@AppLoc["qaDeadlinePassed"]</p>
                                            }
                                        </div>
                                        <div>
                                            <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400">@CalcResource.tenderDeadline</label>
                                            <InputDate class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 disabled:cursor-not-allowed disabled:bg-slate-100 disabled:text-slate-500 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:disabled:bg-slate-900" @bind-Value="@CalculationUpdate.TenderDeadline" disabled="@IsContentLocked" />
                                            @if (CalculationUpdate.TenderDeadline != default && CalculationUpdate.TenderDeadline < DateTime.Today)
                                            {
                                                <p class="mt-0.5 text-[11px] text-amber-600 dark:text-amber-400">@AppLoc["tenderDeadlinePassed"]</p>
                                            }
                                        </div>
                                        <div>
                                            <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400">@CalcResource.startDate</label>
                                            <InputDate class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 disabled:cursor-not-allowed disabled:bg-slate-100 disabled:text-slate-500 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:disabled:bg-slate-900"
                                                       @bind-Value="@CalculationUpdate.StartDate"
                                                       disabled="@IsContentLocked"
                                                       @bind-Value:after="OnStartDateChanged" />
                                            @if (CalculationUpdate.StartDate != default && CalculationUpdate.StartDate < DateTime.Today)
                                            {
                                                <p class="mt-0.5 text-[11px] text-amber-600 dark:text-amber-400">@AppLoc["startDatePassed"]</p>
                                            }
                                        </div>
                                        <div>
                                            <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400">@CalcResource.endDate</label>
                                            <InputDate class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 disabled:cursor-not-allowed disabled:bg-slate-100 disabled:text-slate-500 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:disabled:bg-slate-900"
                                                       @bind-Value="@CalculationUpdate.EndDate"
                                                       disabled="@IsContentLocked"
                                                       @bind-Value:after="OnEndDateChanged" />
                                            @if (CalculationUpdate.EndDate != default && CalculationUpdate.StartDate != default && CalculationUpdate.EndDate < CalculationUpdate.StartDate)
                                            {
                                                <p class="mt-0.5 text-[11px] text-red-600 dark:text-red-400">@AppLoc["endBeforeStartError"]</p>
                                            }
                                        </div>
                                        <div class="sm:col-span-2">
                                            <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400">
                                                @AppLoc["projectDurationMonths"]
                                                @if (CalculationUpdate.StartDate != default && CalculationUpdate.EndDate != default)
                                                {
                                                    <span class="ml-1 text-slate-400">@AppLoc["calculatedAutomatically"]</span>
                                                }
                                            </label>
                                            <input class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 disabled:cursor-not-allowed disabled:bg-slate-100 disabled:text-slate-500 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:disabled:bg-slate-900"
                                                   value="@FormatMonthsInput(CalculationUpdate.TimeMonth)"
                                                   disabled="@IsContentLocked"
                                                   @onchange="OnTimeMonthInputChanged" />
                                            @if (CalculationUpdate.StartDate != default && CalculationUpdate.EndDate == default && CalculationUpdate.TimeMonth > 0)
                                            {
                                                <p class="mt-0.5 text-[11px] text-sky-600 dark:text-sky-400">@AppLoc["endDateFromStartMonths"]</p>
                                            }
