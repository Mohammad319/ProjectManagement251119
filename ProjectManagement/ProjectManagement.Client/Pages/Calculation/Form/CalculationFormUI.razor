@using BlazorMHD.UI.Components.Navigation.Tabs
@using ProjectManagement.Client.Shared.MVVM.Calculation
@using ProjectManagement.Shared.DTO.App
@using ProjectManagement.Shared.DTO.Calculation
@using ProjectManagement.Shared.DTO.General
@using ProjectManagement.Shared.Enums
@using ProjectManagement.Shared.Constant
@using System.Security.Claims
@using BlazorMHD.UI.Core.DesignSystem
@using NavTabItem = BlazorMHD.UI.Core.Navigation.TabItem

@inherits AppComponentBase
@attribute [Authorize(Roles = PMRolesConst.Tenant.AdminManger)]
@inject AuthenticationStateProvider AuthenticationStateProvider

@if (CalculationUpdate != null)
{
    <EditForm id="@DialogFormId"
              @key="editContext"
              class="space-y-0"
              EditContext="editContext!"
              OnValidSubmit="async () => await HandleSubmitAsync()">

        <DataAnnotationsValidator />
        <FormValidationSummary />

        @* Sticky tab row *@
        <div class="sticky top-0 z-10 -mx-1 border-b border-slate-200 bg-white pb-0 pt-0 dark:border-slate-700 dark:bg-slate-950">
            <MhdTabs Items="Tabs"
                     Mode="MhdTabMode.Horizontal"
                     Size="MhdSize.Sm"
                     @bind-ActiveKey="ActiveKey" />
        </div>

        @if (Part == 1)
        {
            <div class="mt-3 pr-1">
                <div class="grid grid-cols-1 gap-3 xl:grid-cols-2">

                    @* ── Vänster kolumn: Kalkyl + Ansvar + Projektplats + Anteckning ── *@
                    <div class="flex flex-col gap-3">

                        @* Kalkyl *@
                        <section class="rounded-lg border border-slate-200 bg-white p-3 shadow-sm dark:border-slate-700 dark:bg-slate-900">
                            <h3 class="mb-3 text-sm font-semibold text-slate-800 dark:text-slate-100">@CalcResource.calculation</h3>

                            @* Kod (smal) + Namn (bred) *@
                            <div class="mb-3 grid grid-cols-4 gap-3">
                                <div class="col-span-1">
                                    <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400">@CalcResource.code</label>
                                    <InputText class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100" @bind-Value="@CalculationUpdate.Code" />
                                </div>
                                <div class="col-span-3">
                                    <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400">@CalcResource.name</label>
                                    <InputText class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100" @bind-Value="@CalculationUpdate.Name" />
                                </div>
                            </div>

                            @* Kalkyltyp + Kalkylroll + Kalkylstatus på samma rad *@
                            <div class="mb-3 grid grid-cols-3 gap-3">
                                <div>
                                    <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400">@AppLoc["calculationStatus"]</label>
                                    <select value="@CalculationUpdate.StatusId"
                                            @onchange="OnStatusChanged"
                                            class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 disabled:bg-slate-100 disabled:text-slate-500 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:disabled:bg-slate-900"
                                            disabled="@CalculationUpdate.IsLocked">
                                        <option></option>
                                        @if (Config?.Statuses != null)
                                        {
                                            foreach (var status in Config.Statuses)
                                            {
                                                <option value="@status.Id">@status.Name</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div>
                                    <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400">@AppLoc["calculationRole"]</label>
                                    <InputSelect class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100"
                                                 @bind-Value="@CalculationUpdate.CalculationRole">
                                        @foreach (var role in CalculationRoles)
                                        {
                                            <option value="@role">@GetCalculationRoleLabel(role)</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div>
                                    <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400">@AppLoc["calculationType"]</label>
                                    @if (CalculationUpdate.IsLocked)
                                    {
                                        <div class="rounded-md border border-amber-200 bg-amber-50 px-2 py-1.5 text-xs text-amber-800 dark:border-amber-900/60 dark:bg-amber-950/30 dark:text-amber-200">
                                            @GetCalculationTypeLabel(CalculationUpdate.CalculationType) @AppLoc["lockedSuffix"]
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="w-full rounded-md border border-slate-300 bg-slate-50 px-2 py-1.5 text-sm text-slate-700 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100">
                                            @GetCalculationTypeLabel(CalculationUpdate.CalculationType)
                                        </div>
                                    }
                                </div>
                            </div>

                            @if (CalculationUpdate.CalculationRole == CalculationRole.Custom)
                            {
                                <div class="mb-3">
                                    <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400">@AppLoc["customRoleDescription"]</label>
                                    <InputText class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100"
                                               @bind-Value="@CalculationUpdate.CustomCalculationRoleName"
                                               placeholder="@AppLoc["customRolePlaceholder"]" />
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(_approvalBlockMessage))
                            {
                                <div class="mb-3 rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-800 dark:border-amber-900/60 dark:bg-amber-950/30 dark:text-amber-300">
                                    @_approvalBlockMessage
                                </div>
                            }
                            @if (CalculationUpdate.IsLocked)
                            {
                                <div class="mb-3 text-xs text-amber-700 dark:text-amber-400">
                                    @CalcResource.lockedBecauseApproved
                                </div>
                            }

                            @* Versionspanel *@
                            <div class="mb-3 rounded-md border border-slate-200 bg-slate-50 px-3 py-2 dark:border-slate-700 dark:bg-slate-950">
                                <div class="flex flex-wrap items-center justify-between gap-2">
                                    <div>
                                        <span class="text-sm font-semibold text-slate-800 dark:text-slate-100">V.@CalculationUpdate.VersionNumber.ToString("D2")</span>
                                        <span class="ml-2 text-xs text-slate-500 dark:text-slate-400">
                                            @(CalculationUpdate.IsCurrentVersion ? AppLoc["currentVersionLabel"].Value : AppLoc["olderVersionLabel"].Value)
                                        </span>
                                    </div>
                                    <div class="flex flex-wrap items-center gap-2">
                                        @if (CalculationVersions.Count() > 1)
                                        {
                                            <button type="button"
                                                    class="rounded-md border border-slate-300 bg-white px-2 py-1 text-xs font-medium text-slate-700 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
                                                    @onclick="OpenVersionsDialog">
                                                @AppLoc["showVersions"]
                                            </button>
                                        }
                                        @if (Calculation.Id > 0 && CalculationUpdate.IsCurrentVersion)
                                        {
                                            <button type="button"
                                                    class="rounded-md border border-blue-300 bg-blue-50 px-2 py-1 text-xs font-semibold text-blue-700 transition hover:bg-blue-100 disabled:cursor-not-allowed disabled:opacity-50 dark:border-blue-900/60 dark:bg-blue-950/30 dark:text-blue-300 dark:hover:bg-blue-950/50"
                                                    disabled="@_isCreatingVersion"
                                                    @onclick="CreateNewVersionAsync">
                                                @AppLoc["newVersionLabel"]
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>

                            @* Moms + vinstchans + arkiverad *@
                            <div class="grid grid-cols-3 gap-3 items-end">
                      
                                <div>
                                    <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400"
                                           title="Sannolikhet att vinna">
                                        Vinstchans (@CalculationUpdate.Priority %)
                                    </label>
                                    <input type="range" min="0" max="100" step="1"
                                           class="w-full accent-sky-600"
                                           value="@CalculationUpdate.Priority"
                                           @oninput="@((args) => CalculationUpdate.Priority = Convert.ToInt16(args.Value))" />
                                </div>
                                <div>
                                    <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400">@AppLoc["vatPercentLabel"]</label>
                                    <InputNumber class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100" @bind-Value="@CalculationUpdate.Tax" />
                                </div>
                                <div class="flex flex-col gap-1.5">
                                    <label class="inline-flex cursor-pointer items-center gap-2 rounded-md border border-slate-200 px-2.5 py-1.5 transition hover:bg-slate-50 dark:border-slate-700 dark:hover:bg-slate-800">
                                        <input type="checkbox"
                                               class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 dark:border-slate-500"
                                               checked="@(CalculationUpdate.IsArchived)"
                                               @onchange="e => CalculationUpdate.IsArchived = (bool)(e.Value ?? false)" />
                                        <span class="select-none text-sm text-slate-700 dark:text-slate-300">@AppLoc["archived"]</span>
                                    </label>
                                    @if (Calculation.Id == 0 || CalculationUpdate.IsPrivate)
                                    {
                                        <label class="inline-flex cursor-pointer items-center gap-2 rounded-md border border-slate-200 px-2.5 py-1.5 transition hover:bg-slate-50 dark:border-slate-700 dark:hover:bg-slate-800">
                                            <InputCheckbox class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 dark:border-slate-500" @bind-Value="@CalculationUpdate.IsPrivate" />
                                            <span class="select-none text-sm text-slate-700 dark:text-slate-300">@ResourceApp._private</span>
                                        </label>
                                    }
                                </div>
                            </div>
                        </section>

                        @* Ansvar + Projektplats ── sida vid sida utom på mobil *@
                        <div class="grid grid-cols-2 gap-3 max-sm:grid-cols-1">

                        @* Ansvar *@
                        <section class="rounded-lg border border-slate-200 bg-white p-3 shadow-sm dark:border-slate-700 dark:bg-slate-900">
                            <h3 class="mb-3 text-sm font-semibold text-slate-800 dark:text-slate-100">@AppLoc["responsibility"]</h3>
                            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                                <div>
                                    <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400">@AppLoc["calculationResponsible"]</label>
                                    <InputText class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 disabled:bg-slate-100 disabled:text-slate-500 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:disabled:bg-slate-900"
                                               @bind-Value="@CalculationUpdate.Responsibles[0]"
                                               disabled="@CalculationUpdate.IsLocked" />
                                </div>
                                <div>
                                    <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400">@AppLoc["reviewer"]</label>
                                    <InputText class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 disabled:bg-slate-100 disabled:text-slate-500 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:disabled:bg-slate-900"
                                               @bind-Value="@CalculationUpdate.Inspector"
                                               disabled="@CalculationUpdate.IsLocked" />
                                </div>
                                @if (CalculationUpdate.IsLocked)
                                {
                                    <div class="sm:col-span-2 rounded-md border border-emerald-200 bg-emerald-50 px-3 py-2.5 text-xs dark:border-emerald-900/60 dark:bg-emerald-950/30">
                                        <div class="mb-1.5 inline-flex items-center gap-1.5 rounded-full bg-emerald-100 px-2.5 py-0.5 font-semibold text-emerald-800 dark:bg-emerald-900/50 dark:text-emerald-200">
                                            <svg class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25z" />
                                            </svg>
                                            @CalcResource.lockedAndApproved
                                        </div>
                                        <p class="mb-1.5 text-emerald-800 dark:text-emerald-200">@CalcResource.lockedBecauseApproved</p>
                                        <div class="grid grid-cols-1 gap-0.5 text-emerald-700 dark:text-emerald-300 sm:grid-cols-2">
                                            <span>@CalcResource.approvedBy @(string.IsNullOrWhiteSpace(CalculationUpdate.ApprovedByName) ? CalcResource.unknownUser : CalculationUpdate.ApprovedByName)</span>
                                            <span>@CalcResource.approvedDate @FormatDateTime(CalculationUpdate.ApprovedAtUtc)</span>
                                        </div>
                                    </div>
                                }
                                @if (CanCreateContractCalculation || CanCreateProductionCalculation)
                                {
                                    <div class="sm:col-span-2 flex flex-wrap gap-2">
                                        @if (CanCreateContractCalculation)
                                        {
                                            <button type="button"
                                                    class="rounded-lg border border-sky-500 bg-sky-600 px-3 py-1.5 text-sm font-semibold text-white transition hover:bg-sky-700 dark:border-sky-500 dark:bg-sky-500 dark:hover:bg-sky-600"
                                                    @onclick="OpenContractDialog">
                                                @AppLoc["createContractCalculation"]
                                            </button>
                                        }
                                        @if (CanCreateProductionCalculation)
                                        {
                                            <button type="button"
                                                    class="rounded-lg border border-emerald-500 bg-emerald-600 px-3 py-1.5 text-sm font-semibold text-white transition hover:bg-emerald-700 dark:border-emerald-500 dark:bg-emerald-500 dark:hover:bg-emerald-600"
                                                    @onclick="OpenProductionDialog">
                                                @AppLoc["createProductionCalculation"]
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        </section>

                        @* Projektplats *@
                        <section class="rounded-lg border border-slate-200 bg-white p-3 shadow-sm dark:border-slate-700 dark:bg-slate-900">
                            <h3 class="mb-3 text-sm font-semibold text-slate-800 dark:text-slate-100">@AppLoc["projectLocation"]</h3>
                            <div class="flex flex-col gap-3">
                                <div>
                                    <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400">@AppLoc["address"]</label>
                                    <InputText class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100"
                                               placeholder="@AppLoc["addressPlaceholder"]"
                                               @bind-Value="@CalcMainAddress.Street" />
                                </div>
                                <div>
                                    <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400">@AppLoc["geoLocation"]</label>
                                    <InputText class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100"
                                               placeholder="@AppLoc["geoLocationPlaceholder"]"
                                               @bind-Value="@CalculationUpdate.Maps" />
                                </div>
                            </div>
                        </section>

                        </div>@* end Ansvar + Projektplats *@

                        @* Anteckning *@
                        <section class="rounded-lg border border-slate-200 bg-white p-3 shadow-sm dark:border-slate-700 dark:bg-slate-900">
                            <h3 class="mb-3 text-sm font-semibold text-slate-800 dark:text-slate-100">@AppLoc["note"]</h3>
                            @if (CalculationUpdate.Notes == null || CalculationUpdate.Notes.Count == 0)
                            {
                                <p class="text-xs italic text-slate-400 dark:text-slate-500">@AppLoc["noNotesYet"]</p>
                            }
                            else
                            {
                                <div class="flex flex-col gap-2">
                                    @for (int _ni = 0; _ni < CalculationUpdate.Notes.Count; _ni++)
                                    {
                                        var noteIdx = _ni;
                                        <div class="relative">
                                            <textarea class="min-h-20 w-full resize-y rounded-md border border-slate-300 bg-white px-2 py-1.5 pr-7 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100"
                                                      placeholder="@AppLoc["notePlaceholder"]"
                                                      @bind="CalculationUpdate.Notes[noteIdx]">
                                            </textarea>
                                            @if (CalculationUpdate.Notes.Count > 1)
                                            {
                                                <button type="button"
                                                        title="@AppLoc["deleteNote"]"
                                                        class="absolute right-1.5 top-1.5 rounded p-0.5 text-slate-400 transition hover:bg-red-50 hover:text-red-500 dark:hover:bg-red-950/30 dark:hover:text-red-400"
                                                        @onclick="() => RemoveCalcNote(noteIdx)">
                                                    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                                                    </svg>
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            <button type="button"
                                    class="mt-2 flex items-center gap-1 rounded-md border border-dashed border-slate-300 px-2.5 py-1.5 text-xs font-medium text-slate-500 transition hover:border-sky-400 hover:text-sky-600 dark:border-slate-600 dark:text-slate-400 dark:hover:border-sky-500 dark:hover:text-sky-400"
                                    @onclick="AddCalcNote">
                                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                                </svg>
                                @CalcResource.addNote
                            </button>
                        </section>

                    </div>

                    @* ── Höger kolumn: Datum ────────────────────────────── *@
                    <div class="flex flex-col gap-3">

                        @* Datum *@
                        <section class="rounded-lg border border-slate-200 bg-white p-3 shadow-sm dark:border-slate-700 dark:bg-slate-900">
                            <h3 class="mb-3 text-sm font-semibold text-slate-800 dark:text-slate-100">@ResourceApp.date</h3>
                            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                                <div>
                                    <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400"
                                           title="Sista dag för frågor och svar">Frågor/svar senast</label>
                                    <InputDate class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100" @bind-Value="@CalculationUpdate.TenderQA" />
                                    @if (CalculationUpdate.TenderQA != default && CalculationUpdate.TenderQA < DateTime.Today)
                                    {
                                        <p class="mt-0.5 text-[11px] text-amber-600 dark:text-amber-400">@AppLoc["qaDeadlinePassed"]</p>
                                    }
                                </div>
                                <div>
                                    <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400">@CalcResource.tenderDeadline</label>
                                    <InputDate class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100" @bind-Value="@CalculationUpdate.TenderDeadline" />
                                    @if (CalculationUpdate.TenderDeadline != default && CalculationUpdate.TenderDeadline < DateTime.Today)
                                    {
                                        <p class="mt-0.5 text-[11px] text-amber-600 dark:text-amber-400">@AppLoc["tenderDeadlinePassed"]</p>
                                    }
                                </div>
                                <div>
                                    <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400">@CalcResource.startDate</label>
                                    <InputDate class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100"
                                               @bind-Value="@CalculationUpdate.StartDate"
                                               @bind-Value:after="OnStartDateChanged" />
                                    @if (CalculationUpdate.StartDate != default && CalculationUpdate.StartDate < DateTime.Today)
                                    {
                                        <p class="mt-0.5 text-[11px] text-amber-600 dark:text-amber-400">@AppLoc["startDatePassed"]</p>
                                    }
                                </div>
                                <div>
                                    <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400">@CalcResource.endDate</label>
                                    <InputDate class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100"
                                               @bind-Value="@CalculationUpdate.EndDate"
                                               @bind-Value:after="OnEndDateChanged" />
                                    @if (CalculationUpdate.EndDate != default && CalculationUpdate.StartDate != default && CalculationUpdate.EndDate < CalculationUpdate.StartDate)
                                    {
                                        <p class="mt-0.5 text-[11px] text-red-600 dark:text-red-400">@AppLoc["endBeforeStartError"]</p>
                                    }
                                </div>
                                <div class="sm:col-span-2">
                                    <label class="mb-0.5 block text-xs font-medium text-slate-600 dark:text-slate-400">
                                        @AppLoc["projectDurationMonths"]
                                        @if (CalculationUpdate.StartDate != default && CalculationUpdate.EndDate != default)
                                        {
                                            <span class="ml-1 text-slate-400">@AppLoc["calculatedAutomatically"]</span>
                                        }
                                    </label>
                                    <InputNumber class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100"
                                                 @bind-Value="@CalculationUpdate.TimeMonth"
                                                 @bind-Value:after="OnTimeMonthChanged" />
                                    @if (CalculationUpdate.StartDate != default && CalculationUpdate.EndDate == default && CalculationUpdate.TimeMonth > 0)
                                    {
