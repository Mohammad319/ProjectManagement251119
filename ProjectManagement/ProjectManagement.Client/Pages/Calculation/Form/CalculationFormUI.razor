    async Task HandleSubmitAsync(bool keepOpen = false)
    {
        if (btnSubmitDisabled)
            return;

        if (CalculationUpdate.IsLocked && !HasAllowedLockedStatusChange)
        {
            // The calculation is locked and nothing changeable remains. Show a clear,
            // specific reason instead of the generic "an unexpected error occurred" toast.
            MHD.MessageOk(
                CalcResource.calculation,
                "Kalkylen är låst och kan inte ändras.",
                BlazorMHD.UI.Core.DesignSystem.MhdState.Warning);
            return;
        }

        btnSubmitDisabled = true;
        var shouldClose = true;
        NormalizeResponsibilityFields();

        try
        {
            if (Calculation.Id > 0)
            {
                if (await Repo.Calculation.UpdateAsync(CalculationUpdate, Calculation.Id))
                {
                    MHD.Notifications(ToastType.Update, true);
                    PropertyCopier.CopyPropertiesTo(CalculationUpdate, Calculation);
                    _originalStatusId = CalculationUpdate.StatusId;
                }

                if (keepOpen)
                {
                    // Refresh the parent list/tree and reload the form so the locked state
                    // (read-only fields, "Låst & godkänd", next-step buttons) is shown.
                    await OnReloadList.InvokeAsync();
                    btnSubmitDisabled = false;
                    await LoadCalculationAsync();
                    StateHasChanged();
                    return;
                }

                await Callback.InvokeAsync(Calculation);
            }
            else
            {
                var projectId = Folder.State.ProjectSelected?.Id;
                if (projectId is null)
                {
                    shouldClose = false;
                    MHD.Notifications(ToastType.Info);
                    return;
                }

                Calculation.Id = await Repo.Calculation.CreateAsync(
                    projectId.Value,
                    CalculationUpdate
                );

                PropertyCopier.CopyPropertiesTo(CalculationUpdate, Calculation);
                MHD.Notifications(ToastType.Add, true);

                await Callback.InvokeAsync(Calculation);
            }
        }
        catch (Exception ex)
        {
            MHD.Notifications(ToastType.Update, false);
            _ = ClientLog.ErrorAsync("CalculationForm submit failed", ex: ex);
        }
        finally
        {
            if (!shouldClose)
                btnSubmitDisabled = false;
        }

        await Callback.InvokeAsync(null);
    }

    private void OpenImportInfoDialog()
    {
        var info = CalculationUpdate.Metadata.ImportInfo;
        if (info is null)
            return;

        Modal.ShowComponent<CalculationImportInfoDialog>(
            "Importinformation",
            new Dictionary<string, object>
            {
                [nameof(CalculationImportInfoDialog.Info)] = info
            },
            BlazorMHD.UI.Core.Services.MhdDialogSize.Large);
    }

    private void NormalizeResponsibilityFields()
    {
        EnsureResponsibleSlot();
        CalculationResponsible = CalculationResponsible.Trim();
        CalculationUpdate.Inspector = CalculationUpdate.Inspector?.Trim() ?? string.Empty;
    }

    private static void AddOption(HashSet<string> options, string? value)
    {
        if (!string.IsNullOrWhiteSpace(value))
            options.Add(value.Trim());
    }
}
