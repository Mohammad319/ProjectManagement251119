@code {
    public const string DialogFormId = "calcForm";
    bool btnSubmitDisabled = false;
    private bool _showContractDialog;
    private bool _isCreatingContractCalculation;
    private string _contractDialogMessage = string.Empty;
    private bool _showProductionDialog;
    private bool _isCreatingProductionCalculation;
    private string _productionDialogMessage = string.Empty;
    private bool _showVersionsDialog;
    private bool _isCreatingVersion;
    private string _versionDialogMessage = string.Empty;
    private bool _showApprovalDialog;
    private bool _isApprovingCalculation;
    private int? _pendingApprovalStatusId;
    private string _approvalDialogMessage = string.Empty;
    private string _approvalBlockMessage = string.Empty;
    private string _currentUserDisplayName = string.Empty;
    private bool _isCurrentUserAdmin;

    [Parameter] public EventCallback<ListCalculationMVVM?> Callback { get; set; }
    [Parameter] public required ListCalculationMVVM Calculation { get; set; }

    CalculationPostDTO CalculationUpdate = new();
    GetProjectCalcConfigDTO? Config;
    private EditContext? editContext;

    private int Part { get; set; } = 1;

    private string ActiveKey
    {
        get => Part.ToString();
        set
        {
            if (int.TryParse(value, out var p))
                Part = p;
        }
    }

    private List<NavTabItem> Tabs => new()
    {
        new(){Key = 1.ToString(), Text = AppLoc["calcInfoTab"].Value, Icon = "🧮" },
        new(){Key = 2.ToString(), Text = AppLoc["revenues"].Value, Icon = "💰" },
    };

    private int CalculationIncomeStartYear =>
        CalculationUpdate.StartDate == default
            ? DateTime.Today.Year
            : CalculationUpdate.StartDate.Year;

    private string GetCalculationTypeLabel(CalculationVersionType type) => type switch
    {
        CalculationVersionType.Production => AppLoc["productionCalculation"],
        CalculationVersionType.Contract   => AppLoc["contractCalculation"],
        _                                 => AppLoc["tenderCalculation"]
    };

    private static readonly CalculationRole[] CalculationRoles =
    [
        CalculationRole.MainBid,
        CalculationRole.SubObject,
        CalculationRole.Option,
        CalculationRole.ChangeOrder,
        CalculationRole.InternalObject,
        CalculationRole.Custom
    ];

    private string GetCalculationRoleLabel(CalculationRole role) => role switch
    {
        CalculationRole.MainBid => AppLoc["calcRoleMainBid"].Value,
        CalculationRole.SubObject => AppLoc["calcRoleSubObject"].Value,
        CalculationRole.Option => AppLoc["calcRoleOption"].Value,
        CalculationRole.ChangeOrder => AppLoc["calcRoleChangeOrder"].Value,
        CalculationRole.InternalObject => AppLoc["calcRoleInternalObject"].Value,
        CalculationRole.Custom => AppLoc["calcRoleCustom"].Value,
        _ => AppLoc["calcRoleMainBid"].Value
    };

    private bool CanCreateProductionCalculation =>
        Calculation.Id > 0 &&
        (CalculationUpdate.CalculationType == CalculationVersionType.Tender ||
         CalculationUpdate.CalculationType == CalculationVersionType.Contract) &&
        CalculationUpdate.IsLocked &&
        SelectedStatus?.AllowsProductionCalculation == true;

    private bool CanCreateContractCalculation =>
        Calculation.Id > 0 &&
        CalculationUpdate.CalculationType == CalculationVersionType.Tender &&
        CalculationUpdate.IsLocked &&
        SelectedStatus?.AllowsProductionCalculation == true;

    private IEnumerable<ListCalculationMVVM> CalculationVersions =>
        CalculationVersionSelector.GetVersions(
            Folder.State.ProjectSelected?.Calculations,
            Calculation);

    private bool CanArchiveVersion(ListCalculationMVVM version) =>
        !version.IsCurrentVersion &&
        !version.IsLocked &&
        !version.IsArchived &&
        !(Folder.State.ProjectSelected?.Calculations ?? [])
            .Any(calculation => calculation.SourceCalculationId == version.Id);

    private StatusListDTO? SelectedStatus =>
        Config?.Statuses.FirstOrDefault(x => x.Id == CalculationUpdate.StatusId);

    private void OnStatusChanged(ChangeEventArgs e)
    {
        var oldStatusId = CalculationUpdate.StatusId;
        int? selectedStatusId = int.TryParse(e.Value?.ToString(), out var value) && value > 0
            ? value
            : null;

        var selectedStatus = Config?.Statuses.FirstOrDefault(x => x.Id == selectedStatusId);
        if (selectedStatus is { IsApprovalStatus: true, LocksCalculation: true } &&
            Calculation.Id > 0 &&
            !CalculationUpdate.IsLocked)
        {
            var blockReason = GetApprovalBlockReason();
            if (blockReason is not null)
            {
                _approvalBlockMessage = blockReason;
                CalculationUpdate.StatusId = oldStatusId;
                return;
            }

            _approvalBlockMessage = string.Empty;
            _pendingApprovalStatusId = selectedStatusId;
            _approvalDialogMessage = string.Empty;
            _showApprovalDialog = true;
            CalculationUpdate.StatusId = oldStatusId;
            return;
        }

        _approvalBlockMessage = string.Empty;
        CalculationUpdate.StatusId = selectedStatusId;
    }

    private string? GetApprovalBlockReason()
    {
        if (_isCurrentUserAdmin)
            return null;

        var inspector = CalculationUpdate.Inspector?.Trim();
        var responsible = CalculationUpdate.Responsibles?.ElementAtOrDefault(0)?.Trim();

        if (string.IsNullOrWhiteSpace(inspector) && string.IsNullOrWhiteSpace(responsible))
            return CalcResource.approvalBlockedNoResponsible;

        if (!string.IsNullOrWhiteSpace(inspector))
        {
            return string.Equals(_currentUserDisplayName, inspector, StringComparison.OrdinalIgnoreCase)
                ? null
                : string.Format(CalcResource.approvalBlockedInspectorOnly, inspector);
        }

        return string.Equals(_currentUserDisplayName, responsible, StringComparison.OrdinalIgnoreCase)
            ? null
            : string.Format(CalcResource.approvalBlockedResponsibleOnly, responsible);
    }

    private void CancelApprovalDialog()
    {
        if (_isApprovingCalculation)
            return;

        _pendingApprovalStatusId = null;
        _approvalDialogMessage = string.Empty;
        _showApprovalDialog = false;
    }

    private void AddCalcNote()
    {
        CalculationUpdate.Notes ??= [];
        CalculationUpdate.Notes.Add(string.Empty);
    }

    private void RemoveCalcNote(int idx)
    {
        if (CalculationUpdate.Notes is { Count: > 1 } && idx >= 0 && idx < CalculationUpdate.Notes.Count)
            CalculationUpdate.Notes.RemoveAt(idx);
    }

    private async Task ApproveAndLockAsync()
    {
        if (_isApprovingCalculation || _pendingApprovalStatusId is null)
            return;

        _isApprovingCalculation = true;
        _approvalDialogMessage = string.Empty;

        try
        {
            CalculationUpdate.StatusId = _pendingApprovalStatusId;
            _showApprovalDialog = false;
            await HandleSubmitAsync();
        }
        catch (Exception ex)
        {
            _approvalDialogMessage = AppLoc["approvalLockFailed"].Value;
            await ClientLog.ErrorAsync("Approve and lock calculation failed", ex: ex);
        }
        finally
        {
            _pendingApprovalStatusId = null;
            _isApprovingCalculation = false;
        }
    }

    private void OpenContractDialog()
    {
        _contractDialogMessage = string.Empty;
        _showContractDialog = true;
    }

    private void CancelContractDialog()
    {
        if (_isCreatingContractCalculation)
            return;

        _showContractDialog = false;
        _contractDialogMessage = string.Empty;
    }

    private async Task CreateContractCalculationAsync()
    {
        if (_isCreatingContractCalculation || Calculation.Id <= 0)
            return;

        _isCreatingContractCalculation = true;
        _contractDialogMessage = string.Empty;

        try
        {
            var newCalculationId = await Repo.Calculation.CreateContractCopyAsync(Calculation.Id);
            if (newCalculationId <= 0)
            {
                _contractDialogMessage = AppLoc["contractCalculationCreateFailed"];
                return;
            }

            _showContractDialog = false;
            MHD.Notifications(ToastType.Add, true);
            await Callback.InvokeAsync(Calculation);
            await Callback.InvokeAsync(null);
            await CalcService.SetCalc(newCalculationId);
        }
        catch (Exception ex)
        {
            _contractDialogMessage = AppLoc["contractCalculationCreateFailed"].Value;
            await ClientLog.ErrorAsync("Create contract calculation from form failed", ex: ex);
        }
        finally
        {
            _isCreatingContractCalculation = false;
        }
    }

    private void OpenProductionDialog()
    {
        _productionDialogMessage = string.Empty;
        _showProductionDialog = true;
    }

    private void CancelProductionDialog()
    {
        if (_isCreatingProductionCalculation)
            return;

        _showProductionDialog = false;
        _productionDialogMessage = string.Empty;
    }

    private async Task CreateProductionCalculationAsync()
    {
        if (_isCreatingProductionCalculation || Calculation.Id <= 0)
            return;

        _isCreatingProductionCalculation = true;
        _productionDialogMessage = string.Empty;

        try
        {
            var newCalculationId = await Repo.Calculation.CreateProductionCopyAsync(Calculation.Id);
            if (newCalculationId <= 0)
            {
                _productionDialogMessage = AppLoc["productionCalculationCreateFailed"].Value;
                return;
            }

            _showProductionDialog = false;
            MHD.Notifications(ToastType.Add, true);
            await Callback.InvokeAsync(Calculation);
            await Callback.InvokeAsync(null);
            await CalcService.SetCalc(newCalculationId);
        }
        catch (Exception ex)
        {
            _productionDialogMessage = AppLoc["productionCalculationCreateError"].Value;
            await ClientLog.ErrorAsync("Create production calculation from form failed", ex: ex);
        }
        finally
        {
            _isCreatingProductionCalculation = false;
        }
    }

    private void OpenVersionsDialog()
    {
        _versionDialogMessage = string.Empty;
        _showVersionsDialog = true;
    }

    private void CloseVersionsDialog()
    {
        _showVersionsDialog = false;
        _versionDialogMessage = string.Empty;
    }

    private async Task OpenVersionAsync(ListCalculationMVVM version)
    {
        _showVersionsDialog = false;
        await Callback.InvokeAsync(null);
        await CalcService.SetCalc(version.Id);
    }

    private Task CreateNewVersionAsync() =>
        CreateVersionFromAsync(Calculation.Id);

    private Task RestoreAsNewVersionAsync(ListCalculationMVVM version) =>
        CreateVersionFromAsync(version.Id);

    private async Task CreateVersionFromAsync(int sourceCalculationId)
    {
        if (_isCreatingVersion || sourceCalculationId <= 0)
            return;

        _isCreatingVersion = true;
        _versionDialogMessage = string.Empty;

        try
        {
            var newCalculationId = await Repo.Calculation.CreateVersionAsync(sourceCalculationId);
            if (newCalculationId <= 0)
            {
                _versionDialogMessage = AppLoc["versionCreateFailed"].Value;
                MHD.Notifications(ToastType.Add, false);
                return;
            }

            _showVersionsDialog = false;
            MHD.Notifications(ToastType.Add, true);
            await Callback.InvokeAsync(Calculation);
            await Callback.InvokeAsync(null);
            await CalcService.SetCalc(newCalculationId);
        }
        catch (Exception ex)
        {
            _versionDialogMessage = AppLoc["versionCreateError"].Value;
            MHD.Notifications(ToastType.Add, false);
            await ClientLog.ErrorAsync("Create calculation version from form failed", ex: ex);
        }
        finally
        {
            _isCreatingVersion = false;
        }
    }

    private async Task ArchiveVersionAsync(ListCalculationMVVM version)
    {
        if (!CanArchiveVersion(version))
            return;

        var dto = await Repo.Calculation.GetPostAsync(version.Id);
        dto.IsArchived = true;

        if (!await Repo.Calculation.UpdateAsync(dto, version.Id))
        {
            _versionDialogMessage = AppLoc["versionArchiveFailed"].Value;
            return;
        }

        version.IsArchived = true;
        MHD.Notifications(ToastType.Update, true);
    }

    private static string FormatText(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string FormatDateTime(DateTime? value) =>
        value.HasValue ? value.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : "-";

    private static string FormatUserId(int? value) =>
        value.HasValue && value.Value > 0 ? value.Value.ToString() : "-";

    private async Task EnsureResponsibilityDefaultsAsync()
    {
        CalculationUpdate.Responsibles ??= [];

        while (CalculationUpdate.Responsibles.Count == 0)
            CalculationUpdate.Responsibles.Add(string.Empty);

        if (Calculation.Id == 0 && string.IsNullOrWhiteSpace(CalculationUpdate.Responsibles[0]))
        {
            var projectResponsible = Folder.State.ProjectSelected?.Responsible;
            CalculationUpdate.Responsibles[0] = !string.IsNullOrWhiteSpace(projectResponsible)
                ? projectResponsible
                : await GetCurrentUserDisplayNameAsync();
        }
    }

    private async Task InheritFromProjectAsync()
    {
        var project = Folder.State.ProjectSelected;
        if (project is null)
            return;

        CalculationUpdate.TenderDeadline = project.TenderDeadline;
        CalculationUpdate.StartDate      = project.StartDate;
        CalculationUpdate.EndDate        = project.EndDate;

        if (!string.IsNullOrWhiteSpace(project.Inspector))
            CalculationUpdate.Inspector = project.Inspector;

        var projectPost = await Repo.Project.GetToPostAsync(project.Id);
        if (projectPost?.Address is { Count: > 0 } && CalculationUpdate.Address.Count == 0)
        {
            var src = projectPost.Address[0];
            CalculationUpdate.Address.Add(new AddressDTO
            {
                Street  = src.Street,
                Nr      = src.Nr,
                ZIPCode = src.ZIPCode,
                City    = src.City,
                Region  = src.Region,
                Country = src.Country
            });
        }
    }

    private async Task<string> GetCurrentUserDisplayNameAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        var fullName = user.FindFirst(PMClaimsConst.FullName)?.Value;
        if (!string.IsNullOrWhiteSpace(fullName))
            return fullName;

        return user.Identity?.Name
            ?? user.FindFirst(ClaimTypes.Email)?.Value
            ?? string.Empty;
    }

    private AddressDTO CalcMainAddress
    {
        get
        {
            CalculationUpdate.Address ??= [];
            if (CalculationUpdate.Address.Count == 0)
                CalculationUpdate.Address.Add(new AddressDTO());
            return CalculationUpdate.Address[0];
        }
    }

    protected override async Task OnInitializedAsync()
    {
        ResetEditContext();

        if (CalculationUpdate.Responsibles.Count == 0)
            CalculationUpdate.Responsibles.Add(string.Empty);

        if (Calculation.Id > 0)
        {
            CalculationUpdate = await Repo.Calculation.GetPostAsync(Calculation.Id) ?? new CalculationPostDTO();
        }

        CalculationUpdate.Notes ??= [];
        if (CalculationUpdate.Notes.Count == 0)
            CalculationUpdate.Notes.Add(string.Empty);
        CalculationUpdate.Contacts ??= [];
        CalculationUpdate.Income ??= [];
        CalculationUpdate.Address ??= [];
        await EnsureResponsibilityDefaultsAsync();

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var authUser = authState.User;
        _currentUserDisplayName = authUser.FindFirst(PMClaimsConst.FullName)?.Value
            ?? authUser.Identity?.Name
            ?? authUser.FindFirst(ClaimTypes.Email)?.Value
            ?? string.Empty;
        _isCurrentUserAdmin = authUser.IsInRole(PMRolesConst.Tenant.Admin);

        if (Calculation.Id == 0)
            await InheritFromProjectAsync();

        Config = await Repo.Calculation.GetConfig(
                CalculationUpdate.ProcurementMethodsId,
                CalculationUpdate.ContractId,
                CalculationUpdate.CompensationId,
                CalculationUpdate.TypeId,
                CalculationUpdate.StatusId
            );

        if (Calculation.Id == 0 && !CalculationUpdate.StatusId.HasValue)
            CalculationUpdate.StatusId = Config.Statuses.FirstOrDefault(status => status.IsDefault)?.Id;

        ResetEditContext();
    }

    private void ComputeTimeMonth()
    {
        if (CalculationUpdate.StartDate == default || CalculationUpdate.EndDate == default)
            return;
        var totalDays = (CalculationUpdate.EndDate - CalculationUpdate.StartDate).TotalDays;
        if (totalDays < 0) return;
        CalculationUpdate.TimeMonth = (int)Math.Round(totalDays / 30.4375, MidpointRounding.AwayFromZero);
    }

    private void OnStartDateChanged()
    {
        if (CalculationUpdate.StartDate != default && CalculationUpdate.EndDate != default)
            ComputeTimeMonth();
        else if (CalculationUpdate.StartDate != default && CalculationUpdate.EndDate == default && CalculationUpdate.TimeMonth > 0)
        {
            var months = (int)CalculationUpdate.TimeMonth;
            CalculationUpdate.EndDate = CalculationUpdate.StartDate.AddMonths(months);
        }
    }

    private void OnEndDateChanged()
    {
        if (CalculationUpdate.StartDate != default && CalculationUpdate.EndDate != default)
            ComputeTimeMonth();
        else if (CalculationUpdate.EndDate != default && CalculationUpdate.StartDate == default && CalculationUpdate.TimeMonth > 0)
        {
            var months = (int)CalculationUpdate.TimeMonth;
            CalculationUpdate.StartDate = CalculationUpdate.EndDate.AddMonths(-months);
        }
    }

    private void OnTimeMonthChanged()
    {
        if (CalculationUpdate.TimeMonth <= 0) return;
        if (CalculationUpdate.StartDate != default && CalculationUpdate.EndDate == default)
        {
            var months = (int)CalculationUpdate.TimeMonth;
            CalculationUpdate.EndDate = CalculationUpdate.StartDate.AddMonths(months);
        }
        else if (CalculationUpdate.EndDate != default && CalculationUpdate.StartDate == default)
        {
            var months = (int)CalculationUpdate.TimeMonth;
            CalculationUpdate.StartDate = CalculationUpdate.EndDate.AddMonths(-months);
        }
    }

    private void ResetEditContext()
    {
        editContext = new EditContext(CalculationUpdate);
        editContext.SetFieldCssClassProvider(RequiredFieldCssClassProvider.Instance);
    }

    async Task HandleSubmitAsync()
    {
        if (btnSubmitDisabled)
            return;

        if (CalculationUpdate.IsLocked)
        {
            MHD.Notifications(ToastType.Update, false);
            await Callback.InvokeAsync(null);
            return;
        }

        btnSubmitDisabled = true;
        var shouldClose = true;

        try
        {
            if (Calculation.Id > 0)
            {
                if (await Repo.Calculation.UpdateAsync(CalculationUpdate, Calculation.Id))
                {
                    MHD.Notifications(ToastType.Update, true);
                    PropertyCopier.CopyPropertiesTo(CalculationUpdate, Calculation);
                }

                await Callback.InvokeAsync(Calculation);
            }
            else
            {
                var projectId = Folder.State.ProjectSelected?.Id;
                if (projectId is null)
                {
                    shouldClose = false;
                    MHD.Notifications(ToastType.Info);
                    return;
                }

                Calculation.Id = await Repo.Calculation.CreateAsync(
                    projectId.Value,
                    CalculationUpdate
                );

                PropertyCopier.CopyPropertiesTo(CalculationUpdate, Calculation);
                MHD.Notifications(ToastType.Add, true);

                await Callback.InvokeAsync(Calculation);
            }
        }
        catch (Exception ex)
        {
            MHD.Notifications(ToastType.Update, false);
            _ = ClientLog.ErrorAsync("CalculationForm submit failed", ex: ex);
        }
        finally
        {
            if (!shouldClose)
                btnSubmitDisabled = false;
        }

        await Callback.InvokeAsync(null);
    }
}
