    private string TableClass => "min-w-full border-collapse text-sm";
    private string TableHeadCellClass => "border-b border-slate-200 px-1 py-1 text-left text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:border-slate-700 dark:text-slate-300";
    private string TableCellClass => "border-b border-slate-200 px-0.5 py-0.5 align-top dark:border-slate-700";
    private string ResourceQuantityReference
    {
        get
        {
            var quantity = ResourceUpdate?.Data?.Quantity;
            var unit = ResourceUpdate?.Data?.Unit;

            if (!quantity.HasValue)
                return "-";

            var formattedQuantity = FormatQuantityDisplay(quantity.Value);
            return string.IsNullOrWhiteSpace(unit)
                ? formattedQuantity
                : $"{formattedQuantity} {unit}";
        }
    }

    private string TimesPercentageReference
    {
        get
        {
            var total = ResourceUpdate?.Data?.Times?.Sum(x => x.Percentage ?? 0m) ?? 0m;
            return $"{FormatNumericDisplay(total)}%";
        }
    }

    private static string FormatResolvedTimeQuantity(decimal quantity)
        => FormatQuantityDisplay(quantity);

    private static string FormatNumericDisplay(decimal value)
        => NumericFormatHelper.Format(value, NumericFractionDigits);

    private static string FormatNumericDisplay(decimal? value)
        => NumericFormatHelper.Format(value, NumericFractionDigits);

    private static string FormatNumericDisplay(double? value)
        => NumericFormatHelper.Format(value, NumericFractionDigits);

    private static string FormatQuantityDisplay(decimal value)
        => NumericFormatHelper.Format(value, QuantityFractionDigits);

    private static string FormatQuantityDisplay(decimal? value)
        => NumericFormatHelper.Format(value, QuantityFractionDigits);

    private string GetStepButtonClass(int index)
    {
        var isActive = PostList != null
            && index >= 0
            && index < PostList.Count
            && object.ReferenceEquals(PostList[index], ResourceUpdate);

        return isActive
            ? "inline-flex h-9 min-w-[2.25rem] items-center justify-center rounded-xl bg-blue-600 px-3 text-sm font-semibold text-white shadow-sm transition dark:bg-blue-500"
            : "inline-flex h-9 min-w-[2.25rem] items-center justify-center rounded-xl border border-slate-300 bg-white px-3 text-sm font-medium text-slate-700 transition hover:bg-slate-100 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700";
    }

    private void AddParameter()
    {
        ResourceUpdate.Data.Parameters.Add(new ResourceParameter
        {
            Name = string.Empty,
            Unit = string.Empty,
            Value = 1
        });
    }

    private void RemoveParameter(int index)
    {
        if (index < 0 || index >= ResourceUpdate.Data.Parameters.Count) return;
        ResourceUpdate.Data.Parameters.RemoveAt(index);
    }

    private void AddTime()
    {
        ResourceUpdate.Data.Times.Add(new ResourceTime
        {
            Name = string.Empty,
            Unit = ResourceUpdate.Data.Unit,
            Percentage = GetSuggestedTimePercentage(),
            Cost = 1
        }.SetResolvedQuantity(0));

        ResourceUpdate.Data.SyncTimesWithQuantity();
    }

    private void RemoveTime(int index)
    {
        if (index < 0 || index >= ResourceUpdate.Data.Times.Count) return;
        ResourceUpdate.Data.Times.RemoveAt(index);
        ResourceUpdate.Data.SyncTimesWithQuantity();
    }

    private decimal GetSuggestedTimePercentage()
    {
        var usedPercentage = ResourceUpdate.Data.Times.Sum(x => x.Percentage ?? 0m);
        var remainingPercentage = Math.Round(100m - usedPercentage, 4, MidpointRounding.AwayFromZero);
        return remainingPercentage > 0m ? remainingPercentage : 0m;
    }
}
