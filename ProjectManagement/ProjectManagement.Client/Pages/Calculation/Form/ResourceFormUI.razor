    private string PrimaryBlueButtonClass => "inline-flex h-6 items-center justify-center rounded-md bg-blue-600 px-1 text-sm font-medium text-white transition hover:bg-blue-700 dark:bg-blue-500";
    private string OutlineBlueButtonClass => "inline-flex h-6 items-center justify-center rounded-md border border-blue-600 px-1 text-sm font-medium text-blue-600 transition hover:bg-blue-600 hover:text-white dark:border-blue-400 dark:text-blue-300";
    private string OutlineRedButtonClass => "inline-flex h-6 items-center justify-center rounded-md border border-red-600 px-1 text-sm font-medium text-red-600 transition hover:bg-red-600 hover:text-white dark:border-red-400 dark:text-red-300";
    private string OutlineGreenButtonClass => "inline-flex items-center justify-center rounded border border-emerald-600 px-1 py-0.5 text-sm font-medium text-emerald-600 transition hover:bg-emerald-600 hover:text-white disabled:cursor-not-allowed disabled:opacity-50 dark:border-emerald-400 dark:text-emerald-300";
    private string OutlineGrayButtonClass => "inline-flex items-center justify-center rounded border border-slate-300 px-1 py-0.5 text-sm font-medium text-slate-700 transition hover:bg-slate-100 dark:border-slate-600 dark:text-slate-200";
