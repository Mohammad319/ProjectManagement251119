@* ﻿@implements IDisposable *@
@implements IDisposable
@attribute [Authorize(Roles = PMRolesConst.Tenant.AdminManger)]
@using BlazorMHD.UI.Components.Data.Card
@using ProjectManagement.Client.Shared.MVVM.Calculation
@using ProjectManagement.Client.Shared.Model.Project.Calculation
@using ProjectManagement.Shared.Base.Calculation
@using ProjectManagement.Shared.DTO.Calculation
@using ProjectManagement.Shared.DTO.Offer
@using ProjectManagement.Shared.DTO.ResourceType
@using ProjectManagement.Shared.Enums

@inherits AppComponentBase


    @if (Resource?.Id == 0 && PostList.Count > 1)
{
    <div class="sticky top-0 z-20 border-b border-slate-200 bg-white/95 px-4 py-3 backdrop-blur dark:border-slate-700 dark:bg-slate-900/95">
        <div class="flex flex-wrap gap-2">
            @for (int i = 0; i < PostList.Count; i++)
            {
                int x = i;
                <button type="button"
                        @onclick="() => ChangePos(x)"
                        class="@GetStepButtonClass(i)">
                    @(i + 1)
                </button>
            }
        </div>
    </div>
}

<EditForm @key="editContext"
          id="@DialogFormId"
          EditContext="editContext!"
          OnValidSubmit="HandleSubmitAsync">

    <DataAnnotationsValidator />
    <FormValidationSummary />

    <!-- PANEL 1 -->
    <MhdCard Elevated="true" Compact="true" Class="mb-1.5">
        <div class="grid gap-x-2 gap-y-1.5 md:grid-cols-12">
            <div class="min-w-0 md:col-span-4">
                <label class="@LabelClass">@CalcResource.name</label>
                <InputText @bind-Value="ResourceUpdate.Name" class="@InputClass" />
            </div>

            @if (!Refresh && Config.AccountGroups != null)
            {
                <div class="min-w-0 md:col-span-4">
                    <label class="@LabelClass">@CalcResource.accountGroups</label>
                    <select @onchange="ChangeGroupAccount"
                            value="@AccountGroupSelected?.Id"
                            class="@InputClass">
                        <option></option>
                        @foreach (var item in Config.AccountGroups)
                        {
                            <option selected="@(AccountGroupSelected != null && item.Id == AccountGroupSelected.Id)"
                                    value="@item.Id">
                                @item.Name
                            </option>
                        }
                    </select>
                </div>

                @if (ResourceUpdate != null && AccountGroupSelected != null && AccountGroupSelected.Accounts != null)
                {
                    <div class="min-w-0 md:col-span-4">
                        <label class="@LabelClass">@CalcResource.account</label>
                        <InputSelect @bind-Value="ResourceUpdate.AccountId" class="@InputClass">
                            <option></option>
                            @foreach (var item in AccountGroupSelected.Accounts)
                            {
                                <option selected="@(item.Id == ResourceUpdate.AccountId)"
                                        value="@item.Id">
                                    @($"{item.Account} ({item.Name})")
                                </option>
                            }
                        </InputSelect>
                    </div>
                }
            }
        </div>
    </MhdCard>

    <!-- PANEL 2 -->
    <MhdCard Elevated="true" Compact="true" Class="mb-1.5">
        <div class="grid gap-x-2 gap-y-1.5 md:grid-cols-12">

            <div class="min-w-0 md:col-span-12 xl:col-span-4">
                <label class="@LabelClass">@CalcResource.quantity</label>

                <div class="grid items-start gap-1.5  grid-cols-[minmax(0,1fr)_7rem]">
                    <InputSelect class="@InputClass"
                                 @bind-Value:get="ResourceUpdate.Data.QuantityParam"
                                 @bind-Value:set="(value) => ChangeQuantityParam(value)">
                        <option></option>
                        <option value="@ConstValues.FixedQ">@CalcResource.fixedQ</option>
                        @if (Calc.QuanityList != null)
                        {
                            foreach (var status in Calc.QuanityList)
                            {
                                <option value="@status.Name">@status.Name (@status.Quantity)</option>
                            }
                        }
                    </InputSelect>

                    @if (ResourceUpdate.Data.QuantityParam == ConstValues.FixedQ)
                    {
                        <TrimmedNumberInput TValue="decimal?"
                                            @bind-Value="ResourceUpdate.Data.Quantity"
                                            MaxFractionDigits="@QuantityFractionDigits"
                                            class="@InputClass" />
                    }
                    else
                    {
                        <input value="@FormatQuantityDisplay(ResolvedResourceQuantity)" class="@InputClass" disabled />
                    }
                </div>

            </div>

            <div class="min-w-0 md:col-span-4 xl:col-span-3">
                <label class="@LabelClass">@CalcResource.unit</label>
                <InputText @bind-Value="ResourceUpdate.Data.Unit" class="@InputClass" />
            </div>
           
                <div class="min-w-0 md:col-span-4 xl:col-span-2">
                    <label class="@LabelClass">@StorageLoc["resourceUnitCostLabel"]</label>
                    @if (Resource?.OfferId.HasValue == true && Resource.OfferId > 0)
                    {
                        <input class="@DisabledInputClass" type="text" disabled value="@FormatNumericDisplay(Resource.Data.Cost)" />
                    }
                    else if (!ResourceUpdate.Data.Times.Any())
                    {
                        <TrimmedNumberInput TValue="decimal"
                                            @bind-Value="ResourceUpdate.Data.Cost"
                                            MaxFractionDigits="@NumericFractionDigits"
                                            class="@InputClass" />
                }
                else
                {
                    <input value="@FormatNumericDisplay(ResourceUpdate.Data.Cost)" class="@InputClass" disabled />
                }
                </div>
            
            <div class="min-w-0 md:col-span-4 xl:col-span-2">
                <label class="@LabelClass">@CalcResource.baseCost</label>
                @if (Resource?.OfferId.HasValue == true && Resource.OfferId > 0)
                {
                    <input type="text" disabled value="@FormatNumericDisplay(Resource.Data.BaseCost)" class="@DisabledInputClass" />
                }
                else
                {
                    <TrimmedNumberInput TValue="decimal?"
                                        @bind-Value="ResourceUpdate.Data.BaseCost"
                                        MaxFractionDigits="@NumericFractionDigits"
                                        class="@InputClass" />
                }
            </div>
         
                <div class="min-w-0 md:col-span-4 xl:col-span-2">
                    <label class="@LabelClass">@CalcResource.changeFactor1</label>
                @if (!ResourceUpdate.Data.Parameters.Any())
                {
                    <TrimmedNumberInput TValue="decimal"
                                        @bind-Value="ResourceUpdate.Data.ChangeFactor1"
                                        MaxFractionDigits="@NumericFractionDigits"
                                        class="@InputClass" />
                }
                else
                {
                    <input value="@FormatNumericDisplay(ResourceUpdate.Data.ChangeFactor1)" class="@InputClass" disabled />
            }
                </div>

@*             <div class="min-w-0 md:col-span-4 xl:col-span-2">
                <label class="@LabelClass">@StorageLoc["changeFactor2Resource"]</label>
                <TrimmedNumberInput TValue="decimal"
                                    @bind-Value="ResourceUpdate.Data.ChangeFactor2"
                                    MaxFractionDigits="@NumericFractionDigits"
                                    class="@InputClass" />
            </div> *@

            @if (ResourceUpdate.ResType == ResourceTypesEnum.Materials
                                                              || ResourceUpdate.ResType == ResourceTypesEnum.Worker
                                                              || ResourceUpdate.ResType == ResourceTypesEnum.MachinesAndEquipments)
            {
                <div class="min-w-0 md:col-span-3 xl:col-span-2">
                    <label class="@LabelClass" for="waste">
                        @(ResourceUpdate.ResType == ResourceTypesEnum.Materials ? CalcResource.waste : CalcResource.cap)
                    </label>
                    @if (HasCapResourceType && UseCapFromTask)
                     {
                         <input id="waste"
                                value="@FormatNumericDisplay(EffectiveCapWaste)"
                                class="@DisabledInputClass"
                                disabled />
                     }
                     else
                     {
                         <TrimmedNumberInput TValue="decimal"
                                             id="waste"
                                             @bind-Value="ResourceUpdate.Data.CapWaste"
                                             MaxFractionDigits="@NumericFractionDigits"
                                             class="@InputClass" />
                     }
                </div>
            } 
            @if (HasCapResourceType)
                    {
            <div class="min-w-0 flex items-end md:col-span-4 xl:col-span-2">
                    <label class="@($"{CheckboxCardClass} mt-1")">
                        <InputCheckbox @bind-Value:get="ResourceUpdate.Data.CapFromTask"
                                       @bind-Value:set="ChangeCapFromTask"
                                       class="@CheckboxClass" />
                        <span>Cap från uppgift</span>
                    </label>

            </div>  }

            <div class="min-w-0 flex items-end md:col-span-4 xl:col-span-2">
                <label class="@CheckboxCardClass">
                    <InputCheckbox @bind-Value="ResourceUpdate.IsActive" class="@CheckboxClass" />
                    <span>@CalcResource.active</span>
                </label>
            </div>
        </div>
    </MhdCard>

    <!-- PANEL 3 -->
    <MhdCard Elevated="true" Compact="true" Class="mb-1.5">
        <div class="grid gap-x-2 gap-y-1.5 md:grid-cols-12">

            @if (Config.ResourceTypes != null)
            {
                <div class="min-w-0 md:col-span-4">
                    <label class="@LabelClass">@CalcResource.resourceType</label>
                    <InputSelect class="@InputClass"
                                 @bind-Value:get="ResourceUpdate.ResourceTypeId"
                                 @bind-Value:set="async (value) => await ChangeResType(value)">
                        <option value=""></option>
                        @foreach (var item in Config.ResourceTypes)
                        {
                            <option value="@item.Id"
                                    selected="@(ResourceUpdate.ResourceTypeId == item.Id)">
                                @item.Name
                            </option>
                        }
                    </InputSelect>
                </div>
            }

            @if (ResTypeSelected != null && ResTypeSelected.ResourcesSort != null && ResTypeSelected.ResourcesSort.Any())
            {
                <div class="min-w-0 md:col-span-4">
                    <label class="@LabelClass">@CalcResource.resourceSort</label>
                    <InputSelect class="@InputClass"
                                 @bind-Value:get="ResourceUpdate.ResourceSortId"
                                 @bind-Value:set="async (value) => await ChangeResSort2(value)">
                        <option></option>
                        @foreach (var item in ResTypeSelected.ResourcesSort)
                        {
                            <option value="@item.Id"
                                    selected="@(ResourceUpdate.ResourceSortId.HasValue && ResourceUpdate.ResourceSortId == item.Id)">
                                @item.Name
                            </option>
                        }
                    </InputSelect>
                </div>
            }

            <div class="min-w-0 md:col-span-4">
                <label class="@LabelClass">@CalcResource.status</label>
                <InputSelect @bind-Value="ResourceUpdate.StatusId" class="@InputClass">
                    @if (Config.Statues != null)
                    {
                        <option value=""></option>
                        @foreach (var status in Config.Statues)
                        {
                            <option value="@status.Id">@status.Name</option>
                        }
                    }
                </InputSelect>
            </div>

            <div class="min-w-0 md:col-span-3 xl:col-span-2">
                <label class="@LabelClass">@CalcResource.priceSub</label>
                <TrimmedNumberInput TValue="decimal?"
                                    @bind-Value="ResourceUpdate.Data.PriceSub"
                                    MaxFractionDigits="@NumericFractionDigits"
                                    class="@InputClass" />
            </div>

            <div class="min-w-0 md:col-span-3 xl:col-span-2">
                <label class="@LabelClass">@CalcResource.co2</label>
                <TrimmedNumberInput TValue="double?"
                                    @bind-Value="ResourceUpdate.Data.CO2"
                                    MaxFractionDigits="@NumericFractionDigits"
                                    class="@InputClass" />
            </div>

            <div class="min-w-0 md:col-span-6 xl:col-span-4">
                <label class="@LabelClass">@CalcResource.opportunity</label>
                <InputSelect @bind-Value="ResourceUpdate.OpportunityId" class="@InputClass">
                    <option></option>
                    @if (Calc.Opportunities != null)
                    {
                        foreach (var opportunity in Calc.Opportunities)
                        {
                            <option value="@opportunity.Id">
                                @opportunity.OpportunitiesRisks @opportunity.OpportunityType
                            </option>
                        }
                    }
                </InputSelect>
            </div>
        </div>
    </MhdCard>

    <!-- PARAMETERS -->
    <MhdCard Elevated="true" Compact="true" Class="mb-1.5">
        <div class="mb-2 flex flex-wrap items-start justify-between gap-2">
            <div class="min-w-0 flex-1 overflow-x-auto">
                <div class="@SectionMetaRowClass">
                    <span class="@SectionTitleInlineClass">@StorageLoc["resourceParametersTitle"]</span>
                    <span class="@SectionSubtleInlineClass">@AppLoc["itemsCount", ResourceUpdate.Data.Parameters.Count]</span>
                    <span class="@SectionMutedInlineClass">@StorageLoc["resourceParametersHint"]</span>
                </div>
            </div>

            <button type="button"
                    class="@OutlineBlueButtonClass"
                    @onclick="AddParameter">
                @ResourceApp.newItem
            </button>
        </div>

        @if (!ResourceUpdate.Data.Parameters.Any())
        {
            <div class="rounded-xl border border-dashed border-amber-300 bg-amber-50 px-3 py-3 text-sm text-amber-700 dark:border-amber-700 dark:bg-amber-900/20 dark:text-amber-300">
                @ResourceApp.thereIsNoElements
            </div>
        }
        else
        {
            <div class="@TableWrapClass">
                <table class="@TableClass">
                    <thead>
                        <tr>
                            <th class="@TableHeadCellClass">@CalcResource.name</th>
                            <th class="@TableHeadCellClass">@ResourceLoc.value</th>
                            <th class="@TableHeadCellClass">@CalcResource.unit</th>
                            <th class="@TableHeadCellClass w-12"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < ResourceUpdate.Data.Parameters.Count; i++)
                        {
                            int idx = i;
                            <tr>
                                <td class="@TableCellClass min-w-[18rem]">
                                    <InputText class="@InputClass"
                                               @bind-Value="ResourceUpdate.Data.Parameters[idx].Name" />
                                </td>
                                <td class="@TableCellClass min-w-[6rem]">
                                    <TrimmedNumberInput TValue="decimal"
                                                        class="@InputClass"
                                                        @bind-Value="ResourceUpdate.Data.Parameters[idx].Value"
                                                        MaxFractionDigits="@NumericFractionDigits" />
                                </td>
                                <td class="@TableCellClass min-w-[6rem]">
                                    <InputText class="@InputClass"
                                               @bind-Value="ResourceUpdate.Data.Parameters[idx].Unit" />
                                </td>
                                <td class="@TableCellClass w-12 text-right">
                                    <button type="button"
                                            class="@DeleteIconButtonClass"
                                            @onclick="() => RemoveParameter(idx)">
                                        @((MarkupString)Icons.DeleteSVG)
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </MhdCard>

    <!-- ADD-ONS / ATTACHMENTS -->
    <MhdCard Elevated="true" Compact="true" Class="mb-1">
        <div class="mb-1 flex flex-wrap items-start justify-between gap-2">
            <div class="min-w-0 flex-1 overflow-x-auto">
                <div class="@SectionMetaRowClass">
                    <span class="@SectionTitleInlineClass">@StorageLoc["resourceAddOnsTitle"]</span>
                    <span class="@SectionSubtleInlineClass">@AppLoc["itemsCount", AddOnRowCount]</span>
                    <span class="@SectionMutedInlineClass">@StorageLoc["resourceAddOnsHint"]</span>
                </div>
            </div>

            <button type="button"
                    class="@OutlineBlueButtonClass"
                    @onclick="AddAddOn">
                @ResourceApp.newItem
            </button>
        </div>

        <div class="@TableWrapClass">
            <table class="@TableClass">
                <thead>
                    <tr>
                        <th class="@TableHeadCellClass">@CalcResource.name</th>
                        <th class="@TableHeadCellClass">@CalcResource.factor</th>
                        <th class="@TableHeadCellClass">@CalcResource.type</th>
                        <th class="@TableHeadCellClass">@CalcResource.quantity</th>
                        <th class="@TableHeadCellClass">@CalcResource.unit</th>
                        <th class="@TableHeadCellClass">@CalcResource.cost</th>
                        <th class="@TableHeadCellClass">@CalcResource.baseCost</th>
                        <th class="@TableHeadCellClass">@CalcResource.totalNetCost</th>
                        <th class="@TableHeadCellClass w-12"></th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="@TableCellClass min-w-[16rem]">
                            <input class="@DisabledInputClass" type="text" disabled value="@ResourceUpdate.Name" />
                        </td>
                        <td class="@TableCellClass min-w-[4rem]"></td>
                        <td class="@TableCellClass min-w-[3.5rem]"></td>
                        <td class="@TableCellClass min-w-[4rem]">
                            <input class="@DisabledInputClass" type="text" disabled value="@FormatQuantityDisplay(PrimaryAddOnQuantity)" />
                        </td>
                        <td class="@TableCellClass min-w-[4rem]">
                            <input class="@DisabledInputClass" type="text" disabled value="@ResourceUpdate.Data.Unit" />
                        </td>
                        <td class="@TableCellClass min-w-[4rem]">
                            <input class="@DisabledInputClass" type="text" disabled value="@FormatNumericDisplay(ResourceUpdate.Data.Cost)" />
                        </td>
                        <td class="@TableCellClass min-w-[4rem]">
                            <input class="@DisabledInputClass" type="text" disabled value="@FormatNumericDisplay(PrimaryAddOnBaseCost)" />
                        </td>
                        <td class="@TableCellClass min-w-[4rem]">
                            <input class="@DisabledInputClass" type="text" disabled value="@FormatNumericDisplay(PrimaryAddOnTotalCost)" />
                        </td>
                        <td class="@TableCellClass w-12 text-center">
                            <span class="text-xs font-medium text-slate-400"></span>
                        </td>
                    </tr>

                    @for (int i = 0; i < ResourceUpdate.Data.AddOns.Count; i++)
                    {
                        int idx = i;
                        <tr>
                            <td class="@TableCellClass min-w-[16rem]">
                                <InputText class="@InputClass"
                                           @bind-Value="ResourceUpdate.Data.AddOns[idx].Name" />
                            </td>
                            <td class="@TableCellClass min-w-[4rem]">
                                <TrimmedNumberInput TValue="decimal"
                                                    class="@InputClass"
                                                    @bind-Value="ResourceUpdate.Data.AddOns[idx].Factor"
                                                    MaxFractionDigits="@NumericFractionDigits" />
                            </td>
                            <td class="@TableCellClass min-w-[3.5rem]">
   <InputSelect @bind-Value="ResourceUpdate.Data.AddOns[idx].Type" class="@InputClass">
                                <option value="@QuantityResourceAddon.Multiplication" selected> * </option>
                                <option value="@QuantityResourceAddon.Division"> / </option>
                                </InputSelect>
                            </td>
                         

                          
                            <td class="@TableCellClass min-w-[4rem]">
                                <input class="@InputClass" disabled
                                       value="@FormatQuantityDisplay(ResourceUpdate.Data.AddOns[idx].Quantity(ResourceUpdate.Quantity))" />
                            </td>
                            <td class="@TableCellClass min-w-[4rem]">
                                <InputText class="@InputClass"
                                           @bind-Value="ResourceUpdate.Data.AddOns[idx].Unit" />
                            </td>
                            <td class="@TableCellClass min-w-[4rem]">
                                <TrimmedNumberInput TValue="decimal"
                                                    class="@InputClass"
                                                    @bind-Value="ResourceUpdate.Data.AddOns[idx].Cost"
                                                    MaxFractionDigits="@NumericFractionDigits" />
                            </td>
                            <td class="@TableCellClass min-w-[4rem]">
                                <TrimmedNumberInput TValue="decimal"
                                                    class="@InputClass"
                                                    @bind-Value="ResourceUpdate.Data.AddOns[idx].BaseCost"
                                                    MaxFractionDigits="@NumericFractionDigits" />
                            </td>
                            <td class="@TableCellClass min-w-[4rem]">
                                <input class="@DisabledInputClass" type="text" disabled value="@FormatNumericDisplay(GetAddOnTotalCost(ResourceUpdate.Data.AddOns[idx]))" />
                            </td>
                            <td class="@TableCellClass w-12 text-right">
                                <button type="button"
                                        class="@DeleteIconButtonClass"
                                        @onclick="() => RemoveAddOn(idx)">
                                    @((MarkupString)Icons.DeleteSVG)
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-1 grid gap-1 md:grid-cols-3">
            <div class="min-w-0">
                <label class="@LabelClass">@CalcResource.cost</label>
                <input class="@DisabledInputClass" type="text" disabled value="@FormatNumericDisplay(EffectiveAddOnCost)" />
            </div>

            <div class="min-w-0">
                <label class="@LabelClass">@CalcResource.baseCost</label>
                <input class="@DisabledInputClass" type="text" disabled value="@FormatNumericDisplay(EffectiveAddOnBaseCost)" />
            </div>

            <div class="min-w-0">
                <label class="@LabelClass">@CalcResource.totalNetCost</label>
                <input class="@DisabledInputClass" type="text" disabled value="@FormatNumericDisplay(EffectiveAddOnTotalCost)" />
            </div>
        </div>
    </MhdCard>

    @if (ResourceUpdate?.ResType == ResourceTypesEnum.Worker ||
         ResourceUpdate?.ResType == ResourceTypesEnum.MachinesAndEquipments)
    {
        <!-- TIMES -->
        <MhdCard Elevated="true" Compact="true" Class="mb-1">
            <div class="mb-1 flex flex-wrap items-start justify-between gap-1">
                <div class="min-w-0 flex-1 overflow-x-auto">
                    <div class="@SectionMetaRowClass">
                        <span class="@SectionTitleInlineClass">@StorageLoc["resourceTimesTitle"]</span>
                        <span class="@SectionSubtleInlineClass">@AppLoc["itemsCount", ResourceUpdate.Data.Times.Count]</span>
                        <span class="@SectionMutedInlineClass">@StorageLoc["resourceTimesHint"]</span>
                        <span class="@SectionMutedInlineClass">Resource Q: @ResourceQuantityReference</span>
                        <span class="@SectionMutedInlineClass">Times %: @TimesPercentageReference</span>
                    </div>
                </div>

                <button type="button"
                        class="@OutlineBlueButtonClass"
                        @onclick="AddTime">
                    @ResourceApp.newItem
                </button>
            </div>

            @if (!ResourceUpdate.Data.Times.Any())
            {
                <div class="rounded-xl border border-dashed border-amber-300 bg-amber-50 px-3 py-3 text-sm text-amber-700 dark:border-amber-700 dark:bg-amber-900/20 dark:text-amber-300">
                    @ResourceApp.thereIsNoElements
                </div>
            }
            else
            {
                <div class="@TableWrapClass">
                    <table class="@TableClass">
                        <thead>
                            <tr>
                                <th class="@TableHeadCellClass">@CalcResource.name</th>
                                <th class="@TableHeadCellClass">@ResourceLoc.inprecent</th>
                                <th class="@TableHeadCellClass">@CalcResource.quantity</th>
                                <th class="@TableHeadCellClass">@CalcResource.unit</th>
                                <th class="@TableHeadCellClass">@StorageLoc["resourceUnitCostLabel"]</th>
                                <th class="@TableHeadCellClass w-12"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < ResourceUpdate.Data.Times.Count; i++)
                            {
                                int idx = i;
                                <tr>
                                    <td class="@TableCellClass min-w-[18rem]">
                                        <InputText class="@InputClass"
                                                   @bind-Value="ResourceUpdate.Data.Times[idx].Name" />
                                    </td>
                              
                                    <td class="@TableCellClass min-w-[5rem]">
                                        <TrimmedNumberInput TValue="decimal?"
                                                            class="@InputClass"
                                                            @bind-Value="ResourceUpdate.Data.Times[idx].Percentage"
                                                            MaxFractionDigits="@NumericFractionDigits" />
                                    </td>
                                    <td class="@TableCellClass min-w-[5rem]">
                                        <input class="@DisabledInputClass" type="text" disabled
                                               value="@FormatResolvedTimeQuantity(ResourceUpdate.Data.Times[idx].Quantity)" />
                                    </td>
                                    <td class="@TableCellClass min-w-[5rem]">
                                        <input class="@DisabledInputClass" disabled
                                               value="@ResourceUpdate.Data.Unit" />
                                    </td>
                                    <td class="@TableCellClass min-w-[5rem]">
                                        <TrimmedNumberInput TValue="decimal"
                                                            class="@InputClass"
                                                            @bind-Value="ResourceUpdate.Data.Times[idx].Cost"
                                                            MaxFractionDigits="@NumericFractionDigits" />
                                    </td>
                                    <td class="@TableCellClass w-12 text-right">
                                        <button type="button"
                                                class="@DeleteIconButtonClass"
                                                @onclick="() => RemoveTime(idx)">
                                            @((MarkupString)Icons.DeleteSVG)
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </MhdCard>
    }

    <!-- NOTES -->
    <MhdCard Elevated="true" Compact="true" Class="mb-1">
        <div class="mb-1 flex flex-wrap items-center justify-between gap-2">
            <label class="block text-sm font-semibold text-slate-800 dark:text-slate-100">@CalcResource.note</label>
            <p class="text-xs text-slate-500 dark:text-slate-400">@StorageLoc["resourceNotesHint"]</p>

            <button type="button"
                    class="@PrimaryBlueButtonClass"
                    @onclick="AddUpperNote">
                @CalcResource.UpperNote
            </button>
        </div>

        <div class="mb-2">
            <InputTextArea @bind-Value="ResourceData.Note"
                           class="@TextAreaClass" />
        </div>

        @for (int i = 0; i < ResourceData.UpperNote.Count; i++)
        {
            int d = i;
            <div class="mb-2 overflow-x-auto overflow-y-hidden rounded-xl border border-slate-200 bg-slate-50 p-3 dark:border-slate-700 dark:bg-slate-800/60">
                <div class="flex min-w-max flex-nowrap items-end gap-1">
                    <div class="min-w-[420px] flex-1">
                        <label class="@LabelClass">@CalcResource.UpperNote</label>
                        <textarea @bind="ResourceData.UpperNote[d]"
                                  class="@TextAreaClass min-h-[88px]"
                                  rows="3"></textarea>
                    </div>

                    <div class="w-[42px] shrink-0">
                        <button type="button"
                                class="inline-flex h-10 w-[42px] items-center justify-center rounded bg-red-600 text-sm font-medium text-white transition hover:bg-red-700 dark:bg-red-500"
                                @onclick="() => RemoveUpperNoteAt(d)">
                            @((MarkupString)Icons.DeleteSVG)
                        </button>
                    </div>
                </div>
            </div>
        }
    </MhdCard>

</EditForm>

@if (Resource?.Id == 0)
{
    <div class="sticky bottom-0 z-20 border-t border-slate-200 bg-white/95 px-2 py-2 dark:border-slate-700 dark:bg-slate-900/95">
        <div class="flex flex-wrap items-center justify-end gap-2">
            @if (PostList.Count > 1)
            {
                <button type="button"
                        class="@OutlineRedButtonClass"
                        @onclick="() => PostList.Remove(ResourceUpdate)">
                    @ResourceApp.delete
                </button>
            }

            <button type="button"
                    class="@OutlineBlueButtonClass"
                    @onclick="NewSP">
                @ResourceApp.newItem
            </button>
        </div>
    </div>
}

