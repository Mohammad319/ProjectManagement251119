@implements IDisposable
@attribute [Authorize(Roles = PMRolesConst.Tenant.AdminManger)]
@using BlazorMHD.UI.Components.Data.Card
@using ProjectManagement.Client.Shared.MVVM.Calculation
@using ProjectManagement.Client.Shared.Model.Project.Calculation
@using ProjectManagement.Shared.Base.Calculation
@using ProjectManagement.Shared.DTO.Calculation
@using ProjectManagement.Shared.DTO.Offer
@using ProjectManagement.Shared.DTO.ResourceType
@using ProjectManagement.Shared.Enums

@inherits AppComponentBase
<EditForm id="resForm" Model="ResourceUpdate" OnValidSubmit="async()=> await HandleSubmitAsync()">

    @if (Resource?.Id == 0 && PostList.Count > 1)
    {
        <div>
            <ul class="nav nav-pills mb-3" id="pills-tab" role="tablist">
                @for (int i = 0; i < PostList.Count; i++)
                {
                    int x = i;
                    <li class="nav-item" role="presentation">
                        <button @onclick="()=> ChangePos(x)" class="nav-link active" type="button" role="tab">@(i + 1)</button>
                    </li>
                }
            </ul>
        </div>
    }

    @* <DataAnnotationsValidator /> *@

    @* PANEL 1: الاسم + مجموعة الحساب + الحساب *@
    <MhdCard Elevated="true" Compact="true" Class="mb-2">
        <div class="flex flex-wrap gap-2">
            <div class="flex-1 min-w-[350px]">
                <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.name </label>
                <InputText @bind-Value="ResourceUpdate.Name" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" />
                <ValidationMessage For="@(() => ResourceUpdate.Name)" />
            </div>

            @if (!Refresh && Config.AccountGroups != null)
            {
                <div class="w-[160px]">
                    <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.accountGroups </label>
                    <select @onchange="ChangeGroupAccount"
                            value="@AccountGroupSelected?.Id"
                            class="w-full border border-gray-300 rounded px-2 py-1 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:text-white dark:border-gray-600">
                        <option></option>
                        @foreach (var item in Config.AccountGroups)
                        {
                            <option selected="@(AccountGroupSelected != null && item.Id == AccountGroupSelected.Id)"
                                    value="@item.Id">
                                @item.Name
                            </option>
                        }
                    </select>
                </div>

                @if (ResourceUpdate != null && AccountGroupSelected != null && AccountGroupSelected.Accounts != null)
                {
                    <div class="w-[160px]">
                        <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.account </label>
                        <InputSelect @bind-Value="ResourceUpdate.AccountId"
                                     class="w-full border border-gray-300 rounded px-2 py-1 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:text-white dark:border-gray-600">
                            <option></option>
                            @if (AccountGroupSelected.Accounts != null)
                                foreach (var item in AccountGroupSelected.Accounts)
                                {
                                    <option selected="@(item.Id == ResourceUpdate.AccountId)"
                                            value="@item.Id">
                                        @($"{item.Account} ({item.Name})")
                                    </option>
                                }
                        </InputSelect>
                    </div>
                }
            }
        </div>
    </MhdCard>

    @* PANEL 2: الكمية + الوحدة + التكاليف + عوامل التغيير + Waste/Cap + Active *@
    <MhdCard Elevated="true" Compact="true" Class="mb-2">
        <div class="flex flex-wrap gap-2">
            <div class="@(ResourceUpdate.Data.QuantityParam == ConstValues.FixedQ ? "w-[110px]" : "w-[200px]")">
                <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.quantity</label>
                <div class="w-full @("inline-flex")">
                    <InputSelect class="w-full border border-gray-300 rounded px-2 py-1 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:text-white dark:border-gray-600"
                                 @bind-Value:get="ResourceUpdate.Data.QuantityParam"
                                 @bind-Value:set="(value) => ChangeQuantityParam(value)">
                        <option></option>
                        <option value="@ConstValues.FixedQ">@CalcResource.fixedQ</option>
                        @if (Calc.QuanityList != null)
                            foreach (var status in Calc.QuanityList)
                            {
                                <option value="@status.Name">@status.Name (@status.Quantity)</option>
                            }
                    </InputSelect>

                    @if (ResourceUpdate.Data.QuantityParam == ConstValues.FixedQ)
                    {
                        <InputNumber @bind-Value="ResourceUpdate.Data.Quantity"
                                     class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" />
                    }
                </div>
            </div>

            <div class="w-[110px]">
                <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.unit</label>
                <InputText @bind-Value="ResourceUpdate.Data.Unit" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" />
                <ValidationMessage For="@(() => ResourceUpdate.Data.Unit)" />
            </div>

            <div class="w-[110px]">
                <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.cost </label>
                @if (Resource?.OfferId.HasValue == true && Resource.OfferId > 0)
                {
                    <input class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" type="number" disabled value="@Resource.Data.Cost" />
                }
                else
                {
                    <InputNumber @bind-Value="ResourceUpdate.Data.Cost" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" />
                    <ValidationMessage For="@(() => ResourceUpdate.Data.Cost)" />
                }
            </div>

            <div class="w-[110px]">
                <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.baseCost </label>
                @if (Resource?.OfferId.HasValue == true && Resource.OfferId > 0)
                {
                    <input type="number" disabled value="@Resource.Data.BaseCost" />
                }
                else
                {
                    <InputNumber @bind-Value="ResourceUpdate.Data.BaseCost" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" />
                    <ValidationMessage For="@(() => ResourceUpdate.Data.BaseCost)" />
                }
            </div>

            <div class="w-[130px]">
                <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.changeFactor1</label>
                <InputNumber @bind-Value="ResourceUpdate.Data.ChangeFactor1" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" />
                <ValidationMessage For="@(() => ResourceUpdate.Data.ChangeFactor1)" />
            </div>

            <div class="w-[130px]">
                <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.changeFactor2 </label>
                <InputNumber @bind-Value="ResourceUpdate.Data.ChangeFactor2" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" />
                <ValidationMessage For="@(() => ResourceUpdate.Data.ChangeFactor2)" />
            </div>

            <div class="w-[130px]">
                <div class="flex items-center gap-2 mt-1 md:mt-6">
                    <InputCheckbox @bind-Value="ResourceUpdate.IsActive" class="h-4 w-4 text-blue-600 rounded focus:ring-blue-500 dark:text-blue-400" />
                    <label class="select-none dark:text-white">@CalcResource.active </label>
                </div>
            </div>

            @if (ResourceUpdate.ResType == ResourceTypesEnum.Materials
              || ResourceUpdate.ResType == ResourceTypesEnum.Worker
              || ResourceUpdate.ResType == ResourceTypesEnum.MachinesAndEquipments)
            {
                <div class="w-[110px]">
                    <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300" for="waste">
                        @(ResourceUpdate.ResType == ResourceTypesEnum.Materials ? CalcResource.waste : CalcResource.cap)
                    </label>
                    <InputNumber id="waste"
                                 @bind-Value="ResourceUpdate.Data.CapWaste"
                                 class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" />
                    <ValidationMessage For="@(() => ResourceUpdate.Data.CapWaste)"
                                       class="text-red-600 dark:text-red-400" />
                </div>
            }
        </div>
    </MhdCard>

    @* PANEL 3: النوع / التصنيف / الحالة / CO2 / الفرصة *@
    <MhdCard Elevated="true" Compact="true" Class="mb-2">
        <div class="flex flex-wrap gap-2">
            @if (Config.ResourceTypes != null)
            {
                <div class="w-[160px]">
                    <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.resourceType</label>
                    <InputSelect class="w-full border border-gray-300 rounded px-2 py-1 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:text-white dark:border-gray-600"
                                 @bind-Value:get="ResourceUpdate.ResourceTypeId"
                                 @bind-Value:set="async (value) => await ChangeResType(value)">
                        <option value=""></option>
                        @foreach (var item in Config.ResourceTypes)
                        {
                            <option value="@item.Id"
                                    selected="@(ResourceUpdate.ResourceTypeId == item.Id)">
                                @item.Name
                            </option>
                        }
                    </InputSelect>
                </div>
            }

            @if (ResTypeSelected != null && ResTypeSelected.ResourcesSort != null && ResTypeSelected.ResourcesSort.Any())
            {
                <div class="w-[160px]">
                    <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.resourceSort </label>
                    <InputSelect class="w-full border border-gray-300 rounded px-2 py-1 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:text-white dark:border-gray-600"
                                 @bind-Value:get="ResourceUpdate.ResourceSortId"
                                 @bind-Value:set="async (value) => await ChangeResSort2(value)">
                        <option></option>
                        @foreach (var item in ResTypeSelected.ResourcesSort)
                        {
                            <option value="@item.Id"
                                    selected="@(ResourceUpdate.ResourceSortId.HasValue && ResourceUpdate.ResourceSortId == item.Id)">
                                @item.Name
                            </option>
                        }
                    </InputSelect>
                </div>
            }

            <div class="w-[160px]">
                <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.status</label>
                <InputSelect @bind-Value="ResourceUpdate.StatusId" class="w-full border border-gray-300 rounded px-2 py-1 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:text-white dark:border-gray-600">
                    @if (Config.Statues != null)
                    {
                        <option value=""></option>
                        @foreach (var status in Config.Statues)
                        {
                            <option value="@status.Id">@status.Name</option>
                        }
                    }
                </InputSelect>
                <ValidationMessage For="@(() => ResourceUpdate.StatusId)" />
            </div>
            <div class="w-[110px]">
                <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.priceSub </label>
                <InputNumber @bind-Value="ResourceUpdate.Data.PriceSub" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" />
                <ValidationMessage For="@(() => ResourceUpdate.Data.PriceSub)" />
            </div>
            <div class="w-[110px]">
                <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.co2 </label>
                <InputNumber @bind-Value="ResourceUpdate.Data.CO2" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" />
                <ValidationMessage For="@(() => ResourceUpdate.Data.CO2)" />
            </div>

            <div class="w-[160px]">
                <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.opportunity</label>
                <InputSelect @bind-Value="ResourceUpdate.OpportunityId" class="w-full border border-gray-300 rounded px-2 py-1 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:text-white dark:border-gray-600">
                    <option></option>
                    @if (Calc.Opportunities != null)
                        foreach (var opportunity in Calc.Opportunities)
                        {
                            <option value="@opportunity.Id">
                                @opportunity.OpportunitiesRisks @opportunity.OpportunityType
                            </option>
                        }
                </InputSelect>
                <ValidationMessage For="@(() => ResourceUpdate.OpportunityId)" />
            </div>
        </div>
    </MhdCard>
    <MhdCard Elevated="true" Compact="true" Class="mb-2">
        <div class="flex items-center justify-between mb-2">
            <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">Parameters</label>
            <button type="button"
                    class="px-2 py-1 border border-blue-600 text-blue-600 rounded transition hover:bg-blue-600 hover:text-white dark:border-blue-400 dark:text-blue-400 dark:hover:bg-blue-400 dark:hover:text-white "
                    @onclick="AddParameter">
                @ResourceApp.newItem
            </button>
        </div>

        @if (!ResourceUpdate.Data.Parameters.Any())
        {
            <div class="text-yellow-600 dark:text-yellow-400">@ResourceApp.thereIsNoElements</div>
        }
        else
        {
            @for (int i = 0; i < ResourceUpdate.Data.Parameters.Count; i++)
            {
                int idx = i;
                <div class="flex flex-wrap gap-2 gap-2 mb-2 items-end">
                    <div class="flex-1 min-w-[160px]">
                        <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.name</label>
                        <InputText class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white"
                                   @bind-Value="ResourceUpdate.Data.Parameters[idx].Name" />
                    </div>

                    <div class="w-[120px]">
                        <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.unit</label>
                        <InputText class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white"
                                   @bind-Value="ResourceUpdate.Data.Parameters[idx].Unit" />
                    </div>

                    <div class="w-[120px]">
                        <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@ResourceLoc.value</label>
                        <InputNumber class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white"
                                     @bind-Value="ResourceUpdate.Data.Parameters[idx].Value" />
                    </div>

                    <div class="w-[52px]">
                        <button type="button"
                                class="px-2 py-1 bg-red-600 text-white rounded hover:bg-red-700 dark:bg-red-500"
                                @onclick="() => RemoveParameter(idx)">
                            @((MarkupString)Icons.DeleteSVG)
                        </button>
                    </div>
                </div>
            }
        }
    </MhdCard>
    @if (Resource?.ResType == ResourceTypesEnum.Worker ||
        Resource?.ResType == ResourceTypesEnum.MachinesAndEquipments)
    {
         <MhdCard Elevated="true" Compact="true" Class="mb-2">
        <div class="flex items-center justify-between mb-2">
            <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">Times</label>
            <button type="button"
                    class="px-2 py-1 border border-blue-600 text-blue-600 rounded transition hover:bg-blue-600 hover:text-white dark:border-blue-400 dark:text-blue-400 dark:hover:bg-blue-400 dark:hover:text-white "
                    @onclick="AddTime">
                @ResourceApp.newItem
            </button>
        </div>

        @if (!ResourceUpdate.Data.Times.Any())
        {
            <div class="text-yellow-600 dark:text-yellow-400">@ResourceApp.thereIsNoElements</div>
        }
        else
        {
            @for (int i = 0; i < ResourceUpdate.Data.Times.Count; i++)
            {
                int idx = i;
                <div class="flex flex-wrap gap-2 gap-2 mb-2 items-end">
                    <div class="flex-1 min-w-[160px]">
                        <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.name</label>
                        <InputText class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white"
                                   @bind-Value="ResourceUpdate.Data.Times[idx].Name" />
                    </div>

                    <div class="w-[100px]">
                        <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@ResourceLoc.value</label>
                        <InputNumber class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white"
                                     @bind-Value="ResourceUpdate.Data.Times[idx].Value" />
                    </div>

                    <div class="w-[100px]">
                        <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.quantity</label>
                        <InputNumber class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white"
                                     @bind-Value="ResourceUpdate.Data.Times[idx].Quantity" />
                    </div>

                    <div class="w-[100px]">
                        <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.cost</label>
                        <InputNumber class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white"
                                     @bind-Value="ResourceUpdate.Data.Times[idx].Cost" />
                    </div>

                    <div class="w-[52px]">
                        <button type="button"
                                class="px-2 py-1 bg-red-600 text-white rounded hover:bg-red-700 dark:bg-red-500"
                                @onclick="() => RemoveTime(idx)">
                            @((MarkupString)Icons.DeleteSVG)
                        </button>
                    </div>
                </div>
            }
        }
    </MhdCard>
   
    }

    @* PANEL 4: الملاحظات *@
    <MhdCard Elevated="true" Compact="true" Class="mb-2">
        <div class="flex flex-wrap gap-2">
            <div class="flex-grow">
                <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.note </label>
                <InputTextArea @bind-Value="ResourceUpdate.Data.Note" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" />
                <ValidationMessage For="@(() => ResourceUpdate.Data.Note)" />
            </div>

            <div class="w-[100px]">
                <button type="button"
                        class="px-2 py-1 bg-blue-600 text-white rounded hover:bg-blue-700 dark:bg-blue-500 mt-7"
                        @onclick="() => ResourceUpdate.Data.UpperNote.Add(string.Empty)">
                    @CalcResource.UpperNote
                </button>
            </div>
        </div>

        @for (int i = 0; i < ResourceUpdate.Data.UpperNote.Count; i++)
        {
            int d = i;
            <div class="flex flex-wrap gap-2 mt-1">
                <div class="flex-grow">
                    <textarea lang="3"
                              @bind="ResourceUpdate.Data.UpperNote[d]"
                              class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white w-full">
                    </textarea>
                </div>
                <div class="w-[100px]">
                    <button type="button"
                            class="px-2 py-1 bg-red-600 text-white rounded hover:bg-red-700 dark:bg-red-500"
                            @onclick="() => ResourceUpdate.Data.UpperNote.RemoveAt(d)">
                        @((MarkupString)@Icons.DeleteSVG)
                    </button>
                </div>
            </div>
        }
    </MhdCard>
</EditForm>

    <div class="mt-1 flex justify-end gap-1">
    @if (Resource?.Id == 0)
    {
        if (PostList.Count > 1)
        {
            <button type="button" class="px-2 py-1 border border-red-600 text-red-600 rounded transition hover:bg-red-600 hover:text-white dark:border-red-400 dark:text-red-400 dark:hover:bg-red-400 dark:hover:text-white " @onclick="()=> PostList.Remove(ResourceUpdate)">@ResourceApp.delete</button>
        }
        <button type="button" class="px-2 py-1 border border-blue-600 text-blue-600 rounded transition hover:bg-blue-600 hover:text-white dark:border-blue-400 dark:text-blue-400 dark:hover:bg-blue-400 dark:hover:text-white " @onclick="NewSP">@ResourceApp.newItem</button>
    }
    <button type="submit" class="px-2 py-1 border border-green-600 text-green-600 rounded transition hover:bg-green-600 hover:text-white dark:border-green-400 dark:text-green-400 dark:hover:bg-green-400 dark:hover:text-white " form="resForm" disabled="@btnSubmitDisabled">@ResourceApp.save</button>
    <button type="button" class="px-2 py-1 border border-gray-500 text-gray-500 rounded transition hover:bg-gray-500 hover:text-white dark:border-gray-400 dark:text-gray-400 dark:hover:bg-gray-400 dark:hover:text-white " @onclick="Close">@ResourceApp.cancel</button>
    </div>
    @code{
    private void AddParameter()
    {
        ResourceUpdate.Data.Parameters.Add(new ResourceParameter
        {
            Name = string.Empty,
            Unit = string.Empty,
            Value = 1
        });
    }

    private void RemoveParameter(int index)
    {
        if (index < 0 || index >= ResourceUpdate.Data.Parameters.Count) return;
        ResourceUpdate.Data.Parameters.RemoveAt(index);
    }

    private void AddTime()
    {
        ResourceUpdate.Data.Times.Add(new ResourceTime
        {
            Name = string.Empty,
            Value = 1,
            Quantity = 1,
            Cost = 1
        });
    }

    private void RemoveTime(int index)
    {
        if (index < 0 || index >= ResourceUpdate.Data.Times.Count) return;
        ResourceUpdate.Data.Times.RemoveAt(index);
    }

    }
