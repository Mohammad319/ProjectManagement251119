@using ProjectManagement.Client.Shared.MVVM.Calculation
@using ProjectManagement.Client.Shared.Model.Project.Calculation;
@using ProjectManagement.Client.Shared.Repositories.Calculation
@using ProjectManagement.Shared.Base.Calculation
@using ProjectManagement.Shared.DTO.Calculation
@attribute [Authorize(Roles = PMRolesConst.Tenant.AdminManger)]
@inherits AppComponentBase


<EditForm id="taskForm"
          Model="@TaskUpdate"
          OnValidSubmit="async()=> await HandleSubmitAsync()">

    @if (Task.Id == 0 && PostList.Count > 1)
    {
        <div>
            <ul class="nav nav-pills mb-3" id="pills-tab" role="tablist">
                @for (int i = 0; i < PostList.Count; i++)
                {
                    int x = i;
                    <li class="nav-item" role="presentation">
                        <button @onclick="() => TaskUpdate = PostList[x]" class="nav-link active" type="button" role="tab">@(i + 1)</button>
                    </li>
                }
            </ul>
        </div>
    }

    <DataAnnotationsValidator />

    <MhdCard Elevated="true" Compact="true" Class="mb-2">
        <div class="flex flex-wrap gap-2">
            <div class="w-[200px]">
                <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.code</label>
                <InputText @bind-Value="TaskUpdate.Metadata.Code" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" />
                <ValidationMessage For="@(() => TaskUpdate.Metadata.Code)" />
            </div>
            <div class="flex-1 min-w-[350px]">
                <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.name </label>
                <InputText @bind-Value="TaskUpdate.Name" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" />
                <ValidationMessage For="@(() => TaskUpdate.Name)" />
            </div>
        </div>
    </MhdCard>

    <MhdCard Elevated="true" Compact="true" Class="mb-2">
        <div class="flex flex-wrap gap-2">
            @if (!TaskUpdate.OnlyCodeText)
            {
                    <div class="@(TaskUpdate.Metadata.QuantityParam == ConstValues.FixedQ ? "w-[110px]" : "w-[200px]")">

                    <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.quantity</label>
                    <div class="w-full inline-flex">
                        <InputSelect class="w-full border border-gray-300 rounded px-2 py-1 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:text-white dark:border-gray-600"
                                     @bind-Value:get="TaskUpdate.Metadata.QuantityParam"
                                     @bind-Value:set="(value) => ChangeQuantityParam(value)">
                            <option></option>
                            <option value="@ConstValues.FixedQ">@CalcResource.fixedQ</option>
                            @if (Calc.QuanityList != null)
                                foreach (var status in Calc.QuanityList)
                                {
                                    <option value="@status.Name">@status.Name (@status.Quantity)</option>
                                }
                        </InputSelect>

                        @if (TaskUpdate.Metadata.QuantityParam == ConstValues.FixedQ)
                        {
                            <InputNumber @bind-Value="TaskUpdate.Metadata.Quantity" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" />
                        }
                    </div>
                </div>

                <div class="w-[110px]">
                    <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.unit</label>
                    <InputText @bind-Value="TaskUpdate.Metadata.Unit" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" />
                    <ValidationMessage For="@(() => TaskUpdate.Metadata.Unit)" />
                </div>

                @if (Task.Tasks == null || Task.Tasks.Count == 0)
                {
                    <div class="w-[110px]">
                        <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.cap </label>
                        <InputNumber @bind-Value="TaskUpdate.Metadata.Ca‌​p" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" />
                        <ValidationMessage For="@(() => TaskUpdate.Metadata.Cap)" />
                    </div>
                }

                @if (TaskUpdate.ParentTaskId.HasValue)
                {
                    <div class="w-[130px]">
                        <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.changeFactor1</label>
                        <InputNumber @bind-Value="TaskUpdate.Metadata.ChangeFactor1" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" />
                        <ValidationMessage For="@(() => TaskUpdate.Metadata.ChangeFactor1)" />
                    </div>
                    <div class="w-[130px]">
                        <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.changeFactor2 </label>
                        <InputNumber @bind-Value="TaskUpdate.Metadata.ChangeFactor2" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" />
                        <ValidationMessage For="@(() => TaskUpdate.Metadata.ChangeFactor2)" />
                    </div>
                }
                <div class="w-[110px]">
                    <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">ActuallyQuantity </label>
                    <InputNumber @bind-Value="TaskUpdate.Metadata.ActuallyQuantity" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" />
                    <ValidationMessage For="@(() => TaskUpdate.Metadata.ActuallyQuantity)" />
                </div>
                <div class="w-[110px]">
                    <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">WorkedQ </label>
                    <InputNumber @bind-Value="TaskUpdate.Metadata.WorkedQ" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" />
                    <ValidationMessage For="@(() => TaskUpdate.Metadata.WorkedQ)" />
                </div>

                <div class="w-[110px]">
                    <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.priceSub </label>
                    <InputNumber @bind-Value="TaskUpdate.Metadata.PriceSubDB" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" />
                    <ValidationMessage For="@(() => TaskUpdate.Metadata.PriceSubDB)" />
                </div>
                <div class="w-[110px]">
                    <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.minPrice </label>
                    <InputNumber @bind-Value="TaskUpdate.Metadata.MinPrice" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" />
                    <ValidationMessage For="@(() => TaskUpdate.Metadata.MinPrice)" />
                </div>
                <div class="w-[110px]">
                    <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.ceilingPrice </label>
                    <InputNumber @bind-Value="TaskUpdate.Metadata.CeilingPrice" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" />
                    <ValidationMessage For="@(() => TaskUpdate.Metadata.CeilingPrice)" />
                </div>
            }

            @if (Task.Resources == null || Task.Resources.Count == 0 || Task.Type == TaskType.CodeName)
            {
                <div class="w-[160px]">
                    <div class="flex items-center gap-2 mt-1 md:mt-6">
                        <InputCheckbox @bind-Value="TaskUpdate.OnlyCodeText" class="h-4 w-4 text-blue-600 rounded focus:ring-blue-500 dark:text-blue-400" />
                        <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">Only Code Text</label>
                    </div>
                </div>
            }
        </div>
    </MhdCard>

    @if (!TaskUpdate.OnlyCodeText)
    {
        <MhdCard Elevated="true" Compact="true" Class="mb-2">
            <div class="flex flex-wrap gap-2">
                <div class="w-[160px]">
                    <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.status</label>
                    <InputSelect @bind-Value="TaskUpdate.StatusId" class="w-full border border-gray-300 rounded px-2 py-1 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:text-white dark:border-gray-600">
                        <option></option>
                        @if (Statuses != null)
                            foreach (var status in Statuses)
                            {
                                <option value="@status.Id">@status.Name</option>
                            }
                    </InputSelect>
                    <ValidationMessage For="@(() => TaskUpdate.StatusId)" />
                </div>

                <div class="w-[160px]">
                    <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.opportunity</label>
                    <InputSelect @bind-Value="TaskUpdate.OpportunityId" class="w-full border border-gray-300 rounded px-2 py-1 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:text-white dark:border-gray-600">
                        <option></option>
                        @if (Calc.Opportunities != null)
                            foreach (var opportunity in Calc.Opportunities)
                            {
                                <option value="@opportunity.Id">@opportunity.OpportunitiesRisks @opportunity.OpportunityType</option>
                            }
                    </InputSelect>
                    <ValidationMessage For="@(() => TaskUpdate.OpportunityId)" />
                </div>

                <div class="w-[200px]">
                    <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.responsible</label>
                    <InputText @bind-Value="TaskUpdate.Metadata.Responsible" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" />
                    <ValidationMessage For="@(() => TaskUpdate.Metadata.Responsible)" />
                </div>

                <div class="w-[110px]">
                    <div class="flex items-center gap-2 mt-1 md:mt-6">
                        <InputCheckbox class="h-4 w-4 text-blue-600 rounded focus:ring-blue-500 dark:text-blue-400" @bind-Value="TaskUpdate.Metadata.PriceSubInPrecent" />
                        <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">
                            @ResourceLoc.inprecent
                        </label>
                    </div>
                </div>

                <div class="w-[110px]">
                    <div class="flex items-center gap-2 mt-1 md:mt-6">
                        <InputCheckbox @bind-Value="TaskUpdate.IsActive" class="h-4 w-4 text-blue-600 rounded focus:ring-blue-500 dark:text-blue-400" />
                        <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.active</label>
                    </div>
                </div>
            </div>
        </MhdCard>
    }

    <MhdCard Elevated="true" Compact="true" Class="mb-2">
        <div class="flex flex-wrap gap-2">
            <div class="flex-grow">
                <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.note </label>
                <InputTextArea @bind-Value="TaskUpdate.Metadata.Note" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" />
                <ValidationMessage For="@(() => TaskUpdate.Metadata.Note)" />
            </div>
            <div class="w-[100px]">
                <button type="button"
                        class="px-2 py-1 bg-blue-600 text-white rounded hover:bg-blue-700 dark:bg-blue-500 mt-7"
                        @onclick="() => TaskUpdate.Metadata.UpperNote.Add(string.Empty)">
                    @CalcResource.UpperNote
                </button>
            </div>
        </div>

        @for (int i = 0; i < TaskUpdate.Metadata.UpperNote.Count; i++)
        {
            int d = i;
            <div class="flex flex-wrap gap-2 mt-1">
                <div class="flex-grow">
                    <textarea lang="3" @bind="TaskUpdate.Metadata.UpperNote[d]" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white"></textarea>
                </div>
                <div class="w-[100px]">
                    <button type="button"
                            class="px-2 py-1 bg-red-600 text-white rounded hover:bg-red-700 dark:bg-red-500"
                            @onclick="() => TaskUpdate.Metadata.UpperNote.RemoveAt(d)">
                        @((MarkupString)@Icons.DeleteSVG)
                    </button>
                </div>
            </div>
        }
    </MhdCard>
</EditForm>


<div class="mt-1 flex justify-end gap-1">
    @if (Task.Id == 0)
    {
        if (PostList.Count > 1)
        {
            <button type="button" class="px-2 py-1 border border-red-600 text-red-600 rounded transition hover:bg-red-600 hover:text-white dark:border-red-400 dark:text-red-400 dark:hover:bg-red-400 dark:hover:text-white " @onclick="() => PostList.Remove(TaskUpdate)">@ResourceApp.delete</button>
        }
        <button type="button" class="px-2 py-1 border border-blue-600 text-blue-600 rounded transition hover:bg-blue-600 hover:text-white dark:border-blue-400 dark:text-blue-400 dark:hover:bg-blue-400 dark:hover:text-white " @onclick="NewSP">@ResourceApp.newItem</button>
    }
    <button type="submit" class="px-2 py-1 border border-green-600 text-green-600 rounded transition hover:bg-green-600 hover:text-white dark:border-green-400 dark:text-green-400 dark:hover:bg-green-400 dark:hover:text-white " form="taskForm" disabled="@btnSubmitDisabled">
        @ResourceApp.save
    </button>
    <button type="button" class="px-2 py-1 border border-gray-500 text-gray-500 rounded transition hover:bg-gray-500 hover:text-white dark:border-gray-400 dark:text-gray-400 dark:hover:bg-gray-400 dark:hover:text-white " @onclick="Close">@ResourceApp.cancel</button>
</div>


@code {
    List<TaskPostDTO> PostList = new();
    bool btnSubmitDisabled = false;
    List<ListOrderDTO>? Statuses;
    [Parameter] public TaskListMVVM Task { get; set; } = default!;
    TaskPostDTO TaskUpdate = new();

    void NewSP()
    {
        TaskPostDTO p = new();
        TaskUpdate.CopyPropertiesTo(p);
        PostList.Insert(0, p);
    }

    private void ChangeQuantityParam(string qp)
    {
        TaskUpdate.Metadata.QuantityParam = qp;
        if (string.IsNullOrEmpty(qp)) TaskUpdate.Metadata.Quantity = null;
        else if (qp != ConstValues.FixedQ) TaskUpdate.Metadata.Quantity = Calc.QuanityList?.FirstOrDefault(x => x.Name == qp)?.Quantity;
    }

    protected async override Task OnInitializedAsync()
    {
        TaskUpdate = TaskConvert.GetToPost(Task);
        TaskUpdate.OnlyCodeText = TaskUpdate.Metadata.Type == TaskType.CodeName;

        if (Task.Id == 0) PostList.Add(TaskUpdate);
        Statuses = (await Repo.Task.GetAsync()).ToList();
        if (Calc.Opportunities == null)
            Calc.Opportunities = await Repo.Opportunity.GetAsync(Calc.Id);
    }

    void UpdateStatus(TaskListMVVM task)
    {
        var st = Statuses?.FirstOrDefault(x => x.Id == TaskUpdate.StatusId);
        task.Status = st?.Name;
        task.StatusColor = st?.Color;
    }

    void CheckTaskType(TaskPostDTO po)
    {
        if (po.OnlyCodeText)
        {
            po.Metadata.Type = TaskType.CodeName;
            po.Metadata.QuantityParam = string.Empty;
            po.Metadata.Quantity = null;
        }
        else po.Metadata.Type = TaskType.Task;
    }

    async Task HandleSubmitAsync()
    {
        btnSubmitDisabled = true;
        bool hasSuccess = false;
        try
        {
            if (Task.Id > 0)
            {
                CheckTaskType(TaskUpdate);
                hasSuccess = await Repo.Task.UpdateAsync(TaskUpdate, Task.Id);
            }
            else
            {
                int maxOrder = 0;
                var siblingTasks = Calc.Tasks.Where(x => x.TaskId == Task.TaskId).ToList();
                if (siblingTasks.Count > 0)
                    maxOrder = siblingTasks.Max(x => x.Order) + 100;
                foreach (var item in PostList)
                {
                    CheckTaskType(item);
                    item.Order = maxOrder;
                    maxOrder += 100;
                    item.Metadata.IsOH = Calc.OHFactors;
                }
                hasSuccess = await Repo.Task.CreateAsync(PostList, Calc.Id);
            }
            MHD.Notifications(Task.Id == 0 ? ToastType.Add : ToastType.Update, hasSuccess);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        Close();
    }

    void Close() => Modal.Close();
}