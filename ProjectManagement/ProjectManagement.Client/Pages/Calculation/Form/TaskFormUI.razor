@using ProjectManagement.Client.Shared.MVVM.Calculation
@using ProjectManagement.Client.Shared.Model.Project.Calculation;
@using ProjectManagement.Client.Shared.Repositories.Calculation
@using ProjectManagement.Shared.Base.Calculation
@using ProjectManagement.Shared.DTO.Calculation
@attribute [Authorize(Roles = PMRolesConst.Tenant.AdminManger)]
@inherits AppComponentBase
@implements IDisposable


<EditForm @key="editContext"
          id="@DialogFormId"
          EditContext="editContext!"
          OnValidSubmit="async()=> await HandleSubmitAsync()">

    @if (Task.Id == 0 && PostList.Count > 1)
    {
        <div>
            <ul class="nav nav-pills mb-2" id="pills-tab" role="tablist">
                @for (int i = 0; i < PostList.Count; i++)
                {
                    int x = i;
                    <li class="nav-item" role="presentation">
                        <button @onclick="() => SetActiveTask(PostList[x])" class="nav-link active" type="button" role="tab">@(i + 1)</button>
                    </li>
                }
            </ul>
        </div>
    }

    <DataAnnotationsValidator />
    <FormValidationSummary />

    <MhdCard Elevated="true" Compact="true" Class="mb-1.5">
        <div class="grid gap-x-2 gap-y-1.5 md:grid-cols-[180px_minmax(0,1fr)]">
            <div class="min-w-0">
                <label class="@LabelClass">@CalcResource.code</label>
                <InputText @bind-Value="TaskUpdate.Metadata.Code" class="@InputClass" />
            </div>

            <div class="min-w-0">
                <label class="@LabelClass">@CalcResource.name </label>
                <InputText @bind-Value="TaskUpdate.Name" class="@InputClass" />
            </div>
        </div>
    </MhdCard>

    <MhdCard Elevated="true" Compact="true" Class="mb-1.5">
        <div class="grid gap-x-2 gap-y-1.5 md:grid-cols-12">
            @if (!TaskUpdate.OnlyCodeText)
            {
                <div class="min-w-0 md:col-span-12 xl:col-span-5">
                    <label class="@LabelClass">@CalcResource.quantity</label>
                    @if (HasTaskAbove)
                    {
                        <div class="grid items-start gap-1.5 @(TaskUpdate.Metadata.QuantityParam == ConstValues.FixedQ ? "grid-cols-[minmax(0,1fr)_7.25rem]" : "grid-cols-1")">
                            <InputSelect class="@InputClass"
                                         @bind-Value:get="TaskUpdate.Metadata.QuantityParam"
                                         @bind-Value:set="(value) => ChangeQuantityParam(value)">
                                @if (!ParentIsOnlyCodeText)
                                {
                                    <option></option>
                                }
                                <option value="@ConstValues.FixedQ">@CalcResource.fixedQ</option>
                                @if (Calc.QuanityList != null)
                                {
                                    foreach (var status in Calc.QuanityList)
                                    {
                                        <option value="@status.Name">@status.Name (@status.Quantity)</option>
                                    }
                                }
                            </InputSelect>

                            @if (TaskUpdate.Metadata.QuantityParam == ConstValues.FixedQ)
                            {
                                <TrimmedNumberInput TValue="decimal?" @bind-Value="TaskUpdate.Metadata.BaseQuantity" class="@InputClass" />
                            }
                        </div>
                    }
                    else
                    {
                        <div class="grid items-start gap-1.5 grid-cols-[7.25rem_minmax(0,1fr)]">
                            <input class="@DisabledInputClass" value="@CalcResource.fixedQ" disabled />
                            <TrimmedNumberInput TValue="decimal?" @bind-Value="TaskUpdate.Metadata.BaseQuantity" class="@InputClass" />
                        </div>
                    }
                </div>

                <div class="min-w-0 md:col-span-4 xl:col-span-3">
                    <label class="@LabelClass">@(TaskUpdate.Metadata.ConversionParameters.Any() ? CalcResource.newUnit : CalcResource.unit)</label>
                    <InputText @bind-Value="TaskUpdate.Metadata.Unit" class="@InputClass" />
                </div>

                @if (ShowTaskCapInput || true)
                {
                    <div class="min-w-0 md:col-span-3 xl:col-span-2">
                        <label class="@LabelClass">@CalcResource.cap </label>
                        <TrimmedNumberInput TValue="decimal?" @bind-Value="TaskUpdate.Metadata.Cap" class="@InputClass" />
                    </div>
                }
@* 
                @if (HasTaskAbove)
                {
                    <div class="min-w-0 md:col-span-3 xl:col-span-2">
                        <label class="@LabelClass">@CalcResource.changeFactor1</label>
                        <TrimmedNumberInput TValue="decimal" @bind-Value="TaskUpdate.Metadata.ChangeFactor1" class="@InputClass" />
                    </div>
                } *@

                <div class="min-w-0 md:col-span-3 xl:col-span-2">
                    <label class="@LabelClass">@CalcResource.changeFactor2 </label>
                    @if (TaskUpdate.Metadata.ConversionParameters.Any())
                    {
                        <TrimmedNumberInput TValue="decimal" @bind-Value="TaskUpdate.Metadata.ChangeFactor2" class="@DisabledInputClass" disabled />
                    }
                    else
                    {
                        <TrimmedNumberInput TValue="decimal" @bind-Value="TaskUpdate.Metadata.ChangeFactor2" class="@InputClass" />
                    }
                </div>

                <div class="min-w-0 md:col-span-3 xl:col-span-2">
                    <label class="@LabelClass">@AppLoc["actuallyQuantity"]</label>
                    <TrimmedNumberInput TValue="decimal?" @bind-Value="_actuallyQuantity" class="@InputClass" />
                </div>

                <div class="min-w-0 md:col-span-3 xl:col-span-2">
                    <label class="@LabelClass">@AppLoc["workedQuantity"]</label>
                    <TrimmedNumberInput TValue="decimal?" @bind-Value="_workedQ" class="@InputClass" />
                </div>

                <div class="min-w-0 md:col-span-3 xl:col-span-2">
                    <label class="@LabelClass">@CalcResource.priceProduction</label>
                    <TrimmedNumberInput TValue="decimal?" @bind-Value="TaskUpdate.Metadata.PriceProductionDB" class="@InputClass" />
                </div>

                <div class="min-w-0 md:col-span-3 xl:col-span-2">
                    <label class="@LabelClass">@CalcResource.priceSub </label>
                    <TrimmedNumberInput TValue="decimal?" @bind-Value="TaskUpdate.Metadata.PriceSubDB" class="@InputClass" />
                </div>

                <div class="min-w-0 md:col-span-3 xl:col-span-2">
                    <label class="@LabelClass">@CalcResource.minPrice </label>
                    <TrimmedNumberInput TValue="decimal?" @bind-Value="TaskUpdate.Metadata.MinPrice" class="@InputClass" />
                </div>

                <div class="min-w-0 md:col-span-3 xl:col-span-2">
                    <label class="@LabelClass">@CalcResource.ceilingPrice </label>
                    <TrimmedNumberInput TValue="decimal?" @bind-Value="TaskUpdate.Metadata.CeilingPrice" class="@InputClass" />
                </div>
            }
        </div>
    </MhdCard>

    @if (!TaskUpdate.OnlyCodeText)
    {
        <MhdCard Elevated="true" Compact="true" Class="mb-1.5">
            <div class="grid gap-x-2 gap-y-1.5 md:grid-cols-12">
                <div class="min-w-0 md:col-span-4 xl:col-span-3">
                    <label class="@LabelClass">@CalcResource.status</label>
                    <InputSelect @bind-Value="TaskUpdate.StatusId" class="@InputClass">
                        <option></option>
                        @if (Statuses != null)
                        {
                            foreach (var status in Statuses)
                            {
                                <option value="@status.Id">@status.Name</option>
                            }
                        }
                    </InputSelect>
                </div>

                <div class="min-w-0 md:col-span-8 xl:col-span-5">
                    <label class="@LabelClass">@CalcResource.opportunity</label>
                    <InputSelect @bind-Value="TaskUpdate.OpportunityId" class="@InputClass">
                        <option></option>
                        @if (Calc.Opportunities != null)
                        {
                            foreach (var opportunity in Calc.Opportunities)
                            {
                                <option value="@opportunity.Id">@opportunity.OpportunitiesRisks @opportunity.OpportunityType</option>
                            }
                        }
                    </InputSelect>
                </div>

                <div class="min-w-0 md:col-span-6 xl:col-span-4">
                    <label class="@LabelClass">@CalcResource.responsible</label>
                    <InputText @bind-Value="TaskUpdate.Metadata.Responsible" class="@InputClass" />
                </div>

                <div class="min-w-0 md:col-span-3 xl:col-span-2">
                    <label class="@CheckboxCardClass">
                        <InputCheckbox class="@CheckboxClass" @bind-Value="TaskUpdate.Metadata.PriceSubInPrecent" />
                        <span>@ResourceLoc.inprecent</span>
                    </label>
                </div>

                <div class="min-w-0 md:col-span-3 xl:col-span-2">
                    <label class="@CheckboxCardClass">
                        <InputCheckbox @bind-Value="TaskUpdate.IsActive" class="@CheckboxClass" />
                        <span>@CalcResource.active</span>
                    </label>
                </div>
                
                @if (Task.Resources == null || Task.Resources.Count == 0 || Task.Type == TaskType.CodeName)
                {
               
                    <div class="min-w-0 flex items-end md:col-span-4 xl:col-span-3">
                        <label class="@CheckboxCardClass">
                            <InputCheckbox @bind-Value="TaskUpdate.OnlyCodeText"
                                           class="@CheckboxClass" />
                            <span>@AppLoc["onlyCodeText"]</span>
                        </label>
                    </div>
                }
            </div>
        </MhdCard>
    }

    <MhdCard Elevated="true" Compact="true" Class="mb-1.5">
        <div class="grid gap-y-2">
            <div class="flex items-center justify-between gap-2">
                <div class="min-w-0">
                    <div class="text-[12px] font-semibold text-slate-800 dark:text-slate-100">Mängdomräkningsparametrar</div>
                    <div class="text-[11px] text-slate-500 dark:text-slate-400">
                        Använd parametrar för att räkna om uppgiftens egen mängd eller en överordnad mängd, till exempel bredd, djup eller tjocklek.
                    </div>
                </div>

                @if (!TaskUpdate.OnlyCodeText)
                {
                    <div class="flex items-end gap-2">
                        @if (TaskUpdate.Metadata.ConversionParameters.Any())
                        {
                            <div class="w-[110px]">
                                <label class="@LabelClass">Basenhet</label>
                                <InputText @bind-Value="TaskUpdate.Metadata.BaseUnit" class="@InputClass" />
                            </div>
                        }

                        <button type="button"
                                class="@OutlineBlueButtonClass"
                                @onclick="AddConversionParameter">
                            Ny parameter
                        </button>
                    </div>
                }
            </div>

            @if (!TaskUpdate.OnlyCodeText)
            {
                @if (!TaskUpdate.Metadata.ConversionParameters.Any())
                {
                    <div class="rounded-md border border-dashed border-slate-300 bg-slate-50 px-3 py-2 text-[12px] text-slate-500 dark:border-slate-700 dark:bg-slate-800/60 dark:text-slate-400">
                        Inga omräkningsparametrar ännu. Lämna listan tom om du vill skriva in Mängdomräkningsfaktor manuellt.
                    </div>
                }
                else
                {
                    <div class="grid gap-2">
                        @for (int i = 0; i < TaskUpdate.Metadata.ConversionParameters.Count; i++)
                        {
                            var idx = i;
                            <div class="grid gap-2 rounded-md border border-slate-200 bg-slate-50 p-2 dark:border-slate-700 dark:bg-slate-800/60 md:grid-cols-[minmax(0,1.4fr)_110px_110px_auto]">
                                <div class="min-w-0">
                                    <label class="@LabelClass">@CalcResource.name</label>
                                    <InputText @bind-Value="TaskUpdate.Metadata.ConversionParameters[idx].Name" class="@InputClass" />
                                </div>
                                <div class="min-w-0">
                                    <label class="@LabelClass">Värde</label>
                                    <TrimmedNumberInput TValue="decimal"
                                                 @bind-Value="TaskUpdate.Metadata.ConversionParameters[idx].Value"
                                                 class="@InputClass"
                                                 @bind-Value:after="RecalculateConversionFactor" />
                                </div>
                                <div class="min-w-0">
                                    <label class="@LabelClass">@CalcResource.unit</label>
                                    <InputText @bind-Value="TaskUpdate.Metadata.ConversionParameters[idx].Unit" class="@InputClass" />
                                </div>
                                <div class="flex items-end justify-end">
                                    <button type="button" class="@OutlineRedButtonClass" @onclick="() => RemoveConversionParameter(idx)">Ta bort</button>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <div class="rounded-md border border-dashed border-slate-300 bg-slate-50 px-3 py-2 text-[12px] text-slate-500 dark:border-slate-700 dark:bg-slate-800/60 dark:text-slate-400">
                    Omräkningsparametrar används inte för kodrader.
                </div>
            }
        </div>
    </MhdCard>

    <MhdCard Elevated="true" Compact="true" Class="mb-1.5">
        <div class="grid gap-x-2 gap-y-1.5 md:grid-cols-[minmax(0,1fr)_auto] md:items-start">
            <div class="min-w-0">
                <label class="@LabelClass">@CalcResource.note </label>
                <InputTextArea @bind-Value="TaskUpdate.Metadata.Note" class="@TextAreaClass" />
            </div>

            <div class="md:pt-7">
                <button type="button"
                        class="@PrimaryBlueButtonClass"
                        @onclick="() => TaskUpdate.Metadata.UpperNote.Add(string.Empty)">
                    @CalcResource.UpperNote
                </button>
            </div>
        </div>

        @for (int i = 0; i < TaskUpdate.Metadata.UpperNote.Count; i++)
        {
            int d = i;
            <div class="mt-2 grid gap-2 rounded-xl border border-slate-200 bg-slate-50 p-2.5 dark:border-slate-700 dark:bg-slate-800/60 md:grid-cols-[minmax(0,1fr)_auto] md:items-start">
                <div class="min-w-0">
                    <textarea rows="3" @bind="TaskUpdate.Metadata.UpperNote[d]" class="@TextAreaClass"></textarea>
                </div>

                <div class="md:pt-1">
                    <button type="button"
                            class="@DeleteButtonClass"
                            @onclick="() => TaskUpdate.Metadata.UpperNote.RemoveAt(d)">
                        @((MarkupString)@Icons.DeleteSVG)
                    </button>
                </div>
            </div>
        }
    </MhdCard>
</EditForm>


@if (Task.Id == 0)
{
    <div class="mt-1 flex flex-wrap justify-end gap-2">
        @if (PostList.Count > 1)
        {
            <button type="button" class="@OutlineRedButtonClass" @onclick="RemoveCurrentTask">@ResourceApp.delete</button>
        }
        <button type="button" class="@OutlineBlueButtonClass" @onclick="NewSP">@ResourceApp.newItem</button>
    </div>
}


@code {
    private string LabelClass => "mb-0.5 block text-[11px] font-medium leading-tight text-slate-700 dark:text-slate-200";
    private string InputClass => "h-6 w-full rounded-md border border-slate-300 bg-white px-1 py-0.5 text-[13px] leading-tight text-slate-900 shadow-sm transition focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-white dark:focus:border-blue-400";
    private string DisabledInputClass => "h-6 w-full rounded-md border border-slate-200 bg-slate-100 px-1 py-0.5 text-[13px] leading-tight text-slate-500 shadow-sm dark:border-slate-600 dark:bg-slate-700 dark:text-slate-300";
    private string TextAreaClass => "min-h-[4rem] w-full rounded-md border border-slate-300 bg-white px-1 py-0.5 text-[13px] leading-tight text-slate-900 shadow-sm transition focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-white dark:focus:border-blue-400";
    private string CheckboxCardClass => "inline-flex min-h-6 max-w-full cursor-pointer items-center gap-1 rounded-md border border-slate-200 bg-slate-50 px-2.5 py-1 text-[13px] font-medium leading-tight text-slate-700 shadow-sm transition hover:border-slate-300 dark:border-slate-700 dark:bg-slate-800/80 dark:text-slate-200 dark:hover:border-slate-500";
    private string CheckboxClass => "h-3.5 w-3.5 rounded border-slate-300 text-blue-600 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-500 dark:bg-slate-900 dark:text-blue-400";
    private string PrimaryBlueButtonClass => "inline-flex h-6 items-center justify-center rounded-md bg-blue-600 px-1 text-sm font-medium text-white transition hover:bg-blue-700 dark:bg-blue-500";
    private string OutlineBlueButtonClass => "inline-flex h-6 items-center justify-center rounded-md border border-blue-600 px-1 text-sm font-medium text-blue-600 transition hover:bg-blue-600 hover:text-white dark:border-blue-400 dark:text-blue-300";
    private string OutlineRedButtonClass => "inline-flex h-6 items-center justify-center rounded-md border border-red-600 px-1 text-sm font-medium text-red-600 transition hover:bg-red-600 hover:text-white dark:border-red-400 dark:text-red-300";
    private string DeleteButtonClass => "inline-flex h-6 items-center justify-center rounded-md bg-red-600 px-3 text-sm font-medium text-white transition hover:bg-red-700 dark:bg-red-500";

    public const string DialogFormId = "taskForm";
    List<TaskPostDTO> PostList = new();
    bool btnSubmitDisabled = false;
    List<ListOrderDTO>? Statuses;
    [Parameter] public TaskListMVVM Task { get; set; } = default!;
    TaskPostDTO TaskUpdate = new();
    private EditContext? editContext;

    // Nullable wrappers: empty field = treat as 0 in calculations
    private decimal? _actuallyQuantity;
    private decimal? _workedQ;

    private void SyncMetadataToWrappers()
    {
        _actuallyQuantity = TaskUpdate.Metadata.ActuallyQuantity == 0m ? null : TaskUpdate.Metadata.ActuallyQuantity;
        _workedQ = TaskUpdate.Metadata.WorkedQ == 0m ? null : TaskUpdate.Metadata.WorkedQ;
    }

    private void SyncWrappersToMetadata()
    {
        TaskUpdate.Metadata.ActuallyQuantity = _actuallyQuantity ?? 0m;
        TaskUpdate.Metadata.WorkedQ = _workedQ ?? 0m;
    }
    private ValidationMessageStore? messageStore;
    private bool HasTaskAbove => HasParentTask(TaskUpdate);
    private bool ParentIsOnlyCodeText => IsParentOnlyCodeText(TaskUpdate);
    private bool ShowExpandedTaskQuantity => !HasTaskAbove || TaskUpdate.Metadata.QuantityParam == ConstValues.FixedQ;
    private bool ShowTaskCapInput => CanEditTaskCap(Task?.Resources);
    private FieldIdentifier BaseQuantityField => new(TaskUpdate.Metadata, nameof(TaskMetadata.BaseQuantity));

    void NewSP()
    {
        TaskPostDTO p = new();
        TaskUpdate.CopyPropertiesTo(p);
        ApplyTaskFormRules(p);
        EnsureConversionParameters(p);
        EnsureBaseQuantity(p);

        if (p.Metadata.ConversionParameters.Any() && string.IsNullOrWhiteSpace(p.Metadata.BaseUnit))
            p.Metadata.BaseUnit = p.Metadata.Unit;

        if (p.Metadata.ConversionParameters.Any())
            p.Metadata.SyncConversionFactorFromParameters();

        PostList.Insert(0, p);
        SetActiveTask(p);
    }

    private void SetActiveTask(TaskPostDTO task)
    {
        if (ReferenceEquals(TaskUpdate, task) && editContext is not null)
            return;

        SyncWrappersToMetadata();
        DetachEditContext();
        TaskUpdate = task;
        SyncMetadataToWrappers();
        ConfigureEditContext();
    }

    private void RemoveCurrentTask()
    {
        if (PostList.Count <= 1)
            return;

        var index = PostList.IndexOf(TaskUpdate);
        if (index < 0)
            return;

        PostList.RemoveAt(index);

        if (PostList.Count > 0)
            SetActiveTask(PostList[Math.Clamp(index - 1, 0, PostList.Count - 1)]);
    }

    private void ChangeQuantityParam(string qp)
    {
        if (!HasTaskAbove)
        {
            TaskUpdate.Metadata.QuantityParam = ConstValues.FixedQ;
            return;
        }

        TaskUpdate.Metadata.QuantityParam = qp;
        if (string.IsNullOrEmpty(qp))
            TaskUpdate.Metadata.Quantity = null;
        else if (qp != ConstValues.FixedQ)
            TaskUpdate.Metadata.Quantity = Calc.QuanityList?.FirstOrDefault(x => x.Name == qp)?.Quantity;
        else if (!TaskUpdate.Metadata.BaseQuantity.HasValue)
            TaskUpdate.Metadata.BaseQuantity = TaskUpdate.Metadata.Quantity;
    }

    private static void EnsureConversionParameters(TaskPostDTO task)
    {
        task.Metadata.ConversionParameters ??= [];
    }

    private static void EnsureBaseQuantity(TaskPostDTO task)
    {
        if (!task.Metadata.BaseQuantity.HasValue && task.Metadata.Quantity.HasValue)
            task.Metadata.BaseQuantity = task.Metadata.Quantity;
    }

    private void AddConversionParameter()
    {
        EnsureConversionParameters(TaskUpdate);

        if (!TaskUpdate.Metadata.BaseQuantity.HasValue)
            TaskUpdate.Metadata.BaseQuantity = TaskUpdate.Metadata.Quantity;

        if (string.IsNullOrWhiteSpace(TaskUpdate.Metadata.BaseUnit))
            TaskUpdate.Metadata.BaseUnit = TaskUpdate.Metadata.Unit;

        TaskUpdate.Metadata.ConversionParameters.Add(new TaskConversionParameter
        {
            Name = string.Empty,
            Unit = string.Empty,
            Value = 1m
        });

        RecalculateConversionFactor();
    }
    private void RemoveConversionParameter(int index)
    {
        if (TaskUpdate.Metadata.ConversionParameters is null)
            return;
        if (index < 0 || index >= TaskUpdate.Metadata.ConversionParameters.Count)
            return;

        TaskUpdate.Metadata.ConversionParameters.RemoveAt(index);

        if (!TaskUpdate.Metadata.ConversionParameters.Any())
            TaskUpdate.Metadata.BaseUnit = string.Empty;

        RecalculateConversionFactor();
    }

    private void RecalculateConversionFactor()
    {
        if (TaskUpdate.Metadata.ConversionParameters is not { Count: > 0 })
            return;

        TaskUpdate.Metadata.SyncConversionFactorFromParameters();
    }
    private static void SyncQuantityForSave(TaskPostDTO task)
    {
        if (task.Metadata is null)
            return;

        var metadata = task.Metadata;
        var hasParameters = metadata.ConversionParameters is { Count: > 0 };

        if (hasParameters)
        {
            if (!metadata.BaseQuantity.HasValue)
                metadata.BaseQuantity = metadata.Quantity;

            if (string.IsNullOrWhiteSpace(metadata.BaseUnit))
                metadata.BaseUnit = metadata.Unit;

            metadata.SyncConversionFactorFromParameters();

            var baseQty = metadata.BaseQuantity ?? 0m;
            metadata.Quantity = Math.Round(
                baseQty * metadata.ChangeFactor1 * metadata.ChangeFactor2,
                3,
                MidpointRounding.AwayFromZero);
        }
        else if (string.Equals(metadata.QuantityParam, ConstValues.FixedQ, StringComparison.OrdinalIgnoreCase))
        {
            metadata.Quantity = metadata.BaseQuantity;
        }
    }
    protected async override Task OnInitializedAsync()
    {
        TaskUpdate = TaskConvert.GetToPost(Task);
        TaskUpdate.OnlyCodeText = TaskUpdate.Metadata.Type == TaskType.CodeName;
        ApplyTaskFormRules(TaskUpdate);
        EnsureConversionParameters(TaskUpdate);
        EnsureBaseQuantity(TaskUpdate);
        if (TaskUpdate.Metadata.ConversionParameters.Any() && string.IsNullOrWhiteSpace(TaskUpdate.Metadata.BaseUnit))
            TaskUpdate.Metadata.BaseUnit = TaskUpdate.Metadata.Unit;
        RecalculateConversionFactor();
        ConfigureEditContext();

        SyncMetadataToWrappers();
        if (Task.Id == 0) PostList.Add(TaskUpdate);
        Statuses = (await Repo.Task.GetAsync()).ToList();
        if (Calc.Opportunities == null)
            Calc.Opportunities = await Repo.Opportunity.GetAsync(Calc.Id);
    }

    void UpdateStatus(TaskListMVVM task)
    {
        var st = Statuses?.FirstOrDefault(x => x.Id == TaskUpdate.StatusId);
        task.Status = st?.Name ?? string.Empty;
        task.StatusColor = st?.Color ?? string.Empty;
    }

    void CheckTaskType(TaskPostDTO po)
    {
        if (po.OnlyCodeText)
        {
            po.Metadata.Type = TaskType.CodeName;
            po.Metadata.QuantityParam = string.Empty;
            po.Metadata.Quantity = null;
        }
        else po.Metadata.Type = TaskType.Task;

        ApplyTaskFormRules(po);
    }

    private bool HasParentTask(TaskPostDTO task)
    {
        if (!task.ParentTaskId.HasValue || task.ParentTaskId <= 0)
            return false;

        return Calc?.Tasks?.Any(item => item.Id == task.ParentTaskId.Value) == true;
    }

    private bool IsParentOnlyCodeText(TaskPostDTO task)
    {
        if (!task.ParentTaskId.HasValue || task.ParentTaskId <= 0)
            return false;
        var parent = Calc?.Tasks?.FirstOrDefault(item => item.Id == task.ParentTaskId.Value);
        return parent?.Type == TaskType.CodeName;
    }
    private void ApplyTaskFormRules(TaskPostDTO task)
    {
        if (task.OnlyCodeText)
        {
            task.Metadata.ChangeFactor1 = 1;
            task.Metadata.ChangeFactor2 = 1;
            task.Metadata.Cap = null;
            return;
        }

        if (!HasParentTask(task))
        {
            task.Metadata.QuantityParam = ConstValues.FixedQ;
            task.Metadata.ChangeFactor1 = 1;

            if (task.Metadata.ConversionParameters is not { Count: > 0 })
                task.Metadata.ChangeFactor2 = 1;
        }
        else if (IsParentOnlyCodeText(task) && string.IsNullOrEmpty(task.Metadata.QuantityParam))
        {
            task.Metadata.QuantityParam = ConstValues.FixedQ;
        }

        if (!ShowTaskCapInput)
            task.Metadata.Cap = null;
    }
    private static bool CanEditTaskCap(IEnumerable<ResourceListMVVM>? resources)
    {
        if (resources is null)
            return false;
        return resources.Any(resource => resource.HasCap) ;

        // return resources
        //     .Where(resource => resource.HasCap && resource.Data.CapWaste != 0)
        //     .GroupBy(resource => resource.Data.CapWaste)
        //     .Any(group => group.Count() >= 2);
    }

    private void ConfigureEditContext()
    {
        editContext = new EditContext(TaskUpdate);
        editContext.SetFieldCssClassProvider(RequiredFieldCssClassProvider.Instance);
        editContext.OnValidationRequested += HandleValidationRequested;
        editContext.OnFieldChanged += HandleFieldChanged;
        messageStore = new ValidationMessageStore(editContext);
    }

    private void DetachEditContext()
    {
        if (editContext is null)
            return;

        editContext.OnValidationRequested -= HandleValidationRequested;
        editContext.OnFieldChanged -= HandleFieldChanged;
    }

    private bool IsBaseQuantityRequired()
        => !TaskUpdate.OnlyCodeText
            && string.Equals(TaskUpdate.Metadata.QuantityParam, ConstValues.FixedQ, StringComparison.OrdinalIgnoreCase);

    private void ClearBaseQuantityValidation()
        => messageStore?.Clear(BaseQuantityField);

    private void ValidateBaseQuantity()
    {
        if (IsBaseQuantityRequired() && !TaskUpdate.Metadata.BaseQuantity.HasValue)
        {
            messageStore?.Add(
                BaseQuantityField,
                string.Format(ProjectManagement.Shared.Resource.ResLocalize.FieldIsRequred, CalcResource.quantity));
        }
    }

    private void HandleValidationRequested(object? sender, ValidationRequestedEventArgs args)
    {
        messageStore?.Clear();
        ValidateBaseQuantity();
    }

    private void HandleFieldChanged(object? sender, FieldChangedEventArgs args)
    {
        if (ReferenceEquals(args.FieldIdentifier.Model, TaskUpdate.Metadata)
            && args.FieldIdentifier.FieldName is nameof(TaskMetadata.BaseQuantity) or nameof(TaskMetadata.QuantityParam))
        {
            ClearBaseQuantityValidation();
            editContext?.NotifyValidationStateChanged();
            return;
        }

        if (ReferenceEquals(args.FieldIdentifier.Model, TaskUpdate)
            && args.FieldIdentifier.FieldName == nameof(TaskPostDTO.OnlyCodeText))
        {
            ClearBaseQuantityValidation();
            editContext?.NotifyValidationStateChanged();
        }
    }

    async Task HandleSubmitAsync()
    {
        if (btnSubmitDisabled)
            return;

        btnSubmitDisabled = true;
        bool hasSuccess = false;
        try
        {
            if (Task.Id > 0)
            {
                SyncWrappersToMetadata();
                CheckTaskType(TaskUpdate);
                SyncQuantityForSave(TaskUpdate);
                hasSuccess = await Repo.Task.UpdateAsync(TaskUpdate, Task.Id);
            }
            else
            {
                SyncWrappersToMetadata();
                int maxOrder = 0;
                var siblingTasks = Calc.Tasks.Where(x => x.TaskId == Task.TaskId).ToList();
                if (siblingTasks.Count > 0)
                    maxOrder = siblingTasks.Max(x => x.Order) + 100;
                foreach (var item in PostList)
                {
                    CheckTaskType(item);
                    SyncQuantityForSave(item);
                    item.Order = maxOrder;
                    maxOrder += 100;
                    item.Metadata.IsOH = Calc.OHFactors;
                }
                hasSuccess = await Repo.Task.CreateAsync(PostList, Calc.Id);
            }
            MHD.Notifications(Task.Id == 0 ? ToastType.Add : ToastType.Update, hasSuccess);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        Close();
    }

    public void Dispose()
    {
        DetachEditContext();
    }

    void Close() => Modal.Close();
}
