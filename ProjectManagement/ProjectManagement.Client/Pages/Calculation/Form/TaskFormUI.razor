    private void ConfigureEditContext()
    {
        editContext = new EditContext(TaskUpdate);
        editContext.SetFieldCssClassProvider(RequiredFieldCssClassProvider.Instance);
        editContext.OnValidationRequested += HandleValidationRequested;
        editContext.OnFieldChanged += HandleFieldChanged;
        messageStore = new ValidationMessageStore(editContext);
    }

    private void DetachEditContext()
    {
        if (editContext is null)
            return;

        editContext.OnValidationRequested -= HandleValidationRequested;
        editContext.OnFieldChanged -= HandleFieldChanged;
    }

    private bool IsBaseQuantityRequired()
        => TaskUpdate.Metadata.Type is TaskType.Task or TaskType.ThreeBarCode
            && string.Equals(TaskUpdate.Metadata.QuantityParam, ConstValues.FixedQ, StringComparison.OrdinalIgnoreCase);

    private void ClearBaseQuantityValidation()
        => messageStore?.Clear(BaseQuantityField);

    private void ValidateBaseQuantity()
    {
        if (IsBaseQuantityRequired() && !TaskUpdate.Metadata.BaseQuantity.HasValue)
        {
            messageStore?.Add(
                BaseQuantityField,
                string.Format(ProjectManagement.Shared.Resource.ResLocalize.FieldIsRequred, CalcResource.quantity));
        }
    }

    private void HandleValidationRequested(object? sender, ValidationRequestedEventArgs args)
    {
        messageStore?.Clear();
        ValidateBaseQuantity();
    }

    private void HandleFieldChanged(object? sender, FieldChangedEventArgs args)
    {
        if (ReferenceEquals(args.FieldIdentifier.Model, TaskUpdate.Metadata)
            && args.FieldIdentifier.FieldName is nameof(TaskMetadata.BaseQuantity) or nameof(TaskMetadata.QuantityParam))
        {
            ClearBaseQuantityValidation();
            editContext?.NotifyValidationStateChanged();
            return;
        }

        if (ReferenceEquals(args.FieldIdentifier.Model, TaskUpdate.Metadata)
            && args.FieldIdentifier.FieldName == nameof(TaskMetadata.Type))
            ClearBaseQuantityValidation();
    }

    async Task HandleSubmitAsync()
    {
        if (btnSubmitDisabled)
            return;

        btnSubmitDisabled = true;
        bool hasSuccess = false;
        var calcId = Calc.Id;
        List<TaskListMVVM> createdTasks = [];
        try
        {
            if (Task.Id > 0)
            {
                SyncWrappersToMetadata();
                CheckTaskType(TaskUpdate);
                SyncQuantityForSave(TaskUpdate);
                hasSuccess = await Repo.Task.UpdateAsync(TaskUpdate, Task.Id);
            }
            else
            {
                SyncWrappersToMetadata();
                int maxOrder = 0;
                var siblingTasks = Calc.Tasks.Where(x => x.TaskId == Task.TaskId).ToList();
                if (siblingTasks.Count > 0)
                    maxOrder = siblingTasks.Max(x => x.Order) + 100;
                foreach (var item in PostList)
                {
                    CheckTaskType(item);
                    SyncQuantityForSave(item);
                    item.Order = maxOrder;
                    maxOrder += 100;
                    item.Metadata.IsOH = Calc.OHFactors;
                }
                createdTasks = await Repo.Task.CreateAsync(PostList, Calc.Id);
                hasSuccess = createdTasks.Count > 0;
            }
            MHD.Notifications(Task.Id == 0 ? ToastType.Add : ToastType.Update, hasSuccess);

            if (hasSuccess && calcId > 0)
            {
                if (createdTasks.Count > 0)
                    await CalcService.AddCreatedTasksOrRefreshAsync(createdTasks);
                else
                    await CalcService.RefreshAfterStructuralMutationAsync();
            }
        }
        catch (Exception ex)
        {
            _ = ClientLog.ErrorAsync("TaskForm submit failed", ex: ex);
        }
        Close();
    }

    public void Dispose()
    {
        DetachEditContext();
    }

