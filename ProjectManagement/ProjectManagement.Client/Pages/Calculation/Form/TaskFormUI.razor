@using ProjectManagement.Client.Shared.MVVM.Calculation
@using ProjectManagement.Client.Helper
@using ProjectManagement.Client.Shared.Model.Project.Calculation;
@using ProjectManagement.Client.Shared.Repositories.Calculation
@using ProjectManagement.Shared.Base.Calculation
@using ProjectManagement.Shared.DTO.Calculation
@using Microsoft.Extensions.Localization
@using System.Globalization
@attribute [Authorize(Roles = PMRolesConst.Tenant.AdminManger)]
@inherits AppComponentBase
@implements IDisposable


<EditForm @key="editContext"
          id="@DialogFormId"
          EditContext="editContext!"
          OnValidSubmit="async()=> await HandleSubmitAsync()">

    @if (Task.Id == 0 && PostList.Count > 1)
    {
        <div>
            <ul class="nav nav-pills mb-2" id="pills-tab" role="tablist">
                @for (int i = 0; i < PostList.Count; i++)
                {
                    int x = i;
                    <li class="nav-item" role="presentation">
                        <button @onclick="() => SetActiveTask(PostList[x])" class="nav-link active" type="button" role="tab">@(i + 1)</button>
                    </li>
                }
            </ul>
        </div>
    }

    <DataAnnotationsValidator />
    <FormValidationSummary />
    <MhdCard Elevated="true" Compact="true" Class="mb-1.5">
        <div class="@HeaderGridClass">

            @if (ShowActiveCheckbox)
            {
                <div class="min-w-0">
                    <label class="@($"{CheckboxCardClass} w-fit whitespace-nowrap")">
                        <InputCheckbox @bind-Value="TaskUpdate.IsActive" class="@CheckboxClass" />
                        <span>@CalcResource.active</span>
                    </label>
                </div>
            }

            <div class="min-w-0">
                <label class="@LabelClass">@CalcResource.type</label>
                <select class="@InputClass"
                        value="@TaskUpdate.Metadata.Type"
                        @onchange="OnTaskTypeChanged">
                    <option value="@TaskType.Task">@ResourceLoc.task</option>
                    <option value="@TaskType.CodeName">@AppLoc["onlyCodeText"]</option>
                    <option value="@TaskType.ThreeBarCode">3-Bar Code</option>
                    <option value="@TaskType.FourBarCode">4-Bar Code</option>
                </select>
            </div>

            <div class="min-w-0">
                <label class="@LabelClass">@CalcResource.code</label>
                <InputText @bind-Value="TaskUpdate.Metadata.Code" class="@InputClass" />
            </div>

            <div class="min-w-0">
                <label class="@LabelClass">@CalcResource.name</label>
                <InputText @bind-Value="TaskUpdate.Name" class="@InputClass" />
            </div>

        </div>
    </MhdCard>
    @if (ShowTaskDetails)
            {
    <MhdCard Elevated="true" Compact="true" Class="mb-1.5">
        <div class="grid gap-x-2 gap-y-1.5 md:grid-cols-12">

                <div class="min-w-0 md:col-span-12 xl:col-span-5">
                    <label class="@LabelClass">@CalcResource.quantity</label>
                    @if (IsThreeBarCodeTask)
                    {
                        <div class="grid items-start gap-1.5 grid-cols-[7.25rem_minmax(0,1fr)]">
                            <input class="@DisabledInputClass" value="@CalcResource.fixedQ" disabled />
                            <TrimmedNumberInput TValue="decimal?"
                                                @bind-Value="TaskUpdate.Metadata.BaseQuantity"
                                                @bind-Value:after="SyncConvertedQuantity"
                                                class="@InputClass" />
                        </div>
                    }
                    else if (HasTaskAbove)
                    {
                        <div class="grid items-start gap-1.5 @(TaskUpdate.Metadata.QuantityParam == ConstValues.FixedQ ? "grid-cols-[minmax(0,1fr)_7.25rem]" : "grid-cols-1")">
                            <InputSelect class="@InputClass"
                                         @bind-Value:get="TaskUpdate.Metadata.QuantityParam"
                                         @bind-Value:set="(value) => ChangeQuantityParam(value)">
                                @if (!ParentIsOnlyCodeText)
                                {
                                    <option value="">@ResourceLoc.DependsOnParentItem</option>
                                }
                                <option value="@ConstValues.FixedQ">@CalcResource.fixedQ</option>
                                @if (Calc.QuanityList != null)
                                {
                                    foreach (var status in Calc.QuanityList)
                                    {
                                        <option value="@status.Name">@status.Name (@status.Quantity)</option>
                                    }
                                }
                            </InputSelect>

                            @if (TaskUpdate.Metadata.QuantityParam == ConstValues.FixedQ)
                            {
                                <TrimmedNumberInput TValue="decimal?"
                                                    @bind-Value="TaskUpdate.Metadata.BaseQuantity"
                                                    @bind-Value:after="SyncConvertedQuantity"
                                                    class="@InputClass" />
                            }
                            else
                            {
                                <input type="number" value="@SourceQuantityText" class="@DisabledInputClass" disabled />
                            }
                        </div>
                    }
                    else
                    {
                        <div class="grid items-start gap-1.5 grid-cols-[7.25rem_minmax(0,1fr)]">
                            <input class="@DisabledInputClass" value="@CalcResource.fixedQ" disabled />
                            <TrimmedNumberInput TValue="decimal?"
                                                @bind-Value="TaskUpdate.Metadata.BaseQuantity"
                                                @bind-Value:after="SyncConvertedQuantity"
                                                class="@InputClass" />
                        </div>
                    }
                </div>
                @if (TaskUpdate.Metadata.ConversionParameters.Any())
                {
                    <div class="min-w-0 md:col-span-3 xl:col-span-2">
                        <label class="@LabelClass">@ResourceLoc.baseUnit</label>
                        <InputText @bind-Value="TaskUpdate.Metadata.BaseUnit" class="@InputClass" />
                    </div>
                }
                else
                {
                    <div class="min-w-0 md:col-span-4 xl:col-span-3">
                        <label class="@LabelClass">@(TaskUpdate.Metadata.ConversionParameters.Any() ? CalcResource.newUnit : CalcResource.unit)</label>
                        <InputText @bind-Value="TaskUpdate.Unit" class="@InputClass" />
                    </div>
                }
              


@* 
                @if (HasTaskAbove)
                {
                    <div class="min-w-0 md:col-span-3 xl:col-span-2">
                        <label class="@LabelClass">@CalcResource.changeFactor1</label>
                        <TrimmedNumberInput TValue="decimal" @bind-Value="TaskUpdate.Metadata.ChangeFactor1" class="@InputClass" />
                    </div>
                } *@

                @if (!IsThreeBarCodeTask)
                {
                    <div class="min-w-0 md:col-span-3 xl:col-span-2">
                        <label class="@LabelClass">@CalcResource.changeFactor2 </label>
                        @if (TaskUpdate.Metadata.ConversionParameters.Any())
                        {
                            <TrimmedNumberInput TValue="decimal"
                                                @bind-Value="TaskUpdate.Metadata.ChangeFactor2"
                                                class="@DisabledInputClass"
                                                disabled />
                        }
                        else
                        {
                            <TrimmedNumberInput TValue="decimal"
                                                @bind-Value="TaskUpdate.Metadata.ChangeFactor2"
                                                @bind-Value:after="SyncConvertedQuantity"
                                                class="@InputClass" />
                        }
                    </div>
                }
                @if (!IsThreeBarCodeTask && TaskUpdate.Metadata.ConversionParameters.Any())
                {
                    <div class="min-w-0 md:col-span-3 xl:col-span-2">
                        <label class="@LabelClass">@ResourceLoc.convertedQuantity</label>
                        <input type="number" value="@ConvertedQuantityText" class="@DisabledInputClass" disabled />
                    </div>
                    <div class="min-w-0 md:col-span-4 xl:col-span-3">
                        <label class="@LabelClass">@CalcResource.newUnit</label>
                        <InputText @bind-Value="TaskUpdate.Unit" class="@InputClass" />
                    </div>
                }
                @if (ShowTaskCapInput || true)
                {
                    <div class="min-w-0 md:col-span-3 xl:col-span-2">
                        <label class="@LabelClass">@CalcResource.cap </label>
                        <TrimmedNumberInput TValue="decimal?" @bind-Value="TaskUpdate.Metadata.Cap" class="@InputClass" />
                    </div>
                }
        </div>
    </MhdCard>
       
        <MhdCard Elevated="true" Compact="true" Class="mb-1.5">
            <div class="grid gap-x-2 gap-y-1.5 md:grid-cols-12">

                <div class="min-w-0 md:col-span-3 xl:col-span-2">
                    <label class="@LabelClass">@CalcResource.priceSub</label>
                    <TrimmedNumberInput TValue="decimal?"
                                        @bind-Value="TaskUpdate.Metadata.PriceSubDB"
                                        class="@InputClass" />
                </div>

                <div class="min-w-0 md:col-span-5 xl:col-span-4">
                    <div class="flex h-full items-end">
                        <div class="flex min-w-0 items-center gap-2">
                            <label class="@($"{CheckboxCardClass} min-w-0 max-w-full")">
                                <InputCheckbox class="@CheckboxClass"
                                               @bind-Value="TaskUpdate.Metadata.PriceSubInPrecent" />
                                <span class="truncate">@ResourceLoc.inprecent</span>
                            </label>

                            <div class="group relative inline-flex flex-shrink-0">
                                <button type="button"
                                        class="flex h-4 w-4 flex-shrink-0 items-center justify-center rounded-full bg-slate-400 text-[10px] font-bold leading-none text-white hover:bg-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/30 dark:bg-slate-600 dark:hover:bg-blue-500"
                                        aria-label="@CalcLoc["priceSubInfo"]">
                                    !
                                </button>

                                <div role="tooltip"
                                     class="pointer-events-none absolute left-1/2 top-full z-50 mt-1 w-64 -translate-x-1/2 rounded-md border border-blue-200 bg-blue-50 px-2.5 py-1.5 text-left text-[11px] font-normal leading-snug text-blue-700 opacity-0 shadow-lg transition-opacity duration-150 group-hover:opacity-100 group-focus-within:opacity-100 dark:border-blue-700 dark:bg-blue-950 dark:text-blue-300">
                                    @CalcLoc["priceSubInfo"]
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="min-w-0 md:col-span-2 xl:col-span-3">
                    <label class="@LabelClass">@CalcResource.minPrice</label>
                    <TrimmedNumberInput TValue="decimal?"
                                        @bind-Value="TaskUpdate.Metadata.MinPrice"
                                        class="@InputClass" />
                </div>

                <div class="min-w-0 md:col-span-2 xl:col-span-3">
                    <label class="@LabelClass">@CalcResource.ceilingPrice</label>
                    <TrimmedNumberInput TValue="decimal?"
                                        @bind-Value="TaskUpdate.Metadata.CeilingPrice"
                                        class="@InputClass" />
                </div>

            </div>
        </MhdCard>
        <MhdCard Elevated="true" Compact="true" Class="mb-1.5">
                <div class="grid gap-x-2 gap-y-1.5 md:grid-cols-12">
        <div class="min-w-0 md:col-span-3 xl:col-span-2">
            <label class="@LabelClass">@CalcResource.actuallyQuantity</label>
            <TrimmedNumberInput TValue="decimal?" @bind-Value="_actuallyQuantity" class="@InputClass" />
        </div>

        <div class="min-w-0 md:col-span-3 xl:col-span-2">
            <label class="@LabelClass">@AppLoc["workedQuantity"]</label>
            <TrimmedNumberInput TValue="decimal?" @bind-Value="_workedQ" class="@InputClass" />
        </div>

        <div class="min-w-0 md:col-span-3 xl:col-span-2">
            <label class="@LabelClass">@CalcResource.priceProduction</label>
            <TrimmedNumberInput TValue="decimal?" @bind-Value="TaskUpdate.Metadata.PriceProductionDB" class="@InputClass" />
            </div>
        </div>
    </MhdCard>

        <MhdCard Elevated="true" Compact="true" Class="mb-1.5">
            <div class="grid gap-x-2 gap-y-1.5 md:grid-cols-12">
                <div class="min-w-0 md:col-span-4 xl:col-span-3">
                    <label class="@LabelClass">@CalcResource.status</label>
                    <InputSelect @bind-Value="TaskUpdate.StatusId" class="@InputClass">
                        <option></option>
                        @if (Statuses != null)
                        {
                            foreach (var status in Statuses)
                            {
                                <option value="@status.Id">@status.Name</option>
                            }
                        }
                    </InputSelect>
                </div>
                <div class="min-w-0 md:col-span-6 xl:col-span-4">
                    <label class="@LabelClass">@CalcResource.responsible</label>
                    <InputText @bind-Value="TaskUpdate.Metadata.Responsible" class="@InputClass" />
                </div>
                <div class="min-w-0 md:col-span-8 xl:col-span-5">
                    <label class="@LabelClass">@CalcResource.opportunity</label>
                    <InputSelect @bind-Value="TaskUpdate.OpportunityId" class="@InputClass">
                        <option></option>
                        @if (Calc.Opportunities != null)
                        {
                            foreach (var opportunity in Calc.Opportunities)
                            {
                                <option value="@opportunity.Id">@opportunity.OpportunitiesRisks @opportunity.OpportunityType</option>
                            }
                        }
                    </InputSelect>
                </div>
            </div>
        </MhdCard>
        <MhdCard Elevated="true" Compact="true" Class="mb-1.5">
            <div class="grid gap-y-1">
                <div class="flex items-center justify-between gap-2">
                    <div class="flex min-w-0 items-center gap-1.5">
                        <div class="text-[12px] font-semibold text-slate-800 dark:text-slate-100">
                            @CalcLoc["conversionParamTitle"]
                        </div>

                        <div class="group relative inline-flex">
                            <button type="button"
                                    class="flex h-4 w-4 flex-shrink-0 items-center justify-center rounded-full bg-slate-400 text-[10px] font-bold leading-none text-white hover:bg-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/30 dark:bg-slate-600 dark:hover:bg-blue-500"
                                    aria-label="@CalcLoc["conversionParamInfo"]">
                                !
                            </button>

                            <div role="tooltip"
                                 class="pointer-events-none absolute left-1/2 top-full z-50 mt-1 w-72 -translate-x-1/2 rounded-md border border-blue-200 bg-blue-50 px-2.5 py-1.5 text-left text-[11px] font-normal leading-snug text-blue-700 opacity-0 shadow-lg transition-opacity duration-150 group-hover:opacity-100 group-focus-within:opacity-100 dark:border-blue-700 dark:bg-blue-950 dark:text-blue-300">
                                @CalcLoc["conversionParamInfo"]
                            </div>
                        </div>
                    </div>

                    @if (CanEditConversionParameters)
                    {
                        <div class="flex items-end gap-2">
                            <button type="button"
                                    class="@OutlineBlueButtonClass"
                                    @onclick="AddConversionParameter">
                                @CalcLoc["newParameter"]
                            </button>
                        </div>
                    }
                </div>

                @if (CanEditConversionParameters)
                {
                    @if (!TaskUpdate.Metadata.ConversionParameters.Any())
                    {
                        <div class="rounded-md border border-dashed border-slate-300 bg-slate-50 px-3 py-2 text-[12px] text-slate-500 dark:border-slate-700 dark:bg-slate-800/60 dark:text-slate-400">
                            @CalcLoc["noConversionParams"]
                        </div>
                    }
                    else
                    {
                        <table class="w-full border-collapse">
                            <thead>
                                <tr class="border-b border-slate-200 dark:border-slate-700">
                                    <th class="pb-1 text-left text-[11px] font-medium text-slate-700 dark:text-slate-200">@CalcResource.name</th>
                                    <th class="w-[110px] pb-1 pl-1.5 text-left text-[11px] font-medium text-slate-700 dark:text-slate-200">@CalcResource.factor</th>
                                    <th class="w-[110px] pb-1 pl-1.5 text-left text-[11px] font-medium text-slate-700 dark:text-slate-200">@CalcResource.unit</th>
                                    <th class="w-auto"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < TaskUpdate.Metadata.ConversionParameters.Count; i++)
                                {
                                    var idx = i;
                                    <tr class="last:border-0 dark:border-slate-700/50">
                                        <td class="py-0.5 pr-0.5">
                                            <InputText @bind-Value="TaskUpdate.Metadata.ConversionParameters[idx].Name" class="@InputClass" />
                                        </td>
                                        <td class="py-0.5 pr-0.5">
                                            <TrimmedNumberInput TValue="decimal"
                                                                @bind-Value="TaskUpdate.Metadata.ConversionParameters[idx].Value"
                                                                class="@InputClass"
                                                                @bind-Value:after="RecalculateConversionFactor" />
                                        </td>
                                        <td class="py-0.5 pr-0.5">
                                            <InputText @bind-Value="TaskUpdate.Metadata.ConversionParameters[idx].Unit" class="@InputClass" />
                                        </td>
                                        <td class="py-0.5 text-right">
                                            <button type="button"
                                                    class="@OutlineRedButtonClass"
                                                    @onclick="() => RemoveConversionParameter(idx)">
                                                @AppLoc["delete"]
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                }
                else
                {
                    <div class="rounded-md border border-dashed border-slate-300 bg-slate-50 px-3 py-2 text-[12px] text-slate-500 dark:border-slate-700 dark:bg-slate-800/60 dark:text-slate-400">
                        @CalcLoc["conversionParamNotForCodeRows"]
                    </div>
                }
            </div>
        </MhdCard>
    }
    <MhdCard Elevated="true" Compact="true" Class="mb-1.5">
        <div class="grid gap-x-2 gap-y-1.5 md:grid-cols-[minmax(0,1fr)_auto] md:items-start">
            <div class="min-w-0">
                <label class="@LabelClass">@CalcResource.note </label>
                <InputTextArea @bind-Value="TaskUpdate.Metadata.Note" class="@TextAreaClass" />
            </div>

            <div class="md:pt-7">
                <button type="button"
                        class="@PrimaryBlueButtonClass"
                        @onclick="() => TaskUpdate.Metadata.UpperNote.Add(string.Empty)">
                    @CalcResource.UpperNote
                </button>
            </div>
        </div>

        @for (int i = 0; i < TaskUpdate.Metadata.UpperNote.Count; i++)
        {
            int d = i;
            <div class="mt-2 grid gap-2 rounded-xl border border-slate-200 bg-slate-50 p-2.5 dark:border-slate-700 dark:bg-slate-800/60 md:grid-cols-[minmax(0,1fr)_auto] md:items-start">
                <div class="min-w-0">
                    <textarea rows="3" @bind="TaskUpdate.Metadata.UpperNote[d]" class="@TextAreaClass"></textarea>
                </div>

                <div class="md:pt-1">
                    <button type="button"
                            class="@DeleteButtonClass"
                            @onclick="() => TaskUpdate.Metadata.UpperNote.RemoveAt(d)">
                        @((MarkupString)@Icons.DeleteSVG)
                    </button>
                </div>
            </div>
        }
    </MhdCard>
</EditForm>


