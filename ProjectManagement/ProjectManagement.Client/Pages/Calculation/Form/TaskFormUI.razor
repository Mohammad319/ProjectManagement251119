@using ProjectManagement.Client.Shared.MVVM.Calculation
@using ProjectManagement.Client.Shared.Model.Project.Calculation;
@using ProjectManagement.Client.Shared.Repositories.Calculation
@using ProjectManagement.Shared.Base.Calculation
@using ProjectManagement.Shared.DTO.Calculation
@attribute [Authorize(Roles = PMRolesConst.Tenant.AdminManger)]
@inherits AppComponentBase


<EditForm id="taskForm"
          Model="@TaskUpdate"
          OnValidSubmit="async()=> await HandleSubmitAsync()">

    @if (Task.Id == 0 && PostList.Count > 1)
    {
        <div>
            <ul class="nav nav-pills mb-3" id="pills-tab" role="tablist">
                @for (int i = 0; i < PostList.Count; i++)
                {
                    int x = i;
                    <li class="nav-item" role="presentation">
                        <button @onclick="() => TaskUpdate = PostList[x]" class="nav-link active" type="button" role="tab">@(i + 1)</button>
                    </li>
                }
            </ul>
        </div>
    }

    <DataAnnotationsValidator />

    <MhdCard Elevated="true" Compact="true" Class="mb-2">
        <div class="@CssClasses.Layout.FlexWrap">
            <div class="@CssClasses.Layout.FlexWidth200">
                <label class="@CssClasses.Form.Label">@CalcResource.code</label>
                <InputText @bind-Value="TaskUpdate.Metadata.Code" class="@CssClasses.Input.Text" />
                <ValidationMessage For="@(() => TaskUpdate.Metadata.Code)" />
            </div>
            <div class="@CssClasses.Layout.FlexMinWidth350">
                <label class="@CssClasses.Form.Label">@CalcResource.name </label>
                <InputText @bind-Value="TaskUpdate.Name" class="@CssClasses.Input.Text" />
                <ValidationMessage For="@(() => TaskUpdate.Name)" />
            </div>
        </div>
    </MhdCard>

    <MhdCard Elevated="true" Compact="true" Class="mb-2">
        <div class="@CssClasses.Layout.FlexWrap">
            @if (!TaskUpdate.OnlyCodeText)
            {
                    <div class="@(TaskUpdate.Metadata.QuantityParam == ConstValues.FixedQ ? CssClasses.Layout.FlexWidth110 : CssClasses.Layout.FlexWidth200)">

                    <label class="@CssClasses.Form.Label">@CalcResource.quantity</label>
                    <div class="w-full @CssClasses.Layout.ButtonGroup">
                        <InputSelect class="@CssClasses.Input.Select"
                                     @bind-Value:get="TaskUpdate.Metadata.QuantityParam"
                                     @bind-Value:set="(value) => ChangeQuantityParam(value)">
                            <option></option>
                            <option value="@ConstValues.FixedQ">@CalcResource.fixedQ</option>
                            @if (Calc.QuanityList != null)
                                foreach (var status in Calc.QuanityList)
                                {
                                    <option value="@status.Name">@status.Name (@status.Quantity)</option>
                                }
                        </InputSelect>

                        @if (TaskUpdate.Metadata.QuantityParam == ConstValues.FixedQ)
                        {
                            <InputNumber @bind-Value="TaskUpdate.Metadata.Quantity" class="@CssClasses.Input.Text" />
                        }
                    </div>
                </div>

                <div class="@CssClasses.Layout.FlexWidth110">
                    <label class="@CssClasses.Form.Label">@CalcResource.unit</label>
                    <InputText @bind-Value="TaskUpdate.Metadata.Unit" class="@CssClasses.Input.Text" />
                    <ValidationMessage For="@(() => TaskUpdate.Metadata.Unit)" />
                </div>

                @if (Task.Tasks == null || Task.Tasks.Count == 0)
                {
                    <div class="@CssClasses.Layout.FlexWidth110">
                        <label class="@CssClasses.Form.Label">@CalcResource.cap </label>
                        <InputNumber @bind-Value="TaskUpdate.Metadata.Ca‌​p" class="@CssClasses.Input.Text" />
                        <ValidationMessage For="@(() => TaskUpdate.Metadata.Cap)" />
                    </div>
                }

                @if (TaskUpdate.ParentTaskId.HasValue)
                {
                    <div class="@CssClasses.Layout.FlexWidth130">
                        <label class="@CssClasses.Form.Label">@CalcResource.changeFactor1</label>
                        <InputNumber @bind-Value="TaskUpdate.Metadata.ChangeFactor1" class="@CssClasses.Input.Text" />
                        <ValidationMessage For="@(() => TaskUpdate.Metadata.ChangeFactor1)" />
                    </div>
                    <div class="@CssClasses.Layout.FlexWidth130">
                        <label class="@CssClasses.Form.Label">@CalcResource.changeFactor2 </label>
                        <InputNumber @bind-Value="TaskUpdate.Metadata.ChangeFactor2" class="@CssClasses.Input.Text" />
                        <ValidationMessage For="@(() => TaskUpdate.Metadata.ChangeFactor2)" />
                    </div>
                }
                <div class="@CssClasses.Layout.FlexWidth110">
                    <label class="@CssClasses.Form.Label">ActuallyQuantity </label>
                    <InputNumber @bind-Value="TaskUpdate.Metadata.ActuallyQuantity" class="@CssClasses.Input.Text" />
                    <ValidationMessage For="@(() => TaskUpdate.Metadata.ActuallyQuantity)" />
                </div>
                <div class="@CssClasses.Layout.FlexWidth110">
                    <label class="@CssClasses.Form.Label">WorkedQ </label>
                    <InputNumber @bind-Value="TaskUpdate.Metadata.WorkedQ" class="@CssClasses.Input.Text" />
                    <ValidationMessage For="@(() => TaskUpdate.Metadata.WorkedQ)" />
                </div>

                <div class="@CssClasses.Layout.FlexWidth110">
                    <label class="@CssClasses.Form.Label">@CalcResource.priceSub </label>
                    <InputNumber @bind-Value="TaskUpdate.Metadata.PriceSubDB" class="@CssClasses.Input.Text" />
                    <ValidationMessage For="@(() => TaskUpdate.Metadata.PriceSubDB)" />
                </div>
                <div class="@CssClasses.Layout.FlexWidth110">
                    <label class="@CssClasses.Form.Label">@CalcResource.minPrice </label>
                    <InputNumber @bind-Value="TaskUpdate.Metadata.MinPrice" class="@CssClasses.Input.Text" />
                    <ValidationMessage For="@(() => TaskUpdate.Metadata.MinPrice)" />
                </div>
                <div class="@CssClasses.Layout.FlexWidth110">
                    <label class="@CssClasses.Form.Label">@CalcResource.ceilingPrice </label>
                    <InputNumber @bind-Value="TaskUpdate.Metadata.CeilingPrice" class="@CssClasses.Input.Text" />
                    <ValidationMessage For="@(() => TaskUpdate.Metadata.CeilingPrice)" />
                </div>
            }

            @if (Task.Resources == null || Task.Resources.Count == 0 || Task.Type == TaskType.CodeName)
            {
                <div class="@CssClasses.Layout.FlexWidth160">
                    <div class="@CssClasses.Form.CheckWrapperM">
                        <InputCheckbox @bind-Value="TaskUpdate.OnlyCodeText" class="@CssClasses.Input.Check" />
                        <label class="@CssClasses.Form.Label">Only Code Text</label>
                    </div>
                </div>
            }
        </div>
    </MhdCard>

    @if (!TaskUpdate.OnlyCodeText)
    {
        <MhdCard Elevated="true" Compact="true" Class="mb-2">
            <div class="@CssClasses.Layout.FlexWrap">
                <div class="@CssClasses.Layout.FlexWidth160">
                    <label class="@CssClasses.Form.Label">@CalcResource.status</label>
                    <InputSelect @bind-Value="TaskUpdate.StatusId" class="@CssClasses.Input.Select">
                        <option></option>
                        @if (Statuses != null)
                            foreach (var status in Statuses)
                            {
                                <option value="@status.Id">@status.Name</option>
                            }
                    </InputSelect>
                    <ValidationMessage For="@(() => TaskUpdate.StatusId)" />
                </div>

                <div class="@CssClasses.Layout.FlexWidth160">
                    <label class="@CssClasses.Form.Label">@CalcResource.opportunity</label>
                    <InputSelect @bind-Value="TaskUpdate.OpportunityId" class="@CssClasses.Input.Select">
                        <option></option>
                        @if (Calc.Opportunities != null)
                            foreach (var opportunity in Calc.Opportunities)
                            {
                                <option value="@opportunity.Id">@opportunity.OpportunitiesRisks @opportunity.Type</option>
                            }
                    </InputSelect>
                    <ValidationMessage For="@(() => TaskUpdate.OpportunityId)" />
                </div>

                <div class="@CssClasses.Layout.FlexWidth200">
                    <label class="@CssClasses.Form.Label">@CalcResource.responsible</label>
                    <InputText @bind-Value="TaskUpdate.Metadata.Responsible" class="@CssClasses.Input.Text" />
                    <ValidationMessage For="@(() => TaskUpdate.Metadata.Responsible)" />
                </div>

                <div class="@CssClasses.Layout.FlexWidth110">
                    <div class="@CssClasses.Form.CheckWrapperM">
                        <InputCheckbox class="@CssClasses.Input.Check" @bind-Value="TaskUpdate.Metadata.PriceSubInPrecent" />
                        <label class="@CssClasses.Form.Label">
                            @ResourceLoc.inprecent
                        </label>
                    </div>
                </div>

                <div class="@CssClasses.Layout.FlexWidth110">
                    <div class="@CssClasses.Form.CheckWrapperM">
                        <InputCheckbox @bind-Value="TaskUpdate.IsActive" class="@CssClasses.Input.Check" />
                        <label class="@CssClasses.Form.Label">@CalcResource.active</label>
                    </div>
                </div>
            </div>
        </MhdCard>
    }

    <MhdCard Elevated="true" Compact="true" Class="mb-2">
        <div class="@CssClasses.Layout.FlexWrap">
            <div class="flex-grow">
                <label class="@CssClasses.Form.Label">@CalcResource.note </label>
                <InputTextArea @bind-Value="TaskUpdate.Metadata.Note" class="@CssClasses.Input.Text" />
                <ValidationMessage For="@(() => TaskUpdate.Metadata.Note)" />
            </div>
            <div class="w-[100px]">
                <button type="button"
                        class="@CssClasses.Btn.Solid.Primary mt-7"
                        @onclick="() => TaskUpdate.Metadata.UpperNote.Add(string.Empty)">
                    @CalcResource.UpperNote
                </button>
            </div>
        </div>

        @for (int i = 0; i < TaskUpdate.Metadata.UpperNote.Count; i++)
        {
            int d = i;
            <div class="@CssClasses.Layout.FlexWrap mt-1">
                <div class="flex-grow">
                    <textarea lang="3" @bind="TaskUpdate.Metadata.UpperNote[d]" class="@CssClasses.Input.Text"></textarea>
                </div>
                <div class="w-[100px]">
                    <button type="button"
                            class="@CssClasses.Btn.Solid.Danger"
                            @onclick="() => TaskUpdate.Metadata.UpperNote.RemoveAt(d)">
                        @((MarkupString)@Icons.DeleteSVG)
                    </button>
                </div>
            </div>
        }
    </MhdCard>
</EditForm>


<div class="@CssClasses.Modal.Footer">
    @if (Task.Id == 0)
    {
        if (PostList.Count > 1)
        {
            <button type="button" class="@CssClasses.Btn.Outline.Danger" @onclick="() => PostList.Remove(TaskUpdate)">@ResourceApp.delete</button>
        }
        <button type="button" class="@CssClasses.Btn.Outline.Primary" @onclick="NewSP">@ResourceApp.newItem</button>
    }
    <button type="submit" class="@CssClasses.Btn.Outline.Success" form="taskForm" disabled="@btnSubmitDisabled">
        @ResourceApp.save
    </button>
    <button type="button" class="@CssClasses.Btn.Outline.Secondary" @onclick="Close">@ResourceApp.cancel</button>
</div>


@code {
    int Selectwidth = 160;
    int InputNumber = 120;
    List<TaskPostDTO> PostList = new();
    bool btnSubmitDisabled = false;
    List<ListOrderDTO>? Statuses;
    [Parameter] public TaskListMVVM Task { get; set; } = default!;
    TaskPostDTO TaskUpdate = new();

    void NewSP()
    {
        TaskPostDTO p = new();
        TaskUpdate.CopyPropertiesTo(p);
        PostList.Insert(0, p);
    }

    private void ChangeQuantityParam(string qp)
    {
        TaskUpdate.Metadata.QuantityParam = qp;
        if (string.IsNullOrEmpty(qp)) TaskUpdate.Metadata.Quantity = null;
        else if (qp != ConstValues.FixedQ) TaskUpdate.Metadata.Quantity = Calc.QuanityList?.FirstOrDefault(x => x.Name == qp)?.Quantity;
    }

    protected async override Task OnInitializedAsync()
    {
        TaskUpdate = TaskConvert.GetToPost(Task);
        TaskUpdate.OnlyCodeText = TaskUpdate.Metadata.Type == TaskType.CodeName;

        if (Task.Id == 0) PostList.Add(TaskUpdate);
        Statuses = (await Repo.Task.GetAsync()).ToList();
        if (Calc.Opportunities == null)
            Calc.Opportunities = await Repo.Opportunity.GetAsync(Calc.Id);
    }

    void UpdateStatus(TaskListMVVM task)
    {
        var st = Statuses?.FirstOrDefault(x => x.Id == TaskUpdate.StatusId);
        task.Status = st?.Name;
        task.StatusColor = st?.Color;
    }

    void CheckTaskType(TaskPostDTO po)
    {
        if (po.OnlyCodeText)
        {
            po.Metadata.Type = TaskType.CodeName;
            po.Metadata.QuantityParam = string.Empty;
            po.Metadata.Quantity = null;
        }
        else po.Metadata.Type = TaskType.Task;
    }

    async Task HandleSubmitAsync()
    {
        btnSubmitDisabled = true;
        bool hasSuccess = false;
        try
        {
            if (Task.Id > 0)
            {
                CheckTaskType(TaskUpdate);
                hasSuccess = await Repo.Task.UpdateAsync(TaskUpdate, Task.Id);
            }
            else
            {
                double maxOrder = 0;
                if (Calc.Tasks.Where(x => x.TaskId == Task.TaskId).Any())
                    maxOrder = Calc.Tasks.OrderByDescending(x => x.Order).First().Order + 100;
                foreach (var item in PostList)
                {
                    CheckTaskType(item);
                    item.Order = maxOrder;
                    maxOrder += 100;
                    item.Metadata.IsOH = Calc.OHFactors;
                }
                hasSuccess = await Repo.Task.CreateAsync(PostList, Calc.Id);
            }
            MHD.Notifications(Task.Id == 0 ? ToastType.Add : ToastType.Update, hasSuccess);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        Close();
    }

    void Close() => Modal.Close();
}