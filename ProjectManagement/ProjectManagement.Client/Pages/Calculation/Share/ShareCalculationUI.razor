@using ProjectManagement.Client.Shared.MVVM.Calculation
@using ProjectManagement.Shared.DTO.Calculation
@using ProjectManagement.Shared.DTO.Identity
@using System.Security.Claims
@inherits AppComponentBase
@attribute [Authorize(Roles = PMRolesConst.Tenant.AdminManger)]

<div class="space-y-0 ">
    @if (Form != null)
    {
        <ShareCalculationFormUI ListShareCalc="Form" CalculationId="ListCalculation.Id" Callback="FormCallBack"></ShareCalculationFormUI>
    }
    else
    {
        <div class="container mx-auto px-4">
            <div class="flex flex-wrap gap-2 mt-1">
                @if (Departments != null)
                {
                    @if (page == 0)
                    {
                        foreach (var item in Departments)
                        {
                            <div class="mb-1">
                                <div class="flex items-center gap-1">
                                    <AuthorizeView Roles="@PMRolesConst.Tenant.AdminManger">
                                        <div class="flex items-center gap-1">
                                            <button class="px-2 py-1 border border-blue-600 text-blue-600 rounded transition hover:bg-blue-600 hover:text-white dark:border-blue-400 dark:text-blue-400 dark:hover:bg-blue-400 dark:hover:text-white "
                                                    @onclick="async () => await GetUsersAsync(item)">
                                                @ResourceIdentity.addUser
                                            </button>

                                            <div class="ml-1">
                                                <button disabled="@(list.Any(x => x.DepartmentId == item.Id))"
                                                        class="px-2 py-1 border border-blue-600 text-blue-600 rounded transition hover:bg-blue-600 hover:text-white dark:border-blue-400 dark:text-blue-400 dark:hover:bg-blue-400 dark:hover:text-white "
                                                        @onclick=" ()=> Form = new ListShareCalcDTO(){DepartmentId = item.Id, Department = item.Name}">
                                                    @((MarkupString)Icons.Plus)
                                                </button>
                                            </div>
                                        </div>
                                    </AuthorizeView>

                                    <span class="ml-1 text-gray-600 dark:text-gray-300">
                                        @item.Name
                                    </span>
                                </div>
                            </div>
                        }
                    }

                    @if (Users != null && page == 1)
                    {
                        <div class="mb-1">
                            <button class="px-2 py-1 bg-yellow-400 text-black rounded hover:bg-yellow-500 dark:bg-yellow-500 dark:text-black" @onclick="() => page = 0">
                                @ResourceApp.department
                            </button>
                        </div>

                        @foreach (var user in Users)
                        {
                            <div class="mb-1">
                                <div class="flex items-center gap-1">
                                    <AuthorizeView Roles="@PMRolesConst.Tenant.AdminManger">
                                        <button disabled="@(list.Any(x => x.UserId == user.Id))"
                                                class="px-2 py-1 bg-blue-600 text-white rounded hover:bg-blue-700 dark:bg-blue-500"
                                                @onclick=" ()=> Form = new ListShareCalcDTO(){
                                                DepartmentId = DepartmentSelected?.Id ?? 0,
                                                                            Department = DepartmentSelected?.Name ?? string.Empty,
                                                                            UserId = user.Id,
                                                                            User = user.Name
                                                                        }">
                                                                      @((MarkupString)Icons.Plus)
                                                                  </button>
                                                              </AuthorizeView>

                                <span class="ml-1 text-gray-600 dark:text-gray-300">
                                    @user.Name
                                </span>
                            </div>
                        </div>
                    }
                }
            }
        </div>
    </div>


        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-600">
            <thead class ="@("bg-gray-100 dark:bg-gray-700")">
                <tr>
                    <th></th>
                    <th class="p-1 text-left text-sm font-semibold">@ResourceApp.department</th>
                    <th class="p-1 text-left text-sm font-semibold">@ResourceIdentity.User</th>
                    <th class="p-1 text-left text-sm font-semibold">@CalcResource.netCal</th>
                    <th class="p-1 text-left text-sm font-semibold">@CalcResource.overheadCosts</th>
                    <th class="p-1 text-left text-sm font-semibold">@ResourceLoc.summarySheet</th>
                    <th class="p-1 text-left text-sm font-semibold">@ResourceLoc.opportunitiesRisks</th>
                    <th class="p-1 text-left text-sm font-semibold">@ResourceLoc.offer</th>
                    <th class="p-1 text-left text-sm font-semibold">@ResourceLoc.selfInspection</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 hover:divide-gray-200 dark:divide-gray-700">
                @if (list != null)
                    foreach (var project in Enumerable.Reverse(list))
                    {
                        <tr>
                            <td>
                                <AuthorizeView Roles="@PMRolesConst.Tenant.AdminManger">
                                    <button class="px-2 py-1 bg-blue-600 text-white rounded hover:bg-blue-700 dark:bg-blue-500" @onclick="()=>Form = project">@Icons.Edit</button>
                                    <button class="px-2 py-1 bg-red-600 text-white rounded hover:bg-red-700 dark:bg-red-500" @onclick="()=> Remove(project)">@((MarkupString)@Icons.DeleteSVG)</button>

                                </AuthorizeView>
                            </td>
                            <td>@project.Department</td>
                            <td>@project.User</td>
                            <td><input type="checkbox" checked="@project.Tap1" disabled /></td>
                            <td><input type="checkbox" checked="@project.Tap2" disabled /></td>
                            <td><input type="checkbox" checked="@project.Tap3" disabled /></td>
                            <td><input type="checkbox" checked="@project.Tap4" disabled /></td>
                            <td><input type="checkbox" checked="@project.Tap5" disabled /></td>
                            <td><input type="checkbox" checked="@project.Tap6" disabled /></td>
                        </tr>
                    }
            </tbody>
        </table>
    }
</div>
@code {
    List<ListShareCalcDTO> list = [];
    ListShareCalcDTO? Form;
    [Parameter, EditorRequired] public ListCalculationMVVM ListCalculation { get; set; } = default!;
    int page = 0;
    List<ListDTO> Departments = [];
    List<ListDTO> Users = [];
    ListDTO? DepartmentSelected;
    [Parameter] public EventCallback Callback { get; set; }
    [Inject] AuthenticationStateProvider AuthStateProvider { get; set; } = default!;

    async Task<int> GetUserDepartment()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var claim = authState.User.Claims.FirstOrDefault(x => x.Type == PMClaimsConst.DepartmentId);
        if (claim == null) return 0;
        return Convert.ToInt32(claim.Value);
    }
    void FormCallBack(ListShareCalcDTO? obj)
    {
        if (obj != null)
        {
            list?.Add(obj);
        }
        Form = null;
    }

    async Task GetUsersAsync(ListDTO department)
    {
        DepartmentSelected = department;
        Users = await Repo.Departments.GetUsersAsListAsync(department.Id) ?? [];
        page = 1;
    }
    protected async override Task OnInitializedAsync()
    {
        Departments = await Repo.Departments.GetDepartmentsAsListAsync() ?? [];
        int UserDepartment = await GetUserDepartment();
        Departments.RemoveAll(x => x.Id == UserDepartment);
        list = await Repo.ShareCalc.GetAsync(ListCalculation.Id) ?? [];
    }
    void Remove(ListShareCalcDTO project)
    {
         MHD.DeleteMessage(project.Department + project.User, EventCallback.Factory.Create(this,() => ConfirmRemoveAsync(project)));
    }

    async Task ConfirmRemoveAsync(ListShareCalcDTO project)
    {
        bool result = await Repo.ShareCalc.RemoveAsync(project.Id);
        if (result)
        {
            list.Remove(project);
        }
         MHD.Notifications( ToastType.Delete, result);

        StateHasChanged();
    }
}
