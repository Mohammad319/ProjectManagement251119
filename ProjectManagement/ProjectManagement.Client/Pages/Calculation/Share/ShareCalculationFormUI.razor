@using ProjectManagement.Shared.DTO.Calculation
@inherits AppComponentBase
@attribute [Authorize(Roles = PMRolesConst.Tenant.AdminManger)]

<h3 class="mb-2 text-sm font-medium text-gray-800 dark:text-gray-100">
    @(ResourceApp.department + ": " + ListShareCalc.Department + (string.IsNullOrEmpty(ListShareCalc.User) ? "" : " - " + ListShareCalc.User))
</h3>

<EditForm id="myForm" class="space-y-0" Model="@form" OnValidSubmit="async () => await HandleSubmitAsync()">
    <div class="grid grid-cols-2 gap-2">
        <div class="flex h-9 items-center gap-2 rounded border border-gray-200 bg-gray-50 px-2 dark:border-gray-700 dark:bg-gray-800/60">
            <InputCheckbox @bind-Value="form.Tap1" class="h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-700" />
            <label class="text-sm font-normal text-gray-700 dark:text-gray-300">@CalcResource.netCal</label>
        </div>

        <div class="flex h-9 items-center gap-2 rounded border border-gray-200 bg-gray-50 px-2 dark:border-gray-700 dark:bg-gray-800/60">
            <InputCheckbox @bind-Value="form.Tap2" class="h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-700" />
            <label class="text-sm font-normal text-gray-700 dark:text-gray-300">@CalcResource.overheadCosts</label>
        </div>

        <div class="flex h-9 items-center gap-2 rounded border border-gray-200 bg-gray-50 px-2 dark:border-gray-700 dark:bg-gray-800/60">
            <InputCheckbox @bind-Value="form.Tap3" class="h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-700" />
            <label class="text-sm font-normal text-gray-700 dark:text-gray-300">@ResourceLoc.summarySheet</label>
        </div>

        <div class="flex h-9 items-center gap-2 rounded border border-gray-200 bg-gray-50 px-2 dark:border-gray-700 dark:bg-gray-800/60">
            <InputCheckbox @bind-Value="form.Tap4" class="h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-700" />
            <label class="text-sm font-normal text-gray-700 dark:text-gray-300">@ResourceLoc.opportunitiesRisks</label>
        </div>

        <div class="flex h-9 items-center gap-2 rounded border border-gray-200 bg-gray-50 px-2 dark:border-gray-700 dark:bg-gray-800/60">
            <InputCheckbox @bind-Value="form.Tap5" class="h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-700" />
            <label class="text-sm font-normal text-gray-700 dark:text-gray-300">@ResourceLoc.offer</label>
        </div>

        <div class="flex h-9 items-center gap-2 rounded border border-gray-200 bg-gray-50 px-2 dark:border-gray-700 dark:bg-gray-800/60">
            <InputCheckbox @bind-Value="form.Tap6" class="h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-700" />
            <label class="text-sm font-normal text-gray-700 dark:text-gray-300">@ResourceLoc.selfInspection</label>
        </div>
    </div>
</EditForm>

<div class="mt-2 flex justify-end gap-2 border-t border-gray-200 pt-2 dark:border-gray-700">
    <button type="submit"
            class="inline-flex h-8 items-center justify-center rounded border border-green-600 px-3 text-sm font-normal text-green-600 transition hover:bg-green-600 hover:text-white disabled:cursor-not-allowed disabled:opacity-60 dark:border-green-400 dark:text-green-400 dark:hover:bg-green-400 dark:hover:text-white"
            form="myForm"
            disabled="@IsLoading">
        @ResourceApp.save
    </button>

    <button type="button"
            class="inline-flex h-8 items-center justify-center rounded border border-gray-400 px-3 text-sm font-normal text-gray-600 transition hover:bg-gray-500 hover:text-white dark:border-gray-500 dark:text-gray-300 dark:hover:bg-gray-500 dark:hover:text-white"
            @onclick="async () => await Callback.InvokeAsync(null)">
        @ResourceApp.cancel
    </button>
</div>

@code {
    PostShareCalcDTO form = new();
    bool IsLoading = false;
    [Parameter] public EventCallback<ListShareCalcDTO> Callback { get; set; }
    [Parameter, EditorRequired] public ListShareCalcDTO ListShareCalc { get; set; } = default!;
    [Parameter] public int CalculationId { get; set; }

    protected override void OnInitialized()
    {
        PropertyCopier.CopyPropertiesTo(ListShareCalc, form);
        form.CalculationId = CalculationId;
    }

    private async Task HandleSubmitAsync()
    {
        bool result = false;
        if (ListShareCalc.Id == 0)
        {
            int id = await Repo.ShareCalc.CreateAsync(form);
            PropertyCopier.CopyPropertiesTo(form, ListShareCalc);
            if (id > 0)
            {
                result = true;
                ListShareCalc.Id = id;
                await Callback.InvokeAsync(ListShareCalc);
            }
        }
        else if (ListShareCalc.Id > 0)
        {
            UpdateShareCalcDTO update = new UpdateShareCalcDTO() { Id = ListShareCalc.Id };
            PropertyCopier.CopyPropertiesTo(form, update);
            PropertyCopier.CopyPropertiesTo(update, ListShareCalc);

            if (await Repo.ShareCalc.UpdateAsync(update))
            {
                result = true;
                await Callback.InvokeAsync(null);
            }
        }

        MHD.Notifications(ToastType.Delete, result);
    }
}
