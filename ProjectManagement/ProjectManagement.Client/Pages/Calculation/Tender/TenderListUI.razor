@using ProjectManagement.Client.Pages.Calculation.Tender.Attribute
@using ProjectManagement.Client.Shared.MVVM.Calculation
@using ProjectManagement.Shared.DTO.Calculation
@inherits AppComponentBase

@if (FormAttr != null && result != null)
{
    <TenderAttributeFormUI TenderAttribute="FormAttr" CalcId="Calculation.Id" 
    Tenders="result.Tenders" Callback="CallbackForm">
    </TenderAttributeFormUI>
}
else if (Form != null && result != null)
{
    <TenderFormUI TenderList="Form" CalcId="Calculation.Id" Callback="CallbackForm" 
    Attributes="result.Attributes"></TenderFormUI>
}
else
{
    <div class="space-y-3">
        @if (result != null)
        {
            <!-- شريط علوي يحتوي على العنوان والأزرار -->
            <AuthorizeView Roles="@PMRolesConst.Tenant.AdminManger">
                <div class="mb-2.5 flex flex-wrap items-center justify-between gap-2.5">
                    <div>
                        <h3 class="text-base font-semibold text-slate-800 dark:text-slate-100">
                           @ResourceLoc.tender
                        </h3>
                    </div>

                    <div class="flex flex-wrap gap-2.5">
                        <!-- زر إنشاء خاصية -->
                        <button @onclick="() => FormAttr = new TenderAttributeListDTO()"
                                class="inline-flex items-center rounded-md border border-emerald-600 px-4 py-2 text-base font-medium text-emerald-700 hover:bg-emerald-50 dark:border-emerald-500 dark:text-emerald-300 dark:hover:bg-emerald-900/30 focus:outline-none focus:ring-2 focus:ring-emerald-500/40 gap-2">

                            <span class="text-lg leading-none">
                                @((MarkupString)Icons.Plus)
                            </span>

                            <span>
                                @AppLoc[LocalizerConst.New, ResourceApp.attribute]
                            </span>
                        </button>

                        <!-- زر إنشاء عطاء -->
                        <button @onclick="() => Form = new TenderListDTO()"
                                class="inline-flex items-center rounded-md border border-emerald-600 px-4 py-2 text-base font-medium text-emerald-700 hover:bg-emerald-50 dark:border-emerald-500 dark:text-emerald-300 dark:hover:bg-emerald-900/30 focus:outline-none focus:ring-2 focus:ring-emerald-500/40 gap-2">

                            <span class="text-lg leading-none">
                                @((MarkupString)Icons.Plus)
                            </span>

                            <span>
                                @AppLoc[LocalizerConst.New, ResourceLoc.tender]
                            </span>
                        </button>
                    </div>
                </div>
            </AuthorizeView>

            <!-- بطاقة الجدول -->
            <div class="rounded-xl border border-slate-200 dark:border-slate-700
                                bg-white dark:bg-slate-900 shadow-sm">

                <!-- Scroll أفقي + رأس جدول ثابت -->
                <div class="max-h-[60vh] overflow-auto">
                    <table class="min-w-full border-collapse text-sm">
                        <thead class="sticky top-0 z-10 bg-slate-100 dark:bg-slate-800">
                            <tr class="border-b border-slate-200 dark:border-slate-700">
                                <th class="w-60 px-3 py-2 text-start text-sm font-semibold uppercase tracking-wide text-slate-600 dark:text-slate-300">
                                    @ResourceLoc.company
                                </th>

                                @foreach (var attr in result.Attributes)
                                {
                                    <th class="px-3 py-2 text-center text-sm font-semibold uppercase tracking-wide text-slate-600 dark:text-slate-300">
                                        <div class="flex items-center justify-center gap-2">
                                            <AuthorizeView Roles="@PMRolesConst.Tenant.AdminManger">
                                                <button class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-indigo-600 text-indigo-700 hover:bg-indigo-50 dark:border-indigo-500 dark:text-indigo-300 dark:hover:bg-indigo-900/30 focus:outline-none focus:ring-2 focus:ring-indigo-500/40" title="@ResourceApp.edit"
                                                      @onclick="() => FormAttr = attr">
                                                    @((MarkupString)Icons.Edit)
                                                </button>

                                                <button class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-rose-600 text-rose-700 hover:bg-rose-50 dark:border-rose-500 dark:text-rose-300 dark:hover:bg-rose-900/30 focus:outline-none focus:ring-2 focus:ring-rose-500/40"
                                                        title="@ResourceApp.delete"
                                                      @onclick="() => Remove(attr)">
                                                    @((MarkupString)Icons.DeleteSVG)
                                                </button>
                                            </AuthorizeView>

                                            <span class="inline-flex max-w-[140px] items-center justify-center rounded-full
                                                                     bg-slate-200/70 dark:bg-slate-700/70 px-2.5 py-1 text-sm text-slate-800 dark:text-slate-100">
                                                @attr.Name
                                            </span>
                                        </div>
                                    </th>
                                }

                                <th class="px-3 py-2 text-center text-sm font-semibold uppercase tracking-wide text-slate-600 dark:text-slate-300">
                                    @CalcResource.sum
                                </th>
                            </tr>
                        </thead>

                        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                            @foreach (var tender in result.Tenders)
                            {
                                <tr class="hover:bg-emerald-50/80 dark:hover:bg-emerald-900/40 transition-colors">
                                    <!-- اسم الشركة + أكشن الحذف -->
                                    <td class="whitespace-nowrap px-3 py-2 text-sm md:text-sm font-medium text-slate-800 dark:text-slate-100">
                                        <div class="flex items-center justify-between gap-2">
                                            <span class="truncate">
                                                @tender.Company
                                            </span>

                                            <AuthorizeView Roles="@PMRolesConst.Tenant.AdminManger">
                                                <button class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-rose-600 text-rose-700 hover:bg-rose-50 dark:border-rose-500 dark:text-rose-300 dark:hover:bg-rose-900/30 focus:outline-none focus:ring-2 focus:ring-rose-500/40"
                                                        title="@ResourceApp.delete"
                                                      @onclick="() => Remove(tender)">
                                                    @((MarkupString)Icons.DeleteSVG)
                                                </button>
                                            </AuthorizeView>
                                        </div>
                                    </td>

                                    <!-- قيم الخصائص -->
                                    @foreach (var attr in result.Attributes)
                                    {
                                        <td class="px-2.5 py-2 text-center align-middle">
                                            @{
                                                var zz = tender.Values.FirstOrDefault(r => r.AttributeID == attr.Id);
                                                var value = zz?.Values ?? 0;
                                            }

                                            <input type="number"
                                                   value="@value"
                                                   min="0"
                                                   step="0.01"
                                                   class="w-28 rounded-md border border-slate-300 dark:border-slate-600
                                                                          bg-white dark:bg-slate-800 px-2.5 py-1
                                                                          text-right text-sm text-slate-800 dark:text-slate-100 shadow-sm
                                                                          focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
                                                   @onchange="async (e) => await OnChangeAsync(tender.Id, attr.Id, e)" />
                                        </td>
                                    }

                                    <!-- مجموع العطاء -->
                                    <td class="px-3 py-2 text-center text-sm font-semibold text-emerald-700 dark:text-emerald-300">
                                        <span class="inline-flex items-center justify-center rounded-full
                                                                 bg-emerald-100 dark:bg-emerald-900 px-3 py-1 text-sm font-semibold">
                                            @(tender.Values.Sum(x => x.Values))
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
}

@code {
    Dictionary<int, double> TendersValues = new Dictionary<int, double>();

    async Task OnChangeAsync(int tenderID, int attrID, ChangeEventArgs e)
    {
        if (!string.IsNullOrEmpty(e.Value?.ToString()))
            await Repo.Tender.UpdateBindAsync(tenderID, attrID, Convert.ToDouble(e.Value.ToString()));
    }

    [Parameter] public EventCallback<bool> CallBack { get; set; }
    [Parameter] public ListCalculationMVVM Calculation { get; set; } = default!;

    TenderListDTO? Form;
    TenderAttributeListDTO? FormAttr;
    TenderAttributeValuesListDTO? result;

    async Task CallbackForm(bool isSuccess)
    {
        if (isSuccess)
        {
            result = null;
            await Get();
        }
        Form = null;
        FormAttr = null;
    }

    async Task Get()
    {
         result = await Repo.Tender.GetAllAsync(Calculation.Id);
    }

    protected async override Task OnInitializedAsync()
    {
        await Get();
    }

    void Remove(TenderAttributeListDTO tender)
    {
        MHD.DeleteMessage(tender.Name, EventCallback.Factory.Create(this, () => ConfirmRemoveAsync(tender)));
    }

    async Task ConfirmRemoveAsync(TenderAttributeListDTO tender)
    {
        if (await Repo.Tender.DeleteAttributeAsync(tender.Id, Calculation.Id))
        {
            result?.Attributes.Remove(tender);
            StateHasChanged();
            MHD.Notifications(ToastType.Delete, true);
        }
        else
            MHD.Notifications(ToastType.Delete, false);
    }

    void Remove(TenderListDTO tender)
    {
        MHD.DeleteMessage(tender.Company, EventCallback.Factory.Create(this, () => ConfirmRemoveAsync(tender)));
    }

    async Task ConfirmRemoveAsync(TenderListDTO tender)
    {
        if (await Repo.Tender.DeleteAsync(tender.Id, Calculation.Id))
        {
            result?.Tenders.Remove(tender);
            StateHasChanged();
            MHD.Notifications(ToastType.Delete, true);
        }
        else
            MHD.Notifications(ToastType.Delete, false);
    }
}
