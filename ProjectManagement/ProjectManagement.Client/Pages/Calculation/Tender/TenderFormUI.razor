@using ProjectManagement.Client.Shared.MVVM.Calculation
@using ProjectManagement.Client.Shared.Model.Project
@using ProjectManagement.Client.Shared.Repositories.Calculation
@using ProjectManagement.Client.Shared.Repositories.Organisation
@using ProjectManagement.Shared.DTO.Calculation
@using ProjectManagement.Shared.DTO.Offer
@using ProjectManagement.Shared.DTO.Organisation
@using ProjectManagement.Shared.Base.Calculation
@using System.Text.Json
@inherits AppComponentBase

@if (Income is not null)
{
    <EditForm id="myForm" class="space-y-4" Model="@Income" OnValidSubmit="HandleSubmitAsync">
        <div class="grid gap-4 md:grid-cols-3">
            @if (Companies is not null)
            {
                <div>
                    <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceApp.organisation</label>
                    <select class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100" @onchange="OnChangeCompany">
                        <option value="" selected></option>
                        @foreach (var cat in Companies)
                        {
                            <option value="@cat.Id">@cat.Name</option>
                        }
                    </select>
                </div>
            }

            <div class="md:col-span-2">
                <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">@CalcResource.note</label>
                <InputTextArea @bind-Value="Income.Note" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100" />
                <ValidationMessage For="@(() => Income.Note)" />
            </div>
        </div>
    </EditForm>

    <div class="mt-4 flex items-center justify-end gap-2 border-t border-slate-200 pt-3 dark:border-slate-700">
        <button type="submit" class="inline-flex items-center rounded-md border border-emerald-600 px-4 py-2 text-sm font-medium text-emerald-700 hover:bg-emerald-50 focus:outline-none focus:ring-2 focus:ring-emerald-500/40 disabled:cursor-not-allowed disabled:opacity-60 dark:border-emerald-500 dark:text-emerald-300 dark:hover:bg-emerald-900/30" form="myForm" disabled="@Loading">
            @ResourceApp.save
        </button>
        <button type="button" class="inline-flex items-center rounded-md border border-slate-400 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-slate-500/40 dark:border-slate-500 dark:text-slate-300 dark:hover:bg-slate-800" @onclick="() => Callback.InvokeAsync(false)">
            @ResourceApp.cancel
        </button>
    </div>
}

@code {
    // لو ممكن يجيك null من الأب خليه nullable، وإلا عطه قيمة افتراضية
    [Parameter] public List<TenderAttributeListDTO> Attributes { get; set; } = new();

    [Parameter] public EventCallback<bool> Callback { get; set; }

    // لو TenderList ممكن يجي null من الأب خليه TenderListDTO?
    // إذا متأكد دايمًا موجود: عطه default جديد
    [Parameter] public TenderListDTO TenderList { get; set; } = new();

    [Parameter] public int CalcId { get; set; }

    private int CompanyId;
    private bool Loading = false;

    private List<ListDTO>? Companies;

    // نهيئه من البداية لتجنب null
    private TenderPostDTO? Income;

    private Dictionary<int, double> AttributesValue { get; } = new();

    private void OnChange(ChangeEventArgs ev, int i)
    {
        var raw = ev?.Value?.ToString();

        if (string.IsNullOrWhiteSpace(raw))
        {
            AttributesValue[i] = 0;
            return;
        }

        if (double.TryParse(raw, out var v))
            AttributesValue[i] = v;
        else
            AttributesValue[i] = 0;
    }

    private void OnChangeCompany(ChangeEventArgs e)
    {
        var raw = e?.Value?.ToString();

        if (string.IsNullOrWhiteSpace(raw) || Income is null)
        {
            CompanyId = 0;
            return;
        }

        if (int.TryParse(raw, out var id))
        {
            CompanyId = id;

            // مهم: حدث Income.CompanyId حسب الاختيار الحالي
            Income.CompanyId = id;
        }
        else
        {
            CompanyId = 0;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // تهيئة قيم AttributesValue
        if (TenderList.Id == 0)
        {
            foreach (var item in Attributes)
                AttributesValue[item.Id] = 0;
        }

        Companies = await Repo.Org.GetVisibleOrIdAsync();

        if (TenderList.Id > 0)
        {
            var t = await Repo.Tender.DetailsAsync(TenderList.Id, CalcId);

            Income = new TenderPostDTO
            {
                CompanyId = TenderList.CompanyId,
                Note = t.Note,
            };

            CompanyId = TenderList.CompanyId;
        }
        else
        {
            Income = new TenderPostDTO();
        }

        Loading = false;
    }

    private async Task HandleSubmitAsync()
    {
        if (Income is null) return;

        Loading = true;

        try
        {
            bool isSuccess;

            if (TenderList.CompanyId == 0)
            {
                Income.AttributesValue = AttributesValue;
                isSuccess = (await Repo.Tender.CreateAsync(CalcId, CompanyId, Income)) > 0;
            }
            else
            {
                isSuccess = await Repo.Tender.UpdateAsync(0, CalcId, Income);
            }

            MHD.Notifications(TenderList.CompanyId == 0 ? ToastType.Add : ToastType.Update, isSuccess);
            await Callback.InvokeAsync(isSuccess);
        }
        catch
        {
            MHD.Notifications(TenderList.CompanyId == 0 ? ToastType.Add : ToastType.Update, false);
            await Callback.InvokeAsync(false);
        }
        finally
        {
            Loading = false;
        }
    }
}
