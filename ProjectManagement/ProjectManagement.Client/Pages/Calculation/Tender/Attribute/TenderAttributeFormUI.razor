@using ProjectManagement.Client.Shared.MVVM.Calculation;
@using ProjectManagement.Client.Shared.Model.Project;
@using ProjectManagement.Client.Shared.Repositories.Calculation;
@using ProjectManagement.Client.Shared.Repositories.Offer;
@using ProjectManagement.Shared.DTO.Calculation
@using ProjectManagement.Shared.DTO.Offer;
@using ProjectManagement.Shared.Base.Calculation;
@using System.Text.Json;
@inherits AppComponentBase
<EditForm id="myFormAttr" class="space-y-0 " Model="@Post" OnValidSubmit="async()=> await HandleSubmitAsync()">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-2">
        <div class="md:col-span-2">
        <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.name </label>
        <InputText @bind-Value="Post.Name" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" />
        <ValidationMessage For=@(() => Post.Name) />
    </div>
        <div class="md:col-span-2">
        <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.note </label>
        <InputTextArea @bind-Value="Post.Note" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" />
        <ValidationMessage For=@(() => Post.Note) />
    </div>
    @if (TenderAttribute.Id == 0) for (int i = 0; i < TendersValues.Count; i++)
        {
            var buttonNumber = i;
            <div>
                <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@Tenders[i].Company </label>
                <input type="number" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" @onchange="(e)=> OnChange(e,TendersValues.ElementAt(buttonNumber).Key)" />
            </div>
        }
    </div>
</EditForm>

<div class="mt-1 flex justify-end gap-1">
    <button type="submit" class="px-2 py-1 border border-green-600 text-green-600 rounded transition hover:bg-green-600 hover:text-white dark:border-green-400 dark:text-green-400 dark:hover:bg-green-400 dark:hover:text-white " form="myFormAttr" disabled="@IsLoading">
        @ResourceApp.save
    </button>
    <button type="button" class="px-2 py-1 border border-gray-500 text-gray-500 rounded transition hover:bg-gray-500 hover:text-white dark:border-gray-400 dark:text-gray-400 dark:hover:bg-gray-400 dark:hover:text-white " @onclick="async ()=> await Callback.InvokeAsync(false)">@ResourceApp.cancel</button>
</div>
@code {
    void OnChange(ChangeEventArgs ev,int i)
    {
        if (string.IsNullOrEmpty(ev.Value?.ToString()))
        {
            TendersValues[i] = 0;
        }
        else
        {
            string s = ev.Value?.ToString() ?? "0";
            var t = Convert.ToDouble(s);
            TendersValues[i] = t;
        }
    }
    [Parameter] public EventCallback<bool> Callback { get; set; }
    bool IsLoading = false;
    [Parameter] public List<TenderListDTO> Tenders { get; set; } = new();
    [Parameter] public int CalcId { get; set; }

    [Parameter] public TenderAttributeListDTO TenderAttribute { get; set; } = new();
    TenderAttributeListPostDTO Post = new();
    Dictionary<int, double> TendersValues = new Dictionary<int, double>();
    protected override void OnInitialized()
    {
        if (TenderAttribute.Id ==0)
            foreach (var item in Tenders)
            {
                TendersValues.Add(item.Id,0);
            }
        Post = new TenderAttributeListPostDTO()
        {
                Name = TenderAttribute.Name,
                Note = TenderAttribute.Note,
        };
    }
    async Task HandleSubmitAsync()
    {
        IsLoading = true;
        try
        {
            bool isSuccess;
            if (TenderAttribute.Id == 0)
            {
                Post.TendersValues = TendersValues;
                isSuccess = (await Repo.Tender.CreateAsync(CalcId, Post)) > 0;
            }
            else
            {
                isSuccess = await Repo.Tender.UpdateAsync(TenderAttribute.Id, CalcId, Post);
            }
             MHD.Notifications(TenderAttribute.Id == 0 ? ToastType.Add : ToastType.Update, isSuccess);
            await Callback.InvokeAsync(isSuccess);
        }
        catch
        {
             MHD.Notifications(TenderAttribute.Id == 0 ? ToastType.Add : ToastType.Update, false);
           // Console.WriteLine(ex.Message);
        }
        await Callback.InvokeAsync(false);
        IsLoading = false;
    }
}
