@using ProjectManagement.Shared.DTO.Calculation
@using ProjectManagement.Shared.DTO.Project
@inherits AppComponentBase

    <div class="space-y-0 ">
        @if (ProjectDetails != null)
        {
        <dl class="grid grid-cols-1 md:grid-cols-3 gap-2">
            <dt>@CalcResource.name</dt>
            <dd class="md:col-span-2">@ProjectDetails.Name</dd>
                <dt>@CalcResource.procurement</dt>
            <dd class="md:col-span-2">@ProjectDetails.Procurement</dd>
                <dt>@CalcResource.procurementMethods</dt>
            <dd class="md:col-span-2">@ProjectDetails.ProcurementMethods</dd>
                <dt>@CalcResource.projectContract</dt>
                <dd class="md:col-span-2">@ProjectDetails.Contract</dd>
            </dl>
        }
    </div>

@code {
    CalculationDetailsDTO? ProjectDetails;
    [Parameter] public int Id { get; set; }

    protected async override Task OnInitializedAsync()
    {
        ProjectDetails = await Repo.Calculation.DetailsAsync(Id);
    }
}
