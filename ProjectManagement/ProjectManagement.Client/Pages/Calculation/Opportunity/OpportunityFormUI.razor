@using ProjectManagement.Client.Shared.Model.Project.Calculation;
@using ProjectManagement.Shared.DTO.Calculation
@inherits AppComponentBase
@attribute [Authorize(Roles = PMRolesConst.Tenant.AdminManger)]

<EditForm class="space-y-0 " Model="@Post" OnValidSubmit="async () => await HandleSubmitAsync()" id="custForm">
    <DataAnnotationsValidator />
    <div class="grid grid-cols-1 md:grid-cols-4 gap-2">

        <div>
            <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@ResourceLoc.opportunitiesRisks:</label>
            <InputText class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" @bind-Value="@Post.OpportunitiesRisks" />
            <ValidationMessage For="@(() => Post.OpportunitiesRisks)" />
        </div>

        <div>
            <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.risk:</label>
            <InputText class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" @bind-Value="@Post.OpportunityType" />
            <ValidationMessage For="@(() => Post.OpportunityType)" />
        </div>

        <div>
            <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@ResourceLoc.probabilityWorth:</label>
            <InputNumber class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" @bind-Value="@Post.Metadata.ProbabilityWorth" />
            <ValidationMessage For="@(() => Post.Metadata.ProbabilityWorth)" />
        </div>

        <div>
            <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@ResourceLoc.probability:</label>
            <InputNumber class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" @bind-Value="@Post.Metadata.ProbabilityPercent" />
            <ValidationMessage For="@(() => Post.Metadata.ProbabilityPercent)" />
        </div>

        <div>
            <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@ResourceLoc.probabilityBest:</label>
            <InputNumber class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" @bind-Value="@Post.Metadata.ProbabilityBest" />
            <ValidationMessage For="@(() => Post.Metadata.ProbabilityBest)" />
        </div>

        <div>
            <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@ResourceLoc.value:</label>
            <InputNumber class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" @bind-Value="@Post.Metadata.Value" />
            <ValidationMessage For="@(() => Post.Metadata.Value)" />
        </div>

        <div class="md:col-span-2">
            <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.note:</label>
            <InputTextArea class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" @bind-Value="@Post.Metadata.Comment" />
            <ValidationMessage For="@(() => Post.Metadata.Comment)" />
        </div>

    </div>

    </EditForm>
<div class="mt-1 flex justify-end gap-1">
        <button type="submit" form="custForm" class="px-2 py-1 border border-green-600 text-green-600 rounded transition hover:bg-green-600 hover:text-white dark:border-green-400 dark:text-green-400 dark:hover:bg-green-400 dark:hover:text-white " disabled="@IsLoading">
            @ResourceApp.save
        </button>
        <button type="button" class="px-2 py-1 border border-gray-500 text-gray-500 rounded transition hover:bg-gray-500 hover:text-white dark:border-gray-400 dark:text-gray-400 dark:hover:bg-gray-400 dark:hover:text-white " data-dismiss="modal" @onclick=" Modal.Close">@ResourceApp.cancel</button>
    </div>



@code {
    PostOpportunityDTO Post = new();
    bool IsLoading = false;
    [Parameter] public OpportunityModel Opportunity { get; set; } = default!;

    protected override void OnInitialized()
    {
        PropertyCopier.CopyPropertiesTo<OpportunityModel, PostOpportunityDTO>(Opportunity, Post);
        IsLoading = false;
    }

    private async Task HandleSubmitAsync()
    {
        IsLoading = true;
        try
        {
            PropertyCopier.CopyPropertiesTo(Post, Opportunity);

            if (Opportunity.Id == 0){
                bool result = await Repo.Opportunity.CreateAsync(Post, Calc.Id) > 0;
                 MHD.Notifications(ToastType.Add, result);
            }
            else {
                bool result = await Repo.Opportunity.UpdateAsync(Post, Opportunity.Id);
                 MHD.Notifications(ToastType.Update, result);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        IsLoading = false;
         Modal.Close();
    }
}
