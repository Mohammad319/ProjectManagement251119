@using ProjectManagement.Client.Shared.Model.Project.Calculation;
@using ProjectManagement.Shared.DTO.Calculation
@inherits AppComponentBase
@attribute [Authorize(Roles = PMRolesConst.Tenant.AdminManger)]

<EditForm class="space-y-4" Model="@Post" OnValidSubmit="async () => await HandleSubmitAsync()" id="custForm">
    <DataAnnotationsValidator />
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">

        <div>
            <label class="block mb-1 text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceLoc.opportunitiesRisks:</label>
            <InputText class="w-full px-3 py-2 text-sm border rounded-md bg-white dark:bg-slate-900 border-slate-300 dark:border-slate-700 text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-cyan-500/40 dark:focus:ring-cyan-400/40 focus:border-cyan-500 dark:focus:border-cyan-400" @bind-Value="@Post.OpportunitiesRisks" />
            <ValidationMessage For="@(() => Post.OpportunitiesRisks)" />
        </div>

        <div>
            <label class="block mb-1 text-sm font-medium text-slate-700 dark:text-slate-200">@CalcResource.risk:</label>
            <InputText class="w-full px-3 py-2 text-sm border rounded-md bg-white dark:bg-slate-900 border-slate-300 dark:border-slate-700 text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-cyan-500/40 dark:focus:ring-cyan-400/40 focus:border-cyan-500 dark:focus:border-cyan-400" @bind-Value="@Post.OpportunityType" />
            <ValidationMessage For="@(() => Post.OpportunityType)" />
        </div>

        <div>
            <label class="block mb-1 text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceLoc.probabilityWorth:</label>
            <InputNumber class="w-full px-3 py-2 text-sm border rounded-md bg-white dark:bg-slate-900 border-slate-300 dark:border-slate-700 text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-cyan-500/40 dark:focus:ring-cyan-400/40 focus:border-cyan-500 dark:focus:border-cyan-400" @bind-Value="@Post.Metadata.ProbabilityWorth" />
            <ValidationMessage For="@(() => Post.Metadata.ProbabilityWorth)" />
        </div>

        <div>
            <label class="block mb-1 text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceLoc.probability:</label>
            <InputNumber class="w-full px-3 py-2 text-sm border rounded-md bg-white dark:bg-slate-900 border-slate-300 dark:border-slate-700 text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-cyan-500/40 dark:focus:ring-cyan-400/40 focus:border-cyan-500 dark:focus:border-cyan-400" @bind-Value="@Post.Metadata.ProbabilityPercent" />
            <ValidationMessage For="@(() => Post.Metadata.ProbabilityPercent)" />
        </div>

        <div>
            <label class="block mb-1 text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceLoc.probabilityBest:</label>
            <InputNumber class="w-full px-3 py-2 text-sm border rounded-md bg-white dark:bg-slate-900 border-slate-300 dark:border-slate-700 text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-cyan-500/40 dark:focus:ring-cyan-400/40 focus:border-cyan-500 dark:focus:border-cyan-400" @bind-Value="@Post.Metadata.ProbabilityBest" />
            <ValidationMessage For="@(() => Post.Metadata.ProbabilityBest)" />
        </div>

        <div>
            <label class="block mb-1 text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceLoc.value:</label>
            <InputNumber class="w-full px-3 py-2 text-sm border rounded-md bg-white dark:bg-slate-900 border-slate-300 dark:border-slate-700 text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-cyan-500/40 dark:focus:ring-cyan-400/40 focus:border-cyan-500 dark:focus:border-cyan-400" @bind-Value="@Post.Metadata.Value" />
            <ValidationMessage For="@(() => Post.Metadata.Value)" />
        </div>

        <div class="md:col-span-2">
            <label class="block mb-1 text-sm font-medium text-slate-700 dark:text-slate-200">@CalcResource.note:</label>
            <InputTextArea class="w-full px-3 py-2 text-sm border rounded-md bg-white dark:bg-slate-900 border-slate-300 dark:border-slate-700 text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-cyan-500/40 dark:focus:ring-cyan-400/40 focus:border-cyan-500 dark:focus:border-cyan-400" @bind-Value="@Post.Metadata.Comment" />
            <ValidationMessage For="@(() => Post.Metadata.Comment)" />
        </div>

    </div>

    </EditForm>
<div class="mt-4 flex items-center justify-end gap-2 border-t border-slate-200 dark:border-slate-700 pt-3">
        <button type="submit" form="custForm" class="inline-flex items-center rounded-md border border-emerald-500 px-4 py-2 text-sm font-medium text-emerald-600 hover:bg-emerald-50 dark:text-emerald-400 dark:border-emerald-600 dark:hover:bg-emerald-900/20 disabled:opacity-60 disabled:cursor-not-allowed focus:outline-none focus:ring-2 focus:ring-emerald-500/40 dark:focus:ring-emerald-400/40" disabled="@IsLoading">
            @ResourceApp.save
        </button>
        <button type="button" class="inline-flex items-center rounded-md border border-slate-400 px-4 py-2 text-sm font-medium text-slate-600 hover:bg-slate-100 dark:border-slate-600 dark:text-slate-300 dark:hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-slate-500/30 dark:focus:ring-slate-400/30" data-dismiss="modal" @onclick=" Modal.Close">@ResourceApp.cancel</button>
    </div>



@code {
    PostOpportunityDTO Post = new();
    bool IsLoading = false;
    [Parameter] public OpportunityModel Opportunity { get; set; } = default!;

    protected override void OnInitialized()
    {
        PropertyCopier.CopyPropertiesTo<OpportunityModel, PostOpportunityDTO>(Opportunity, Post);
        IsLoading = false;
    }

    private async Task HandleSubmitAsync()
    {
        IsLoading = true;
        try
        {
            PropertyCopier.CopyPropertiesTo(Post, Opportunity);

            if (Opportunity.Id == 0){
                bool result = await Repo.Opportunity.CreateAsync(Post, Calc.Id) > 0;
                 MHD.Notifications(ToastType.Add, result);
            }
            else {
                bool result = await Repo.Opportunity.UpdateAsync(Post, Opportunity.Id);
                 MHD.Notifications(ToastType.Update, result);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        IsLoading = false;
         Modal.Close();
    }
}
