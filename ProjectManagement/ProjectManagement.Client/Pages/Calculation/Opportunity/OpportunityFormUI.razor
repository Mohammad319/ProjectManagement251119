@using ProjectManagement.Client.Shared.Model.Project.Calculation;
@using ProjectManagement.Shared.DTO.Calculation
@inherits AppComponentBase
@attribute [Authorize(Roles = PMRolesConst.Tenant.AdminManger)]

<EditForm class="space-y-3 p-3 text-slate-800 dark:text-slate-100" Model="@Post" OnValidSubmit="async () => await HandleSubmitAsync()" id="custForm">
    <DataAnnotationsValidator />

    <div class="grid grid-cols-2 gap-3">
        <div class="flex flex-col gap-1">
            <label class="text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceLoc.opportunitiesRisks:</label>
            <InputText class="h-9 w-full rounded-lg border border-slate-300 bg-white px-2 py-1 text-sm text-slate-900 outline-none transition focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:focus:border-cyan-400 dark:focus:ring-cyan-400/20"
                       @bind-Value="@Post.OpportunitiesRisks" />
            <ValidationMessage For="@(() => Post.OpportunitiesRisks)" />
        </div>

        <div class="flex flex-col gap-1">
            <label class="text-sm font-medium text-slate-700 dark:text-slate-200">@CalcResource.risk:</label>
            <InputText class="h-9 w-full rounded-lg border border-slate-300 bg-white px-2 py-1 text-sm text-slate-900 outline-none transition focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:focus:border-cyan-400 dark:focus:ring-cyan-400/20"
                       @bind-Value="@Post.OpportunityType" />
            <ValidationMessage For="@(() => Post.OpportunityType)" />
        </div>

        <div class="flex flex-col gap-1">
            <label class="text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceLoc.probabilityWorth:</label>
            <InputNumber class="h-9 w-full rounded-lg border border-slate-300 bg-white px-2 py-1 text-sm text-slate-900 outline-none transition focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:focus:border-cyan-400 dark:focus:ring-cyan-400/20"
                         @bind-Value="@Post.Metadata.ProbabilityWorth" />
            <ValidationMessage For="@(() => Post.Metadata.ProbabilityWorth)" />
        </div>

        <div class="flex flex-col gap-1">
            <label class="text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceLoc.probability:</label>
            <InputNumber class="h-9 w-full rounded-lg border border-slate-300 bg-white px-2 py-1 text-sm text-slate-900 outline-none transition focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:focus:border-cyan-400 dark:focus:ring-cyan-400/20"
                         @bind-Value="@Post.Metadata.ProbabilityPercent" />
            <ValidationMessage For="@(() => Post.Metadata.ProbabilityPercent)" />
        </div>

        <div class="flex flex-col gap-1">
            <label class="text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceLoc.probabilityBest:</label>
            <InputNumber class="h-9 w-full rounded-lg border border-slate-300 bg-white px-2 py-1 text-sm text-slate-900 outline-none transition focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:focus:border-cyan-400 dark:focus:ring-cyan-400/20"
                         @bind-Value="@Post.Metadata.ProbabilityBest" />
            <ValidationMessage For="@(() => Post.Metadata.ProbabilityBest)" />
        </div>

        <div class="flex flex-col gap-1">
            <label class="text-sm font-medium text-slate-700 dark:text-slate-200">@ResourceLoc.value:</label>
            <InputNumber class="h-9 w-full rounded-lg border border-slate-300 bg-white px-2 py-1 text-sm text-slate-900 outline-none transition focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:focus:border-cyan-400 dark:focus:ring-cyan-400/20"
                         @bind-Value="@Post.Metadata.Value" />
            <ValidationMessage For="@(() => Post.Metadata.Value)" />
        </div>

        <div class="col-span-2 flex flex-col gap-1">
            <label class="text-sm font-medium text-slate-700 dark:text-slate-200">@CalcResource.note:</label>
            <InputTextArea class="min-h-[84px] w-full rounded-lg border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-900 outline-none transition focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:focus:border-cyan-400 dark:focus:ring-cyan-400/20"
                           @bind-Value="@Post.Metadata.Comment" />
            <ValidationMessage For="@(() => Post.Metadata.Comment)" />
        </div>
    </div>
</EditForm>

<div class="flex items-center justify-end gap-2 border-t border-slate-200 px-3 py-2.5 dark:border-slate-700">
    <button type="submit"
            form="custForm"
            class="inline-flex h-9 items-center justify-center rounded-lg border border-emerald-600 px-4 text-sm font-medium text-emerald-700 transition hover:bg-emerald-600 hover:text-white disabled:cursor-not-allowed disabled:opacity-60 dark:border-emerald-500 dark:text-emerald-400 dark:hover:bg-emerald-500 dark:hover:text-slate-900"
            disabled="@IsLoading">
        @ResourceApp.save
    </button>

    <button type="button"
            class="inline-flex h-9 items-center justify-center rounded-lg border border-slate-300 px-4 text-sm font-medium text-slate-700 transition hover:bg-slate-100 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-800"
            data-dismiss="modal"
            @onclick="Modal.Close">
        @ResourceApp.cancel
    </button>
</div>

@code {
    PostOpportunityDTO Post = new();
    bool IsLoading = false;
    [Parameter] public OpportunityModel Opportunity { get; set; } = default!;

    protected override void OnInitialized()
    {
        PropertyCopier.CopyPropertiesTo<OpportunityModel, PostOpportunityDTO>(Opportunity, Post);
        IsLoading = false;
    }

    private async Task HandleSubmitAsync()
    {
        IsLoading = true;
        try
        {
            PropertyCopier.CopyPropertiesTo(Post, Opportunity);

            if (Opportunity.Id == 0)
            {
                bool result = await Repo.Opportunity.CreateAsync(Post, Calc.Id) > 0;
                MHD.Notifications(ToastType.Add, result);
            }
            else
            {
                bool result = await Repo.Opportunity.UpdateAsync(Post, Opportunity.Id);
                MHD.Notifications(ToastType.Update, result);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        IsLoading = false;
        Modal.Close();
    }
}
