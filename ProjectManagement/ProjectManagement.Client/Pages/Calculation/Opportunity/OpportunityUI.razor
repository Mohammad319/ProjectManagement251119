@using BlazorMHD.UI.Components.Data.Card
@using BlazorMHD.UI.Core.Services
@using ProjectManagement.Client.Shared.Model.Project.Calculation
@using ProjectManagement.Client.Constant
@using ProjectManagement.Client.Helper
@inherits AppComponentBase
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="pl-1 @(Calc.Tap4 ? "" : "pointer-events-none opacity-60")">
    <div class="max-h-[420px] overflow-x-auto overflow-y-auto rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">
        <table id="tableOpportunity" class="min-w-full table-auto border-collapse text-[13px] leading-4">
            <thead class="text-slate-900 dark:text-slate-100">
                @if (Calc?.Opportunities != null)
                {
                    <tr class="p-1 bg-cyan-50 text-xs font-semibold dark:bg-cyan-900/50">
                        <th class="sticky top-0 z-10 w-[104px] bg-cyan-50 text-center align-middle dark:bg-cyan-900/50"></th>
                        <th class="sticky top-0 z-10 bg-cyan-50 text-center align-middle dark:bg-cyan-900/50"></th>
                        <th class="sticky top-0 z-10 bg-cyan-50 text-center align-middle dark:bg-cyan-900/50"></th>
                        <th class="sticky top-0 z-10 bg-cyan-50 text-center align-middle font-bold text-emerald-600 dark:bg-cyan-900/50 dark:text-emerald-400">
                            @Calc.Opportunities.Sum(x => x.Metadata.ProbabilityWorth)
                        </th>
                        <th class="sticky top-0 z-10 bg-cyan-50 text-center align-middle dark:bg-cyan-900/50"></th>
                        <th class="sticky top-0 z-10 bg-cyan-50 text-center align-middle font-bold text-blue-600 dark:bg-cyan-900/50 dark:text-blue-400">
                            @Template.Format(GetTotalProbabilityValue())
                        </th>
                        <th class="sticky top-0 z-10 bg-cyan-50 text-center align-middle font-bold text-amber-600 dark:bg-cyan-900/50 dark:text-amber-400">
                            @Calc.Opportunities.Sum(x => x.Metadata.ProbabilityBest)
                        </th>
                        <th class="sticky top-0 z-10 bg-cyan-50 text-center align-middle font-bold text-slate-700 dark:bg-cyan-900/50 dark:text-slate-100">
                            @Calc.Opportunities.Sum(x => x.Metadata.Value)
                        </th>
                    </tr>
                }

                <tr class="p-1 bg-slate-100 text-[11px] uppercase tracking-wide text-slate-700 dark:bg-slate-800 dark:text-slate-200">
                    <th class="sticky top-0 z-10 w-[104px] bg-slate-100 text-center align-middle dark:bg-slate-800">
                        <AuthorizeView Roles="@PMRolesConst.Tenant.AdminManger">
                            <button type="button"
                                    class="inline-flex h-7 w-7 items-center justify-center rounded-md border border-emerald-300 text-emerald-600 transition hover:bg-emerald-50 dark:border-emerald-700 dark:text-emerald-400 dark:hover:bg-emerald-900/20"
                                    title="@AppLoc[LocalizerConst.New, CalcResource.opportunity]"
                                    @onclick="() => UpdateForm(new OpportunityModel())">
                                @((MarkupString)Icons.Plus)
                            </button>
                        </AuthorizeView>
                    </th>
                    <th class="sticky top-0 z-10 bg-slate-100 text-center align-middle dark:bg-slate-800">@ResourceLoc.opportunitiesRisks</th>
                    <th class="sticky top-0 z-10 bg-slate-100 text-center align-middle dark:bg-slate-800">@CalcResource.risk</th>
                    <th class="sticky top-0 z-10 bg-slate-100 text-center align-middle dark:bg-slate-800">@ResourceLoc.probabilityWorth</th>
                    <th class="sticky top-0 z-10 bg-slate-100 text-center align-middle dark:bg-slate-800">@ResourceLoc.probability</th>
                    <th class="sticky top-0 z-10 bg-slate-100 text-center align-middle dark:bg-slate-800">@ResourceLoc.probabilityValue</th>
                    <th class="sticky top-0 z-10 bg-slate-100 text-center align-middle dark:bg-slate-800">@ResourceLoc.probabilityBest</th>
                    <th class="sticky top-0 z-10 bg-slate-100 text-center align-middle dark:bg-slate-800">@ResourceLoc.value</th>
                </tr>
            </thead>

            <tbody class="bg-white text-slate-700 dark:bg-slate-900 dark:text-slate-100">
                @if (Calc?.Opportunities != null)
                {
                    foreach (var status in Calc.Opportunities)
                    {
                        <tr class="p-1 group cursor-pointer border-b border-slate-100 transition-colors hover:bg-slate-50 dark:border-slate-800 dark:hover:bg-slate-800/60"
                            @oncontextmenu:preventDefault
                            @oncontextmenu="async () => await Context(status)">

                            <td class="text-center align-middle">
                                <div class="inline-flex items-center gap-1">
                                    @if (!string.IsNullOrEmpty(status.Metadata.Comment))
                                    {
                                        <button type="button"
                                                class="inline-flex h-6 w-6 items-center justify-center rounded-md border border-slate-300 text-[11px] transition hover:bg-slate-100 dark:border-slate-600 dark:hover:bg-slate-700"
                                                @onclick="() => status.ShowComment = !status.ShowComment"
                                                title="@CalcResource.comment">
                                            @((MarkupString)Icons.TopBottom(status.ShowComment))
                                        </button>
                                    }

                                    <button type="button"
                                            class="inline-flex h-7 w-7 items-center justify-center rounded-md border border-blue-300 text-blue-600 transition hover:bg-blue-50 dark:border-blue-700 dark:text-blue-400 dark:hover:bg-blue-900/20"
                                            title="@ResourceApp.edit"
                                            @onclick="() => UpdateForm(status)">
                                        @((MarkupString)Icons.Edit)
                                    </button>

                                    <button type="button"
                                            class="inline-flex h-7 w-7 items-center justify-center rounded-md border border-rose-300 text-rose-600 transition hover:bg-rose-50 dark:border-rose-700 dark:text-rose-400 dark:hover:bg-rose-900/20"
                                            title="@ResourceApp.delete"
                                            @onclick="() => Remove(status)">
                                        @((MarkupString)Icons.Delete)
                                    </button>
                                </div>
                            </td>

                            <td class="max-w-[220px] text-center align-middle">
                                <span class="block truncate" title="@status.OpportunitiesRisks">@status.OpportunitiesRisks</span>
                            </td>

                            <td class="text-center align-middle">
                                <span class="inline-flex items-center rounded-full bg-slate-100 px-1 py-0.5 text-[11px] text-slate-700 dark:bg-slate-800 dark:text-slate-200">
                                    @status.OpportunityType
                                </span>
                            </td>

                            <td class="text-center align-middle">
                                @status.Metadata.ProbabilityWorth
                            </td>

                            <td class="text-center align-middle">
                                @status.Metadata.ProbabilityPercent%
                            </td>

                            <td class="text-center align-middle font-medium text-blue-700 dark:text-blue-300">
                                @Template.Format(GetProbabilityValue(status))
                            </td>

                            <td class="text-center align-middle">
                                @status.Metadata.ProbabilityBest
                            </td>

                            <td class="text-center align-middle font-medium text-slate-800 dark:text-slate-100">
                                @Template.Format(status.Metadata.Value ?? 0)
                            </td>
                        </tr>

                        @if (status.ShowComment)
                        {
                            <tr class="p-1 border-b border-slate-100 bg-slate-50/70 dark:border-slate-800 dark:bg-slate-800/40">
                                <td></td>
                                <td colspan="7" class="text-start align-middle text-slate-700 dark:text-slate-200">
                                    <div class="rounded-lg border border-slate-200 bg-white/80 px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-900/70">
                                        @status.Metadata.Comment
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    decimal GetTotalProbabilityValue() =>
        Calc?.Opportunities?.Sum(GetProbabilityValue) ?? 0m;

    static decimal GetProbabilityValue(OpportunityModel item) =>
        ((item.Metadata.ProbabilityPercent ?? 0m) * (item.Metadata.Value ?? 0m)) / 100m;

    async Task Context(OpportunityModel item)
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        bool isInAnyRole = PMRolesConst.Tenant.AdminManger.Split(',').Any(r => user.IsInRole(r));

        if (!(user.Identity?.IsAuthenticated == true && isInAnyRole)) return;

        var list = new List<MenuItem>()
        {
            new() {
                Label = ResourceApp.edit,
                OnClickAsync = () =>
                {
                    UpdateForm(item);
                    return Task.CompletedTask;
                }
            },
            new() {
                Label = ResourceApp.delete,
                OnClickAsync = () =>
                {
                    Remove(item);
                    return Task.CompletedTask;
                }
            },
        };

        await ContextService.ShowMenuAsync(list);
    }

    void UpdateForm(OpportunityModel model)
    {
        Modal.ShowComponent<OpportunityFormUI>(
            model.Id == 0
                ? AppLoc[LocalizerConst.New, CalcResource.opportunity]
                : AppLoc[LocalizerConst.Update, model.OpportunitiesRisks ?? string.Empty],
            new Dictionary<string, object>
            {
                [nameof(OpportunityFormUI.Opportunity)] = model,
            },
            DialogSize.ExtraLarge,
            DialogButtonsHelper.CreateSaveCancelButtons(OpportunityFormUI.DialogFormId));
    }

    protected override void OnInitialized()
    {
        if (Folder?.State?.Calculation != null)
            Folder.State.Calculation.OnChangeInCalculation += ChangeCalcultionItems;
    }

    public void Dispose()
    {
        if (Folder?.State?.Calculation != null)
            Folder.State.Calculation.OnChangeInCalculation -= ChangeCalcultionItems;
    }

    void ChangeCalcultionItems() => _ = InvokeAsync(StateHasChanged);

    void Remove(OpportunityModel status) =>
        MHD.DeleteMessage(string.Empty, EventCallback.Factory.Create(this, () => ConfirmRemoveAsync(status)));

    async Task ConfirmRemoveAsync(OpportunityModel st)
    {
        bool result = await Repo.Opportunity.DeleteAsync(st.Id);
        MHD.Notifications(ToastType.Delete, result);
    }
}
