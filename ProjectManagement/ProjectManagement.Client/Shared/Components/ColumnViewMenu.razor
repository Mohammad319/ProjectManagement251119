@namespace ProjectManagement.Client.Shared.Components
@using BlazorMHD.UI.Core.Data
@using ProjectManagement.Client.Shared.ResourceFiles.APP
@inject Microsoft.Extensions.Localization.IStringLocalizer<ResourceApp> AppLoc

@* Shared "Kolumnvyer" menu section: Standard + personal saved column views,
   the save-current-view prompt, and the column-picker panel. Backed by a
   MhdColumnViewManager. The project and calculation right-panel lists render this
   inside their "Vy" dropdown, so the markup/behavior lives in one place.

   Prompt/panel state is local: the host unmounts this section when its dropdown
   closes, so the state resets naturally on reopen. Apply raises OnViewApplied so
   the host can close the outer dropdown; column toggles raise OnColumnsChanged so
   the host re-renders the table and any hidden-filter notices. *@

@* ── Kolumnvyer ── *@
<div class="flex items-center justify-between gap-2 px-3 pt-1.5 pb-0.5">
    <span class="text-[10px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500">Kolumnvyer</span>
    <span class="truncate text-[10px] font-medium @(Manager.IsSelectedViewModified ? "text-amber-600 dark:text-amber-400" : "text-slate-400 dark:text-slate-500")"
          title="Aktiv kolumnvy">@Manager.ActiveViewLabel</span>
</div>

@* Standard (built-in, always available) *@
<button type="button"
        class="@(Manager.IsStandardViewActive ? "flex w-full items-center gap-2 px-3 py-1.5 text-[11px] text-blue-700 dark:text-blue-300" : "flex w-full items-center gap-2 px-3 py-1.5 text-[11px] text-slate-700 hover:bg-slate-50 dark:text-slate-200 dark:hover:bg-slate-800")"
        title="Använd: Standard"
        @onclick="ApplyStandardAsync">
    <svg class="h-3 w-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
    </svg>
    <span class="flex-1 text-left">Standard</span>
    @if (Manager.IsStandardViewActive)
    {
        <svg class="ml-auto h-3 w-3 shrink-0 text-blue-600 dark:text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
    }
</button>

@* Egna sparade kolumnvyer *@
@if (Manager.SavedViews.Count > 0)
{
    <div class="max-h-44 overflow-y-auto">
        @foreach (var view in Manager.SavedViews)
        {
            var currentView = view;
            <div class="group/view flex items-center gap-1 px-3 py-1 hover:bg-slate-50 dark:hover:bg-slate-800">
                <button type="button"
                        class="@(Manager.IsViewActive(currentView) ? "flex min-w-0 flex-1 items-center gap-2 text-left text-[11px] text-blue-700 dark:text-blue-300" : "flex min-w-0 flex-1 items-center gap-2 text-left text-[11px] text-slate-700 dark:text-slate-200")"
                        title="Använd: @currentView.Name"
                        @onclick="() => ApplySavedAsync(currentView)">
                    <svg class="h-3 w-3 shrink-0 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
                    <span class="truncate">@currentView.Name</span>
                    @if (Manager.IsViewActive(currentView))
                    {
                        <svg class="ml-auto h-3 w-3 shrink-0 text-blue-600 dark:text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
                    }
                </button>
                <button type="button"
                        class="shrink-0 rounded p-0.5 text-slate-400 transition hover:bg-red-50 hover:text-red-600 dark:hover:bg-red-950/30 dark:hover:text-red-400"
                        title="Ta bort: @currentView.Name"
                        @onclick="() => DeleteAsync(currentView)">
                    <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                </button>
            </div>
        }
    </div>
}

@* Spara aktuell kolumnvy *@
@if (_saveViewPromptOpen)
{
    <div class="px-3 py-1.5">
        <label class="mb-1 block text-[10px] font-semibold text-slate-500 dark:text-slate-400">Namn på kolumnvy</label>
        <input type="text"
               class="w-full rounded border border-slate-300 bg-white px-2 py-1 text-[11px] text-slate-800 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500/30 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
               placeholder="T.ex. Kompakt"
               @bind="_saveViewName"
               @bind:event="oninput" />
        @if (!string.IsNullOrEmpty(_saveViewError))
        {
            <p class="mt-1 text-[10px] text-red-600 dark:text-red-400">@_saveViewError</p>
        }
        <div class="mt-1.5 flex items-center gap-1.5">
            <button type="button"
                    class="inline-flex h-6 items-center rounded bg-blue-600 px-2 text-[11px] font-semibold text-white transition hover:bg-blue-700 disabled:cursor-not-allowed disabled:opacity-50"
                    disabled="@(string.IsNullOrWhiteSpace(_saveViewName))"
                    @onclick="SaveCurrentAsync">
                Spara
            </button>
            <button type="button"
                    class="inline-flex h-6 items-center rounded border border-slate-200 bg-white px-2 text-[11px] font-medium text-slate-600 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800"
                    @onclick="() => { _saveViewPromptOpen = false; _saveViewError = null; }">
                Avbryt
            </button>
        </div>
    </div>
}
else
{
    <button type="button"
            class="flex w-full items-center gap-2 px-3 py-1.5 text-[11px] text-slate-700 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-40 dark:text-slate-200 dark:hover:bg-slate-800"
            disabled="@(!Manager.CanSaveCurrentView)"
            title="@Manager.SaveDisabledReason"
            @onclick="OpenSaveViewPrompt">
        <svg class="h-3 w-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" /></svg>
        <span>Spara aktuell kolumnvy</span>
    </button>
}

@* Separator *@
<div class="my-1 border-t border-slate-100 dark:border-slate-800"></div>

@* Välj kolumner *@
<button type="button"
        class="flex w-full items-center gap-2 px-3 py-1.5 text-[11px] text-slate-700 hover:bg-slate-50 dark:text-slate-200 dark:hover:bg-slate-800"
        @onclick="() => _showColumnPanel = !_showColumnPanel">
    <svg class="h-3 w-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2" />
    </svg>
    <span class="flex-1 text-left">@AppLoc["selectColumns"]</span>
    <svg class="h-2.5 w-2.5 shrink-0 text-slate-400 transition-transform @(_showColumnPanel ? "rotate-180" : "")" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
    </svg>
</button>
@if (_showColumnPanel)
{
    <div class="max-h-52 overflow-y-auto px-1 pb-1">
        @foreach (var col in ColumnOptions)
        {
            var colKey = col.Key;
            <label class="flex cursor-pointer items-center gap-2 rounded px-2 py-1 text-[11px] text-slate-700 hover:bg-slate-50 dark:text-slate-200 dark:hover:bg-slate-800">
                <input type="checkbox"
                       class="h-3.5 w-3.5 rounded border-slate-300 text-blue-600 focus:ring-blue-500 dark:border-slate-600 dark:bg-slate-800"
                       checked="@Manager.IsColumnVisible(colKey)"
                       @onchange="async e => await ToggleColumnAsync(colKey, e.Value)" />
                <span>@col.Label</span>
            </label>
        }
    </div>
}

@code {
    /// <summary>Drives visible columns and the Standard/saved views (shared library logic).</summary>
    [Parameter, EditorRequired] public MhdColumnViewManager Manager { get; set; } = default!;

    /// <summary>The toggleable columns shown in the picker panel (key + display label).</summary>
    [Parameter, EditorRequired] public IReadOnlyList<MhdColumnPickerItem> ColumnOptions { get; set; } = default!;

    /// <summary>Raised after a view (Standard or saved) is applied, so the host can close its outer dropdown.</summary>
    [Parameter] public EventCallback OnViewApplied { get; set; }

    /// <summary>Raised after a column is toggled, so the host can re-render the table and any hidden-filter notices.</summary>
    [Parameter] public EventCallback OnColumnsChanged { get; set; }

    // Local UI state — reset automatically because the host unmounts this section when its dropdown closes.
    private bool _showColumnPanel;
    private bool _saveViewPromptOpen;
    private string _saveViewName = string.Empty;
    private string? _saveViewError;

    private void OpenSaveViewPrompt()
    {
        _saveViewPromptOpen = true;
        _saveViewName = string.Empty;
        _saveViewError = null;
    }

    private async Task ApplyStandardAsync()
    {
        await Manager.ApplyStandardViewAsync();
        CloseLocalMenus();
        await OnViewApplied.InvokeAsync();
    }

    private async Task ApplySavedAsync(MhdSavedColumnView view)
    {
        await Manager.ApplySavedViewAsync(view);
        CloseLocalMenus();
        await OnViewApplied.InvokeAsync();
    }

    private async Task SaveCurrentAsync()
    {
        var error = await Manager.SaveCurrentViewAsync(_saveViewName);
        if (error is not null)
        {
            _saveViewError = error;
            return;
        }

        _saveViewPromptOpen = false;
        _saveViewName = string.Empty;
        _saveViewError = null;
    }

    private Task DeleteAsync(MhdSavedColumnView view) => Manager.DeleteViewAsync(view);

    // Toggle one column from the picker checkbox (persists; keeps the active view
    // name so a manual edit shows as "<view> · ändrad"). The host re-renders to
    // reflect the changed column set in the table and hidden-filter notices.
    private async Task ToggleColumnAsync(string key, object? value)
    {
        await Manager.SetColumnVisibleAsync(key, value is bool b && b);
        await OnColumnsChanged.InvokeAsync();
    }

    private void CloseLocalMenus()
    {
        _showColumnPanel = false;
        _saveViewPromptOpen = false;
    }
}
