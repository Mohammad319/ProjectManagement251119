@namespace ProjectManagement.Client.Shared.Components
@using ProjectManagement.Client.Shared.Model.Filter
@using ProjectManagement.Client.Shared.SharedComponent
@inject IJSRuntime JS

@* Compact filter icon that opens a fixed popup. Works inside sticky / overflow:hidden headers. *@

<button type="button"
        @ref="_buttonRef"
        aria-label="Filtrera"
        class="@ButtonCss"
        @onclick:stopPropagation="true"
        @onclick="ToggleOpen">
    <svg class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M3 3a1 1 0 011-1h12a1 1 0 011 1v3a1 1 0 01-.293.707L13 10.414V15a1 1 0 01-.553.894l-4 2A1 1 0 017 19v-8.586L3.293 6.707A1 1 0 013 6V3z" clip-rule="evenodd" />
    </svg>
    @if (FilterState.IsActive)
    {
        <span class="absolute -right-0.5 -top-0.5 h-1.5 w-1.5 rounded-full bg-blue-500" aria-hidden="true"></span>
    }
</button>

@if (_open)
{
    @* Click-away overlay *@
    <div class="fixed inset-0" style="z-index:2147483646" @onclick="ClosePopup" @onclick:stopPropagation="true"></div>

    @* Popup — fixed so it escapes overflow:hidden table cells. Compact: narrow width, tight padding. *@
    <div class="fixed w-52 cursor-default rounded-lg border border-slate-200 bg-white p-1.5 shadow-xl dark:border-slate-700 dark:bg-slate-900"
         style="z-index:2147483647;top:@(_popY.ToString("F0"))px;left:min(calc(100vw - 13rem - 8px),max(4px,@(_popX.ToString("F0"))px))"
         @onclick:stopPropagation="true">

        @if (FilterState.Type == ColumnFilterType.Text)
        {
            <div class="filter-operator-select mb-1.5">
                <MhdFormSelect TValue="TextFilterOp"
                               Value="FilterState.TextOp"
                               ValueChanged="OnTextOpChanged"
                               Options="TextOpOptions"
                               FixedPopup="true" />
            </div>
            @if (FilterState.TextOp != TextFilterOp.IsEmpty && FilterState.TextOp != TextFilterOp.IsNotEmpty)
            {
                <input type="text" class="@InputCss" placeholder="Sök..."
                       value="@FilterState.TextValue"
                       @oninput="e => { FilterState.TextValue = e.Value?.ToString() ?? string.Empty; _ = Notify(); }" />
            }
        }
        else if (FilterState.Type == ColumnFilterType.Date)
        {
            <div class="filter-operator-select mb-1.5">
                <MhdFormSelect TValue="DateFilterOp"
                               Value="FilterState.DateOp"
                               ValueChanged="OnDateOpChanged"
                               Options="DateOpOptions"
                               FixedPopup="true" />
            </div>
            @if (FilterState.DateOp != DateFilterOp.IsEmpty && FilterState.DateOp != DateFilterOp.IsNotEmpty)
            {
                <input type="date" class="@InputCss"
                       value="@(FilterState.DateFrom?.ToString("yyyy-MM-dd") ?? string.Empty)"
                       @onchange="e => { FilterState.DateFrom = DateTime.TryParse(e.Value?.ToString(), out var d) ? d : null; _ = Notify(); }" />
                @if (FilterState.DateOp == DateFilterOp.Between)
                {
                    <label class="mt-1 block text-[10px] text-slate-400">Till</label>
                    <input type="date" class="@InputCss mt-0.5"
                           value="@(FilterState.DateTo?.ToString("yyyy-MM-dd") ?? string.Empty)"
                           @onchange="e => { FilterState.DateTo = DateTime.TryParse(e.Value?.ToString(), out var d) ? d : null; _ = Notify(); }" />
                }
            }
        }
        else if (FilterState.Type == ColumnFilterType.Number)
        {
            <div class="filter-operator-select mb-1.5">
                <MhdFormSelect TValue="NumberFilterOp"
                               Value="FilterState.NumberOp"
                               ValueChanged="OnNumberOpChanged"
                               Options="NumberOpOptions"
                               FixedPopup="true" />
            </div>
            @if (FilterState.NumberOp != NumberFilterOp.IsEmpty && FilterState.NumberOp != NumberFilterOp.IsNotEmpty)
            {
                <input type="number" class="@InputCss" placeholder="Värde"
                       value="@FilterState.NumberFrom"
                       @onchange="e => { FilterState.NumberFrom = decimal.TryParse(e.Value?.ToString(), out var n) ? n : null; _ = Notify(); }" />
                @if (FilterState.NumberOp == NumberFilterOp.Between)
                {
                    <label class="mt-1 block text-[10px] text-slate-400">Till</label>
                    <input type="number" class="@InputCss mt-0.5" placeholder="Till"
                           value="@FilterState.NumberTo"
                           @onchange="e => { FilterState.NumberTo = decimal.TryParse(e.Value?.ToString(), out var n) ? n : null; _ = Notify(); }" />
                }
            }
        }
        else if (FilterState.Type == ColumnFilterType.Boolean)
        {
            <div class="filter-operator-select">
                <MhdFormSelect TValue="string"
                               Value="FilterState.BoolValue"
                               ValueChanged="OnBoolChanged"
                               Options="BoolOptions"
                               FixedPopup="true" />
            </div>
        }
        else if (FilterState.Type == ColumnFilterType.Dropdown)
        {
            @if (FilterState.AvailableGroups is { Count: > 0 } groups)
            {
                @* Grouped: headed sections with thin dividers. *@
                <div class="max-h-52 space-y-0.5 overflow-y-auto">
                    @for (var gi = 0; gi < groups.Count; gi++)
                    {
                        var group = groups[gi];
                        if (group.Options.Count == 0) { continue; }
                        <div class="@(gi > 0 ? "border-t border-slate-100 pt-0.5 dark:border-slate-700" : "")">
                            <div class="px-1 pb-0.5 text-[11px] font-semibold tracking-wide text-slate-500 dark:text-slate-400">@group.Header</div>
                            @foreach (var option in group.Options)
                            {
                                var value = option.Value;
                                var isChecked = FilterState.SelectedValues.Contains(value);
                                <label class="flex cursor-pointer items-center gap-1 rounded px-1.5 py-0.5 text-[11px] leading-tight transition-colors @(isChecked ? "bg-sky-50 dark:bg-sky-950/40" : "hover:bg-slate-50 dark:hover:bg-slate-800")">
                                    <input type="checkbox" class="h-3 w-3 shrink-0 accent-sky-600" checked="@isChecked"
                                           @onchange="e => { if ((bool)(e.Value ?? false)) FilterState.SelectedValues.Add(value); else FilterState.SelectedValues.Remove(value); _ = Notify(); }" />
                                    @if (!string.IsNullOrWhiteSpace(option.Tooltip))
                                    {
                                        <HoverTooltip Text="@option.Tooltip" Class="truncate text-slate-700 dark:text-slate-200">
                                            <span class="truncate">@option.Label</span>
                                            <span class="shrink-0 text-[9px] text-slate-400" aria-hidden="true">ⓘ</span>
                                        </HoverTooltip>
                                    }
                                    else
                                    {
                                        <span class="truncate text-slate-700 dark:text-slate-200">@option.Label</span>
                                    }
                                </label>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="max-h-44 space-y-0.5 overflow-y-auto">
                    @foreach (var option in FilterState.AvailableValues)
                    {
                        var isChecked = FilterState.SelectedValues.Contains(option);
                        <label class="flex cursor-pointer items-center gap-1 rounded px-1.5 py-0.5 text-[11px] leading-tight transition-colors @(isChecked ? "bg-sky-50 dark:bg-sky-950/40" : "hover:bg-slate-50 dark:hover:bg-slate-800")">
                            <input type="checkbox" class="h-3 w-3 shrink-0 accent-sky-600" checked="@isChecked"
                                   @onchange="e => { if ((bool)(e.Value ?? false)) FilterState.SelectedValues.Add(option); else FilterState.SelectedValues.Remove(option); _ = Notify(); }" />
                            <span class="text-slate-700 dark:text-slate-200">@option</span>
                        </label>
                    }
                </div>
            }
        }

        <div class="mt-1.5 flex items-center justify-between gap-1 border-t border-slate-100 pt-1.5 dark:border-slate-700">
            <button type="button"
                    class="cursor-pointer rounded px-2 py-0.5 text-[11px] font-medium text-red-600 hover:bg-red-50 disabled:cursor-not-allowed disabled:opacity-30 dark:text-red-400 dark:hover:bg-red-950/30"
                    disabled="@(!FilterState.IsActive)"
                    @onclick="ClearFilter">
                Rensa
            </button>
            <button type="button"
                    class="cursor-pointer rounded px-2 py-0.5 text-[11px] font-medium text-slate-500 hover:bg-slate-50 dark:text-slate-400 dark:hover:bg-slate-800"
                    @onclick="ClosePopup">
                Stäng
            </button>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public ColumnFilterState FilterState { get; set; } = null!;
    [Parameter] public EventCallback OnChanged { get; set; }

    private bool _open;
    private double _popX;
    private double _popY;
    private ElementReference _buttonRef;

    private async Task ToggleOpen(MouseEventArgs e)
    {
        await DismissTooltipAsync();

        if (_open)
        {
            _open = false;
            return;
        }

        try
        {
            var position = await JS.InvokeAsync<FilterPopupPosition>(
                "tableColumnFilterPosition.calculate",
                _buttonRef,
                208,
                8);
            _popX = position.X;
            _popY = position.Y;
        }
        catch
        {
            _popX = e.ClientX + 8;
            _popY = e.ClientY + 14;
        }

        _open = true;
    }

    private async Task ClosePopup()
    {
        _open = false;
        await DismissTooltipAsync();
    }

    private async Task ClearFilter()
    {
        FilterState.Clear();
        _open = false;
        await DismissTooltipAsync();
        await OnChanged.InvokeAsync();
    }

    private async Task Notify()
    {
        await DismissTooltipAsync();
        await OnChanged.InvokeAsync();
    }

    // Operator/boolean selections — set state then re-run the filter (logic unchanged).
    private Task OnTextOpChanged(TextFilterOp op)     { FilterState.TextOp = op;   return Notify(); }
    private Task OnDateOpChanged(DateFilterOp op)     { FilterState.DateOp = op;   return Notify(); }
    private Task OnNumberOpChanged(NumberFilterOp op) { FilterState.NumberOp = op; return Notify(); }
    private Task OnBoolChanged(string value)          { FilterState.BoolValue = value ?? string.Empty; return Notify(); }

    // Operator option lists for the custom dropdowns (labels match the previous native <option>s).
    private static readonly List<MhdSelectItem<TextFilterOp>> TextOpOptions = new()
    {
        new() { Value = TextFilterOp.Contains,   Label = "Innehåller" },
        new() { Value = TextFilterOp.Equals,     Label = "Är lika med" },
        new() { Value = TextFilterOp.NotEquals,  Label = "Är inte lika med" },
        new() { Value = TextFilterOp.IsEmpty,    Label = "Är tomt" },
        new() { Value = TextFilterOp.StartsWith, Label = "Börjar med" },
        new() { Value = TextFilterOp.EndsWith,   Label = "Slutar med" },
        new() { Value = TextFilterOp.IsNotEmpty, Label = "Är inte tomt" },
    };

    private static readonly List<MhdSelectItem<DateFilterOp>> DateOpOptions = new()
    {
        new() { Value = DateFilterOp.On,         Label = "Är lika med" },
        new() { Value = DateFilterOp.Before,     Label = "Före" },
        new() { Value = DateFilterOp.After,      Label = "Efter" },
        new() { Value = DateFilterOp.Between,    Label = "Mellan" },
        new() { Value = DateFilterOp.IsEmpty,    Label = "Är tomt" },
        new() { Value = DateFilterOp.IsNotEmpty, Label = "Är inte tomt" },
    };

    private static readonly List<MhdSelectItem<NumberFilterOp>> NumberOpOptions = new()
    {
        new() { Value = NumberFilterOp.Equals,      Label = "Är lika med" },
        new() { Value = NumberFilterOp.NotEquals,   Label = "Är inte lika med" },
        new() { Value = NumberFilterOp.GreaterThan, Label = "Större än" },
        new() { Value = NumberFilterOp.LessThan,    Label = "Mindre än" },
        new() { Value = NumberFilterOp.Between,     Label = "Mellan" },
        new() { Value = NumberFilterOp.IsEmpty,     Label = "Är tomt" },
        new() { Value = NumberFilterOp.IsNotEmpty,  Label = "Är inte tomt" },
    };

    private static readonly List<MhdSelectItem<string>> BoolOptions = new()
    {
        new() { Value = "",      Label = "Alla" },
        new() { Value = "true",  Label = "Ja" },
        new() { Value = "false", Label = "Nej" },
    };

    private async Task DismissTooltipAsync()
    {
        try { await JS.InvokeVoidAsync("hoverTooltip.dismiss"); }
        catch (JSException) { }
    }

    private string ButtonCss => "relative inline-flex h-3.5 w-3.5 shrink-0 items-center justify-center rounded transition " +
        (FilterState.IsActive
            ? "text-blue-600 dark:text-blue-400"
            : "text-slate-400 opacity-50 hover:opacity-100 hover:text-slate-600 dark:text-slate-500 dark:hover:text-slate-300");

    private const string InputCss  = "w-full rounded border border-slate-300 bg-white px-2 py-1 text-[11px] text-slate-700 placeholder-slate-400 focus:outline-none focus:ring-1 focus:ring-blue-500 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200";

    private sealed class FilterPopupPosition
    {
        public double X { get; set; }
        public double Y { get; set; }
    }
}
