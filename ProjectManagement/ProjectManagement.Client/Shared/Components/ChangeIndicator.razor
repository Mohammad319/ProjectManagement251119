@namespace ProjectManagement.Client.Shared.Components
@using ProjectManagement.Client.Shared.Helper
@using ProjectManagement.Shared.DTO.ChangeLog

@* Diskret ändringsindikator – tre små linjer (aktivitetsmarkering), blå/gråblå, ~13px.
   Värdkomponenten renderar den ENDAST när objektet ändrats efter att aktuell användare
   senast öppnade det (Senast ändrad > senast öppnad). Tooltipen visar de senaste
   ändringarna (max fem); saknas full historik visas en enkel fallback (Senast ändrad + Ändrad av).
   OBS: ingen klocka/emoji/varningsikon – bara tre linjer.
   Den yttre <span title=""> skuggar ev. native title-tooltip på raden (t.ex. projekt-/kalkyl-
   raden i vänsterträdet) så att ENBART "Senaste ändringar" visas vid hover på symbolen –
   inga dubbla tooltipar. *@
<span title="" class="inline-flex shrink-0 align-middle leading-none">
    <HoverTooltip Text="@TooltipText"
                  Class="text-sky-500 dark:text-sky-400"
                  Focusable="true">
        <svg class="h-3 w-3.5" viewBox="0 0 20 14" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" role="img" aria-label="Ändrad sedan du senast öppnade">
            <line x1="2" y1="3" x2="18" y2="3" />
            <line x1="2" y1="7" x2="13" y2="7" />
            <line x1="2" y1="11" x2="8" y2="11" />
        </svg>
    </HoverTooltip>
</span>

@code {
    /// <summary>Objektets senaste ändringstidpunkt (fallback i tooltipen).</summary>
    [Parameter] public DateTime? UpdatedAt { get; set; }

    /// <summary>Namn på den som ändrade senast (fallback om historik saknas). Aldrig null/undefined/id i UI:t.</summary>
    [Parameter] public string? UpdatedByName { get; set; }

    /// <summary>De senaste ändringarna (max fem visas). Tom/null → fallback-rader.</summary>
    [Parameter] public IReadOnlyList<ChangeLogItemDTO>? RecentChanges { get; set; }

    /// <summary>True för projekt, false för kalkyl – styr åtgärdstexten (t.ex. projektstatus/kalkylstatus).</summary>
    [Parameter] public bool IsProject { get; set; } = true;

    private string TooltipText =>
        ChangeLogTextFormatter.BuildTooltip(RecentChanges, UpdatedAt, UpdatedByName, IsProject);
}
