@using ProjectManagement.Client.Shared.Repositories.Offer;
@using ProjectManagement.Client.Shared.Repositories.Organisation
@using ProjectManagement.Shared.Base.Organisation
@using ProjectManagement.Shared.DTO.Offer
@using ProjectManagement.Client.Shared.Repositories.Organisation.Implement;
@using ProjectManagement.Shared.DTO.Organisation
@inherits AppComponentBase

@if (Form != null)
{
    <ContactFormUI underContact="Form" Callback="CallBack"></ContactFormUI>
}
else if (Contacts != null)
{
    <div class="overflow-x-auto rounded-lg border border-slate-200 dark:border-slate-700">
        <table class="min-w-full text-sm text-slate-700 dark:text-slate-200">
            <thead class="bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-100">
                <tr>
                    <th class="px-3 py-2 text-start font-semibold">
                        <button type="button"
                                class="me-2 inline-flex h-7 w-7 items-center justify-center rounded-md bg-indigo-600 text-white hover:bg-indigo-700 dark:bg-indigo-500 dark:hover:bg-indigo-400"
                                @onclick="()=> SetForm(-1)">
                            @((MarkupString)Icons.Plus)
                        </button>
                        @CalcResource.name
                    </th>
                    <th class="px-3 py-2 text-start font-semibold" style="width:105px;">@ResourceIdentity.mobile </th>
                    <th class="px-3 py-2 text-start font-semibold" style="width:105px;">@ResourceIdentity.phone </th>
                    <th class="px-3 py-2 text-start font-semibold" style="width:120px;">@CalcResource.status </th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-200 bg-white dark:divide-slate-700 dark:bg-slate-900">
                @for (int i = 0; i < Contacts.Count; i++)
                {
                    int x = i;
                    <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/70">
                        <td class="px-3 py-2">
                            <button class="me-1 inline-flex h-7 w-7 items-center justify-center rounded-md bg-rose-600 text-white hover:bg-rose-700 dark:bg-rose-500 dark:hover:bg-rose-400"
                                    @onclick="()=> Remove(Contacts[x])">
                                @((MarkupString)@Icons.DeleteSVG)
                            </button>
                            <button class="me-2 inline-flex h-7 w-7 items-center justify-center rounded-md bg-indigo-600 text-white hover:bg-indigo-700 dark:bg-indigo-500 dark:hover:bg-indigo-400"
                                    @onclick="()=> SetForm(x)">
                                @Icons.Edit
                            </button>
                            @Contacts[x].FirstName @Contacts[x].LastName
                        </td>
                        <td class="px-3 py-2">@Contacts[x].Mobile</td>
                        <td class="px-3 py-2">@Contacts[x].Telefone</td>
                        <td class="px-3 py-2">@Contacts[x].Status</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter] public List<UnderContactOrganisationBase> Contacts { get; set; } = [];
    UnderContactOrganisationBase? Form;
    int IndexForm = -1;
    void CallBack(UnderContactOrganisationBase f)
    {
        if (IndexForm == -1) Contacts.Add(f);
        Form = null;
        StateHasChanged();
    }
    void SetForm(int i = -1)
    {
        IndexForm = i;
        if (i > -1)
            Form = Contacts[i];
        else Form = new UnderContactOrganisationBase();
    }

    void Remove(UnderContactOrganisationBase Company)
    {
        Contacts.Remove(Company);
    }
}
