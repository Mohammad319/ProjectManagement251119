@using TaskResourceBlueprints.Entities
@using ProjectManagement.Adminstrator.Services.MHDBlazor
@using ProjectManagement.Shared.DTO.App.Dataloader
@inject MhdServices MHD
@inject TaskResourceBlueprints.Services.Resource.IResourceBlueprintsService ResourceService

<div class="space-y-1 text-slate-900 dark:text-slate-100">
    <section class="overflow-hidden rounded-2xl border border-slate-200   shadow-sm dark:border-slate-800  ">
        <div class="flex items-start justify-between gap-1 border-b border-slate-200 px-1 py-1 dark:border-slate-800">
            <div>
                <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">Cost distribution</h3>
                <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">Split the selected resource quantity across morning, day, and evening periods.</p>
            </div>

            <div class="flex flex-wrap items-center gap-2">
                <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[11px] font-semibold text-slate-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200">Qty: @(Resource?.Data?.Quantity ?? 0)</span>
                <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[11px] font-semibold text-slate-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200">Cost: @(Resource?.Data?.Cost ?? 0)</span>
            </div>
        </div>

        <div class="px-1 py-1">
            <EditForm Model="CalcResCost" OnValidSubmit="HandleSubmit" class="space-y-3">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-sm text-rose-600 dark:text-rose-400" />

                <div class="grid grid-cols-3 gap-1">
                    <div class="min-w-0 rounded-2xl border border-slate-200 p-1 dark:border-slate-800">
                        <div class="text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">Morning %</div>
                        <div class="mt-1 text-lg font-semibold text-slate-900 dark:text-slate-100">@GetPercentage(CalcResCost.Morgen)%</div>
                    </div>
                    <div class="min-w-0 rounded-2xl border border-slate-200 p-1 dark:border-slate-800">
                        <div class="text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">Day %</div>
                        <div class="mt-1 text-lg font-semibold text-slate-900 dark:text-slate-100">@GetPercentage(CalcResCost.Day)%</div>
                    </div>
                    <div class="min-w-0 rounded-2xl border border-slate-200 p-1 dark:border-slate-800">
                        <div class="text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">Evening %</div>
                        <div class="mt-1 text-lg font-semibold text-slate-900 dark:text-slate-100">@GetEveningPercentage()%</div>
                    </div>
                </div>

                <div class="space-y-1">
                    <div class="rounded-2xl border border-slate-200 p-1 dark:border-slate-800">
                        <div class="mb-3 flex items-center justify-between gap-3">
                            <div class="mt-1 inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[11px] font-semibold text-slate-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200">Morning</div>
                        </div>

                        <div class="grid grid-cols-3 gap-3 items-end">
                            <div class="min-w-0">
                                <label class="block text-xs font-medium text-slate-700 dark:text-slate-300">Quantity</label>
                                <InputNumber max="@Resource?.Data?.Quantity" @bind-Value="CalcResCost.Morgen" class="block w-full rounded-xl border border-slate-300 px-1 py-1 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500" />
                            </div>
                            <div class="min-w-0">
                                <label class="block text-xs font-medium text-slate-700 dark:text-slate-300">%</label>
                                <input value="@($"{GetPercentage(CalcResCost.Morgen)}%")" class="block w-full rounded-xl border border-slate-200 bg-slate-50 px-1 py-1 text-sm text-slate-700 shadow-sm outline-none dark:border-slate-800 dark:bg-slate-900/70 dark:text-slate-200" disabled />
                            </div>
                            <div class="min-w-0">
                                <label class="block text-xs font-medium text-slate-700 dark:text-slate-300">Cost</label>
                                <InputNumber @bind-Value="CalcResCost.MorgenCost" class="block w-full rounded-xl border border-slate-300 px-1 py-1 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500" />
                            </div>
                        </div>
                    </div>

                    <div class="rounded-2xl border border-slate-200 p-1 dark:border-slate-800">
                        <div class="mb-3 flex items-center justify-between gap-3">
                                <div class="mt-1 inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[11px] font-semibold text-slate-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200">Day</div>
                          
                        </div>

                        <div class="grid grid-cols-3 gap-3 items-end">
                            <div class="min-w-0">
                                <label class="block text-xs font-medium text-slate-700 dark:text-slate-300">Quantity</label>
                                <InputNumber max="@Resource?.Data?.Quantity" @bind-Value="CalcResCost.Day" class="block w-full rounded-xl border border-slate-300 px-1 py-1 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500" />
                            </div>
                            <div class="min-w-0">
                                <label class="block text-xs font-medium text-slate-700 dark:text-slate-300">%</label>
                                <input value="@($"{GetPercentage(CalcResCost.Day)}%")" class="block w-full rounded-xl border border-slate-200 bg-slate-50 px-1 py-1 text-sm text-slate-700 shadow-sm outline-none dark:border-slate-800 dark:bg-slate-900/70 dark:text-slate-200" disabled />
                            </div>
                            <div class="min-w-0">
                                <label class="block text-xs font-medium text-slate-700 dark:text-slate-300">Cost</label>
                                <InputNumber @bind-Value="CalcResCost.DayCost" class="block w-full rounded-xl border border-slate-300 px-1 py-1 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500" />
                            </div>
                        </div>
                    </div>

                    @{
                        var eveningQty = GetEveningQuantity();
                    }
                    <div class="rounded-2xl border border-slate-200 p-1 dark:border-slate-800">
                        <div class="mb-1 flex items-center justify-between gap-3">
                                <div class="mt-1 inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[11px] font-semibold text-slate-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200">Evening</div>
                        </div>

                        <div class="grid grid-cols-3 gap-3 items-end">
                            <div class="min-w-0">
                                <label class="block text-xs font-medium text-slate-700 dark:text-slate-300">Quantity</label>
                                <input disabled value="@eveningQty" class="block w-full rounded-xl border border-slate-200 bg-slate-50 px-1 py-1 text-sm text-slate-700 shadow-sm outline-none dark:border-slate-800 dark:bg-slate-900/70 dark:text-slate-200" />
                            </div>
                            <div class="min-w-0">
                                <label class="block text-xs font-medium text-slate-700 dark:text-slate-300">%</label>
                                <input disabled value="@($"{GetEveningPercentage()}%")" class="block w-full rounded-xl border border-slate-200 bg-slate-50 px-1 py-1 text-sm text-slate-700 shadow-sm outline-none dark:border-slate-800 dark:bg-slate-900/70 dark:text-slate-200" />
                            </div>
                            <div class="min-w-0">
                                <label class="block text-xs font-medium text-slate-700 dark:text-slate-300">Cost</label>
                                <InputNumber @bind-Value="CalcResCost.EveningCost" class="block w-full rounded-xl border border-slate-300 px-1 py-1 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="border-t border-slate-200 pt-1 dark:border-slate-800">
                    <div class="flex items-center justify-end gap-2">
                        <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-xl border border-sky-600 bg-sky-600 px-1 py-1 text-xs font-medium text-white transition hover:bg-sky-700 focus:outline-none focus:ring-2 focus:ring-sky-500/30 disabled:cursor-not-allowed disabled:opacity-60 dark:border-sky-500 dark:bg-sky-500 dark:hover:bg-sky-400">@ResourceApp.save</button>
                    </div>
                </div>
            </EditForm>
        </div>
    </section>
</div>

@code {
    [Parameter, EditorRequired] public ResourceDefinition? Resource { get; set; }

    private CalcResCost CalcResCost = new();
    [Parameter] public EventCallback<bool> CallBack { get; set; }

    protected override void OnInitialized()
    {
        if (Resource?.CalcResCost != null)
        {
            CalcResCost = new()
            {
                DayCost = Resource.CalcResCost.DayCost,
                Day = Resource.CalcResCost.Day,
                Evening = Resource.CalcResCost.Evening,
                EveningCost = Resource.CalcResCost.EveningCost,
                Morgen = Resource.CalcResCost.Morgen,
                MorgenCost = Resource.CalcResCost.MorgenCost,
                IsPercent = Resource.CalcResCost.IsPercent,
                Quantity = Resource.CalcResCost.Quantity,
            };
        }
        else
        {
            CalcResCost.Day = Convert.ToInt32(Resource?.Data?.Quantity ?? 0);
            CalcResCost.DayCost = Resource?.Data?.Cost ?? 0;
        }
    }

    public void IsPercent()
    {
        CalcResCost.IsPercent = true;
        CalcResCost.Quantity = null;
    }

    public void IsNotPercent()
    {
        CalcResCost.IsPercent = false;
        CalcResCost.Quantity ??= 0;
    }

    private decimal GetTotalQty() => Resource?.Data?.Quantity ?? 0m;

    private decimal GetPercentage(int value)
    {
        var total = GetTotalQty();
        return total > 0 ? Math.Round((value * 100m) / total, 2) : 0;
    }

    private decimal GetEveningQuantity()
    {
        var totalQty = GetTotalQty();
        var used = CalcResCost.Morgen + CalcResCost.Day;
        var eveningQty = used > totalQty ? 0 : totalQty - used;
        CalcResCost.Evening = Convert.ToInt32(eveningQty);
        return eveningQty;
    }

    private decimal GetEveningPercentage()
    {
        var total = GetTotalQty();
        var eveningQty = GetEveningQuantity();
        return total > 0 ? Math.Round((eveningQty * 100m) / total, 2) : 0;
    }

    private async Task HandleSubmit()
    {
        if (Resource is null)
        {
            return;
        }

        Resource.CalcResCost = CalcResCost;
        Resource.Data.Cost = CalcResCost.CalcCost();
        if (await ResourceService.UpdateAsync(Resource))
        {
            MHD.Modal.Close();
            await CallBack.InvokeAsync(true);
        }
    }

    private async Task HandleValidSubmit()
    {
        if (Resource is not null)
        {
            await ResourceService.UpdateAsync(Resource);
        }
    }
}
