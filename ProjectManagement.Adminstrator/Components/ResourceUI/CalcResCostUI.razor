@using TaskResourceBlueprints.Entities
@using ProjectManagement.Adminstrator.Services.MHDBlazor
@using ProjectManagement.Shared.DTO.App.Dataloader
@inject MhdServices MHD
@inject TaskResourceBlueprints.Services.Resource.IResourceBlueprintsService ResourceService

<div class="space-y-3">
    <EditForm Model="CalcResCost" OnValidSubmit="HandleSubmit" class="">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-sm text-red-600 dark:text-red-400" />
        <div class="grid grid-cols-4 gap-2">
            <div class="text-xs font-semibold text-gray-500 dark:text-gray-400">Period</div>
            <div class="text-xs font-semibold text-gray-500 dark:text-gray-400">@Resource?.Data?.Quantity</div>
            <div class="text-xs font-semibold text-gray-500 dark:text-gray-400">%</div>
            <div class="text-xs font-semibold text-gray-500 dark:text-gray-400">@Resource?.Data?.Cost</div>
            <div class="text-sm text-gray-600 dark:text-gray-300">Morning</div>
            <div>
                <InputNumber max="@Resource?.Data?.Quantity" @bind-Value="CalcResCost.Morgen" class="w-full rounded border border-gray-300 bg-white px-2 py-1 text-sm text-gray-900 focus:border-blue-500 focus:outline-none dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100" />
            </div>
            <div class="text-sm text-gray-600 dark:text-gray-300">
                @((Resource?.Data?.Quantity ?? 0) > 0 ? Math.Round((CalcResCost.Morgen * 100m) / (Resource?.Data?.Quantity ?? 1m), 2) : 0)%
            </div>
            <div>
                <InputNumber @bind-Value="CalcResCost.MorgenCost" class="w-full rounded border border-gray-300 bg-white px-2 py-1 text-sm text-gray-900 focus:border-blue-500 focus:outline-none dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100" />
            </div>

            <!-- Day -->
            <div class="text-sm text-gray-600 dark:text-gray-300">Day</div>
            <div>
                <InputNumber max="@Resource?.Data?.Quantity" @bind-Value="CalcResCost.Day" class="w-full rounded border border-gray-300 bg-white px-2 py-1 text-sm text-gray-900 focus:border-blue-500 focus:outline-none dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100" />
            </div>
            <div class="text-sm text-gray-600 dark:text-gray-300">
                @((Resource?.Data?.Quantity ?? 0) > 0 ? Math.Round((CalcResCost.Day * 100m) / (Resource?.Data?.Quantity ?? 1m), 2) : 0)%
            </div>
            <div>
                <InputNumber @bind-Value="CalcResCost.DayCost" class="w-full rounded border border-gray-300 bg-white px-2 py-1 text-sm text-gray-900 focus:border-blue-500 focus:outline-none dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100" />
            </div>
            @{
                var totalQty = Resource?.Data?.Quantity ?? 0m;
                var used = (CalcResCost.Morgen + CalcResCost.Day);
                var eveningQty = (used > totalQty) ? 0 : (totalQty - used);
                CalcResCost.Evening = Convert.ToInt32(eveningQty);
                var eveningPct = totalQty > 0 ? Math.Round((eveningQty * 100m) / totalQty, 2) : 0;
            }
            <div class="text-sm text-gray-600 dark:text-gray-300">Evening</div>
            <div>
                <input disabled value="@eveningQty" class="w-full rounded border border-gray-300 bg-white px-2 py-1 text-sm text-gray-900 focus:border-blue-500 focus:outline-none dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100" />
            </div>
            <div class="text-sm text-gray-600 dark:text-gray-300">@eveningPct%</div>
            <div>
                <InputNumber @bind-Value="CalcResCost.EveningCost" class="w-full rounded border border-gray-300 bg-white px-2 py-1 text-sm text-gray-900 focus:border-blue-500 focus:outline-none dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100" />
            </div>
        </div>

        <div class="mt-3 flex justify-end">
            <button type="submit" class="rounded border border-emerald-600 px-3 py-1.5 text-sm text-emerald-700 hover:bg-emerald-50 dark:border-emerald-500 dark:text-emerald-300 dark:hover:bg-emerald-900/30">@ResourceApp.save</button>
        </div>
    </EditForm>
</div>

@code {
    [Parameter, EditorRequired] public ResourceDefinition? Resource { get; set; }

    CalcResCost CalcResCost = new();
    [Parameter] public EventCallback<bool> CallBack { get; set; }

    protected override void OnInitialized()
    {
        if (Resource?.CalcResCost != null)
            CalcResCost = new()
                {
                    DayCost = Resource.CalcResCost.DayCost,
                    Day = Resource.CalcResCost.Day,
                    Evening = Resource.CalcResCost.Evening,
                    EveningCost = Resource.CalcResCost.EveningCost,
                    Morgen = Resource.CalcResCost.Morgen,
                    MorgenCost = Resource.CalcResCost.MorgenCost,
                    IsPercent = Resource.CalcResCost.IsPercent,
                    Quantity = Resource.CalcResCost.Quantity,
                };
        else
        {
            CalcResCost.Day = Convert.ToInt32(Resource?.Data?.Quantity ?? 0);
            CalcResCost.DayCost = Resource?.Data?.Cost ?? 0;
        }
    }
    public void IsPercent()
    {
        CalcResCost.IsPercent = true;
        CalcResCost.Quantity = null;
    }
    public void IsNotPercent()
    {
        CalcResCost.IsPercent = false;
        CalcResCost.Quantity ??= 0;
    }
    async Task HandleSubmit()
    {
        if (Resource is null)
            return;

        Resource.CalcResCost = CalcResCost;
        Resource.Data.Cost = CalcResCost.CalcCost();
        if(await ResourceService.UpdateAsync(Resource))
        {
            MHD.Modal.Close();
            await CallBack.InvokeAsync(true);  
        }
    }
    async Task HandleValidSubmit()
    {
        if (Resource is not null)
        {
            await ResourceService.UpdateAsync(Resource);
        }
    }
}
