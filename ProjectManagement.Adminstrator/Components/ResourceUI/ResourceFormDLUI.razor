@using TaskResourceBlueprints.Services
@using Microsoft.EntityFrameworkCore
@using TaskResourceBlueprints.Entities
@using TaskResourceBlueprints.Infrastructure
@using TaskResourceBlueprints.Services.Resource
@using ProjectManagement.Adminstrator.Shared.ResourceFiles
@using ProjectManagement.Shared.DTO.App.Dataloader
@using ProjectManagement.Shared.Enums
@inject IResourceBlueprintsService ResourceService
@inherits AppComponentBase

<div class="pm-form-shell">
    <EditForm Model="@model" OnValidSubmit="HandleValidSubmit" class="pm-form-shell">
        <DataAnnotationsValidator />
        <ValidationSummary class="pm-validation-summary" />

        <section class="pm-form-section">
            <div>
                <h3 class="pm-form-section-title">Resource blueprint</h3>
                <p class="pm-form-section-text">Define cost behavior, unit settings, and optional role-based pricing for this resource.</p>
            </div>

            <div class="pm-form-grid">
                <div class="pm-field">
                    <label class="pm-label" for="name">@CalcResource.name</label>
                    <InputText id="name"
                               @bind-Value="model.Name"
                               class="pm-input"
                               aria-invalid="@(EditContext?.GetValidationMessages(() => model.Name).Any() == true)" />
                    <ValidationMessage For="@(() => model.Name)" class="pm-validation-message" />
                </div>

                <div class="pm-field">
                    <label class="pm-label" for="unit">@CalcResource.unit</label>
                    <InputText id="unit" @bind-Value="model.Data.Unit" class="pm-input" />
                    <ValidationMessage For="@(() => model.Data.Unit)" class="pm-validation-message" />
                </div>

                <div class="pm-field">
                    <label class="pm-label" for="cost">@CalcResource.cost</label>
                    <InputNumber id="cost" @bind-Value="model.Data.Cost" class="pm-input" />
                    <ValidationMessage For="@(() => model.Data.Cost)" class="pm-validation-message" />
                </div>

                <div class="pm-field">
                    <label class="pm-label" for="cf1">@CalcResource.changeFactor1</label>
                    <InputNumber id="cf1" @bind-Value="model.Data.ChangeFactor1" class="pm-input" />
                    <ValidationMessage For="@(() => model.Data.ChangeFactor1)" class="pm-validation-message" />
                </div>

                <div class="pm-field">
                    <label class="pm-label" for="cf2">@CalcResource.changeFactor2</label>
                    <InputNumber id="cf2" @bind-Value="model.Data.ChangeFactor2" class="pm-input" />
                    <ValidationMessage For="@(() => model.Data.ChangeFactor2)" class="pm-validation-message" />
                </div>

                <div class="pm-field">
                    <label class="pm-label" for="co2">@CalcResource.co2</label>
                    <InputNumber id="co2" @bind-Value="model.Data.CO2" class="pm-input" />
                    <ValidationMessage For="@(() => model.Data.CO2)" class="pm-validation-message" />
                </div>

                <div class="pm-field">
                    <label class="pm-label" for="baseCost">@CalcResource.baseCost</label>
                    <InputNumber id="baseCost" @bind-Value="model.Data.BaseCost" class="pm-input" />
                    <ValidationMessage For="@(() => model.Data.BaseCost)" class="pm-validation-message" />
                </div>

                <div class="pm-field">
                    <label class="pm-label" for="resType">@CalcResource.resourceType</label>
                    <InputSelect id="resType" @bind-Value="model.ResType" class="pm-select">
                        @foreach (ResourceTypesEnum level in Enum.GetValues(typeof(ResourceTypesEnum)))
                        {
                            <option value="@level">@ResourceLocalize.GetResourceType(level)</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => model.ResType)" class="pm-validation-message" />
                </div>

                @if (model.ResType == ResourceTypesEnum.Materials || model.ResType == ResourceTypesEnum.Worker || model.ResType == ResourceTypesEnum.MachinesAndEquipments)
                {
                    <div class="pm-field">
                        <label class="pm-label" for="waste">@(model.ResType == ResourceTypesEnum.Materials ? CalcResource.waste : CalcResource.cap)</label>
                        <InputNumber id="waste" @bind-Value="model.Data.CapWaste" class="pm-input" />
                        <ValidationMessage For="@(() => model.Data.CapWaste)" class="pm-validation-message" />
                    </div>
                }

                <div class="pm-field">
                    <label class="pm-label" for="qty">@CalcResource.quantity</label>
                    <InputNumber id="qty" @bind-Value="model.Data.Quantity" class="pm-input" />
                    <ValidationMessage For="@(() => model.Data.Quantity)" class="pm-validation-message" />
                </div>

                <div class="flex items-end">
                    <button type="button" class="pm-btn-primary" @onclick="@(() => AddRole())">Add Role</button>
                </div>

                <div class="pm-field md:col-span-2 xl:col-span-2">
                    <label class="pm-label" for="note">Note</label>
                    <InputTextArea id="note" @bind-Value="model.Data.Note" class="pm-textarea" />
                    <ValidationMessage For="@(() => model.Data.Note)" class="pm-validation-message" />
                </div>

                <div class="pm-field md:col-span-2 xl:col-span-2">
                    <label class="pm-label" for="admin-note">Admin Note</label>
                    <InputTextArea id="admin-note" @bind-Value="model.AdminNote" class="pm-textarea" />
                    <ValidationMessage For="@(() => model.AdminNote)" class="pm-validation-message" />
                </div>
            </div>
        </section>

        @if (model.CostRoles != null && model.CostRoles.Any())
        {
            <section class="pm-form-section">
                <div>
                    <h3 class="pm-form-section-title">Role-based cost ranges</h3>
                    <p class="pm-form-section-text">Fine-tune cost values based on min/max thresholds.</p>
                </div>

                <div class="mt-4 space-y-2 overflow-x-auto">
                    <div class="pm-kv-grid text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
                        <div></div>
                        <div>@AppControll.min</div>
                        <div>@AppControll.max</div>
                        <div>@CalcResource.cost</div>
                        <div>#</div>
                    </div>

                    @for (int i = 0; i < model.CostRoles.Count; i++)
                    {
                        int d = i;
                        var role = model.CostRoles[d];
                        <div class="pm-kv-grid">
                            <button type="button" title="Remove"
                                    class="pm-btn-danger-soft h-9 w-9 px-0"
                                    @onclick="() => model.CostRoles.Remove(role)">
                                x
                            </button>
                            <input type="number" class="pm-input px-2 py-2" @bind="role.Min" />
                            <input type="number" class="pm-input px-2 py-2" @bind="role.Max" />
                            <input type="number" class="pm-input px-2 py-2" @bind="role.Value" />
                            <div class="text-xs text-slate-500 dark:text-slate-400">@(d + 1)</div>
                        </div>
                    }
                </div>
            </section>
        }

        <div class="pm-toolbar">
            <button type="submit" class="pm-btn-success">
                @ResourceApp.save
            </button>
            <button type="button" class="pm-btn-secondary" @onclick="GoBack">
                @ResourceApp.cancel
            </button>
        </div>
    </EditForm>
</div>

@code {
    [CascadingParameter] private EditContext? EditContext { get; set; }
    [Parameter] public ResourceDefinition model { get; set; } = new();
    bool IsEditMode => model.Id > 0;
    [Parameter] public EventCallback<bool> CallBack { get; set; }

    async Task HandleValidSubmit()
    {
        if (IsEditMode)
            await ResourceService.UpdateAsync(model);
        else
            await ResourceService.CreateAsync(model);

        await CallBack.InvokeAsync(true);
        MHD.Modal.Close();
    }

    void GoBack() => MHD.Modal.Close();
    void CalcResourceForm(ResourceEXDto Resource)
    {
        MHD.Modal.ShowComponent<CalcResCostUI>(Resource.Id == 0 ? ResourceApp.newItem : ResourceApp.update,
            new Dictionary<string, object>
            {
                [nameof(CalcResCostUI.Resource)] = Resource,
                [nameof(CalcResCostUI.CallBack)] = EventCallback.Factory.Create<bool>(this, RefreshCalcAsync),
            });
    }
    void RefreshCalcAsync(bool refre)
    {
        
    }
    void AddRole()
    {
        if (model.CostRoles == null) model.CostRoles = [];
        if (model.CostRoles.Count != 0)
            model.CostRoles.Add(new() { Min = model.CostRoles.Last().Max,
                Max = model.CostRoles.Last().Max + 10, 
                Value = model.CostRoles.Last().Value + 1 });
        else model.CostRoles.Add(new() { Min = 0, Max = 10, Value = 5 });
        StateHasChanged();
    }
}
