@using TaskResourceBlueprints.Services
@using Microsoft.EntityFrameworkCore
@using TaskResourceBlueprints.Entities
@using TaskResourceBlueprints.Infrastructure
@using TaskResourceBlueprints.Services.Resource
@using ProjectManagement.Adminstrator.Shared.ResourceFiles
@using ProjectManagement.Shared.DTO.App.Dataloader
@using ProjectManagement.Shared.Enums
@inject IResourceBlueprintsService ResourceService
@inherits AppComponentBase

<div class="space-y-5">
    <EditForm Model="@model" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary class="rounded-2xl border border-rose-900/60 bg-rose-950/40 px-3 py-2 text-sm text-rose-300" />

        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:!border-slate-800 dark:!bg-slate-950/80">
            <div class="text-sm font-semibold text-slate-900 dark:text-slate-100">Resource details</div>
            <div class="mt-1 text-xs text-slate-600 dark:text-slate-400">Name, unit, quantity, and resource type.</div>

            <div class="mt-4 grid grid-cols-3 gap-4">
                <div class="min-w-0">
                    <label class="block text-xs font-medium text-slate-700 dark:text-slate-300" for="name">@CalcResource.name</label>
                    <InputText id="name" @bind-Value="model.Name" class="block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500" aria-invalid="@(EditContext?.GetValidationMessages(() => model.Name).Any() == true)" />
                    <ValidationMessage For="@(() => model.Name)" class="text-xs text-rose-400" />
                </div>

                <div class="min-w-0">
                    <label class="block text-xs font-medium text-slate-700 dark:text-slate-300" for="unit">@CalcResource.unit</label>
                    <InputText id="unit" @bind-Value="model.Data.Unit" class="block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500" />
                    <ValidationMessage For="@(() => model.Data.Unit)" class="text-xs text-rose-400" />
                </div>

                <div class="min-w-0">
                    <label class="block text-xs font-medium text-slate-700 dark:text-slate-300" for="resType">@CalcResource.resourceType</label>
                    <InputSelect id="resType" @bind-Value="model.ResType" class="block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100">
                        @foreach (ResourceTypesEnum level in Enum.GetValues(typeof(ResourceTypesEnum)))
                        {
                            <option value="@level">@ResourceLocalize.GetResourceType(level)</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => model.ResType)" class="text-xs text-rose-400" />
                </div>

                <div class="min-w-0">
                    <label class="block text-xs font-medium text-slate-700 dark:text-slate-300" for="qty">@CalcResource.quantity</label>
                    <InputNumber id="qty" @bind-Value="model.Data.Quantity" class="block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500" />
                    <ValidationMessage For="@(() => model.Data.Quantity)" class="text-xs text-rose-400" />
                </div>

                @if (model.ResType == ResourceTypesEnum.Materials || model.ResType == ResourceTypesEnum.Worker || model.ResType == ResourceTypesEnum.MachinesAndEquipments)
                {
                    <div class="min-w-0">
                        <label class="block text-xs font-medium text-slate-700 dark:text-slate-300" for="waste">@(model.ResType == ResourceTypesEnum.Materials ? CalcResource.waste : CalcResource.cap)</label>
                        <InputNumber id="waste" @bind-Value="model.Data.CapWaste" class="block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500" />
                        <ValidationMessage For="@(() => model.Data.CapWaste)" class="text-xs text-rose-400" />
                    </div>
                }
            </div>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:!border-slate-800 dark:!bg-slate-950/80">
            <div class="text-sm font-semibold text-slate-900 dark:text-slate-100">Cost and factors</div>
            <div class="mt-1 text-xs text-slate-600 dark:text-slate-400">Maintain price, base cost, CO₂, and calculation factors in one place.</div>

            <div class="mt-4 grid grid-cols-3 gap-4">
                <div class="min-w-0">
                    <label class="block text-xs font-medium text-slate-700 dark:text-slate-300" for="cost">@CalcResource.cost</label>
                    <InputNumber id="cost" @bind-Value="model.Data.Cost" class="block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500" />
                    <ValidationMessage For="@(() => model.Data.Cost)" class="text-xs text-rose-400" />
                </div>
                <div class="min-w-0">
                    <label class="block text-xs font-medium text-slate-700 dark:text-slate-300" for="baseCost">@CalcResource.baseCost</label>
                    <InputNumber id="baseCost" @bind-Value="model.Data.BaseCost" class="block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500" />
                    <ValidationMessage For="@(() => model.Data.BaseCost)" class="text-xs text-rose-400" />
                </div>
                <div class="min-w-0">
                    <label class="block text-xs font-medium text-slate-700 dark:text-slate-300" for="co2">@CalcResource.co2</label>
                    <InputNumber id="co2" @bind-Value="model.Data.CO2" class="block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500" />
                    <ValidationMessage For="@(() => model.Data.CO2)" class="text-xs text-rose-400" />
                </div>
                <div class="min-w-0">
                    <label class="block text-xs font-medium text-slate-700 dark:text-slate-300" for="cf1">@CalcResource.changeFactor1</label>
                    <InputNumber id="cf1" @bind-Value="model.Data.ChangeFactor1" class="block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500" />
                    <ValidationMessage For="@(() => model.Data.ChangeFactor1)" class="text-xs text-rose-400" />
                </div>
                <div class="min-w-0">
                    <label class="block text-xs font-medium text-slate-700 dark:text-slate-300" for="cf2">@CalcResource.changeFactor2</label>
                    <InputNumber id="cf2" @bind-Value="model.Data.ChangeFactor2" class="block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500" />
                    <ValidationMessage For="@(() => model.Data.ChangeFactor2)" class="text-xs text-rose-400" />
                </div>
            </div>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:!border-slate-800 dark:!bg-slate-950/80">
            <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
                <div>
                    <div class="text-sm font-semibold text-slate-900 dark:text-slate-100">Role based cost bands</div>
                    <div class="mt-1 text-xs text-slate-600 dark:text-slate-400">Optional cost ranges for different role or quantity bands.</div>
                </div>
                <button type="button" class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-medium text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-400/30 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800" @onclick="AddRole">Add Role</button>
            </div>

            @if (model.CostRoles != null && model.CostRoles.Any())
            {
                <div class="mt-4 space-y-3">
                    <div class="grid grid-cols-[2.5rem_repeat(3,minmax(0,1fr))_2rem] gap-2 rounded-xl bg-slate-50 px-3 py-2 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500 dark:bg-slate-900/60 dark:text-slate-400">
                        <div></div>
                        <div>@AppControll.min</div>
                        <div>@AppControll.max</div>
                        <div>@CalcResource.cost</div>
                        <div>#</div>
                    </div>

                    @for (int i = 0; i < model.CostRoles.Count; i++)
                    {
                        int d = i;
                        var role = model.CostRoles[d];
                        <div class="grid grid-cols-[2.5rem_repeat(3,minmax(0,1fr))_2rem] items-center gap-2 rounded-xl border border-slate-200 bg-white p-2 dark:border-slate-800 dark:bg-slate-950/70">
                            <button type="button" title="Remove" class="inline-flex h-9 w-9 items-center justify-center rounded-xl border border-rose-200 bg-rose-50 text-rose-700 transition hover:bg-rose-100 focus:outline-none focus:ring-2 focus:ring-rose-500/20 dark:border-rose-900/60 dark:bg-rose-950/40 dark:text-rose-300 dark:hover:bg-rose-950/60 h-9 w-9" @onclick="() => model.CostRoles.Remove(role)">x</button>
                            <input type="number" class="block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500" @bind="role.Min" />
                            <input type="number" class="block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500" @bind="role.Max" />
                            <input type="number" class="block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500" @bind="role.Value" />
                            <div class="text-center text-xs text-slate-500">@(d + 1)</div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="flex min-h-[180px] flex-col items-center justify-center rounded-2xl border border-dashed border-slate-300 bg-slate-50/70 px-4 py-8 text-center dark:border-slate-700 dark:bg-slate-900/40 mt-4">
                    <div class="text-sm font-semibold text-slate-900 dark:text-slate-100">No role based cost bands</div>
                    <div class="mt-1 max-w-xl text-sm text-slate-600 dark:text-slate-400">Add a role when you need different cost values for ranges.</div>
                </div>
            }
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:!border-slate-800 dark:!bg-slate-950/80">
            <div class="text-sm font-semibold text-slate-900 dark:text-slate-100">Notes</div>
            <div class="mt-1 text-xs text-slate-600 dark:text-slate-400">Internal notes and descriptive text for administrators.</div>

            <div class="mt-4 grid grid-cols-3 gap-4">
                <div class="min-w-0 col-span-2">
                    <label class="block text-xs font-medium text-slate-700 dark:text-slate-300" for="note">Note</label>
                    <InputTextArea id="note" @bind-Value="model.Data.Note" class="min-h-[96px] w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500" />
                    <ValidationMessage For="@(() => model.Data.Note)" class="text-xs text-rose-400" />
                </div>
                <div class="min-w-0">
                    <label class="block text-xs font-medium text-slate-700 dark:text-slate-300" for="adminNote">Admin Note</label>
                    <InputTextArea id="adminNote" @bind-Value="model.AdminNote" class="min-h-[96px] w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500" />
                    <ValidationMessage For="@(() => model.AdminNote)" class="text-xs text-rose-400" />
                </div>
            </div>
        </div>

        <div class="flex flex-wrap items-center justify-end gap-3 pt-1">
            <button type="button" class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-medium text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-400/30 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800" @onclick="GoBack">@ResourceApp.cancel</button>
            <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-xl border border-sky-600 bg-sky-600 px-3 py-2 text-xs font-medium text-white transition hover:bg-sky-700 focus:outline-none focus:ring-2 focus:ring-sky-500/30 disabled:cursor-not-allowed disabled:opacity-60 dark:border-sky-500 dark:bg-sky-500 dark:hover:bg-sky-400">@ResourceApp.save</button>
        </div>
    </EditForm>
</div>

@code {
    [CascadingParameter] private EditContext? EditContext { get; set; }
    [Parameter] public ResourceDefinition model { get; set; } = new();
    bool IsEditMode => model.Id > 0;
    [Parameter] public EventCallback<bool> CallBack { get; set; }

    async Task HandleValidSubmit()
    {
        if (IsEditMode)
            await ResourceService.UpdateAsync(model);
        else
            await ResourceService.CreateAsync(model);

        await CallBack.InvokeAsync(true);
        MHD.Modal.Close();
    }

    void GoBack() => MHD.Modal.Close();
    void CalcResourceForm(ResourceEXDto Resource)
    {
        MHD.Modal.ShowComponent<CalcResCostUI>(Resource.Id == 0 ? ResourceApp.newItem : ResourceApp.update,
            new Dictionary<string, object>
            {
                [nameof(CalcResCostUI.Resource)] = Resource,
                [nameof(CalcResCostUI.CallBack)] = EventCallback.Factory.Create<bool>(this, RefreshCalcAsync),
            });
    }
    void RefreshCalcAsync(bool refre)
    {

    }
    void AddRole()
    {
        if (model.CostRoles == null) model.CostRoles = [];
        if (model.CostRoles.Count != 0)
            model.CostRoles.Add(new()
            {
                Min = model.CostRoles.Last().Max,
                Max = model.CostRoles.Last().Max + 10,
                Value = model.CostRoles.Last().Value + 1
            });
        else model.CostRoles.Add(new() { Min = 0, Max = 10, Value = 5 });
        StateHasChanged();
    }
}
