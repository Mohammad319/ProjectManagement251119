@using TaskResourceBlueprints.Services
@using Microsoft.EntityFrameworkCore
@using TaskResourceBlueprints.Entities
@using TaskResourceBlueprints.Infrastructure
@using TaskResourceBlueprints.Services.Resource
@using ProjectManagement.Adminstrator.Shared.ResourceFiles
@using ProjectManagement.Shared.DTO.App.Dataloader
@using ProjectManagement.Shared.Enums
@inject IResourceBlueprintsService ResourceService
@inherits AppComponentBase

<div class="space-y-3">
    <EditForm Model="@model" OnValidSubmit="HandleValidSubmit" class="">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-sm text-red-600 dark:text-red-400" />

        <!-- الحقول الأساسية -->
        <div class="grid grid-cols-1 gap-3 md:grid-cols-4">
            <div>
                <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300" for="name">@CalcResource.name</label>
                <InputText id="name"
                           @bind-Value="model.Name"
                           class="w-full rounded border border-gray-300 bg-white px-2 py-1 text-sm text-gray-900 focus:border-blue-500 focus:outline-none dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100"
                           aria-invalid="@(EditContext?.GetValidationMessages(() => model.Name).Any() == true)" />
                <ValidationMessage For="@(() => model.Name)" class="text-xs text-red-600 dark:text-red-400" />
            </div>

            <div>
                <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300" for="unit">@CalcResource.unit</label>
                <InputText id="unit"
                           @bind-Value="model.Data.Unit"
                           class="w-full rounded border border-gray-300 bg-white px-2 py-1 text-sm text-gray-900 focus:border-blue-500 focus:outline-none dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100" />
                <ValidationMessage For="@(() => model.Data.Unit)" class="text-xs text-red-600 dark:text-red-400" />
            </div>

            <div>
                <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300" for="cost">@CalcResource.cost</label>
                <InputNumber id="cost"
                             @bind-Value="model.Data.Cost"
                             class="w-full rounded border border-gray-300 bg-white px-2 py-1 text-sm text-gray-900 focus:border-blue-500 focus:outline-none dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100" />
                <ValidationMessage For="@(() => model.Data.Cost)" class="text-xs text-red-600 dark:text-red-400" />
            </div>

            <div>
                <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300" for="cf1">@CalcResource.changeFactor1</label>
                <InputNumber id="cf1"
                             @bind-Value="model.Data.ChangeFactor1"
                             class="w-full rounded border border-gray-300 bg-white px-2 py-1 text-sm text-gray-900 focus:border-blue-500 focus:outline-none dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100" />
                <ValidationMessage For="@(() => model.Data.ChangeFactor1)" class="text-xs text-red-600 dark:text-red-400" />
            </div>

            <div>
                <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300" for="cf2">@CalcResource.changeFactor2</label>
                <InputNumber id="cf2"
                             @bind-Value="model.Data.ChangeFactor2"
                             class="w-full rounded border border-gray-300 bg-white px-2 py-1 text-sm text-gray-900 focus:border-blue-500 focus:outline-none dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100" />
                <ValidationMessage For="@(() => model.Data.ChangeFactor2)" class="text-xs text-red-600 dark:text-red-400" />
            </div>

            <div>
                <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300" for="co2">@CalcResource.co2</label>
                <InputNumber id="co2"
                             @bind-Value="model.Data.CO2"
                             class="w-full rounded border border-gray-300 bg-white px-2 py-1 text-sm text-gray-900 focus:border-blue-500 focus:outline-none dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100" />
                <ValidationMessage For="@(() => model.Data.CO2)" class="text-xs text-red-600 dark:text-red-400" />
            </div>

            <div>
                <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300" for="baseCost">@CalcResource.baseCost</label>
                <InputNumber id="baseCost"
                             @bind-Value="model.Data.BaseCost"
                             class="w-full rounded border border-gray-300 bg-white px-2 py-1 text-sm text-gray-900 focus:border-blue-500 focus:outline-none dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100" />
                <ValidationMessage For="@(() => model.Data.BaseCost)" class="text-xs text-red-600 dark:text-red-400" />
            </div>

            <div>
                <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300" for="resType">@CalcResource.resourceType</label>
                <InputSelect id="resType"
                             @bind-Value="model.ResType"
                             class="w-full rounded border border-gray-300 bg-white px-2 py-1 text-sm text-gray-900 focus:border-blue-500 focus:outline-none dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100">
                    @foreach (ResourceTypesEnum level in Enum.GetValues(typeof(ResourceTypesEnum)))
                    {
                        <option value="@level">@ResourceLocalize.GetResourceType(level)</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => model.ResType)" class="text-xs text-red-600 dark:text-red-400" />
            </div>

            @if (model.ResType == ResourceTypesEnum.Materials || model.ResType == ResourceTypesEnum.Worker || model.ResType == ResourceTypesEnum.MachinesAndEquipments)
            {
                <div>
                    <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300" for="waste">@(model.ResType == ResourceTypesEnum.Materials ? CalcResource.waste : CalcResource.cap)</label>
                    <InputNumber id="waste"
                                 @bind-Value="model.Data.CapWaste"
                                 class="w-full rounded border border-gray-300 bg-white px-2 py-1 text-sm text-gray-900 focus:border-blue-500 focus:outline-none dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100" />
                    <ValidationMessage For="@(() => model.Data.CapWaste)" class="text-xs text-red-600 dark:text-red-400" />
                </div>
            }

            <div>
                <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300" for="qty">@CalcResource.quantity</label>
                <InputNumber id="qty" @bind-Value="model.Data.Quantity" class="w-full rounded border border-gray-300 bg-white px-2 py-1 text-sm text-gray-900 focus:border-blue-500 focus:outline-none dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100" />
                <ValidationMessage For="@(() => model.Data.Quantity)" class="text-xs text-red-600 dark:text-red-400" />
            </div>
            <div>
                <button type="button" class="rounded border border-blue-600 px-3 py-1.5 text-sm text-blue-700 hover:bg-blue-50 dark:border-blue-500 dark:text-blue-300 dark:hover:bg-blue-900/30" @onclick="@(() => AddRole())">Add Role</button>
            </div>
            @if (model.CostRoles != null && model.CostRoles.Any())
            {
                <div class="md:col-span-4">
                    <div class="inline-grid grid-cols-[minmax(0,1fr)_80px_80px_80px_28px] items-center gap-2">
                        <div></div>
                        <div>@AppControll.min</div>
                        <div>@AppControll.max</div>
                        <div>@CalcResource.cost</div>
                        <div class=" ">#</div>
                    </div>
                    <br />
                    @if (model.CostRoles is not null && model.CostRoles.Count > 0)
                    {
                        @for (int i = 0; i < model.CostRoles.Count; i++)
                        {
                            int d = i;
                            var role = model.CostRoles[d];
                            <div class="inline-grid grid-cols-[minmax(0,1fr)_80px_80px_80px_28px] items-center gap-2">
                                <div class="flex items-center ">
                                    <button type="button" title="Remove"
                                            class="flex h-6 w-6 items-center justify-center rounded border border-red-600 p-0 text-red-700 hover:bg-red-50 dark:border-red-500 dark:text-red-300 dark:hover:bg-red-900/30"
                                            @onclick="() => model.CostRoles.Remove(role)">
                                        x
                                    </button>
                                </div>
                                <input type="number" class="w-full rounded border border-gray-300 bg-white px-2 py-1 text-sm text-gray-900 focus:border-blue-500 focus:outline-none dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100" @bind="role.Min" />
                                <input type="number" class="w-full rounded border border-gray-300 bg-white px-2 py-1 text-sm text-gray-900 focus:border-blue-500 focus:outline-none dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100" @bind="role.Max" />
                                <input type="number" class="w-full rounded border border-gray-300 bg-white px-2 py-1 text-sm text-gray-900 focus:border-blue-500 focus:outline-none dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100" @bind="role.Value" />
                                <div class="text-xs text-gray-500 dark:text-gray-400">@(d + 1)</div>
                            </div>
                        }
                    }

                </div>
            }
            <div class="md:col-span-4">
                <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300" for="note">Note</label>
                <InputTextArea id="note"
                           @bind-Value="model.Data.Note"
                           class="w-full rounded border border-gray-300 bg-white px-2 py-1 text-sm text-gray-900 focus:border-blue-500 focus:outline-none dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100" />
                <ValidationMessage For="@(() => model.Data.Note)" class="text-xs text-red-600 dark:text-red-400" />
            </div>
            <div class="md:col-span-4">
                <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300" for="note">Admin Note</label>
                <InputTextArea id="note"
                               @bind-Value="model.AdminNote"
                               class="w-full rounded border border-gray-300 bg-white px-2 py-1 text-sm text-gray-900 focus:border-blue-500 focus:outline-none dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100" />
                <ValidationMessage For="@(() => model.AdminNote)" class="text-xs text-red-600 dark:text-red-400" />
            </div>
        </div>


        <div class="mt-3 flex items-center justify-end gap-2">
            <button type="submit" class="rounded border border-emerald-600 px-3 py-1.5 text-sm text-emerald-700 hover:bg-emerald-50 dark:border-emerald-500 dark:text-emerald-300 dark:hover:bg-emerald-900/30">
                @ResourceApp.save
            </button>
            <button type="button" class="rounded border border-gray-300 px-3 py-1.5 text-sm text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:text-gray-200 dark:hover:bg-gray-800" @onclick="GoBack">
                @ResourceApp.cancel
            </button>
        </div>
    </EditForm>
</div>

@code {
    [CascadingParameter] private EditContext? EditContext { get; set; }
    [Parameter] public ResourceDefinition model { get; set; } = new();
    bool IsEditMode => model.Id > 0;
    [Parameter] public EventCallback<bool> CallBack { get; set; }

    async Task HandleValidSubmit()
    {
        if (IsEditMode)
            await ResourceService.UpdateAsync(model);
        else
            await ResourceService.CreateAsync(model);

        await CallBack.InvokeAsync(true);
        MHD.Modal.Close();
    }

    void GoBack() => MHD.Modal.Close();
    void CalcResourceForm(ResourceEXDto Resource)
    {
        MHD.Modal.ShowComponent<CalcResCostUI>(Resource.Id == 0 ? ResourceApp.newItem : ResourceApp.update,
            new Dictionary<string, object>
            {
                [nameof(CalcResCostUI.Resource)] = Resource,
                [nameof(CalcResCostUI.CallBack)] = EventCallback.Factory.Create<bool>(this, RefreshCalcAsync),
            });
    }
    void RefreshCalcAsync(bool refre)
    {
        
    }
    void AddRole()
    {
        if (model.CostRoles == null) model.CostRoles = [];
        if (model.CostRoles.Count != 0)
            model.CostRoles.Add(new() { Min = model.CostRoles.Last().Max,
                Max = model.CostRoles.Last().Max + 10, 
                Value = model.CostRoles.Last().Value + 1 });
        else model.CostRoles.Add(new() { Min = 0, Max = 10, Value = 5 });
        StateHasChanged();
    }
}
