@using ContextMenuMHD
@using Microsoft.EntityFrameworkCore
@using TaskResourceBlueprints.Entities
@using TaskResourceBlueprints.Entities.Resources
@using TaskResourceBlueprints.Infrastructure
@using TaskResourceBlueprints.Services.Resource
@using ProjectManagement.Adminstrator.Components.Folder
@using ProjectManagement.Adminstrator.Helper
@inherits AppComponentBase
@using ProjectManagement.Shared.Enums
@inject IResourceCategoryService ResourceFolderService

<div class="flex flex-wrap gap-3">
    <div class="w-[200px] rounded border border-gray-200 bg-white p-1 dark:border-gray-700 dark:bg-gray-900/60">
        @if (EnableFolderContext)
        {
            <div class="mb-2 flex items-center">
                <button class="rounded border border-blue-600 px-2 py-1 text-sm text-blue-700 hover:bg-blue-50 dark:border-blue-500 dark:text-blue-300 dark:hover:bg-blue-900/30" @onclick="() => AddFolder(null)">
                    @((MarkupString)Icons.Plus)
                </button>
            </div>
        }
        @FolderTreeHelper.RenderFolderTreeRecursive(
                this,
                Folders,
                expanded,
                selectedFolderIds,
                EventCallback.Factory.Create<ResourceCategory>(this, ToggleSelectionAsync),
                EnableFolderContext
                ? EventCallback.Factory.Create<ResourceCategory>(this, ContextF)
                : EventCallback<ResourceCategory>.Empty)
    </div>

    <div class="m-2 min-w-[350px] flex-1">
        @if (!selectedFolderIds.Any())
                {
        <p class="text-xs text-gray-500 dark:text-gray-400">Select one or more folders to see resources.</p>
                }
                else if (!resourcesToShow.Any())
        {
            <p class="text-xs text-gray-500 dark:text-gray-400">No resources in the selected folders.</p>
        }
        else
        {
            <table class="min-w-full border-collapse overflow-hidden rounded border border-gray-200 text-sm dark:border-gray-700">
                <thead class="bg-gray-50 dark:bg-gray-800/70">
                    <tr>
                        <th class="border-b border-gray-200 px-3 py-2 text-start text-xs font-semibold text-gray-600 dark:border-gray-700 dark:text-gray-300">@CalcResource.name</th>
                        <th class="border-b border-gray-200 px-3 py-2 text-start text-xs font-semibold text-gray-600 dark:border-gray-700 dark:text-gray-300">@CalcResource.active</th>
                        <th class="border-b border-gray-200 px-3 py-2 text-start text-xs font-semibold text-gray-600 dark:border-gray-700 dark:text-gray-300">@CalcResource.resourceType</th>
                        <th class="border-b border-gray-200 px-3 py-2 text-start text-xs font-semibold text-gray-600 dark:border-gray-700 dark:text-gray-300">@CalcResource.unit</th>
                        <th class="border-b border-gray-200 px-3 py-2 text-start text-xs font-semibold text-gray-600 dark:border-gray-700 dark:text-gray-300">@CalcResource.quantity</th>
                        <th class="border-b border-gray-200 px-3 py-2 text-start text-xs font-semibold text-gray-600 dark:border-gray-700 dark:text-gray-300">@CalcResource.changeFactor1 / 2</th>
                        <th class="border-b border-gray-200 px-3 py-2 text-start text-xs font-semibold text-gray-600 dark:border-gray-700 dark:text-gray-300">@CalcResource.cap / @CalcResource.waste</th>
                        <th class="border-b border-gray-200 px-3 py-2 text-start text-xs font-semibold text-gray-600 dark:border-gray-700 dark:text-gray-300">@CalcResource.cap</th>
                        <th class="border-b border-gray-200 px-3 py-2 text-start text-xs font-semibold text-gray-600 dark:border-gray-700 dark:text-gray-300">@CalcResource.cost</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                    @foreach (var r in resourcesToShow)
                    {
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-800/40">
                            <td class="px-3 py-2 text-gray-700 dark:text-gray-200">
                                <div class="flex items-center gap-2">

                                @if (RowActions is not null)
                                {
                                        @if (r.ResType == ResourceTypesEnum.MachinesAndEquipments || r.ResType == ResourceTypesEnum.Worker || r.ResType == ResourceTypesEnum.Managers)
                                        {
                                            <button type="button" class="rounded border border-cyan-600 px-2 py-1 text-xs text-cyan-700 hover:bg-cyan-50 dark:border-cyan-500 dark:text-cyan-300 dark:hover:bg-cyan-900/30" @onclick="() => CalcModeal(r)">Calc</button>
                                        }
                                        @RowActions(r)
                                }
                                @r.Name
                                    </div>
                            </td>
                            <td class="px-3 py-2 text-gray-700 dark:text-gray-200">
                                <input type="checkbox" class="h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-800" checked="@r.IsActive" disabled />
                            </td>
                            <td class="px-3 py-2 text-gray-700 dark:text-gray-200">@r.ResType</td>
                            <td class="px-3 py-2 text-gray-700 dark:text-gray-200">@r.Data.Unit</td>
                            <td class="px-3 py-2 text-gray-700 dark:text-gray-200">@r.Data.Quantity</td>
                            <td class="px-3 py-2 text-gray-700 dark:text-gray-200">@r.Data.ChangeFactor1 / @r.Data.ChangeFactor2</td>
                            <td class="px-3 py-2 text-gray-700 dark:text-gray-200">@r.Data.CapWaste</td>
                            <td class="px-3 py-2 text-gray-700 dark:text-gray-200">@r.Data.Cost</td>
                            <td class="px-3 py-2 text-gray-700 dark:text-gray-200">@r.Data.BaseCost</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    [Parameter] public RenderFragment<ResourceDefinition>? RowActions { get; set; }
    [Parameter] public bool EnableFolderContext { get; set; } = true;

    [Parameter] public List<ResourceCategory> Folders { get; set; } = new();
    private List<ResourceDefinition> resourcesToShow = new();
    private HashSet<int> expanded = new();
    private HashSet<int> selectedFolderIds = new();
    void CalcModeal(ResourceDefinition model) => MHD.Modal.ShowComponent<CalcResCostUI>(model.Name,
    new Dictionary<string, object>
    {
        [nameof(CalcResCostUI.Resource)] = model,
        [nameof(CalcResCostUI.CallBack)] = EventCallback.Factory.Create<bool>(this, StateHasChanged),
    });
    protected override async Task OnInitializedAsync()
    {
        if (Folders.Count == 0)
        {
            Folders = await ResourceFolderService.GetAllAsync();
        }
    }

    private async Task ToggleSelectionAsync(ResourceCategory folder)
    {
        selectedFolderIds.Clear();
        selectedFolderIds.Add(folder.Id);
        await UpdateResourcesAsync();
        StateHasChanged();
    }

    private async Task UpdateResourcesAsync()=>
        resourcesToShow = await ResourceFolderService.GetResourcesAsync(selectedFolderIds);

    async Task ContextF(ResourceCategory item)
    {
        var list = new List<MenuItem>()
            {
                new() { Label = $"➕ Resource", OnClickAsync = () => {UpdateForm(new ResourceDefinition(){FolderId = item.Id}); return Task.CompletedTask; } },
                new() { Label = $"➕ Subfolder", OnClickAsync = () => {AddFolder(item.Id); return Task.CompletedTask; } },
                new() { Label = $"✏️ {ResourceApp.edit}", OnClickAsync = () => {UpdateForm(item); return Task.CompletedTask; } },
                new() { Label = $"🗑 {ResourceApp.delete}", OnClickAsync = () => {Remove(item); return Task.CompletedTask; } },
            };
        await ContextService.ShowMenuAsync(list);
    }
    void UpdateForm(ResourceDefinition model) => MHD.Modal.ShowComponent<ResourceFormDLUI>(model.Id == 0 ? ResourceApp.newItem : ResourceApp.update,
new Dictionary<string, object>
{
[nameof(ResourceFormDLUI.model)] = model,
    [nameof(ResourceFormDLUI.CallBack)] = EventCallback.Factory.Create<bool>(this, RefreshAsync),
});
    async Task RefreshAsync()
    {
        await UpdateResourcesAsync();
        StateHasChanged();
    }

    private void AddFolder(int? parentID) => UpdateForm(new ResourceCategory() { DisplayName = "", ParentCategoryId = parentID });
    void UpdateForm(ResourceCategory model) =>
    Modal.ShowComponent<FolderFormUI>(model.Id == 0 ? AppLoc[LocalizerConst.New, CalcResource.projectCompensation] :
        AppLoc[LocalizerConst.Update, model.DisplayName], new Dictionary<string, object>
        {
            [nameof(FolderFormUI.Form)] = model,
            [nameof(FolderFormUI.Callback)] = EventCallback.Factory.Create<bool>(this, BtnUpdate)
        }, DialogSize.Medium);
    void Remove(ResourceCategory model) => MHD.DeleteMessage(model.DisplayName, EventCallback.Factory.Create(this, () => DeleteFolder(model.Id)));
    private async Task DeleteFolder(int id)
    {
        try
        {
            if(!await ResourceFolderService.DeleteAsync(id))return;

            var toRemove = Folders.FirstOrDefault(f => f.Id == id);
            if (toRemove is not null) Folders.Remove(toRemove);

            // نظّف الاختيار إن كان المجلد المحذوف محددًا
            if (selectedFolderIds.Remove(id))
                resourcesToShow.Clear();

            StateHasChanged();
        }
        catch (DbUpdateException)
        {
            // هنا غالبًا المجلد لديه أبناء/موارد مرتبطة
            // MHD.ToastMessage.Error("Delete folder", "Cannot delete: folder has children or linked resources.");
        }
    }

    async Task BtnUpdate(bool IsSuccess)
    {
        Modal.Close();
        if (IsSuccess)
        {
            Folders = await ResourceFolderService.GetAllAsync();
        }
        StateHasChanged();
    }

}
