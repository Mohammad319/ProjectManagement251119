@using System.Globalization
@using BlazorMHD.UI.Components.Feedback.Alert
@using Microsoft.EntityFrameworkCore
@using ProjectManagement.Adminstrator.Components
@using TaskResourceBlueprints.Entities
@using TaskResourceBlueprints.Entities.Resources
@using TaskResourceBlueprints.Infrastructure
@using ProjectManagement.Shared.DTO.ProjectAppStorage
@inherits AppComponentBase
@inject IDbContextFactory<TaskResourceBlueprintsContext> ContextFactory

<div class="space-y-1">
    @if (isLoading)
    {
        <BlazorMHD.UI.Components.Feedback.Loading.MhdLoadingOverlay></BlazorMHD.UI.Components.Feedback.Loading.MhdLoadingOverlay>
    }
    else if (!string.IsNullOrWhiteSpace(loadError))
    {
        <BlazorMHD.UI.Components.Feedback.Alert.MHDAlert Kind="MhdState.Danger" Message="@loadError" />
    }
    else if (propertySets.Count == 0)
    {
        <BlazorMHD.UI.Components.Feedback.Alert.MHDAlert Kind="MhdState.Info" Message="No property sets were found for this resource." />
    }
    else
    {
        <div class="rounded-xl border border-slate-200 p-1 shadow-sm dark:border-slate-800 ">
            <div class="grid grid-cols-[minmax(0,1fr)_auto] items-start gap-1">
                <div>
                    <p class="mt-1 text-sm  ">Link property definitions to this resource and enter their current values.</p>
                </div>

                <div class="flex flex-wrap items-center gap-1">
                    <span class="inline-flex items-center rounded-full border border-sky-200 px-1 py-1 text-xs font-medium dark:border-sky-900/60">Sets: @propertySets.Count</span>
                    <span class="inline-flex items-center rounded-full border border-slate-200  px-3 py-1 text-xs font-medium  dark:border-slate-700  ">Linked: @bindsByPropId.Count</span>
                </div>
            </div>
        </div>

        @foreach (var set in propertySets)
        {
            var linkedCount = CountLinkedInSet(set);
            <section class="overflow-hidden rounded-xl border border-slate-200 shadow-sm dark:border-slate-800 ">
                <div class="grid grid-cols-[minmax(0,1fr)_auto] items-start gap-1 border-b border-slate-200 px-1 py-1 dark:border-slate-800">
                    <div>
                        <h4 class="text-base font-semibold text-slate-900 ">@set.DisplayName</h4>
                        <p class="mt-1 text-sm  ">@linkedCount linked of @set.Attributes.Count attributes.</p>
                    </div>

                    <div class="flex flex-wrap gap-1">
                        <button class="inline-flex items-center justify-center rounded-xl border border-sky-200 px-2.5 text-sm font-medium shadow-sm transition hover:bg-sky-100 focus:outline-none focus:ring-4 focus:ring-sky-500/15 dark:border-sky-900/60"
                                @onclick="() => LinkAllInSetAsync(set)">
                            @AppLoc["selectAll"]
                        </button>
                        <button class="inline-flex items-center justify-center rounded-xl border border-slate-300 px-2.5 text-sm font-medium shadow-sm transition hover:border-slate-400 focus:outline-none focus:ring-4 focus:ring-slate-300/40 dark:border-slate-700 dark:hover:border-slate-600 dark:hover:bg-slate-800"
                                @onclick="() => UnlinkAllInSetAsync(set)">
                            @AppLoc["clearAll"]
                        </button>
                    </div>
                </div>

                <div class="space-y-0.5 px-1 py-1">
                    @if (set.Attributes.Count == 0)
                    {
                        <div class="rounded-xl border border-dashed border-slate-300  px-2.5 py-1 text-center text-sm  dark:border-slate-700  ">This set does not contain any attributes yet.</div>
                    }
                    else
                    {
                        @foreach (var p in set.Attributes)
                        {
                            var bind = GetBind(p.Id);
                            var isLinked = bind is not null;
                            var shown = bind?.NumericValue?.ToString(CultureInfo.InvariantCulture) ?? string.Empty;
                         
                            <div class="rounded-xl border border-slate-200/80 bg-white/40 px-1 dark:border-slate-800/60 dark:bg-slate-950/30">
                                <div class="grid grid-cols-[minmax(180px,220px)_max-content_minmax(260px,1fr)] items-center gap-1">

                                    <label class="flex min-w-0 cursor-pointer items-center gap-1">
                                        <input class="h-4 w-4 shrink-0 rounded border-slate-300 text-sky-600 focus:ring-sky-500/40 dark:border-slate-600 dark:bg-slate-900"
                                               type="checkbox"
                                               checked="@isLinked"
                                               @onchange="async e => await ToggleBindAsync(p, ((ChangeEventArgs)e).Value is bool b && b)" />

                                        <span class="truncate text-sm font-medium text-slate-900 dark:text-slate-100">
                                            @p.DisplayName
                                        </span>
                                    </label>

                                    <div class="flex flex-nowrap items-center gap-1 overflow-hidden">
                                        <span class="inline-flex shrink-0 items-center rounded-full border border-slate-200 px-2 py-0.5 text-xs font-medium text-slate-700 dark:border-slate-700 dark:text-slate-200">
                                            @("p" + p.Id)
                                        </span>

                                        <span class="inline-flex shrink-0 items-center rounded-full border border-slate-200 px-2 py-0.5 text-xs font-medium text-slate-700 dark:border-slate-700 dark:text-slate-200">
                                            @p.DataType
                                        </span>

                                        @if (p.DataType == DataType.Number && (p.StepValue.HasValue || p.MaxNumericValue.HasValue))
                                        {
                                            <span class="inline-flex shrink-0 items-center rounded-full border border-sky-200 px-2 py-0.5 text-xs font-medium text-sky-700 dark:border-sky-900/60 dark:text-sky-300" dir="ltr">
                                                @FormatRange(p.StepValue, p.MaxNumericValue)
                                            </span>
                                        }

                                        @if (isLinked)
                                        {
                                            <span class="inline-flex shrink-0 items-center rounded-full border border-emerald-200 bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700 dark:border-emerald-900/60 dark:bg-emerald-950/40 dark:text-emerald-300">
                                                Linked
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex shrink-0 items-center rounded-full border border-slate-300 px-2 py-0.5 text-xs font-medium text-slate-600 dark:border-slate-700 dark:text-slate-300">
                                                Inactive
                                            </span>
                                        }
                                    </div>

                                    <div class="min-w-0">
                                        @if (isLinked)
                                        {
                                            @if (p.DataType == DataType.Text)
                                            {
                                                <input class="block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:ring-4 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500"
                                                       placeholder="@AppLoc["textValuePlaceholder"]"
                                                       value="@bind!.TextValue"
                                                       @onchange="async e => await SaveTextAsync(p, e.Value?.ToString())" />
                                            }
                                            else
                                            {
                                                var numAttrs = new Dictionary<string, object>();
                                                if (p.StepValue.HasValue) numAttrs["min"] = p.StepValue.Value.ToString(CultureInfo.InvariantCulture);
                                                if (p.MaxNumericValue.HasValue) numAttrs["max"] = p.MaxNumericValue.Value.ToString(CultureInfo.InvariantCulture);

                                                <input class="block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:ring-4 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500"
                                                       type="number"
                                                       step="any"
                                                       placeholder="@AppLoc["numericValuePlaceholder"]"
                                                       value="@shown"
                                                       @onchange="async e => await SaveNumberAsync(p, e.Value?.ToString())"
                                                       @attributes="numAttrs" />
                                            }
                                        }
                                        else
                                        {
                                            <div class="rounded-xl border border-dashed border-slate-300 px-3 py-2 text-sm text-slate-500 dark:border-slate-700 dark:text-slate-400">
                                                Enable this attribute to enter a value.
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </section>
        }
    }
</div>

@code {
    [Parameter] public int ResourceId { get; set; }

    private bool isLoading = true;
    private string? loadError;
    private List<ResourceAttributeSet> propertySets = new();
    private Dictionary<int, ResourceAttributeValue> bindsByPropId = new();

    protected override async Task OnParametersSetAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        isLoading = true;
        loadError = null;
        try
        {
            using var db = await ContextFactory.CreateDbContextAsync();

            propertySets = await db.ResourceAttributeSets.AsNoTracking()
                                   .Include(s => s.Attributes)
                                   .ToListAsync();

            var binds = await db.ResourceAttributeValues.AsNoTracking()
                                .Where(b => b.ResourceId == ResourceId)
                                .ToListAsync();

            bindsByPropId = binds.ToDictionary(b => b.AttributeId, b => b);
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private int CountLinkedInSet(ResourceAttributeSet set)
        => set.Attributes.Count(p => bindsByPropId.ContainsKey(p.Id));

    private ResourceAttributeValue? GetBind(int propertyId)
        => bindsByPropId.TryGetValue(propertyId, out var b) ? b : null;

    private static string FormatRange(decimal? min, decimal? max)
    {
        if (min is null && max is null) return string.Empty;
        if (min is not null && max is not null) return $"[{min} - {max}]";
        return min is not null ? $">= {min}" : $"<= {max}";
    }

    private static decimal? Clamp(decimal? v, decimal? min, decimal? max)
    {
        if (v is null) return null;
        var x = v.Value;
        if (min.HasValue && x < min.Value) x = min.Value;
        if (max.HasValue && x > max.Value) x = max.Value;
        return x;
    }

    private static string DefaultText(ResourceAttribute p, string? current)
        => !string.IsNullOrEmpty(current) ? current : (p.DefaultTextValue ?? string.Empty);

    private static decimal? DefaultNumber(ResourceAttribute p, decimal? current)
    {
        var candidate = current
                        ?? p.DefaultNumericValue
                        ?? p.StepValue
                        ?? p.MaxNumericValue
                        ?? 0m;
        return Clamp(candidate, p.StepValue, p.MaxNumericValue);
    }

    private async Task ToggleBindAsync(ResourceAttribute p, bool link)
    {
        try
        {
            using var db = await ContextFactory.CreateDbContextAsync();

            if (link)
            {
                if (!bindsByPropId.TryGetValue(p.Id, out var bind))
                {
                    bind = new ResourceAttributeValue
                    {
                        ResourceId = ResourceId,
                        AttributeId = p.Id,
                        TextValue = p.DataType == DataType.Text ? DefaultText(p, null) : null,
                        NumericValue = p.DataType == DataType.Number ? DefaultNumber(p, null) : null
                    };
                    db.Add(bind);
                    await db.SaveChangesAsync();
                    bindsByPropId[p.Id] = bind;
                }
                else
                {
                    if (p.DataType == DataType.Text)
                    {
                        bind.NumericValue = null;
                        bind.TextValue = DefaultText(p, bind.TextValue);
                    }
                    else
                    {
                        bind.TextValue = null;
                        bind.NumericValue = DefaultNumber(p, bind.NumericValue);
                    }

                    db.Update(bind);
                    await db.SaveChangesAsync();
                }
            }
            else
            {
                if (bindsByPropId.TryGetValue(p.Id, out var bind))
                {
                    db.Remove(bind);
                    await db.SaveChangesAsync();
                    bindsByPropId.Remove(p.Id);
                }
            }
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task SaveTextAsync(ResourceAttribute p, string? value)
    {
        try
        {
            using var db = await ContextFactory.CreateDbContextAsync();
            if (!bindsByPropId.TryGetValue(p.Id, out var bind))
            {
                bind = new ResourceAttributeValue
                {
                    ResourceId = ResourceId,
                    AttributeId = p.Id
                };
                db.Add(bind);
                bindsByPropId[p.Id] = bind;
            }

            bind.TextValue = value ?? string.Empty;
            bind.NumericValue = null;

            db.Update(bind);
            await db.SaveChangesAsync();
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task SaveNumberAsync(ResourceAttribute p, string? valueStr)
    {
        decimal? value = null;
        if (!string.IsNullOrWhiteSpace(valueStr))
        {
            if (!decimal.TryParse(valueStr, NumberStyles.Number, CultureInfo.InvariantCulture, out var parsed))
            {
                loadError = AppLoc["invalidNumericValue"];
                StateHasChanged();
                return;
            }

            value = parsed;
        }

        if (value is not null)
        {
            if (p.StepValue.HasValue && value < p.StepValue)
            {
                loadError = string.Format(CultureInfo.CurrentCulture, AppLoc["valueMustBeAtLeast"], p.StepValue);
                StateHasChanged();
                return;
            }

            if (p.MaxNumericValue.HasValue && value > p.MaxNumericValue)
            {
                loadError = string.Format(CultureInfo.CurrentCulture, AppLoc["valueMustBeAtMost"], p.MaxNumericValue);
                StateHasChanged();
                return;
            }
        }

        try
        {
            using var db = await ContextFactory.CreateDbContextAsync();
            if (!bindsByPropId.TryGetValue(p.Id, out var bind))
            {
                bind = new ResourceAttributeValue
                {
                    ResourceId = ResourceId,
                    AttributeId = p.Id
                };
                db.Add(bind);
                bindsByPropId[p.Id] = bind;
            }

            bind.NumericValue = value;
            bind.TextValue = null;

            db.Update(bind);
            await db.SaveChangesAsync();
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task LinkAllInSetAsync(ResourceAttributeSet set)
    {
        try
        {
            using var db = await ContextFactory.CreateDbContextAsync();
            var ids = set.Attributes.Select(p => p.Id).ToHashSet();

            var existing = await db.Set<ResourceAttributeValue>()
                                   .Where(b => b.ResourceId == ResourceId && ids.Contains(b.AttributeId))
                                   .ToListAsync();
            var existingIds = existing.Select(b => b.AttributeId).ToHashSet();

            var toAdd = new List<ResourceAttributeValue>();
            foreach (var p in set.Attributes)
            {
                if (!existingIds.Contains(p.Id))
                {
                    var b = new ResourceAttributeValue
                    {
                        ResourceId = ResourceId,
                        AttributeId = p.Id,
                        TextValue = p.DataType == DataType.Text ? DefaultText(p, null) : null,
                        NumericValue = p.DataType == DataType.Number ? DefaultNumber(p, null) : null
                    };
                    toAdd.Add(b);
                    bindsByPropId[p.Id] = b;
                }
            }

            if (toAdd.Count > 0)
            {
                await db.AddRangeAsync(toAdd);
                await db.SaveChangesAsync();
            }
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task UnlinkAllInSetAsync(ResourceAttributeSet set)
    {
        try
        {
            using var db = await ContextFactory.CreateDbContextAsync();
            var ids = set.Attributes.Select(p => p.Id).ToHashSet();

            var toRemove = await db.Set<ResourceAttributeValue>()
                                   .Where(b => b.ResourceId == ResourceId && ids.Contains(b.AttributeId))
                                   .ToListAsync();

            if (toRemove.Count > 0)
            {
                db.RemoveRange(toRemove);
                await db.SaveChangesAsync();
            }

            foreach (var pid in ids)
            {
                bindsByPropId.Remove(pid);
            }
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
        finally
        {
            StateHasChanged();
        }
    }
}
