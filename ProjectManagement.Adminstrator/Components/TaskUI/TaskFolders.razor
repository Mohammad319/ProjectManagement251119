@using TaskResourceBlueprints.Dto.ProjectTask
@using TaskResourceBlueprints.Dto.Resource
@using TaskResourceBlueprints.Services.Resource
@inject ITaskResourceService FoldersService
@inject IResourceCategoryService ResourceCategoryService

<div class="flex flex-wrap gap-4">
    <div class="w-full max-w-[220px] space-y-2">
        @if (Folders is null)
        {
            <div class="rounded-lg border border-slate-200 bg-white p-3 text-sm text-slate-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300">Lädt Ordner …</div>
        }
        else if (Folders.Count == 0)
        {
            <div class="rounded-lg border border-slate-200 bg-white p-3 text-sm text-slate-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-400">Keine Ordner verfügbar.</div>
        }
        else
        {
            @foreach (var f in Folders)
            {
                <div role="button">
                    <button class="w-full rounded-lg border border-blue-200 bg-blue-50 px-3 py-2 text-left text-sm font-medium text-blue-700 transition hover:bg-blue-100 dark:border-blue-900/60 dark:bg-blue-950/40 dark:text-blue-300"
                            @onclick="() => LoadResourcesAsync(f.Id, f.DisplayName)">
                        @f.DisplayName
                    </button>
                </div>
            }
        }
    </div>

    <div class="min-w-[350px] flex-1 rounded-xl border border-slate-200 bg-white p-3 shadow-sm dark:border-slate-800 dark:bg-slate-950">
        <table class="w-full border-collapse text-sm">
            <thead class="bg-slate-50 dark:bg-slate-900/70">
                <tr>
                    <th class="p-2 text-left font-semibold text-slate-700 dark:text-slate-200">@CalcResource.name</th>
                    <th class="p-2 text-left font-semibold text-slate-700 dark:text-slate-200">@CalcResource.active</th>
                    <th class="p-2 text-left font-semibold text-slate-700 dark:text-slate-200">@CalcResource.resourceType</th>
                    <th class="p-2 text-left font-semibold text-slate-700 dark:text-slate-200">@CalcResource.unit</th>
                    <th class="p-2 text-left font-semibold text-slate-700 dark:text-slate-200">@CalcResource.quantity</th>
                    <th class="p-2 text-left font-semibold text-slate-700 dark:text-slate-200">@CalcResource.changeFactor1 / 2</th>
                    <th class="p-2 text-left font-semibold text-slate-700 dark:text-slate-200">@CalcResource.cap / @CalcResource.waste</th>
                    <th class="p-2 text-left font-semibold text-slate-700 dark:text-slate-200">@CalcResource.baseCost</th>
                </tr>
            </thead>
            <tbody>
                @if (SelectedFolderName is null)
                {
                    <tr class="border-t border-slate-200 dark:border-slate-800">
                        <td class="p-3 text-center text-slate-500 dark:text-slate-400" colspan="8">
                            Bitte wählen Sie einen Ordner.
                        </td>
                    </tr>
                }
                else if (Rows is null)
                {
                    <tr class="border-t border-slate-200 dark:border-slate-800">
                        <td class="p-3 text-center text-slate-500 dark:text-slate-400" colspan="8">
                            Lädt Ressourcen in „@SelectedFolderName“…
                        </td>
                    </tr>
                }
                else if (Rows.Count == 0)
                {
                    <tr class="border-t border-slate-200 dark:border-slate-800">
                        <td class="p-3 text-center text-slate-500 dark:text-slate-400" colspan="8">
                            Keine Ressourcen in diesem Ordner.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var r in Rows)
                    {
                        <tr class="border-t border-slate-200 dark:border-slate-800">
                            <td class="p-2 text-slate-700 dark:text-slate-200">
                                <div class="flex items-center gap-2">
                                    <button class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-blue-200 bg-blue-50 text-blue-700 transition hover:bg-blue-100 dark:border-blue-900/60 dark:bg-blue-950/40 dark:text-blue-300"
                                            @onclick="() => ToggleAssignAsync(r)">
                                        @(r.IsAssigned ? "-" : "+")
                                    </button>
                                    <span>@r.Name</span>
                                </div>
                            </td>

                            <td class="p-2 text-slate-700 dark:text-slate-200"><span>—</span></td>
                            <td class="p-2 text-slate-700 dark:text-slate-200">@r.ResourceType</td>
                            <td class="p-2 text-slate-700 dark:text-slate-200">@r.UnitCode</td>
                            <td class="p-2 text-slate-700 dark:text-slate-200">@r.Quantity</td>
                            <td class="p-2 text-slate-700 dark:text-slate-200">@r.ChangeFactor1 / @r.ChangeFactor2</td>
                            <td class="p-2 text-slate-700 dark:text-slate-200">@r.WasteFactor</td>
                            <td class="p-2 text-slate-700 dark:text-slate-200">@r.BaseCost</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    [Parameter] public int TaskId { get; set; }

    private List<FolderDto>? Folders;
    private List<ResourceRowDto>? Rows;
    private string? SelectedFolderName;

    protected override async Task OnInitializedAsync()
    {
        Folders = (await ResourceCategoryService.GetVisibleFoldersAsync(TaskId)).ToList();
    }

    private async Task LoadResourcesAsync(int folderId, string folderName)
    {
        SelectedFolderName = folderName;
        Rows = null;
        StateHasChanged();

        var (rows, _) = await FoldersService.GetFolderResourcesAsync(TaskId, folderId);
        Rows = rows.ToList();
    }

    private async Task ToggleAssignAsync(ResourceRowDto r)
    {
        if (!r.IsAssigned)
            await FoldersService.AddAssignmentAsync(TaskId, r.Id);
        else
            await FoldersService.RemoveResourceFromTaskAsync(TaskId, r.Id);

        var current = Folders?.FirstOrDefault(f => f.DisplayName == SelectedFolderName);
        if (current is not null)
        {
            var (rows, _) = await FoldersService.GetFolderResourcesAsync(TaskId, current.Id);
            Rows = rows.ToList();
        }
    }
}
