@using TaskResourceBlueprints.Dto.ProjectTask
@using TaskResourceBlueprints.Dto.Resource
@using TaskResourceBlueprints.Services.Resource
@using TaskResourceBlueprints.Services.ProjectTask
@inject ITaskResourceService FoldersService
@inject IResourceCategoryService ResourceCategoryService
@inject ITaskDefinitionService TaskDefinitionService
<div class="space-y-2 text-slate-900 dark:text-slate-100">

    <!-- Visible Folders Panel -->
    <div class="overflow-hidden rounded-xl border border-slate-200 bg-white/95 shadow-sm dark:border-slate-700/80 dark:bg-slate-950">
        <div class="flex items-center justify-between border-b border-slate-200 px-3 py-2 dark:border-slate-800/80">
            <div>
                <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">Visible folders</h3>
                <p class="mt-0.5 text-xs text-slate-600 dark:text-slate-400">Select the catalog folders where this task definition should appear.</p>
            </div>
            <div class="flex items-center gap-2">
                @if (_visibleFoldersDirty)
                {
                    <button type="button"
                            class="inline-flex items-center justify-center rounded-lg border border-emerald-600 px-3 py-1.5 text-xs font-medium text-emerald-600 transition hover:bg-emerald-600 hover:text-white dark:border-emerald-400 dark:text-emerald-400 dark:hover:bg-emerald-400 dark:hover:text-white"
                            @onclick="SaveVisibleFoldersAsync">
                        Save
                    </button>
                }
                <button type="button"
                        class="inline-flex items-center justify-center rounded-lg border border-slate-300 px-3 py-1.5 text-xs font-medium text-slate-600 transition hover:bg-slate-100 dark:border-slate-600 dark:text-slate-300 dark:hover:bg-slate-800"
                        @onclick="() => _foldersExpanded = !_foldersExpanded">
                    @(_foldersExpanded ? "▲ Hide" : "▼ Show")
                </button>
            </div>
        </div>

        @if (_foldersExpanded)
        {
            @if (_allFolders is null)
            {
                <div class="px-3 py-4 text-center text-xs text-slate-500 dark:text-slate-400">Loading…</div>
            }
            else if (_allFolders.Count == 0)
            {
                <div class="px-3 py-4 text-center text-xs text-slate-500 dark:text-slate-400">No folders available.</div>
            }
            else
            {
                <div class="px-3 py-3">
                    <div class="grid grid-cols-2 gap-1.5 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">
                        @foreach (var folder in _allFolders)
                        {
                            var isChecked = _visibleFolderIds.Contains(folder.Id);
                            <label class="@($"inline-flex cursor-pointer items-center gap-2 rounded-lg border px-2.5 py-1.5 text-xs transition {(isChecked ? "border-sky-400 bg-sky-50 text-sky-800 dark:border-sky-700 dark:bg-sky-950/40 dark:text-sky-200" : "border-slate-200 bg-slate-50 text-slate-700 hover:border-slate-300 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800")}")">
                                <input type="checkbox"
                                       checked="@isChecked"
                                       @onchange="() => ToggleVisibleFolder(folder.Id)"
                                       class="h-3.5 w-3.5 shrink-0 rounded border-slate-300 accent-sky-500 dark:border-slate-600" />
                                <span class="leading-5 truncate">@folder.DisplayName</span>
                            </label>
                        }
                    </div>
                </div>
            }
        }
    </div>
    <div class="grid grid-cols-1 gap-2 xl:grid-cols-[220px_minmax(0,1fr)]">
        <aside class="rounded-xl border border-slate-200 bg-slate-50/80 p-2 shadow-sm dark:border-slate-800 dark:bg-slate-900/60">
            <div class="mb-2">
                <p class="mt-0.5 text-[11px] text-slate-600 dark:text-slate-400">
                    Choose a folder to assign or remove resources for this task.
                </p>
            </div>

            @if (Folders is null)
            {
                <div class="flex min-h-[120px] items-center justify-center rounded-xl border border-dashed border-slate-300 bg-slate-50/70 px-2 py-3 text-center text-xs dark:border-slate-700 dark:bg-slate-900/40">
                    Lädt Ordner …
                </div>
            }
            else if (Folders.Count == 0)
            {
                <div class="flex min-h-[120px] items-center justify-center rounded-xl border border-dashed border-slate-300 bg-slate-50/70 px-2 py-3 text-center text-xs dark:border-slate-700 dark:bg-slate-900/40">
                    Keine Ordner verfügbar.
                </div>
            }
            else
            {
                <div class="grid grid-cols-3 gap-1">
                    @foreach (var f in Folders)
                    {
                        var selected = SelectedFolderId == f.Id;
                        <button class="w-full rounded-md border px-2 py-1 text-left text-[11px] font-medium transition @(selected
                                                                                                                                      ? "border-blue-300 bg-blue-50 text-blue-700 dark:border-blue-900/70 dark:bg-blue-950/50 dark:text-blue-300"
                                                                                                                                      : "border-slate-200 bg-white text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800")"
                                @onclick="() => LoadResourcesAsync(f.Id, f.DisplayName)">
                            <span class="block truncate">@f.DisplayName</span>
                        </button>
                    }
                </div>
            }
        </aside>

        <section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-950/80">
    
            @if (SelectedFolderName is null)
            {
                <div class="p-2">
                    <div class="flex min-h-[120px] items-center justify-center rounded-xl border border-dashed border-slate-300 bg-slate-50/70 px-3 py-4 text-center text-xs dark:border-slate-700 dark:bg-slate-900/40">
                        Bitte wählen Sie einen Ordner.
                    </div>
                </div>
            }
            else if (Rows is null)
            {
                <div class="p-2">
                    <div class="flex min-h-[120px] items-center justify-center rounded-xl border border-dashed border-slate-300 bg-slate-50/70 px-3 py-4 text-center text-xs dark:border-slate-700 dark:bg-slate-900/40">
                        Lädt Ressourcen in „@SelectedFolderName“…
                    </div>
                </div>
            }
            else if (Rows.Count == 0)
            {
                <div class="p-2">
                    <div class="flex min-h-[120px] items-center justify-center rounded-xl border border-dashed border-slate-300 bg-slate-50/70 px-3 py-4 text-center text-xs dark:border-slate-700 dark:bg-slate-900/40">
                        Keine Ressourcen in diesem Ordner.
                    </div>
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-slate-200 text-xs dark:divide-slate-800">
                        <thead class="bg-slate-50/70 dark:bg-slate-900/40">
                            <tr>
                                <th class="whitespace-nowrap px-2 py-1.5 text-left text-[10px] font-semibold uppercase tracking-[0.08em] text-slate-500 dark:text-slate-400">@CalcResource.name</th>
                                <th class="whitespace-nowrap px-2 py-1.5 text-left text-[10px] font-semibold uppercase tracking-[0.08em] text-slate-500 dark:text-slate-400">@CalcResource.active</th>
                                <th class="whitespace-nowrap px-2 py-1.5 text-left text-[10px] font-semibold uppercase tracking-[0.08em] text-slate-500 dark:text-slate-400">@CalcResource.resourceType</th>
                                <th class="whitespace-nowrap px-2 py-1.5 text-left text-[10px] font-semibold uppercase tracking-[0.08em] text-slate-500 dark:text-slate-400">@CalcResource.unit</th>
                                <th class="whitespace-nowrap px-2 py-1.5 text-left text-[10px] font-semibold uppercase tracking-[0.08em] text-slate-500 dark:text-slate-400">@CalcResource.quantity</th>
                                <th class="whitespace-nowrap px-2 py-1.5 text-left text-[10px] font-semibold uppercase tracking-[0.08em] text-slate-500 dark:text-slate-400">@CalcResource.changeFactor1 / 2</th>
                                <th class="whitespace-nowrap px-2 py-1.5 text-left text-[10px] font-semibold uppercase tracking-[0.08em] text-slate-500 dark:text-slate-400">@CalcResource.cap / @CalcResource.waste</th>
                                <th class="whitespace-nowrap px-2 py-1.5 text-left text-[10px] font-semibold uppercase tracking-[0.08em] text-slate-500 dark:text-slate-400">@CalcResource.baseCost</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                            @foreach (var r in Rows)
                            {
                                <tr class="hover:bg-slate-50/70 dark:hover:bg-slate-900/30">
                                    <td class="px-2 py-1.5 align-middle text-xs text-slate-700 dark:text-slate-200">
                                        <div class="flex min-w-[220px] flex-nowrap items-center gap-2 whitespace-nowrap">
                                            <button class="@(r.IsAssigned
                                                                                                                                                              ? "inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-md border border-rose-600 bg-rose-600 text-[11px] font-semibold text-white transition hover:bg-rose-700 focus:outline-none focus:ring-2 focus:ring-rose-500/30 disabled:cursor-not-allowed disabled:opacity-60 dark:border-rose-500 dark:bg-rose-500 dark:hover:bg-rose-400"
                                                                                                                                                              : "inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-md border border-emerald-600 bg-emerald-600 text-[11px] font-semibold text-white transition hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-500/30 disabled:cursor-not-allowed disabled:opacity-60 dark:border-emerald-500 dark:bg-emerald-500 dark:hover:bg-emerald-400")"
                                                    @onclick="() => ToggleAssignAsync(r)">
                                                @(r.IsAssigned ? "-" : "+")
                                            </button>

                                            <div class="min-w-0">
                                                <div class="truncate font-medium text-slate-800 dark:text-slate-100">
                                                    @r.Name
                                                </div>
                                            </div>
                                        </div>
                                    </td>

                                    <td class="whitespace-nowrap px-2 py-1.5 align-middle text-xs text-slate-700 dark:text-slate-200">
                                        <span class="@(r.IsAssigned
                                                                                                                                                ? "inline-flex items-center rounded-full border border-emerald-200 bg-emerald-50 px-2 py-0.5 text-[10px] font-medium text-emerald-700 dark:border-emerald-900/60 dark:bg-emerald-950/40 dark:text-emerald-200"
                                                                                                                                                : "inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-2 py-0.5 text-[10px] font-semibold text-slate-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200")">
                                            @(r.IsAssigned? CalcResource.active: "—")
                                        </span>
                                    </td>

                                    <td class="whitespace-nowrap px-2 py-1.5 align-middle text-xs text-slate-700 dark:text-slate-200">@r.ResourceType</td>
                                    <td class="whitespace-nowrap px-2 py-1.5 align-middle text-xs text-slate-700 dark:text-slate-200">@r.UnitCode</td>
                                    <td class="whitespace-nowrap px-2 py-1.5 align-middle text-xs text-slate-700 dark:text-slate-200">@FormatNumber(r.Quantity)</td>
                                    <td class="whitespace-nowrap px-2 py-1.5 align-middle text-xs text-slate-700 dark:text-slate-200">@FormatNumber(r.ChangeFactor1) / @FormatNumber(r.ChangeFactor2)</td>
                                    <td class="whitespace-nowrap px-2 py-1.5 align-middle text-xs text-slate-700 dark:text-slate-200">@FormatNumber(r.WasteFactor)</td>
                                    <td class="whitespace-nowrap px-2 py-1.5 align-middle text-xs text-slate-700 dark:text-slate-200">@FormatNumber(r.BaseCost)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
</div>
@code {
    [Parameter] public int TaskId { get; set; }

    private List<FolderDto>? Folders;
    private List<ResourceRowDto>? Rows;
    private string? SelectedFolderName;
    private int? SelectedFolderId;

    // Visible folders panel
    private bool _foldersExpanded = false;
    private bool _visibleFoldersDirty = false;
    private List<TaskResourceBlueprints.Entities.Resources.ResourceCategory>? _allFolders;
    private List<int> _visibleFolderIds = [];

    private static string FormatNumber(decimal? value)
        => NumericDisplayHelper.Format(value);

    protected override async Task OnInitializedAsync()
    {
        var allFoldersTask = ResourceCategoryService.GetAllAsync();
        var visibleFoldersTask = ResourceCategoryService.GetVisibleFoldersAsync(TaskId);

        await Task.WhenAll(allFoldersTask, visibleFoldersTask);

        _allFolders = await allFoldersTask;
        Folders = (await visibleFoldersTask).ToList();
        _visibleFolderIds = Folders.Select(f => f.Id).ToList();
    }

    private void ToggleVisibleFolder(int folderId)
    {
        if (_visibleFolderIds.Contains(folderId))
            _visibleFolderIds.Remove(folderId);
        else
            _visibleFolderIds.Add(folderId);
        _visibleFoldersDirty = true;
    }

    private async Task SaveVisibleFoldersAsync()
    {
        await TaskDefinitionService.UpdateVisibleFoldersAsync(TaskId, _visibleFolderIds);
        Folders = (await ResourceCategoryService.GetVisibleFoldersAsync(TaskId)).ToList();
        _visibleFoldersDirty = false;
    }

    private async Task LoadResourcesAsync(int folderId, string folderName)
    {
        SelectedFolderId = folderId;
        SelectedFolderName = folderName;
        Rows = null;
        StateHasChanged();

        var (rows, _) = await FoldersService.GetFolderResourcesAsync(TaskId, folderId);
        Rows = rows.ToList();
    }

    private async Task ToggleAssignAsync(ResourceRowDto r)
    {
        if (!r.IsAssigned)
            await FoldersService.AddAssignmentAsync(TaskId, r.Id);
        else
            await FoldersService.RemoveResourceFromTaskAsync(TaskId, r.Id);

        if (SelectedFolderId is int folderId)
        {
            var (rows, _) = await FoldersService.GetFolderResourcesAsync(TaskId, folderId);
            Rows = rows.ToList();
        }
    }
}
