@using TaskResourceBlueprints.Dto.ProjectTask
@using TaskResourceBlueprints.Dto.Resource
@using TaskResourceBlueprints.Services.Resource
@inject ITaskResourceService FoldersService
@inject IResourceCategoryService ResourceCategoryService

<div class="pm-page">
    <div class="grid grid-cols-1 gap-4 xl:grid-cols-[260px_minmax(0,1fr)]">
        <aside class="pm-card-soft">
            <div class="pm-section-header !mb-3">
                <div>
                    <h3 class="pm-section-title">Folders</h3>
                    <p class="pm-section-subtitle">Choose a folder to assign or remove resources for this task.</p>
                </div>
            </div>

            @if (Folders is null)
            {
                <div class="pm-empty !px-4 !py-6">Lädt Ordner …</div>
            }
            else if (Folders.Count == 0)
            {
                <div class="pm-empty !px-4 !py-6">Keine Ordner verfügbar.</div>
            }
            else
            {
                <div class="space-y-2">
                    @foreach (var f in Folders)
                    {
                        var selected = SelectedFolderId == f.Id;
                        <button class="w-full rounded-xl border px-3 py-2 text-left text-sm font-medium transition @(selected ? "border-blue-300 bg-blue-50 text-blue-700 dark:border-blue-900/70 dark:bg-blue-950/50 dark:text-blue-300" : "border-slate-200 bg-white text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800")"
                                @onclick="() => LoadResourcesAsync(f.Id, f.DisplayName)">
                            @f.DisplayName
                        </button>
                    }
                </div>
            }
        </aside>

        <section class="pm-table-shell">
            <div class="border-b border-slate-200 px-4 py-4 dark:border-slate-700 sm:px-5">
                <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
                    <div>
                        <h3 class="pm-section-title">Resources</h3>
                        <p class="pm-section-subtitle">
                            @if (string.IsNullOrWhiteSpace(SelectedFolderName))
                            {
                                <span>Bitte wählen Sie einen Ordner.</span>
                            }
                            else
                            {
                                <span>@SelectedFolderName</span>
                            }
                        </p>
                    </div>

                    @if (Rows is not null)
                    {
                        <span class="pm-chip">@Rows.Count items</span>
                    }
                </div>
            </div>

            @if (SelectedFolderName is null)
            {
                <div class="p-5">
                    <div class="pm-empty">Bitte wählen Sie einen Ordner.</div>
                </div>
            }
            else if (Rows is null)
            {
                <div class="p-5">
                    <div class="pm-empty">Lädt Ressourcen in „@SelectedFolderName“…</div>
                </div>
            }
            else if (Rows.Count == 0)
            {
                <div class="p-5">
                    <div class="pm-empty">Keine Ressourcen in diesem Ordner.</div>
                </div>
            }
            else
            {
                <div class="pm-table-scroll">
                    <table class="pm-table">
                        <thead>
                            <tr>
                                <th>@CalcResource.name</th>
                                <th>@CalcResource.active</th>
                                <th>@CalcResource.resourceType</th>
                                <th>@CalcResource.unit</th>
                                <th>@CalcResource.quantity</th>
                                <th>@CalcResource.changeFactor1 / 2</th>
                                <th>@CalcResource.cap / @CalcResource.waste</th>
                                <th>@CalcResource.baseCost</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Rows)
                            {
                                <tr>
                                    <td>
                                        <div class="flex min-w-[260px] items-center gap-3">
                                            <button class="@(r.IsAssigned ? "pm-btn-danger !h-8 !px-2 !py-1 !text-xs" : "pm-btn-success !h-8 !px-2 !py-1 !text-xs")"
                                                    @onclick="() => ToggleAssignAsync(r)">
                                                @(r.IsAssigned ? "-" : "+")
                                            </button>
                                            <div>
                                                <div class="font-medium text-slate-800 dark:text-slate-100">@r.Name</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="@(r.IsAssigned ? "pm-badge-success" : "pm-chip")">@(r.IsAssigned ? CalcResource.active : "—")</span>
                                    </td>
                                    <td>@r.ResourceType</td>
                                    <td>@r.UnitCode</td>
                                    <td>@r.Quantity</td>
                                    <td>@r.ChangeFactor1 / @r.ChangeFactor2</td>
                                    <td>@r.WasteFactor</td>
                                    <td>@r.BaseCost</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
</div>

@code {
    [Parameter] public int TaskId { get; set; }

    private List<FolderDto>? Folders;
    private List<ResourceRowDto>? Rows;
    private string? SelectedFolderName;
    private int? SelectedFolderId;

    protected override async Task OnInitializedAsync()
    {
        Folders = (await ResourceCategoryService.GetVisibleFoldersAsync(TaskId)).ToList();
    }

    private async Task LoadResourcesAsync(int folderId, string folderName)
    {
        SelectedFolderId = folderId;
        SelectedFolderName = folderName;
        Rows = null;
        StateHasChanged();

        var (rows, _) = await FoldersService.GetFolderResourcesAsync(TaskId, folderId);
        Rows = rows.ToList();
    }

    private async Task ToggleAssignAsync(ResourceRowDto r)
    {
        if (!r.IsAssigned)
            await FoldersService.AddAssignmentAsync(TaskId, r.Id);
        else
            await FoldersService.RemoveResourceFromTaskAsync(TaskId, r.Id);

        if (SelectedFolderId is int folderId)
        {
            var (rows, _) = await FoldersService.GetFolderResourcesAsync(TaskId, folderId);
            Rows = rows.ToList();
        }
    }
}
