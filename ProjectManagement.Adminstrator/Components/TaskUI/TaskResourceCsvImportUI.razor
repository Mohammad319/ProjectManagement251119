@using Microsoft.AspNetCore.Components.Forms
@using TaskResourceBlueprints.Services.Import
@using TaskResourceBlueprints.Services.ProjectTask
@using TaskResourceBlueprints.Services.Training
@inject ITaskResourceCsvImportService ImportService
@inject ITaskDefinitionService TaskService
@inject ITaskResourceMlTrainingService MlTrainingService

<div class="space-y-3 text-slate-900 dark:text-slate-100">

    <!-- ── Header: Import controls ─────────────────────────────────────────── -->
    <section class="rounded-2xl border border-slate-200 bg-white px-4 py-3 shadow-sm dark:border-slate-800 dark:bg-slate-950/80">
        <div class="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
            <div>
                <h2 class="mt-1 text-lg font-semibold tracking-tight">Import tasks and resources</h2>
                <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
                    Upload a semicolon-separated CSV file. Task rows use <code class="rounded bg-slate-100 px-1 dark:bg-slate-800">Radtyp T</code>,
                    resource rows <code class="rounded bg-slate-100 px-1 dark:bg-slate-800">R</code>,
                    parameter rows <code class="rounded bg-slate-100 px-1 dark:bg-slate-800">P</code> (Typ 0–3).
                    Resursmapp paths are created automatically.
                </p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <!-- Delete existing toggle -->
                <label class="inline-flex items-center gap-2 rounded-xl border border-amber-300 bg-amber-50 px-3 py-2 text-xs font-medium text-amber-800 dark:border-amber-900/70 dark:bg-amber-950/40 dark:text-amber-200">
                    <input type="checkbox"
                           class="h-4 w-4 rounded border-amber-300 text-amber-600 focus:ring-amber-500"
                           @bind="deleteExistingData"
                           disabled="@isBusy" />
                    <span>Delete existing tasks, folders and resources before import</span>
                </label>

                <label class="inline-flex items-center gap-2 rounded-xl border border-emerald-300 bg-emerald-50 px-3 py-2 text-xs font-medium text-emerald-800 dark:border-emerald-900/70 dark:bg-emerald-950/40 dark:text-emerald-200">
                    <input type="checkbox"
                           class="h-4 w-4 rounded border-emerald-300 text-emerald-600 focus:ring-emerald-500"
                           @bind="trainMlAfterImport"
                           disabled="@isBusy" />
                    <span>Train ML after successful import</span>
                </label>

                <!-- File picker -->
                <label class="inline-flex cursor-pointer items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-medium text-slate-700 transition hover:bg-slate-50 focus-within:ring-2 focus-within:ring-sky-500/30 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800">
                    <span>Select CSV</span>
                    <InputFile class="sr-only" OnChange="OnFileSelected" accept=".csv,text/csv" disabled="@isBusy" />
                </label>

                <!-- Import button -->
                <button type="button"
                        class="inline-flex items-center justify-center gap-2 rounded-xl border border-sky-600 bg-sky-600 px-3 py-2 text-xs font-medium text-white transition hover:bg-sky-700 focus:outline-none focus:ring-2 focus:ring-sky-500/30 disabled:cursor-not-allowed disabled:opacity-60 dark:border-sky-500 dark:bg-sky-500 dark:hover:bg-sky-400"
                        disabled="@(selectedFile is null || isBusy)"
                        @onclick="ImportAsync">
                    @if (isTrainingMl)
                    {
                        <svg class="h-3.5 w-3.5 animate-spin" viewBox="0 0 24 24" fill="none">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z" />
                        </svg>
                        <span>Training...</span>
                    }
                    else if (isImporting)
                    {
                        <svg class="h-3.5 w-3.5 animate-spin" viewBox="0 0 24 24" fill="none">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z" />
                        </svg>
                        <span>Importing…</span>
                    }
                    else
                    {
                        <span>Import</span>
                    }
                </button>

                <!-- Rebuild search index button -->
                <button type="button"
                        title="Rebuilds NormalizedTextSv for all tasks and clears TF-IDF cache. Run after updating dictionaries or after a large import."
                        class="inline-flex items-center justify-center gap-2 rounded-xl border border-violet-500 bg-violet-500 px-3 py-2 text-xs font-medium text-white transition hover:bg-violet-600 focus:outline-none focus:ring-2 focus:ring-violet-400/30 disabled:cursor-not-allowed disabled:opacity-60 dark:border-violet-400 dark:bg-violet-500/80 dark:hover:bg-violet-400"
                        disabled="@isBusy"
                        @onclick="RebuildSearchIndexAsync">
                    @if (isRebuilding)
                    {
                        <svg class="h-3.5 w-3.5 animate-spin" viewBox="0 0 24 24" fill="none">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z" />
                        </svg>
                        <span>Rebuilding…</span>
                    }
                    else
                    {
                        <span>Rebuild Search Index</span>
                    }
                </button>
            </div>
        </div>

        @if (rebuildMessage is not null)
        {
            <p class="mt-2 text-xs font-medium text-violet-700 dark:text-violet-300">@rebuildMessage</p>
        }
        @if (trainingMessage is not null)
        {
            <p class="mt-2 text-xs font-medium text-emerald-700 dark:text-emerald-300">@trainingMessage</p>
        }
    </section>

    <!-- ── CSV format reference ────────────────────────────────────────────── -->
    <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-950/80">
        <div class="grid gap-3 md:grid-cols-5">
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3 dark:border-slate-800 dark:bg-slate-900/70">
                <div class="text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">File</div>
                <div class="mt-1 truncate text-sm font-semibold">@(selectedFile?.Name ?? "No file selected")</div>
                @if (selectedFile is not null)
                {
                    <div class="mt-0.5 text-[11px] text-slate-500 dark:text-slate-400">@FormatFileSize(selectedFile.Size)</div>
                }
            </div>
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3 dark:border-slate-800 dark:bg-slate-900/70">
                <div class="text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">Expected Code</div>
                <div class="mt-1 text-sm font-semibold">Code or column E</div>
            </div>
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3 dark:border-slate-800 dark:bg-slate-900/70">
                <div class="text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">Expected Name</div>
                <div class="mt-1 text-sm font-semibold">Name/Namn or column F</div>
            </div>
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3 dark:border-slate-800 dark:bg-slate-900/70">
                <div class="text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">Expected Quantity</div>
                <div class="mt-1 text-sm font-semibold">Mängd/Quantity or column G</div>
            </div>
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3 dark:border-slate-800 dark:bg-slate-900/70">
                <div class="text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">Expected Unit</div>
                <div class="mt-1 text-sm font-semibold">Enhet/Unit or column H</div>
            </div>
        </div>
    </section>

    <!-- ── Error ────────────────────────────────────────────────────────────── -->
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="rounded-2xl border border-rose-200 bg-rose-50 px-3 py-2 text-sm text-rose-700 dark:border-rose-900/70 dark:bg-rose-950/50 dark:text-rose-300">
            @errorMessage
        </div>
    }

    <!-- ── Import summary ───────────────────────────────────────────────────── -->
    @if (result is not null)
    {
        <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-950/80">
            <div class="flex flex-wrap items-center justify-between gap-2">
                <div>
                    <h3 class="text-sm font-semibold">Import summary</h3>
                    <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
                        Rows processed: <strong>@result.TotalRows</strong>, skipped: <strong>@result.SkippedRows</strong>
                    </p>
                    @if (result.DeletedExistingData)
                    {
                        <p class="mt-1 text-xs font-medium text-amber-700 dark:text-amber-300">
                            Existing tasks, folders and resources were deleted before import.
                        </p>
                    }
                </div>
                <div class="flex items-center gap-2">
                    @if (result.Issues.Count > 0)
                    {
                        <span class="inline-flex rounded-full border border-amber-300 bg-amber-50 px-3 py-1 text-xs font-medium text-amber-700 dark:border-amber-700 dark:bg-amber-950/40 dark:text-amber-300">
                            @result.Issues.Count issue@(result.Issues.Count == 1 ? "" : "s")
                        </span>
                    }
                    <span class="inline-flex rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1 text-xs font-medium text-emerald-700 dark:border-emerald-900/60 dark:bg-emerald-950/40 dark:text-emerald-200">
                        Completed
                    </span>
                </div>
            </div>

            <div class="mt-3 grid gap-2 sm:grid-cols-2 xl:grid-cols-4">
                @SummaryCard("Tasks",        $"{result.CreatedTasks} created / {result.UpdatedTasks} updated",        result.CreatedTasks + result.UpdatedTasks > 0)
                @SummaryCard("Resources",    $"{result.CreatedResources} created / {result.UpdatedResources} updated", result.CreatedResources + result.UpdatedResources > 0)
                @SummaryCard("Folders",      $"{result.CreatedFolders} created",                                       result.CreatedFolders > 0)
                @SummaryCard("Assignments",  $"{result.CreatedAssignments} created / {result.UpdatedAssignments} updated", result.CreatedAssignments + result.UpdatedAssignments > 0)
                @SummaryCard("State Groups", $"{result.CreatedStateGroups} created",                                   result.CreatedStateGroups > 0)
                @SummaryCard("States",       $"{result.CreatedStates} created",                                        result.CreatedStates > 0)
                @SummaryCard("State Links",  $"{result.CreatedStateLinks} created",                                    result.CreatedStateLinks > 0)
                @SummaryCard("Typ 0 – TaskUnit",   $"{result.CreatedTaskConversionParams} created",                   result.CreatedTaskConversionParams > 0)
                @SummaryCard("Typ 1 – Parameters", $"{result.CreatedResourceParameters} created",                     result.CreatedResourceParameters > 0)
                @SummaryCard("Typ 2 – AddOns",     $"{result.CreatedResourceAddOns} created",                         result.CreatedResourceAddOns > 0)
                @SummaryCard("Typ 3 – Times",      $"{result.CreatedResourceTimes} created",                          result.CreatedResourceTimes > 0)
                @SummaryCard("Issues",             result.Issues.Count.ToString(),                                     result.Issues.Count > 0, highlight: true)
            </div>
        </section>

        @if (mlTrainingResult is not null)
        {
            <section class="rounded-2xl border border-emerald-200 bg-emerald-50 p-4 shadow-sm dark:border-emerald-900/60 dark:bg-emerald-950/30">
                <h3 class="text-sm font-semibold text-emerald-900 dark:text-emerald-100">ML training summary</h3>
                <div class="mt-3 grid gap-2 sm:grid-cols-2 xl:grid-cols-4">
                    @SummaryCard("Status", mlTrainingResult.Trained ? "Trained" : "Skipped", mlTrainingResult.Trained, highlight: !mlTrainingResult.Trained)
                    @SummaryCard("Positive", mlTrainingResult.PositiveExamples.ToString(), mlTrainingResult.PositiveExamples > 0)
                    @SummaryCard("Negative", mlTrainingResult.NegativeExamples.ToString(), mlTrainingResult.NegativeExamples > 0)
                    @SummaryCard("Examples", mlTrainingResult.TotalExamples.ToString(), mlTrainingResult.TotalExamples > 0)
                </div>
                <p class="mt-2 break-all text-xs text-emerald-800 dark:text-emerald-200">@mlTrainingResult.ModelPath</p>
            </section>
        }

        <!-- ── Issues table ─────────────────────────────────────────────────── -->
        @if (result.Issues.Count > 0)
        {
            <section class="rounded-2xl border border-amber-200 bg-amber-50 p-4 shadow-sm dark:border-amber-900/70 dark:bg-amber-950/30">
                <div class="flex items-center justify-between">
                    <h3 class="text-sm font-semibold text-amber-900 dark:text-amber-100">Import issues</h3>
                    @if (result.Issues.Count > 100)
                    {
                        <span class="text-[11px] text-amber-700 dark:text-amber-300">Showing first 100 of @result.Issues.Count</span>
                    }
                </div>
                <div class="mt-2 max-h-80 overflow-auto rounded-xl border border-amber-200 bg-white dark:border-amber-900/60 dark:bg-slate-950">
                    <table class="min-w-full divide-y divide-amber-100 text-sm dark:divide-amber-900/50">
                        <thead class="sticky top-0 bg-white dark:bg-slate-950">
                            <tr>
                                <th class="px-3 py-1.5 text-left text-[11px] font-semibold uppercase tracking-[0.12em] text-amber-800 dark:text-amber-200">Row</th>
                                <th class="px-3 py-1.5 text-left text-[11px] font-semibold uppercase tracking-[0.12em] text-amber-800 dark:text-amber-200">Message</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-amber-50 dark:divide-amber-900/30">
                            @foreach (var issue in result.Issues.Take(100))
                            {
                                <tr class="hover:bg-amber-50/50 dark:hover:bg-amber-900/10">
                                    <td class="px-3 py-1.5 align-top font-mono text-xs text-amber-900 dark:text-amber-100">@issue.RowNumber</td>
                                    <td class="px-3 py-1.5 align-top text-amber-900 dark:text-amber-100">@issue.Message</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    }
</div>

@code {
    private const long MaxFileSize = 100L * 1024L * 1024L;

    private IBrowserFile? selectedFile;
    private TaskResourceCsvImportResult? result;
    private TaskResourceMlTrainingResult? mlTrainingResult;
    private string? errorMessage;
    private string? rebuildMessage;
    private string? trainingMessage;
    private bool isImporting;
    private bool isRebuilding;
    private bool isTrainingMl;
    private bool deleteExistingData;
    private bool trainMlAfterImport;

    private bool isBusy => isImporting || isRebuilding || isTrainingMl;

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        result = null;
        mlTrainingResult = null;
        errorMessage = null;
        trainingMessage = null;
    }

    private async Task ImportAsync()
    {
        if (selectedFile is null) return;
        try
        {
            isImporting = true;
            errorMessage = null;
            result = null;
            mlTrainingResult = null;
            rebuildMessage = null;
            trainingMessage = null;

            await using var source = selectedFile.OpenReadStream(MaxFileSize);
            await using var buffer = new MemoryStream();
            await source.CopyToAsync(buffer);
            buffer.Position = 0;

            result = await ImportService.ImportAsync(buffer, selectedFile.Name, deleteExistingData, CancellationToken.None);

            if (trainMlAfterImport && result.Issues.Count == 0)
            {
                isImporting = false;
                isTrainingMl = true;
                StateHasChanged();
                mlTrainingResult = await MlTrainingService.TrainAsync(ct: CancellationToken.None);
                trainingMessage = mlTrainingResult.Message;
            }
            else if (trainMlAfterImport)
            {
                trainingMessage = "ML training skipped because the import completed with issues.";
            }

            // TF-IDF cache lives in the main web app (separate process) — expires automatically in 30 min.
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isImporting = false;
            isTrainingMl = false;
        }
    }

    private async Task RebuildSearchIndexAsync()
    {
        try
        {
            isRebuilding = true;
            rebuildMessage = null;
            errorMessage = null;

            var updated = await TaskService.RebuildNormalizedTextAsync(CancellationToken.None);
            rebuildMessage = $"Search index rebuilt — {updated} tasks updated. TF-IDF cache in the main app will refresh within 30 min.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Rebuild failed: {ex.Message}";
        }
        finally
        {
            isRebuilding = false;
        }
    }

    private static string FormatFileSize(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:0.#} KB",
        _ => $"{bytes / (1024.0 * 1024):0.##} MB"
    };

    private static RenderFragment SummaryCard(string label, string value, bool active = false, bool highlight = false) =>
        @<div class="@($"rounded-xl border p-3 {(highlight && active ? "border-amber-300 bg-amber-50 dark:border-amber-800 dark:bg-amber-950/30" : active ? "border-emerald-200 bg-emerald-50 dark:border-emerald-900/60 dark:bg-emerald-950/20" : "border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-900/70")}")">
            <div class="text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">@label</div>
            <div class="mt-1 text-sm font-semibold @(highlight && active ? "text-amber-800 dark:text-amber-200" : "text-slate-900 dark:text-slate-100")">@value</div>
        </div>;
}
