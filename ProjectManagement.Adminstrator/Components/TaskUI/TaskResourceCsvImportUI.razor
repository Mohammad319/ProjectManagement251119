@using Microsoft.AspNetCore.Components.Forms
@using TaskResourceBlueprints.Services.Import
@inject ITaskResourceCsvImportService ImportService

<div class="space-y-3 text-slate-900 dark:text-slate-100">
    <section class="rounded-2xl border border-slate-200 bg-white px-4 py-3 shadow-sm dark:border-slate-800 dark:bg-slate-950/80">
        <div class="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
            <div>
                <h2 class="mt-1 text-lg font-semibold tracking-tight text-slate-900 dark:text-slate-100">Import tasks and resources</h2>
                <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">Upload a semicolon separated CSV file. Task rows use Radtyp T, resource rows use Radtyp R, parameter rows use Radtyp P (Typ 0–3), and Resursmapp paths are created automatically.</p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <label class="inline-flex items-center gap-2 rounded-xl border border-amber-300 bg-amber-50 px-3 py-2 text-xs font-medium text-amber-800 dark:border-amber-900/70 dark:bg-amber-950/40 dark:text-amber-200">
                    <input type="checkbox"
                           class="h-4 w-4 rounded border-amber-300 text-amber-600 focus:ring-amber-500"
                           @bind="deleteExistingData"
                           disabled="@isImporting" />
                    <span>Delete existing tasks, folders and resources before import</span>
                </label>
                <label class="inline-flex cursor-pointer items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-medium text-slate-700 transition hover:bg-slate-50 focus-within:ring-2 focus-within:ring-sky-500/30 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800">
                    <span>Select CSV</span>
                    <InputFile class="sr-only" OnChange="OnFileSelected" accept=".csv,text/csv" />
                </label>
                <button type="button"
                        class="inline-flex items-center justify-center gap-2 rounded-xl border border-sky-600 bg-sky-600 px-3 py-2 text-xs font-medium text-white transition hover:bg-sky-700 focus:outline-none focus:ring-2 focus:ring-sky-500/30 disabled:cursor-not-allowed disabled:opacity-60 dark:border-sky-500 dark:bg-sky-500 dark:hover:bg-sky-400"
                        disabled="@(selectedFile is null || isImporting)"
                        @onclick="ImportAsync">
                    @(isImporting ? "Importing..." : "Import")
                </button>
            </div>
        </div>
    </section>

    <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-950/80">
        <div class="grid gap-3 md:grid-cols-5">
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3 dark:border-slate-800 dark:bg-slate-900/70">
                <div class="text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">File</div>
                <div class="mt-1 truncate text-sm font-semibold text-slate-900 dark:text-slate-100">@(selectedFile?.Name ?? "No file selected")</div>
            </div>
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3 dark:border-slate-800 dark:bg-slate-900/70">
                <div class="text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">Expected Code</div>
                <div class="mt-1 text-sm font-semibold text-slate-900 dark:text-slate-100">Code or column E</div>
            </div>
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3 dark:border-slate-800 dark:bg-slate-900/70">
                <div class="text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">Expected Name</div>
                <div class="mt-1 text-sm font-semibold text-slate-900 dark:text-slate-100">Name/Namn or column F</div>
            </div>
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3 dark:border-slate-800 dark:bg-slate-900/70">
                <div class="text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">Expected Quantity</div>
                <div class="mt-1 text-sm font-semibold text-slate-900 dark:text-slate-100">Mängd/Quantity or column G</div>
            </div>
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3 dark:border-slate-800 dark:bg-slate-900/70">
                <div class="text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">Expected Unit</div>
                <div class="mt-1 text-sm font-semibold text-slate-900 dark:text-slate-100">Enhet/Unit or column H</div>
            </div>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="rounded-2xl border border-rose-200 bg-rose-50 px-3 py-2 text-sm text-rose-700 dark:border-rose-900/70 dark:bg-rose-950/50 dark:text-rose-300">@errorMessage</div>
    }

    @if (result is not null)
    {
        <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-950/80">
            <div class="flex flex-wrap items-center justify-between gap-2">
                <div>
                    <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">Import summary</h3>
                    <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">Rows processed: @result.TotalRows, skipped: @result.SkippedRows</p>
                    @if (result.DeletedExistingData)
                    {
                        <p class="mt-1 text-xs font-medium text-amber-700 dark:text-amber-300">Existing tasks, folders and resources were deleted before import.</p>
                    }
                </div>
                <span class="inline-flex rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1 text-xs font-medium text-emerald-700 dark:border-emerald-900/60 dark:bg-emerald-950/40 dark:text-emerald-200">Completed</span>
            </div>

            <div class="mt-3 grid gap-2 sm:grid-cols-2 xl:grid-cols-4">
                @SummaryCard("Tasks", $"{result.CreatedTasks} created / {result.UpdatedTasks} updated")
                @SummaryCard("Resources", $"{result.CreatedResources} created / {result.UpdatedResources} updated")
                @SummaryCard("Folders", $"{result.CreatedFolders} created")
                @SummaryCard("Assignments", $"{result.CreatedAssignments} created / {result.UpdatedAssignments} updated")
                @SummaryCard("State Groups", $"{result.CreatedStateGroups} created")
                @SummaryCard("States", $"{result.CreatedStates} created")
                @SummaryCard("State Links", $"{result.CreatedStateLinks} created")
                @SummaryCard("Typ 0 – TaskUnit", $"{result.CreatedTaskConversionParams} created")
                @SummaryCard("Typ 1 – Parameters", $"{result.CreatedResourceParameters} created")
                @SummaryCard("Typ 2 – AddOns", $"{result.CreatedResourceAddOns} created")
                @SummaryCard("Typ 3 – Times", $"{result.CreatedResourceTimes} created")
                @SummaryCard("Issues", result.Issues.Count.ToString())
            </div>
        </section>

        @if (result.Issues.Count > 0)
        {
            <section class="rounded-2xl border border-amber-200 bg-amber-50 p-4 shadow-sm dark:border-amber-900/70 dark:bg-amber-950/30">
                <h3 class="text-sm font-semibold text-amber-900 dark:text-amber-100">Import issues</h3>
                <div class="mt-2 max-h-80 overflow-auto rounded-xl border border-amber-200 bg-white dark:border-amber-900/60 dark:bg-slate-950">
                    <table class="min-w-full divide-y divide-amber-100 text-sm dark:divide-amber-900/50">
                        <thead>
                            <tr>
                                <th class="px-2 py-1 text-left text-[11px] font-semibold uppercase tracking-[0.12em] text-amber-800 dark:text-amber-200">Row</th>
                                <th class="px-2 py-1 text-left text-[11px] font-semibold uppercase tracking-[0.12em] text-amber-800 dark:text-amber-200">Message</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var issue in result.Issues.Take(100))
                            {
                                <tr>
                                    <td class="px-2 py-1 align-top text-amber-900 dark:text-amber-100">@issue.RowNumber</td>
                                    <td class="px-2 py-1 align-top text-amber-900 dark:text-amber-100">@issue.Message</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    }
</div>

@code {
    private const long MaxFileSize = 100L * 1024L * 1024L;
    private IBrowserFile? selectedFile;
    private TaskResourceCsvImportResult? result;
    private string? errorMessage;
    private bool isImporting;
    private bool deleteExistingData;

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        result = null;
        errorMessage = null;
    }

    private async Task ImportAsync()
    {
        if (selectedFile is null)
            return;

        try
        {
            isImporting = true;
            errorMessage = null;
            result = null;

            await using var source = selectedFile.OpenReadStream(MaxFileSize);
            await using var buffer = new MemoryStream();
            await source.CopyToAsync(buffer);
            buffer.Position = 0;

            result = await ImportService.ImportAsync(buffer, selectedFile.Name, deleteExistingData, CancellationToken.None);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isImporting = false;
        }
    }

    private static RenderFragment SummaryCard(string label, string value) => @<div class="rounded-xl border border-slate-200 bg-slate-50 p-3 dark:border-slate-800 dark:bg-slate-900/70">
        <div class="text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">@label</div>
        <div class="mt-1 text-sm font-semibold text-slate-900 dark:text-slate-100">@value</div>
    </div>;
}
