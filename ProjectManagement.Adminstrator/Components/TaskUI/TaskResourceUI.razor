@inject ITaskDefinitionService TaskService
@inject ITaskResourceService TaskResourceService
@inherits AppComponentBase
@using Microsoft.Extensions.Localization
@using TaskResourceBlueprints.Dto.ProjectTask
@using TaskResourceBlueprints.Services.ProjectTask
@using ProjectManagement.Adminstrator.Components.ResourceUI
@using ProjectManagement.Shared.Base.AppTenant
@using ProjectManagement.Shared.DTO.App.Dataloader
@using ProjectManagement.Shared.Enums
@using TaskResourceBlueprints.Services.Resource
@using System.Globalization
@inject IStringLocalizer<CalcResource> L

<div class="space-y-2 rounded-2xl bg-white p-2 text-slate-900 dark:!bg-slate-950 dark:text-slate-100">
    @if (!string.IsNullOrWhiteSpace(FormErrorMessage))
    {
        <div class="rounded-2xl border border-rose-200 bg-rose-50 px-3 py-2 text-sm text-rose-700 shadow-sm dark:border-rose-900/60 dark:bg-rose-950/40 dark:text-rose-300">
            @FormErrorMessage
        </div>
    }

    @if (TaskResource is null)
    {
        <div class="@SectionClass">
            <div class="space-y-2 px-3 py-3 animate-pulse">
                <div class="h-4 w-40 rounded bg-slate-200/80 dark:bg-slate-700/70"></div>
                <div class="h-11 w-full rounded-xl bg-slate-200/80 dark:bg-slate-800/80"></div>
                <div class="h-11 w-full rounded-xl bg-slate-200/80 dark:bg-slate-800/80"></div>
                <div class="h-11 w-2/3 rounded-xl bg-slate-200/80 dark:bg-slate-800/80"></div>
            </div>
            <span class="sr-only">Loading...</span>
        </div>
    }
    else
    {
        <section class="@SectionClass">
            <div class="@HeaderClass">
                <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">Task resource setup</h3>
            </div>

            <div class="@BodyClass">
                <div class="overflow-x-auto">
                    <div class="flex min-w-max flex-nowrap items-stretch gap-2">
                        <div class="shrink-0">
                            <span class="@BadgeClass">Task: @Task.DisplayName</span>
                        </div>

                        <div class="shrink-0">
                            <span class="@BadgeClass">Resource: @Resource.DisplayName</span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Resource.Unit))
                        {
                            <div class="shrink-0">
                                <span class="@BadgeMutedClass">@Resource.Unit</span>
                            </div>
                        }

                        <div class="@StatCardClass w-[150px] shrink-0">
                            <div class="@StatLabelClass">Roles</div>
                            <div class="@StatValueClass">@(TaskResource.CapRole?.Count ?? 0)</div>
                        </div>

                        <div class="@StatCardClass w-[150px] shrink-0">
                            <div class="@StatLabelClass">Formulas</div>
                            <div class="@StatValueClass">@(TaskResource.Formulas?.Count ?? 0)</div>
                        </div>

                        <div class="@StatCardClass w-[220px] shrink-0">
                            <div class="@StatLabelClass">Type</div>
                            <div class="@StatValueClass">@TaskResource.ResType</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="@SectionClass">
            <div class="@HeaderClass">
                <h4 class="text-sm font-semibold text-slate-900 dark:text-slate-100">Settings</h4>
            </div>

            <div class="@BodyClass">
                <div class="overflow-x-auto">
                    <div class="flex min-w-max flex-nowrap items-start gap-2">
                        <div class="w-[180px] shrink-0">
                            <label for="menu-id" class="@LabelClass">Menu Id</label>
                            <input id="menu-id"
                                   type="text"
                                   inputmode="numeric"
                                   class="@InputClass"
                                   value="@MenuIdText"
                                   @oninput="OnMenuIdInput" />
                        </div>

                        <div class="w-[180px] shrink-0">
                            <label for="cf1" class="@LabelClass">@CalcResource.changeFactor1</label>
                            <input id="cf1"
                                   type="text"
                                   inputmode="decimal"
                                   class="@InputClass"
                                   value="@ChangeFactor1Text"
                                   @oninput="OnChangeFactor1Input" />
                        </div>

                        <div class="w-[180px] shrink-0">
                            <label for="cf2" class="@LabelClass">@CalcResource.changeFactor2</label>
                            <input id="cf2"
                                   type="text"
                                   inputmode="decimal"
                                   class="@InputClass"
                                   value="@ChangeFactor2Text"
                                   @oninput="OnChangeFactor2Input" />
                        </div>

                        <div class="w-[180px] shrink-0">
                            <label for="cap" class="@LabelClass">@(TaskResource.ResType == ResourceTypesEnum.Materials ? CalcResource.waste : CalcResource.cap)</label>
                            <input id="cap"
                                   type="text"
                                   inputmode="decimal"
                                   class="@InputClass"
                                   value="@CapWasteText"
                                   @oninput="OnCapWasteInput" />
                        </div>

                        <div class="w-[180px] shrink-0">
                            <label for="baseCost" class="@LabelClass">@CalcResource.baseCost</label>
                            <input id="baseCost"
                                   type="text"
                                   inputmode="decimal"
                                   class="@InputClass"
                                   value="@BaseCostText"
                                   @oninput="OnBaseCostInput" />
                        </div>
                    </div>
                </div>
            </div>
        </section>

        @if (TaskResource.ResType == ResourceTypesEnum.MachinesAndEquipments || TaskResource.ResType == ResourceTypesEnum.Worker)
        {
            <section class="@SectionClass">
                <div class="@HeaderClass">
                    <h4 class="text-sm font-semibold text-slate-900 dark:text-slate-100">Roles</h4>

                    <button type="button"
                            class="@SecondaryButtonClass"
                            @onclick="AddRole">
                        <span>+</span>
                        <span>Role</span>
                    </button>
                </div>

                <div class="@BodyClass">
                    @if (TaskResource.CapRole is not null && TaskResource.CapRole.Count > 0)
                    {
                        <div class="overflow-x-auto">
                            <div class="min-w-[760px] space-y-2">
                                <div class="grid grid-cols-[56px_1fr_1fr_1fr] gap-2 px-1 text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
                                    <div></div>
                                    <div>@AppControll.min</div>
                                    <div>@AppControll.max</div>
                                    <div>@CalcResource.cap</div>
                                </div>

                                @for (int i = 0; i < TaskResource.CapRole.Count; i++)
                                {
                                    var role = TaskResource.CapRole[i];

                                    <div class="rounded-2xl border border-slate-200 bg-slate-50 p-2.5 dark:border-slate-700 dark:!bg-slate-900/70">
                                        <div class="grid grid-cols-[56px_1fr_1fr_1fr] items-end gap-2">
                                            <div class="shrink-0">
                                                <button type="button"
                                                        title="@ResourceApp.delete"
                                                        class="inline-flex h-11 w-full items-center justify-center rounded-xl border border-rose-600 bg-rose-600 text-sm font-medium text-white transition hover:bg-rose-700 focus:outline-none focus:ring-2 focus:ring-rose-500/30 dark:border-rose-500 dark:bg-rose-500 dark:hover:bg-rose-400"
                                                        @onclick="@(() => TaskResource.CapRole.Remove(role))">
                                                    ×
                                                </button>
                                            </div>

                                            <div class="min-w-0">
                                                <input type="text"
                                                       inputmode="decimal"
                                                       class="@InputClass"
                                                       value="@FormatDecimal(role.Min)"
                                                       @oninput="e => OnRoleMinInput(role, e)"
                                                       aria-label="Min" />
                                            </div>

                                            <div class="min-w-0">
                                                <input type="text"
                                                       inputmode="decimal"
                                                       class="@InputClass"
                                                       value="@FormatDecimal(role.Max)"
                                                       @oninput="e => OnRoleMaxInput(role, e)"
                                                       aria-label="Max" />
                                            </div>

                                            <div class="min-w-0">
                                                <input type="text"
                                                       inputmode="decimal"
                                                       class="@InputClass"
                                                       value="@FormatNullableDecimal(role.Value)"
                                                       @oninput="e => OnRoleValueInput(role, e)"
                                                       aria-label="Cap" />
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="flex min-h-[110px] items-center justify-center rounded-2xl border border-dashed border-slate-300 bg-slate-100 px-3 py-6 text-center text-sm text-slate-500 dark:border-slate-700 dark:!bg-slate-900/70 dark:text-slate-300">
                            No roles
                        </div>
                    }
                </div>
            </section>
        }

        <section class="@SectionClass">
            <div class="@HeaderClass">
                <h4 class="text-sm font-semibold text-slate-900 dark:text-slate-100">@CalcResource.Formulas</h4>

                <button type="button"
                        class="@SecondaryButtonClass"
                        @onclick="@(() => TaskResource.Formulas.Add(string.Empty))">
                    <span>+</span>
                    <span>Add</span>
                </button>
            </div>

            <div class="@BodyClass">
                @if (TaskResource.Formulas is null || TaskResource.Formulas.Count == 0)
                {
                    <div class="flex min-h-[110px] items-center justify-center rounded-2xl border border-dashed border-slate-300 bg-slate-100 px-3 py-6 text-center text-sm text-slate-500 dark:border-slate-700 dark:!bg-slate-900/70 dark:text-slate-300">
                        No formulas
                    </div>
                }
                else
                {
                    <div class="space-y-2">
                        @foreach (var eq in TaskResource.Formulas.Select((value, index) => new { value, index }))
                        {
                            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-2 dark:border-slate-700 dark:!bg-slate-900/70">
                                <div class="grid grid-cols-[minmax(0,1fr)_auto] items-end gap-2">
                                    <div class="min-w-0">
                                        <label class="@LabelClass">Formula @(eq.index + 1)</label>
                                        <input class="@InputClass"
                                               placeholder="Formula"
                                               value="@TaskResource.Formulas[eq.index]"
                                               @oninput="e => TaskResource.Formulas[eq.index] = e.Value?.ToString() ?? string.Empty" />
                                    </div>

                                    <div class="shrink-0">
                                        <button type="button"
                                                class="@DangerButtonClass"
                                                title="@ResourceApp.delete"
                                                @onclick="@(() => RemoveFormula(eq.index))">
                                            @ResourceApp.delete
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </section>
    }

    <div class="border-t border-slate-200 pt-2 dark:border-slate-700">
        <div class="flex flex-wrap items-center justify-end gap-2">
            <button type="button"
                    class="@PrimaryButtonClass"
                    @onclick="SaveAsync">
                @ResourceApp.save
            </button>

            <button type="button"
                    class="@NeutralButtonClass"
                    @onclick="MHD.Modal.Close">
                @ResourceApp.cancel
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ProjectTaskListItemDto Task { get; set; } = default!;
    [Parameter, EditorRequired] public ResourceTaskIndexDto Resource { get; set; } = default!;

    private TaskResourceDto? TaskResource;
    private string? FormErrorMessage;
    private string MenuIdText { get; set; } = string.Empty;
    private string ChangeFactor1Text { get; set; } = string.Empty;
    private string ChangeFactor2Text { get; set; } = string.Empty;
    private string CapWasteText { get; set; } = string.Empty;
    private string BaseCostText { get; set; } = string.Empty;

    private const string SectionClass =
        "overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:!bg-slate-950";

    private const string HeaderClass =
        "flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 bg-slate-50 px-3 py-2 dark:border-slate-700 dark:!bg-slate-900";

    private const string BodyClass =
        "space-y-2 bg-white px-3 py-3 dark:!bg-slate-950";

    private const string LabelClass =
        "mb-1.5 block text-[11px] font-semibold uppercase tracking-wide text-slate-600 dark:text-slate-300";

    private const string InputClass =
        "block h-11 w-full rounded-xl border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:!bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500 dark:focus:border-sky-400 dark:focus:ring-sky-400/20";

    private const string BadgeClass =
        "inline-flex items-center rounded-full border border-slate-300 bg-slate-100 px-3 py-1.5 text-[11px] font-medium text-slate-700 dark:border-slate-700 dark:!bg-slate-900 dark:text-slate-200";

    private const string BadgeMutedClass =
        "inline-flex items-center rounded-full border border-slate-300 bg-slate-100 px-3 py-1.5 text-[11px] font-medium text-slate-600 dark:border-slate-700 dark:!bg-slate-900 dark:text-slate-300";

    private const string StatCardClass =
        "rounded-2xl border border-slate-300 bg-slate-100 p-3 dark:border-slate-700 dark:!bg-slate-800";

    private const string StatLabelClass =
        "text-[10px] font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400";

    private const string StatValueClass =
        "mt-1 break-words text-base font-semibold text-slate-900 dark:text-slate-100";

    private const string PrimaryButtonClass =
        "inline-flex h-10 items-center justify-center gap-1 rounded-xl border border-sky-600 bg-sky-600 px-4 text-sm font-medium text-white transition hover:bg-sky-700 focus:outline-none focus:ring-2 focus:ring-sky-500/30 disabled:cursor-not-allowed disabled:opacity-60 dark:border-sky-500 dark:bg-sky-500 dark:hover:bg-sky-400";

    private const string NeutralButtonClass =
        "inline-flex h-10 items-center justify-center gap-1 rounded-xl border border-slate-300 bg-white px-4 text-sm font-medium text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-400/30 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:!bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800";

    private const string SecondaryButtonClass =
        "inline-flex h-10 items-center justify-center gap-1.5 rounded-xl border border-slate-300 bg-slate-100 px-3 text-sm font-medium text-slate-700 transition hover:bg-slate-200 focus:outline-none focus:ring-2 focus:ring-slate-400/20 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:!bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700";

    private const string DangerButtonClass =
        "inline-flex h-10 items-center justify-center gap-1 rounded-xl border border-rose-600 bg-rose-600 px-3 text-sm font-medium text-white transition hover:bg-rose-700 focus:outline-none focus:ring-2 focus:ring-rose-500/30 disabled:cursor-not-allowed disabled:opacity-60 dark:border-rose-500 dark:bg-rose-500 dark:hover:bg-rose-400";

    private void RemoveFormula(int i)
    {
        if (TaskResource is not null && i >= 0 && i < TaskResource.Formulas.Count)
        {
            TaskResource.Formulas.RemoveAt(i);
        }
    }

    private void AddRole()
    {
        if (TaskResource?.CapRole is null)
        {
            return;
        }

        if (TaskResource.CapRole.Count != 0)
        {
            TaskResource.CapRole.Add(new()
            {
                Min = TaskResource.CapRole.Last().Max,
                Max = TaskResource.CapRole.Last().Max + 10,
                Value = TaskResource.CapRole.Last().Value + 1
            });
        }
        else
        {
            TaskResource.CapRole.Add(new() { Min = 0, Max = 10, Value = 5 });
        }

        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        TaskResource = await TaskResourceService.GetTaskResourceAsync(Task.Id, Resource.ResourceId, CancellationToken.None) ?? new TaskResourceDto();
        TaskResource.CapRole ??= [];
        TaskResource.Formulas ??= [];
        SyncNumericInputs();
    }

    private async Task SaveAsync()
    {
        if (TaskResource is null)
        {
            return;
        }

        if (!TryParseNullableInt(MenuIdText, out var menuId) ||
            !TryParseDecimal(ChangeFactor1Text, out var changeFactor1) ||
            !TryParseDecimal(ChangeFactor2Text, out var changeFactor2) ||
            !TryParseDecimal(CapWasteText, out var capWaste) ||
            !TryParseNullableDecimal(BaseCostText, out var baseCost))
        {
            FormErrorMessage = "Please enter valid numeric values before saving.";
            return;
        }

        FormErrorMessage = null;
        TaskResource.MenuId = menuId;
        TaskResource.ChangeFactor1 = changeFactor1;
        TaskResource.ChangeFactor2 = changeFactor2;
        TaskResource.CapWaste = capWaste;
        TaskResource.BaseCost = baseCost;

        if (await TaskResourceService.UpdateAssignmentAsync(Task.Id, Resource.ResourceId, TaskResource, CancellationToken.None))
        {
            MHD.Modal.Close();
        }
        else
        {
            MHD.MessageOk("Error", "There was an error saving the resource.", MhdState.Danger);
        }
    }

    private void SyncNumericInputs()
    {
        if (TaskResource is null)
        {
            return;
        }

        MenuIdText = TaskResource.MenuId?.ToString(CultureInfo.CurrentCulture) ?? string.Empty;
        ChangeFactor1Text = FormatDecimal(TaskResource.ChangeFactor1);
        ChangeFactor2Text = FormatDecimal(TaskResource.ChangeFactor2);
        CapWasteText = FormatDecimal(TaskResource.CapWaste);
        BaseCostText = FormatNullableDecimal(TaskResource.BaseCost);
    }

    private void OnMenuIdInput(ChangeEventArgs e)
    {
        MenuIdText = e.Value?.ToString() ?? string.Empty;
        if (TryParseNullableInt(MenuIdText, out var value) && TaskResource is not null)
        {
            TaskResource.MenuId = value;
            FormErrorMessage = null;
        }
    }

    private void OnChangeFactor1Input(ChangeEventArgs e)
    {
        ChangeFactor1Text = e.Value?.ToString() ?? string.Empty;
        if (TryParseDecimal(ChangeFactor1Text, out var value) && TaskResource is not null)
        {
            TaskResource.ChangeFactor1 = value;
            FormErrorMessage = null;
        }
    }

    private void OnChangeFactor2Input(ChangeEventArgs e)
    {
        ChangeFactor2Text = e.Value?.ToString() ?? string.Empty;
        if (TryParseDecimal(ChangeFactor2Text, out var value) && TaskResource is not null)
        {
            TaskResource.ChangeFactor2 = value;
            FormErrorMessage = null;
        }
    }

    private void OnCapWasteInput(ChangeEventArgs e)
    {
        CapWasteText = e.Value?.ToString() ?? string.Empty;
        if (TryParseDecimal(CapWasteText, out var value) && TaskResource is not null)
        {
            TaskResource.CapWaste = value;
            FormErrorMessage = null;
        }
    }

    private void OnBaseCostInput(ChangeEventArgs e)
    {
        BaseCostText = e.Value?.ToString() ?? string.Empty;
        if (TryParseNullableDecimal(BaseCostText, out var value) && TaskResource is not null)
        {
            TaskResource.BaseCost = value;
            FormErrorMessage = null;
        }
    }

    private void OnRoleMinInput(RoleDTO role, ChangeEventArgs e)
    {
        var text = e.Value?.ToString() ?? string.Empty;
        if (TryParseDecimal(text, out var value))
        {
            role.Min = value;
            FormErrorMessage = null;
        }
    }

    private void OnRoleMaxInput(RoleDTO role, ChangeEventArgs e)
    {
        var text = e.Value?.ToString() ?? string.Empty;
        if (TryParseDecimal(text, out var value))
        {
            role.Max = value;
            FormErrorMessage = null;
        }
    }

    private void OnRoleValueInput(RoleDTO role, ChangeEventArgs e)
    {
        var text = e.Value?.ToString() ?? string.Empty;
        if (TryParseNullableDecimal(text, out var value))
        {
            role.Value = value;
            FormErrorMessage = null;
        }
    }

    private static string FormatDecimal(decimal value)
        => NumericDisplayHelper.Format(value);

    private static string FormatNullableDecimal(decimal? value)
        => NumericDisplayHelper.Format(value);

    private static bool TryParseDecimal(string? text, out decimal value)
    {
        if (decimal.TryParse(text, NumberStyles.Number, CultureInfo.CurrentCulture, out value))
            return true;

        var normalized = text?.Replace(',', '.');
        return decimal.TryParse(normalized, NumberStyles.Number, CultureInfo.InvariantCulture, out value);
    }

    private static bool TryParseNullableDecimal(string? text, out decimal? value)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            value = null;
            return true;
        }

        if (TryParseDecimal(text, out var parsed))
        {
            value = parsed;
            return true;
        }

        value = null;
        return false;
    }

    private static bool TryParseNullableInt(string? text, out int? value)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            value = null;
            return true;
        }

        if (int.TryParse(text, NumberStyles.Integer, CultureInfo.CurrentCulture, out var parsed))
        {
            value = parsed;
            return true;
        }

        value = null;
        return false;
    }
}