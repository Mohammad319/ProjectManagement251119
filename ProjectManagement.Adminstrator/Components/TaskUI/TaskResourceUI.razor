@inject ITaskDefinitionService TaskService
@inject ITaskResourceService TaskResourceService
@inherits AppComponentBase
@using Microsoft.Extensions.Localization
@using TaskResourceBlueprints.Dto.ProjectTask
@using TaskResourceBlueprints.Services.ProjectTask
@using ProjectManagement.Adminstrator.Components.ResourceUI
@using ProjectManagement.Shared.DTO.App.Dataloader
@using ProjectManagement.Shared.Enums
@using TaskResourceBlueprints.Services.Resource
@inject IStringLocalizer<CalcResource> L

<div class="pm-page p-2">
    @if (TaskResource is null)
    {
        <div class="pm-card">
            <div class="pm-card-body space-y-3 animate-pulse">
                <div class="pm-skeleton-line w-1/3"></div>
                <div class="pm-skeleton-line h-10 w-full"></div>
                <div class="pm-skeleton-line h-10 w-full"></div>
                <div class="pm-skeleton-line h-10 w-5/6"></div>
            </div>
            <span class="sr-only">Loading...</span>
        </div>
    }
    else
    {
        <section class="pm-card">
            <div class="pm-card-header">
                <div>
                    <h3 class="pm-card-title">Task resource setup</h3>
                    <p class="pm-card-subtitle">Configure factors, caps, formulas, and role ranges for the selected task resource.</p>
                </div>

                <div class="flex flex-wrap items-center gap-2">
                    <span class="pm-chip-soft">Task: @Task.DisplayName</span>
                    <span class="pm-chip">Resource: @Resource.DisplayName</span>
                    @if (!string.IsNullOrWhiteSpace(Resource.Unit))
                    {
                        <span class="pm-chip-muted">@Resource.Unit</span>
                    }
                </div>
            </div>

            <div class="pm-card-body">
                <div class="pm-grid-3">
                    <div class="pm-stat">
                        <div class="pm-stat-label">Roles</div>
                        <div class="pm-stat-value">@(TaskResource.CapRole?.Count ?? 0)</div>
                    </div>
                    <div class="pm-stat">
                        <div class="pm-stat-label">Formulas</div>
                        <div class="pm-stat-value">@(TaskResource.Formulas?.Count ?? 0)</div>
                    </div>
                    <div class="pm-stat">
                        <div class="pm-stat-label">Resource type</div>
                        <div class="pm-stat-value text-base">@TaskResource.ResType</div>
                    </div>
                </div>
            </div>
        </section>

        <section class="pm-card">
            <div class="pm-card-header">
                <div>
                    <h4 class="pm-card-title">Settings</h4>
                    <p class="pm-card-subtitle">Base values used while the task calculates this resource assignment.</p>
                </div>
            </div>

            <div class="pm-card-body">
                <div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
                    <div>
                        <label for="menu-id" class="pm-label">Menu Id</label>
                        <input id="menu-id"
                               type="number"
                               step="1"
                               min="0"
                               class="pm-input"
                               @bind-value="TaskResource.MenuId"
                               @bind-value:event="oninput" />
                    </div>

                    <div>
                        <label for="cf1" class="pm-label">@CalcResource.changeFactor1</label>
                        <input id="cf1"
                               type="number"
                               step="0.01"
                               inputmode="decimal"
                               min="0"
                               class="pm-input"
                               @bind-value="TaskResource.ChangeFactor1"
                               @bind-value:event="oninput" />
                    </div>

                    <div>
                        <label for="cf2" class="pm-label">@CalcResource.changeFactor2</label>
                        <input id="cf2"
                               type="number"
                               step="0.01"
                               inputmode="decimal"
                               min="0"
                               class="pm-input"
                               @bind-value="TaskResource.ChangeFactor2"
                               @bind-value:event="oninput" />
                    </div>

                    <div>
                        <label for="cap" class="pm-label">@(TaskResource.ResType == ResourceTypesEnum.Materials ? CalcResource.waste : CalcResource.cap)</label>
                        <input id="cap"
                               type="number"
                               step="0.01"
                               inputmode="decimal"
                               min="0"
                               class="pm-input"
                               @bind-value="TaskResource.CapWaste"
                               @bind-value:event="oninput" />
                    </div>

                    <div>
                        <label for="baseCost" class="pm-label">@CalcResource.baseCost</label>
                        <input id="baseCost"
                               type="number"
                               step="0.01"
                               inputmode="decimal"
                               min="0"
                               class="pm-input"
                               @bind-value="TaskResource.BaseCost"
                               @bind-value:event="oninput" />
                    </div>
                </div>
            </div>
        </section>

        @if (TaskResource.ResType == ResourceTypesEnum.MachinesAndEquipments || TaskResource.ResType == ResourceTypesEnum.Worker)
        {
            <section class="pm-card">
                <div class="pm-card-header">
                    <div>
                        <h4 class="pm-card-title">Roles</h4>
                        <p class="pm-card-subtitle">Define quantity ranges and cap values for role-based assignments.</p>
                    </div>

                    <button type="button" class="pm-btn pm-btn-soft" @onclick="AddRole">
                        <span>+</span>
                        <span>Role</span>
                    </button>
                </div>

                <div class="pm-card-body space-y-3">
                    @if (TaskResource.CapRole is not null && TaskResource.CapRole.Count > 0)
                    {
                        <div class="hidden grid-cols-[80px_repeat(3,minmax(0,1fr))] gap-3 px-1 text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400 md:grid">
                            <div>Action</div>
                            <div>@AppControll.min</div>
                            <div>@AppControll.max</div>
                            <div>@CalcResource.cap</div>
                        </div>

                        @for (int i = 0; i < TaskResource.CapRole.Count; i++)
                        {
                            var role = TaskResource.CapRole[i];
                            <div class="rounded-2xl border border-slate-200 bg-slate-50/80 p-3 dark:border-slate-800 dark:bg-slate-900/50">
                                <div class="grid grid-cols-1 gap-3 md:grid-cols-[80px_repeat(3,minmax(0,1fr))] md:items-end">
                                    <div>
                                        <label class="pm-label md:sr-only">Action</label>
                                        <button type="button"
                                                title="@ResourceApp.delete"
                                                class="pm-btn pm-btn-danger w-full md:w-auto"
                                                @onclick="@(() => TaskResource.CapRole.Remove(role))">
                                            <span>×</span>
                                            <span>@ResourceApp.delete</span>
                                        </button>
                                    </div>

                                    <div>
                                        <label class="pm-label">@AppControll.min</label>
                                        <input type="number"
                                               step="1"
                                               min="0"
                                               class="pm-input"
                                               @bind-value="role.Min"
                                               @bind-value:event="oninput"
                                               aria-label="Min" />
                                    </div>

                                    <div>
                                        <label class="pm-label">@AppControll.max</label>
                                        <input type="number"
                                               step="1"
                                               min="0"
                                               class="pm-input"
                                               @bind-value="role.Max"
                                               @bind-value:event="oninput"
                                               aria-label="Max" />
                                    </div>

                                    <div>
                                        <label class="pm-label">@CalcResource.cap</label>
                                        <input type="number"
                                               step="0.01"
                                               min="0"
                                               class="pm-input"
                                               @bind-value="role.Value"
                                               @bind-value:event="oninput"
                                               aria-label="Cap" />
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="pm-empty">No roles defined yet.</div>
                    }
                </div>
            </section>
        }

        <section class="pm-card">
            <div class="pm-card-header">
                <div>
                    <h4 class="pm-card-title">@CalcResource.Formulas</h4>
                    <p class="pm-card-subtitle">Add one or more formulas that will be used for this task-resource assignment.</p>
                </div>

                <button class="pm-btn pm-btn-soft"
                        type="button"
                        @onclick="@(() => TaskResource.Formulas.Add(string.Empty))">
                    <span>+</span>
                    <span>Add formula</span>
                </button>
            </div>

            <div class="pm-card-body space-y-3">
                @if (TaskResource.Formulas is null || TaskResource.Formulas.Count == 0)
                {
                    <div class="pm-empty">No formulas added yet.</div>
                }
                else
                {
                    @foreach (var eq in TaskResource.Formulas.Select((value, index) => new { value, index }))
                    {
                        <div class="rounded-2xl border border-slate-200 bg-slate-50/80 p-3 dark:border-slate-800 dark:bg-slate-900/50">
                            <div class="flex flex-col gap-3 md:flex-row md:items-end">
                                <div class="flex-1">
                                    <label class="pm-label">Formula @(eq.index + 1)</label>
                                    <input class="pm-input"
                                           placeholder="Formula"
                                           value="@TaskResource.Formulas[eq.index]"
                                           @oninput="e => TaskResource.Formulas[eq.index] = e.Value?.ToString() ?? string.Empty" />
                                </div>

                                <button type="button"
                                        class="pm-btn pm-btn-danger"
                                        title="@ResourceApp.delete"
                                        @onclick="@(() => RemoveFormula(eq.index))">
                                    @ResourceApp.delete
                                </button>
                            </div>
                        </div>
                    }
                }
            </div>
        </section>
    }

    <div class="pm-divider pt-4">
        <div class="pm-toolbar justify-end">
            <button type="button" class="pm-btn pm-btn-primary" @onclick="SaveAsync">
                @ResourceApp.save
            </button>
            <button type="button" class="pm-btn pm-btn-secondary" @onclick="MHD.Modal.Close">
                @ResourceApp.cancel
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ProjectTaskListItemDto Task { get; set; } = default!;
    [Parameter, EditorRequired] public ResourceTaskIndexDto Resource { get; set; } = default!;

    private TaskResourceDto? TaskResource;

    private void RemoveFormula(int i)
    {
        if (TaskResource is not null && i >= 0 && i < TaskResource.Formulas.Count)
        {
            TaskResource.Formulas.RemoveAt(i);
        }
    }

    private void AddRole()
    {
        if (TaskResource?.CapRole is null)
        {
            return;
        }

        if (TaskResource.CapRole.Count != 0)
        {
            TaskResource.CapRole.Add(new()
            {
                Min = TaskResource.CapRole.Last().Max,
                Max = TaskResource.CapRole.Last().Max + 10,
                Value = TaskResource.CapRole.Last().Value + 1
            });
        }
        else
        {
            TaskResource.CapRole.Add(new() { Min = 0, Max = 10, Value = 5 });
        }

        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        TaskResource = await TaskResourceService.GetTaskResourceAsync(Task.Id, Resource.ResourceId, CancellationToken.None) ?? new TaskResourceDto();
        TaskResource.CapRole ??= [];
        TaskResource.Formulas ??= [];
    }

    private async Task SaveAsync()
    {
        if (TaskResource is null)
        {
            return;
        }

        if (await TaskResourceService.UpdateAssignmentAsync(Task.Id, Resource.ResourceId, TaskResource, CancellationToken.None))
        {
            MHD.Modal.Close();
        }
        else
        {
            MHD.MessageOk("Error", "There was an error saving the resource.", MhdState.Danger);
        }
    }
}
