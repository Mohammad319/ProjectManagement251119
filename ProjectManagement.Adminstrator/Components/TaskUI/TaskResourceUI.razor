@inject ITaskDefinitionService TaskService
@inject ITaskResourceService TaskResourceService
@attribute [Authorize(Roles = PMRolesConst.APP.AdminManger)]
@inherits AppComponentBase
@using Microsoft.Extensions.Localization
@using TaskResourceBlueprints.Dto.ProjectTask
@using TaskResourceBlueprints.Services.ProjectTask
@using ProjectManagement.Adminstrator.Components.ResourceUI
@using ProjectManagement.Shared.Base.AppTenant
@using ProjectManagement.Shared.DTO.App.Dataloader
@using ProjectManagement.Shared.Base.Calculation
@using ProjectManagement.Shared.Enums
@using TaskResourceBlueprints.Services.Resource
@using System.Globalization
@inject IStringLocalizer<CalcResource> L

<div class="space-y-2 rounded-2xl bg-white p-2 text-slate-900 dark:!bg-slate-950 dark:text-slate-100">
    @if (!string.IsNullOrWhiteSpace(FormErrorMessage))
    {
        <div class="rounded-2xl border border-rose-200 bg-rose-50 px-3 py-2 text-sm text-rose-700 shadow-sm dark:border-rose-900/60 dark:bg-rose-950/40 dark:text-rose-300">
            @FormErrorMessage
        </div>
    }

    @if (TaskResource is null)
    {
        <div class="@SectionClass">
            <div class="space-y-2 px-3 py-3 animate-pulse">
                <div class="h-4 w-40 rounded bg-slate-200/80 dark:bg-slate-700/70"></div>
                <div class="h-11 w-full rounded-xl bg-slate-200/80 dark:bg-slate-800/80"></div>
                <div class="h-11 w-full rounded-xl bg-slate-200/80 dark:bg-slate-800/80"></div>
                <div class="h-11 w-2/3 rounded-xl bg-slate-200/80 dark:bg-slate-800/80"></div>
            </div>
            <span class="sr-only">Loading...</span>
        </div>
    }
    else
    {

        <section class="@SectionClass">
    
            <div class="@BodyClass">
                <div class="overflow-x-auto">
                    <div class="flex min-w-max flex-nowrap items-start gap-2">
                        <div class="w-[180px] shrink-0">
                            <label for="qty" class="@LabelClass">@CalcResource.quantity</label>
                            <input id="qty"
                                   type="text"
                                   inputmode="decimal"
                                   class="@InputClass"
                                   value="@QuantityText"
                                   @oninput="OnQuantityInput" />
                        </div>

                        <div class="flex w-[140px] shrink-0 flex-col">
                            <label class="@LabelClass">Fixed</label>
                            <label class="flex h-11 cursor-pointer items-center gap-2 px-1">
                                <input type="checkbox"
                                       class="h-4 w-4 rounded border-slate-300 text-sky-600 focus:ring-sky-500"
                                       checked="@TaskResource.IsFixed"
                                       @onchange="e => { TaskResource.IsFixed = (bool)(e.Value ?? false); }" />
                                <span class="text-sm text-slate-700 dark:text-slate-200">@(TaskResource.IsFixed ? "Yes" : "No")</span>
                            </label>
                        </div>

                        <div class="w-[180px] shrink-0">
                            <label for="menu-id" class="@LabelClass">Menu Id</label>
                            <input id="menu-id"
                                   type="text"
                                   inputmode="numeric"
                                   class="@InputClass"
                                   value="@MenuIdText"
                                   @oninput="OnMenuIdInput" />
                        </div>

                        @*              <div class="w-[180px] shrink-0">
                            <label for="cf1" class="@LabelClass">@CalcResource.changeFactor1</label>
                            <input id="cf1"
                                   type="text"
                                   inputmode="decimal"
                                   class="@InputClass"
                                   value="@ChangeFactor1Text"
                                   @oninput="OnChangeFactor1Input" />
                        </div>

                        <div class="w-[180px] shrink-0">
                            <label for="cf2" class="@LabelClass">@CalcResource.changeFactor2</label>
                            <input id="cf2"
                                   type="text"
                                   inputmode="decimal"
                                   class="@InputClass"
                                   value="@ChangeFactor2Text"
                                   @oninput="OnChangeFactor2Input" />
                        </div> *@

                        <div class="w-[180px] shrink-0">
                            <label for="cap" class="@LabelClass">@(TaskResource.ResType == ResourceTypesEnum.Materials ? CalcResource.waste : CalcResource.cap)</label>
                            <input id="cap"
                                   type="text"
                                   inputmode="decimal"
                                   class="@InputClass"
                                   value="@CapWasteText"
                                   @oninput="OnCapWasteInput" />
                        </div>

                        <div class="w-[180px] shrink-0">
                            <label for="baseCost" class="@LabelClass">@CalcResource.baseCost</label>
                            <input id="baseCost"
                                   type="text"
                                   inputmode="decimal"
                                   class="@InputClass"
                                   value="@BaseCostText"
                                   @oninput="OnBaseCostInput" />
                        </div>
                    </div>
                </div>
            </div>
        </section>

        @if (TaskResource.ResType == ResourceTypesEnum.MachinesAndEquipments || TaskResource.ResType == ResourceTypesEnum.Worker)
        {
            <section class="@SectionClass">
                <div class="@HeaderClass">
                    <h4 class="text-sm font-semibold text-slate-900 dark:text-slate-100">Roles</h4>

                    <button type="button"
                            class="@SecondaryButtonClass"
                            @onclick="AddRole">
                        <span>+</span>
                        <span>Role</span>
                    </button>
                </div>

                <div class="@BodyClass">
                    @if (TaskResource.CapRole is not null && TaskResource.CapRole.Count > 0)
                    {
                        <div class="overflow-x-auto">
                            <div class="min-w-[760px] space-y-2">
                                <div class="grid grid-cols-[56px_1fr_1fr_1fr] gap-2 px-1 text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
                                    <div></div>
                                    <div>@AppControll.min</div>
                                    <div>@AppControll.max</div>
                                    <div>@CalcResource.cap</div>
                                </div>

                                @for (int i = 0; i < TaskResource.CapRole.Count; i++)
                                {
                                    var role = TaskResource.CapRole[i];

                                    <div class="rounded-2xl border border-slate-200 bg-slate-50 p-2.5 dark:border-slate-700 dark:!bg-slate-900/70">
                                        <div class="grid grid-cols-[56px_1fr_1fr_1fr] items-end gap-2">
                                            <div class="shrink-0">
                                                <button type="button"
                                                        title="@ResourceApp.delete"
                                                        class="inline-flex h-11 w-full items-center justify-center rounded-xl border border-rose-600 bg-rose-600 text-sm font-medium text-white transition hover:bg-rose-700 focus:outline-none focus:ring-2 focus:ring-rose-500/30 dark:border-rose-500 dark:bg-rose-500 dark:hover:bg-rose-400"
                                                        @onclick="@(() => TaskResource.CapRole.Remove(role))">
                                                    ×
                                                </button>
                                            </div>

                                            <div class="min-w-0">
                                                <input type="text"
                                                       inputmode="decimal"
                                                       class="@InputClass"
                                                       value="@FormatDecimal(role.Min)"
                                                       @oninput="e => OnRoleMinInput(role, e)"
                                                       aria-label="Min" />
                                            </div>

                                            <div class="min-w-0">
                                                <input type="text"
                                                       inputmode="decimal"
                                                       class="@InputClass"
                                                       value="@FormatDecimal(role.Max)"
                                                       @oninput="e => OnRoleMaxInput(role, e)"
                                                       aria-label="Max" />
                                            </div>

                                            <div class="min-w-0">
                                                <input type="text"
                                                       inputmode="decimal"
                                                       class="@InputClass"
                                                       value="@FormatNullableDecimal(role.Value)"
                                                       @oninput="e => OnRoleValueInput(role, e)"
                                                       aria-label="Cap" />
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="flex min-h-[110px] items-center justify-center rounded-2xl border border-dashed border-slate-300 bg-slate-100 px-3 py-6 text-center text-sm text-slate-500 dark:border-slate-700 dark:!bg-slate-900/70 dark:text-slate-300">
                            No roles
                        </div>
                    }
                </div>
            </section>
        }

        <!-- PARAMETERS -->
        <section class="@SectionClass">
            <div class="@HeaderClass">
                <h4 class="text-sm font-semibold text-slate-900 dark:text-slate-100">Parameters</h4>
                <button type="button" class="@SecondaryButtonClass" @onclick="AddParameter">
                    <span>+</span><span>Parameter</span>
                </button>
            </div>
            <div class="@BodyClass">
                @if (TaskResource.Parameters.Count > 0)
                {
                    <div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-700">
                        <table class="min-w-full border-collapse text-sm">
                            <thead>
                                <tr class="border-b border-slate-200 bg-slate-50 dark:border-slate-700 dark:bg-slate-800/60">
                                    <th class="w-10 px-1 py-1.5"></th>
                                    <th class="px-2 py-1.5 text-left text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">@CalcResource.active</th>
                                    <th class="px-2 py-1.5 text-left text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">@CalcResource.name</th>
                                    <th class="px-2 py-1.5 text-left text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Value</th>
                                    <th class="px-2 py-1.5 text-left text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">@CalcResource.unit</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < TaskResource.Parameters.Count; i++)
                                {
                                    int idx = i;
                                    <tr class="border-b border-slate-200 last:border-0 dark:border-slate-700">
                                        <td class="px-1 py-0.5 w-10">
                                            <button type="button" class="@DangerButtonClass h-8 w-8 !px-0"
                                                    @onclick="() => TaskResource.Parameters.RemoveAt(idx)">×</button>
                                        </td>
                                        <td class="px-1 py-0.5 w-12 text-center">
                                            <input type="checkbox"
                                                   class="h-4 w-4 rounded border-slate-300 text-sky-600 focus:ring-sky-500"
                                                   checked="@TaskResource.Parameters[idx].IsActive"
                                                   @onchange="e => TaskResource.Parameters[idx].IsActive = (bool)(e.Value ?? true)" />
                                        </td>
                                        <td class="px-1 py-0.5 min-w-[14rem]">
                                            <input type="text" class="@InputClass"
                                                   value="@TaskResource.Parameters[idx].Name"
                                                   @oninput="e => TaskResource.Parameters[idx].Name = e.Value?.ToString() ?? string.Empty" />
                                        </td>
                                        <td class="px-1 py-0.5 min-w-[7rem]">
                                            <input type="text" inputmode="decimal" class="@InputClass"
                                                   value="@FormatDecimal(TaskResource.Parameters[idx].Value)"
                                                   @oninput="e => { if (TryParseDecimal(e.Value?.ToString(), out var v)) TaskResource.Parameters[idx].Value = v; }" />
                                        </td>
                                        <td class="px-1 py-0.5 min-w-[7rem]">
                                            <input type="text" class="@InputClass"
                                                   value="@TaskResource.Parameters[idx].Unit"
                                                   @oninput="e => TaskResource.Parameters[idx].Unit = e.Value?.ToString() ?? string.Empty" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="flex min-h-[80px] items-center justify-center rounded-2xl border border-dashed border-slate-300 bg-slate-100 px-3 py-4 text-center text-sm text-slate-500 dark:border-slate-700 dark:!bg-slate-900/70 dark:text-slate-300">
                        No parameters
                    </div>
                }
            </div>
        </section>

        <!-- ADD-ONS -->
        <section class="@SectionClass">
            <div class="@HeaderClass">
                <h4 class="text-sm font-semibold text-slate-900 dark:text-slate-100">Add-ons</h4>
                <button type="button" class="@SecondaryButtonClass" @onclick="AddAddOn">
                    <span>+</span><span>Add-on</span>
                </button>
            </div>
            <div class="@BodyClass">
                @if (TaskResource.AddOns.Count > 0)
                {
                    <div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-700">
                        <table class="min-w-full border-collapse text-sm">
                            <thead>
                                <tr class="border-b border-slate-200 bg-slate-50 dark:border-slate-700 dark:bg-slate-800/60">
                                    <th class="w-10 px-1 py-1.5"></th>
                                    <th class="px-2 py-1.5 text-left text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">@CalcResource.active</th>
                                    <th class="px-2 py-1.5 text-left text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">@CalcResource.name</th>
                                    <th class="px-2 py-1.5 text-left text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">@CalcResource.type</th>
                                    <th class="px-2 py-1.5 text-left text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Factor</th>
                                    <th class="px-2 py-1.5 text-left text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">@CalcResource.cost</th>
                                    <th class="px-2 py-1.5 text-left text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">@CalcResource.unit</th>
                                    <th class="px-2 py-1.5 text-left text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">@CalcResource.baseCost</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < TaskResource.AddOns.Count; i++)
                                {
                                    int idx = i;
                                    <tr class="border-b border-slate-200 last:border-0 dark:border-slate-700">
                                        <td class="px-1 py-0.5 w-10">
                                            <button type="button" class="@DangerButtonClass h-8 w-8 !px-0"
                                                    @onclick="() => TaskResource.AddOns.RemoveAt(idx)">×</button>
                                        </td>
                                        <td class="px-1 py-0.5 w-12 text-center">
                                            <input type="checkbox"
                                                   class="h-4 w-4 rounded border-slate-300 text-sky-600 focus:ring-sky-500"
                                                   checked="@TaskResource.AddOns[idx].IsActive"
                                                   @onchange="e => TaskResource.AddOns[idx].IsActive = (bool)(e.Value ?? true)" />
                                        </td>
                                        <td class="px-1 py-0.5 min-w-[12rem]">
                                            <input type="text" class="@InputClass"
                                                   value="@TaskResource.AddOns[idx].Name"
                                                   @oninput="e => TaskResource.AddOns[idx].Name = e.Value?.ToString() ?? string.Empty" />
                                        </td>
                                        <td class="px-1 py-0.5 min-w-[5rem]">
                                            <select class="@InputClass"
                                                    value="@((int)TaskResource.AddOns[idx].Type)"
                                                    @onchange="e => OnAddOnTypeChanged(idx, e)">
                                                <option value="@((int)QuantityResourceAddon.Multiplication)">*</option>
                                                <option value="@((int)QuantityResourceAddon.Division)">/</option>
                                            </select>
                                        </td>
                                        <td class="px-1 py-0.5 min-w-[7rem]">
                                            <input type="text" inputmode="decimal" class="@InputClass"
                                                   value="@FormatDecimal(TaskResource.AddOns[idx].Factor)"
                                                   @oninput="e => { if (TryParseDecimal(e.Value?.ToString(), out var v)) TaskResource.AddOns[idx].Factor = v; }" />
                                        </td>
                                        <td class="px-1 py-0.5 min-w-[7rem]">
                                            <input type="text" inputmode="decimal" class="@InputClass"
                                                   value="@FormatDecimal(TaskResource.AddOns[idx].Cost)"
                                                   @oninput="e => { if (TryParseDecimal(e.Value?.ToString(), out var v)) TaskResource.AddOns[idx].Cost = v; }" />
                                        </td>
                                        <td class="px-1 py-0.5 min-w-[7rem]">
                                            <input type="text" class="@InputClass"
                                                   value="@TaskResource.AddOns[idx].Unit"
                                                   @oninput="e => TaskResource.AddOns[idx].Unit = e.Value?.ToString() ?? string.Empty" />
                                        </td>
                                        <td class="px-1 py-0.5 min-w-[7rem]">
                                            <input type="text" inputmode="decimal" class="@InputClass"
                                                   value="@FormatDecimal(TaskResource.AddOns[idx].BaseCost)"
                                                   @oninput="e => { if (TryParseDecimal(e.Value?.ToString(), out var v)) TaskResource.AddOns[idx].BaseCost = v; }" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="flex min-h-[80px] items-center justify-center rounded-2xl border border-dashed border-slate-300 bg-slate-100 px-3 py-4 text-center text-sm text-slate-500 dark:border-slate-700 dark:!bg-slate-900/70 dark:text-slate-300">
                        No add-ons
                    </div>
                }
            </div>
        </section>

        <!-- TIMES -->
        @if (TaskResource.ResType == ResourceTypesEnum.Worker || TaskResource.ResType == ResourceTypesEnum.MachinesAndEquipments)
        {
            <section class="@SectionClass">
                <div class="@HeaderClass">
                    <h4 class="text-sm font-semibold text-slate-900 dark:text-slate-100">Times</h4>
                    <button type="button" class="@SecondaryButtonClass" @onclick="AddTime">
                        <span>+</span><span>Time</span>
                    </button>
                </div>
                <div class="@BodyClass">
                    @if (TaskResource.Times.Count > 0)
                    {
                        <div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-700">
                            <table class="min-w-full border-collapse text-sm">
                                <thead>
                                    <tr class="border-b border-slate-200 bg-slate-50 dark:border-slate-700 dark:bg-slate-800/60">
                                        <th class="w-10 px-1 py-1.5"></th>
                                        <th class="px-2 py-1.5 text-left text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">@CalcResource.active</th>
                                        <th class="px-2 py-1.5 text-left text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">@CalcResource.name</th>
                                        <th class="px-2 py-1.5 text-left text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Time share %</th>
                                        <th class="px-2 py-1.5 text-left text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">@CalcResource.cost</th>
                                        <th class="px-2 py-1.5 text-left text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">@CalcResource.unit</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < TaskResource.Times.Count; i++)
                                    {
                                        int idx = i;
                                        <tr class="border-b border-slate-200 last:border-0 dark:border-slate-700">
                                            <td class="px-1 py-0.5 w-10">
                                                <button type="button" class="@DangerButtonClass h-8 w-8 !px-0"
                                                        @onclick="() => TaskResource.Times.RemoveAt(idx)">×</button>
                                            </td>
                                            <td class="px-1 py-0.5 w-12 text-center">
                                                <input type="checkbox"
                                                       class="h-4 w-4 rounded border-slate-300 text-sky-600 focus:ring-sky-500"
                                                       checked="@TaskResource.Times[idx].IsActive"
                                                       @onchange="e => TaskResource.Times[idx].IsActive = (bool)(e.Value ?? true)" />
                                            </td>
                                            <td class="px-1 py-0.5 min-w-[14rem]">
                                                <input type="text" class="@InputClass"
                                                       value="@TaskResource.Times[idx].Name"
                                                       @oninput="e => TaskResource.Times[idx].Name = e.Value?.ToString() ?? string.Empty" />
                                            </td>
                                            <td class="px-1 py-0.5 min-w-[7rem]">
                                                <input type="text" inputmode="decimal" class="@InputClass"
                                                       value="@FormatNullableDecimal(TaskResource.Times[idx].Percentage)"
                                                       @oninput="e => { if (TryParseNullableDecimal(e.Value?.ToString(), out var v)) TaskResource.Times[idx].Percentage = v; }" />
                                            </td>
                                            <td class="px-1 py-0.5 min-w-[7rem]">
                                                <input type="text" inputmode="decimal" class="@InputClass"
                                                       value="@FormatDecimal(TaskResource.Times[idx].Cost)"
                                                       @oninput="e => { if (TryParseDecimal(e.Value?.ToString(), out var v)) TaskResource.Times[idx].Cost = v; }" />
                                            </td>
                                            <td class="px-1 py-0.5 min-w-[7rem]">
                                                <input type="text" class="block h-11 w-full rounded-xl border border-slate-200 bg-slate-100 px-3 py-2 text-sm text-slate-500 dark:border-slate-700 dark:!bg-slate-800 dark:text-slate-300"
                                                       disabled value="@TaskResource.Unit" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="flex min-h-[80px] items-center justify-center rounded-2xl border border-dashed border-slate-300 bg-slate-100 px-3 py-4 text-center text-sm text-slate-500 dark:border-slate-700 dark:!bg-slate-900/70 dark:text-slate-300">
                            No times
                        </div>
                    }
                </div>
            </section>
        }
    }

    <div class="border-t border-slate-200 pt-2 dark:border-slate-700">
        <div class="flex flex-wrap items-center justify-end gap-2">
            <button type="button"
                    class="@PrimaryButtonClass"
                    @onclick="SaveAsync">
                @ResourceApp.save
            </button>

            <button type="button"
                    class="@NeutralButtonClass"
                    @onclick="MHD.Modal.CloseAsync">
                @ResourceApp.cancel
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ProjectTaskListItemDto Task { get; set; } = default!;
    [Parameter, EditorRequired] public ResourceTaskIndexDto Resource { get; set; } = default!;

    private TaskResourceDto? TaskResource;
    private string? FormErrorMessage;
    private string QuantityText { get; set; } = string.Empty;
    private string MenuIdText { get; set; } = string.Empty;
    private string ChangeFactor1Text { get; set; } = string.Empty;
    private string ChangeFactor2Text { get; set; } = string.Empty;
    private string CapWasteText { get; set; } = string.Empty;
    private string BaseCostText { get; set; } = string.Empty;

    private const string SectionClass =
        "overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:!bg-slate-950";

    private const string HeaderClass =
        "flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 bg-slate-50 px-3 py-2 dark:border-slate-700 dark:!bg-slate-900";

    private const string BodyClass =
        "space-y-2 bg-white px-3 py-3 dark:!bg-slate-950";

    private const string LabelClass =
        "mb-1.5 block text-[11px] font-semibold uppercase tracking-wide text-slate-600 dark:text-slate-300";

    private const string InputClass =
        "block h-11 w-full rounded-xl border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:!bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500 dark:focus:border-sky-400 dark:focus:ring-sky-400/20";

    private const string BadgeClass =
        "inline-flex items-center rounded-full border border-slate-300 bg-slate-100 px-3 py-1.5 text-[11px] font-medium text-slate-700 dark:border-slate-700 dark:!bg-slate-900 dark:text-slate-200";

    private const string BadgeMutedClass =
        "inline-flex items-center rounded-full border border-slate-300 bg-slate-100 px-3 py-1.5 text-[11px] font-medium text-slate-600 dark:border-slate-700 dark:!bg-slate-900 dark:text-slate-300";

    private const string StatCardClass =
        "rounded-2xl border border-slate-300 bg-slate-100 p-3 dark:border-slate-700 dark:!bg-slate-800";

    private const string StatLabelClass =
        "text-[10px] font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400";

