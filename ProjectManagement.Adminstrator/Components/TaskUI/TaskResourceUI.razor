@inject ITaskDefinitionService TaskService
@inject  ITaskResourceService TaskResourceService
@inherits AppComponentBase
@using Microsoft.Extensions.Localization
@using TaskResourceBlueprints.Dto.ProjectTask
@using TaskResourceBlueprints.Services.ProjectTask
@using ProjectManagement.Adminstrator.Components.ResourceUI
@using ProjectManagement.Shared.DTO.App.Dataloader
@using ProjectManagement.Shared.Enums
@using TaskResourceBlueprints.Services.Resource
@inject IStringLocalizer<CalcResource> L

<div class="space-y-4 p-2">
    @if (TaskResource is null)
    {
        <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-950">
            <div class="animate-pulse space-y-2">
                <div class="h-4 bg-gray-200 dark:bg-gray-700 rounded w-1/3"></div>
                <div class="h-8 bg-gray-200 dark:bg-gray-700 rounded"></div>
                <div class="h-8 bg-gray-200 dark:bg-gray-700 rounded"></div>
                <div class="h-8 bg-gray-200 dark:bg-gray-700 rounded"></div>
            </div>
            <span class="sr-only">Loading...</span>
        </div>
    }
    else
    {
        <!-- بطاقة: الإعدادات الأساسية -->
        <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-950">
            <h5 class="font-medium text-gray-800 dark:text-gray-100">Settings</h5>

            <div class="grid grid-cols-1 gap-3 md:grid-cols-6">
                <div class="space-y-1 md:col-span-3">
                    <label for="cf1" class="block text-sm font-medium text-slate-700 dark:text-slate-200">Menu Id</label>
                    <input type="number" step="1" min="0" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
                           @bind-value="TaskResource.MenuId"
                           @bind-value:event="oninput"/>
                </div>
                <div class="space-y-1 md:col-span-3">
                    <label for="cf1" class="block text-sm font-medium text-slate-700 dark:text-slate-200">@CalcResource.changeFactor1</label>
                    <input id="cf1"
                           type="number"
                           step="0.01"
                           inputmode="decimal"
                           min="0"
                           class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
                           @bind-value="TaskResource.ChangeFactor1"
                           @bind-value:event="oninput" />
                </div>
                <div class="space-y-1 md:col-span-3">
                    <label for="cf2" class="block text-sm font-medium text-slate-700 dark:text-slate-200">@CalcResource.changeFactor2</label>
                    <input id="cf2"
                           type="number"
                           step="0.01"
                           inputmode="decimal"
                           min="0"
                           class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
                           @bind-value="TaskResource.ChangeFactor2"
                           @bind-value:event="oninput" />
                </div>

                <div class="space-y-1 md:col-span-3">
                    <label for="cap" class="block text-sm font-medium text-slate-700 dark:text-slate-200">
                        @if (TaskResource?.ResType == ResourceTypesEnum.Materials)
                        {
                            <span>@CalcResource.waste</span>
                        }
                        else
                        {
                            <span>@CalcResource.cap</span>
                        }
                    </label>
                    <input id="cap"
                           type="number"
                           step="0.01"
                           inputmode="decimal"
                           min="0"
                           class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
                           @bind-value="TaskResource!.CapWaste"
                           @bind-value:event="oninput" />
                </div>

                <div class="space-y-1 md:col-span-3">
                    <label for="baseCost" class="block text-sm font-medium text-slate-700 dark:text-slate-200">
                        @CalcResource.baseCost
                    </label>
                    <input id="baseCost"
                           type="number"
                           step="0.01"
                           inputmode="decimal"
                           min="0"
                           class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
                           @bind-value="TaskResource.BaseCost"
                           @bind-value:event="oninput" />
                </div>

            </div>
        </div>

        @if (TaskResource?.ResType == ResourceTypesEnum.MachinesAndEquipments
            || TaskResource?.ResType == ResourceTypesEnum.Worker)
        {
            <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-950 mt-4">
                <div class="flex items-center justify-between gap-2">
                    <h5 class="font-medium text-gray-800 dark:text-gray-100">Roles</h5>
                    <button type="button"
                            class="inline-flex items-center rounded-lg border border-blue-200 bg-blue-50 px-2 py-1 text-xs font-medium text-blue-700 transition hover:bg-blue-100 dark:border-blue-900/60 dark:bg-blue-950/40 dark:text-blue-300"
                            @onclick="AddRole">
                        + Role
                    </button>
                </div>

                <div class="mt-2">
                    <div class="grid grid-cols-1 gap-3 md:grid-cols-6 text-xs font-semibold text-gray-600 dark:text-gray-300">
                        <div></div>
                        <div>@AppControll.min</div>
                        <div>@AppControll.max</div>
                        <div>@CalcResource.cap</div>
                    </div>

                    @if (TaskResource.CapRole is not null && TaskResource.CapRole.Count > 0)
                    {
                        @for (int i = 0; i < TaskResource.CapRole.Count; i++)
                        {
                            var role = TaskResource.CapRole[i];
                            <div class="grid grid-cols-1 gap-3 md:grid-cols-6 items-center">
                                <div class="flex items-center">
                                    <button type="button"
                                            title="@ResourceApp.delete"
                                            class="inline-flex h-6 w-6 items-center justify-center rounded-md border border-rose-200 bg-rose-50 p-0 text-rose-700 transition hover:bg-rose-100 dark:border-rose-900/60 dark:bg-rose-950/40 dark:text-rose-300"
                                            @onclick="@(() => TaskResource.CapRole.Remove(role))">
                                        ×
                                    </button>
                                </div>

                                <input type="number"
                                       step="1"
                                       min="0"
                                       class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
                                       @bind-value="role.Min"
                                       @bind-value:event="oninput"
                                       aria-label="Min" />

                                <input type="number"
                                       step="1"
                                       min="0"
                                       class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
                                       @bind-value="role.Max"
                                       @bind-value:event="oninput"
                                       aria-label="Max" />

                                <input type="number"
                                       step="0.01"
                                       min="0"
                                       class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
                                       @bind-value="role.Value"
                                       @bind-value:event="oninput"
                                       aria-label="Cap" />
                            </div>
                        }
                    }
                    else
                    {
                        <div class="mt-2 text-sm text-slate-500 dark:text-slate-400">
                            No Data
                        </div>
                    }
                </div>
            </div>
        }

        <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-950 mt-4">
            <div class="flex items-center justify-between gap-2">
                <h5 class="font-medium text-gray-800 dark:text-gray-100">@CalcResource.Formulas</h5>
                <button class="inline-flex items-center rounded-lg border border-blue-200 bg-blue-50 px-2 py-1 text-xs font-medium text-blue-700 transition hover:bg-blue-100 dark:border-blue-900/60 dark:bg-blue-950/40 dark:text-blue-300"
                        type="button"
                        @onclick="@(() => TaskResource!.Formulas.Add(string.Empty))">
                    + Add Formula
                </button>
            </div>

            @if (TaskResource!.Formulas is null || TaskResource.Formulas.Count == 0)
            {
                <div class="mt-2 text-sm text-slate-500 dark:text-slate-400">No Data</div>
            }
            else
            {
                @foreach (var eq in TaskResource.Formulas.Select((value, index) => new { value, index }))
                {
                    <div class="mt-4 flex items-center gap-2">
                        <input class="w-full flex-1 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
                               placeholder="Formula"
                               value="@TaskResource!.Formulas[eq.index]"
                               @oninput="e => TaskResource!.Formulas[eq.index] = e.Value?.ToString() ?? string.Empty" />
                        <button type="button"
                                class="inline-flex items-center rounded-lg border border-rose-200 bg-rose-50 px-2 py-1 text-xs font-medium text-rose-700 transition hover:bg-rose-100 dark:border-rose-900/60 dark:bg-rose-950/40 dark:text-rose-300"
                                title="@ResourceApp.delete"
                                @onclick="@(() => RemoveFormula(eq.index))">
                            @ResourceApp.delete
                        </button>
                    </div>
                }
            }
        </div>
    }

    <div class="mt-6 border-t border-slate-200 pt-4 dark:border-slate-800">
        <div class="flex flex-wrap items-center gap-3">
            <button type="button"
                    class="inline-flex items-center rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-2 text-sm font-medium text-emerald-700 transition hover:bg-emerald-100 dark:border-emerald-900/60 dark:bg-emerald-950/40 dark:text-emerald-300"
                    @onclick="SaveAsync">
                @ResourceApp.save
            </button>
            <button type="button"
                    class="inline-flex items-center rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
                    @onclick="MHD.Modal.Close">
                @ResourceApp.cancel
            </button>
        </div>
    </div>
</div>
@code {
    [Parameter, EditorRequired] public ProjectTaskListItemDto Task { get; set; } = default!;
    [Parameter, EditorRequired] public ResourceTaskIndexDto Resource { get; set; } = default!;
    TaskResourceDto? TaskResource;
    private void RemoveFormula(int i)
    {
        if (TaskResource is not null && i >= 0 && i < TaskResource.Formulas.Count)
            TaskResource.Formulas.RemoveAt(i);
    }
    void AddRole()
    {
        if (TaskResource?.CapRole is null)
            return;

        if (TaskResource.CapRole.Count != 0)
            TaskResource.CapRole.Add(new() { Min = TaskResource.CapRole.Last().Max, Max = TaskResource.CapRole.Last().Max + 10, Value = TaskResource.CapRole.Last().Value + 1 });
        else TaskResource.CapRole.Add(new() { Min = 0, Max = 10, Value = 5 });
        StateHasChanged();
    }
    protected override async Task OnInitializedAsync()
    {
        TaskResource = await TaskResourceService.GetTaskResourceAsync
        (Task.Id, Resource.ResourceId, CancellationToken.None) ?? new TaskResourceDto();
        TaskResource.CapRole ??= [];
        TaskResource.Formulas ??= [];
    }
    async Task SaveAsync()
    {
        if (TaskResource is null)
            return;

        if (await TaskResourceService.UpdateAssignmentAsync(Task.Id, Resource.ResourceId, TaskResource, CancellationToken.None))
        {
            MHD.Modal.Close();
        }
        else
        {
            MHD.MessageOk("Error", "There was an error saving the resource.", MhdState.Danger);
        }
    }

}
