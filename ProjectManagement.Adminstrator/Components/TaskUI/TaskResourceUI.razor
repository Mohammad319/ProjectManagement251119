    private void AddRole()
    {
        if (TaskResource?.CapRole is null)
            return;

        if (TaskResource.CapRole.Count != 0)
            TaskResource.CapRole.Add(new()
            {
                Min = TaskResource.CapRole.Last().Max,
                Max = TaskResource.CapRole.Last().Max + 10,
                Value = TaskResource.CapRole.Last().Value + 1
            });
        else
            TaskResource.CapRole.Add(new() { Min = 0, Max = 10, Value = 5 });

        StateHasChanged();
    }

    private void OnAddOnTypeChanged(int idx, ChangeEventArgs e)
    {
        if (TaskResource is null) return;
        if (int.TryParse(e.Value?.ToString(), out var val))
            TaskResource.AddOns[idx].Type = (QuantityResourceAddon)val;
    }

    private void AddParameter()
    {
        if (TaskResource is null) return;
        TaskResource.Parameters.Add(new ResourceParameter { Name = string.Empty, Unit = string.Empty, Value = 1 });
        StateHasChanged();
    }

    private void AddAddOn()
    {
        if (TaskResource is null) return;
        TaskResource.AddOns.Add(new ResourceAddon { Name = string.Empty, Factor = 1, Cost = 0, Type = QuantityResourceAddon.Multiplication });
        StateHasChanged();
    }

    private void AddTime()
    {
        if (TaskResource is null) return;
        var usedPct = TaskResource.Times.Sum(x => x.Percentage ?? 0m);
        var remaining = Math.Round(100m - usedPct, 4, MidpointRounding.AwayFromZero);
        TaskResource.Times.Add(new ResourceTime
        {
            Name = string.Empty,
            Unit = TaskResource.Unit,
            Percentage = remaining > 0m ? remaining : 0m,
            Cost = 1,
        }.SetResolvedQuantity(0));
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        TaskResource = await TaskResourceService.GetTaskResourceAsync(Task.Id, Resource.ResourceId, CancellationToken.None) ?? new TaskResourceDto();
        TaskResource.CapRole ??= [];
        SyncNumericInputs();
    }

    private async Task SaveAsync()
    {
        if (TaskResource is null)
        {
            return;
        }

        if (!TryParseDecimal(QuantityText, out var quantity) ||
            !TryParseNullableInt(MenuIdText, out var menuId) ||
            !TryParseDecimal(ChangeFactor1Text, out var changeFactor1) ||
            !TryParseDecimal(ChangeFactor2Text, out var changeFactor2) ||
            !TryParseDecimal(CapWasteText, out var capWaste) ||
            !TryParseNullableDecimal(BaseCostText, out var baseCost))
        {
            FormErrorMessage = "Please enter valid numeric values before saving.";
            return;
        }

        FormErrorMessage = null;
        TaskResource.Quantity = quantity;
        TaskResource.MenuId = menuId;
        TaskResource.ChangeFactor1 = changeFactor1;
        TaskResource.ChangeFactor2 = changeFactor2;
        TaskResource.CapWaste = capWaste;
        TaskResource.BaseCost = baseCost;

        if (await TaskResourceService.UpdateAssignmentAsync(Task.Id, Resource.ResourceId, TaskResource, CancellationToken.None))
        {
            await MHD.Modal.CloseAsync();
        }
        else
        {
            MHD.MessageOk("Error", "There was an error saving the resource.", MhdState.Danger);
        }
    }

    private void SyncNumericInputs()
    {
        if (TaskResource is null)
        {
            return;
        }

        QuantityText = FormatDecimal(TaskResource.Quantity);
        MenuIdText = TaskResource.MenuId?.ToString(CultureInfo.CurrentCulture) ?? string.Empty;
        ChangeFactor1Text = FormatDecimal(TaskResource.ChangeFactor1);
        ChangeFactor2Text = FormatDecimal(TaskResource.ChangeFactor2);
        CapWasteText = FormatDecimal(TaskResource.CapWaste);
        BaseCostText = FormatNullableDecimal(TaskResource.BaseCost);
    }

