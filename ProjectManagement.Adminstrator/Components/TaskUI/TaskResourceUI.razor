@inject ITaskDefinitionService TaskService
@inject ITaskResourceService TaskResourceService
@inherits AppComponentBase
@using Microsoft.Extensions.Localization
@using TaskResourceBlueprints.Dto.ProjectTask
@using TaskResourceBlueprints.Services.ProjectTask
@using ProjectManagement.Adminstrator.Components.ResourceUI
@using ProjectManagement.Shared.DTO.App.Dataloader
@using ProjectManagement.Shared.Enums
@using TaskResourceBlueprints.Services.Resource
@inject IStringLocalizer<CalcResource> L

<div class="space-y-1 p-1 text-slate-900 dark:text-slate-100">
    @if (TaskResource is null)
    {
        <div class="@SectionClass">
            <div class="space-y-1 px-1 py-1 animate-pulse">
                <div class="h-4 w-40 rounded bg-slate-200/80 dark:bg-slate-800/80"></div>
                <div class="h-9 w-full rounded-lg bg-slate-200/80 dark:bg-slate-800/80"></div>
                <div class="h-9 w-full rounded-lg bg-slate-200/80 dark:bg-slate-800/80"></div>
                <div class="h-9 w-2/3 rounded-lg bg-slate-200/80 dark:bg-slate-800/80"></div>
            </div>
            <span class="sr-only">Loading...</span>
        </div>
    }
    else
    {
        <section class="@SectionClass">
            <div class="@HeaderClass">
                <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">Task resource setup</h3>
            </div>

            <div class="@BodyClass">
                <div class="overflow-x-auto">
                    <div class="flex min-w-max flex-nowrap items-stretch gap-1">
                        <div class="shrink-0">
                            <span class="@BadgeClass">Task: @Task.DisplayName</span>
                        </div>

                        <div class="shrink-0">
                            <span class="@BadgeClass">Resource: @Resource.DisplayName</span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Resource.Unit))
                        {
                            <div class="shrink-0">
                                <span class="@BadgeMutedClass">@Resource.Unit</span>
                            </div>
                        }

                        <div class="@StatCardClass w-[140px] shrink-0">
                            <div class="@StatLabelClass">Roles</div>
                            <div class="@StatValueClass">@(TaskResource.CapRole?.Count ?? 0)</div>
                        </div>

                        <div class="@StatCardClass w-[140px] shrink-0">
                            <div class="@StatLabelClass">Formulas</div>
                            <div class="@StatValueClass">@(TaskResource.Formulas?.Count ?? 0)</div>
                        </div>

                        <div class="@StatCardClass w-[180px] shrink-0">
                            <div class="@StatLabelClass">Type</div>
                            <div class="@StatValueClass">@TaskResource.ResType</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="@SectionClass">
            <div class="@HeaderClass">
                <h4 class="text-sm font-semibold text-slate-900 dark:text-slate-100">Settings</h4>
            </div>

            <div class="@BodyClass">
                <div class="overflow-x-auto">
                    <div class="flex min-w-max flex-nowrap items-start gap-1">
                        <div class="w-[180px] shrink-0">
                            <label for="menu-id" class="@LabelClass">Menu Id</label>
                            <input id="menu-id"
                                   type="number"
                                   step="1"
                                   min="0"
                                   class="@InputClass"
                                   @bind-value="TaskResource.MenuId"
                                   @bind-value:event="oninput" />
                        </div>

                        <div class="w-[180px] shrink-0">
                            <label for="cf1" class="@LabelClass">@CalcResource.changeFactor1</label>
                            <input id="cf1"
                                   type="number"
                                   step="0.01"
                                   inputmode="decimal"
                                   min="0"
                                   class="@InputClass"
                                   @bind-value="TaskResource.ChangeFactor1"
                                   @bind-value:event="oninput" />
                        </div>

                        <div class="w-[180px] shrink-0">
                            <label for="cf2" class="@LabelClass">@CalcResource.changeFactor2</label>
                            <input id="cf2"
                                   type="number"
                                   step="0.01"
                                   inputmode="decimal"
                                   min="0"
                                   class="@InputClass"
                                   @bind-value="TaskResource.ChangeFactor2"
                                   @bind-value:event="oninput" />
                        </div>

                        <div class="w-[180px] shrink-0">
                            <label for="cap" class="@LabelClass">@(TaskResource.ResType == ResourceTypesEnum.Materials ? CalcResource.waste : CalcResource.cap)</label>
                            <input id="cap"
                                   type="number"
                                   step="0.01"
                                   inputmode="decimal"
                                   min="0"
                                   class="@InputClass"
                                   @bind-value="TaskResource.CapWaste"
                                   @bind-value:event="oninput" />
                        </div>

                        <div class="w-[180px] shrink-0">
                            <label for="baseCost" class="@LabelClass">@CalcResource.baseCost</label>
                            <input id="baseCost"
                                   type="number"
                                   step="0.01"
                                   inputmode="decimal"
                                   min="0"
                                   class="@InputClass"
                                   @bind-value="TaskResource.BaseCost"
                                   @bind-value:event="oninput" />
                        </div>
                    </div>
                </div>
            </div>
        </section>

        @if (TaskResource.ResType == ResourceTypesEnum.MachinesAndEquipments || TaskResource.ResType == ResourceTypesEnum.Worker)
        {
            <section class="@SectionClass">
                <div class="@HeaderClass">
                    <h4 class="text-sm font-semibold text-slate-900 dark:text-slate-100">Roles</h4>

                    <button type="button"
                            class="@SecondaryButtonClass"
                            @onclick="AddRole">
                        <span>+</span>
                        <span>Role</span>
                    </button>
                </div>

                <div class="@BodyClass">
                    @if (TaskResource.CapRole is not null && TaskResource.CapRole.Count > 0)
                    {
                        <div class="overflow-x-auto">
                            <div class="min-w-[760px] space-y-2">
                                <div class="grid grid-cols-[56px_1fr_1fr_1fr] gap-1 px-1 text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
                                    <div></div>
                                    <div>@AppControll.min</div>
                                    <div>@AppControll.max</div>
                                    <div>@CalcResource.cap</div>
                                </div>

                                @for (int i = 0; i < TaskResource.CapRole.Count; i++)
                                {
                                    var role = TaskResource.CapRole[i];

                                    <div class="rounded-xl border border-slate-200 bg-slate-50/80 p-2.5 dark:border-slate-800 dark:bg-slate-900/50">
                                        <div class="grid grid-cols-[56px_1fr_1fr_1fr] items-end gap-1">
                                            <div class="shrink-0">
                                                <button type="button"
                                                        title="@ResourceApp.delete"
                                                        class="inline-flex h-9 w-full items-center justify-center rounded-lg border border-rose-600 bg-rose-600 text-sm font-medium text-white transition hover:bg-rose-700 focus:outline-none focus:ring-2 focus:ring-rose-500/30 dark:border-rose-500 dark:bg-rose-500 dark:hover:bg-rose-400"
                                                        @onclick="@(() => TaskResource.CapRole.Remove(role))">
                                                    ×
                                                </button>
                                            </div>

                                            <div class="min-w-0">
                                                <input type="number"
                                                       step="1"
                                                       min="0"
                                                       class="@InputClass"
                                                       @bind-value="role.Min"
                                                       @bind-value:event="oninput"
                                                       aria-label="Min" />
                                            </div>

                                            <div class="min-w-0">
                                                <input type="number"
                                                       step="1"
                                                       min="0"
                                                       class="@InputClass"
                                                       @bind-value="role.Max"
                                                       @bind-value:event="oninput"
                                                       aria-label="Max" />
                                            </div>

                                            <div class="min-w-0">
                                                <input type="number"
                                                       step="0.01"
                                                       min="0"
                                                       class="@InputClass"
                                                       @bind-value="role.Value"
                                                       @bind-value:event="oninput"
                                                       aria-label="Cap" />
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="flex min-h-[96px] items-center justify-center rounded-xl border border-dashed border-slate-300 bg-slate-50/70 px-1 py-5 text-center text-sm text-slate-500 dark:border-slate-700 dark:bg-slate-900/40 dark:text-slate-400">
                            No roles
                        </div>
                    }
                </div>
            </section>
        }

        <section class="@SectionClass">
            <div class="@HeaderClass">
                <h4 class="text-sm font-semibold text-slate-900 dark:text-slate-100">@CalcResource.Formulas</h4>

                <button type="button"
                        class="@SecondaryButtonClass"
                        @onclick="@(() => TaskResource.Formulas.Add(string.Empty))">
                    <span>+</span>
                    <span>Add</span>
                </button>
            </div>

            <div class="@BodyClass">
                @if (TaskResource.Formulas is null || TaskResource.Formulas.Count == 0)
                {
                    <div class="flex min-h-[96px] items-center justify-center rounded-xl border border-dashed border-slate-300 bg-slate-50/70 px-1 py-5 text-center text-sm text-slate-500 dark:border-slate-700 dark:bg-slate-900/40 dark:text-slate-400">
                        No formulas
                    </div>
                }
                else
                {
                    <div class="space-y-1">
                        @foreach (var eq in TaskResource.Formulas.Select((value, index) => new { value, index }))
                        {
                            <div class="rounded-xl border border-slate-200 bg-slate-50/80 p-1 dark:border-slate-800 dark:bg-slate-900/50">
                                <div class="grid grid-cols-[minmax(0,1fr)_auto] items-end gap-1">
                                    <div class="min-w-0">
                                        <label class="@LabelClass">Formula @(eq.index + 1)</label>
                                        <input class="@InputClass"
                                               placeholder="Formula"
                                               value="@TaskResource.Formulas[eq.index]"
                                               @oninput="e => TaskResource.Formulas[eq.index] = e.Value?.ToString() ?? string.Empty" />
                                    </div>

                                    <div class="shrink-0">
                                        <button type="button"
                                                class="@DangerButtonClass"
                                                title="@ResourceApp.delete"
                                                @onclick="@(() => RemoveFormula(eq.index))">
                                            @ResourceApp.delete
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </section>
    }

    <div class="border-t border-slate-200 pt-1 dark:border-slate-800">
        <div class="flex flex-wrap items-center justify-end gap-1">
            <button type="button"
                    class="@PrimaryButtonClass"
                    @onclick="SaveAsync">
                @ResourceApp.save
            </button>

            <button type="button"
                    class="@NeutralButtonClass"
                    @onclick="MHD.Modal.Close">
                @ResourceApp.cancel
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ProjectTaskListItemDto Task { get; set; } = default!;
    [Parameter, EditorRequired] public ResourceTaskIndexDto Resource { get; set; } = default!;

    private TaskResourceDto? TaskResource;

    private const string SectionClass =
        "overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-950/80";

    private const string HeaderClass =
        "flex flex-wrap items-center justify-between gap-1 border-b border-slate-200 px-1 py-1 dark:border-slate-800";

    private const string BodyClass =
        "px-1 py-1 space-y-1";

    private const string LabelClass =
        "mb-1 block text-[11px] font-medium text-slate-700 dark:text-slate-300";

    private const string InputClass =
        "block h-9 w-full rounded-lg border border-slate-300 bg-white px-1.5 py-1 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500";

    private const string BadgeClass =
        "inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-1 py-1 text-[11px] font-medium text-slate-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200";

    private const string BadgeMutedClass =
        "inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-2 py-1 text-[11px] font-medium text-slate-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300";

    private const string StatCardClass =
        "rounded-xl border border-slate-200 bg-slate-50/70 p-2.5 dark:border-slate-800 dark:bg-slate-900/60";

    private const string StatLabelClass =
        "text-[10px] font-semibold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400";

    private const string StatValueClass =
        "mt-1 text-sm font-semibold text-slate-900 dark:text-slate-100";

    private const string PrimaryButtonClass =
        "inline-flex items-center justify-center gap-1 rounded-lg border border-sky-600 bg-sky-600 px-1 py-1 text-xs font-medium text-white transition hover:bg-sky-700 focus:outline-none focus:ring-2 focus:ring-sky-500/30 disabled:cursor-not-allowed disabled:opacity-60 dark:border-sky-500 dark:bg-sky-500 dark:hover:bg-sky-400";

    private const string NeutralButtonClass =
        "inline-flex items-center justify-center gap-1 rounded-lg border border-slate-300 bg-white px-1 py-1 text-xs font-medium text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-400/30 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800";

    private const string SecondaryButtonClass =
        "inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-medium text-slate-700 transition hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-slate-400/20 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:bg-slate-800/80 dark:text-slate-200 dark:hover:bg-slate-800";

    private const string DangerButtonClass =
        "inline-flex items-center justify-center gap-1 rounded-lg border border-rose-600 bg-rose-600 px-2.5 py-1 text-xs font-medium text-white transition hover:bg-rose-700 focus:outline-none focus:ring-2 focus:ring-rose-500/30 disabled:cursor-not-allowed disabled:opacity-60 dark:border-rose-500 dark:bg-rose-500 dark:hover:bg-rose-400";

    private void RemoveFormula(int i)
    {
        if (TaskResource is not null && i >= 0 && i < TaskResource.Formulas.Count)
        {
            TaskResource.Formulas.RemoveAt(i);
        }
    }

    private void AddRole()
    {
        if (TaskResource?.CapRole is null)
        {
            return;
        }

        if (TaskResource.CapRole.Count != 0)
        {
            TaskResource.CapRole.Add(new()
            {
                Min = TaskResource.CapRole.Last().Max,
                Max = TaskResource.CapRole.Last().Max + 10,
                Value = TaskResource.CapRole.Last().Value + 1
            });
        }
        else
        {
            TaskResource.CapRole.Add(new() { Min = 0, Max = 10, Value = 5 });
        }

        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        TaskResource = await TaskResourceService.GetTaskResourceAsync(Task.Id, Resource.ResourceId, CancellationToken.None) ?? new TaskResourceDto();
        TaskResource.CapRole ??= [];
        TaskResource.Formulas ??= [];
    }

    private async Task SaveAsync()
    {
        if (TaskResource is null)
        {
            return;
        }

        if (await TaskResourceService.UpdateAssignmentAsync(Task.Id, Resource.ResourceId, TaskResource, CancellationToken.None))
        {
            MHD.Modal.Close();
        }
        else
        {
            MHD.MessageOk("Error", "There was an error saving the resource.", MhdState.Danger);
        }
    }
}