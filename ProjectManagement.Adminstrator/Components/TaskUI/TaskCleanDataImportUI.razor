@using Microsoft.AspNetCore.Components.Forms
@using TaskResourceBlueprints.Services.Import
@using TaskResourceBlueprints.Services.Training
@inject ITaskNameCorpusImportService TaskNameCorpusImportService
@inject ICleanTaskResourceDatasetImportService CleanTaskResourceDatasetImportService
@inject ITaskResourceTrainingDatasetService TrainingDatasetService
@inject ITaskResourceMlTrainingService MlTrainingService

<div class="space-y-3 text-slate-900 dark:text-slate-100">
    <section class="rounded-2xl border border-slate-200 bg-white px-4 py-3 shadow-sm dark:border-slate-800 dark:bg-slate-950/80">
        <div class="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
            <div>
                <h2 class="mt-1 text-lg font-semibold tracking-tight">Clean training data</h2>
                <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
                    Analyze clean task files before importing them into TaskResourceBlueprints. One unified format can contain task rows only, or task rows with resource rows below them.
                </p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <label class="inline-flex cursor-pointer items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-medium text-slate-700 transition hover:bg-slate-50 focus-within:ring-2 focus-within:ring-sky-500/30 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800">
                    <span>Select file</span>
                    <InputFile class="sr-only" OnChange="OnFileSelected" accept=".txt,.csv,.tsv,.xlsx,.xlsm,.json,text/plain,text/csv,application/json" disabled="@isBusy" />
                </label>

                <button type="button"
                        class="inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-medium text-slate-700 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
                        disabled="@(selectedFile is null || isBusy)"
                        @onclick="AnalyzeAsync">
                    @(isAnalyzing ? "Analyzing..." : "Analyze")
                </button>

                <button type="button"
                        class="inline-flex items-center justify-center rounded-xl border border-emerald-600 bg-emerald-600 px-3 py-2 text-xs font-medium text-white transition hover:bg-emerald-700 disabled:cursor-not-allowed disabled:opacity-60 dark:border-emerald-500 dark:bg-emerald-500"
                        disabled="@(selectedFile is null || isBusy)"
                        @onclick="ImportAsync">
                    @(isImporting ? "Importing..." : "Import Clean Data")
                </button>

                <button type="button"
                        class="inline-flex items-center justify-center rounded-xl border border-violet-500 bg-violet-500 px-3 py-2 text-xs font-medium text-white transition hover:bg-violet-600 disabled:cursor-not-allowed disabled:opacity-60 dark:border-violet-400 dark:bg-violet-500/80"
                        disabled="@isBusy"
                        @onclick="AnalyzeTrainingDatasetAsync">
                    @(isBuildingTrainingSet ? "Checking..." : "Training Dataset")
                </button>

                <button type="button"
                        class="inline-flex items-center justify-center rounded-xl border border-indigo-600 bg-indigo-600 px-3 py-2 text-xs font-medium text-white transition hover:bg-indigo-700 disabled:cursor-not-allowed disabled:opacity-60 dark:border-indigo-500 dark:bg-indigo-500"
                        disabled="@isBusy"
                        @onclick="TrainMlModelAsync">
                    @(isTrainingMl ? "Training..." : "Train ML Model")
                </button>
            </div>
        </div>

        @if (trainingMessage is not null)
        {
            <p class="mt-2 text-xs font-medium text-indigo-700 dark:text-indigo-300">@trainingMessage</p>
        }
    </section>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="rounded-2xl border border-rose-200 bg-rose-50 px-3 py-2 text-sm text-rose-700 dark:border-rose-900/70 dark:bg-rose-950/50 dark:text-rose-300">
            @errorMessage
        </div>
    }

    <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-950/80">
        <div class="grid gap-3 md:grid-cols-4">
            @SummaryCard("File", selectedFile?.Name ?? "No file selected", selectedFile is not null)
            @SummaryCard("Accepted", ".txt .csv .tsv .xlsx .xlsm .json", true)
            @SummaryCard("Scope", "TaskResourceBlueprints", true)
            @SummaryCard("Mode", selectedFile is not null && IsPlainTextTaskNameFile(selectedFile.Name) ? "Task names only" : "Auto detect", true)
        </div>
    </section>

    @if (analysis is not null)
    {
        <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-950/80">
            <h3 class="text-sm font-semibold">Task-name file analysis</h3>
            <div class="mt-3 grid gap-2 sm:grid-cols-2 xl:grid-cols-4">
                @SummaryCard("Rows", analysis.TotalRows.ToString(), analysis.TotalRows > 0)
                @SummaryCard("Parsed", analysis.ParsedRows.ToString(), analysis.ParsedRows > 0)
                @SummaryCard("Unique Tasks", analysis.UniqueTasks.ToString(), analysis.UniqueTasks > 0)
                @SummaryCard("Duplicates", analysis.DuplicateRows.ToString(), analysis.DuplicateRows > 0, highlight: true)
                @SummaryCard("Skipped", analysis.SkippedRows.ToString(), analysis.SkippedRows > 0, highlight: true)
                @SummaryCard("Name Column", analysis.NameColumn, !string.IsNullOrWhiteSpace(analysis.NameColumn))
                @SummaryCard("Code Column", analysis.CodeColumn ?? "-", !string.IsNullOrWhiteSpace(analysis.CodeColumn))
                @SummaryCard("Unit Column", analysis.UnitColumn ?? "-", !string.IsNullOrWhiteSpace(analysis.UnitColumn))
            </div>
        </section>
    }

    @if (taskResourceAnalysis is not null)
    {
        <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-950/80">
            <h3 class="text-sm font-semibold">Clean data analysis</h3>
            <div class="mt-3 grid gap-2 sm:grid-cols-2 xl:grid-cols-4">
                @SummaryCard("Rows", taskResourceAnalysis.TotalRows.ToString(), taskResourceAnalysis.TotalRows > 0)
                @SummaryCard("Task Rows", taskResourceAnalysis.TaskRows.ToString(), taskResourceAnalysis.TaskRows > 0)
                @SummaryCard("Resource Rows", taskResourceAnalysis.ResourceRows.ToString(), taskResourceAnalysis.ResourceRows > 0)
                @SummaryCard("Unique Tasks", taskResourceAnalysis.UniqueTasks.ToString(), taskResourceAnalysis.UniqueTasks > 0)
                @SummaryCard("Unique Resources", taskResourceAnalysis.UniqueResources.ToString(), taskResourceAnalysis.UniqueResources > 0)
                @SummaryCard("Links", taskResourceAnalysis.Links.ToString(), taskResourceAnalysis.Links > 0)
                @SummaryCard("Duplicates", taskResourceAnalysis.DuplicateLinks.ToString(), taskResourceAnalysis.DuplicateLinks > 0, highlight: true)
                @SummaryCard("Skipped", taskResourceAnalysis.SkippedRows.ToString(), taskResourceAnalysis.SkippedRows > 0, highlight: true)
            </div>
        </section>
    }

    @if (importResult is not null)
    {
        <section class="rounded-2xl border border-emerald-200 bg-emerald-50 p-4 shadow-sm dark:border-emerald-900/60 dark:bg-emerald-950/30">
            <h3 class="text-sm font-semibold text-emerald-900 dark:text-emerald-100">Import result</h3>
            <div class="mt-3 grid gap-2 sm:grid-cols-2 xl:grid-cols-4">
                @SummaryCard("Created", importResult.CreatedTasks.ToString(), importResult.CreatedTasks > 0)
                @SummaryCard("Existing", importResult.ExistingTasks.ToString(), importResult.ExistingTasks > 0)
                @SummaryCard("Updated", importResult.UpdatedTasks.ToString(), importResult.UpdatedTasks > 0)
                @SummaryCard("Issues", importResult.Issues.Count.ToString(), importResult.Issues.Count > 0, highlight: true)
            </div>
        </section>
    }

    @if (taskResourceImportResult is not null)
    {
        <section class="rounded-2xl border border-emerald-200 bg-emerald-50 p-4 shadow-sm dark:border-emerald-900/60 dark:bg-emerald-950/30">
            <h3 class="text-sm font-semibold text-emerald-900 dark:text-emerald-100">Clean data import result</h3>
            <div class="mt-3 grid gap-2 sm:grid-cols-2 xl:grid-cols-4">
                @SummaryCard("Tasks", $"{taskResourceImportResult.CreatedTasks} created / {taskResourceImportResult.ExistingTasks} existing", taskResourceImportResult.CreatedTasks + taskResourceImportResult.ExistingTasks > 0)
                @SummaryCard("Resources", $"{taskResourceImportResult.CreatedResources} created / {taskResourceImportResult.ExistingResources} existing", taskResourceImportResult.CreatedResources + taskResourceImportResult.ExistingResources > 0)
                @SummaryCard("Folders", taskResourceImportResult.CreatedFolders.ToString(), taskResourceImportResult.CreatedFolders > 0)
                @SummaryCard("Assignments", $"{taskResourceImportResult.CreatedAssignments} created / {taskResourceImportResult.ExistingAssignments} existing", taskResourceImportResult.CreatedAssignments + taskResourceImportResult.ExistingAssignments > 0)
                @SummaryCard("Issues", taskResourceImportResult.Issues.Count.ToString(), taskResourceImportResult.Issues.Count > 0, highlight: true)
            </div>
        </section>
    }

    @if (trainingDataset is not null)
    {
        <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-950/80">
            <h3 class="text-sm font-semibold">Training dataset from existing task-resource links</h3>
            <div class="mt-3 grid gap-2 sm:grid-cols-2 xl:grid-cols-4">
                @SummaryCard("Tasks", trainingDataset.TaskCount.ToString(), trainingDataset.TaskCount > 0)
                @SummaryCard("Resources", trainingDataset.ResourceCount.ToString(), trainingDataset.ResourceCount > 0)
                @SummaryCard("Positive Examples", trainingDataset.PositiveExamples.ToString(), trainingDataset.PositiveExamples > 0)
                @SummaryCard("Negative Examples", trainingDataset.NegativeExamples.ToString(), trainingDataset.NegativeExamples > 0)
            </div>
        </section>
    }

    @if (mlTrainingResult is not null)
    {
        <section class="rounded-2xl border border-indigo-200 bg-indigo-50 p-4 shadow-sm dark:border-indigo-900/60 dark:bg-indigo-950/30">
            <h3 class="text-sm font-semibold text-indigo-900 dark:text-indigo-100">ML training summary</h3>
            <div class="mt-3 grid gap-2 sm:grid-cols-2 xl:grid-cols-4">
                @SummaryCard("Status", mlTrainingResult.Trained ? "Trained" : "Skipped", mlTrainingResult.Trained, highlight: !mlTrainingResult.Trained)
                @SummaryCard("Positive", mlTrainingResult.PositiveExamples.ToString(), mlTrainingResult.PositiveExamples > 0)
                @SummaryCard("Negative", mlTrainingResult.NegativeExamples.ToString(), mlTrainingResult.NegativeExamples > 0)
                @SummaryCard("Examples", mlTrainingResult.TotalExamples.ToString(), mlTrainingResult.TotalExamples > 0)
            </div>
            <p class="mt-2 break-all text-xs text-indigo-800 dark:text-indigo-200">@mlTrainingResult.ModelPath</p>
        </section>
    }

    @if ((analysis?.Issues.Count ?? 0) > 0 || (importResult?.Issues.Count ?? 0) > 0 || (taskResourceAnalysis?.Issues.Count ?? 0) > 0 || (taskResourceImportResult?.Issues.Count ?? 0) > 0)
    {
        var issues = taskResourceImportResult?.Issues.Cast<object>().ToList()
            ?? taskResourceAnalysis?.Issues.Cast<object>().ToList()
            ?? importResult?.Issues.Cast<object>().ToList()
            ?? analysis!.Issues.Cast<object>().ToList();

        <section class="rounded-2xl border border-amber-200 bg-amber-50 p-4 shadow-sm dark:border-amber-900/70 dark:bg-amber-950/30">
            <h3 class="text-sm font-semibold text-amber-900 dark:text-amber-100">Issues</h3>
            <div class="mt-2 max-h-80 overflow-auto rounded-xl border border-amber-200 bg-white dark:border-amber-900/60 dark:bg-slate-950">
                <table class="min-w-full divide-y divide-amber-100 text-sm dark:divide-amber-900/50">
                    <thead class="sticky top-0 bg-white dark:bg-slate-950">
                        <tr>
                            <th class="px-3 py-1.5 text-left text-[11px] font-semibold uppercase tracking-[0.12em] text-amber-800 dark:text-amber-200">Row</th>
                            <th class="px-3 py-1.5 text-left text-[11px] font-semibold uppercase tracking-[0.12em] text-amber-800 dark:text-amber-200">Message</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-amber-50 dark:divide-amber-900/30">
                        @foreach (var issue in issues.Take(100))
                        {
                            var rowNumber = GetIssueRow(issue);
                            var message = GetIssueMessage(issue);
                            <tr class="hover:bg-amber-50/50 dark:hover:bg-amber-900/10">
                                <td class="px-3 py-1.5 align-top font-mono text-xs text-amber-900 dark:text-amber-100">@rowNumber</td>
                                <td class="px-3 py-1.5 align-top text-amber-900 dark:text-amber-100">@message</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>

@code {
    private const long MaxFileSize = 100L * 1024L * 1024L;

    private IBrowserFile? selectedFile;
    private TaskNameCorpusImportAnalysis? analysis;
    private TaskNameCorpusImportResult? importResult;
    private CleanTaskResourceDatasetAnalysis? taskResourceAnalysis;
    private CleanTaskResourceDatasetImportResult? taskResourceImportResult;
    private TaskResourceTrainingDataset? trainingDataset;
    private TaskResourceMlTrainingResult? mlTrainingResult;
    private string? errorMessage;
    private string? trainingMessage;
    private bool isAnalyzing;
    private bool isImporting;
    private bool isBuildingTrainingSet;
    private bool isTrainingMl;

    private bool isBusy => isAnalyzing || isImporting || isBuildingTrainingSet || isTrainingMl;

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        analysis = null;
        importResult = null;
        taskResourceAnalysis = null;
        taskResourceImportResult = null;
        mlTrainingResult = null;
        errorMessage = null;
        trainingMessage = null;
    }

    private async Task AnalyzeAsync()
    {
        if (selectedFile is null) return;

        try
        {
            isAnalyzing = true;
            errorMessage = null;
            importResult = null;
            taskResourceImportResult = null;
            mlTrainingResult = null;
            trainingMessage = null;

            await using var buffer = await ReadSelectedFileAsync();
            if (IsPlainTextTaskNameFile(selectedFile.Name))
            {
                taskResourceAnalysis = null;
                analysis = await TaskNameCorpusImportService.AnalyzeAsync(buffer, selectedFile.Name, CancellationToken.None);
            }
            else
            {
                analysis = null;
                taskResourceAnalysis = await CleanTaskResourceDatasetImportService.AnalyzeAsync(buffer, selectedFile.Name, CancellationToken.None);
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isAnalyzing = false;
        }
    }

    private async Task ImportAsync()
    {
        if (selectedFile is null) return;

        try
        {
            isImporting = true;
            errorMessage = null;
            mlTrainingResult = null;
            trainingMessage = null;

            await using var buffer = await ReadSelectedFileAsync();
            if (IsPlainTextTaskNameFile(selectedFile.Name))
            {
                taskResourceImportResult = null;
                taskResourceAnalysis = null;
                importResult = await TaskNameCorpusImportService.ImportAsync(buffer, selectedFile.Name, updateExistingTasks: false, CancellationToken.None);
                analysis = importResult;
            }
            else
            {
                importResult = null;
                analysis = null;
                taskResourceImportResult = await CleanTaskResourceDatasetImportService.ImportAsync(buffer, selectedFile.Name, updateExisting: false, CancellationToken.None);
                taskResourceAnalysis = taskResourceImportResult;
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isImporting = false;
        }
    }

    private async Task AnalyzeTrainingDatasetAsync()
    {
        try
        {
            isBuildingTrainingSet = true;
            errorMessage = null;
            trainingMessage = null;

            trainingDataset = await TrainingDatasetService.BuildAsync(ct: CancellationToken.None);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isBuildingTrainingSet = false;
        }
    }

    private async Task TrainMlModelAsync()
    {
        try
        {
            isTrainingMl = true;
            errorMessage = null;
            trainingMessage = null;

            mlTrainingResult = await MlTrainingService.TrainAsync(ct: CancellationToken.None);
            trainingMessage = mlTrainingResult.Message;
        }
        catch (Exception ex)
        {
            errorMessage = $"ML training failed: {ex.Message}";
        }
        finally
        {
            isTrainingMl = false;
        }
    }

    private async Task<MemoryStream> ReadSelectedFileAsync()
    {
        if (selectedFile is null)
            throw new InvalidOperationException("No file selected.");

        await using var source = selectedFile.OpenReadStream(MaxFileSize);
        var buffer = new MemoryStream();
        await source.CopyToAsync(buffer);
        buffer.Position = 0;
        return buffer;
    }

    private static int GetIssueRow(object issue)
        => issue switch
        {
            TaskNameCorpusImportIssue taskIssue => taskIssue.RowNumber,
            CleanTaskResourceDatasetIssue datasetIssue => datasetIssue.RowNumber,
            _ => 0
        };

    private static string GetIssueMessage(object issue)
        => issue switch
        {
            TaskNameCorpusImportIssue taskIssue => taskIssue.Message,
            CleanTaskResourceDatasetIssue datasetIssue => datasetIssue.Message,
            _ => issue.ToString() ?? string.Empty
        };

    private static bool IsPlainTextTaskNameFile(string fileName)
        => fileName.EndsWith(".txt", StringComparison.OrdinalIgnoreCase);

    private static RenderFragment SummaryCard(string label, string value, bool active = false, bool highlight = false) =>
        @<div class="@($"rounded-xl border p-3 {(highlight && active ? "border-amber-300 bg-amber-50 dark:border-amber-800 dark:bg-amber-950/30" : active ? "border-emerald-200 bg-emerald-50 dark:border-emerald-900/60 dark:bg-emerald-950/20" : "border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-900/70")}")">
            <div class="text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">@label</div>
            <div class="mt-1 truncate text-sm font-semibold @(highlight && active ? "text-amber-800 dark:text-amber-200" : "text-slate-900 dark:text-slate-100")">@value</div>
        </div>;
}
