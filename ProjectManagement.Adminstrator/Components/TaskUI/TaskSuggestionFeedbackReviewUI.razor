@using System.Globalization
@using Microsoft.JSInterop
@using ProjectManagement.Shared.DTO.Calculation
@using TaskResourceBlueprints.Services.Evaluation
@using TaskResourceBlueprints.Services.Feedback
@using TaskResourceBlueprints.Services.Training
@inject ITaskResourceSuggestionEvaluationService EvaluationService
@inject ITaskResourceSuggestionFeedbackReviewService FeedbackReviewService
@inject ITaskResourceMlTrainingService MlTrainingService
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="space-y-3 text-slate-900 dark:text-slate-100">
    <section class="rounded-2xl border border-slate-200 bg-white px-4 py-3 shadow-sm dark:border-slate-800 dark:bg-slate-950/80">
        <div class="flex flex-col gap-3 xl:flex-row xl:items-end xl:justify-between">
            <div>
                <h2 class="mt-1 text-lg font-semibold tracking-tight">Suggestion feedback review</h2>
                <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
                    Review Good/Bad/Unit/Missing/Type decisions before training the ML model.
                </p>
            </div>

            <div class="flex flex-wrap items-end gap-2">
                <label class="grid gap-1 text-xs font-medium text-slate-600 dark:text-slate-300">
                    <span>Feedback</span>
                    <select value="@_selectedFeedbackValue"
                            @onchange="OnFeedbackFilterChanged"
                            class="w-36 rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 focus:border-sky-500 focus:outline-none dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100">
                        <option value="">All</option>
                        @foreach (var kind in Enum.GetValues<TaskResourceSuggestionFeedbackKind>())
                        {
                            <option value="@kind.ToString()">@Label(kind)</option>
                        }
                    </select>
                </label>

                <label class="grid gap-1 text-xs font-medium text-slate-600 dark:text-slate-300">
                    <span>Source</span>
                    <select value="@_selectedSourceValue"
                            @onchange="OnSourceFilterChanged"
                            class="w-36 rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 focus:border-sky-500 focus:outline-none dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100">
                        <option value="">All</option>
                        @foreach (var src in Enum.GetValues<TaskResourceSuggestionSource>())
                        {
                            <option value="@src.ToString()">@SourceLabel(src)</option>
                        }
                    </select>
                </label>

                <label class="grid gap-1 text-xs font-medium text-slate-600 dark:text-slate-300">
                    <span>Search task</span>
                    <input type="text"
                           value="@_search"
                           @oninput="OnSearchInput"
                           placeholder="Name or code…"
                           class="w-44 rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 focus:border-sky-500 focus:outline-none dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100" />
                </label>

                <button type="button"
                        class="inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-medium text-slate-700 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:hover:bg-slate-800"
                        disabled="@_isBusy"
                        @onclick="ReloadAsync">
                    @(_isLoading ? "Loading..." : "Refresh")
                </button>

                <button type="button"
                        class="inline-flex items-center justify-center rounded-xl border border-indigo-600 bg-indigo-600 px-3 py-2 text-xs font-medium text-white transition hover:bg-indigo-700 disabled:cursor-not-allowed disabled:opacity-60 dark:border-indigo-500 dark:bg-indigo-500"
                        disabled="@_isBusy"
                        @onclick="TrainMlNowAsync">
                    @(_isTraining ? "Training..." : "Train ML Now")
                </button>

                <button type="button"
                        class="inline-flex items-center justify-center rounded-xl border border-emerald-600 bg-emerald-600 px-3 py-2 text-xs font-medium text-white transition hover:bg-emerald-700 disabled:cursor-not-allowed disabled:opacity-60 dark:border-emerald-500 dark:bg-emerald-500"
                        disabled="@_isBusy"
                        @onclick="RunQualityReportAsync">
                    @(_isEvaluating ? "Checking..." : "Quality Report")
                </button>
            </div>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="@MessageClass">@_message</div>
    }

    @if (_trainingResult is not null)
    {
        <section class="rounded-2xl border border-emerald-200 bg-emerald-50 p-4 shadow-sm dark:border-emerald-900/60 dark:bg-emerald-950/30">
            <h3 class="text-sm font-semibold">ML training summary</h3>
            <div class="mt-3 grid gap-2 sm:grid-cols-2 xl:grid-cols-4">
                @SummaryCard("Status", _trainingResult.Trained ? "Trained" : "Skipped", _trainingResult.Trained, highlight: !_trainingResult.Trained)
                @SummaryCard("Positive", _trainingResult.PositiveExamples.ToString(CultureInfo.InvariantCulture), _trainingResult.PositiveExamples > 0)
                @SummaryCard("Negative", _trainingResult.NegativeExamples.ToString(CultureInfo.InvariantCulture), _trainingResult.NegativeExamples > 0)
                @SummaryCard("Examples", _trainingResult.TotalExamples.ToString(CultureInfo.InvariantCulture), _trainingResult.TotalExamples > 0)
            </div>
            @if (!string.IsNullOrWhiteSpace(_trainingResult.ModelPath))
            {
                <p class="mt-2 break-all text-xs text-emerald-800 dark:text-emerald-200">@_trainingResult.ModelPath</p>
            }
        </section>
    }

    @if (_qualityResult is not null)
    {
        <section class="rounded-2xl border border-sky-200 bg-sky-50 p-4 shadow-sm dark:border-sky-900/60 dark:bg-sky-950/30">
            <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
                <h3 class="text-sm font-semibold">Quality report after training</h3>
                <span class="text-xs text-sky-800 dark:text-sky-200">Sample @_qualityResult.EvaluatedTasks of @_qualityResult.EligibleTasks · Top @_qualityResult.TopK</span>
            </div>
            <div class="mt-3 grid gap-2 sm:grid-cols-2 xl:grid-cols-4">
                @SummaryCard("Top 1 hit", FormatPercent(_qualityResult.Top1HitRate), _qualityResult.Top1HitRate >= 0.50d, highlight: _qualityResult.Top1HitRate < 0.50d)
                @SummaryCard($"Top {_qualityResult.TopK} hit", FormatPercent(_qualityResult.TopKHitRate), _qualityResult.TopKHitRate >= 0.70d, highlight: _qualityResult.TopKHitRate < 0.70d)
                @SummaryCard("Unit match", FormatPercent(_qualityResult.UnitMatchRate), _qualityResult.UnitMatchRate >= 0.75d, highlight: _qualityResult.UnitMatchRate < 0.75d)
                @SummaryCard("Type match", FormatPercent(_qualityResult.TypeMatchRate), _qualityResult.TypeMatchRate >= 0.85d, highlight: _qualityResult.TypeMatchRate < 0.85d)
                @SummaryCard("Avg top 1 overlap", FormatPercent(_qualityResult.AverageTop1ResourceOverlap), _qualityResult.AverageTop1ResourceOverlap >= 0.25d)
                @SummaryCard($"Avg best top {_qualityResult.TopK}", FormatPercent(_qualityResult.AverageBestTopKResourceOverlap), _qualityResult.AverageBestTopKResourceOverlap >= 0.35d)
                @SummaryCard("Top 1 hits", _qualityResult.Top1Hits.ToString(CultureInfo.InvariantCulture), _qualityResult.Top1Hits > 0)
                @SummaryCard($"Top {_qualityResult.TopK} hits", _qualityResult.TopKHits.ToString(CultureInfo.InvariantCulture), _qualityResult.TopKHits > 0)
            </div>
        </section>
    }

    @if (_initialized)
    {
        <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-950/80">
            <h3 class="text-sm font-semibold">Feedback summary</h3>
            <div class="mt-3 grid gap-2 sm:grid-cols-2 xl:grid-cols-6">
                @SummaryCard("Total", _grandTotal.ToString(CultureInfo.InvariantCulture), _grandTotal > 0)
                @foreach (var kind in Enum.GetValues<TaskResourceSuggestionFeedbackKind>())
                {
                    var count = _countsByFeedback.GetValueOrDefault(kind);
                    @SummaryCard(Label(kind), count.ToString(CultureInfo.InvariantCulture), count > 0, highlight: kind != TaskResourceSuggestionFeedbackKind.Accepted && count > 0)
                }
            </div>
        </section>

        <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-950/80">
            <div class="flex items-center justify-between gap-3">
                <h3 class="text-sm font-semibold">Feedback rows</h3>
                <span class="text-xs text-slate-500">
                    @if (_isLoading)
                    {
                        <span>Loading…</span>
                    }
                    else
                    {
                        <span>Showing @_items.Count of @_filteredTotal</span>
                    }
                </span>
            </div>

            <div id="feedback-scroll-container" class="mt-3 max-h-[42rem] overflow-auto rounded-xl border border-slate-200 dark:border-slate-800">
                <table class="min-w-full divide-y divide-slate-100 text-sm dark:divide-slate-800">
                    <thead class="sticky top-0 bg-white dark:bg-slate-950">
                        <tr>
                            <th class="px-3 py-1.5 text-left text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500">Feedback</th>
                            <th class="px-3 py-1.5 text-left text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500">Target task</th>
                            <th class="px-3 py-1.5 text-left text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500">Suggested task</th>
                            <th class="px-3 py-1.5 text-right text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500">Score</th>
                            <th class="px-3 py-1.5 text-left text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500">Updated</th>
                            <th class="px-3 py-1.5 text-right text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                        @foreach (var item in _items)
                        {
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-900" @key="item.Id">
                                <td class="px-3 py-2 align-top">
                                    @FeedbackPill(item.Feedback)
                                    <div class="mt-1 text-[10px] text-slate-400">@SourceLabel(item.Source)</div>
                                </td>
                                <td class="px-3 py-2 align-top">
                                    <div class="font-medium text-slate-900 dark:text-slate-100">@item.TargetTaskName</div>
                                    <div class="mt-0.5 text-xs text-slate-500">@item.TargetTaskCode @FormatQuantityUnit(item.TargetTaskQuantity, item.TargetTaskUnit) · tenant @item.TenantId</div>
                                </td>
                                <td class="px-3 py-2 align-top">
                                    <div class="font-medium text-slate-800 dark:text-slate-200">@item.SourceTaskName</div>
                                    <div class="mt-0.5 text-xs text-slate-500">@item.Source @FormatQuantityUnit(item.SourceTaskQuantity, item.SourceTaskUnit)</div>
                                    @if (!string.IsNullOrWhiteSpace(item.Reason))
                                    {
                                        <div class="mt-1 max-w-xl text-xs text-slate-500">@item.Reason</div>
                                    }
                                </td>
                                <td class="px-3 py-2 text-right font-mono text-xs">@FormatPercent(item.Score)</td>
                                <td class="px-3 py-2 text-xs text-slate-500">@FormatDate(item.UpdatedAtUtc)</td>
                                <td class="px-3 py-2 text-right">
                                    <button type="button"
                                            class="rounded-lg border border-rose-300 px-2 py-1 text-xs font-medium text-rose-700 transition hover:bg-rose-50 disabled:cursor-not-allowed disabled:opacity-60 dark:border-rose-800 dark:text-rose-300 dark:hover:bg-rose-950/50"
                                            disabled="@_isBusy"
                                            @onclick="() => DeleteAsync(item.Id)">
                                        Delete
                                    </button>
                                </td>
                            </tr>
                        }
                        @if (_items.Count == 0 && !_isLoading)
                        {
                            <tr>
                                <td colspan="6" class="px-3 py-8 text-center text-sm text-slate-500">No feedback rows match the current filters.</td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (_loadingMore)
                {
                    <div class="flex justify-center py-3">
                        <MhdLoading />
                    </div>
                }
                else if (_hasMore)
                {
                    <div id="feedback-scroll-sentinel" class="h-2 w-full"></div>
                }
            </div>
        </section>
    }
</div>

@code {
    private const int PageSize = 100;
    private const string ContainerId = "feedback-scroll-container";
    private const string SentinelId = "feedback-scroll-sentinel";

    private DotNetObjectReference<TaskSuggestionFeedbackReviewUI>? _selfRef;
    private bool _observerAttached;

    private readonly List<TaskResourceSuggestionFeedbackReviewItem> _items = [];
    private int _grandTotal;
    private int _filteredTotal;
    private Dictionary<TaskResourceSuggestionFeedbackKind, int> _countsByFeedback = [];

    private TaskResourceMlTrainingResult? _trainingResult;
    private TaskResourceSuggestionEvaluationResult? _qualityResult;

    private TaskResourceSuggestionFeedbackKind? _selectedFeedback;
    private string _selectedFeedbackValue = string.Empty;
    private TaskResourceSuggestionSource? _selectedSource;
    private string _selectedSourceValue = string.Empty;
    private string _search = string.Empty;
    private CancellationTokenSource? _searchCts;

    private string? _message;
    private bool _hasError;
    private bool _isLoading;
    private bool _loadingMore;
    private bool _hasMore;
    private bool _isDeleting;
    private bool _isTraining;
    private bool _isEvaluating;
    private bool _initialized;
    private bool _isBusy => _isLoading || _loadingMore || _isDeleting || _isTraining || _isEvaluating;

    private string MessageClass => _hasError
        ? "rounded-2xl border border-rose-200 bg-rose-50 px-3 py-2 text-sm text-rose-700 dark:border-rose-900/70 dark:bg-rose-950/50 dark:text-rose-300"
        : "rounded-2xl border border-emerald-200 bg-emerald-50 px-3 py-2 text-sm text-emerald-700 dark:border-emerald-900/70 dark:bg-emerald-950/50 dark:text-emerald-300";

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _isLoading = true;
        _hasError = false;
        _message = null;
        _items.Clear();
        _hasMore = false;
        _observerAttached = false;
        try { await JS.InvokeVoidAsync("unobserveIntersection", SentinelId); } catch { }

        try
        {
            var batch = await FeedbackReviewService.GetAsync(
                _selectedFeedback, _selectedSource, _search, skip: 0, take: PageSize, CancellationToken.None);

            _grandTotal = batch.Total;
            _filteredTotal = batch.FilteredTotal;
            _countsByFeedback = batch.CountsByFeedback;
            _items.AddRange(batch.Items);
            _hasMore = batch.Items.Count == PageSize;
            _initialized = true;
        }
        catch (Exception ex)
        {
            _hasError = true;
            _message = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadMoreAsync()
    {
        if (_loadingMore || !_hasMore) return;
        _loadingMore = true;
        try
        {
            var batch = await FeedbackReviewService.GetAsync(
                _selectedFeedback, _selectedSource, _search, skip: _items.Count, take: PageSize, CancellationToken.None);

            _items.AddRange(batch.Items);
            _filteredTotal = batch.FilteredTotal;
            _hasMore = batch.Items.Count == PageSize;
        }
        catch (Exception ex)
        {
            _hasError = true;
            _message = ex.Message;
        }
        finally
        {
            _loadingMore = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var shouldObserve = _hasMore && !_isLoading && !_loadingMore;
        if (shouldObserve && !_observerAttached)
        {
            _selfRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("observeIntersection", _selfRef, SentinelId, ContainerId);
            _observerAttached = true;
        }
        else if (!shouldObserve && _observerAttached)
        {
            await JS.InvokeVoidAsync("unobserveIntersection", SentinelId);
            _observerAttached = false;
        }
    }

    [JSInvokable]
    public async Task OnScrolledToBottom()
    {
        if (_loadingMore || !_hasMore || _isLoading) return;
        _observerAttached = false;
        try { await JS.InvokeVoidAsync("unobserveIntersection", SentinelId); } catch { }
        await InvokeAsync(async () =>
        {
            await LoadMoreAsync();
            StateHasChanged();
        });
    }

    public async ValueTask DisposeAsync()
    {
        if (_observerAttached)
        {
            try { await JS.InvokeVoidAsync("unobserveIntersection", SentinelId); } catch { }
        }
        _selfRef?.Dispose();
        _searchCts?.Dispose();
    }

    private async Task OnFeedbackFilterChanged(ChangeEventArgs e)
    {
        _selectedFeedbackValue = e.Value?.ToString() ?? string.Empty;
        _selectedFeedback = Enum.TryParse<TaskResourceSuggestionFeedbackKind>(_selectedFeedbackValue, out var parsed) ? parsed : null;
        await ReloadAsync();
    }

    private async Task OnSourceFilterChanged(ChangeEventArgs e)
    {
        _selectedSourceValue = e.Value?.ToString() ?? string.Empty;
        _selectedSource = Enum.TryParse<TaskResourceSuggestionSource>(_selectedSourceValue, out var parsed) ? parsed : null;
        await ReloadAsync();
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? string.Empty;
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;
        try
        {
            await Task.Delay(400, token);
            if (!token.IsCancellationRequested)
                await ReloadAsync();
        }
        catch (TaskCanceledException) { }
    }

    private async Task TrainMlNowAsync()
    {
        try
        {
            _isTraining = true;
            _hasError = false;
            _message = null;
            _trainingResult = await MlTrainingService.TrainAsync(ct: CancellationToken.None);
            _message = _trainingResult.Message;
            _qualityResult = _trainingResult.Trained
                ? await EvaluationService.EvaluateAsync(sampleSize: 100, topK: 5, ct: CancellationToken.None)
                : null;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _hasError = true;
            _message = ex.Message;
        }
        finally
        {
            _isTraining = false;
        }
    }

    private async Task RunQualityReportAsync()
    {
        try
        {
            _isEvaluating = true;
            _hasError = false;
            _message = null;
            _qualityResult = await EvaluationService.EvaluateAsync(sampleSize: 100, topK: 5, ct: CancellationToken.None);
            _message = $"Quality report completed for {_qualityResult.EvaluatedTasks} evaluated tasks.";
        }
        catch (Exception ex)
        {
            _hasError = true;
            _message = ex.Message;
        }
        finally
        {
            _isEvaluating = false;
        }
    }

    private async Task DeleteAsync(int id)
    {
        try
        {
            _isDeleting = true;
            _hasError = false;
            _message = null;
            var deleted = await FeedbackReviewService.DeleteAsync(id, CancellationToken.None);
            if (deleted)
            {
                _items.RemoveAll(x => x.Id == id);
                _grandTotal = Math.Max(0, _grandTotal - 1);
                _filteredTotal = Math.Max(0, _filteredTotal - 1);
                _message = "Feedback row deleted.";
                StateHasChanged();
            }
            else
            {
                _message = "Feedback row was not found.";
            }
        }
        catch (Exception ex)
        {
            _hasError = true;
            _message = ex.Message;
        }
        finally
        {
            _isDeleting = false;
        }
    }

    private static string Label(TaskResourceSuggestionFeedbackKind kind) => kind switch
    {
        TaskResourceSuggestionFeedbackKind.Accepted => "Good",
        TaskResourceSuggestionFeedbackKind.Rejected => "Bad",
        TaskResourceSuggestionFeedbackKind.WrongUnit => "Unit",
        TaskResourceSuggestionFeedbackKind.MissingResources => "Missing",
        TaskResourceSuggestionFeedbackKind.WrongResourceType => "Type",
        _ => kind.ToString()
    };

    private static string SourceLabel(TaskResourceSuggestionSource source) => source switch
    {
        TaskResourceSuggestionSource.TenantTask => "Tenant",
        TaskResourceSuggestionSource.BlueprintTask => "Blueprint",
        _ => source.ToString()
    };

    private static string FormatPercent(double value) => value.ToString("0%", CultureInfo.InvariantCulture);

    private static string FormatDate(DateTime value) => value.ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);

    private static string FormatQuantityUnit(decimal? quantity, string? unit)
    {
        var parts = new List<string>();
        if (quantity.HasValue)
            parts.Add(quantity.Value.ToString("0.###", CultureInfo.InvariantCulture));
        if (!string.IsNullOrWhiteSpace(unit))
            parts.Add(unit.Trim());
        return parts.Count == 0 ? string.Empty : string.Join(' ', parts);
    }

    private static RenderFragment FeedbackPill(TaskResourceSuggestionFeedbackKind kind) => builder =>
    {
        var cls = kind switch
        {
            TaskResourceSuggestionFeedbackKind.Accepted => "bg-emerald-50 text-emerald-700 ring-emerald-200 dark:bg-emerald-950/40 dark:text-emerald-300 dark:ring-emerald-800",
            TaskResourceSuggestionFeedbackKind.Rejected => "bg-rose-50 text-rose-700 ring-rose-200 dark:bg-rose-950/40 dark:text-rose-300 dark:ring-rose-800",
            TaskResourceSuggestionFeedbackKind.WrongUnit => "bg-amber-50 text-amber-700 ring-amber-200 dark:bg-amber-950/40 dark:text-amber-300 dark:ring-amber-800",
            TaskResourceSuggestionFeedbackKind.MissingResources => "bg-sky-50 text-sky-700 ring-sky-200 dark:bg-sky-950/40 dark:text-sky-300 dark:ring-sky-800",
            TaskResourceSuggestionFeedbackKind.WrongResourceType => "bg-violet-50 text-violet-700 ring-violet-200 dark:bg-violet-950/40 dark:text-violet-300 dark:ring-violet-800",
            _ => "bg-slate-50 text-slate-700 ring-slate-200 dark:bg-slate-900 dark:text-slate-300 dark:ring-slate-700"
        };
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", $"rounded-full px-2 py-0.5 text-xs font-semibold ring-1 {cls}");
        builder.AddContent(2, Label(kind));
        builder.CloseElement();
    };

    private static RenderFragment SummaryCard(string title, string value, bool ok, bool highlight = false) => builder =>
    {
        var border = highlight
            ? "border-amber-300 bg-amber-50 dark:border-amber-800 dark:bg-amber-950/30"
            : ok
                ? "border-emerald-200 bg-emerald-50 dark:border-emerald-900/60 dark:bg-emerald-950/30"
                : "border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-900";
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", $"rounded-xl border px-3 py-2 {border}");
        builder.OpenElement(2, "div");
        builder.AddAttribute(3, "class", "text-[11px] font-bold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400");
        builder.AddContent(4, title);
        builder.CloseElement();
        builder.OpenElement(5, "div");
        builder.AddAttribute(6, "class", "mt-1 text-base font-semibold text-slate-950 dark:text-slate-50");
        builder.AddContent(7, value);
        builder.CloseElement();
        builder.CloseElement();
    };
}
