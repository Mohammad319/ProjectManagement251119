@using Microsoft.EntityFrameworkCore
@using TaskResourceBlueprints.Entities
@using TaskResourceBlueprints.Entities.Questions.Assignments
@using TaskResourceBlueprints.Entities.Resources
@using TaskResourceBlueprints.Entities.Tasks
@using TaskResourceBlueprints.Infrastructure
@using TaskResourceBlueprints.Services.Resource
@using ProjectManagement.Adminstrator.Components.ResourceUI
@using ProjectManagement.Adminstrator.Helper
@using ProjectManagement.Shared.DTO.App.TasksResource
@inject ITaskResourceService TaskResourceService
@inject MhdServices MHD
@using CsS = ProjectManagement.Shared.Constant.CssClasses

<ResourcesBrowser EnableFolderContext="false" Folders="folders">
    <RowActions Context="r">
        @if (TaskResourceLink.Any(x => x.TaskId == TaskPM.Id && x.ResourceId == r.Id))
                                {
            <button class="@CsS.Btn.Outline.Danger" title="@ResourceApp.delete"
                                            @onclick="async () => await OnCheckboxChanged(r.Id)">➖</button>
                                }
                                else
                                {
            <button class="@CsS.Btn.Outline.Success" title="@ResourceApp.newItem"
                                            @onclick="async () => await OnCheckboxChanged(r.Id)">➕</button>
        }
    </RowActions>
</ResourcesBrowser>

@code {
    public sealed class TaskResourceLinkDto
    {
        public int TaskId { get; init; }
        public int ResourceId { get; init; }
    }
    async Task OnCheckboxChanged( int resId)
    {
        if (!TaskResourceLink.Any(x => x.TaskId == TaskPM.Id && x.ResourceId == resId))
        {
            await TaskResourceService.AddAssignmentAsync(new TaskResourceAssignment() { TaskId = TaskPM.Id, ResourceId = resId });
            TaskResourceLink.Add(new TaskResourceLinkDto() { TaskId = TaskPM.Id, ResourceId = resId });
        }
        else
        {
            await TaskResourceService.RemoveResourceFromTaskAsync(TaskPM.Id, resId);
            TaskResourceLink.RemoveAll(x => x.TaskId == TaskPM.Id && x.ResourceId == resId);
        }
        StateHasChanged();
    }

    [Parameter] public TaskDefinition TaskPM { get; set; }
    [Parameter] public List<ResourceCategory> folders  { get; set;}
    [Parameter] public List<TaskResourceLinkDto> TaskResourceLink { get; set; }

}
