@using TaskResourceBlueprints.Dto.ProjectTask
@using TaskResourceBlueprints.Services.ProjectTask
@using TaskResourceBlueprints.Services.Resource
@using ProjectManagement.Adminstrator.Constants
@using ProjectManagement.Adminstrator.Services.MHDBlazor
@using Microsoft.JSInterop
@attribute [Authorize(Roles = PMRolesConst.APP.AdminManger)]
@inject ITaskDefinitionQueryService TaskQueries
@inject ITaskDefinitionService TaskCommands
@inject ITaskResourceService FoldersService
@inject IJSRuntime JS
@inject MhdServices MHD
@implements IAsyncDisposable

<div class="space-y-3 text-slate-900 dark:text-slate-100">
    <section class="rounded-2xl border border-slate-200 bg-white px-4 py-3 shadow-sm dark:border-slate-800 dark:bg-slate-950/80">
        <div class="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
            <div>
                <h2 class="mt-1 text-lg font-semibold tracking-tight text-slate-900 dark:text-slate-100">Task &amp; question blueprint library</h2>
                <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">Manage task definitions, task conditions, question groups, and assigned resource blueprints from one table.</p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
           
                <button @onclick="() => OpenEditor(0)" class="inline-flex items-center justify-center gap-2 rounded-xl px-1 py-1 text-xs font-medium transition focus:outline-none focus:ring-2 disabled:cursor-not-allowed disabled:opacity-60 inline-flex items-center justify-center gap-2 rounded-xl border border-sky-600 bg-sky-600 px-1 py-1 text-xs font-medium text-white transition hover:bg-sky-700 focus:outline-none focus:ring-2 focus:ring-sky-500/30 disabled:cursor-not-allowed disabled:opacity-60 dark:border-sky-500 dark:bg-sky-500 dark:hover:bg-sky-400">
                    @((MarkupString)Icons.Plus)
                    <span>@ResourceApp.newItem</span>
                </button>
            </div>
        </div>
    </section>

    @if (infoMessage is not null)
    {
        <div class="rounded-2xl border border-sky-200 bg-sky-50 px-1 py-1 text-sm text-sky-700 dark:border-sky-900/60 dark:bg-sky-950/40 dark:text-sky-200">@infoMessage</div>
    }
    else if (errorMessage is not null)
    {
        <div class="rounded-2xl border border-rose-200 bg-rose-50 px-1 py-1 text-sm text-rose-700 dark:border-rose-900/70 dark:bg-rose-950/50 dark:text-rose-300">@errorMessage</div>
    }
    else if (tasks is null)
    {
        <div class="flex min-h-[180px] flex-col items-center justify-center rounded-2xl border border-dashed border-slate-300 bg-slate-50/70 px-4 py-8 text-center dark:border-slate-700 dark:bg-slate-900/40">
            <div class="text-sm font-semibold text-slate-900 dark:text-slate-100">Loading task definitions…</div>
            <div class="mt-1 max-w-xl text-sm text-slate-600 dark:text-slate-400">The admin workspace is fetching task definitions and linked resource assignments.</div>
        </div>
    }
    else if (taskRows.Count == 0)
    {
        <div class="flex min-h-[180px] flex-col items-center justify-center rounded-2xl border border-dashed border-slate-300 bg-slate-50/70 px-4 py-8 text-center dark:border-slate-700 dark:bg-slate-900/40">
            <div class="text-sm font-semibold text-slate-900 dark:text-slate-100">No task definitions yet</div>
            <div class="mt-1 max-w-xl text-sm text-slate-600 dark:text-slate-400">Create the first task definition to start building reusable task and question blueprints.</div>
            <button @onclick="() => OpenEditor(0)" class="inline-flex items-center justify-center gap-2 rounded-xl px-1 py-1 text-xs font-medium transition focus:outline-none focus:ring-2 disabled:cursor-not-allowed disabled:opacity-60 inline-flex items-center justify-center gap-2 rounded-xl border border-sky-600 bg-sky-600 px-1 py-1 text-xs font-medium text-white transition hover:bg-sky-700 focus:outline-none focus:ring-2 focus:ring-sky-500/30 disabled:cursor-not-allowed disabled:opacity-60 dark:border-sky-500 dark:bg-sky-500 dark:hover:bg-sky-400">@ResourceApp.newItem</button>
        </div>
    }
    else
    {
        <div class="sticky top-0 z-10 flex flex-wrap items-center gap-2 rounded-2xl border border-slate-200 bg-white px-3 py-2 shadow-sm dark:border-slate-800 dark:bg-slate-950/80">
            <input type="search"
                   class="h-8 w-44 rounded-lg border border-slate-300 bg-white px-2.5 text-xs text-slate-900 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
                   placeholder="Name..."
                   @bind-value="_filterName" @bind-value:event="oninput" />
            <input type="search"
                   class="h-8 w-32 rounded-lg border border-slate-300 bg-white px-2.5 text-xs text-slate-900 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
                   placeholder="Code..."
                   @bind-value="_filterCode" @bind-value:event="oninput" />
            <input type="search"
                   class="h-8 w-28 rounded-lg border border-slate-300 bg-white px-2.5 text-xs text-slate-900 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
                   placeholder="Unit..."
                   @bind-value="_filterUnit" @bind-value:event="oninput" />
            <select class="h-8 rounded-lg border border-slate-300 bg-white px-2.5 text-xs text-slate-900 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
                    value="@_filterStatus"
                    @onchange="e => _filterStatus = e.Value?.ToString() ?? string.Empty">
                <option value="">All statuses</option>
                <option value="active">Active</option>
                <option value="inactive">Inactive</option>
            </select>
            @if (HasActiveFilter)
            {
                <button type="button"
                        class="inline-flex h-8 items-center justify-center rounded-lg border border-slate-300 bg-white px-2.5 text-xs font-medium text-slate-700 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
                        @onclick="ClearFilters">
                    Clear
                </button>
            }
            @{var filteredRows = FilteredRows.ToList();}
            <span class="ml-auto text-xs text-slate-500 dark:text-slate-400">
                @(HasActiveFilter ? $"{filteredRows.Count} of {taskRows.Count}" : $"{taskRows.Count} items")
            </span>
        </div>

        @if (filteredRows.Count == 0)
        {
            <div class="flex min-h-[100px] items-center justify-center rounded-2xl border border-dashed border-slate-300 bg-slate-50/70 px-4 py-6 text-center text-sm text-slate-500 dark:border-slate-700 dark:bg-slate-900/40 dark:text-slate-400">
                No results match the current filters.
            </div>
        }
        else
        {
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-950/80">
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-slate-200 text-sm dark:divide-slate-800">
                    <thead>
                        <tr>
                            <th class="px-1 py-1 text-left text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400" style="width: 390px;">Actions</th>
                            <th class="px-1 py-1 text-left text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">@CalcResource.code</th>
                            <th class="px-1 py-1 text-left text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">@CalcResource.name</th>
                            <th class="px-1 py-1 text-left text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">@CalcResource.unit</th>
                            <th class="px-1 py-1 text-left text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">Responsible</th>
                            <th class="px-1 py-1 text-left text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">Uncontrollable</th>
                            <th class="px-1 py-1 text-left text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">@CalcResource.status</th>
                            <th class="px-1 py-1 text-left text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">States</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in filteredRows)
                        {
                            var item = row.Task;
                            <tr>
                                <td class="px-1 py-1 align-top text-sm text-slate-700 dark:text-slate-200">
                                    <div class="flex flex-wrap items-center gap-1">
                                        <button @onclick="async () => await Collspan(row)" class="inline-flex items-center justify-center gap-2 rounded-xl px-1 py-1 text-xs font-medium transition focus:outline-none focus:ring-2 disabled:cursor-not-allowed disabled:opacity-60 inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-slate-50 px-1 py-1 text-xs font-medium text-slate-700 transition hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-slate-400/20 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:bg-slate-800/80 dark:text-slate-200 dark:hover:bg-slate-800 px-1 py-1 text-xs">
                                            @(ColspanTaskIDs.Any(x => x == row.Id) ? "-" : "+")
                                        </button>

                                        <button @onclick="() => OpenEditor(item.Id)" class="inline-flex items-center justify-center gap-1 rounded-xl px-1 py-1 text-xs font-medium transition focus:outline-none focus:ring-2 disabled:cursor-not-allowed disabled:opacity-60 inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-slate-50 px-1 py-1 text-xs font-medium text-slate-700 transition hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-slate-400/20 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:bg-slate-800/80 dark:text-slate-200 dark:hover:bg-slate-800 px-1 py-1 text-xs" title="Edit">
                                            @Icons.Edit
                                        </button>
                                        <button @onclick="() => ConfirmDelete(row)" class="inline-flex items-center justify-center gap-2 rounded-xl px-1 py-1 text-xs font-medium transition focus:outline-none focus:ring-2 disabled:cursor-not-allowed disabled:opacity-60 inline-flex items-center justify-center gap-2 rounded-xl border border-rose-600 bg-rose-600 px-1 py-1 text-xs font-medium text-white transition hover:bg-rose-700 focus:outline-none focus:ring-2 focus:ring-rose-500/30 disabled:cursor-not-allowed disabled:opacity-60 dark:border-rose-500 dark:bg-rose-500 dark:hover:bg-rose-400 px-1 py-1 text-xs" title="Delete">
                                            @Icons.Delete
                                        </button>
                                        <button @onclick="() => OpenTaskFolders(item.Id, item.DisplayName)" class="inline-flex items-center justify-center gap-2 rounded-xl px-1 py-1 text-xs font-medium transition focus:outline-none focus:ring-2 disabled:cursor-not-allowed disabled:opacity-60 inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-1 py-1 text-xs font-medium text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-400/30 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800 px-1 py-1 text-xs">@ResourceLoc.resource</button>
                                    </div>
                                </td>
                                <td class="px-1 py-1 align-top text-sm text-slate-700 dark:text-slate-200">@item.Code</td>
                                <td class="px-1 py-1 align-top text-sm text-slate-700 dark:text-slate-200">
                                    <div class="font-medium text-slate-900 dark:text-slate-100">@item.DisplayName</div>
                                </td>
                                <td class="px-1 py-1 align-top text-sm text-slate-700 dark:text-slate-200">@item.UnitCode</td>
                                <td class="px-1 py-1 align-top text-sm text-slate-700 dark:text-slate-200">@item.Responsible</td>
                                <td class="px-1 py-1 align-top text-center">
                                    @if (item.Uncontrollable)
                                    {
                                        <span class="inline-flex items-center rounded-full border border-amber-200 bg-amber-50 px-2 py-0.5 text-[11px] font-medium text-amber-700 dark:border-amber-900/60 dark:bg-amber-950/40 dark:text-amber-200">Yes</span>
                                    }
                                </td>
                                <td class="px-1 py-1 align-top text-sm text-slate-700 dark:text-slate-200">
                                    @if (item.IsActive)
                                    {
                                        <span class="inline-flex items-center rounded-full border px-2.5 py-1 text-[11px] font-medium inline-flex items-center rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-[11px] font-medium text-emerald-700 dark:border-emerald-900/60 dark:bg-emerald-950/40 dark:text-emerald-200">Active</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center rounded-full border px-2.5 py-1 text-[11px] font-medium inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[11px] font-medium text-slate-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200">Inactive</span>
                                    }
                                </td>
                                <td class="px-1 py-1 align-top">
                                    @if (row.StateLinks.Count > 0)
                                    {
                                        <div class="flex flex-wrap gap-1">
                                            @foreach (var sl in row.StateLinks)
                                            {
                                                <span class="inline-flex items-center rounded-full border border-sky-200 bg-sky-50 px-2 py-0.5 text-[11px] font-medium text-sky-700 dark:border-sky-900/60 dark:bg-sky-950/40 dark:text-sky-200"
                                                      title="@sl.GroupName">
                                                    @sl.GroupName: @sl.StateName
                                                </span>
                                            }
                                        </div>
                                    }
                                </td>
                            </tr>
                            @if (ColspanTaskIDs.Any(x => x == row.Id) && row.ResourceTasks != null)
                            {
                                foreach (var res in row.ResourceTasks)
                                {
                                    <tr class="bg-slate-50/60 dark:bg-slate-950/30">
                                        <td class="px-1 py-1 align-top text-sm text-slate-700 dark:text-slate-200">
                                            <div class="flex flex-wrap items-center gap-1">
                                                <button class="inline-flex items-center justify-center gap-2 rounded-xl px-1 py-1 text-xs font-medium transition focus:outline-none focus:ring-2 disabled:cursor-not-allowed disabled:opacity-60 inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-1 py-1 text-xs font-medium text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-400/30 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800 px-1 py-1 text-xs" @onclick="() => TaskChoiceResourceBin(row, res)">
                                                    @((MarkupString)Icons.Machines)
                                                </button>
                                                <button class="inline-flex items-center justify-center gap-2 rounded-xl px-1 py-1 text-xs font-medium transition focus:outline-none focus:ring-2 disabled:cursor-not-allowed disabled:opacity-60 inline-flex items-center justify-center gap-2 rounded-xl border border-rose-600 bg-rose-600 px-1 py-1 text-xs font-medium text-white transition hover:bg-rose-700 focus:outline-none focus:ring-2 focus:ring-rose-500/30 disabled:cursor-not-allowed disabled:opacity-60 dark:border-rose-500 dark:bg-rose-500 dark:hover:bg-rose-400 px-1 py-1 text-xs" @onclick="() => RemoveAsync(row, res)">
                                                    @((MarkupString)Icons.Delete)
                                                </button>
                                                <span class="text-sm font-medium text-slate-800 dark:text-slate-100">@res.DisplayName</span>
                                            </div>
                                        </td>
                                        <td colspan="4" class="px-1 py-1 align-top text-sm text-slate-700 dark:text-slate-200">
                                            <div class="flex flex-wrap items-center gap-1">
                                                <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-2 py-0.5 text-xs font-medium text-slate-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200">
                                                    @CalcResource.unit: @res.Unit
                                                </span>
                                                <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-2 py-0.5 text-xs font-medium text-slate-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200">
                                                    @CalcResource.changeFactor1: @FormatNumber(res.Chf1)
                                                </span>
                                                <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-2 py-0.5 text-xs font-medium text-slate-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200">
                                                    @CalcResource.changeFactor2: @FormatNumber(res.Chf2)
                                                </span>
                                                <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-2 py-0.5 text-xs font-medium text-slate-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200">
                                                    @CalcResource.cap / @CalcResource.waste: @FormatNumber(res.CapWaste)
                                                </span>
                                                <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-2 py-0.5 text-xs font-medium text-slate-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200">
                                                    @CalcResource.baseCost: @FormatNullableDecimal(res.BaseCost)
                                                </span>
                                            </div>
                                        </td>

                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
        }

        @if (_loadingMore)
        {
            <div class="flex justify-center pt-3 pb-2">
                <BlazorMHD.UI.Components.Feedback.Loading.MhdLoading />
            </div>
        }
        else if (_hasMore)
        {
            <div id="task-dl-scroll-sentinel" class="h-4 w-full"></div>
        }
    }
</div>

@code {
    private const int PageSize = 100;
    private const string SentinelId = "task-dl-scroll-sentinel";

    private DotNetObjectReference<TaskDLIndexUI>? _selfRef;
    private bool _observerAttached = false;
    private bool _loadingMore = false;
    private bool _hasMore = false;

    void TaskChoiceResourceBin(TaskDisplayRow row, ResourceTaskIndexDto resourceId) =>
    MHD.Modal.ShowComponent<TaskResourceUI>
    (row.Task.DisplayName + " Resource",
new Dictionary<string, object>
{
    [nameof(TaskResourceUI.Task)] = row.GetTaskForAssignment(resourceId.AssignmentId),
    [nameof(TaskResourceUI.Resource)] = resourceId,
}, DialogSize.ExtraLarge);
    private List<ProjectTaskListItemDto>? tasks;
    private List<TaskDisplayRow> taskRows = [];
    private string? errorMessage;
    private string? infoMessage;
    private int _loadedTaskCount = 0;
    List<int> ColspanTaskIDs = [];

    private string _filterName = string.Empty;
    private string _filterCode = string.Empty;
    private string _filterUnit = string.Empty;
    private string _filterStatus = string.Empty;

    private bool HasActiveFilter =>
        !string.IsNullOrWhiteSpace(_filterName) ||
        !string.IsNullOrWhiteSpace(_filterCode) ||
        !string.IsNullOrWhiteSpace(_filterUnit) ||
        !string.IsNullOrWhiteSpace(_filterStatus);

    private IEnumerable<TaskDisplayRow> FilteredRows => taskRows.Where(r =>
        (string.IsNullOrWhiteSpace(_filterName) || (r.Task.DisplayName ?? string.Empty).Contains(_filterName, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(_filterCode) || (r.Task.Code ?? string.Empty).Contains(_filterCode, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(_filterUnit) || (r.Task.UnitCode ?? string.Empty).Contains(_filterUnit, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(_filterStatus) || (_filterStatus == "active" ? r.Task.IsActive : !r.Task.IsActive))
    );

    private void ClearFilters()
    {
        _filterName = string.Empty;
        _filterCode = string.Empty;
        _filterUnit = string.Empty;
        _filterStatus = string.Empty;
    }

    async Task RemoveAsync(TaskDisplayRow row, ResourceTaskIndexDto res)
    {
        if (await FoldersService.RemoveAssignmentAsync(res.AssignmentId))
        {
            row.ResourceTasks?.RemoveAll(x => x.AssignmentId == res.AssignmentId);
            StateHasChanged();
        }
    }

    async Task Collspan(TaskDisplayRow row)
    {
        if (ColspanTaskIDs.Any(x => x == row.Id))
        {
            ColspanTaskIDs.Remove(row.Id);
        }
        else
        {
            row.ClearResourceTasks();
            foreach (var taskId in row.TaskIds)
            {
                var resources = await TaskQueries.GetResourcesForTaskAsync(taskId, CancellationToken.None);
                row.AddResourceTasks(taskId, resources);
            }
            ColspanTaskIDs.Add(row.Id);
        }
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        try
        {
            errorMessage = null;
            _hasMore = false;
            ColspanTaskIDs.Clear();
            var batch = (await TaskQueries.GetListPagedAsync(0, PageSize, CancellationToken.None)).ToList();
            tasks = batch;
            taskRows = BuildDisplayRows(tasks);
            _loadedTaskCount = batch.Count;
            _hasMore = batch.Count == PageSize;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            infoMessage = null;
        }
    }

    private async Task LoadMoreAsync()
    {
        if (tasks is null || _loadingMore || !_hasMore) return;
        _loadingMore = true;
        try
        {
            var batch = (await TaskQueries.GetListPagedAsync(_loadedTaskCount, PageSize, CancellationToken.None)).ToList();
            tasks.AddRange(batch);
            taskRows = BuildDisplayRows(tasks);
            _loadedTaskCount += batch.Count;
            _hasMore = batch.Count == PageSize;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            _loadingMore = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var shouldObserve = _hasMore && !_loadingMore && tasks is not null;
        if (shouldObserve && !_observerAttached)
        {
            _selfRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("observeIntersection", _selfRef, SentinelId);
            _observerAttached = true;
        }
        else if (!shouldObserve && _observerAttached)
        {
            await JS.InvokeVoidAsync("unobserveIntersection", SentinelId);
            _observerAttached = false;
        }
    }

    [JSInvokable]
    public async Task OnScrolledToBottom()
    {
        if (_loadingMore || !_hasMore || tasks is null) return;
        _observerAttached = false;
        try { await JS.InvokeVoidAsync("unobserveIntersection", SentinelId); } catch { }
        await InvokeAsync(async () =>
        {
            await LoadMoreAsync();
            StateHasChanged();
        });
    }

    public async ValueTask DisposeAsync()
    {
        if (_observerAttached)
        {
            try { await JS.InvokeVoidAsync("unobserveIntersection", SentinelId); } catch { }
            _observerAttached = false;
        }
        _selfRef?.Dispose();
    }

    private void OpenEditor(int id)
    {
        var title = id == 0 ? ResourceApp.newItem : ResourceApp.update;
        MHD.Modal.ShowComponent<TaskDLFormUI>(title, new Dictionary<string, object>
        {
            [nameof(TaskDLFormUI.TaskId)] = id,
            [nameof(TaskDLFormUI.Saved)] = EventCallback.Factory.Create<bool>(this, ReloadAsync),
        }, DialogSize.ExtraLarge);
    }

    private void OpenTaskFolders(int id, string name)
    {
        MHD.Modal.ShowComponent<TaskFolders>(ResourceLoc.resource, new Dictionary<string, object>
        {
            [nameof(TaskFolders.TaskId)] = id
        }, DialogSize.ExtraLarge);
    }

    private void ConfirmDelete(TaskDisplayRow row)
        => MHD.DeleteMessage(row.Task.DisplayName, EventCallback.Factory.Create(this, () => DeleteAsync(row.TaskIds)));

    private async Task DeleteAsync(IReadOnlyList<int> ids)
    {
        foreach (var id in ids.Distinct())
        {
            await TaskCommands.DeleteAsync(id, CancellationToken.None);
        }
        await ReloadAsync();
    }

    private static string FormatNumber(decimal value)
        => NumericDisplayHelper.Format(value);

    private static string FormatNullableDecimal(decimal? value)
        => NumericDisplayHelper.Format(value);

    private static List<TaskDisplayRow> BuildDisplayRows(IEnumerable<ProjectTaskListItemDto> source)
    {
        var rows = new List<TaskDisplayRow>();
        var index = new Dictionary<TaskDisplayKey, TaskDisplayRow>();

        foreach (var task in source)
        {
            var key = TaskDisplayKey.From(task);
            if (!index.TryGetValue(key, out var row))
            {
                row = new TaskDisplayRow(task);
                rows.Add(row);
                index.Add(key, row);
            }
            else
            {
                row.AddTaskId(task.Id);
            }

            row.AddStateLinks(task.StateLinks);
        }

        return rows;
    }

    private sealed record TaskDisplayKey(
        string Code,
        string DisplayName,
        string UnitCode,
        decimal? Quantity,
        bool IsActive,
        string Responsible,
        bool Uncontrollable)
    {
        public static TaskDisplayKey From(ProjectTaskListItemDto task) => new(
            Normalize(task.Code),
            Normalize(task.DisplayName),
            Normalize(task.UnitCode),
            task.Quantity,
            task.IsActive,
            Normalize(task.Responsible),
            task.Uncontrollable);

        private static string Normalize(string? value) => (value ?? string.Empty).Trim();
    }

    private sealed class TaskDisplayRow
    {
        private readonly Dictionary<int, int> assignmentTaskIds = [];

        public TaskDisplayRow(ProjectTaskListItemDto task)
        {
            Task = task;
            TaskIds.Add(task.Id);
        }

        public int Id => Task.Id;
        public ProjectTaskListItemDto Task { get; }
        public List<int> TaskIds { get; } = [];
        public List<TaskStateLinkDto> StateLinks { get; } = [];
        public List<ResourceTaskIndexDto>? ResourceTasks { get; private set; }

        public void AddTaskId(int taskId)
        {
            if (!TaskIds.Contains(taskId))
            {
                TaskIds.Add(taskId);
            }
        }

        public void AddStateLinks(IEnumerable<TaskStateLinkDto> links)
        {
            foreach (var link in links)
            {
                if (!StateLinks.Any(x => x.StateId == link.StateId && x.GroupId == link.GroupId))
                {
                    StateLinks.Add(link);
                }
            }
        }

        public void ClearResourceTasks()
        {
            ResourceTasks = [];
            assignmentTaskIds.Clear();
        }

        public void AddResourceTasks(int taskId, IEnumerable<ResourceTaskIndexDto> resources)
        {
            ResourceTasks ??= [];

            foreach (var resource in resources)
            {
                if (assignmentTaskIds.ContainsKey(resource.AssignmentId))
                {
                    continue;
                }

                ResourceTasks.Add(resource);
                assignmentTaskIds.Add(resource.AssignmentId, taskId);
            }
        }

        public ProjectTaskListItemDto GetTaskForAssignment(int assignmentId)
        {
            if (!assignmentTaskIds.TryGetValue(assignmentId, out var taskId) || taskId == Task.Id)
            {
                return Task;
            }

            var task = Task with { Id = taskId };
            task.StateLinks = StateLinks;
            task.ResourceTasks = ResourceTasks ?? [];
            return task;
        }
    }
}
