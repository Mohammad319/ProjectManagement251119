@using TaskResourceBlueprints.Dto.ProjectTask
@using TaskResourceBlueprints.Services.ProjectTask
@using TaskResourceBlueprints.Services.Resource
@using ProjectManagement.Adminstrator.Components.Question
@using ProjectManagement.Adminstrator.Components.Question.QuestionConditionList
@using ProjectManagement.Adminstrator.Constants
@using ProjectManagement.Adminstrator.Services.MHDBlazor
@inject ITaskDefinitionQueryService TaskQueries
@inject ITaskDefinitionService TaskCommands
@inject ITaskResourceService FoldersService

@inject MhdServices MHD

<div class="pm-page">
    <section class="pm-page-header">
        <div class="pm-page-kicker">Task definitions</div>
        <div class="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
            <div>
                <h2 class="pm-page-title">Task &amp; question blueprint library</h2>
                <p class="pm-page-subtitle">Manage task definitions, task conditions, question groups, and assigned resource blueprints from one table.</p>
            </div>
            <button @onclick="() => OpenEditor(0)" class="pm-btn pm-btn-primary">
                @((MarkupString)Icons.Plus)
                <span>@ResourceApp.newItem</span>
            </button>
        </div>
    </section>

    @if (errorMessage is not null)
    {
        <div class="rounded-2xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 dark:border-rose-900/70 dark:bg-rose-950/50 dark:text-rose-300">@errorMessage</div>
    }
    else if (tasks is null)
    {
        <div class="pm-empty">
            <div class="pm-empty-title">Loading task definitions…</div>
            <div class="pm-empty-copy">The admin workspace is fetching task definitions and linked resource assignments.</div>
        </div>
    }
    else if (tasks.Count == 0)
    {
        <div class="pm-empty">
            <div class="pm-empty-title">No task definitions yet</div>
            <div class="pm-empty-copy">Create the first task definition to start building reusable task and question blueprints.</div>
            <button @onclick="() => OpenEditor(0)" class="pm-btn pm-btn-primary">@ResourceApp.newItem</button>
        </div>
    }
    else
    {
        <div class="pm-table-wrap">
            <div class="pm-table-scroll">
                <table class="pm-table">
                    <thead>
                        <tr>
                            <th style="width: 390px;">Actions</th>
                            <th>@CalcResource.code</th>
                            <th>@CalcResource.name</th>
                            <th>@CalcResource.unit</th>
                            <th>@CalcResource.quantity</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in tasks)
                        {
                            <tr>
                                <td>
                                    <div class="flex flex-wrap items-center gap-2">
                                        <button @onclick="() => OpenEditor(item.Id)" class="pm-btn pm-btn-soft px-3 py-2 text-xs" title="Edit">
                                            @Icons.Edit <span>Edit</span>
                                        </button>
                                        <button @onclick="() => ConfirmDelete(item.Id, item.DisplayName)" class="pm-btn pm-btn-danger px-3 py-2 text-xs" title="Delete">
                                            @Icons.Delete <span>Delete</span>
                                        </button>
                                        <button @onclick="() => OpenConditions(item.Id, item.DisplayName)" class="pm-btn pm-btn-secondary px-3 py-2 text-xs">@ResourceLoc.Conditions</button>
                                        <button @onclick="() => OpenGroups(item.Id, item.DisplayName)" class="pm-btn pm-btn-secondary px-3 py-2 text-xs">@ResourceLoc.group</button>
                                        <button @onclick="() => OpenTaskFolders(item.Id, item.DisplayName)" class="pm-btn pm-btn-secondary px-3 py-2 text-xs">@ResourceLoc.resource</button>
                                        <button @onclick="async () => await Collspan(item)" class="pm-btn pm-btn-soft px-3 py-2 text-xs">
                                            @(ColspanTaskIDs.Any(x => x == item.Id) ? "Hide resources" : "Show resources")
                                        </button>
                                    </div>
                                </td>
                                <td>@item.Code</td>
                                <td>
                                    <div class="font-medium text-slate-900 dark:text-slate-100">@item.DisplayName</div>
                                </td>
                                <td>@item.UnitCode</td>
                                <td>@item.Quantity</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="pm-pill pm-pill-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="pm-pill pm-pill-muted">Inactive</span>
                                    }
                                </td>
                            </tr>
                            @if (ColspanTaskIDs.Any(x => x == item.Id) && item.ResourceTasks != null)
                            {
                                foreach (var res in item.ResourceTasks)
                                {
                                    <tr class="bg-slate-50/60 dark:bg-slate-950/30">
                                        <td>
                                            <div class="flex flex-wrap items-center gap-2">
                                                <button class="pm-btn pm-btn-secondary px-3 py-2 text-xs" @onclick="() => TaskChoiceResourceBin(item, res)">
                                                    @((MarkupString)Icons.Machines)
                                                    <span>Open resource</span>
                                                </button>
                                                <button class="pm-btn pm-btn-danger px-3 py-2 text-xs" @onclick="() => RemoveAsync(item, res)">
                                                    @((MarkupString)Icons.Delete)
                                                    <span>Remove</span>
                                                </button>
                                                <span class="text-sm font-medium text-slate-800 dark:text-slate-100">@res.DisplayName</span>
                                            </div>
                                        </td>
                                        <td>@res.Unit</td>
                                        <td>@res.Chf1</td>
                                        <td>@res.Chf2</td>
                                        <td>@res.Unit</td>
                                        <td>
                                            @if (res.IsActive)
                                            {
                                                <span class="pm-pill pm-pill-success">Assigned</span>
                                            }
                                            else
                                            {
                                                <span class="pm-pill pm-pill-muted">Disabled</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    void TaskChoiceResourceBin(ProjectTaskListItemDto model, ResourceTaskIndexDto resourceId) => MHD.Modal.ShowComponent<TaskResourceUI>
    (model.DisplayName + " Resource",
new Dictionary<string, object>
{
    [nameof(TaskResourceUI.Task)] = model,
    [nameof(TaskResourceUI.Resource)] = resourceId,
});
    private List<ProjectTaskListItemDto>? tasks;
    private string? errorMessage;
    List<int> ColspanTaskIDs = [];
    private void ConfirmDelete(ProjectTaskListItemDto task, ResourceTaskIndexDto res)
    => MHD.DeleteMessage(res.DisplayName, EventCallback.Factory.Create(this, () => RemoveAsync(task, res)));

    async Task RemoveAsync(ProjectTaskListItemDto task, ResourceTaskIndexDto res)
    {
        if (await FoldersService.RemoveAssignmentAsync(res.AssignmentId))
        {
            task.ResourceTasks?.RemoveAll(x => x.AssignmentId == res.AssignmentId);
            StateHasChanged();
        }
    }

    async Task Collspan(ProjectTaskListItemDto task)
    {
        if (ColspanTaskIDs.Any(x => x == task.Id))
        {
            ColspanTaskIDs.Remove(task.Id);
        }
        else
        {
            task.ResourceTasks = (await TaskQueries.GetResourcesForTaskAsync(task.Id, CancellationToken.None)).ToList();

            ColspanTaskIDs.Add(task.Id);
        }
        StateHasChanged();
    }
    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        try
        {
            errorMessage = null;
            tasks = (await TaskQueries.GetListAsync(CancellationToken.None)).ToList();
            StateHasChanged();

        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void OpenEditor(int id)
    {
        var title = id == 0 ? ResourceApp.newItem : ResourceApp.update;
        MHD.Modal.ShowComponent<TaskDLFormUI>(title, new Dictionary<string, object>
        {
            [nameof(TaskDLFormUI.TaskId)] = id,
            [nameof(TaskDLFormUI.Saved)] = EventCallback.Factory.Create<bool>(this, ReloadAsync),
        });
    }

    private void OpenConditions(int id, string name)
    {
        MHD.Modal.ShowComponent<QuestionConditionListUI>($"Questions for Task {name}",
            new Dictionary<string, object> { [nameof(QuestionConditionListUI.TaskId)] = id });
    }

    private void OpenGroups(int id, string name)
    {
        MHD.Modal.ShowComponent<TaskGroupsFormUI>($"Questions for Task {name}",
            new Dictionary<string, object> { [nameof(TaskGroupsFormUI.ID)] = id });
    }

    private void OpenTaskFolders(int id, string name)
    {
        MHD.Modal.ShowComponent<TaskFolders>(ResourceLoc.resource, new Dictionary<string, object>
        {
            [nameof(TaskFolders.TaskId)] = id
        });
    }

    private void ConfirmDelete(int id, string name)
        => MHD.DeleteMessage(name, EventCallback.Factory.Create(this, () => DeleteAsync(id)));

    private async Task DeleteAsync(int id)
    {
        await TaskCommands.DeleteAsync(id, CancellationToken.None);
        await ReloadAsync();
    }
}
