@using TaskResourceBlueprints.Dto.ProjectTask
@using TaskResourceBlueprints.Services.ProjectTask
@using TaskResourceBlueprints.Services.Resource
@using ProjectManagement.Adminstrator.Components.Question
@using ProjectManagement.Adminstrator.Components.Question.QuestionConditionList
@using ProjectManagement.Adminstrator.Constants
@using ProjectManagement.Adminstrator.Services.MHDBlazor
@inject ITaskDefinitionQueryService TaskQueries
@inject ITaskDefinitionService TaskCommands
@inject ITaskResourceService FoldersService

@inject MhdServices MHD

@if (errorMessage is not null)
{
    <div class="rounded border border-gray-200 bg-white p-1 text-red-600 dark:border-gray-700 dark:bg-gray-900/60 dark:text-red-400">@errorMessage</div>
}
else if (tasks is null)
{
    <div class="rounded border border-gray-200 bg-white p-1 dark:border-gray-700 dark:bg-gray-900/60">Loading …</div>
}
else if (tasks.Count == 0)
{
    <button @onclick="() => OpenEditor(0)"
            class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-blue-200 bg-blue-50 text-blue-700 transition hover:bg-blue-100 dark:border-blue-900/60 dark:bg-blue-950/40 dark:text-blue-300 dark:hover:bg-blue-950/60">
        @((MarkupString)Icons.Plus)
    </button>
    <div class="rounded border border-gray-200 bg-white p-1 dark:border-gray-700 dark:bg-gray-900/60">@ResourceApp.thereIsNoElements …</div>
}
else
{
    <table class="w-full border-collapse overflow-hidden rounded-xl border border-slate-200 bg-white text-sm shadow-sm dark:border-slate-800 dark:bg-slate-950">
        <thead class="bg-slate-50 dark:bg-slate-900/70">
            <tr>
                <th class="p-2 text-left text-sm font-semibold text-slate-700 dark:text-slate-200" style="width:370px;">
                    <button @onclick="() => OpenEditor(0)"
                            class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-blue-200 bg-blue-50 text-blue-700 transition hover:bg-blue-100 dark:border-blue-900/60 dark:bg-blue-950/40 dark:text-blue-300 dark:hover:bg-blue-950/60">
                        @((MarkupString)Icons.Plus)
                    </button>
                </th>
                <th class="p-2 text-left text-sm font-semibold text-slate-700 dark:text-slate-200">@CalcResource.code</th>
                <th class="p-2 text-left text-sm font-semibold text-slate-700 dark:text-slate-200">@CalcResource.name</th>
                <th class="p-2 text-left text-sm font-semibold text-slate-700 dark:text-slate-200">@CalcResource.unit</th>
                <th class="p-2 text-left text-sm font-semibold text-slate-700 dark:text-slate-200">@CalcResource.quantity</th>
                <th class="p-2 text-left text-sm font-semibold text-slate-700 dark:text-slate-200">Aktiv</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in tasks)
            {
                <tr class="border-t border-slate-200 align-top dark:border-slate-800">
                    <td class="p-2 text-slate-700 dark:text-slate-200">
                        <div class="flex flex-wrap items-center gap-2">
                            <button @onclick="() => OpenEditor(item.Id)" class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-amber-200 bg-amber-50 text-amber-700 transition hover:bg-amber-100 dark:border-amber-900/60 dark:bg-amber-950/40 dark:text-amber-300" title="Edit">
                                @Icons.Edit
                            </button>
                            <button @onclick="() => ConfirmDelete(item.Id, item.DisplayName)" class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-rose-200 bg-rose-50 text-rose-700 transition hover:bg-rose-100 dark:border-rose-900/60 dark:bg-rose-950/40 dark:text-rose-300" title="Delete">
                                @Icons.Delete
                            </button>
                            <button @onclick="() => OpenConditions(item.Id, item.DisplayName)" class="inline-flex items-center rounded-lg border border-blue-200 bg-blue-50 px-2 py-1 text-xs font-medium text-blue-700 transition hover:bg-blue-100 dark:border-blue-900/60 dark:bg-blue-950/40 dark:text-blue-300">
                                @ResourceLoc.Conditions
                            </button>
                            <button @onclick="() => OpenGroups(item.Id, item.DisplayName)" class="inline-flex items-center rounded-lg border border-blue-200 bg-blue-50 px-2 py-1 text-xs font-medium text-blue-700 transition hover:bg-blue-100 dark:border-blue-900/60 dark:bg-blue-950/40 dark:text-blue-300">
                                @ResourceLoc.group
                            </button>
                            <button @onclick="() => OpenTaskFolders(item.Id, item.DisplayName)" class="inline-flex items-center rounded-lg border border-blue-200 bg-blue-50 px-2 py-1 text-xs font-medium text-blue-700 transition hover:bg-blue-100 dark:border-blue-900/60 dark:bg-blue-950/40 dark:text-blue-300">
                                @ResourceLoc.resource
                            </button>
                            @if (ColspanTaskIDs.Any(x => x == item.Id))
                            {
                                <button @onclick="async () => await Collspan(item)" class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-cyan-200 bg-cyan-50 text-cyan-700 transition hover:bg-cyan-100 dark:border-cyan-900/60 dark:bg-cyan-950/40 dark:text-cyan-300">^</button>
                            }
                            else
                            {
                                <button @onclick="async  () => await Collspan(item)" class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-cyan-200 bg-cyan-50 text-cyan-700 transition hover:bg-cyan-100 dark:border-cyan-900/60 dark:bg-cyan-950/40 dark:text-cyan-300">v</button>
                            }
                        </div>
                    </td>

                    <td class="p-2 text-slate-700 dark:text-slate-200">@item.Code</td>
                    <td class="p-2 text-slate-700 dark:text-slate-200">@item.DisplayName</td>
                    <td class="p-2 text-slate-700 dark:text-slate-200">@item.UnitCode</td>
                    <td class="p-2 text-slate-700 dark:text-slate-200">@item.Quantity</td>
                    <td class="p-2 text-slate-700 dark:text-slate-200">
                        @if (item.IsActive)
                        {
                            <span class="rounded bg-cyan-100 px-2 py-1 text-xs font-semibold text-cyan-700 dark:bg-cyan-950/50 dark:text-cyan-300">ON</span>
                        }
                        else
                        {
                            <span class="rounded bg-slate-200 px-2 py-1 text-xs font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-300">OFF</span>
                        }
                    </td>
                </tr>
                @if (ColspanTaskIDs.Any(x => x == item.Id) && item.ResourceTasks != null)
                {
                    foreach (var res in item.ResourceTasks)
                    {
                        <tr class="border-t border-slate-200 bg-slate-50/50 align-top dark:border-slate-800 dark:bg-slate-900/20">
                            <td class="p-2 text-slate-700 dark:text-slate-200">
                                <button class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-blue-200 bg-blue-50 text-blue-700 transition hover:bg-blue-100 dark:border-blue-900/60 dark:bg-blue-950/40 dark:text-blue-300" @onclick="() => TaskChoiceResourceBin(item, res)">
                                    @((MarkupString)Icons.Machines)
                                </button>
                                <button class="ml-2 inline-flex h-8 w-8 items-center justify-center rounded-lg border border-rose-200 bg-rose-50 text-rose-700 transition hover:bg-rose-100 dark:border-rose-900/60 dark:bg-rose-950/40 dark:text-rose-300" @onclick="() => RemoveAsync(item, res)">
                                    @((MarkupString)Icons.Delete)
                                </button>
                                @res.DisplayName
                            </td>
                            <td class="p-2 text-slate-700 dark:text-slate-200">@res.Unit</td>
                            <td class="p-2 text-slate-700 dark:text-slate-200">@res.Chf1</td>
                            <td class="p-2 text-slate-700 dark:text-slate-200">@res.Chf2</td>
                            <td class="p-2 text-slate-700 dark:text-slate-200">@res.Unit</td>
                            <td class="p-2 text-slate-700 dark:text-slate-200">
                                @if (res.IsActive)
                                {
                                    <span class="rounded bg-cyan-100 px-2 py-1 text-xs font-semibold text-cyan-700 dark:bg-cyan-950/50 dark:text-cyan-300">ON</span>
                                }
                                else
                                {
                                    <span class="rounded bg-slate-200 px-2 py-1 text-xs font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-300">OFF</span>
                                }
                            </td>
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
}

@code {
    void TaskChoiceResourceBin(ProjectTaskListItemDto model, ResourceTaskIndexDto resourceId) => MHD.Modal.ShowComponent<TaskResourceUI>
    (model.DisplayName + " Resource",
new Dictionary<string, object>
{
    [nameof(TaskResourceUI.Task)] = model,
    [nameof(TaskResourceUI.Resource)] = resourceId,
});
    private List<ProjectTaskListItemDto>? tasks;
    private string? errorMessage;
    List<int> ColspanTaskIDs = [];
    private void ConfirmDelete(ProjectTaskListItemDto task, ResourceTaskIndexDto res)
    => MHD.DeleteMessage(res.DisplayName, EventCallback.Factory.Create(this, () => RemoveAsync(task, res)));

    async Task RemoveAsync(ProjectTaskListItemDto task, ResourceTaskIndexDto res)
    {
        if (await FoldersService.RemoveAssignmentAsync(res.AssignmentId))
        {
            task.ResourceTasks?.RemoveAll(x => x.AssignmentId == res.AssignmentId);
            StateHasChanged();
        }
    }

    async Task Collspan(ProjectTaskListItemDto task)
    {
        if (ColspanTaskIDs.Any(x => x == task.Id))
        {
            ColspanTaskIDs.Remove(task.Id);
        }
        else
        {
            task.ResourceTasks = (await TaskQueries.GetResourcesForTaskAsync(task.Id, CancellationToken.None)).ToList();

            ColspanTaskIDs.Add(task.Id);
        }
        StateHasChanged();
    }
    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        try
        {
            errorMessage = null;
            tasks = (await TaskQueries.GetListAsync(CancellationToken.None)).ToList();
            StateHasChanged();

        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void OpenEditor(int id)
    {
        var title = id == 0 ? ResourceApp.newItem : ResourceApp.update;
        MHD.Modal.ShowComponent<TaskDLFormUI>(title, new Dictionary<string, object>
        {
            [nameof(TaskDLFormUI.TaskId)] = id,
            [nameof(TaskDLFormUI.Saved)] = EventCallback.Factory.Create<bool>(this, ReloadAsync),
        });
    }

    private void OpenConditions(int id, string name)
    {
        MHD.Modal.ShowComponent<QuestionConditionListUI>($"Questions for Task {name}",
            new Dictionary<string, object> { [nameof(QuestionConditionListUI.TaskId)] = id });
    }

    private void OpenGroups(int id, string name)
    {
        MHD.Modal.ShowComponent<TaskGroupsFormUI>($"Questions for Task {name}",
            new Dictionary<string, object> { [nameof(TaskGroupsFormUI.ID)] = id });
    }

    private void OpenTaskFolders(int id, string name)
    {
        MHD.Modal.ShowComponent<TaskFolders>(ResourceLoc.resource, new Dictionary<string, object>
        {
            [nameof(TaskFolders.TaskId)] = id
        });
    }

    private void ConfirmDelete(int id, string name)
        => MHD.DeleteMessage(name, EventCallback.Factory.Create(this, () => DeleteAsync(id)));

    private async Task DeleteAsync(int id)
    {
        await TaskCommands.DeleteAsync(id, CancellationToken.None);
        await ReloadAsync();
    }
}
