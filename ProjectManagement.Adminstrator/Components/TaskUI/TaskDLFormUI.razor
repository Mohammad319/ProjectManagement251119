@using TaskResourceBlueprints.Dto.ProjectTask
@using TaskResourceBlueprints.Entities
@using TaskResourceBlueprints.Entities.Lookups
@using TaskResourceBlueprints.Entities.Resources
@using TaskResourceBlueprints.Entities.Tasks
@using TaskResourceBlueprints.Services.ProjectTask
@inject ITaskDefinitionService TaskService
@inherits AppComponentBase

<div class="pm-form-shell">
    <EditForm Model="UpdateForm" OnValidSubmit="HandleSubmit" class="pm-form-shell">
        <DataAnnotationsValidator />
        <ValidationSummary class="pm-validation-summary" />

        <section class="pm-form-section">
            <div>
                <h3 class="pm-form-section-title">Task definition</h3>
                <p class="pm-form-section-text">Configure the action, catalog grouping, quantities, and visibility of this task blueprint.</p>
            </div>

            <div class="pm-form-grid">
                <div class="pm-field">
                    <label class="pm-label">Action</label>
                    <InputSelect @bind-Value="UpdateForm.ActionId" class="pm-select">
                        <option value="">Select Action</option>
                        @if (ActionsTasks != null)
                        {
                            foreach (var action in ActionsTasks)
                            {
                                <option value="@action.Id">@action.Name</option>
                            }
                        }
                    </InputSelect>
                </div>

                <div class="pm-field">
                    <label class="pm-label">Location</label>
                    <InputSelect @bind-Value="UpdateForm.LocationId" class="pm-select">
                        <option value="">Select Location</option>
                        @if (LocationsList != null)
                        {
                            foreach (var action in LocationsList)
                            {
                                <option value="@action.Id">@action.Name</option>
                            }
                        }
                    </InputSelect>
                </div>

                <div class="pm-field">
                    <label class="pm-label">Fall</label>
                    <InputSelect @bind-Value="UpdateForm.FallId" class="pm-select">
                        <option value="">Select Fall</option>
                        @if (FallsList != null)
                        {
                            foreach (var action in FallsList)
                            {
                                <option value="@action.Id">@action.Name</option>
                            }
                        }
                    </InputSelect>
                </div>

                <div class="pm-field">
                    <label class="pm-label">ActionType</label>
                    <InputSelect @bind-Value="UpdateForm.ActionTypeId" class="pm-select">
                        <option value="">Select ActionType</option>
                        @if (ActionTypesList != null)
                        {
                            foreach (var action in ActionTypesList)
                            {
                                <option value="@action.Id">@action.Name</option>
                            }
                        }
                    </InputSelect>
                </div>

                <div class="pm-field">
                    <label class="pm-label">@CalcResource.code</label>
                    <InputText @bind-Value="UpdateForm.Code" class="pm-input" />
                </div>

                <div class="pm-field">
                    <label class="pm-label">@CalcResource.name</label>
                    <InputText @bind-Value="UpdateForm.DisplayName" class="pm-input" />
                </div>

                <div class="pm-field">
                    <label class="pm-label">@CalcResource.responsible</label>
                    <InputText @bind-Value="UpdateForm.Responsible" class="pm-input" />
                </div>

                <div class="pm-field">
                    <label class="pm-label">Groups</label>
                    <select class="pm-select" @onchange="ChangeGroup">
                        <option value="">Select Group</option>
                        @if (Groups != null)
                        {
                            foreach (var action in Groups)
                            {
                                <option value="@action.Id" selected="@(UpdateForm.UnitGroupId == action.Id)">@action.DisplayName</option>
                            }
                        }
                    </select>
                </div>

                @if (SelectedGroup != null && UpdateForm.UnitGroupId.HasValue)
                {
                    <div class="pm-field">
                        <label class="pm-label">Units</label>
                        <InputSelect @bind-Value="UpdateForm.UnitCode" class="pm-select">
                            <option value="">Select Unit</option>
                            @foreach (var item in SelectedGroup.Keys)
                            {
                                <option value="@item">@item</option>
                            }
                        </InputSelect>
                    </div>
                }

                <div class="pm-field">
                    <label class="pm-label">Status</label>
                    <InputSelect @bind-Value="UpdateForm.Status" class="pm-select">
                        <option value="@TaskStatusEnum.ToPlan" selected="@(UpdateForm.Status == TaskStatusEnum.ToPlan)">@TaskStatusEnum.ToPlan</option>
                        <option value="@TaskStatusEnum.ToDo" selected="@(UpdateForm.Status == TaskStatusEnum.ToDo)">@TaskStatusEnum.ToDo</option>
                        <option value="@TaskStatusEnum.UnderWorking" selected="@(UpdateForm.Status == TaskStatusEnum.UnderWorking)">@TaskStatusEnum.UnderWorking</option>
                        <option value="@TaskStatusEnum.Ready" selected="@(UpdateForm.Status == TaskStatusEnum.Ready)">@TaskStatusEnum.Ready</option>
                    </InputSelect>
                </div>

                <div class="pm-field">
                    <label class="pm-label">@CalcResource.quantity</label>
                    <InputNumber @bind-Value="UpdateForm.Quantity" class="pm-input" />
                </div>

                <div class="pm-field">
                    <label class="pm-label">@CalcResource.changeFactor1</label>
                    <InputNumber @bind-Value="UpdateForm.ChangeFactor1" class="pm-input" />
                </div>

                <div class="pm-field">
                    <label class="pm-label">@CalcResource.changeFactor2</label>
                    <InputNumber @bind-Value="UpdateForm.ChangeFactor2" class="pm-input" />
                </div>

                <div class="pm-field">
                    <label class="pm-label">Thickness</label>
                    <InputNumber @bind-Value="UpdateForm.Thickness" class="pm-input" />
                </div>

                <div class="pm-field">
                    <label class="pm-label">Width</label>
                    <InputNumber @bind-Value="UpdateForm.Width" class="pm-input" />
                </div>

                <div class="pm-field">
                    <label class="pm-label">Length</label>
                    <InputNumber @bind-Value="UpdateForm.Length" class="pm-input" />
                </div>

                <div class="md:col-span-2 xl:col-span-2">
                    <label class="pm-inline-check">
                        <InputCheckbox @bind-Value="UpdateForm.IsActive" class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 dark:border-slate-600 dark:bg-slate-950" />
                        <span>@CalcResource.active</span>
                    </label>
                </div>

                <div class="md:col-span-2 xl:col-span-2">
                    <label class="pm-inline-check">
                        <InputCheckbox @bind-Value="UpdateForm.Uncontrollable" class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 dark:border-slate-600 dark:bg-slate-950" />
                        <span>Hide the resource and show the total cost only (UE).</span>
                    </label>
                </div>

                <div class="pm-field md:col-span-2 xl:col-span-2">
                    <label class="pm-label">@CalcResource.note</label>
                    <InputTextArea @bind-Value="UpdateForm.Note" class="pm-textarea" />
                </div>

                <div class="pm-field md:col-span-2 xl:col-span-2">
                    <label class="pm-label">Admin @CalcResource.note</label>
                    <InputTextArea @bind-Value="UpdateForm.AdminNote" class="pm-textarea" />
                </div>
            </div>
        </section>

        <section class="pm-form-section">
            <div>
                <h3 class="pm-form-section-title">Visible folders</h3>
                <p class="pm-form-section-text">Select the catalog folders where this task definition should appear.</p>
            </div>

            <div class="mt-4 flex flex-wrap gap-3">
                @if (Folders != null)
                {
                    foreach (var folder in Folders)
                    {
                        <label class="pm-inline-check">
                            <input type="checkbox" @onchange="() => ToggleFolder(folder.Id)" class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 dark:border-slate-600 dark:bg-slate-950" checked="@(UpdateForm.VisibleFolderIds.Any(x => x == folder.Id))" />
                            <span>@folder.DisplayName</span>
                        </label>
                    }
                }
            </div>
        </section>

        <div class="pm-toolbar">
            <button type="submit" class="pm-btn-success">@ResourceApp.save</button>
            <button type="button" @onclick="Close" class="pm-btn-secondary">@ResourceApp.cancel</button>
        </div>
    </EditForm>
</div>
@code {
    void ChangeGroup(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int groupId))
        {
            UpdateForm.UnitGroupId = groupId;
            var selectedGroup = Groups.FirstOrDefault(g => g.Id == groupId);
            if (selectedGroup is null || string.IsNullOrWhiteSpace(UpdateForm.UnitCode) || !selectedGroup.Keys.Contains(UpdateForm.UnitCode))
            {
                UpdateForm.UnitCode = selectedGroup?.Keys.FirstOrDefault();
            }
        }
        else
        {
            UpdateForm.UnitGroupId = null;
            UpdateForm.UnitCode = null;
        }
    }
    [Parameter] public int? TaskId { get; set; }
    [Parameter] public EventCallback<bool> Saved { get; set; }

    private TaskDefinitionEditDto UpdateForm { get; set; } = new();

    private List<ActionEntity> ActionsTasks = new();
    private List<ActionTypeEntity> ActionTypesList = new();
    private List<FallEntity> FallsList = new();
    private List<LocationEntity> LocationsList = new();
    private List<TaskUnitGroup> Groups = new();
    private List<ResourceCategory> Folders = new();

    private TaskUnitGroup? SelectedGroup => Groups.FirstOrDefault(g => g.Id == UpdateForm.UnitGroupId);
    [Inject] private ITaskDefinitionQueryService TaskQueries { get; set; } = default!;


    protected override async Task OnInitializedAsync()
    {
        var (actions, actionTypes, falls, locations, unitGroups, folders) =
            await TaskService.GetLookupsAsync(CancellationToken.None);

        ActionsTasks = actions.ToList();
        ActionTypesList = actionTypes.ToList();
        FallsList = falls.ToList();
        LocationsList = locations.ToList();
        Groups = unitGroups.ToList();
        Folders = folders.ToList();
        if (TaskId is > 0)
            UpdateForm = await TaskQueries.GetForEditAsync(TaskId.Value, CancellationToken.None);
    }

    private void ToggleFolder(int folderId)
    {
        if (UpdateForm.VisibleFolderIds.Contains(folderId))
            UpdateForm.VisibleFolderIds.Remove(folderId);
        else
            UpdateForm.VisibleFolderIds.Add(folderId);
    }

    private async Task HandleSubmit()
    {
        if (UpdateForm.Id > 0)
            await TaskService.UpdateAsync(UpdateForm, CancellationToken.None);
        else
            UpdateForm.Id = await TaskService.CreateAsync(UpdateForm, CancellationToken.None);

        await Saved.InvokeAsync(true);
        Close();
    }

    private void Close()
    {
        MHD.Modal.Close();
    }
}
