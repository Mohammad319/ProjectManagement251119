@using TaskResourceBlueprints.Dto.ProjectTask
@using TaskResourceBlueprints.Entities
@using TaskResourceBlueprints.Entities.Lookups
@using TaskResourceBlueprints.Entities.Tasks
@using TaskResourceBlueprints.Services.ProjectTask
@using TaskResourceBlueprints.Services.StateGroups
@using System.Globalization
@inject ITaskDefinitionService TaskService
@inject ITaskStateGroupService StateGroupService
@inherits AppComponentBase

<div class="space-y-2 text-slate-900 dark:[color-scheme:dark] dark:text-slate-100">
    <EditForm Model="UpdateForm" OnValidSubmit="HandleSubmit" class="space-y-2">
        <DataAnnotationsValidator />

        @if (!string.IsNullOrWhiteSpace(FormErrorMessage))
        {
            <div class="rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-sm text-rose-700 shadow-sm dark:border-rose-900/70 dark:bg-rose-950/40 dark:text-rose-300">
                @FormErrorMessage
            </div>
        }

        <ValidationSummary class="rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-sm text-rose-700 shadow-sm dark:border-rose-900/70 dark:bg-rose-950/40 dark:text-rose-300" />

        <section class="@PanelClass">
            <div class="@PanelHeaderClass">
                <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">Task definition</h3>
            </div>

            <div class="space-y-1">
                <div class="space-y-1">
                    <label class="@LabelClass">@CalcResource.code</label>
                    <InputText @bind-Value="UpdateForm.Code" class="@InputClass" />
                </div>

                    <div class="grid grid-cols-1 gap-2 px-3 py-2 md:grid-cols-2 xl:grid-cols-3">
                    <label class="@LabelClass">@CalcResource.name</label>
                    <InputText @bind-Value="UpdateForm.DisplayName" class="@InputClass" />
                </div>



                <div class="space-y-1">
                    <label class="@LabelClass">@CalcResource.unit</label>
                    <InputText @bind-Value="UpdateForm.UnitCode" class="@InputClass" />
                </div>

                <div class="space-y-1">
                    <label class="@LabelClass">Status</label>
                    <InputSelect @bind-Value="UpdateForm.Status" class="@SelectClass">
                        <option value="@TaskStatusEnum.ToPlan" selected="@(UpdateForm.Status == TaskStatusEnum.ToPlan)">@TaskStatusEnum.ToPlan</option>
                        <option value="@TaskStatusEnum.ToDo" selected="@(UpdateForm.Status == TaskStatusEnum.ToDo)">@TaskStatusEnum.ToDo</option>
                        <option value="@TaskStatusEnum.UnderWorking" selected="@(UpdateForm.Status == TaskStatusEnum.UnderWorking)">@TaskStatusEnum.UnderWorking</option>
                        <option value="@TaskStatusEnum.Ready" selected="@(UpdateForm.Status == TaskStatusEnum.Ready)">@TaskStatusEnum.Ready</option>
                    </InputSelect>
                </div>
                <div class="space-y-1">
                    <label class="@LabelClass">@CalcResource.responsible</label>
                    <InputText @bind-Value="UpdateForm.Responsible" class="@InputClass" />
                </div>

                <div class="space-y-1">
                    <label class="@LabelClass">@CalcResource.changeFactor2</label>
                    <input type="text"
                           inputmode="decimal"
                           class="@InputClass"
                           value="@ChangeFactor2Text"
                           @oninput="OnChangeFactor2Input" />
                </div>
@* 
                <div class="space-y-1">
                    <label class="@LabelClass">Thickness</label>
                    <InputNumber @bind-Value="UpdateForm.Thickness" class="@InputClass" />
                </div>

                <div class="space-y-1">
                    <label class="@LabelClass">Width</label>
                    <InputNumber @bind-Value="UpdateForm.Width" class="@InputClass" />
                </div>

                <div class="space-y-1">
                    <label class="@LabelClass">Length</label>
                    <InputNumber @bind-Value="UpdateForm.Length" class="@InputClass" />
                </div>
 *@
                <div class="md:col-span-2 xl:col-span-3">
                    <label class="@ToggleRowClass">
                        <InputCheckbox @bind-Value="UpdateForm.IsActive" class="@CheckboxClass" />
                        <span class="leading-5">@CalcResource.active</span>
                    </label>
                </div>

                <div class="md:col-span-2 xl:col-span-3">
                    <label class="@ToggleRowClass">
                        <InputCheckbox @bind-Value="UpdateForm.Uncontrollable" class="@CheckboxClass" />
                        <span class="leading-5">Hide the resource and show the total cost only (UE).</span>
                    </label>
                </div>
                <div class="space-y-1 md:col-span-2 xl:col-span-3">
                    @if (StateGroups?.Count > 0)
                    {
                        <section class="@PanelClass">
                            <div class="@PanelHeaderClass">
                                <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">State groups</h3>
                                <p class="mt-0.5 text-xs text-slate-600 dark:text-slate-400">Link this task to one state per group.</p>
                            </div>

                            <div class="grid grid-cols-1 gap-2 px-3 py-2 md:grid-cols-2 xl:grid-cols-3">
                                @foreach (var group in StateGroups)
                                {
                                    var selectedStateId = UpdateForm.SelectedStateIds
                                        .FirstOrDefault(id => group.States.Any(s => s.Id == id));
                                    <div class="space-y-1">
                                        <label class="@LabelClass">@group.Name</label>
                                        <select class="@SelectClass"
                                                @onchange="(e) => OnStateGroupChanged(group, e)">
                                            <option value="">— None —</option>
                                            @foreach (var state in group.States.OrderBy(s => s.SortOrder).ThenBy(s => s.Name))
                                            {
                                                <option value="@state.Id" selected="@(selectedStateId == state.Id)">@state.Name</option>
                                            }
                                        </select>
                                    </div>
                                }
                            </div>
                        </section>
                    }

                    <section class="@PanelClass">
                        <div class="@PanelHeaderClass">
                            <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">Conversion parameters</h3>
                        </div>

                        <div class="px-3 py-2">
                            <div class="mb-2 flex justify-end">
                                <button type="button"
                                        class="inline-flex items-center justify-center rounded-lg border border-sky-600 px-3 py-1.5 text-xs font-medium text-sky-600 transition hover:bg-sky-600 hover:text-white dark:border-sky-400 dark:text-sky-300"
                                        @onclick="AddConversionParameter">
                                    + Add parameter
                                </button>
                            </div>

                            @if (!UpdateForm.ConversionParameters.Any())
                            {
                                <div class="rounded-lg border border-dashed border-slate-300 bg-slate-50 px-3 py-4 text-center text-sm text-slate-500 dark:border-slate-700 dark:bg-slate-900/40 dark:text-slate-400">
                                    No conversion parameters
                                </div>
                            }
                            else
                            {
                                <div class="overflow-x-auto rounded-lg border border-slate-200 dark:border-slate-700">
                                    <table class="min-w-full border-collapse text-sm">
                                        <thead>
                                            <tr class="border-b border-slate-200 bg-slate-50 dark:border-slate-700 dark:bg-slate-800/60">
                                                <th class="px-3 py-2 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">@CalcResource.name</th>
                                                <th class="px-3 py-2 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">@CalcResource.factor</th>
                                                <th class="px-3 py-2 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">@CalcResource.unit</th>
                                                <th class="w-12 px-3 py-2"></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @for (int i = 0; i < UpdateForm.ConversionParameters.Count; i++)
                                            {
                                                int idx = i;
                                                <tr class="border-b border-slate-200 last:border-0 dark:border-slate-700">
                                                    <td class="px-2 py-1">
                                                        <InputText @bind-Value="UpdateForm.ConversionParameters[idx].Name"
                                                                   class="block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100" />
                                                    </td>
                                                    <td class="px-2 py-1">
                                                        <InputNumber @bind-Value="UpdateForm.ConversionParameters[idx].Value"
                                                                     class="block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100" />
                                                    </td>
                                                    <td class="px-2 py-1">
                                                        <InputText @bind-Value="UpdateForm.ConversionParameters[idx].Unit"
                                                                   class="block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100" />
                                                    </td>
                                                    <td class="px-2 py-1 text-right">
                                                        <button type="button"
                                                                class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-rose-600 text-white hover:bg-rose-700 dark:bg-rose-500"
                                                                @onclick="() => UpdateForm.ConversionParameters.RemoveAt(idx)">
                                                            x
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </section>

                </div>
                <div class="space-y-1 md:col-span-2 xl:col-span-3">
                    <label class="@LabelClass">@CalcResource.note</label>
                    <InputTextArea @bind-Value="UpdateForm.Note" class="@TextAreaClass" />
                </div>

                <div class="space-y-1 md:col-span-2 xl:col-span-3">
                    <label class="@LabelClass">Admin @CalcResource.note</label>
                    <InputTextArea @bind-Value="UpdateForm.AdminNote" class="@TextAreaClass" />
                </div>
            </div>
        </section>


        <div class="flex flex-wrap items-center justify-end gap-2 pt-1">
            <button type="submit"
                    class="inline-flex items-center justify-center rounded-lg border border-emerald-600 bg-emerald-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-500/30 dark:border-emerald-500 dark:bg-emerald-500 dark:hover:bg-emerald-400">
                @ResourceApp.save
            </button>
            <button type="button"
                    @onclick="Close"
                    class="inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 shadow-sm transition hover:border-slate-400 hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-300/40 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:border-slate-600 dark:hover:bg-slate-800">
                @ResourceApp.cancel
            </button>
        </div>
    </EditForm>
</div>

@code {
    private const string PanelClass =
        "overflow-hidden rounded-xl border border-slate-200 bg-white/95 shadow-sm backdrop-blur dark:border-slate-700/80 dark:bg-slate-950";

    private const string PanelHeaderClass =
        "border-b border-slate-200 px-3 py-2 dark:border-slate-800/80";

    private const string LabelClass =
        "block text-xs font-medium text-slate-700 dark:text-slate-300";

    private const string InputClass =
        "block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition " +
        "placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 " +
        "dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500 dark:[color-scheme:dark]";

    private const string SelectClass =
        "block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition " +
        "focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 " +
        "dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:[color-scheme:dark] dark:[&_option]:bg-slate-900 dark:[&_option]:text-slate-100";

    private const string TextAreaClass =
        "block min-h-24 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition " +
        "placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 " +
        "dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500 dark:[color-scheme:dark]";

    private const string ToggleRowClass =
        "flex cursor-pointer items-center gap-2 rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-700 shadow-sm transition " +
        "hover:border-slate-300 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:hover:border-slate-600 dark:hover:bg-slate-800/80";

    private const string CheckboxClass =
        "h-4 w-4 shrink-0 rounded border-slate-300 bg-white text-sky-600 accent-sky-500 focus:ring-2 focus:ring-sky-500/30 " +
        "dark:border-slate-600 dark:bg-slate-950 dark:[color-scheme:dark]";

    [Parameter] public int? TaskId { get; set; }
    [Parameter] public EventCallback<bool> Saved { get; set; }

    private TaskDefinitionEditDto UpdateForm { get; set; } = new();

    private List<TaskResourceBlueprints.Entities.Lookups.TaskStateGroup> StateGroups = new();
    private string QuantityText { get; set; } = string.Empty;
    private string ChangeFactor2Text { get; set; } = "1";
    private string? FormErrorMessage { get; set; }

    [Inject] private ITaskDefinitionQueryService TaskQueries { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        StateGroups = await StateGroupService.GetGroupsWithStatesAsync();
        if (TaskId is > 0)
            UpdateForm = await TaskQueries.GetForEditAsync(TaskId.Value, CancellationToken.None);

        SyncNumericInputs();
    }

    private void OnStateGroupChanged(TaskResourceBlueprints.Entities.Lookups.TaskStateGroup group, ChangeEventArgs e)
    {
        foreach (var state in group.States)
            UpdateForm.SelectedStateIds.Remove(state.Id);

        if (int.TryParse(e.Value?.ToString(), out int stateId) && stateId > 0)
            UpdateForm.SelectedStateIds.Add(stateId);
    }

    private async Task HandleSubmit()
    {
        if (!TryParseNullableDecimalInput(QuantityText, out var quantity) ||
            !TryParseDecimalInput(ChangeFactor2Text, out var factor2))
        {
            FormErrorMessage = "Quantity, Price production, Change Factor1 and Change Factor2 must be valid numbers.";
            return;
        }

        FormErrorMessage = null;
        UpdateForm.Quantity = quantity;
        UpdateForm.ChangeFactor2 = factor2;

        if (UpdateForm.Id > 0)
            await TaskService.UpdateAsync(UpdateForm, CancellationToken.None);
        else
            UpdateForm.Id = await TaskService.CreateAsync(UpdateForm, CancellationToken.None);

        await Saved.InvokeAsync(true);
        Close();
    }

    private void Close()
    {
        MHD.Modal.Close();
    }


    private void OnQuantityInput(ChangeEventArgs e)
    {
        QuantityText = e.Value?.ToString() ?? string.Empty;
        if (TryParseNullableDecimalInput(QuantityText, out var value))
        {
            UpdateForm.Quantity = value;
            FormErrorMessage = null;
        }
    }

    private void OnChangeFactor2Input(ChangeEventArgs e)
    {
        ChangeFactor2Text = e.Value?.ToString() ?? string.Empty;
        if (TryParseDecimalInput(ChangeFactor2Text, out var value))
        {
            UpdateForm.ChangeFactor2 = value;
            FormErrorMessage = null;
        }
    }

    private void SyncNumericInputs()
    {
        QuantityText = FormatNullableDecimal(UpdateForm.Quantity);
        ChangeFactor2Text = FormatDecimal(UpdateForm.ChangeFactor2);
    }

    private static string FormatDecimal(decimal value)
        => NumericDisplayHelper.Format(value);

    private static string FormatNullableDecimal(decimal? value)
        => NumericDisplayHelper.Format(value);

    private static bool TryParseDecimalInput(string? text, out decimal value)
    {
        if (decimal.TryParse(text, NumberStyles.Number, CultureInfo.CurrentCulture, out value))
            return true;

        var normalized = text?.Replace(',', '.');
        return decimal.TryParse(normalized, NumberStyles.Number, CultureInfo.InvariantCulture, out value);
    }

    private static bool TryParseNullableDecimalInput(string? text, out decimal? value)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            value = null;
            return true;
        }

        if (TryParseDecimalInput(text, out var parsed))
        {
            value = parsed;
            return true;
        }

        value = null;
        return false;
    }

    private void AddConversionParameter()
    {
        UpdateForm.ConversionParameters.Add(new ProjectManagement.Shared.Base.Calculation.TaskConversionParameter
        {
            Name = string.Empty,
            Unit = string.Empty,
            Value = 1m
        });
    }
}
