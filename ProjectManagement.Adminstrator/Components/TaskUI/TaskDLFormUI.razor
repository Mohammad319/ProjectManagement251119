@using TaskResourceBlueprints.Dto.ProjectTask
@using TaskResourceBlueprints.Entities
@using TaskResourceBlueprints.Entities.Lookups
@using TaskResourceBlueprints.Entities.Resources
@using TaskResourceBlueprints.Entities.Tasks
@using TaskResourceBlueprints.Services.ProjectTask
@inject ITaskDefinitionService TaskService
@inherits AppComponentBase
@using CC = ProjectManagement.Adminstrator.Constants.CssClassesV3
@using CsS = ProjectManagement.Shared.Constant.CssClasses

<div class="@CsS.Modal.Body">
    <EditForm Model="UpdateForm" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="@CsS.Grid.Col.MD4">
            <div>
                <label class="@CsS.Form.Label">Action</label>
                <InputSelect @bind-Value="UpdateForm.ActionId" class="@CsS.Input.Select">
                    <option value="">Select Action</option>
                    @if (ActionsTasks != null)
                    {
                        foreach (var action in ActionsTasks)
                        {
                            <option value="@action.Id">@action.Name</option>
                        }
                    }
                </InputSelect>
            </div>

            <div>
                <label class="@CsS.Form.Label">Location</label>
                <InputSelect @bind-Value="UpdateForm.LocationId" class="@CsS.Input.Select">
                    <option value="">Select Location</option>
                    @if (LocationsList != null)
                    {
                        foreach (var action in LocationsList)
                        {
                            <option value="@action.Id">@action.Name</option>
                        }
                    }
                </InputSelect>
            </div>

            <div>
                <label class="@CsS.Form.Label">Fall</label>
                <InputSelect @bind-Value="UpdateForm.FallId" class="@CsS.Input.Select">
                    <option value="">Select Fall</option>
                    @if (FallsList != null)
                    {
                        foreach (var action in FallsList)
                        {
                            <option value="@action.Id">@action.Name</option>
                        }
                    }
                </InputSelect>
            </div>

            <div>
                <label class="@CsS.Form.Label">ActionType</label>
                <InputSelect @bind-Value="UpdateForm.ActionTypeId" class="@CsS.Input.Select">
                    <option value="">Select ActionType</option>
                    @if (ActionTypesList != null)
                    {
                        foreach (var action in ActionTypesList)
                        {
                            <option value="@action.Id">@action.Name</option>
                        }
                    }
                </InputSelect>
            </div>

            <div>
                <label class="@CsS.Form.Label">@CalcResource.code</label>
                <InputText @bind-Value="UpdateForm.Code" class="@CsS.Input.Text" />
            </div>

            <div>
                <label class="@CsS.Form.Label">@CalcResource.name</label>
                <InputText @bind-Value="UpdateForm.DisplayName" class="@CsS.Input.Text" />
            </div>
            <div>
                <label class="@CsS.Form.Label">@CalcResource.responsible</label>
                <InputText @bind-Value="UpdateForm.Responsible" class="@CsS.Input.Text" />
            </div>
            <div>
                <label class="@CsS.Form.Label">Groups</label>
                <select class="@CsS.Input.Select" @onchange="ChangeGroup">
                    <option value="">Select Group</option>
                    @if (Groups != null)
                    {
                        foreach (var action in Groups)
                        {
                            <option value="@action.Id" selected="@(UpdateForm.UnitGroupId == action.Id)">@action.DisplayName</option>
                        }
                    }
                </select>
            </div>

            @if (SelectedGroup != null && UpdateForm.UnitGroupId.HasValue)
            {
                <div>
                    <label class="@CsS.Form.Label">Units</label>
                    <InputSelect @bind-Value="UpdateForm.UnitCode" class="@CsS.Input.Select">
                        <option value="">Select Unit</option>
                        @foreach (var item in SelectedGroup.Keys)
                        {
                            <option value="@item">@item</option>
                        }
                    </InputSelect>
                </div>
            }
            <div>
                <label class="@CsS.Form.Label">Status</label>
                <InputSelect @bind-Value="UpdateForm.Status" class="@CsS.Input.Select">
                    <option value="@TaskStatusEnum.ToPlan" selected="@(UpdateForm.Status == TaskStatusEnum.ToPlan)">@TaskStatusEnum.ToPlan</option>
                    <option value="@TaskStatusEnum.ToDo" selected="@(UpdateForm.Status == TaskStatusEnum.ToDo)">@TaskStatusEnum.ToDo</option>
                    <option value="@TaskStatusEnum.UnderWorking" selected="@(UpdateForm.Status == TaskStatusEnum.UnderWorking)">@TaskStatusEnum.UnderWorking</option>
                    <option value="@TaskStatusEnum.Ready" selected="@(UpdateForm.Status == TaskStatusEnum.Ready)">@TaskStatusEnum.Ready</option>

                </InputSelect>
            </div>
            <div>
                <label class="@CsS.Form.Label">@CalcResource.quantity</label>
                <InputNumber @bind-Value="UpdateForm.Quantity" class="@CsS.Input.Number" />
            </div>

            <div>
                <label class="@CsS.Form.Label">@CalcResource.changeFactor1</label>
                <InputNumber @bind-Value="UpdateForm.ChangeFactor1" class="@CsS.Input.Number" />
            </div>

            <div>
                <label class="@CsS.Form.Label">@CalcResource.changeFactor2</label>
                <InputNumber @bind-Value="UpdateForm.ChangeFactor2" class="@CsS.Input.Number" />
            </div>

            <div>
                <label class="@CsS.Form.Label">Thickness</label>
                <InputNumber @bind-Value="UpdateForm.Thickness" class="@CsS.Input.Number" />
            </div>
            <div>
                <label class="@CsS.Form.Label">Width</label>
                <InputNumber @bind-Value="UpdateForm.Width" class="@CsS.Input.Number" />
            </div>
            <div>
                <label class="@CsS.Form.Label">Length</label>
                <InputNumber @bind-Value="UpdateForm.Length" class="@CsS.Input.Number" />
            </div>

            <div class="@CsS.Form.CheckWrapper">
                <InputCheckbox @bind-Value="UpdateForm.IsActive" class="@CsS.Input.Check" />
                <label class="@CsS.Form.Label">@CalcResource.active</label>
            </div>
            <div class="@CsS.Form.CheckWrapper">
                <InputCheckbox @bind-Value="UpdateForm.Uncontrollable" class="@CsS.Input.Check" />
                <label class="@CsS.Form.Label">Hide the resource and show the total cost only (UE).</label>
            </div>
            <div class="@CsS.Grid.Span.MD3">
                <label class="@CsS.Form.Label">@CalcResource.note</label>
                <InputTextArea @bind-Value="UpdateForm.Note" class="@CsS.Input.Text" />
            </div>
            <div class="@CsS.Grid.Span.MD3">
                <label class="@CsS.Form.Label">Admin @CalcResource.note</label>
                <InputTextArea @bind-Value="UpdateForm.AdminNote" class="@CsS.Input.Text" />
            </div>
        </div>
        <div class="@CssClasses.Layout.FlexWrap">
            @if (Folders != null)
            {
                foreach (var folder in Folders)
                {
                    <div class="@CsS.Layout.FlexItemsCenter">
                        <input type="checkbox" @onchange="() => ToggleFolder(folder.Id)" class="@CsS.Input.Check" checked="@(UpdateForm.VisibleFolderIds.Any(x => x == folder.Id))" />
                        <label class="@CsS.Form.Label">@folder.DisplayName</label>
                    </div>
                }
            }
        </div>

        <div class="@CsS.Modal.Footer">
            <button type="submit" class="@CsS.Btn.Outline.Success">@ResourceApp.save</button>
            <button type="button" @onclick="Close" class="@CsS.Btn.Outline.Secondary">@ResourceApp.cancel</button>
        </div>
    </EditForm>
</div>
@code {
    void ChangeGroup(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int groupId))
        {
            UpdateForm.UnitGroupId = groupId;
            var selectedGroup = Groups.FirstOrDefault(g => g.Id == groupId);
            if (selectedGroup is null || string.IsNullOrWhiteSpace(UpdateForm.UnitCode) || !selectedGroup.Keys.Contains(UpdateForm.UnitCode))
            {
                UpdateForm.UnitCode = selectedGroup?.Keys.FirstOrDefault();
            }
        }
        else
        {
            UpdateForm.UnitGroupId = null;
            UpdateForm.UnitCode = null;
        }
    }
    [Parameter] public int? TaskId { get; set; }
    [Parameter] public EventCallback<bool> Saved { get; set; }

    private TaskDefinitionEditDto UpdateForm { get; set; } = new();

    private List<ActionEntity> ActionsTasks = new();
    private List<ActionTypeEntity> ActionTypesList = new();
    private List<FallEntity> FallsList = new();
    private List<LocationEntity> LocationsList = new();
    private List<TaskUnitGroup> Groups = new();
    private List<ResourceCategory> Folders = new();

    private TaskUnitGroup? SelectedGroup => Groups.FirstOrDefault(g => g.Id == UpdateForm.UnitGroupId);
    [Inject] private ITaskDefinitionQueryService TaskQueries { get; set; } = default!;


    protected override async Task OnInitializedAsync()
    {
        var (actions, actionTypes, falls, locations, unitGroups, folders) =
            await TaskService.GetLookupsAsync(CancellationToken.None);

        ActionsTasks = actions.ToList();
        ActionTypesList = actionTypes.ToList();
        FallsList = falls.ToList();
        LocationsList = locations.ToList();
        Groups = unitGroups.ToList();
        Folders = folders.ToList();
        if (TaskId is > 0)
            UpdateForm = await TaskQueries.GetForEditAsync(TaskId.Value, CancellationToken.None);
    }

    private void ToggleFolder(int folderId)
    {
        if (UpdateForm.VisibleFolderIds.Contains(folderId))
            UpdateForm.VisibleFolderIds.Remove(folderId);
        else
            UpdateForm.VisibleFolderIds.Add(folderId);
    }

    private async Task HandleSubmit()
    {
        if (UpdateForm.Id > 0)
            await TaskService.UpdateAsync(UpdateForm, CancellationToken.None);
        else
            UpdateForm.Id = await TaskService.CreateAsync(UpdateForm, CancellationToken.None);

        await Saved.InvokeAsync(true);
        Close();
    }

    private void Close()
    {
        MHD.Modal.Close();
    }
}
