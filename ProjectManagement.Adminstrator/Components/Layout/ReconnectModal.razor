<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

<dialog id="components-reconnect-modal" data-nosnippet class="rounded-2xl border border-slate-200 bg-white p-0 text-slate-900 shadow-2xl dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100">
    <div class="flex w-full min-w-[18rem] max-w-sm flex-col items-center gap-3 p-6 sm:p-7">
        <div class="components-rejoining-animation" aria-hidden="true">
            <div></div>
            <div></div>
        </div>

        <p class="components-reconnect-first-attempt-visible text-center text-sm text-slate-600 dark:text-slate-300">
            Rejoining the server...
        </p>
        <p class="components-reconnect-repeated-attempt-visible text-center text-sm text-slate-600 dark:text-slate-300">
            Rejoin failed... trying again in <span id="components-seconds-to-next-attempt" class="font-semibold text-slate-900 dark:text-slate-100"></span> seconds.
        </p>
        <p class="components-reconnect-failed-visible text-center text-sm text-rose-600 dark:text-rose-300">
            Failed to rejoin.<br />Please retry or reload the page.
        </p>

        <button id="components-reconnect-button"
                class="components-reconnect-failed-visible inline-flex items-center justify-center rounded-xl border border-blue-200 bg-blue-50 px-5 py-2 text-sm font-medium text-blue-700 transition hover:bg-blue-100 dark:border-blue-800 dark:bg-blue-950/60 dark:text-blue-300 dark:hover:bg-blue-900/70">
            Retry
        </button>

        <p class="components-pause-visible text-center text-sm text-amber-700 dark:text-amber-300">
            The session has been paused by the server.
        </p>
        <button id="components-resume-button"
                class="components-pause-visible inline-flex items-center justify-center rounded-xl border border-emerald-200 bg-emerald-50 px-5 py-2 text-sm font-medium text-emerald-700 transition hover:bg-emerald-100 dark:border-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300 dark:hover:bg-emerald-900/70">
            Resume
        </button>
        <p class="components-resume-failed-visible text-center text-sm text-rose-600 dark:text-rose-300">
            Failed to resume the session.<br />Please reload the page.
        </p>
    </div>
</dialog>
