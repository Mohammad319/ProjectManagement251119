@using Microsoft.JSInterop
@using ProjectManagement.Adminstrator.Components.Shared
@using System.Globalization
@inject NavigationManager _navigationManager
@inject IJSRuntime JS
@inherits AppComponentBase

<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 shadow-sm backdrop-blur dark:border-slate-800 dark:bg-slate-950/95">
    <div class="mx-auto flex w-full max-w-[1800px] items-center justify-between gap-3.5 px-3.5 py-2 sm:px-3.5 lg:px-3.5">
        <a class="flex min-w-0 items-center gap-3" href="/" aria-label="ProjectManagement Admin home">
            <div class="flex h-10 items-center justify-center rounded-xl border border-slate-200 bg-white px-3 shadow-sm dark:border-slate-800 dark:bg-slate-950">
                <img src="Icons/Logo.png" alt="Logo" class="h-8 w-auto" />
            </div>

            <div class="min-w-0">
                <div class="truncate text-sm font-semibold text-slate-900 dark:text-white">
                    ProjectManagement Admin
                </div>
                <div class="truncate text-xs text-slate-500 dark:text-slate-400">
                    Site administration workspace
                </div>
            </div>
        </a>

        <div class="flex flex-wrap items-center justify-end gap-2">
            <a href="/"
                   title="Home"
                   aria-label="Home"
                   class="inline-flex h-9 items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 text-sm font-medium text-slate-700 shadow-sm transition hover:border-slate-300 hover:bg-slate-50 hover:text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:border-slate-600 dark:hover:bg-slate-800 dark:hover:text-white">
                <span class="text-base" aria-hidden="true">⌂</span>
                <span class="hidden sm:inline">Home</span>
            </a>

            <button type="button"
                    @onclick="ChangeLanguage"
                    title="Switch language"
                    aria-label="Switch language"
                    class="inline-flex h-9 items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 text-sm font-medium text-slate-700 shadow-sm transition hover:border-slate-300 hover:bg-slate-50 hover:text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:border-slate-600 dark:hover:bg-slate-800 dark:hover:text-white">
                <span class="text-base leading-none" aria-hidden="true">
                    @((MarkupString)(CultureInfo.CurrentUICulture.Name == "en-US" ? Icons.SE : Icons.EN))
                </span>
                <span class="hidden sm:inline">
                    @(CultureInfo.CurrentUICulture.Name == "en-US" ? "Svenska" : "English")
                </span>
            </button>

            <button type="button"
                    @onclick="ToggleTheme"
                    title="Toggle theme"
                    aria-label="Toggle theme"
                    class="inline-flex h-9 items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 text-sm font-medium text-slate-700 shadow-sm transition hover:border-slate-300 hover:bg-slate-50 hover:text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:border-slate-600 dark:hover:bg-slate-800 dark:hover:text-white">
                <span class="text-base leading-none" aria-hidden="true">
                    @((MarkupString)(IsDark ? Icons.Sun : Icons.DarkMode))
                </span>
                <span class="hidden sm:inline">@(IsDark ? "Light" : "Dark")</span>
            </button>

            <AuthorizeView>
                <Authorized>
                    <button type="button"
                            @onclick="PersonalSettingFun"
                            title="Personal settings"
                            aria-label="Personal settings"
                            class="inline-flex h-9 items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 text-sm font-medium text-slate-700 shadow-sm transition hover:border-slate-300 hover:bg-slate-50 hover:text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:border-slate-600 dark:hover:bg-slate-800 dark:hover:text-white">
                        <span class="text-base leading-none" aria-hidden="true">@((MarkupString)Icons.Person)</span>
                        <span class="hidden sm:inline">Profile</span>
                    </button>

                    <form action="Account/Logout" method="post" class="inline-block">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit"
                                title="Sign out"
                                aria-label="Sign out"
                                class="inline-flex h-9 items-center gap-2 rounded-xl border border-red-200 bg-red-50 px-3 text-sm font-medium text-red-700 shadow-sm transition hover:border-red-300 hover:bg-red-100 hover:text-red-800 dark:border-red-900/60 dark:bg-red-950/40 dark:text-red-300 dark:hover:border-red-800 dark:hover:bg-red-950/60 dark:hover:text-red-200">
                            <span class="text-base leading-none" aria-hidden="true">@((MarkupString)Icons.Logout)</span>
                            <span class="hidden sm:inline">Sign out</span>
                        </button>
                    </form>
                </Authorized>

                <NotAuthorized>
                    <a href="/Account/Login"
                           title="Sign in"
                           aria-label="Sign in"
                           class="inline-flex h-9 items-center rounded-xl bg-blue-600 px-3.5 text-sm font-medium text-white shadow-sm transition hover:bg-blue-700 dark:bg-blue-500 dark:hover:bg-blue-400">
                        Sign in
                    </a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</header>

@if (!string.IsNullOrEmpty(Page))
{
    <div aria-hidden="true">
        <div class="fixed inset-0 z-50 bg-slate-950/50 backdrop-blur-sm" @onclick="CloseDialog"></div>

        <div class="fixed inset-y-0 right-0 z-[60] flex w-full justify-end p-3 sm:p-3.5">
            <div class="flex h-full w-full max-w-2xl flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-2xl dark:border-slate-800 dark:bg-slate-900">
                <div class="flex items-start justify-between gap-3.5 border-b border-slate-200 px-3.5 py-2 dark:border-slate-800">
                    <div>
                        <div class="text-[11px] font-semibold uppercase tracking-[0.24em] text-blue-600 dark:text-sky-300/80">
                            Account
                        </div>
                        <h2 class="mt-1 text-lg font-semibold text-slate-900 dark:text-white">
                            Personal settings
                        </h2>
                        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
                            Manage your profile, authentication, recovery, and account preferences.
                        </p>
                    </div>

                    <button type="button"
                            @onclick="CloseDialog"
                            aria-label="Close settings"
                            class="inline-flex h-9 w-10 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-600 transition hover:bg-slate-50 hover:text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700 dark:hover:text-white">
                        ×
                    </button>
                </div>

                <div class="flex-1 overflow-auto px-3.5 py-2">
                    @if (Page == "identity")
                    {
                        <PersonalSettings />
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string Page = string.Empty;
    private string? currentUrl;
    private bool IsDark;

    protected override void OnInitialized()
    {
        currentUrl = _navigationManager.ToBaseRelativePath(_navigationManager.Uri);
        _navigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = _navigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    private async Task ToggleTheme()
    {
        var newTheme = await JS.InvokeAsync<string>("toggleDarkClass");
        IsDark = newTheme == "dark";
        await InvokeAsync(StateHasChanged);
    }

    private void PersonalSettingFun() => Page = "identity";

    private void CloseDialog() => Page = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            var currentTheme = await JS.InvokeAsync<string>("getCurrentTheme");
            IsDark = currentTheme == "dark";
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
        }
    }

    private async Task ChangeLanguage()
    {
        var newCulture = CultureInfo.CurrentUICulture.Name == "sv-SE" || string.IsNullOrEmpty(CultureInfo.CurrentUICulture.Name)
            ? "en-US"
            : "sv-SE";

        await JS.InvokeVoidAsync("blazorCulture.set", newCulture);
        _navigationManager.NavigateTo(_navigationManager.Uri, forceLoad: true);
    }

    public void Dispose()
    {
        _navigationManager.LocationChanged -= OnLocationChanged;
    }
}
