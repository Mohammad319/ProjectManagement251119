@using Microsoft.JSInterop
@using ProjectManagement.Adminstrator.Components.Shared
@using System.Globalization
@inject NavigationManager _navigationManager
@inject IJSRuntime JS
@attribute [Authorize(Roles = PMRolesConst.APP.AdminManger)]
@inherits AppComponentBase

<header class="pm-topbar">
    <div class="pm-topbar-inner">
        <a class="pm-brand" href="/" aria-label="ProjectManagement Admin home">
            <span class="pm-brand-logo">
                <img src="Icons/Logo.png" alt="Logo" class="h-8 w-auto" />
            </span>

            <span class="min-w-0">
                <span class="pm-brand-title">ProjectManagement.Adminstrator</span>
                <span class="pm-brand-subtitle">Shared catalogs, tenant scope, logs, and control workflows.</span>
            </span>
        </a>

        <button type="button"
                class="pm-btn pm-btn-secondary md:hidden"
                @onclick="ToggleNavMenu"
                aria-controls="navbarMenu"
                aria-expanded="@isNavOpen"
                aria-label="Toggle navigation">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
        </button>

        <div id="navbarMenu" class="@(isNavOpen ? "flex" : "hidden") w-full flex-col gap-2 md:flex md:w-auto md:flex-row md:items-center">
            <span class="pm-kbd hidden lg:inline-flex">Admin</span>

            <button type="button"
                    class="pm-btn pm-btn-secondary"
                    @onclick="ChangeLanguage"
                    title="Switch language"
                    aria-label="Switch language">
                <span class="text-base" aria-hidden="true">@((MarkupString)(CultureInfo.CurrentCulture.Name == "en-US" ? Icons.SE : Icons.EN))</span>
                <span>@(CultureInfo.CurrentCulture.Name == "en-US" ? "Svenska" : "English")</span>
            </button>

            <button type="button"
                    class="pm-btn pm-btn-secondary"
                    @onclick="ToggleTheme"
                    title="Toggle theme"
                    aria-label="Toggle theme">
                <span class="text-base" aria-hidden="true">@((MarkupString)(IsDark ? Icons.Sun : Icons.DarkMode))</span>
                <span>@(IsDark ? "Light" : "Dark")</span>
            </button>

            <AuthorizeView>
                <Authorized>
                    <button type="button"
                            class="pm-btn pm-btn-secondary"
                            @onclick="PersonalSettingFun"
                            title="Personal settings"
                            aria-label="Personal settings">
                        <span class="text-base" aria-hidden="true">@((MarkupString)Icons.Person)</span>
                        <span>Profile</span>
                    </button>

                    <form action="Account/Logout" method="post" class="inline">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit"
                                class="pm-btn pm-btn-danger"
                                title="Sign out"
                                aria-label="Sign out">
                            <span class="text-base" aria-hidden="true">@((MarkupString)Icons.Logout)</span>
                            <span>Sign out</span>
                        </button>
                    </form>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>
</header>

@if (!string.IsNullOrEmpty(Page))
{
    <div aria-hidden="true">
        <div class="fixed inset-0 z-50 bg-slate-950/55 backdrop-blur-sm" @onclick="CloseDialog"></div>
        <div class="fixed inset-y-0 right-0 z-[60] flex w-full justify-end p-3 sm:p-5">
            <div class="flex h-full w-full max-w-2xl flex-col overflow-hidden rounded-[28px] border border-slate-200 bg-white shadow-2xl dark:border-slate-800 dark:bg-slate-900">
                <div class="flex items-start justify-between gap-4 border-b border-slate-200 px-5 py-4 dark:border-slate-800">
                    <div>
                        <div class="pm-page-kicker">Account</div>
                        <h2 class="mt-1 text-xl font-semibold text-slate-950 dark:text-white">Personal settings</h2>
                        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Manage profile data, password, recovery, and sign-in settings.</p>
                    </div>

                    <button type="button"
                            class="pm-btn pm-btn-soft px-3 py-2"
                            @onclick="CloseDialog"
                            aria-label="Close settings">
                        ×
                    </button>
                </div>

                <div class="flex-1 overflow-auto px-5 py-5">
                    @if (Page == "identity")
                    {
                        <PersonalSettings />
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string Page = string.Empty;
    private string? currentUrl;
    private bool IsDark;
    private bool isNavOpen;

    [Parameter] public EventCallback<string> OnMenuClick { get; set; }

    protected override void OnInitialized()
    {
        currentUrl = _navigationManager.ToBaseRelativePath(_navigationManager.Uri);
        _navigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = _navigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    private async Task ToggleTheme()
    {
        var newTheme = await JS.InvokeAsync<string>("toggleDarkClass");
        IsDark = newTheme == "dark";
        await InvokeAsync(StateHasChanged);
    }

    private void PersonalSettingFun()
    {
        Page = "identity";
        isNavOpen = false;
    }

    private void ToggleNavMenu() => isNavOpen = !isNavOpen;

    private void CloseDialog() => Page = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var currentTheme = await JS.InvokeAsync<string>("getCurrentTheme");
            IsDark = currentTheme == "dark";
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
        }
    }

    private async Task ChangeLanguage()
    {
        var newCulture = CultureInfo.CurrentCulture.Name == "sv-SE" || string.IsNullOrEmpty(CultureInfo.CurrentCulture.Name)
            ? "en-US"
            : "sv-SE";

        await JS.InvokeVoidAsync("blazorCulture.set", newCulture);
        _navigationManager.NavigateTo(_navigationManager.Uri, forceLoad: true);
    }

    public void Dispose()
    {
        _navigationManager.LocationChanged -= OnLocationChanged;
    }
}
