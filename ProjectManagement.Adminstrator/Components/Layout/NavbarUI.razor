@using Microsoft.JSInterop
@using ProjectManagement.Adminstrator.Components.AppUser
@using ProjectManagement.Adminstrator.Components.Folder
@using ProjectManagement.Adminstrator.Components.Shared
@using System.Globalization
@inject NavigationManager _navigationManager
@attribute [Authorize(Roles = PMRolesConst.APP.AdminManger)]
@inherits AppComponentBase
@inject IJSRuntime JS

<nav class="shadow-md bg-white dark:bg-gray-800">
    <div class="w-full flex flex-wrap items-center justify-between p-0.5">
        <a class="flex items-center">
            <img src="Icons/Logo.png" alt="Logo" class="h-8 w-auto" />
        </a>
        <button class="text-gray-700 dark:text-white md:hidden focus:outline-none"
                @onclick="ToggleNavMenu" aria-controls="navbarMenu"
                aria-expanded="@isNavOpen" aria-label="Toggle navigation">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
        </button>
        <div class="@($"w-full md:flex md:items-center md:w-auto {(isNavOpen ? "" : "hidden")}")" id="navbarMenu">
            <ul class="flex flex-col mt-0.5 md:flex-row md:space-x-3 md:mt-0 w-full md:justify-end">
                <li class="text-right md:text-left flex-grow">
                    <button class="btn nav-link" @onclick="ChangeLanguage">
                        @((MarkupString)(CultureInfo.CurrentCulture.Name == "en-US" ? Icons.SE : Icons.EN))
                    </button>
                </li>
                    <li class="text-right md:text-left flex-grow">
                        <button class="btn nav-link" @onclick="ToggleTheme">
                            <span>@((MarkupString)(IsDark ? Icons.Sun : Icons.DarkMode))</span>
                        </button>
                    </li>

                    <AuthorizeView>
                        <Authorized>
                            <li class="text-right md:text-left flex-grow">
                                <button class="btn nav-link" @onclick="PersonalSettingFun">
                                    @((MarkupString)Icons.Person)
                                </button>
                            </li>
                            <li class="text-right md:text-left flex-grow">
                                <form action="Account/Logout" method="post" class="inline">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                                    <button type="submit" class="btn nav-link flex items-center space-x-2">
                                        <span aria-hidden="true">@((MarkupString)Icons.Logout)</span>
                                    </button>
                                </form>
                            </li>
                        </Authorized>
                    </AuthorizeView>
                </ul>
            </div>
        </div>
    </nav>
    @if (!string.IsNullOrEmpty(Page))
{
    <div aria-hidden="true">
        <div class="fixed inset-0 bg-black/50 backdrop-blur-[2px]"></div>
        <div class="fixed inset-0 flex items-center justify-center pointer-events-none" style="z-index:17;">
            <div class="pointer-events-auto w-[90vw] h-[90vh] rounded-2xl bg-white text-slate-900 shadow-2xl ring-1 ring-black/5
                        dark:bg-slate-800 dark:text-slate-100 dark:ring-white/10 box-border flex flex-col overflow-hidden">
                                <div class="p-5 flex items-start justify-between gap-4">
                    <h2 class="text-xl font-semibold">Setting</h2>
                    <button type="button" class="rounded-lg px-2.5 py-1.5 text-sm ring-1 ring-slate-300/60
                           hover:bg-slate-100 dark:ring-slate-700/60 dark:hover:bg-slate-700/50"
                            @onclick="() => Page=string.Empty">
                        X
                    </button>
                </div>
                <div class="flex-1 p-5 overflow-auto">
 
                    @if (Page == "identity")
                    {
                        <PersonalSettings></PersonalSettings>
                    }
                </div>

            </div>
        </div>
    </div>
}

@code {
    string Page = string.Empty;
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = _navigationManager.ToBaseRelativePath(_navigationManager.Uri);
        _navigationManager.LocationChanged += OnLocationChanged;
    }
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = _navigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }
    private bool IsDark;
    private async Task ToggleTheme()
    {
        var newTheme = await JS.InvokeAsync<string>("toggleDarkClass");
        IsDark = !IsDark;
        StateHasChanged();
    }
    //--------------
    private bool isNavOpen = true;
    [Parameter] public EventCallback<string> OnMenuClick { get; set; }
    private void Setting(string ty = "control") => Page = ty;
    private void PersonalSettingFun() => Page = "identity";

    private void ToggleNavMenu()
    {
        isNavOpen = !isNavOpen;
    }

    void TermsOfUse() { }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var currentTheme = await JS.InvokeAsync<string>("getCurrentTheme");
            IsDark = currentTheme == "dark";
        }
    }

    async Task ChangeLanguage()
    {
        var newCulture = CultureInfo.CurrentCulture.Name == "sv-SE" || string.IsNullOrEmpty(CultureInfo.CurrentCulture.Name)
            ? "en-US"
            : "sv-SE";

        await JS.InvokeVoidAsync("blazorCulture.set", newCulture);
        _navigationManager.NavigateTo(_navigationManager.Uri, forceLoad: true);
    }
}
