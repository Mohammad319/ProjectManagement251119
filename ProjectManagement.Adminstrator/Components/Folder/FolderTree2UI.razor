    <ResourcesBrowser EnableFolderContext="true">
        <RowActions Context="r">
            <button class="inline-flex items-center justify-center rounded-xl border border-amber-500 bg-amber-500 px-3 py-2 text-xs font-medium text-white transition hover:bg-amber-600 focus:outline-none focus:ring-2 focus:ring-amber-400/30 disabled:cursor-not-allowed disabled:opacity-60 dark:border-amber-400 dark:bg-amber-400 dark:text-slate-950 dark:hover:bg-amber-300 px-1 py-1 text-xs" title="Update" @onclick="() => UpdateForm(r)">@Icons.Edit</button>
            <button class="inline-flex items-center justify-center rounded-xl border border-rose-600 bg-rose-600 px-3 py-2 text-xs font-medium text-white transition hover:bg-rose-700 focus:outline-none focus:ring-2 focus:ring-rose-500/30 disabled:cursor-not-allowed disabled:opacity-60 dark:border-rose-500 dark:bg-rose-500 dark:hover:bg-rose-400 px-1 py-1 text-xs" title="Remove" @onclick="() => Remove(r)">@Icons.Delete</button>
        </RowActions>
    </ResourcesBrowser>
</div>

@code {
    private List<ResourceCategory> folders = new();
    private List<ResourceDefinition> resourcesToShow = new();

    protected override async Task OnInitializedAsync()
    {
        folders = await ResourceFolderService.GetAllAsync();
    }

    async Task Refreeh() { await UpdateResourcesAsync(); }


    void UpdateForm(ResourceDefinition model) => MHD.Modal.ShowComponent<ResourceFormDLUI>(model.Id == 0 ? ResourceApp.newItem : ResourceApp.update,
        new Dictionary<string, object>
        {
            [nameof(ResourceFormDLUI.model)] = model,
            [nameof(ResourceFormDLUI.CallBack)] = EventCallback.Factory.Create<bool>(this, Refreeh),
        }, DialogSize.ExtraLarge);

    void Remove(ResourceDefinition model) => MHD.DeleteMessage(model.Name, EventCallback.Factory.Create(this, () => DeleteR(model.Id)));

    async Task DeleteR(int id)
    {
        if (await ResourceService.DeleteAsync(id))
        {
            await UpdateResourcesAsync();
            StateHasChanged();
        }
    }

    async Task OnSaved()
    {
        await UpdateResourcesAsync();
    }

    private async Task UpdateResourcesAsync()
    {
        resourcesToShow.Clear();
        resourcesToShow.AddRange(await ResourceFolderService.GetResourcesAsync(selectedFolderIds));
    }

    private HashSet<int> selectedFolderIds = new();
}
