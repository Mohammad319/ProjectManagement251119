@using ContextMenuMHD
@using Microsoft.EntityFrameworkCore
@using TaskResourceBlueprints.Entities
@using TaskResourceBlueprints.Entities.Resources
@using TaskResourceBlueprints.Infrastructure
@using TaskResourceBlueprints.Services.Resource
@using ProjectManagement.Adminstrator.Components.Property.PropertyGroups
@using ProjectManagement.Adminstrator.Components.ResourceUI
@using ProjectManagement.Adminstrator.Constants
@using ProjectManagement.Adminstrator.Helper
@inherits AppComponentBase
@inject IResourceBlueprintsService ResourceService
@inject IResourceCategoryService ResourceFolderService

<div class="pm-page">
    <div class="pm-page-header">
        <div>
            <h2 class="pm-page-title">Resources</h2>
            <p class="pm-page-subtitle">Manage folders, resources, and related properties from one view.</p>
        </div>

        <div class="pm-action-stack">
            <button type="button" class="pm-btn-primary" @onclick="PropertyGroups">@AppLoc["properties"]</button>
        </div>
    </div>

    <ResourcesBrowser EnableFolderContext="true">
        <RowActions Context="r">
            <button class="pm-btn-primary !px-3 !py-1.5 !text-xs" title="Property" @onclick="() => Property(r)">Property</button>
            <button class="pm-btn-warning !px-3 !py-1.5 !text-xs" title="Update" @onclick="() => UpdateForm(r)">@Icons.Edit</button>
            <button class="pm-btn-danger !px-3 !py-1.5 !text-xs" title="Remove" @onclick="() => Remove(r)">@Icons.Delete</button>
        </RowActions>
    </ResourcesBrowser>
</div>

@code {
    private List<ResourceCategory> folders = new();
    private List<ResourceDefinition> resourcesToShow = new();

    protected override async Task OnInitializedAsync()
    {
        folders = await ResourceFolderService.GetAllAsync();
    }

    async Task Refreeh() { await UpdateResourcesAsync(); }

    void PropertyGroups() => MHD.Modal.ShowComponent<PropertyGroupsUI>("Property Groups");

    void Property(ResourceDefinition model)
    {
        MHD.Modal.ShowComponent<ResourcePropertiesManager>(model.Name,
        new Dictionary<string, object>
        {
            [nameof(ResourcePropertiesManager.ResourceId)] = model.Id,
        });
    }

    void UpdateForm(ResourceDefinition model) => MHD.Modal.ShowComponent<ResourceFormDLUI>(model.Id == 0 ? ResourceApp.newItem : ResourceApp.update,
        new Dictionary<string, object>
        {
            [nameof(ResourceFormDLUI.model)] = model,
            [nameof(ResourceFormDLUI.CallBack)] = EventCallback.Factory.Create<bool>(this, Refreeh),
        });

    void Remove(ResourceDefinition model) => MHD.DeleteMessage(model.Name, EventCallback.Factory.Create(this, () => DeleteR(model.Id)));

    async Task DeleteR(int id)
    {
        if (await ResourceService.DeleteAsync(id))
        {
            await UpdateResourcesAsync();
            StateHasChanged();
        }
    }

    async Task OnSaved()
    {
        await UpdateResourcesAsync();
    }

    private async Task UpdateResourcesAsync()
    {
        resourcesToShow.Clear();
        resourcesToShow.AddRange(await ResourceFolderService.GetResourcesAsync(selectedFolderIds));
    }

    private HashSet<int> selectedFolderIds = new();
}
