@using TaskResourceBlueprints.Entities
@using TaskResourceBlueprints.Entities.Resources
@using TaskResourceBlueprints.Infrastructure
@inject IResourceCategoryService IResourceFolderService
@using TaskResourceBlueprints.Services.Resource

<EditForm Model="folder" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary class="rounded-xl border border-rose-200 bg-rose-50 px-3.5 py-2 text-sm text-red-700 dark:border-rose-900/70 dark:bg-rose-950/40 dark:text-red-300" />

    <div class="space-y-3">
        <div class="space-y-2">
            <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Folder details</h3>
            <p class="text-sm leading-6 text-slate-500 dark:text-slate-400">Organize resource categories and control visibility inside the admin catalog.</p>
        </div>

        <div class="@GridColumnsClass">
            <div class="space-y-2">
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">Name</label>
                <InputText class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/30 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" @bind-Value="folder.DisplayName" />
            </div>

            <div class="space-y-2">
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">Order</label>
                <InputNumber class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/30 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" @bind-Value="folder.SortOrder" />
            </div>

            <label class="flex items-center gap-3 pt-1 text-sm font-medium text-slate-700 dark:text-slate-200">
                <InputCheckbox class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 dark:border-slate-600 dark:bg-slate-900" @bind-Value="folder.IsVisible" />
                <span>Is visible</span>
            </label>

            <div class="md:col-span-full space-y-2">
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">Note</label>
                <InputTextArea class="min-h-28 w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/30 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" @bind-Value="folder.Note" />
            </div>
        </div>

        <div class="flex items-center justify-end gap-3 border-t border-slate-200 pt-4 dark:border-slate-800">
            <button type="button" class="inline-flex items-center rounded-xl border border-slate-300 px-3.5 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-400 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800" @onclick="Cancel">Cancel</button>
            <button type="submit" class="inline-flex items-center rounded-xl bg-blue-600 px-3.5 py-2 text-sm font-medium text-white shadow-sm transition hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500">Save</button>
        </div>
    </div>
</EditForm>

@code {
    [Parameter] public int? FolderId { get; set; }
    [Parameter] public ResourceCategory? Form { get; set; }
    [Parameter] public EventCallback<bool> Callback { get; set; }
    [Parameter] public int ColumnsMd { get; set; } = 2;

    private ResourceCategory folder = new() { DisplayName = "" };

    private string GridColumnsClass => $"grid grid-cols-1 gap-3.5 {GetMdColsClass()}";

    private string GetMdColsClass() => ColumnsMd switch
    {
        <= 1 => "md:grid-cols-1",
        2 => "md:grid-cols-2",
        3 => "md:grid-cols-3",
        4 => "md:grid-cols-4",
        5 => "md:grid-cols-5",
        6 => "md:grid-cols-6",
        _ => "md:grid-cols-2"
    };

    protected override async Task OnInitializedAsync()
    {
        if (Form is not null)
        {
            folder = new ResourceCategory
            {
                Id = Form.Id,
                DisplayName = Form.DisplayName,
                Note = Form.Note,
                IsVisible = Form.IsVisible,
                SortOrder = Form.SortOrder,
                ParentCategoryId = Form.ParentCategoryId,
            };
        }

        if (FolderId.HasValue)
        {
            var existing = await IResourceFolderService.GetByIdAsync(FolderId.Value);
            if (existing is not null)
                folder = existing;
        }
    }

    private async Task HandleValidSubmit()
    {
        if (folder.Id == 0)
            await IResourceFolderService.AddAsync(folder);
        else
            await IResourceFolderService.UpdateAsync(folder);

        await Callback.InvokeAsync(true);
    }

    private async Task Cancel()
    {
        await Callback.InvokeAsync(false);
    }
}
