@using TaskResourceBlueprints.Entities
@using TaskResourceBlueprints.Entities.Resources
@using TaskResourceBlueprints.Infrastructure
@inject IResourceCategoryService IResourceFolderService
@using TaskResourceBlueprints.Services.Resource

<EditForm Model="folder" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-sm text-red-600 dark:text-red-400" />

    <div class="@GridColumnsClass">
        <div>
            <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">Name</label>
            <InputText class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/30 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100" @bind-Value="folder.DisplayName" />
        </div>

        <div>
            <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">Order</label>
            <InputNumber class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/30 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100" @bind-Value="folder.SortOrder" />
        </div>

        <div class="flex items-center gap-2 pt-2">
            <InputCheckbox class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 dark:border-slate-600 dark:bg-slate-900" @bind-Value="folder.IsVisible" />
            <span class="text-sm text-slate-700 dark:text-slate-200">Is Visible</span>
        </div>

        <div class="md:col-span-full">
            <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200">Note</label>
            <InputTextArea class="min-h-24 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/30 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100" @bind-Value="folder.Note" />
        </div>

        <div class="md:col-span-full flex items-center gap-2">
            <button type="submit" class="inline-flex items-center rounded-md border border-blue-600 px-3 py-1.5 text-sm font-medium text-blue-600 transition hover:bg-blue-50 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:border-blue-400 dark:text-blue-300 dark:hover:bg-blue-950/40">💾 Save</button>
            <button type="button" class="inline-flex items-center rounded-md border border-slate-500 px-3 py-1.5 text-sm font-medium text-slate-600 transition hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-slate-400 dark:border-slate-400 dark:text-slate-200 dark:hover:bg-slate-800" @onclick="Cancel">↩ Cancel</button>
        </div>
    </div>
</EditForm>

@code {
    [Parameter] public int? FolderId { get; set; }
    [Parameter] public ResourceCategory? Form { get; set; }
    [Parameter] public EventCallback<bool> Callback { get; set; }
    [Parameter] public int ColumnsMd { get; set; } = 2;

    private ResourceCategory folder = new() { DisplayName = "" };

    private string GridColumnsClass => $"grid grid-cols-1 gap-2 {GetMdColsClass()}";

    private string GetMdColsClass() => ColumnsMd switch
    {
        <= 1 => "md:grid-cols-1",
        2 => "md:grid-cols-2",
        3 => "md:grid-cols-3",
        4 => "md:grid-cols-4",
        5 => "md:grid-cols-5",
        6 => "md:grid-cols-6",
        _ => "md:grid-cols-2"
    };

    protected override async Task OnInitializedAsync()
    {
        if (Form is not null)
        {
            folder = new ResourceCategory
            {
                Id = Form.Id,
                DisplayName = Form.DisplayName,
                Note = Form.Note,
                IsVisible = Form.IsVisible,
                SortOrder = Form.SortOrder,
                ParentCategoryId = Form.ParentCategoryId,
            };
        }

        if (FolderId.HasValue)
        {
            var existing = await IResourceFolderService.GetByIdAsync(FolderId.Value);
            if (existing is not null)
                folder = existing;
        }
    }

    private async Task HandleValidSubmit()
    {
        if (folder.Id == 0)
            await IResourceFolderService.AddAsync(folder);
        else
            await IResourceFolderService.UpdateAsync(folder);

        await Callback.InvokeAsync(true);
    }

    private async Task Cancel()
    {
        await Callback.InvokeAsync(false);
    }
}
