@using TaskResourceBlueprints.Entities
@using TaskResourceBlueprints.Entities.Resources
@using TaskResourceBlueprints.Infrastructure
@inject IResourceCategoryService IResourceFolderService
@using TaskResourceBlueprints.Services.Resource

<div class="pm-form-shell">
    <EditForm Model="folder" OnValidSubmit="HandleValidSubmit" class="pm-form-shell">
        <DataAnnotationsValidator />
        <ValidationSummary class="pm-validation-summary" />

        <section class="pm-form-section">
            <div>
                <h3 class="pm-form-section-title">Folder details</h3>
                <p class="pm-form-section-text">Organize resource categories and control visibility inside the admin catalog.</p>
            </div>

            <div class="pm-form-grid-2">
                <div class="pm-field">
                    <label class="pm-label">Name</label>
                    <InputText class="pm-input" @bind-Value="folder.DisplayName" />
                </div>

                <div class="pm-field">
                    <label class="pm-label">Order</label>
                    <InputNumber class="pm-input" @bind-Value="folder.SortOrder" />
                </div>

                <div class="md:col-span-2">
                    <label class="pm-inline-check">
                        <InputCheckbox class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 dark:border-slate-600 dark:bg-slate-950" @bind-Value="folder.IsVisible" />
                        <span>Is Visible</span>
                    </label>
                </div>

                <div class="pm-field md:col-span-2">
                    <label class="pm-label">Note</label>
                    <InputTextArea class="pm-textarea" @bind-Value="folder.Note" />
                </div>
            </div>
        </section>

        <div class="pm-toolbar">
            <button type="submit" class="pm-btn-primary">💾 Save</button>
            <button type="button" class="pm-btn-secondary" @onclick="Cancel">↩ Cancel</button>
        </div>
    </EditForm>
</div>

@code {
    [Parameter] public int? FolderId { get; set; }
    [Parameter] public ResourceCategory? Form { get; set; }
    [Parameter] public EventCallback<bool> Callback { get; set; }
    [Parameter] public int ColumnsMd { get; set; } = 2;

    private ResourceCategory folder = new() { DisplayName = "" };

    private string GridColumnsClass => $"grid grid-cols-1 gap-2 {GetMdColsClass()}";

    private string GetMdColsClass() => ColumnsMd switch
    {
        <= 1 => "md:grid-cols-1",
        2 => "md:grid-cols-2",
        3 => "md:grid-cols-3",
        4 => "md:grid-cols-4",
        5 => "md:grid-cols-5",
        6 => "md:grid-cols-6",
        _ => "md:grid-cols-2"
    };

    protected override async Task OnInitializedAsync()
    {
        if (Form is not null)
        {
            folder = new ResourceCategory
            {
                Id = Form.Id,
                DisplayName = Form.DisplayName,
                Note = Form.Note,
                IsVisible = Form.IsVisible,
                SortOrder = Form.SortOrder,
                ParentCategoryId = Form.ParentCategoryId,
            };
        }

        if (FolderId.HasValue)
        {
            var existing = await IResourceFolderService.GetByIdAsync(FolderId.Value);
            if (existing is not null)
                folder = existing;
        }
    }

    private async Task HandleValidSubmit()
    {
        if (folder.Id == 0)
            await IResourceFolderService.AddAsync(folder);
        else
            await IResourceFolderService.UpdateAsync(folder);

        await Callback.InvokeAsync(true);
    }

    private async Task Cancel()
    {
        await Callback.InvokeAsync(false);
    }
}
