@using System.Globalization
@inject NavigationManager Nav

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="@Nav.BaseUri" />

    <script src="@Assets["js/theme-init.js"]"></script>

    <ResourcePreloader />

    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["ProjectManagement.Adminstrator.styles.css"]" />
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <link rel="stylesheet" href="@Assets["css/tailwind.css"]" />
    <link rel="stylesheet" href="@Assets["_content/BlazorMHD.UI/css/mhd.css"]" />
    <link rel="stylesheet" href="@Assets["_content/BlazorMHD.UI/css/animations.css"]" />
    <link rel="stylesheet" href="@Assets["_content/ContextMenuMHD/css/tailwind-contextmenu.css"]" />

    <link rel="shortcut icon" href="@Assets["Icons/favicon.ico"]" type="image/x-icon" />

    <ImportMap />
    <HeadOutlet />
</head>

<body class="min-h-screen bg-slate-50 text-slate-900 antialiased dark:bg-slate-950 dark:text-slate-100">
    <Routes />
    <ReconnectModal />

    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["Components/Account/Shared/PasskeySubmit.razor.js"]" type="module"></script>
    <script src="@Assets["_content/BlazorMHD.UI/js/BlazorMHDUI.js"]"></script>
    <script src="@Assets["_content/ContextMenuMHD/js/contextMenuMHD.js"]"></script>

    <script>
        (function () {
        var culture = localStorage['BlazorCulture'];
        if (culture) {
        document.cookie = ".AspNetCore.Culture=c=" + culture + "|uic=" + culture + "; path=/";
        }
        })();

        window.blazorCulture = {
        get: () => localStorage['BlazorCulture'],
        set: (value) => { localStorage['BlazorCulture'] = value; }
        };
    </script>
</body>
</html>
