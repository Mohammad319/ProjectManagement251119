@using Microsoft.AspNetCore.Identity
@using ProjectManagement.Adminstrator.Services.Users
@using ProjectManagement.Shared.DTO.General
@using ProjectManagement.Shared.Models.Account
@inherits AppComponentBase
@inject IUsersService UsersService
@inject AuthenticationStateProvider AuthStateProvider

<div class="pm-form-shell">
    @if (Form is not null)
    {
        <EditForm Model="Form" OnValidSubmit="HandleSubmitAsync2" class="pm-form-shell">
            <DataAnnotationsValidator />

            @if (!string.IsNullOrWhiteSpace(FormError))
            {
                <div class="pm-validation-summary">
                    @FormError
                </div>
            }

            <ValidationSummary class="pm-validation-summary" />

            @if (string.IsNullOrEmpty(UserForm?.Id))
            {
                <div class="rounded-2xl border border-sky-200 bg-sky-50 px-4 py-3 text-sm text-sky-800 dark:border-sky-900/70 dark:bg-sky-950/40 dark:text-sky-200">
                    User creation is being prepared for localized email notifications. In the next phase, welcome and password emails will follow the active language.
                </div>
            }

            <section class="pm-form-section">
                <div>
                    <h3 class="pm-form-section-title">User profile</h3>
                    <p class="pm-form-section-text">Basic contact details and role assignment for the selected account.</p>
                </div>

                <div class="pm-form-grid-2">
                    <div class="pm-field">
                        <label class="pm-label" for="firstname">@ResourceIdentity.firstname</label>
                        <InputText id="firstname" class="pm-input" @bind-Value="Form.Firstname" />
                        <ValidationMessage For="@(() => Form.Firstname)" class="pm-validation-message" />
                    </div>

                    <div class="pm-field">
                        <label class="pm-label" for="lastname">@ResourceIdentity.lastname</label>
                        <InputText id="lastname" class="pm-input" @bind-Value="Form.Lastname" />
                        <ValidationMessage For="@(() => Form.Lastname)" class="pm-validation-message" />
                    </div>

                    <div class="pm-field md:col-span-2">
                        <label class="pm-label" for="email">@ResourceIdentity.email</label>
                        <InputText id="email" class="pm-input" @bind-Value="Form.Email" />
                        <ValidationMessage For="@(() => Form.Email)" class="pm-validation-message" />
                    </div>

                    @if (string.IsNullOrEmpty(UserForm?.Id))
                    {
                        <div class="pm-field">
                            <label class="pm-label" for="password">Password (optional)</label>
                            <InputText id="password" type="password" class="pm-input" @bind-Value="Form.Password" />
                        </div>
                        <div class="pm-field">
                            <label class="pm-label" for="confirmPassword">Confirm password (optional)</label>
                            <InputText id="confirmPassword" type="password" class="pm-input" @bind-Value="Form.ConfirmPassword" />
                        </div>
                    }

                    <div class="pm-field">
                        <label class="pm-label" for="phone">@ResourceIdentity.phone</label>
                        <InputText id="phone" class="pm-input" @bind-Value="Form.PhoneNumber" />
                        <ValidationMessage For="@(() => Form.PhoneNumber)" class="pm-validation-message" />
                    </div>

                    <div class="pm-field">
                        <label class="pm-label" for="role">@ResourceIdentity.role</label>
                        @if (Roles is not null && !TenantId.HasValue)
                        {
                            <select id="role" @bind="Form.Role" class="pm-select">
                                <option value="@PMRolesConst.APP.Admin">@ResourceIdentity.Admin</option>
                                <option value="@PMRolesConst.APP.SuperManger">@ResourceIdentity.SuperManger</option>
                                <option value="@PMRolesConst.APP.Manger">@ResourceIdentity.Manger</option>
                                <option value="@PMRolesConst.APP.User">@ResourceIdentity.User</option>
                            </select>
                        }
                        else if (Roles is not null)
                        {
                            <select id="role" @bind="Form.Role" class="pm-select">
                                <option value="@PMRolesConst.Tenant.Admin">@ResourceIdentity.Admin</option>
                                <option value="@PMRolesConst.Tenant.SuperManger">@ResourceIdentity.SuperManger</option>
                                <option value="@PMRolesConst.Tenant.Manger">@ResourceIdentity.Manger</option>
                                <option value="@PMRolesConst.Tenant.User">@ResourceIdentity.User</option>
                            </select>
                        }
                    </div>
                </div>
            </section>

            <section class="pm-form-section">
                <div>
                    <h3 class="pm-form-section-title">Access control</h3>
                    <p class="pm-form-section-text">Manage lockout windows and confirmation flags.</p>
                </div>

                <div class="pm-form-grid-2">
                    <div class="pm-field">
                        <label class="pm-label" for="lockoutStart">@ResourceIdentity.lockoutStart</label>
                        <div class="flex items-center gap-2">
                            <InputDate id="lockoutStart" class="pm-input" @bind-Value="Form.LockoutStart" />
                            <button class="pm-btn-danger-soft h-10 w-10 px-0" type="button" @onclick="() => Form.LockoutStart = null">
                                @Icons.Delete
                            </button>
                        </div>
                        <ValidationMessage For="@(() => Form.LockoutStart)" class="pm-validation-message" />
                    </div>

                    <div class="pm-field">
                        <label class="pm-label" for="lockoutEnd">@ResourceIdentity.lockoutEnd</label>
                        <div class="flex items-center gap-2">
                            <InputDate id="lockoutEnd" class="pm-input" @bind-Value="Form.LockoutEnd" />
                            <button class="pm-btn-danger-soft h-10 w-10 px-0" type="button" @onclick="() => Form.LockoutEnd = null">
                                @Icons.Delete
                            </button>
                        </div>
                        <ValidationMessage For="@(() => Form.LockoutEnd)" class="pm-validation-message" />
                    </div>
                </div>

                <div class="mt-4 grid grid-cols-1 gap-3 md:grid-cols-2">
                    <label class="pm-inline-check">
                        <InputCheckbox class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-950" @bind-Value="Form.PhoneNumberConfirmed" id="phoneConfirmed" />
                        <span>@ResourceIdentity.phoneNumberConfirmed</span>
                    </label>

                    <label class="pm-inline-check">
                        <InputCheckbox class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-950" @bind-Value="Form.LockoutEnabled" id="lockoutEnabled" />
                        <span>@ResourceIdentity.logout</span>
                    </label>
                </div>
            </section>

            <div class="pm-toolbar">
                <button type="button" class="pm-btn-secondary" @onclick="async () => await Callback.InvokeAsync(false)">
                    @ResourceApp.cancel
                </button>
                <button type="submit" class="pm-btn-primary" disabled="@IsLoading" aria-busy="@IsLoading">
                    @ResourceApp.save
                </button>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter] public EventCallback<bool> Callback { get; set; }
    [Parameter] public ApplicationUser? UserForm { get; set; }
    [Parameter] public int? DepartmentId { get; set; }
    [Parameter] public int? TenantId { get; set; }
    [Parameter] public int? DBID { get; set; }

    UserPostDTO Form = new();
    bool IsLoading = true;
    string? FormError;
    IList<string> Roles = [];

    async Task<int> GetUserTenant()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var claim = authState.User.Claims.FirstOrDefault(x => x.Type == PMClaimsConst.Tenant);
        if (claim == null) return 0;
        return Convert.ToInt32(claim.Value);
    }

    protected async override Task OnInitializedAsync()
    {
        if (UserForm != null)
        {
            Form = new UserPostDTO()
            {
                Email = UserForm.Email ?? string.Empty,
                Firstname = UserForm.Firstname ?? string.Empty,
                Lastname = UserForm.Lastname ?? string.Empty,
                DepartmentId = DepartmentId,
                LockoutEnabled = UserForm.LockoutEnabled,
                Id = UserForm.Id,
                LockoutStart = UserForm.LockoutStart,
                LockoutEnd = UserForm.LockoutEnd,
                PhoneNumber = UserForm.PhoneNumber ?? string.Empty,
                PhoneNumberConfirmed = UserForm.PhoneNumberConfirmed,
            };
            await IniUserApp();
            if (!string.IsNullOrEmpty(UserForm?.Id))
            {
                Form.Role = Roles.FirstOrDefault() ?? string.Empty;
            }

            IsLoading = false;
        }
    }

    async Task IniUserApp()
    {
        if (!string.IsNullOrEmpty(UserForm?.Id))
        {
            Roles = await UsersService.GetRolesAsync(UserForm.UserName ?? string.Empty);
            return;
        }

        if (TenantId.HasValue)
        {
            Roles.Add(PMRolesConst.Tenant.Manger);
            Form.Role = PMRolesConst.Tenant.Manger;
        }
        else
        {
            Roles.Add(PMRolesConst.APP.Manger);
            Form.Role = PMRolesConst.APP.Manger;
        }
    }

    async Task HandleSubmitAsync2()
    {
        FormError = null;
        IsLoading = true;
        try
        {
            bool result;
            if (string.IsNullOrEmpty(UserForm?.Id))
            {
                var hasPassword = !string.IsNullOrWhiteSpace(Form.Password);

                if (hasPassword && !string.Equals(Form.Password, Form.ConfirmPassword, StringComparison.Ordinal))
                {
                    FormError = "Password and confirmation password do not match.";
                    return;
                }

                result = await UsersService.RegisterAsync(Form, TenantId);
                MHD.Notifications(ToastType.Add, result);
            }
            else
            {
                result = await UsersService.UpdateUserAsync(Form, TenantId);
                MHD.Notifications(ToastType.Update, result);
            }

            await Callback.InvokeAsync(result);
        }
        finally
        {
            IsLoading = false;
        }
    }
}
