@using Microsoft.AspNetCore.Identity
@using ProjectManagement.Adminstrator.Services.Users
@using ProjectManagement.Shared.DTO.General
@using ProjectManagement.Shared.Models.Account
@inherits AppComponentBase
@inject IUsersService UsersService
@inject AuthenticationStateProvider AuthStateProvider

<div class="space-y-3">
    @if (Form is not null)
    {
        <EditForm Model="Form" OnValidSubmit="HandleSubmitAsync2" class="space-y-1">
            <DataAnnotationsValidator />

            @if (!string.IsNullOrWhiteSpace(FormError))
            {
                <div class="rounded-xl border border-rose-200 bg-rose-50 px-3 py-2 text-sm text-rose-700 dark:border-rose-900/60 dark:bg-rose-950/40 dark:text-rose-300">
                    @FormError
                </div>
            }

            <ValidationSummary class="rounded-xl border border-rose-200 bg-rose-50 px-3 py-2 text-sm text-rose-700 dark:border-rose-900/60 dark:bg-rose-950/40 dark:text-rose-300" />


            <section class="rounded-2xl border border-slate-200 bg-white p-1 dark:!border-slate-800 dark:!bg-slate-950/80">

                <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
                    <div class="space-y-1">
                        <label class="block text-xs font-medium text-slate-700 dark:text-slate-300" for="firstname">@ResourceIdentity.firstname</label>
                        <InputText id="firstname" class="block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500" @bind-Value="Form.Firstname" />
                        <ValidationMessage For="@(() => Form.Firstname)" class="text-xs text-rose-600 dark:text-rose-400" />
                    </div>

                    <div class="space-y-1">
                        <label class="block text-xs font-medium text-slate-700 dark:text-slate-300" for="lastname">@ResourceIdentity.lastname</label>
                        <InputText id="lastname" class="block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500" @bind-Value="Form.Lastname" />
                        <ValidationMessage For="@(() => Form.Lastname)" class="text-xs text-rose-600 dark:text-rose-400" />
                    </div>

                    <div class="space-y-1 md:col-span-2">
                        <label class="block text-xs font-medium text-slate-700 dark:text-slate-300" for="email">@ResourceIdentity.email</label>
                        <InputText id="email" class="block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500" @bind-Value="Form.Email" />
                        <ValidationMessage For="@(() => Form.Email)" class="text-xs text-rose-600 dark:text-rose-400" />
                    </div>

                    @if (string.IsNullOrEmpty(UserForm?.Id))
                    {
                        <div class="space-y-1">
                            <label class="block text-xs font-medium text-slate-700 dark:text-slate-300" for="password">Password (optional)</label>
                            <InputText id="password" type="password" class="block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500" @bind-Value="Form.Password" />
                        </div>
                        <div class="space-y-1">
                            <label class="block text-xs font-medium text-slate-700 dark:text-slate-300" for="confirmPassword">Confirm password (optional)</label>
                            <InputText id="confirmPassword" type="password" class="block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500" @bind-Value="Form.ConfirmPassword" />
                        </div>
                    }

                    <div class="space-y-1">
                        <label class="block text-xs font-medium text-slate-700 dark:text-slate-300" for="phone">@ResourceIdentity.phone</label>
                        <InputText id="phone" class="block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500" @bind-Value="Form.PhoneNumber" />
                        <ValidationMessage For="@(() => Form.PhoneNumber)" class="text-xs text-rose-600 dark:text-rose-400" />
                    </div>

                    <div class="space-y-1">
                        <label class="block text-xs font-medium text-slate-700 dark:text-slate-300" for="role">@ResourceIdentity.role</label>
                        @if (Roles is not null && !TenantId.HasValue)
                        {
                            <select id="role" @bind="Form.Role" class="block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100">
                                <option value="@PMRolesConst.APP.Admin">@ResourceIdentity.Admin</option>
                                <option value="@PMRolesConst.APP.SuperManger">@ResourceIdentity.SuperManger</option>
                                <option value="@PMRolesConst.APP.Manger">@ResourceIdentity.Manger</option>
                                <option value="@PMRolesConst.APP.User">@ResourceIdentity.User</option>
                            </select>
                        }
                        else if (Roles is not null)
                        {
                            <select id="role" @bind="Form.Role" class="block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100">
                                <option value="@PMRolesConst.Tenant.Admin">@ResourceIdentity.Admin</option>
                                <option value="@PMRolesConst.Tenant.SuperManger">@ResourceIdentity.SuperManger</option>
                                <option value="@PMRolesConst.Tenant.Manger">@ResourceIdentity.Manger</option>
                                <option value="@PMRolesConst.Tenant.User">@ResourceIdentity.User</option>
                            </select>
                        }
                    </div>
                </div>
            </section>

            <section class="rounded-2xl border border-slate-200 bg-white p-1 dark:!border-slate-800 dark:!bg-slate-950/80">
                <div>
                    <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">Access control</h3>
                    <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">Manage lockout windows and confirmation flags.</p>
                </div>

                <div class="grid grid-cols-2 gap-1 md:grid-cols-2">
                    <div class="space-y-1">
                        <label class="block text-xs font-medium text-slate-700 dark:text-slate-300" for="lockoutStart">@ResourceIdentity.lockoutStart</label>
                        <div class="flex items-center gap-2">
                            <InputDate id="lockoutStart" class="block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500" @bind-Value="Form.LockoutStart" />
                            <button class="inline-flex items-center justify-center gap-2 rounded-xl border border-rose-200 bg-rose-50 px-3 py-2 text-xs font-medium text-rose-700 transition hover:bg-rose-100 focus:outline-none focus:ring-2 focus:ring-rose-500/20 disabled:cursor-not-allowed disabled:opacity-60 dark:border-rose-900/60 dark:bg-rose-950/40 dark:text-rose-300 dark:hover:bg-rose-950/60 h-10 w-10 px-0" type="button" @onclick="() => Form.LockoutStart = null">
                                @Icons.Delete
                            </button>
                        </div>
                        <ValidationMessage For="@(() => Form.LockoutStart)" class="text-xs text-rose-600 dark:text-rose-400" />
                    </div>

                    <div class="space-y-1">
                        <label class="block text-xs font-medium text-slate-700 dark:text-slate-300" for="lockoutEnd">@ResourceIdentity.lockoutEnd</label>
                        <div class="flex items-center gap-2">
                            <InputDate id="lockoutEnd" class="block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500" @bind-Value="Form.LockoutEnd" />
                            <button class="inline-flex items-center justify-center gap-2 rounded-xl border border-rose-200 bg-rose-50 px-3 py-2 text-xs font-medium text-rose-700 transition hover:bg-rose-100 focus:outline-none focus:ring-2 focus:ring-rose-500/20 disabled:cursor-not-allowed disabled:opacity-60 dark:border-rose-900/60 dark:bg-rose-950/40 dark:text-rose-300 dark:hover:bg-rose-950/60 h-10 w-10 px-0" type="button" @onclick="() => Form.LockoutEnd = null">
                                @Icons.Delete
                            </button>
                        </div>
                        <ValidationMessage For="@(() => Form.LockoutEnd)" class="text-xs text-rose-600 dark:text-rose-400" />
                    </div>
                </div>

                <div class="mt-4 grid grid-cols-2 gap-1 md:grid-cols-2">
                    <label class="inline-flex items-center gap-2">
                        <InputCheckbox class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-950" @bind-Value="Form.PhoneNumberConfirmed" id="phoneConfirmed" />
                        <span>@ResourceIdentity.phoneNumberConfirmed</span>
                    </label>

                    <label class="inline-flex items-center gap-1">
                        <InputCheckbox class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-950" @bind-Value="Form.LockoutEnabled" id="lockoutEnabled" />
                        <span>@ResourceIdentity.logout</span>
                    </label>
                </div>
            </section>

            <div class="flex flex-wrap items-center gap-1">
                <button type="button" class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-medium text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-400/30 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800" @onclick="async () => await Callback.InvokeAsync(false)">
                    @ResourceApp.cancel
                </button>
                <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-xl border border-sky-600 bg-sky-600 px-3 py-2 text-xs font-medium text-white transition hover:bg-sky-700 focus:outline-none focus:ring-2 focus:ring-sky-500/30 disabled:cursor-not-allowed disabled:opacity-60 dark:border-sky-500 dark:bg-sky-500 dark:hover:bg-sky-400" disabled="@IsLoading" aria-busy="@IsLoading">
                    @ResourceApp.save
                </button>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter] public EventCallback<bool> Callback { get; set; }
    [Parameter] public ApplicationUser? UserForm { get; set; }
    [Parameter] public int? DepartmentId { get; set; }
    [Parameter] public int? TenantId { get; set; }
    [Parameter] public int? DBID { get; set; }

    UserPostDTO Form = new();
    bool IsLoading = true;
    string? FormError;
    IList<string> Roles = [];

    async Task<int> GetUserTenant()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var claim = authState.User.Claims.FirstOrDefault(x => x.Type == PMClaimsConst.Tenant);
        if (claim == null) return 0;
        return Convert.ToInt32(claim.Value);
    }

    protected async override Task OnInitializedAsync()
    {
        if (UserForm != null)
        {
            Form = new UserPostDTO()
            {
                Email = UserForm.Email ?? string.Empty,
                Firstname = UserForm.Firstname ?? string.Empty,
                Lastname = UserForm.Lastname ?? string.Empty,
                DepartmentId = DepartmentId,
                LockoutEnabled = UserForm.LockoutEnabled,
                Id = UserForm.Id,
                LockoutStart = UserForm.LockoutStart,
                LockoutEnd = UserForm.LockoutEnd,
                PhoneNumber = UserForm.PhoneNumber ?? string.Empty,
                PhoneNumberConfirmed = UserForm.PhoneNumberConfirmed,
            };
            await IniUserApp();
            if (!string.IsNullOrEmpty(UserForm?.Id))
            {
                Form.Role = Roles.FirstOrDefault() ?? string.Empty;
            }

            IsLoading = false;
        }
    }

    async Task IniUserApp()
    {
        if (!string.IsNullOrEmpty(UserForm?.Id))
        {
            Roles = await UsersService.GetRolesAsync(UserForm.UserName ?? string.Empty);
            return;
        }

        if (TenantId.HasValue)
        {
            Roles.Add(PMRolesConst.Tenant.Manger);
            Form.Role = PMRolesConst.Tenant.Manger;
        }
        else
        {
            Roles.Add(PMRolesConst.APP.Manger);
            Form.Role = PMRolesConst.APP.Manger;
        }
    }

    async Task HandleSubmitAsync2()
    {
        FormError = null;
        IsLoading = true;
        try
        {
            bool result;
            if (string.IsNullOrEmpty(UserForm?.Id))
            {
                var hasPassword = !string.IsNullOrWhiteSpace(Form.Password);

                if (hasPassword && !string.Equals(Form.Password, Form.ConfirmPassword, StringComparison.Ordinal))
                {
                    FormError ="Password and confirmation password do not match.";
                    return;
                }

                result = await UsersService.RegisterAsync(Form, TenantId);
                MHD.Notifications(ToastType.Add, result);
            }
            else
            {
                result = await UsersService.UpdateUserAsync(Form, TenantId);
                MHD.Notifications(ToastType.Update, result);
            }

            await Callback.InvokeAsync(result);
        }
        finally
        {
            IsLoading = false;
        }
    }
}
