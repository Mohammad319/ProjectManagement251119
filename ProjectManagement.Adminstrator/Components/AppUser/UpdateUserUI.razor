@using Microsoft.AspNetCore.Identity
@using ProjectManagement.Adminstrator.Services.Users
@using ProjectManagement.Shared.DTO.General
@using ProjectManagement.Shared.Models.Account
@inherits AppComponentBase
@inject IUsersService UsersService
@inject AuthenticationStateProvider AuthStateProvider

<div class="space-y-4 p-1">
    @if (Form is not null)
    {
        <EditForm Model="Form" OnValidSubmit="HandleSubmitAsync2" class="space-y-4">
            <DataAnnotationsValidator />

            @if (!string.IsNullOrWhiteSpace(FormError))
            {
                <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 dark:border-red-900/70 dark:bg-red-950/40 dark:text-red-200">
                    @FormError
                </div>
            }

            <ValidationSummary class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 dark:border-red-900/70 dark:bg-red-950/40 dark:text-red-200" />

            @if (string.IsNullOrEmpty(UserForm?.Id))
            {
                <div class="rounded-2xl border border-sky-200 bg-sky-50 px-4 py-3 text-sm text-sky-800 dark:border-sky-900/70 dark:bg-sky-950/40 dark:text-sky-200">
                    User creation is being prepared for localized email notifications. In the next phase, welcome and password emails will follow the active language.
                </div>
            }

            <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
                <div class="space-y-1">
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-200" for="firstname">@ResourceIdentity.firstname</label>
                    <InputText id="firstname" class="block w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" @bind-Value="Form.Firstname" />
                    <ValidationMessage For="@(() => Form.Firstname)" class="text-sm text-red-600 dark:text-red-400" />
                </div>

                <div class="space-y-1">
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-200" for="lastname">@ResourceIdentity.lastname</label>
                    <InputText id="lastname" class="block w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" @bind-Value="Form.Lastname" />
                    <ValidationMessage For="@(() => Form.Lastname)" class="text-sm text-red-600 dark:text-red-400" />
                </div>

                <div class="space-y-1 lg:col-span-2">
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-200" for="email">@ResourceIdentity.email</label>
                    <InputText id="email" class="block w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" @bind-Value="Form.Email" />
                    <ValidationMessage For="@(() => Form.Email)" class="text-sm text-red-600 dark:text-red-400" />
                </div>

                @if (string.IsNullOrEmpty(UserForm?.Id))
                {
                    <div class="space-y-1">
                        <label class="block text-sm font-medium text-slate-700 dark:text-slate-200" for="password">Password (optional)</label>
                        <InputText id="password" type="password" class="block w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" @bind-Value="Form.Password" />
                    </div>
                    <div class="space-y-1">
                        <label class="block text-sm font-medium text-slate-700 dark:text-slate-200" for="confirmPassword">Confirm password (optional)</label>
                        <InputText id="confirmPassword" type="password" class="block w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" @bind-Value="Form.ConfirmPassword" />
                    </div>
                }

                <div class="space-y-1">
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-200" for="phone">@ResourceIdentity.phone</label>
                    <InputText id="phone" class="block w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" @bind-Value="Form.PhoneNumber" />
                    <ValidationMessage For="@(() => Form.PhoneNumber)" class="text-sm text-red-600 dark:text-red-400" />
                </div>

                <div class="space-y-1">
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-200" for="role">@ResourceIdentity.role</label>
                    @if (Roles is not null && !TenantId.HasValue)
                    {
                        <select id="role" @bind="Form.Role" class="block w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100">
                            <option value="@PMRolesConst.APP.Admin">@ResourceIdentity.Admin</option>
                            <option value="@PMRolesConst.APP.SuperManger">@ResourceIdentity.SuperManger</option>
                            <option value="@PMRolesConst.APP.Manger">@ResourceIdentity.Manger</option>
                            <option value="@PMRolesConst.APP.User">@ResourceIdentity.User</option>
                        </select>
                    }
                    else if (Roles is not null)
                    {
                        <select id="role" @bind="Form.Role" class="block w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100">
                            <option value="@PMRolesConst.Tenant.Admin">@ResourceIdentity.Admin</option>
                            <option value="@PMRolesConst.Tenant.SuperManger">@ResourceIdentity.SuperManger</option>
                            <option value="@PMRolesConst.Tenant.Manger">@ResourceIdentity.Manger</option>
                            <option value="@PMRolesConst.Tenant.User">@ResourceIdentity.User</option>
                        </select>
                    }
                </div>

                <div class="space-y-1">
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-200" for="lockoutStart">@ResourceIdentity.lockoutStart</label>
                    <div class="flex items-center gap-2">
                        <InputDate id="lockoutStart" class="block w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" @bind-Value="Form.LockoutStart" />
                        <button class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-rose-200 bg-white text-rose-600 transition hover:bg-rose-50 dark:border-rose-900/70 dark:bg-slate-950 dark:text-rose-300 dark:hover:bg-rose-950/30" type="button" @onclick="() => Form.LockoutStart = null">
                            @Icons.Delete
                        </button>
                    </div>
                    <ValidationMessage For="@(() => Form.LockoutStart)" class="text-sm text-red-600 dark:text-red-400" />
                </div>

                <div class="space-y-1">
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-200" for="lockoutEnd">@ResourceIdentity.lockoutEnd</label>
                    <div class="flex items-center gap-2">
                        <InputDate id="lockoutEnd" class="block w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" @bind-Value="Form.LockoutEnd" />
                        <button class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-rose-200 bg-white text-rose-600 transition hover:bg-rose-50 dark:border-rose-900/70 dark:bg-slate-950 dark:text-rose-300 dark:hover:bg-rose-950/30" type="button" @onclick="() => Form.LockoutEnd = null">
                            @Icons.Delete
                        </button>
                    </div>
                    <ValidationMessage For="@(() => Form.LockoutEnd)" class="text-sm text-red-600 dark:text-red-400" />
                </div>
            </div>

            <div class="grid grid-cols-1 gap-3 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 dark:border-slate-800 dark:bg-slate-900/60 md:grid-cols-2">
                <label class="flex items-center gap-3 text-sm text-slate-700 dark:text-slate-200">
                    <InputCheckbox class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 dark:border-slate-700 dark:bg-slate-950" @bind-Value="Form.PhoneNumberConfirmed" id="phoneConfirmed" />
                    <span>@ResourceIdentity.phoneNumberConfirmed</span>
                </label>

                <label class="flex items-center gap-3 text-sm text-slate-700 dark:text-slate-200">
                    <InputCheckbox class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 dark:border-slate-700 dark:bg-slate-950" @bind-Value="Form.LockoutEnabled" id="lockoutEnabled" />
                    <span>@ResourceIdentity.logout</span>
                </label>
            </div>

            <div class="flex flex-wrap items-center justify-end gap-3 border-t border-slate-200 pt-4 dark:border-slate-800">
                <button type="button" class="inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-200 dark:hover:bg-slate-900" @onclick="async () => await Callback.InvokeAsync(false)">
                    @ResourceApp.cancel
                </button>
                <button type="submit" class="inline-flex items-center justify-center rounded-xl bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 disabled:cursor-not-allowed disabled:opacity-60 dark:bg-indigo-500 dark:hover:bg-indigo-400" disabled="@IsLoading" aria-busy="@IsLoading">
                    @ResourceApp.save
                </button>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter] public EventCallback<bool> Callback { get; set; }
    [Parameter] public ApplicationUser? UserForm { get; set; }
    [Parameter] public int? DepartmentId { get; set; }
    [Parameter] public int? TenantId { get; set; }
    [Parameter] public int? DBID { get; set; }

    UserPostDTO Form = new();
    bool IsLoading = true;
    string? FormError;
    IList<string> Roles = [];

    async Task<int> GetUserTenant()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var claim = authState.User.Claims.FirstOrDefault(x => x.Type == PMClaimsConst.Tenant);
        if (claim == null) return 0;
        return Convert.ToInt32(claim.Value);
    }

    protected async override Task OnInitializedAsync()
    {
        if (UserForm != null)
        {
            Form = new UserPostDTO()
            {
                Email = UserForm.Email ?? string.Empty,
                Firstname = UserForm.Firstname ?? string.Empty,
                Lastname = UserForm.Lastname ?? string.Empty,
                DepartmentId = DepartmentId,
                LockoutEnabled = UserForm.LockoutEnabled,
                Id = UserForm.Id,
                LockoutStart = UserForm.LockoutStart,
                LockoutEnd = UserForm.LockoutEnd,
                PhoneNumber = UserForm.PhoneNumber ?? string.Empty,
                PhoneNumberConfirmed = UserForm.PhoneNumberConfirmed,
            };
            await IniUserApp();
            if (!string.IsNullOrEmpty(UserForm?.Id))
            {
                Form.Role = Roles.FirstOrDefault() ?? string.Empty;
            }

            IsLoading = false;
        }
    }

    async Task IniUserApp()
    {
        if (!string.IsNullOrEmpty(UserForm?.Id))
        {
            Roles = await UsersService.GetRolesAsync(UserForm.UserName ?? string.Empty);
            return;
        }

        if (TenantId.HasValue)
        {
            Roles.Add(PMRolesConst.Tenant.Manger);
            Form.Role = PMRolesConst.Tenant.Manger;
        }
        else
        {
            Roles.Add(PMRolesConst.APP.Manger);
            Form.Role = PMRolesConst.APP.Manger;
        }
    }

    async Task HandleSubmitAsync2()
    {
        FormError = null;
        IsLoading = true;
        try
        {
            bool result;
            if (string.IsNullOrEmpty(UserForm?.Id))
            {
                var hasPassword = !string.IsNullOrWhiteSpace(Form.Password);

                if (hasPassword && !string.Equals(Form.Password, Form.ConfirmPassword, StringComparison.Ordinal))
                {
                    FormError = "Password and confirmation password do not match.";
                    return;
                }

                result = await UsersService.RegisterAsync(Form, TenantId);
                MHD.Notifications(ToastType.Add, result);
            }
            else
            {
                result = await UsersService.UpdateUserAsync(Form, TenantId);
                MHD.Notifications(ToastType.Update, result);
            }

            await Callback.InvokeAsync(result);
        }
        finally
        {
            IsLoading = false;
        }
    }
}
