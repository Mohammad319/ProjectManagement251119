@using BlazorMHD.UI.Core.Navigation
@using Microsoft.AspNetCore.Components.Authorization
@using ProjectManagement.Adminstrator.Services.Users
@using ProjectManagement.Shared.Models.Account
@inherits AppComponentBase
@inject IUsersService UsersService
@inject AuthenticationStateProvider AuthStateProvider
@attribute [Authorize(Roles = PMRolesConst.APP.AdminManger)]

<div class="space-y-1 text-slate-900 dark:text-slate-100">
    <div class="rounded-2xl border border-slate-200 bg-white px-4 py-1 shadow-sm dark:border-slate-800 dark:bg-slate-950/80">
        <div>
            <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">Manage site users, access state, and account details.</p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
            @if (Users is not null)
            {
                <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[11px] font-semibold text-slate-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200">@Users.Count @ResourceIdentity.users</span>
            }

            @if (CanManageSiteUsers)
            {
                <button type="button" class="inline-flex items-center justify-center gap-1 rounded-xl border border-emerald-600 bg-emerald-600 px-1 py-1 text-xs font-medium text-white transition hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-500/30 disabled:cursor-not-allowed disabled:opacity-60 dark:border-emerald-500 dark:bg-emerald-500 dark:hover:bg-emerald-400" @onclick="RegisterModal">
                    @ResourceIdentity.register
                </button>
            }
        </div>
    </div>

    @if (Users is null)
    {
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-950/80">
            <MhdLoading />
        </div>
    }
    else if (Users.Count > 0)
    {
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-950/80">
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-slate-200 text-sm dark:divide-slate-800">
                    <thead>
                        <tr>
                            <th class="px-0.5 py-0.5text-left text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">@ResourceIdentity.email</th>
                            <th class="px-0.5 py-0.5text-left text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">@CalcResource.name</th>
                            <th class="px-0.5 py-0.5text-left text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">@CalcResource.active</th>
                            <th class="px-0.5 py-0.5text-left text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">@ResourceIdentity.lockoutStart</th>
                            <th class="px-0.5 py-0.5text-left text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">@ResourceIdentity.lockoutEnd</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Users)
                        {
                            <tr class="cursor-context-menu"
                                @oncontextmenu:preventDefault
                                @oncontextmenu="() => ContextM(user)">
                                <td class="px-0.5 py-0.5 align-top text-sm text-slate-700 dark:text-slate-200">
                                    <div class="min-w-[220px]">
                                        <div class="font-medium text-slate-800 dark:text-slate-100">@user.Email</div>
                                        <div class="text-xs text-slate-500 dark:text-slate-400">@user.UserName</div>
                                    </div>
                                </td>
                                <td class="px-0.5 py-0.5 align-top text-sm text-slate-700 dark:text-slate-200">
                                    <div class="font-medium">@user.Firstname @user.Lastname</div>
                                </td>
                                <td class="px-0.5 py-0.5 align-top text-sm text-slate-700 dark:text-slate-200">
                                    <span class="@(user.LockoutEnabled ?"inline-flex items-center rounded-full border border-amber-200 bg-amber-50 px-2.5 py-1 text-[11px] font-medium text-amber-700 dark:border-amber-900/60 dark:bg-amber-950/40 dark:text-amber-200" :"inline-flex items-center rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-[11px] font-medium text-emerald-700 dark:border-emerald-900/60 dark:bg-emerald-950/40 dark:text-emerald-200")">
                                        @(user.LockoutEnabled ? ResourceIdentity.logout : CalcResource.active)
                                    </span>
                                </td>
                                <td class="text-slate-600 dark:text-slate-300">@(user.LockoutStart?.ToString("dd.MM.yyyy") ??"—")</td>
                                <td class="text-slate-600 dark:text-slate-300">@(user.LockoutEnd?.ToString("dd.MM.yyyy") ??"—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="flex min-h-[180px] flex-col items-center justify-center rounded-2xl border border-dashed border-slate-300 bg-slate-50/70 px-4 py-8 text-center dark:border-slate-700 dark:bg-slate-900/40">
            @ResourceApp.ThereAreNoItemsToDisplay
        </div>
    }
</div>

@code {
    private bool CanManageSiteUsers;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var principal = authState.User;
        CanManageSiteUsers = principal.IsInRole(PMRolesConst.APP.Admin);

        await GetUsersAsync();
    }

    async Task ContextM(ApplicationUser item)
    {
        if (!CanManageSiteUsers)
        {
            return;
        }

        await ContextService.ShowMenuAsync(new()
        {
            new MhdContextMenuItem { Label = $"✏️ {ResourceApp.update}", OnClickAsync = () => { UpdateUser(item); return Task.CompletedTask; } },
            new MhdContextMenuItem { Label = $"🗑️ {ResourceApp.delete}", OnClickAsync = () => { Delete_Click(item); return Task.CompletedTask; } }
        });
    }

    void UpdateUser(ApplicationUser user) =>
        Modal.ShowComponent<UpdateUserUI>(AppLoc[LocalizerConst.Update, user.Id], new Dictionary<string, object>
        {
            [nameof(UpdateUserUI.UserForm)] = user,
            [nameof(UpdateUserUI.Callback)] = EventCallback.Factory.Create<bool>(this, CallBack),
        });

    void RegisterModal() =>
        Modal.ShowComponent<UpdateUserUI>(ResourceIdentity.register, new Dictionary<string, object>
        {
            [nameof(UpdateUserUI.UserForm)] = new ApplicationUser() { Id = string.Empty },
            [nameof(UpdateUserUI.Callback)] = EventCallback.Factory.Create<bool>(this, CallBack),
        });

    async Task CallBack(bool refresh)
    {
        if (refresh) await GetUsersAsync();
        await Modal.CloseAsync();
    }

    private async Task RemoveAsync(ApplicationUser deleteConfirmed)
    {
        if (await ExHandlers.RunCheckTokenAsync(() => UsersService.RemoveUserAsync(deleteConfirmed.Id, null)))
        {
            Users?.Remove(deleteConfirmed);
        }

        StateHasChanged();
    }

    bool Remove(ApplicationUser user)
    {
        MHD.MessageYesNo(ResourceApp.delete, AppLoc[LocalizerConst.deleteConfirmMsg, user.Email ?? string.Empty], MhdState.Warning, EventCallback.Factory.Create(this, () => RemoveAsync(user)));
        return true;
    }

    void Delete_Click(ApplicationUser user)
    {
        MHD.DeleteMessage(user.Email, EventCallback.Factory.Create(this, () => Remove(user)));
    }

    List<ApplicationUser>? Users;

    async Task GetUsersAsync()
    {
        MHD.Loading.Begin();
        Users = null;
        Users = await UsersService.GetUsersAsync(null);
        MHD.Loading.End();
        StateHasChanged();
    }
}
