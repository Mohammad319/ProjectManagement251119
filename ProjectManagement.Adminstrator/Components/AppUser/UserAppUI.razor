@using ContextMenuMHD
@using Microsoft.AspNetCore.Components.Authorization
@using ProjectManagement.Adminstrator.Services.Users
@using ProjectManagement.Shared.Models.Account
@inherits AppComponentBase
@inject IUsersService UsersService
@inject AuthenticationStateProvider AuthStateProvider
@attribute [Authorize(Roles = PMRolesConst.APP.AdminManger)]

<div class="space-y-4">
    <div class="flex flex-col gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900 lg:flex-row lg:items-start lg:justify-between">
        <div>
            <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100">@ResourceIdentity.users</h3>
            <p class="text-sm text-slate-500 dark:text-slate-400">Settings</p>
        </div>

        @if (CanManageSiteUsers)
        {
            <button type="button"
                    class="inline-flex items-center justify-center rounded-xl border border-emerald-300 bg-emerald-50 px-3 py-2 text-sm font-medium text-emerald-700 transition hover:bg-emerald-100 dark:border-emerald-900/60 dark:bg-emerald-950/30 dark:text-emerald-300 dark:hover:bg-emerald-950/50"
                    @onclick="RegisterModal">
                @ResourceIdentity.register
            </button>
        }
    </div>

    @if (Users is null)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-700 dark:bg-slate-900">
            <BlazorMHD.UI.Components.Feedback.Loading.MhdLoading />
        </div>
    }
    else if (Users.Count > 0)
    {
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-slate-200 dark:divide-slate-700">
                    <thead class="bg-slate-50/80 dark:bg-slate-800/60">
                        <tr>
                            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-300">@ResourceIdentity.email</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-300">@CalcResource.name</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-300">@CalcResource.active</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-300">@ResourceIdentity.lockoutStart</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-300">@ResourceIdentity.lockoutEnd</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200 dark:divide-slate-800">
                        @foreach (var user in Users)
                        {
                            <tr class="cursor-context-menu transition hover:bg-slate-50 dark:hover:bg-slate-800/60"
                                @oncontextmenu:preventDefault
                                @oncontextmenu="() => ContextM(user)">
                                <td class="px-4 py-3 text-sm text-slate-700 dark:text-slate-200">
                                    <div class="font-medium">@user.Email</div>
                                    <div class="text-xs text-slate-500 dark:text-slate-400">@user.UserName</div>
                                </td>
                                <td class="px-4 py-3 text-sm text-slate-700 dark:text-slate-200">@user.Firstname @user.Lastname</td>
                                <td class="px-4 py-3 text-sm text-slate-700 dark:text-slate-200">@(user.LockoutEnabled ? ResourceIdentity.logout : CalcResource.active)</td>
                                <td class="px-4 py-3 text-sm text-slate-600 dark:text-slate-300">@(user.LockoutStart?.ToString("dd.MM.yyyy") ?? "—")</td>
                                <td class="px-4 py-3 text-sm text-slate-600 dark:text-slate-300">
                                    <div class="flex items-center gap-2">
                                        <span class="inline-flex rounded-full px-2 py-1 text-xs font-medium @(user.LockoutEnabled ? "bg-amber-100 text-amber-700 ring-1 ring-amber-200 dark:bg-amber-900/40 dark:text-amber-300 dark:ring-amber-900/80" : "bg-emerald-100 text-emerald-700 ring-1 ring-emerald-200 dark:bg-emerald-900/40 dark:text-emerald-300 dark:ring-emerald-900/80")">
                                            @(user.LockoutEnabled ? ResourceIdentity.logout : CalcResource.active)
                                        </span>
                                        <span>@(user.LockoutEnd?.ToString("dd.MM.yyyy") ?? "—")</span>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-6 py-10 text-center text-sm text-slate-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-400">
            @ResourceApp.ThereAreNoItemsToDisplay
        </div>
    }
</div>

@code {
    private bool CanManageSiteUsers;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var principal = authState.User;
        CanManageSiteUsers = principal.IsInRole(PMRolesConst.APP.Admin);

        await GetUsersAsync();
    }

    async Task ContextM(ApplicationUser item)
    {
        if (!CanManageSiteUsers)
        {
            return;
        }

        await ContextService.ShowMenuAsync(new()
        {
            new MenuItem { Label = $"✏️ {ResourceApp.update}", OnClickAsync = () => { UpdateUser(item); return Task.CompletedTask; } },
            new MenuItem { Label = $"🗑️ {ResourceApp.delete}", OnClickAsync = () => { Delete_Click(item); return Task.CompletedTask; } }
        });
    }

    void UpdateUser(ApplicationUser user) =>
        Modal.ShowComponent<UpdateUserUI>(AppLoc[LocalizerConst.Update, user.Id], new Dictionary<string, object>
        {
            [nameof(UpdateUserUI.UserForm)] = user,
            [nameof(UpdateUserUI.Callback)] = EventCallback.Factory.Create<bool>(this, CallBack),
        });

    void RegisterModal() =>
        Modal.ShowComponent<UpdateUserUI>(ResourceIdentity.register, new Dictionary<string, object>
        {
            [nameof(UpdateUserUI.UserForm)] = new ApplicationUser() { Id = string.Empty },
            [nameof(UpdateUserUI.Callback)] = EventCallback.Factory.Create<bool>(this, CallBack),
        });

    async Task CallBack(bool refresh)
    {
        if (refresh) await GetUsersAsync();
        Modal.Close();
    }

    private async Task RemoveAsync(ApplicationUser deleteConfirmed)
    {
        if (await ExHandlers.RunCheckTokenAsync(() => UsersService.RemoveUserAsync(deleteConfirmed.Id, null)))
        {
            Users?.Remove(deleteConfirmed);
        }

        StateHasChanged();
    }

    bool Remove(ApplicationUser user)
    {
        MHD.MessageYesNo(ResourceApp.delete, AppLoc[LocalizerConst.deleteConfirmMsg, user.Email ?? string.Empty], MhdState.Warning, EventCallback.Factory.Create(this, () => RemoveAsync(user)));
        return true;
    }

    void Delete_Click(ApplicationUser user)
    {
        MHD.DeleteMessage(user.Email, EventCallback.Factory.Create(this, () => Remove(user)));
    }


    List<ApplicationUser>? Users;

    async Task GetUsersAsync()
    {
        MHD.Loading.Begin();
        Users = null;
        Users = await UsersService.GetUsersAsync(null);
        MHD.Loading.End();
        StateHasChanged();
    }
}
