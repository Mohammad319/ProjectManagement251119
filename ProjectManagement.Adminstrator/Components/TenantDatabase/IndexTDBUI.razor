@using AuthPermissions.Entity
@using BlazorMHD.UI.Components.Data.Table
@using ContextMenuMHD
@using Domain.Repository.AuthPermissions
@using Microsoft.EntityFrameworkCore
@using ProjectManagement.Adminstrator.Services.Users
@using ProjectManagement.Shared.DTO.Tenant
@attribute [Authorize(Roles = PMRolesConst.APP.AdminSuperManger)]
@inherits AppComponentBase
@inject IUsersService sersService
@inject ApplicationDbContext context

<div class="pm-page">
    <section class="pm-card overflow-hidden">
        <div class="pm-card-header">
            <div>
                <h2 class="pm-title">@AppControll.Db</h2>
                <p class="pm-subtitle mt-1">Manage tenant database entries and connection strings used by the admin application.</p>
            </div>

            <div class="pm-toolbar">
                <span class="pm-chip">@(Tenants?.Count ?? 0)</span>
                <button class="pm-btn-success" @onclick="() => UpdateForm(new())">@ResourceApp._new</button>
            </div>
        </div>

        <div class="pm-card-body">
            @if (Tenants is { Count: > 0 })
            {
                <div class="overflow-x-auto">
                    <MhdTable TItem="TenantDatabaseEntity" Items="Tenants" ShowFilter="false">
                        <HeaderTemplate>
                            <th class="w-40 p-2 text-left text-sm font-semibold text-slate-700 dark:text-slate-200"></th>
                            <th class="p-2 text-left text-sm font-semibold text-slate-700 dark:text-slate-200">@CalcResource.name</th>
                            <th class="p-2 text-left text-sm font-semibold text-slate-700 dark:text-slate-200">@AppControll.Db</th>
                        </HeaderTemplate>
                        <ChildContent>
                            <MhdTableColumn>
                                <Template Context="tenant">
                                    <div class="flex items-center gap-2 py-1">
                                        <button class="pm-icon-btn-amber"
                                                title="@ResourceApp.edit"
                                                @onclick="() => UpdateForm(tenant)">
                                            @Icons.Edit
                                        </button>
                                        <button class="pm-icon-btn-danger"
                                                title="@ResourceApp.delete"
                                                @onclick="() => Remove(tenant)">
                                            @((MarkupString)Icons.Delete)
                                        </button>
                                    </div>
                                </Template>
                            </MhdTableColumn>
                            <MhdTableColumn>
                                <Template Context="tenant">
                                    <div class="min-w-40 py-1">
                                        <p class="font-medium text-slate-900 dark:text-slate-100">@tenant.Name</p>
                                    </div>
                                </Template>
                            </MhdTableColumn>
                            <MhdTableColumn>
                                <Template Context="tenant">
                                    <div class="max-w-[42rem] truncate py-1 text-sm text-slate-600 dark:text-slate-300"
                                         title="@tenant.ConnectionString"
                                         @oncontextmenu:preventDefault
                                         @oncontextmenu="() => Context(tenant)">
                                        @tenant.ConnectionString
                                    </div>
                                </Template>
                            </MhdTableColumn>
                        </ChildContent>
                    </MhdTable>
                </div>
            }
            else
            {
                <div class="pm-empty">@AppLoc[nameof(ResourceApp.ThereAreNoItemsToDisplay)]</div>
            }
        </div>
    </section>
</div>

@code{
    List<TenantDatabaseEntity>? Tenants;

    void UpdateForm(TenantDatabaseEntity model)
    {
        TenantDatabaseEntity post = new();
        PropertyCopier.CopyPropertiesTo(model, post);

        Modal.ShowComponent<IndexTDBFormUI>(model.Id == 0 ?
        AppLoc[LocalizerConst.New, AppControll.tenant] : ResourceApp.update,
            new Dictionary<string, object>
            {
                [nameof(IndexTDBFormUI.Put)] = post,
                [nameof(IndexTDBFormUI.Callback)] = EventCallback.Factory.Create<bool>(this, CallBack)
            });
    }

    async Task CallBack(bool newLoading)
    {
        Modal.Close();
        if (newLoading)
        {
            Tenants = await context.TenantDatabase
                .AsNoTracking()
                .OrderBy(x => x.Name)
                .ToListAsync();
        }
    }

    void Remove(TenantDatabaseEntity obj)
    {
        MHD.DeleteMessage(obj.Name, EventCallback.Factory.Create(this, () => RemoveAsync(obj)));
    }

    async Task RemoveAsync(TenantDatabaseEntity obj)
    {
        context.TenantDatabase.Remove(obj);
        await context.SaveChangesAsync();
        Tenants?.Remove(obj);
        MHD.ToastMessage(ResourceApp.delete, ToastType.Delete, true);
    }

    protected async override Task OnInitializedAsync()
    {
        Tenants = await context.TenantDatabase
            .AsNoTracking()
            .OrderBy(x => x.Name)
            .ToListAsync();
    }

    async Task Context(TenantDatabaseEntity item)
    {
        var list = new List<MenuItem>()
        {
            new() { Label = $"✏️ {ResourceApp.edit}", OnClickAsync = () => { UpdateForm(item); return Task.CompletedTask; } },
            new() { Label = $"🗑️ {ResourceApp.delete}", OnClickAsync = () => { Remove(item); return Task.CompletedTask; } },
        };
        await ContextService.ShowMenuAsync(list);
    }
}
