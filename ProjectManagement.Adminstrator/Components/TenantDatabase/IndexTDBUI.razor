@using AuthPermissions.Entity
@using BlazorMHD.UI.Components.Data.Table
@using ContextMenuMHD
@using Domain.Repository.AuthPermissions
@using Microsoft.EntityFrameworkCore
@using ProjectManagement.Adminstrator.Services.Users
@using ProjectManagement.Shared.DTO.Tenant
@attribute [Authorize(Roles = PMRolesConst.APP.AdminManger)]
@inherits AppComponentBase
@inject IUsersService sersService
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<div class="space-y-3 text-slate-900 dark:text-slate-100">
    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-950/80 overflow-hidden">
        <div class="border-b border-slate-200 px-4 py-3 dark:border-slate-800">
            <div>
                <h2 class="text-lg font-semibold tracking-tight text-slate-900 dark:text-slate-100">@AppControll.Db</h2>
                <p class="mt-1 text-sm text-slate-600 dark:text-slate-400 mt-1">Manage tenant database entries and connection strings used by the admin application.</p>
            </div>

            <div class="flex flex-wrap items-center gap-2">
                <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[11px] font-semibold text-slate-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200">@(Tenants?.Count ?? 0)</span>
                <button class="inline-flex items-center justify-center gap-2 rounded-xl border border-emerald-600 bg-emerald-600 px-3 py-2 text-xs font-medium text-white transition hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-500/30 disabled:cursor-not-allowed disabled:opacity-60 dark:border-emerald-500 dark:bg-emerald-500 dark:hover:bg-emerald-400" @onclick="() => UpdateForm(new())">@ResourceApp._new</button>
            </div>
        </div>

        <div class="px-4 py-3">
            @if (_loading)
            {
                <div class="flex min-h-[120px] items-center justify-center text-sm text-slate-500 dark:text-slate-400">
                    <BlazorMHD.UI.Components.Feedback.Loading.MhdLoading />
                </div>
            }
            else if (_loadError is not null)
            {
                <div class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 dark:border-rose-900/60 dark:bg-rose-950/40 dark:text-rose-300">
                    <strong>Error:</strong> @_loadError
                </div>
            }
            else if (Tenants is { Count: > 0 })
            {
                <div class="overflow-x-auto">
                    <MhdTable TItem="TenantDatabaseEntity" Items="Tenants" ShowFilter="false">
                        <HeaderTemplate>
                            <th class="w-40 p-2 text-left text-sm font-semibold text-slate-700 dark:text-slate-200"></th>
                            <th class="p-2 text-left text-sm font-semibold text-slate-700 dark:text-slate-200">@CalcResource.name</th>
                            <th class="p-2 text-left text-sm font-semibold text-slate-700 dark:text-slate-200">@AppControll.Db</th>
                        </HeaderTemplate>
                        <ChildContent>
                            <MhdTableColumn>
                                <Template Context="tenant">
                                    <div class="flex items-center gap-2 py-1">
                                        <button class="inline-flex h-9 w-9 items-center justify-center rounded-xl border border-amber-200 bg-amber-50 text-amber-700 transition hover:bg-amber-100 focus:outline-none focus:ring-2 focus:ring-amber-500/20 dark:border-amber-900/60 dark:bg-amber-950/40 dark:text-amber-300 dark:hover:bg-amber-950/60"
                                                title="@ResourceApp.edit"
                                                @onclick="() => UpdateForm(tenant)">
                                            @Icons.Edit
                                        </button>
                                        <button class="inline-flex h-9 w-9 items-center justify-center rounded-xl border border-rose-200 bg-rose-50 text-rose-700 transition hover:bg-rose-100 focus:outline-none focus:ring-2 focus:ring-rose-500/20 dark:border-rose-900/60 dark:bg-rose-950/40 dark:text-rose-300 dark:hover:bg-rose-950/60"
                                                title="@ResourceApp.delete"
                                                @onclick="() => Remove(tenant)">
                                            @((MarkupString)Icons.Delete)
                                        </button>
                                    </div>
                                </Template>
                            </MhdTableColumn>
                            <MhdTableColumn>
                                <Template Context="tenant">
                                    <div class="min-w-40 py-1">
                                        <p class="font-medium text-slate-900 dark:text-slate-100">@tenant.Name</p>
                                    </div>
                                </Template>
                            </MhdTableColumn>
                            <MhdTableColumn>
                                <Template Context="tenant">
                                    <div class="max-w-[42rem] truncate py-1 text-sm text-slate-600 dark:text-slate-300"
                                         title="@tenant.ConnectionString"
                                         @oncontextmenu:preventDefault
                                         @oncontextmenu="() => Context(tenant)">
                                        @tenant.ConnectionString
                                    </div>
                                </Template>
                            </MhdTableColumn>
                        </ChildContent>
                    </MhdTable>
                </div>
            }
            else
            {
                <div class="flex min-h-[180px] flex-col items-center justify-center rounded-2xl border border-dashed border-slate-300 bg-slate-50/70 px-4 py-8 text-center dark:border-slate-700 dark:bg-slate-900/40">@AppLoc[nameof(ResourceApp.ThereAreNoItemsToDisplay)]</div>
            }
        </div>
    </section>
</div>

@code{
    List<TenantDatabaseEntity>? Tenants;
    bool _loading = true;
    string? _loadError;

    void UpdateForm(TenantDatabaseEntity model)
    {
        TenantDatabaseEntity post = new();
        PropertyCopier.CopyPropertiesTo(model, post);

        Modal.ShowComponent<IndexTDBFormUI>(model.Id == 0 ?
        AppLoc[LocalizerConst.New, AppControll.tenant] : ResourceApp.update,
            new Dictionary<string, object>
            {
                [nameof(IndexTDBFormUI.Put)] = post,
                [nameof(IndexTDBFormUI.Callback)] = EventCallback.Factory.Create<bool>(this, CallBack)
            });
    }

    async Task CallBack(bool newLoading)
    {
        Modal.Close();
        if (newLoading)
            await LoadAsync();
    }

    void Remove(TenantDatabaseEntity obj)
    {
        MHD.DeleteMessage(obj.Name, EventCallback.Factory.Create(this, () => RemoveAsync(obj)));
    }

    async Task RemoveAsync(TenantDatabaseEntity obj)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        db.TenantDatabase.Remove(obj);
        await db.SaveChangesAsync();
        Tenants?.Remove(obj);
        MHD.ToastMessage(ResourceApp.delete, ToastType.Delete, true);
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            Tenants = await db.TenantDatabase
                .AsNoTracking()
                .OrderBy(x => x.Name)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
            Tenants = null;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    async Task Context(TenantDatabaseEntity item)
    {
        var list = new List<MenuItem>()
        {
            new() { Label = $"✏️ {ResourceApp.edit}", OnClickAsync = () => { UpdateForm(item); return Task.CompletedTask; } },
            new() { Label = $"🗑️ {ResourceApp.delete}", OnClickAsync = () => { Remove(item); return Task.CompletedTask; } },
        };
        await ContextService.ShowMenuAsync(list);
    }
}
