@using AuthPermissions.Entity
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> ContextFactory

    <div class="@CssClasses.Modal.Body">
            <EditForm Model="@Put" OnValidSubmit="async () => await HandleSubmitAsync()" FormName="tenantDatabaseForm" id="tenantForm">
                <DataAnnotationsValidator />
                <ValidationSummary />
            <div class="@CssClasses.Grid.Span.MD4">
            <div>
                <label class="@CssClasses.Form.Label">@CalcResource.name:</label>
                <InputText class="@CssClasses.Input.Text" @bind-Value="@Put.Name" />
                <ValidationMessage For=@(() => Put.Name) />
            </div>
            <div>
                <label class="@CssClasses.Form.Label">ConnectionString:</label>
                <InputText class="@CssClasses.Input.Text" @bind-Value="@Put.ConnectionString" />
                <ValidationMessage For=@(() => Put.ConnectionString) />
            </div>
            </div>

    </EditForm>
           </div>
@code {
    [Parameter] public TenantDatabaseEntity Put { get; set; } = new();
    [Parameter] public EventCallback<bool> Callback { get; set; }
    private async Task HandleSubmitAsync()
    {
        using var context = ContextFactory.CreateDbContext();

        if (Put.Id == 0)
        {
            context.TenantDatabase.Add(Put);
        }
        else
        {
            context.TenantDatabase.Update(Put);
        }

        await context.SaveChangesAsync();
        await Callback.InvokeAsync(true);
    }
}
