@using AuthPermissions.Entity
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> ContextFactory

<div class="pm-form-shell">
    <EditForm Model="@Put" OnValidSubmit="HandleSubmitAsync" id="tenantForm" class="pm-form-shell">
        <DataAnnotationsValidator />

        <section class="pm-form-section">
            <div>
                <h3 class="pm-form-section-title">Tenant database</h3>
                <p class="pm-form-section-text">Define the display name and connection string used by the tenant shard.</p>
            </div>

            <div class="pm-form-grid-2">
                <div class="pm-field">
                    <label class="pm-label">@CalcResource.name</label>
                    <InputText class="pm-input" @bind-Value="@Put.Name" />
                    <ValidationMessage For="@(() => Put.Name)" class="pm-validation-message" />
                </div>

                <div class="pm-field md:col-span-2">
                    <label class="pm-label">ConnectionString</label>
                    <InputText class="pm-input" @bind-Value="@Put.ConnectionString" />
                    <ValidationMessage For="@(() => Put.ConnectionString)" class="pm-validation-message" />
                </div>
            </div>
        </section>
    </EditForm>

    <div class="pm-toolbar">
        <button type="submit" form="tenantForm" class="pm-btn-success">
            @ResourceApp.save
        </button>

        <button type="button" class="pm-btn-secondary" @onclick="() => Callback.InvokeAsync(false)">
            @ResourceApp.cancel
        </button>
    </div>
</div>

@code {
    [Parameter] public TenantDatabaseEntity Put { get; set; } = new();
    [Parameter] public EventCallback<bool> Callback { get; set; }

    private async Task HandleSubmitAsync()
    {
        using var context = ContextFactory.CreateDbContext();

        if (Put.Id == 0)
        {
            context.TenantDatabase.Add(Put);
        }
        else
        {
            context.TenantDatabase.Update(Put);
        }

        await context.SaveChangesAsync();
        await Callback.InvokeAsync(true);
    }
}
