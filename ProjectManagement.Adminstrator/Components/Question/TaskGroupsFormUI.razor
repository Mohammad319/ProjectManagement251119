@using Microsoft.EntityFrameworkCore
@using TaskResourceBlueprints.Entities
@using TaskResourceBlueprints.Entities.Questions.Groups
@using TaskResourceBlueprints.Entities.Resources
@using TaskResourceBlueprints.Entities.Tasks
@using TaskResourceBlueprints.Infrastructure
@using ProjectManagement.Adminstrator.Components.Question.QuestionConditionList.Shared
@using ProjectManagement.Shared.Base.ProjectAppStorage
@using ProjectManagement.Shared.Enums
@inherits AppComponentBase
@using TaskResourceBlueprints.Services.Resource
@inject TaskResourceBlueprints.Services.TaskGroups.ITaskGroupsQueryService TaskGroupsQuery
@inject IResourceCategoryService ResourceCategoryService

@code {
    TaskDefinition Task { get; set; } = default!;
    [Parameter] public int ID { get; set; } = default!;
    List<ResourceCategory> Folders { get; set; } = [];
    ResourceCategory? Selected;
    [Parameter] public EventCallback<bool> OnSaved { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Task = await TaskGroupsQuery.GetTaskWithConditionsAsync(ID, CancellationToken.None)
               ?? new TaskDefinition();
        Folders = (await ResourceCategoryService.GetVisibleFoldersAsync(Task.Id, CancellationToken.None))
            .Select(f => new ResourceCategory() { Id = f.Id, DisplayName = f.DisplayName }).ToList();
        Task.QuestionGroups ??= [];
        Task.NumericQuestions ??= [];
        Task.ResourceSelectors ??= [];
    }

    private async Task SaveAsync()
    {
        NormalizeNestedSortOrders();
        await TaskGroupsQuery.SaveTaskConditionsAsync(Task, CancellationToken.None);
        await OnSaved.InvokeAsync(true);
        Close();
    }

    private void Close() => MHD.Modal.Close();

    private void AddChoiceGroup()
        => Task.QuestionGroups.Add(new QuestionGroupDefinition
        {
            TaskId = ID,
            DisplayName = AppLoc["questionGroupDefaultName"],
            SortOrder = Task.QuestionGroups.Count
        });

    private void RemoveChoiceGroup(QuestionGroupDefinition g)
        => Task.QuestionGroups.Remove(g);

    private void AddChoiceOption(QuestionGroupDefinition g)
    {
        g.Options.Add(new QuestionOptionDefinition
        {
            QuestionGroupId = g.Id,
            DisplayName = AppLoc["questionOptionDefaultName"],
            SortOrder = g.Options.Count
        });
        NormalizeNestedSortOrders();
    }

    private void RemoveChoiceOption(QuestionGroupDefinition g, QuestionOptionDefinition o)
    {
        g.Options.Remove(o);
        NormalizeNestedSortOrders();
    }

    private void AddNumericGroup()
        => Task.NumericQuestions.Add(new NumericQuestionDefinition
        {
            TaskId = ID,
            DisplayName = AppLoc["numericGroupDefaultName"],
            SortOrder = Task.NumericQuestions.Count
        });

    private void RemoveNumericGroup(NumericQuestionDefinition g)
        => Task.NumericQuestions.Remove(g);

    private void AddResourceGroup()
        => Task.ResourceSelectors.Add(new ResourceSelectorDefinition
        {
            TaskId = ID,
            DisplayName = AppLoc["resourceGroupDefaultName"],
            SortOrder = Task.ResourceSelectors.Count
        });

    private void RemoveResourceGroup(ResourceSelectorDefinition g)
        => Task.ResourceSelectors.Remove(g);

    private void AddResourceItem(ResourceSelectorDefinition g)
    {
        g.Items.Add(new ResourceOptionItem
        {
            SelectorId = g.Id,
            SortOrder = g.Items.Count
        });
        NormalizeNestedSortOrders();
    }

    private void RemoveResourceItem(ResourceSelectorDefinition g, ResourceOptionItem it)
    {
        g.Items.Remove(it);
        NormalizeNestedSortOrders();
    }

    void AddDelete(ResourceSelectorDefinition group, ResourceDefinition res)
    {
        if (group.Items.Any(x => x.ResourceId == res.Id))
        {
            var item = group.Items.FirstOrDefault(x => x.ResourceId == res.Id);
            if (item != null) group.Items.Remove(item);
        }
        else
        {
            var toadd = new ResourceOptionItem
            {
                SelectorId = group.Id,
                ResourceId = res.Id,
                Resource = res,
                SortOrder = group.Items.Count
            };
            group.Items.Add(toadd);
        }

        NormalizeNestedSortOrders();
    }

    async Task LoadResourcesAsync(ResourceCategory folders)
    {
        if (folders.Resources == null || folders.Resources.Count == 0)
        {
            Selected = null;
            folders.Resources = (await ResourceCategoryService.GetFolderResourcesAsync(folders.Id, CancellationToken.None)).ToList();
        }
        Selected = folders;
        StateHasChanged();
    }

    private static void MoveUp<T>(IList<T> list, T item)
    {
        var i = list.IndexOf(item);
        if (i > 0) (list[i - 1], list[i]) = (list[i], list[i - 1]);
    }

    private static void MoveDown<T>(IList<T> list, T item)
    {
        var i = list.IndexOf(item);
        if (i >= 0 && i < list.Count - 1) (list[i + 1], list[i]) = (list[i], list[i + 1]);
    }

    private void NormalizeNestedSortOrders()
    {
        foreach (var group in Task.QuestionGroups ?? [])
        {
            for (var i = 0; i < group.Options.Count; i++)
                group.Options[i].SortOrder = i;
        }

        foreach (var selector in Task.ResourceSelectors ?? [])
        {
            for (var i = 0; i < selector.Items.Count; i++)
                selector.Items[i].SortOrder = i;
        }
    }

    private void MoveChoiceOptionUp(QuestionGroupDefinition group, QuestionOptionDefinition option)
    {
        MoveUp(group.Options, option);
        NormalizeNestedSortOrders();
    }

    private void MoveChoiceOptionDown(QuestionGroupDefinition group, QuestionOptionDefinition option)
    {
        MoveDown(group.Options, option);
        NormalizeNestedSortOrders();
    }

    private void MoveResourceItemUp(ResourceSelectorDefinition group, ResourceOptionItem item)
    {
        MoveUp(group.Items, item);
        NormalizeNestedSortOrders();
    }

    private void MoveResourceItemDown(ResourceSelectorDefinition group, ResourceOptionItem item)
    {
        MoveDown(group.Items, item);
        NormalizeNestedSortOrders();
    }

    private static string GetRevealKeys(QuestionOptionDefinition o)
        => o?.RevealedSectionKeys is { Count: > 0 } ? string.Join(", ", o.RevealedSectionKeys) : string.Empty;

    private static void SetRevealKeys(QuestionOptionDefinition o, string? input)
    {
        if (o is null) return;
        if (string.IsNullOrWhiteSpace(input)) { o.RevealedSectionKeys = new List<string>(); return; }

        o.RevealedSectionKeys = input
            .Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(x => x.Trim())
            .Where(x => x.Length > 0)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }
}

@if (Task == null)
{
    <div class="pm-empty">@AppLoc["loading"]</div>
}
else
{
    <EditForm Model="Task" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />

        <div class="pm-page">
            <div class="pm-page-header">
                <div class="min-w-0 flex-1">
                    <h3 class="pm-page-title">@Task.Name</h3>
                    <p class="pm-page-subtitle">@CalcResource.name</p>
                </div>

                <div class="pm-action-stack">
                    <button type="submit" class="pm-btn-success">@ResourceApp.save</button>
                    <button type="button" class="pm-btn-neutral" @onclick="Close">@ResourceApp.cancel</button>
                </div>
            </div>

            <div class="pm-card-soft">
                <ValidationSummary class="text-sm text-rose-600 dark:text-rose-300" />
                <div class="grid grid-cols-1 gap-3 md:grid-cols-[minmax(0,1fr)_auto] md:items-end">
                    <div>
                        <label class="pm-label">@CalcResource.name</label>
                        <input class="pm-input-readonly" value="@Task?.Name" readonly />
                    </div>
                    <div class="pm-chip">@(Task.QuestionGroups.Count + Task.NumericQuestions.Count + Task.ResourceSelectors.Count) items</div>
                </div>
            </div>

            <section class="pm-section">
                <div class="pm-section-header">
                    <div>
                        <h4 class="pm-section-title">@AppLoc["choiceGroups"]</h4>
                        <p class="pm-section-subtitle">Configure selectable groups and reveal logic.</p>
                    </div>
                    <button type="button" class="pm-btn-success" @onclick="AddChoiceGroup">@AppLoc["addGroup"]</button>
                </div>

                @if (Task.QuestionGroups is { Count: > 0 })
                {
                    <div class="grid grid-cols-1 gap-4 xl:grid-cols-2">
                        @foreach (var g in Task.QuestionGroups.OrderBy(x => x.SortOrder))
                        {
                            <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900/60">
                                <div class="pm-grid-form">
                                    <div class="md:col-span-3">
                                        <label class="pm-label">@CalcResource.name</label>
                                        <input class="pm-input" @bind="g.DisplayName" />
                                    </div>

                                    <div class="md:col-span-2">
                                        <label class="pm-label">@CalcResource.sort</label>
                                        <input type="number" class="pm-input" @bind="g.SortOrder" />
                                    </div>

                                    <div class="md:col-span-3">
                                        <label class="pm-label">@AppLoc["sectionKey"]</label>
                                        <input class="pm-input" @bind="g.SectionKey" placeholder="@AppLoc["optionalPlaceholder"]" />
                                    </div>

                                    <div class="md:col-span-2">
                                        <label class="pm-label">@AppLoc["selection"]</label>
                                        <select class="pm-input" @bind="g.SelectionMode">
                                            <option value="@SelectionMode.Multiple">@AppLoc["multiple"]</option>
                                            <option value="@SelectionMode.Single">@AppLoc["single"]</option>
                                        </select>
                                    </div>

                                    <div class="md:col-span-2 flex items-end justify-end gap-2">
                                        <button type="button" class="pm-btn-danger !px-3 !py-2 !text-xs" @onclick="(() => RemoveChoiceGroup(g))">×</button>
                                        <button type="button" class="pm-btn-primary !px-3 !py-2 !text-xs" @onclick="(() => AddChoiceOption(g))">@AppLoc["addOption"]</button>
                                    </div>
                                </div>

                                @if (g.Options?.Count > 0)
                                {
                                    <div class="mt-4 space-y-3">
                                        @foreach (var o in g.Options.OrderBy(x => x.SortOrder))
                                        {
                                            <div class="rounded-2xl border border-slate-200 bg-white p-3 shadow-sm dark:border-slate-700 dark:bg-slate-950/70">
                                                <div class="pm-grid-form">
                                                    <div class="md:col-span-4">
                                                        <label class="pm-label">@AppLoc["optionLabel"]</label>
                                                        <input class="pm-input" @bind="o.DisplayName" />
                                                    </div>

                                                    <div class="md:col-span-6">
                                                        <label class="pm-label">@AppLoc["revealSectionKeys"]</label>
                                                        <input class="pm-input"
                                                               value="@GetRevealKeys(o)"
                                                               @onchange="e => SetRevealKeys(o, e.Value?.ToString())"
                                                               placeholder="@AppLoc["revealSectionKeysPlaceholder"]" />
                                                    </div>

                                                    <div class="md:col-span-2 flex items-end justify-end gap-2">
                                                        <button type="button" class="pm-btn-neutral !px-3 !py-2 !text-xs" @onclick="(() => MoveChoiceOptionUp(g, o))">@AppLoc["setDefault"]</button>
                                                        <button type="button" class="pm-btn-neutral !px-3 !py-2 !text-xs" @onclick="(() => MoveChoiceOptionUp(g, o))">↑</button>
                                                        <button type="button" class="pm-btn-neutral !px-3 !py-2 !text-xs" @onclick="(() => MoveChoiceOptionDown(g, o))">↓</button>
                                                        <button type="button" class="pm-btn-danger !px-3 !py-2 !text-xs" @onclick="(() => RemoveChoiceOption(g, o))">×</button>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="pm-empty">@AppLoc["noChoiceGroups"]</div>
                }
            </section>

            <section class="pm-section">
                <div class="pm-section-header">
                    <div>
                        <h4 class="pm-section-title">@AppLoc["numericGroups"]</h4>
                        <p class="pm-section-subtitle">Add numeric questions with optional min/max limits.</p>
                    </div>
                    <button type="button" class="pm-btn-success" @onclick="AddNumericGroup">@AppLoc["addGroup"]</button>
                </div>

                @if (Task.NumericQuestions?.Count > 0)
                {
                    <div class="grid grid-cols-1 gap-4 xl:grid-cols-2">
                        @foreach (var g in Task.NumericQuestions.OrderBy(x => x.SortOrder))
                        {
                            <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900/60">
                                <div class="pm-grid-form">
                                    <div class="md:col-span-3">
                                        <label class="pm-label">@CalcResource.name</label>
                                        <input class="pm-input" @bind="g.DisplayName" />
                                    </div>

                                    <div class="md:col-span-2">
                                        <label class="pm-label">@CalcResource.sort</label>
                                        <input type="number" class="pm-input" @bind="g.SortOrder" />
                                    </div>

                                    <div class="md:col-span-3">
                                        <label class="pm-label">@AppLoc["sectionKey"]</label>
                                        <input class="pm-input" @bind="g.SectionKey" placeholder="@AppLoc["optionalPlaceholder"]" />
                                    </div>

                                    <div class="md:col-span-2">
                                        <label class="pm-label">@AppControll.min</label>
                                        <input type="number" class="pm-input" @bind="g.MinInputValue" />
                                    </div>

                                    <div class="md:col-span-2">
                                        <label class="pm-label">@AppControll.max</label>
                                        <input type="number" class="pm-input" @bind="g.MaxInputValue" />
                                    </div>

                                    <div class="md:col-span-12 flex justify-end">
                                        <button type="button" class="pm-btn-danger !px-3 !py-2 !text-xs" @onclick="(() => RemoveNumericGroup(g))">×</button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="pm-empty">@AppLoc["noNumericGroups"]</div>
                }
            </section>

            <section class="pm-section">
                <div class="pm-section-header">
                    <div>
                        <h4 class="pm-section-title">@AppLoc["resourceChoiceGroups"]</h4>
                        <p class="pm-section-subtitle">Select resources and define their order inside the task.</p>
                    </div>
                    <button type="button" class="pm-btn-success" @onclick="AddResourceGroup">@AppLoc["addGroup"]</button>
                </div>

                @if (Task.ResourceSelectors?.Count > 0)
                {
                    <div class="grid grid-cols-1 gap-4 xl:grid-cols-2">
                        @foreach (var g in Task.ResourceSelectors.OrderBy(x => x.SortOrder))
                        {
                            <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900/60">
                                <div class="pm-grid-form">
                                    <div class="md:col-span-4">
                                        <label class="pm-label">@CalcResource.name</label>
                                        <input class="pm-input" @bind="g.DisplayName" />
                                    </div>

                                    <div class="md:col-span-2">
                                        <label class="pm-label">@CalcResource.sort</label>
                                        <input type="number" class="pm-input" @bind="g.SortOrder" />
                                    </div>

                                    <div class="md:col-span-4">
                                        <label class="pm-label">@AppLoc["sectionKey"]</label>
                                        <input class="pm-input" @bind="g.SectionKey" placeholder="@AppLoc["optionalPlaceholder"]" />
                                    </div>

                                    <div class="md:col-span-2 flex items-end justify-end">
                                        <button type="button" class="pm-btn-danger !px-3 !py-2 !text-xs" @onclick="(() => RemoveResourceGroup(g))">×</button>
                                    </div>
                                </div>

                                <div class="mt-4">
                                    <FolderResourcesAddUI TaskId="Task.Id"
                                                          ResIds="(g.Items ?? []).Select(x => x.ResourceId).ToList()"
                                                          OnSave="(e)=>AddDelete(g,e)" />
                                </div>

                                @if (g.Items?.Count > 0)
                                {
                                    <div class="mt-4 space-y-3">
                                        @foreach (var it in g.Items.OrderBy(x => x.SortOrder))
                                        {
                                            <div class="rounded-2xl border border-slate-200 bg-white p-3 shadow-sm dark:border-slate-700 dark:bg-slate-950/70">
                                                <div class="pm-grid-form">
                                                    <div class="md:col-span-10">
                                                        <label class="pm-label">@AppLoc["resource"]</label>
                                                        <ResourceAutocomplete MinChars="2" PageSize="20"
                                                                              InitialName="@it.Resource?.Name"
                                                                              Value="it.ResourceId"
                                                                              ValueChanged="@(v => it.ResourceId = v ?? 0)" />
                                                    </div>

                                                    <div class="md:col-span-2 flex items-end justify-end gap-2">
                                                        <button type="button" class="pm-btn-neutral !px-3 !py-2 !text-xs" @onclick="(() => MoveResourceItemUp(g, it))">↑</button>
                                                        <button type="button" class="pm-btn-neutral !px-3 !py-2 !text-xs" @onclick="(() => MoveResourceItemDown(g, it))">↓</button>
                                                        <button type="button" class="pm-btn-danger !px-3 !py-2 !text-xs" @onclick="(() => RemoveResourceItem(g, it))">×</button>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="pm-empty">@AppLoc["noResourceGroups"]</div>
                }
            </section>
        </div>
    </EditForm>
}
