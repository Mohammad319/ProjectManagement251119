                            @onclick="AddNumericGroup">
                        @AppLoc["addGroup"]
                    </button>
                </div>

                @if (Task.NumericQuestions?.Count > 0)
                {
                    <div class="space-y-0.5">
                        @foreach (var g in Task.NumericQuestions.OrderBy(x => x.SortOrder))
                        {
                            <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-1 shadow-sm dark:border-slate-700 dark:bg-slate-900/60">
                                <div class="overflow-x-auto">
                                    <div class="grid min-w-[1050px] grid-cols-12 gap-1 items-end">
                                        <div class="col-span-3 space-y-0.5">
                                            <label class="block text-[11px] font-medium text-slate-700 dark:text-slate-300">@CalcResource.name</label>
                                            <input class="block w-full rounded-lg border border-slate-300 bg-white px-1.5 py-0.5 text-xs text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
                                                   @bind="g.DisplayName" />
                                        </div>

                                        <div class="col-span-1 space-y-0.5">
                                            <label class="block text-[11px] font-medium text-slate-700 dark:text-slate-300">@CalcResource.sort</label>
                                            <input type="number"
                                                   class="block w-full rounded-lg border border-slate-300 bg-white px-1.5 py-0.5 text-xs text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
                                                   @bind="g.SortOrder" />
                                        </div>

                                        <div class="col-span-3 space-y-0.5">
                                            <label class="block text-[11px] font-medium text-slate-700 dark:text-slate-300">@AppLoc["sectionKey"]</label>
                                            <input class="block w-full rounded-lg border border-slate-300 bg-white px-1.5 py-0.5 text-xs text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
                                                   @bind="g.SectionKey"
                                                   placeholder="@AppLoc["optionalPlaceholder"]" />
                                        </div>

                                        <div class="col-span-2 space-y-0.5">
                                            <label class="block text-[11px] font-medium text-slate-700 dark:text-slate-300">@AppControll.min</label>
                                            <input type="number"
                                                   class="block w-full rounded-lg border border-slate-300 bg-white px-1.5 py-0.5 text-xs text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
                                                   @bind="g.MinInputValue" />
                                        </div>

                                        <div class="col-span-2 space-y-0.5">
                                            <label class="block text-[11px] font-medium text-slate-700 dark:text-slate-300">@AppControll.max</label>
                                            <input type="number"
                                                   class="block w-full rounded-lg border border-slate-300 bg-white px-1.5 py-0.5 text-xs text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
                                                   @bind="g.MaxInputValue" />
                                        </div>

                                        <div class="col-span-1 flex items-end justify-end">
                                            <button type="button"
                                                    class="inline-flex items-center justify-center rounded-lg border border-rose-600 bg-rose-600 px-1.5 py-0.5 text-[11px] font-medium text-white transition hover:bg-rose-700 focus:outline-none focus:ring-2 focus:ring-rose-500/30 dark:border-rose-500 dark:bg-rose-500 dark:hover:bg-rose-400"
                                                    @onclick="(() => RemoveNumericGroup(g))">
                                                ×
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="flex min-h-[72px] items-center justify-center rounded-xl border border-dashed border-slate-300 bg-slate-50/70 px-1.5 py-0.5 text-center text-xs dark:border-slate-700 dark:bg-slate-900/40">
                        @AppLoc["noNumericGroups"]
                    </div>
                }
            </section>

            <section class="rounded-xl border border-slate-200 bg-white p-1 shadow-sm dark:border-slate-800 dark:bg-slate-950/80">
                <div class="mb-0.5 flex items-center justify-between gap-1">
                    <h4 class="text-xs font-semibold text-slate-900 dark:text-slate-100">@AppLoc["resourceChoiceGroups"]</h4>
                    <button type="button"
                            class="inline-flex items-center justify-center rounded-lg border border-emerald-600 bg-emerald-600 px-1.5 py-0.5 text-[11px] font-medium text-white transition hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-500/30 dark:border-emerald-500 dark:bg-emerald-500 dark:hover:bg-emerald-400"
                            @onclick="AddResourceGroup">
                        @AppLoc["addGroup"]
                    </button>
                </div>

                @if (Task.ResourceSelectors?.Count > 0)
                {
                    <div class="space-y-0.5">
                        @foreach (var g in Task.ResourceSelectors.OrderBy(x => x.SortOrder))
                        {
                            <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-1 shadow-sm dark:border-slate-700 dark:bg-slate-900/60">
                                <div class="overflow-x-auto">
                                    <div class="grid min-w-[980px] grid-cols-12 gap-1 items-end">
                                        <div class="col-span-3 space-y-0.5">
                                            <label class="block text-[11px] font-medium text-slate-700 dark:text-slate-300">@CalcResource.name</label>
                                            <input class="block w-full rounded-lg border border-slate-300 bg-white px-1.5 py-0.5 text-xs text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
                                                   @bind="g.DisplayName" />
                                        </div>

                                        <div class="col-span-1 space-y-0.5">
                                            <label class="block text-[11px] font-medium text-slate-700 dark:text-slate-300">@CalcResource.sort</label>
                                            <input type="number"
                                                   class="block w-full rounded-lg border border-slate-300 bg-white px-1.5 py-0.5 text-xs text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
                                                   @bind="g.SortOrder" />
                                        </div>

                                        <div class="col-span-6 space-y-0.5">
                                            <label class="block text-[11px] font-medium text-slate-700 dark:text-slate-300">@AppLoc["sectionKey"]</label>
                                            <input class="block w-full rounded-lg border border-slate-300 bg-white px-1.5 py-0.5 text-xs text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
                                                   @bind="g.SectionKey"
                                                   placeholder="@AppLoc["optionalPlaceholder"]" />
                                        </div>

                                        <div class="col-span-2 flex items-end justify-end">
                                            <button type="button"
                                                    class="inline-flex items-center justify-center rounded-lg border border-rose-600 bg-rose-600 px-1.5 py-0.5 text-[11px] font-medium text-white transition hover:bg-rose-700 focus:outline-none focus:ring-2 focus:ring-rose-500/30 dark:border-rose-500 dark:bg-rose-500 dark:hover:bg-rose-400"
                                                    @onclick="(() => RemoveResourceGroup(g))">
                                                ×
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <div class="mt-0.5">
                                    <FolderResourcesAddUI TaskId="Task.Id"
                                                          ResIds="(g.Items ?? []).Select(x => x.ResourceId).ToList()"
                                                          OnSave="(e)=>AddDelete(g,e)" />
                                </div>

                                @if (g.Items?.Count > 0)
                                {
                                    <div class="mt-0.5 space-y-0.5">
                                        @foreach (var it in g.Items.OrderBy(x => x.SortOrder))
                                        {
                                            <div class="overflow-x-auto">
                                                <div class="grid min-w-[820px] grid-cols-12 gap-1 items-end rounded-xl border border-slate-200 bg-white p-1 shadow-sm dark:border-slate-700 dark:bg-slate-950/70">
                                                    <div class="col-span-9 space-y-0.5">
                                                        <label class="block text-[11px] font-medium text-slate-700 dark:text-slate-300">@AppLoc["resource"]</label>
                                                        <ResourceAutocomplete MinChars="2"
                                                                              PageSize="20"
                                                                              InitialName="@it.Resource?.Name"
                                                                              Value="it.ResourceId"
                                                                              ValueChanged="@(v => it.ResourceId = v ?? 0)" />
                                                    </div>

                                                    <div class="col-span-3 flex items-end justify-end gap-0.5">
                                                        <button type="button"
                                                                class="inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-1 py-0.5 text-[11px] font-medium text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-400/30 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
                                                                @onclick="(() => MoveResourceItemUp(g, it))">
                                                            ↑
                                                        </button>

                                                        <button type="button"
                                                                class="inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-1 py-0.5 text-[11px] font-medium text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-400/30 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
                                                                @onclick="(() => MoveResourceItemDown(g, it))">
                                                            ↓
                                                        </button>

                                                        <button type="button"
                                                                class="inline-flex items-center justify-center rounded-lg border border-rose-600 bg-rose-600 px-1 py-0.5 text-[11px] font-medium text-white transition hover:bg-rose-700 focus:outline-none focus:ring-2 focus:ring-rose-500/30 dark:border-rose-500 dark:bg-rose-500 dark:hover:bg-rose-400"
                                                                @onclick="(() => RemoveResourceItem(g, it))">
                                                            ×
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="flex min-h-[72px] items-center justify-center rounded-xl border border-dashed border-slate-300 bg-slate-50/70 px-1.5 py-0.5 text-center text-xs dark:border-slate-700 dark:bg-slate-900/40">
                        @AppLoc["noResourceGroups"]
                    </div>
                }
            </section>
        </div>
    </EditForm>
}