@using Microsoft.EntityFrameworkCore
@using TaskResourceBlueprints.Entities
@using TaskResourceBlueprints.Entities.Questions.Groups
@using TaskResourceBlueprints.Entities.Resources
@using TaskResourceBlueprints.Entities.Tasks
@using TaskResourceBlueprints.Infrastructure
@using ProjectManagement.Adminstrator.Components.Question.QuestionConditionList.Shared
@using ProjectManagement.Shared.Base.ProjectAppStorage
@using ProjectManagement.Shared.Enums
@inherits AppComponentBase
@using NewCC = ProjectManagement.Adminstrator.Constants.CssClassesV3
@using CsS = ProjectManagement.Shared.Constant.CssClasses
@using TaskResourceBlueprints.Services.Resource
@inject TaskResourceBlueprints.Services.TaskGroups.ITaskGroupsQueryService TaskGroupsQuery
@inject IResourceCategoryService ResourceCategoryService

@code {
    TaskDefinition Task { get; set; } = new();
    [Parameter] public int ID { get; set; } = default!;
    List<ResourceCategory> Folders { get; set; } = new();
    ResourceCategory? Selected;
    [Parameter] public EventCallback<bool> OnSaved { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Task = await TaskGroupsQuery.GetTaskWithConditionsAsync(ID, CancellationToken.None)
               ?? new TaskDefinition();
        Folders = (await ResourceCategoryService.GetVisibleFoldersAsync(Task.Id, CancellationToken.None))
.Select(f => new ResourceCategory() { Id = f.Id, DisplayName = f.DisplayName }).ToList();

    }

    private async Task SaveAsync()
    {
        await TaskGroupsQuery.SaveTaskConditionsAsync(Task, CancellationToken.None);
        await OnSaved.InvokeAsync(true);
        Close();
    }

    private void Close() => MHD.Modal.Close();

    // ====== Choice ======
    private void AddChoiceGroup()
        => Task.QuestionGroups.Add(new QuestionGroupDefinition { TaskId = ID, DisplayName = "Group", SortOrder = Task.QuestionGroups.Count });

    private void RemoveChoiceGroup(QuestionGroupDefinition g)
        => Task.QuestionGroups.Remove(g);

    private void AddChoiceOption(QuestionGroupDefinition g)
        => g.Options.Add(new QuestionOptionDefinition { QuestionGroupId = g.Id, DisplayName = "Option" });

    private void RemoveChoiceOption(QuestionGroupDefinition g, QuestionOptionDefinition o)
        => g.Options.Remove(o);

    // ====== Numeric ======
    private void AddNumericGroup()
        => Task.NumericQuestions.Add(new NumericQuestionDefinition { TaskId = ID, DisplayName = "Numeric", SortOrder = Task.NumericQuestions.Count });

    private void RemoveNumericGroup(NumericQuestionDefinition g)
        => Task.NumericQuestions.Remove(g);

    // ====== Resources ======
    private void AddResourceGroup()
        => Task.ResourceSelectors.Add(new ResourceSelectorDefinition { TaskId = ID, DisplayName = "Resources", SortOrder = Task.ResourceSelectors.Count });

    private void RemoveResourceGroup(ResourceSelectorDefinition g)
        => Task.ResourceSelectors.Remove(g);

    private void AddResourceItem(ResourceSelectorDefinition g)
        => g.Items.Add(new ResourceOptionItem { SelectorId = g.Id });

    private void RemoveResourceItem(ResourceSelectorDefinition g, ResourceOptionItem it)
        => g.Items.Remove(it);

    void AddDelete(ResourceSelectorDefinition group, ResourceDefinition res)
    {
        if (group.Items.Any(x => x.ResourceId == res.Id))
        {
            var item = group.Items.FirstOrDefault(x => x.ResourceId == res.Id);
            if (item != null) group.Items.Remove(item);
        }
        else
        {
            var toadd = new ResourceOptionItem { SelectorId = group.Id, ResourceId = res.Id, Resource = res };
            group.Items.Add(toadd);
        }
    }

    async Task LoadResourcesAsync(ResourceCategory folders)
    {
        if (folders.Resources == null || folders.Resources.Count == 0)
        {
            Selected = null;
            folders.Resources = (await ResourceCategoryService.GetFolderResourcesAsync(folders.Id, CancellationToken.None)).ToList();
        }
        Selected = folders;
        StateHasChanged();
    }

    // ====== Move helpers ======
    private static void MoveUp<T>(IList<T> list, T item)
    {
        var i = list.IndexOf(item);
        if (i > 0) (list[i - 1], list[i]) = (list[i], list[i - 1]);
    }

    private static void MoveDown<T>(IList<T> list, T item)
    {
        var i = list.IndexOf(item);
        if (i >= 0 && i < list.Count - 1) (list[i + 1], list[i]) = (list[i], list[i + 1]);
    }

    // ====== Helpers: RevealSectionKeys ======
    private static string GetRevealKeys(QuestionOptionDefinition o)
        => o?.RevealedSectionKeys is { Count: > 0 } ? string.Join(", ", o.RevealedSectionKeys) : string.Empty;

    private static void SetRevealKeys(QuestionOptionDefinition o, string? input)
    {
        if (o is null) return;
        if (string.IsNullOrWhiteSpace(input)) { o.RevealedSectionKeys = new List<string>(); return; }

        o.RevealedSectionKeys = input
            .Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(x => x.Trim())
            .Where(x => x.Length > 0)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }
}

@if (Task == null)
{
    <div class="@NewCC.Text.MutedXs">Loading…</div>
}
else
{
    <EditForm Model="Task" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

            <!-- Header: Task name + actions -->
            <div class="@CsS.Layout.FlexItemsCenter @CsS.Spacing.M.Bottom1">
                <div class="@CsS.Layout.FlexMinWidth280">
                    <label class="@CsS.Form.Label">@CalcResource.name</label>
                    <input class="@CsS.Input.Text" value="@Task?.Name" readonly />
                </div>

                <div class="@CsS.Layout.FlexWrap @CsS.Util.PlaceSelfEnd">
                    <button type="submit" class="@CsS.Btn.Outline.Primary">@ResourceApp.save</button>
                    <button type="button" class="@CsS.Btn.Outline.Secondary" @onclick="Close">@ResourceApp.cancel</button>
                </div>
            </div>

            <!-- Choice Groups -->
            <section class="@NewCC.Card.Panel">
                <div class="@CsS.Layout.FlexItemsCenter md:flex-nowrap flex-wrap">
                    <h4 class="@NewCC.Text.SemiBold">Choice Groups</h4>
                    <button type="button" class="@CsS.Btn.Outline.Success @CsS.Spacing.M.LeftAuto" @onclick="AddChoiceGroup">Add Group</button>
                </div>

                @if (Task?.QuestionGroups is { Count: > 0 })
                {
                    @foreach (var g in Task.QuestionGroups.OrderBy(x => x.SortOrder))
                    {
                        <div class="@NewCC.Card.SubPanel">
                            <div class="@CsS.Grid.Col.MD12">
                                <div class="@CsS.Grid.Span.MD3">
                                    <label class="@CsS.Form.Label">@CalcResource.name</label>
                                    <input class="@CsS.Input.Text" @bind="g.DisplayName" />
                                </div>

                                <div class="@CsS.Grid.Span.MD2">
                                    <label class="@CsS.Form.Label">Order</label>
                                    <input type="number" class="@CsS.Input.Number" @bind="g.SortOrder" />
                                </div>

                                <div class="@CsS.Grid.Span.MD3">
                                    <label class="@CsS.Form.Label">Section Key</label>
                                    <input class="@CsS.Input.Text" @bind="g.SectionKey" placeholder="(optional)" />
                                </div>

                                <div class="@CsS.Grid.Span.MD2">
                                    <label class="@CsS.Form.Label">Selection</label>
                                    <select class="@CsS.Input.Select" @bind="g.SelectionMode">
                                        <option value="@SelectionMode.Multiple">Multiple</option>
                                        <option value="@SelectionMode.Single">Single</option>
                                    </select>
                                </div>

                                <div class="@CsS.Grid.Span.MD2 @CsS.Util.PlaceSelfEnd">
                                    <div class="@CsS.Layout.Inline">
                                        <button type="button" class="@CsS.Btn.Outline.Danger" @onclick="(() => RemoveChoiceGroup(g))">x</button>
                                        <button type="button" class="@CsS.Btn.Outline.Primary" @onclick="(() => AddChoiceOption(g))">Add Option</button>
                                    </div>
                                </div>
                            </div>

                            @if (g.Options?.Count > 0)
                            {
                                <div class="@CsS.Spacing.M.Top2">
                                    @foreach (var o in g.Options)
                                    {
                                        <div class="@NewCC.Card.SoftMuted @CsS.Spacing.P.All2 @CsS.Spacing.M.Bottom2">
                                            <div class="@CsS.Grid.Col.MD12">
                                                <div class="@CsS.Grid.Span.MD4">
                                                    <label class="@CsS.Form.Label">Option Label</label>
                                                    <input class="@CsS.Input.Text" @bind="o.DisplayName" />
                                                </div>

                                                <div class="@CsS.Grid.Span.MD6">
                                                    <label class="@NewCC.Text.LabelXs @CsS.Spacing.M.Bottom1">
                                                        Reveal Section Keys (comma-separated)
                                                    </label>
                                                    <input class="@CsS.Input.Text"
                                                           value="@GetRevealKeys(o)"
                                                           @onchange="e => SetRevealKeys(o, e.Value?.ToString())"
                                                           placeholder="e.g. details, advanced, extras" />
                                                </div>

                                                <div class="@CsS.Grid.Span.MD2 @CsS.Util.PlaceSelfEnd">
                                                    <div class="@CsS.Layout.Inline">
                                                    <button type="button" class="@CsS.Btn.Outline.Secondary" @onclick="(() => MoveUp(g.Options, o))">Set Default</button>

                                                        <button type="button" class="@CsS.Btn.Outline.Secondary" @onclick="(() => MoveUp(g.Options, o))">↑</button>
                                                        <button type="button" class="@CsS.Btn.Outline.Secondary" @onclick="(() => MoveDown(g.Options, o))">↓</button>
                                                        <button type="button" class="@CsS.Btn.Outline.Danger" @onclick="(() => RemoveChoiceOption(g, o))">x</button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="@NewCC.Text.MutedXs">No choice groups.</div>
                }
            </section>

            <!-- Numeric Groups -->
            <section class="@NewCC.Card.Panel">
                <div class="@CsS.Layout.FlexItemsCenter md:flex-nowrap flex-wrap">
                    <h4 class="@NewCC.Text.SemiBold">Numeric Groups</h4>
                    <button type="button" class="@CsS.Btn.Outline.Success @CsS.Spacing.M.LeftAuto" @onclick="AddNumericGroup">Add Group</button>
                </div>

                @if ((Task?.NumericQuestions?.Count ?? 0) > 0)
                {
                    @foreach (var g in (Task?.NumericQuestions ?? Enumerable.Empty<NumericQuestionDefinition>()).OrderBy(x => x.SortOrder))
                    {
                        <div class="@NewCC.Card.SubPanel">
                            <!-- NOTE: this row is 8 columns; keep spans sum = 8 -->
                            <div class="@CsS.Grid.Col.MD8">
                                <div class="@CsS.Grid.Span.MD2">
                                    <label class="@CsS.Form.Label">Name</label>
                                    <input class="@CsS.Input.Text" @bind="g.DisplayName" />
                                </div>

                                <div class="@CsS.Grid.Span.MD1">
                                    <label class="@CsS.Form.Label">Order</label>
                                    <input type="number" class="@CsS.Input.Number" @bind="g.SortOrder" />
                                </div>

                                <div class="@CsS.Grid.Span.MD2">
                                    <label class="@CsS.Form.Label">Section Key</label>
                                    <input class="@CsS.Input.Text" @bind="g.SectionKey" placeholder="(optional)" />
                                </div>

                                <div class="@CsS.Grid.Span.MD1">
                                    <label class="@CsS.Form.Label">Min</label>
                                    <input type="number" class="@CsS.Input.Number" @bind="g.MinInputValue" />
                                </div>

                                <div class="@CsS.Grid.Span.MD1">
                                    <label class="@CsS.Form.Label">Max</label>
                                    <input type="number" class="@CsS.Input.Number" @bind="g.MaxInputValue" />
                                </div>

                                <div class="@CsS.Grid.Span.MD1 @CsS.Util.PlaceSelfEnd">
                                    <button type="button" class="@CsS.Btn.Outline.Danger" @onclick="(() => RemoveNumericGroup(g))">x</button>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="@NewCC.Text.MutedXs">No numeric groups.</div>
                }
            </section>

            <!-- Resource Choice Groups -->
            <section class="@NewCC.Card.Panel">
                <div class="@CsS.Layout.FlexItemsCenter md:flex-nowrap flex-wrap">
                    <h4 class="@NewCC.Text.SemiBold">Resource Choice Groups</h4>
                    <button type="button" class="@CsS.Btn.Outline.Success @CsS.Spacing.M.LeftAuto" @onclick="AddResourceGroup">Add Group</button>
                </div>

                @if (Task.ResourceSelectors?.Count > 0)
                {
                    @foreach (var g in Task.ResourceSelectors.OrderBy(x => x.SortOrder))
                    {
                        <div class="@NewCC.Card.SubPanel">
                            <div class="@CsS.Grid.Col.MD12">
                                <div class="@CsS.Grid.Span.MD4">
                                    <label class="@CsS.Form.Label">Name</label>
                                    <input class="@CsS.Input.Text" @bind="g.DisplayName" />
                                </div>

                                <div class="@CsS.Grid.Span.MD2">
                                    <label class="@CsS.Form.Label">Order</label>
                                    <input type="number" class="@CsS.Input.Number" @bind="g.SortOrder" />
                                </div>

                                <div class="@CsS.Grid.Span.MD4">
                                    <label class="@CsS.Form.Label">Section Key</label>
                                    <input class="@CsS.Input.Text" @bind="g.SectionKey" placeholder="(optional)" />
                                </div>

                                <div class="@CsS.Grid.Span.MD2 @CsS.Util.PlaceSelfEnd">
                                    <button type="button" class="@CsS.Btn.Outline.Danger" @onclick="(() => RemoveResourceGroup(g))">x</button>
                                </div>
                            </div>

                            <div class="@CsS.Spacing.M.Top2">
                                <FolderResourcesAddUI TaskId="Task.Id"
                                                      ResIds="(g.Items ?? new List<ResourceOptionItem>()).Select(x => x.ResourceId).ToList()"
                                                      OnSave="(e)=>AddDelete(g,e)" />

                                @if (g.Items?.Count > 0)
                                {
                                    @foreach (var it in g.Items)
                                    {
                                        <div class="@CsS.Grid.Col.MD12 @CsS.Spacing.M.Bottom2">
                                            <div class="@CsS.Grid.Span.MD10">
                                                <label class="@CsS.Form.Label">Resource</label>
                                                <ResourceAutocomplete MinChars="2" PageSize="20"
                                                                      InitialName="@it.Resource?.Name"
                                                                      Value="it.ResourceId"
                                                                      ValueChanged="@(v => it.ResourceId = v ?? 0)"
                                                                      />
                                            </div>

                                            <div class="@CsS.Grid.Span.MD2 @CsS.Util.PlaceSelfEnd">
                                                <div class="@CsS.Layout.Inline">
                                                    <button type="button" class="@CsS.Btn.Outline.Secondary" @onclick="(() => MoveUp(g.Items, it))">↑</button>
                                                    <button type="button" class="@CsS.Btn.Outline.Secondary" @onclick="(() => MoveDown(g.Items, it))">↓</button>
                                                    <button type="button" class="@CsS.Btn.Outline.Danger" @onclick="(() => RemoveResourceItem(g, it))">x</button>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="@NewCC.Text.MutedXs">No resource groups.</div>
                }
            </section>

    </EditForm>
}
