        <DataAnnotationsValidator />

        <div class="space-y-0.5 text-slate-900 dark:text-slate-100">
            <div class="rounded-xl border border-slate-200 bg-white px-1.5 py-0.5 shadow-sm dark:border-slate-800 dark:bg-slate-950/80">
