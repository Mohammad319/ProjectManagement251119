                                            </button>
                                        </div>
                                    </div>
                                </div>

                                @if (g.Options?.Count > 0)
                                {
                                    <div class="mt-0.5 space-y-0.5">
                                        @foreach (var o in g.Options.OrderBy(x => x.SortOrder))
                                        {
