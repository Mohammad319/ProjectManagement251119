                                                   @bind="g.DisplayName" />
                                        </div>

                                        <div class="col-span-1 space-y-0.5">
                                            <label class="block text-[11px] font-medium text-slate-700 dark:text-slate-300">@CalcResource.sort</label>
                                            <input type="number"
                                                   class="block w-full rounded-lg border border-slate-300 bg-white px-1.5 py-0.5 text-xs text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
                                                   @bind="g.SortOrder" />
                                        </div>

                                        <div class="col-span-3 space-y-0.5">
                                            <label class="block text-[11px] font-medium text-slate-700 dark:text-slate-300">@AppLoc["sectionKey"]</label>
                                            <input class="block w-full rounded-lg border border-slate-300 bg-white px-1.5 py-0.5 text-xs text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
                                                   @bind="g.SectionKey"
                                                   placeholder="@AppLoc["optionalPlaceholder"]" />
                                        </div>

                                        <div class="col-span-2 space-y-0.5">
                                            <label class="block text-[11px] font-medium text-slate-700 dark:text-slate-300">@AppLoc["selection"]</label>
                                            <select class="block w-full rounded-lg border border-slate-300 bg-white px-1.5 py-0.5 text-xs text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
                                                    @bind="g.SelectionMode">
                                                <option value="@SelectionMode.Multiple">@AppLoc["multiple"]</option>
                                                <option value="@SelectionMode.Single">@AppLoc["single"]</option>
                                            </select>
                                        </div>

