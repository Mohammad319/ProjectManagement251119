@using System
@using System.Collections.Generic
@using System.Linq
@using Microsoft.AspNetCore.Components
@using Microsoft.EntityFrameworkCore
@using ProjectManagement.Adminstrator.Components
@using TaskResourceBlueprints.Entities.Questions.Conditions
@using TaskResourceBlueprints.Entities.Questions.Groups
@using TaskResourceBlueprints.Services.QuestionConditions
@inherits AppComponentBase
@inject ITaskConditionsService ConditionsService

@code {
    [Parameter] public int TaskId { get; set; }

    private List<ConditionDefinition> conditions = new();
    private ConditionDefinition? editing;
    private bool isLoading = true;
    private string? error;
    private List<QuestionGroupDefinition> taskChoiceGroups = new();
    private List<NumericQuestionDefinition> taskNumericGroups = new();
    private List<ResourceSelectorDefinition> resourceGroups = new();

    private readonly Dictionary<int, List<OptionBindVM>> optBindsByRA = new();
    private readonly Dictionary<int, List<NumericBindVM>> numBindsByRA = new();

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            isLoading = true;
            error = null;

            conditions = await ConditionsService.GetConditionsAsync(TaskId, CancellationToken.None);
            resourceGroups = await ConditionsService.GetResourceGroupsAsync(TaskId, CancellationToken.None);
            taskChoiceGroups = await ConditionsService.GetChoiceGroupsAsync(TaskId, CancellationToken.None);
            taskNumericGroups = await ConditionsService.GetNumericGroupsAsync(TaskId, CancellationToken.None);

            optBindsByRA.Clear();
            numBindsByRA.Clear();

            var raIds = conditions
                .SelectMany(c => c.Assignments)
                .Select(a => a.Id)
                .Distinct()
                .ToArray();

            if (raIds.Length > 0)
            {
                var optDict = await ConditionsService.GetOptionBindsByResourceAssignmentsAsync(raIds, CancellationToken.None);
                var numDict = await ConditionsService.GetNumericBindsByResourceAssignmentsAsync(raIds, CancellationToken.None);

                foreach (var pair in optDict)
                    optBindsByRA[pair.Key] = pair.Value;

                foreach (var pair in numDict)
                    numBindsByRA[pair.Key] = pair.Value;
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void NewCondition()
    {
        editing = new ConditionDefinition
        {
            TaskId = TaskId,
            OptionResourceLogic = ConditionLogic.And,
            OptionNumericLogic = ConditionLogic.And,
            NumericResourceLogic = ConditionLogic.And,
            OptionRules = new(),
            VariableRules = new(),
            ResourceRules = new(),
            NumericRules = new(),
            Assignments = new()
        };

        optBindsByRA.Clear();
        numBindsByRA.Clear();
    }

    private async Task EditConditionAsync(int id)
    {
        editing = await ConditionsService.GetConditionAsync(id, CancellationToken.None);
        if (editing is null)
            return;

        var raIds = editing.Assignments.Select(a => a.Id).Distinct().ToArray();
        optBindsByRA.Clear();
        numBindsByRA.Clear();

        foreach (var raId in raIds)
        {
            optBindsByRA[raId] = new();
            numBindsByRA[raId] = new();
        }

        if (raIds.Length == 0)
            return;

        var optDict = await ConditionsService.GetOptionBindsByResourceAssignmentsAsync(raIds, CancellationToken.None);
        var numDict = await ConditionsService.GetNumericBindsByResourceAssignmentsAsync(raIds, CancellationToken.None);

        foreach (var pair in optDict)
            optBindsByRA[pair.Key] = pair.Value;

        foreach (var pair in numDict)
            numBindsByRA[pair.Key] = pair.Value;
    }

    private async Task DeleteConditionAsync(int id)
    {
        await ConditionsService.DeleteConditionAsync(id, CancellationToken.None);
        await LoadAsync();
    }

    private async Task SaveConditionAsync()
    {
        if (editing is null)
            return;

        foreach (var ra in editing.Assignments)
            ra.Resource = null!;

        await ConditionsService.UpsertConditionAsync(editing, CancellationToken.None);
        editing = null;
        await LoadAsync();
    }

    private void CancelEdit() => editing = null;

    private async Task SaveOptionBindingAsync(int raId, OptionBindVM vm)
    {
        if (vm.ChoiceOptionId == 0)
        {
            vm.LastError = AppLoc["chooseOptionFirst"];
            return;
        }

        try
        {
            var id = await ConditionsService.UpsertOptionBindingAsync(raId, vm, CancellationToken.None);
            vm.Id = id;
            vm.SavedOk = true;
            vm.LastError = null;
        }
        catch (DbUpdateException ex)
        {
            vm.SavedOk = false;
            vm.LastError = ex.InnerException?.Message ?? ex.Message;
        }
        catch (Exception ex)
        {
            vm.SavedOk = false;
            vm.LastError = ex.Message;
        }
    }

    private async Task SaveNumericBindingAsync(int raId, NumericBindVM vm)
    {
        if (vm.NumericId == 0)
        {
            vm.LastError = AppLoc["chooseNumericGroupFirst"];
            return;
        }

        try
        {
            var id = await ConditionsService.UpsertNumericBindingAsync(raId, vm, CancellationToken.None);
            vm.Id = id;
            vm.SavedOk = true;
            vm.LastError = null;
        }
        catch (DbUpdateException ex)
        {
            vm.SavedOk = false;
            vm.LastError = ex.InnerException?.Message ?? ex.Message;
        }
        catch (Exception ex)
        {
            vm.SavedOk = false;
            vm.LastError = ex.Message;
        }
    }

    private async Task DeleteOptionBindingAsync(int raId, OptionBindVM vm)
    {
        if (vm.Id > 0)
            await ConditionsService.DeleteOptionBindingAsync(vm.Id, CancellationToken.None);

        if (optBindsByRA.TryGetValue(raId, out var list))
            list.Remove(vm);
    }

    private async Task DeleteNumericBindingAsync(int raId, NumericBindVM vm)
    {
        if (vm.Id > 0)
            await ConditionsService.DeleteNumericBindingAsync(vm.Id, CancellationToken.None);

        if (numBindsByRA.TryGetValue(raId, out var list))
            list.Remove(vm);
    }
}

<div dir="ltr" class="space-y-2 text-slate-900 dark:text-slate-100">
    @if (isLoading)
    {
        <div class="rounded-lg border border-sky-200 bg-sky-50 px-2.5 py-1.5 text-xs text-sky-700 dark:border-sky-900/60 dark:bg-sky-950/40 dark:text-sky-200">@AppLoc["loading"]</div>
    }
    else if (!string.IsNullOrEmpty(error))
    {
        <div class="rounded-lg border border-rose-200 bg-rose-50 px-2.5 py-1.5 text-xs text-rose-700 dark:border-rose-900/60 dark:bg-rose-950/40 dark:text-rose-300">@AppLoc["error"]: @error</div>
    }
    else if (editing is null)
    {
        <section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-950/80">
            <div class="border-b border-slate-200 px-2.5 py-2 dark:border-slate-800">
                <div>
                    <h3 class="text-sm font-semibold tracking-tight text-slate-900 dark:text-slate-100">Conditions</h3>
                </div>

                <div class="flex flex-wrap items-center gap-2">
                    <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[11px] font-semibold text-slate-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200">@conditions.Count</span>
                    <button class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-sky-600 bg-sky-600 px-2.5 py-1.5 text-[11px] font-medium text-white transition hover:bg-sky-700 focus:outline-none focus:ring-2 focus:ring-sky-500/30 disabled:cursor-not-allowed disabled:opacity-60 dark:border-sky-500 dark:bg-sky-500 dark:hover:bg-sky-400" @onclick="NewCondition">@AppLoc["addCondition"]</button>
                </div>
            </div>

            <div class="px-2.5 py-2">
                <ConditionList Conditions="conditions"
                               ResourceGroups="resourceGroups"
                               ChoiceGroups="taskChoiceGroups"
                               NumericGroups="taskNumericGroups"
                               OnEdit="EditConditionAsync"
                               OnDelete="DeleteConditionAsync" />
            </div>
        </section>
    }
    else
    {
        <section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-950/80 overflow-hidden">
            <div class="border-b border-slate-200 px-2.5 py-2 dark:border-slate-800">
                <div>
                    <h3 class="text-sm font-semibold tracking-tight text-slate-900 dark:text-slate-100">Edit condition</h3>
                </div>

                <div class="flex flex-wrap items-center gap-2">
                    <button class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-emerald-600 bg-emerald-600 px-2.5 py-1.5 text-[11px] font-medium text-white transition hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-500/30 disabled:cursor-not-allowed disabled:opacity-60 dark:border-emerald-500 dark:bg-emerald-500 dark:hover:bg-emerald-400" @onclick="SaveConditionAsync">@AppLoc["save"]</button>
                    <button class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-[11px] font-medium text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-400/30 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800" @onclick="CancelEdit">@AppLoc["cancel"]</button>
                </div>
            </div>

            <div class="px-2.5 py-2">
                <ConditionEditor Condition="editing"
                                 ResourceGroups="resourceGroups"
                                 TaskChoiceGroups="taskChoiceGroups"
                                 TaskNumericGroups="taskNumericGroups"
                                 OptBindsByRA="optBindsByRA"
                                 NumBindsByRA="numBindsByRA"
                                 OnSaveOption="SaveOptionBindingAsync"
                                 OnSaveNumeric="SaveNumericBindingAsync"
                                 OnDeleteOption="DeleteOptionBindingAsync"
                                 OnDeleteNumeric="DeleteNumericBindingAsync" />
            </div>
        </section>
    }
</div>
