@using System
@using System.Collections.Generic
@using System.Linq
@using Microsoft.AspNetCore.Components
@using ProjectManagement.Adminstrator.Components
@using TaskResourceBlueprints.Entities.Questions.Conditions
@using TaskResourceBlueprints.Entities.Questions.Groups
@inherits AppComponentBase

@code {
    [Parameter] public List<ConditionDefinition> Conditions { get; set; } = new();
    [Parameter] public EventCallback<int> OnEdit { get; set; }
    [Parameter] public EventCallback<int> OnDelete { get; set; }
    [Parameter] public List<QuestionGroupDefinition> ChoiceGroups { get; set; } = new();
    [Parameter] public List<ResourceSelectorDefinition> ResourceGroups { get; set; } = new();
    [Parameter] public List<NumericQuestionDefinition> NumericGroups { get; set; } = new();

    private readonly HashSet<int> ExpandedAssignmentConditionIds = new();

    private string RangeLabel(decimal? min, decimal? max)
        => min.HasValue && max.HasValue ? $"[{min}..{max}]"
           : min.HasValue ? $">= {min}"
           : max.HasValue ? $"<= {max}"
           : AppLoc["any"];

    private string FormatLogic(ConditionLogic logic)
        => logic == ConditionLogic.And ? AppLoc["andText"] : AppLoc["orText"];

    private static IEnumerable<IGrouping<int, T>> GroupBySetKey<T>(IEnumerable<T> rows, Func<T, int> keySelector)
        => rows.GroupBy(keySelector).OrderBy(g => g.Key);

    void ToggleResourceAssignments(int conditionId)
    {
        if (!ExpandedAssignmentConditionIds.Add(conditionId))
        {
            ExpandedAssignmentConditionIds.Remove(conditionId);
        }
    }
}

@if (Conditions.Count == 0)
{
    <div class="">@AppLoc["noConditionsYet"]</div>
}
else
{
    <div class="grid grid-cols-1 gap-2 md:grid-cols-2 xl:grid-cols-3 items-stretch">
    @foreach (var c in Conditions)
    {
        <div class="h-full rounded border border-gray-200 bg-white p-2 dark:border-gray-700 dark:bg-gray-900/60">
            <div class="flex items-center gap-1 justify-between mb-1">
                <div class="text-sm">
                    <b>@AppLoc["logic"]:</b>
                    @AppLoc["choiceResourceLogic"]=@FormatLogic(c.OptionResourceLogic),
                    @AppLoc["choiceNumericLogic"]=@FormatLogic(c.OptionNumericLogic),
                    @AppLoc["numericResourceLogic"]=@FormatLogic(c.NumericResourceLogic)
                </div>
                <div class="flex flex-wrap gap-2">
                    @if (c.Assignments.Count > 0)
                    {
                        <button class="px-2 py-1 border border-blue-600 text-blue-600 rounded transition hover:bg-blue-600 hover:text-white dark:border-blue-400 dark:text-blue-400 dark:hover:bg-blue-400 dark:hover:text-white" @onclick="() => ToggleResourceAssignments(c.Id)">
                            @AppLoc["resourceAssignments"]
                        </button>
                    }
                    <button class="px-2 py-1 border border-blue-600 text-blue-600 rounded transition hover:bg-blue-600 hover:text-white dark:border-blue-400 dark:text-blue-400 dark:hover:bg-blue-400 dark:hover:text-white" @onclick="() => OnEdit.InvokeAsync(c.Id)">@ResourceApp.edit</button>
                    <button class="px-2 py-1 border border-red-600 text-red-600 rounded transition hover:bg-red-600 hover:text-white dark:border-red-400 dark:text-red-400 dark:hover:bg-red-400 dark:hover:text-white" @onclick="() => OnDelete.InvokeAsync(c.Id)">@ResourceApp.delete</button>
                </div>
            </div>

            <div class="grid grid-cols-1 gap-1.5 md:grid-cols-3 text-sm">
                <div class="mt-1 rounded border border-gray-200 bg-white/60 p-1 dark:border-gray-700 dark:bg-gray-900/40">
                    <div class="mb-1 font-semibold">@AppLoc["choiceRequirements"]</div>
                    @if (c.OptionRules.Count == 0)
                    {
                        <div class="text-xs text-gray-500 dark:text-gray-400">@AppLoc["none"]</div>
                    }
                    else
                    {
                        @foreach (var set in GroupBySetKey(c.OptionRules, r => r.GroupKey))
                        {
                            <div class="mb-1">
                                <div class="text-[11px] text-gray-600 dark:text-gray-300">
                                    @AppLoc["groupKey"]=@set.Key (@AppLoc["orText"])
                                </div>
                                <div>
                                    @foreach (var r in set)
                                    {
                                        var g = ChoiceGroups.FirstOrDefault(x => x.Id == r.QuestionGroupId);
                                        var o = g?.Options.FirstOrDefault(x => x.Id == r.OptionId);
                                        <div>• @g?.DisplayName -> @o?.DisplayName</div>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>

                <div class="mt-1 rounded border border-gray-200 bg-white/60 p-1 dark:border-gray-700 dark:bg-gray-900/40">
                    <div class="mb-1 font-semibold">@AppLoc["resourceRequirements"]</div>
                    @if (c.ResourceRules.Count == 0)
                    {
                        <div class="text-xs text-gray-500 dark:text-gray-400">@AppLoc["none"]</div>
                    }
                    else
                    {
                        @foreach (var set in GroupBySetKey(c.ResourceRules, r => r.GroupKey))
                        {
                            <div class="mb-1">
                                <div class="text-[11px] text-gray-600 dark:text-gray-300">
                                    @AppLoc["groupKey"]=@set.Key (@AppLoc["orText"])
                                </div>
                                <div>
                                    @foreach (var r in set)
                                    {
                                        var g = ResourceGroups.FirstOrDefault(x => x.Id == r.SelectorId);
                                        var it = g?.Items.FirstOrDefault(x => x.Id == r.SelectorItemId);
                                        <div>• @g?.DisplayName -> @it?.Resource?.Name</div>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>

                <div class="mt-1 rounded border border-gray-200 bg-white/60 p-1 dark:border-gray-700 dark:bg-gray-900/40">
                    <div class="mb-1 font-semibold">@AppLoc["numericRequirements"]</div>
                    @if (c.NumericRules.Count == 0)
                    {
                        <div class="text-xs text-gray-500 dark:text-gray-400">@AppLoc["none"]</div>
                    }
                    else
                    {
                        @foreach (var set in GroupBySetKey(c.NumericRules, r => r.GroupKey))
                        {
                            <div class="mb-1">
                                <div class="text-[11px] text-gray-600 dark:text-gray-300">
                                    @AppLoc["groupKey"]=@set.Key (@AppLoc["orText"])
                                </div>
                                <div>
                                    @foreach (var r in set)
                                    {
                                        var g = NumericGroups.FirstOrDefault(x => x.Id == r.NumericQuestionId);
                                        <div>• @g?.DisplayName - @RangeLabel(r.MinAllowedValue, r.MaxAllowedValue)</div>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            @if (ExpandedAssignmentConditionIds.Contains(c.Id))
            {
                @if (c.Assignments.Count == 0)
                {
                    <div class="mt-1 rounded border border-gray-200 bg-white/60 p-1 text-xs text-gray-500 dark:border-gray-700 dark:bg-gray-900/40 dark:text-gray-400">
                        @AppLoc["resourceAssignments"] - @AppLoc["none"]
                    </div>
                }
                else
                {
                    <div class="mt-1 rounded border border-gray-200 bg-white/60 p-1 dark:border-gray-700 dark:bg-gray-900/40">
                        <div class="mb-1 font-semibold">@AppLoc["resourceAssignments"]</div>
                        <div class="text-sm">
                            @foreach (var a in c.Assignments)
                            {
                                <div>• @a.Resource?.Name, @CalcResource.changeFactor1=@a.ChangeFactor1, @CalcResource.changeFactor2=@a.ChangeFactor2, @CalcResource.cap/@CalcResource.waste=@a.CapWaste, @CalcResource.baseCost=@a.BaseCost</div>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    }
    </div>
}
