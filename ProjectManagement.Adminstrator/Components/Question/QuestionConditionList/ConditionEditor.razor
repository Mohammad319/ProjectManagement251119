@using Microsoft.AspNetCore.Components
@using TaskResourceBlueprints.Entities.Questions.Conditions
@using TaskResourceBlueprints.Entities.Questions.Groups
@using TaskResourceBlueprints.Services.QuestionConditions
@using ProjectManagement.Adminstrator.Components.Question.QuestionConditionList.Shared

@code {
    [Parameter] public ConditionDefinition Condition { get; set; } = null!;
    [Parameter] public List<QuestionGroupDefinition> TaskChoiceGroups { get; set; } = new();
    [Parameter] public List<NumericQuestionDefinition> TaskNumericGroups { get; set; } = new();
    [Parameter] public List<ResourceSelectorDefinition> ResourceGroups { get; set; } = new();

    [Parameter] public Dictionary<int, List<OptionBindVM>> OptBindsByRA { get; set; } = new();
    [Parameter] public Dictionary<int, List<NumericBindVM>> NumBindsByRA { get; set; } = new();

    [Parameter] public Func<int, OptionBindVM, Task> OnSaveOption { get; set; } = (_, _) => Task.CompletedTask;
    [Parameter] public Func<int, NumericBindVM, Task> OnSaveNumeric { get; set; } = (_, _) => Task.CompletedTask;
    [Parameter] public Func<int, OptionBindVM, Task> OnDeleteOption { get; set; } = (_, _) => Task.CompletedTask;
    [Parameter] public Func<int, NumericBindVM, Task> OnDeleteNumeric { get; set; } = (_, _) => Task.CompletedTask;
}

<div class="grid grid-cols-1 md:grid-cols-3 gap-2 mb-1">
    <div>
        <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">Choice ↔ Resource</label>
        <InputSelect TValue="ConditionLogic"
                     @bind-Value="Condition.OptionResourceLogic"
                     class="w-full border border-gray-300 rounded px-2 py-1 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:text-white dark:border-gray-600">
            <option value="And">AND</option>
            <option value="Or">OR</option>
        </InputSelect>
    </div>

    <div>
        <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">Choice ↔ Numeric</label>
        <InputSelect TValue="ConditionLogic"
                     @bind-Value="Condition.OptionNumericLogic"
                     class="w-full border border-gray-300 rounded px-2 py-1 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:text-white dark:border-gray-600">
            <option value="And">AND</option>
            <option value="Or">OR</option>
        </InputSelect>
    </div>

    <div>
        <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">Numeric ↔ @ResourceLoc.resource</label>
        <InputSelect TValue="ConditionLogic"
                     @bind-Value="Condition.NumericResourceLogic"
                     class="w-full border border-gray-300 rounded px-2 py-1 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:text-white dark:border-gray-600">
            <option value="And">AND</option>
            <option value="Or">OR</option>
        </InputSelect>
    </div>
</div>

<RequirementsPanel Condition="Condition"
                   ChoiceGroups="TaskChoiceGroups"
                   NumericGroups="TaskNumericGroups"
                   ResourceGroups="ResourceGroups" />

<ResourceAssignmentsPanel Condition="Condition"
                          TaskChoiceGroups="TaskChoiceGroups"
                          TaskNumericGroups="TaskNumericGroups"
                          OptBindsByRA="OptBindsByRA"
                          NumBindsByRA="NumBindsByRA"
                          OnSaveOption="OnSaveOption"
                          OnSaveNumeric="OnSaveNumeric"
                          OnDeleteOption="OnDeleteOption"
                          OnDeleteNumeric="OnDeleteNumeric" />
