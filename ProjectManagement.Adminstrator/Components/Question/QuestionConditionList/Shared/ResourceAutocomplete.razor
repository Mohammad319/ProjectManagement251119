@using System.Linq
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using ProjectManagement.Adminstrator.Components
@using TaskResourceBlueprints.Dto.Resource
@using TaskResourceBlueprints.Services.Resource

@inherits AppComponentBase

@inject IResourceBlueprintsService ResourceService

<div class="relative min-w-0">
    <input class="@InputCss"
           placeholder="@EffectivePlaceholder"
           value="@_searchText"
           @oninput="OnInput"
           @onkeydown="OnKeyDown"
           @onfocus="() => _isOpen = true"
           disabled="@Disabled" />

    @if (_isOpen && _suggestions.Count > 0)
    {
        <ul class="@DropdownCss">
            @for (int i = 0; i < _suggestions.Count; i++)
            {
                var s = _suggestions[i];
                var isActive = i == _activeIndex;

                <li class="@GetItemCss(isActive)"
                    @onclick="() => SelectSuggestionAsync(i)">
                    <div class="flex flex-col">
                        <span>@s.Name</span>
                        @if (!string.IsNullOrWhiteSpace(s.Group))
                        {
                            <span class="text-xs text-slate-500 dark:text-slate-400">@s.Group</span>
                        }
                    </div>
                </li>
            }

            @if (_hasMore)
            {
                <li class="px-1.5 py-0.5 text-xs text-slate-400 dark:text-slate-500">
                    @AppLoc["moreResultsAvailable"]
                </li>
            }
        </ul>
    }
</div>

@code {
    [Parameter] public int? Value { get; set; }
    [Parameter] public EventCallback<int?> ValueChanged { get; set; }
    [Parameter] public EventCallback<ResourceLookupDto?> ResourceChanged { get; set; }

    [Parameter] public string? InitialName { get; set; }

    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Disabled { get; set; }

    [Parameter] public int MinChars { get; set; } = 2;
    [Parameter] public int SearchDelayMs { get; set; } = 250;
    [Parameter] public int PageSize { get; set; } = 10;

    [Parameter] public string InputCss { get; set; } = "w-full rounded-lg border border-slate-300 bg-white px-1.5 py-0.5 text-xs text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100 dark:placeholder:text-slate-500";
    [Parameter] public string DropdownCss { get; set; } = "absolute z-20 mt-0.5 w-full overflow-hidden rounded-lg border border-slate-200 bg-white shadow-lg dark:border-slate-700 dark:bg-slate-950";
    [Parameter] public string ItemCss { get; set; } = "cursor-pointer px-1.5 py-0.5 text-xs text-slate-700 transition hover:bg-slate-50 dark:text-slate-200 dark:hover:bg-slate-900";
    [Parameter] public string ItemActiveCss { get; set; } = "bg-blue-600 text-white dark:bg-blue-500";

    private string _searchText = string.Empty;
    private bool _isOpen;
    private bool _hasMore;
    private int _activeIndex = -1;
    private List<ResourceLookupDto> _suggestions = new();
    private CancellationTokenSource? _cts;
    private int? _lastAppliedValue;
    private string? _lastAppliedInitialName;

    private string EffectivePlaceholder
        => string.IsNullOrWhiteSpace(Placeholder) ? AppLoc["searchResourcePlaceholder"] : Placeholder!;

    protected override async Task OnParametersSetAsync()
    {
        if (Value != _lastAppliedValue || !string.Equals(InitialName, _lastAppliedInitialName, StringComparison.Ordinal))
        {
            _lastAppliedValue = Value;
            _lastAppliedInitialName = InitialName;

            if (!string.IsNullOrWhiteSpace(InitialName))
            {
                _searchText = InitialName!;
            }
            else if (Value is null or 0)
            {
                _searchText = string.Empty;
            }
        }

        await base.OnParametersSetAsync();
    }

    private async Task OnInput(ChangeEventArgs e)
    {
        _searchText = e.Value?.ToString() ?? string.Empty;
        _isOpen = true;

        _cts?.Cancel();
        _cts = new CancellationTokenSource();

        if (string.IsNullOrWhiteSpace(_searchText))
        {
            _suggestions.Clear();
            _hasMore = false;
            _activeIndex = -1;

            if (Value is not null)
            {
                Value = null;
                await ValueChanged.InvokeAsync(Value);
            }

            if (ResourceChanged.HasDelegate)
                await ResourceChanged.InvokeAsync(null);

            StateHasChanged();
            return;
        }

        if (_searchText.Length < MinChars)
        {
            _suggestions.Clear();
            _hasMore = false;
            _activeIndex = -1;
            StateHasChanged();
            return;
        }

        var token = _cts.Token;

        try
        {
            await Task.Delay(SearchDelayMs, token);
            await LoadSuggestionsAsync(token);
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task LoadSuggestionsAsync(CancellationToken ct)
    {
        var results = await ResourceService.SearchAsync(_searchText, PageSize + 1, ct);

        _hasMore = results.Count > PageSize;
        _suggestions = results.Take(PageSize).ToList();
        _activeIndex = _suggestions.Count > 0 ? 0 : -1;

        StateHasChanged();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (!_isOpen && (e.Key == "ArrowDown" || e.Key == "Enter"))
        {
            _isOpen = true;
        }

        if (!_isOpen)
            return;

        switch (e.Key)
        {
            case "ArrowDown":
                if (_suggestions.Count > 0)
                {
                    _activeIndex = (_activeIndex + 1) % _suggestions.Count;
                    StateHasChanged();
                }
                break;

            case "ArrowUp":
                if (_suggestions.Count > 0)
                {
                    _activeIndex = (_activeIndex - 1 + _suggestions.Count) % _suggestions.Count;
                    StateHasChanged();
                }
                break;

            case "Enter":
                if (_activeIndex >= 0 && _activeIndex < _suggestions.Count)
                {
                    await SelectSuggestionAsync(_activeIndex);
                }
                break;

            case "Escape":
                _isOpen = false;
                StateHasChanged();
                break;
        }
    }

    private async Task SelectSuggestionAsync(int index)
    {
        if (index < 0 || index >= _suggestions.Count)
            return;

        var selected = _suggestions[index];

        _searchText = selected.Name;
        _isOpen = false;

        if (Value != selected.Id)
        {
            Value = selected.Id;
            await ValueChanged.InvokeAsync(Value);
        }

        if (ResourceChanged.HasDelegate)
        {
            await ResourceChanged.InvokeAsync(selected);
        }

        StateHasChanged();
    }

    private string GetItemCss(bool isActive)
        => isActive
            ? $"{ItemCss} {ItemActiveCss}"
            : ItemCss;
}
