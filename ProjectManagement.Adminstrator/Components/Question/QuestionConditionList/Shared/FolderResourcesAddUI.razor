@using TaskResourceBlueprints.Entities
@inject TaskResourceBlueprints.Services.TaskGroups.ITaskGroupsQueryService TaskGroupsQuery
@using TaskResourceBlueprints.Entities.Resources
@using TaskResourceBlueprints.Services.Resource
@inject IResourceCategoryService ResourceCategoryService

<div class="flex flex-wrap gap-3">
    <div class="w-[190px] rounded-xl border border-slate-200 bg-white/90 p-2 dark:border-slate-700 dark:bg-slate-950/60">
        @if (Folders != null) foreach (var r in Folders)
            {
                <div role="button">
                    <button type="button" class="mb-2 inline-flex w-full items-center justify-between rounded-lg border border-blue-600 px-2.5 py-1.5 text-left text-sm text-blue-600 transition hover:bg-blue-600 hover:text-white dark:border-blue-400 dark:text-blue-400 dark:hover:bg-blue-500 dark:hover:text-white" style="width:100%; text-align:left;"
                            @onclick="async () => { await LoadResourcesAsync(r); }">
                        @r.DisplayName
                    </button>
                </div>
            }
    </div>

    <div class="min-w-[320px] flex-1 rounded-xl border border-slate-200 bg-white/90 p-2 dark:border-slate-700 dark:bg-slate-950/60">
        <table class="min-w-full divide-y divide-slate-200 dark:divide-slate-600">
            <thead class="bg-slate-100 dark:bg-slate-700">
                <tr><th class="px-2 py-1.5 text-left text-sm font-semibold text-slate-700 dark:text-slate-200">@CalcResource.name</th></tr>
            </thead>
            <tbody class="divide-y divide-slate-100 hover:divide-slate-200 dark:divide-slate-700">
                @if (Selected != null && Selected.Resources != null && Selected.Resources.Count > 0)
                {
                    foreach (var r in Selected.Resources)
                    {
                        <tr class="hover:bg-slate-50 dark:hover:bg-slate-900/60">
                            <td class="px-2 py-1.5 text-sm text-slate-800 dark:text-slate-200">
                                <div class="flex items-center gap-2">

                                    <button type="button" class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-blue-600 text-sm text-blue-600 transition hover:bg-blue-600 hover:text-white dark:border-blue-400 dark:text-blue-400 dark:hover:bg-blue-500 dark:hover:text-white"
                                            @onclick="async ()=> await AddDelete(r)">
                                        @(ResIds.Any(x => x == r.Id) ? "-" : "+")
                                    </button>
                                    <span class="truncate">@r.Name</span>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

    </div>
</div>
@code {
    [Parameter] public int TaskId { get; set; }
    [Parameter] public EventCallback<ResourceDefinition> OnSave { get; set; }
    [Parameter] public List<int> ResIds { get; set; } = [];

    List<ResourceCategory> Folders { get; set; } = [];
    ResourceCategory? Selected;
    protected override async Task OnInitializedAsync()
    {
        Folders = (await ResourceCategoryService.GetVisibleFoldersAsync(TaskId, CancellationToken.None))
        .Select(f => new ResourceCategory(){Id = f.Id , DisplayName = f.DisplayName}).ToList();
    }
    async Task AddDelete( ResourceDefinition res)
    {
        if (ResIds.Any(x => x == res.Id))
        {
            ResIds.Remove(res.Id);
        }
        else
        {
            ResIds.Add(res.Id);
        }
        await OnSave.InvokeAsync(res);
    }
    async Task LoadResourcesAsync(ResourceCategory folders)
    {
        if (folders.Resources == null || folders.Resources.Count == 0)
        {
            folders.Resources = (await ResourceCategoryService.GetFolderResourcesAsync(folders.Id, CancellationToken.None)).ToList();
        }
        Selected = folders;
        StateHasChanged();
    }
}
