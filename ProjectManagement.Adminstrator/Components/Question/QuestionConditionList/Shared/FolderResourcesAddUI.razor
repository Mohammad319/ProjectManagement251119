@using TaskResourceBlueprints.Entities
@inject TaskResourceBlueprints.Services.TaskGroups.ITaskGroupsQueryService TaskGroupsQuery
@using TaskResourceBlueprints.Entities.Resources
@using TaskResourceBlueprints.Services.Resource
@inject IResourceCategoryService ResourceCategoryService

<div class="flex flex-wrap gap-2">
    <div class="w-[200px]">
        @if (Folders != null) foreach (var r in Folders)
            {
                <div role="button">
                    <button type="button" class="px-2 py-1 border border-blue-600 text-blue-600 rounded transition hover:bg-blue-600 hover:text-white dark:border-blue-400 dark:text-blue-400 dark:hover:bg-blue-400 dark:hover:text-white mb-2" style="width:100%; text-align:left;"
                            @onclick="async () => { await LoadResourcesAsync(r); }">
                        @r.DisplayName
                    </button>
                </div>
            }
    </div>

    <div class="flex-1 min-w-[350px] p-2">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-600">
            <thead class="bg-gray-100 dark:bg-gray-700">
                <tr><th class="p-1 text-left text-sm font-semibold">@CalcResource.name</th></tr>
            </thead>
            <tbody class="divide-y divide-gray-100 hover:divide-gray-200 dark:divide-gray-700">
                @if (Selected != null && Selected.Resources != null && Selected.Resources.Count > 0)
                {
                    foreach (var r in Selected.Resources)
                    {
                        <tr class="p-2 hover:bg-gray-100 dark:hover:bg-gray-800">
                            <td class="p-1 text-sm text-gray-800 dark:text-gray-300">
                                <div class="flex items-center gap-1">

                                    <button type="button" class="px-2 py-1 border border-blue-600 text-blue-600 rounded transition hover:bg-blue-600 hover:text-white dark:border-blue-400 dark:text-blue-400 dark:hover:bg-blue-400 dark:hover:text-white"
                                            @onclick="async ()=> await AddDelete(r)">
                                        @(ResIds.Any(x => x == r.Id) ? "-" : "+")
                                    </button>
                                    <span class="ml-2">@r.Name</span>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

    </div>
</div>
@code {
    [Parameter] public int TaskId { get; set; }
    [Parameter] public EventCallback<ResourceDefinition> OnSave { get; set; }
    [Parameter] public List<int> ResIds { get; set; } = [];

    List<ResourceCategory> Folders { get; set; } = [];
    ResourceCategory? Selected;
    protected override async Task OnInitializedAsync()
    {
        Folders = (await ResourceCategoryService.GetVisibleFoldersAsync(TaskId, CancellationToken.None))
        .Select(f => new ResourceCategory(){Id = f.Id , DisplayName = f.DisplayName}).ToList();
    }
    async Task AddDelete( ResourceDefinition res)
    {
        if (ResIds.Any(x => x == res.Id))
        {
            ResIds.Remove(res.Id);
        }
        else
        {
            ResIds.Add(res.Id);
        }
        await OnSave.InvokeAsync(res);
    }
    async Task LoadResourcesAsync(ResourceCategory folders)
    {
        if (folders.Resources == null || folders.Resources.Count == 0)
        {
            folders.Resources = (await ResourceCategoryService.GetFolderResourcesAsync(folders.Id, CancellationToken.None)).ToList();
        }
        Selected = folders;
        StateHasChanged();
    }
}
