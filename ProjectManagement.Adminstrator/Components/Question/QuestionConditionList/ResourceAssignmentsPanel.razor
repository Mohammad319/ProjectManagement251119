@using System
@using System.Collections.Generic
@using System.Linq
@using Microsoft.AspNetCore.Components
@using ProjectManagement.Adminstrator.Components
@using TaskResourceBlueprints.Entities
@using TaskResourceBlueprints.Entities.Questions.Assignments
@using TaskResourceBlueprints.Entities.Questions.Conditions
@using TaskResourceBlueprints.Entities.Questions.Groups
@using TaskResourceBlueprints.Services.QuestionConditions
@using ProjectManagement.Adminstrator.Components.Question.QuestionConditionList.Shared
@using ProjectManagement.Shared.Base.AppTenant
@using ProjectManagement.Shared.Base.Calculation
@using ProjectManagement.Shared.Enums
@inherits AppComponentBase

@code {
    [Parameter] public ConditionDefinition Condition { get; set; } = null!;

    [Parameter] public List<QuestionGroupDefinition> TaskChoiceGroups { get; set; } = new();
    [Parameter] public List<NumericQuestionDefinition> TaskNumericGroups { get; set; } = new();

    [Parameter] public Dictionary<int, List<OptionBindVM>> OptBindsByRA { get; set; } = new();
    [Parameter] public Dictionary<int, List<NumericBindVM>> NumBindsByRA { get; set; } = new();
    [Parameter] public Func<int, OptionBindVM, Task> OnSaveOption { get; set; } = (_, _) => Task.CompletedTask;
    [Parameter] public Func<int, NumericBindVM, Task> OnSaveNumeric { get; set; } = (_, _) => Task.CompletedTask;
    [Parameter] public Func<int, OptionBindVM, Task> OnDeleteOption { get; set; } = (_, _) => Task.CompletedTask;
    [Parameter] public Func<int, NumericBindVM, Task> OnDeleteNumeric { get; set; } = (_, _) => Task.CompletedTask;

    private bool CanAddBindingsFor(ConditionResourceAssignment a) => a.Id > 0;

    private void RemoveAssignment(ConditionResourceAssignment a)
    {
        Condition.Assignments.Remove(a);
        OptBindsByRA.Remove(a.Id);
        NumBindsByRA.Remove(a.Id);
    }

    private void ToggleAssignment(ResourceDefinition resource)
    {
        if (resource is null) return;

        var existing = Condition.Assignments.FirstOrDefault(x => x.ResourceId == resource.Id);
        if (existing is not null)
        {
            RemoveAssignment(existing);
            StateHasChanged();
            return;
        }

        var metadata = resource.Data;
        Condition.Assignments.Add(new ConditionResourceAssignment
        {
            ResourceId = resource.Id,
            ChangeFactor1 = metadata?.ChangeFactor1 ?? 0,
            ChangeFactor2 = metadata?.ChangeFactor2 ?? 0,
            CapWaste = metadata?.CapWaste ?? 0,
            BaseCost = metadata?.BaseCost ?? 0,
            IsActive = resource.IsActive,
            Resource = new ResourceDefinition
            {
                Id = resource.Id,
                Name = resource.Name,
                ResType = resource.ResType,
                Data = new ResourceMetadata
                {
                    Cost = metadata?.Cost ?? 0,
                    ChangeFactor1 = metadata?.ChangeFactor1 ?? 0,
                    ChangeFactor2 = metadata?.ChangeFactor2 ?? 0,
                    CapWaste = metadata?.CapWaste ?? 0,
                    BaseCost = metadata?.BaseCost ?? 0,
                    Unit = metadata?.Unit ?? string.Empty
                }
            },
            CapacityRoles = []
        });

        StateHasChanged();
    }

    private void AddOptionBindingUI(int raId)
    {
        if (!OptBindsByRA.TryGetValue(raId, out var list))
            OptBindsByRA[raId] = list = new();

        var firstGroup = TaskChoiceGroups.FirstOrDefault();
        var firstOpt = firstGroup?.Options.FirstOrDefault();
        list.Add(new OptionBindVM
        {
            Id = 0,
            ChoiceGroupId = firstGroup?.Id ?? 0,
            ChoiceOptionId = firstOpt?.Id ?? 0,
            Formulas = new()
        });
        StateHasChanged();
    }

    private async Task RemoveOptionBindingUIAsync(int raId, OptionBindVM vm)
    {
        if (vm.Id > 0)
            await OnDeleteOption(raId, vm);

        if (OptBindsByRA.TryGetValue(raId, out var list))
            list.Remove(vm);
    }

    private void OnOptionGroupChanged(OptionBindVM vm, ChangeEventArgs e)
    {
        if (int.TryParse(Convert.ToString(e.Value), out var gid))
        {
            vm.ChoiceGroupId = gid;
            vm.ChoiceOptionId = 0;
        }
    }

    private void AddOptionEq(OptionBindVM vm) => vm.Formulas.Add(string.Empty);

    private void RemoveOptionEq(OptionBindVM vm, int idx)
    {
        if (idx >= 0 && idx < vm.Formulas.Count)
            vm.Formulas.RemoveAt(idx);
    }

    private void AddNumericBindingUI(int raId)
    {
        if (!NumBindsByRA.TryGetValue(raId, out var list))
            NumBindsByRA[raId] = list = new();

        var firstNg = TaskNumericGroups.FirstOrDefault();
        list.Add(new NumericBindVM
        {
            Id = 0,
            NumericId = firstNg?.Id ?? 0,
            Formulas = new()
        });
        StateHasChanged();
    }

    private async Task RemoveNumericBindingUIAsync(int raId, NumericBindVM vm)
    {
        if (vm.Id > 0)
            await OnDeleteNumeric(raId, vm);

        if (NumBindsByRA.TryGetValue(raId, out var list))
            list.Remove(vm);
    }

    private void AddNumericEq(NumericBindVM vm) => vm.Formulas.Add(string.Empty);

    private void RemoveNumericEq(NumericBindVM vm, int idx)
    {
        if (idx >= 0 && idx < vm.Formulas.Count)
            vm.Formulas.RemoveAt(idx);
    }

    private void AddRole(ConditionResourceAssignment a)
    {
        a.CapacityRoles ??= new();
        if (a.CapacityRoles.Count != 0)
        {
            a.CapacityRoles.Add(new RoleDTO
            {
                Min = a.CapacityRoles.Last().Max,
                Max = a.CapacityRoles.Last().Max + 10,
                Value = a.CapacityRoles.Last().Value + 1
            });
        }
        else
        {
            a.CapacityRoles.Add(new RoleDTO
            {
                Min = 0,
                Max = 10,
                Value = 5
            });
        }

        StateHasChanged();
    }
}

<div class="rounded border border-gray-200 bg-white p-1 dark:border-gray-700 dark:bg-gray-900/60">
    <div class="flex items-center gap-1">
        <h5 class="font-medium text-gray-800 dark:text-gray-100">@AppLoc["resourceAssignments"]</h5>
    </div>

    <div>
        <FolderResourcesAddUI TaskId="Condition.TaskId"
                              ResIds="Condition.Assignments.Select(x => x.ResourceId).ToList()"
                              OnSave="ToggleAssignment" />
    </div>

    @if (Condition.Assignments.Count == 0)
    {
        <div>@AppLoc["none"]</div>
    }
    else
    {
        @foreach (var a in Condition.Assignments)
        {
            <div class="mt-2 mb-2 rounded border border-gray-200 bg-white/60 p-1 dark:border-gray-700 dark:bg-gray-900/40">
                <div class="grid grid-cols-1 md:grid-cols-12 gap-2">
                    <div class="md:col-span-3">
                        <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@AppLoc["resource"]</label>
                        <ResourceAutocomplete MinChars="2" PageSize="20"
                                              Value="a.ResourceId"
                                              ValueChanged="@(v => a.ResourceId = v ?? 0)"
                                              InitialName="@(a.Resource?.Name)" />
                    </div>
                    <div>
                        <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.changeFactor1</label>
                        <input type="number" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" @bind="a.ChangeFactor1" />
                    </div>
                    <div>
                        <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.changeFactor2</label>
                        <input type="number" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" @bind="a.ChangeFactor2" />
                    </div>
                    <div>
                        <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">
                            @if (a.Resource?.ResType == ResourceTypesEnum.Materials)
                            {
                                <span>@CalcResource.waste</span>
                            }
                            else
                            {
                                <span>@CalcResource.cap</span>
                            }
                        </label>
                        <input type="number" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" @bind="a.CapWaste" />
                    </div>
                    <div>
                        <label class="md:col-span-2 block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.baseCost</label>
                        <input type="number" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" @bind="a.BaseCost" />
                    </div>
                    <div>
                        <label class="md:col-span-2 block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@AppLoc["menuId"]</label>
                        <input type="number" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" @bind="a.MenuId" />
                    </div>
                    <div>
                        <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">@CalcResource.active</label>
                        <input type="checkbox" class="h-4 w-4 text-blue-600 rounded focus:ring-blue-500 dark:text-blue-400" @bind="a.IsActive" />
                    </div>

                    <div class="md:col-span-2 place-self-end">
                        @if (a.Resource?.ResType == ResourceTypesEnum.MachinesAndEquipments ||
                             a.Resource?.ResType == ResourceTypesEnum.Worker)
                        {
                            <button class="px-2 py-1 border border-blue-600 text-blue-600 rounded transition hover:bg-blue-600 hover:text-white dark:border-blue-400 dark:text-blue-400 dark:hover:bg-blue-400 dark:hover:text-white" @onclick="@(() => AddRole(a))">@($"{AppLoc["add"]} {AppControll.capRole}")</button>
                        }
                        <button class="px-2 py-1 border border-blue-600 text-blue-600 rounded transition hover:bg-blue-600 hover:text-white dark:border-blue-400 dark:text-blue-400 dark:hover:bg-blue-400 dark:hover:text-white" @onclick="@(() => (a.Expressions ??= new()).Add(string.Empty))">+</button>
                        <button class="px-2 py-1 border border-red-600 text-red-600 rounded transition hover:bg-red-600 hover:text-white dark:border-red-400 dark:text-red-400 dark:hover:bg-red-400 dark:hover:text-white" @onclick="() => RemoveAssignment(a)">x</button>
                    </div>
                </div>

                @if (a.Resource?.ResType == ResourceTypesEnum.MachinesAndEquipments ||
                     a.Resource?.ResType == ResourceTypesEnum.Worker)
                {
                    <div class="mt-2 rounded-lg border border-gray-100 bg-white/70 shadow-sm dark:border-gray-800 dark:bg-gray-900/50">
                        <div class="inline-flex gap-2">
                            <div></div>
                            <div>@AppControll.min</div>
                            <div>@AppControll.max</div>
                            <div>@CalcResource.cap</div>
                            <div>#</div>
                        </div>

                        @if (a.CapacityRoles is not null && a.CapacityRoles.Count > 0)
                        {
                            @for (int i = 0; i < a.CapacityRoles.Count; i++)
                            {
                                var index = i;
                                var role = a.CapacityRoles[index];

                                <div class="inline-flex gap-2">
                                    <div class="flex items-center">
                                        <button type="button" title="@AppLoc["remove"]"
                                                class="px-2 py-1 border border-red-600 text-red-600 rounded transition hover:bg-red-600 hover:text-white dark:border-red-400 dark:text-red-400 dark:hover:bg-red-400 dark:hover:text-white h-6 w-6 p-0 flex items-center justify-center"
                                                @onclick="() => a.CapacityRoles.Remove(role)">
                                            x
                                        </button>
                                    </div>

                                    <input type="number" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" @bind="role.Min" />
                                    <input type="number" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" @bind="role.Max" />
                                    <input type="number" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" @bind="role.Value" />

                                    <div class="text-xs text-gray-500 dark:text-gray-400">@(index + 1)</div>
                                </div>
                            }
                        }
                    </div>
                }

                @if (a.Expressions is not null && a.Expressions.Count > 0)
                {
                    <div class="mt-2 font-medium text-gray-800 dark:text-gray-100">@CalcResource.Formulas</div>
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-2 mb-2">
                        @for (int i = 0; i < a.Expressions.Count; i++)
                        {
                            var index = i;
                            <div class="flex items-center gap-1">
                                <button class="px-2 py-1 border border-red-600 text-red-600 rounded transition hover:bg-red-600 hover:text-white dark:border-red-400 dark:text-red-400 dark:hover:bg-red-400 dark:hover:text-white" @onclick="() => a.Expressions.RemoveAt(index)">x</button>
                                <input type="text" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" @bind="a.Expressions[index]" />
                            </div>
                        }
                    </div>
                }

                <div class="mt-2 rounded border border-gray-200 bg-white/60 p-1 dark:border-gray-700 dark:bg-gray-900/40">
                    <div class="flex items-center gap-1 font-semibold text-sm">
                        <div class="text-gray-800 dark:text-gray-100">@AppLoc["bindingsEquations"]</div>
                        @if (CanAddBindingsFor(a))
                        {
                            <div class="flex flex-wrap gap-2">
                                <button class="px-2 py-1 border border-blue-600 text-blue-600 rounded transition hover:bg-blue-600 hover:text-white dark:border-blue-400 dark:text-blue-400 dark:hover:bg-blue-400 dark:hover:text-white" @onclick="() => AddOptionBindingUI(a.Id)">@AppLoc["addChoiceBinding"]</button>
                                <button class="px-2 py-1 border border-blue-600 text-blue-600 rounded transition hover:bg-blue-600 hover:text-white dark:border-blue-400 dark:text-blue-400 dark:hover:bg-blue-400 dark:hover:text-white" @onclick="() => AddNumericBindingUI(a.Id)">@AppLoc["addNumericBinding"]</button>
                            </div>
                        }
                        else
                        {
                            <div class="text-[12px] text-yellow-600 dark:text-yellow-400">@AppLoc["saveConditionFirstToEnableBindings"]</div>
                        }
                    </div>

                    @if (OptBindsByRA.TryGetValue(a.Id, out var obList) && obList.Count > 0)
                    {
                        <div class="mt-1">
                            @foreach (var b in obList)
                            {
                                <section class="mb-1 rounded-lg border border-gray-100 bg-white/70 p-3 shadow-sm dark:border-gray-800 dark:bg-gray-900/50">
                                    <div class="flex items-center gap-1 justify-between">
                                        <div class="inline-flex gap-2">
                                            <select class="w-full border border-gray-300 rounded px-2 py-1 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:text-white dark:border-gray-600"
                                                    value="@b.ChoiceGroupId"
                                                    aria-label="@AppLoc["choiceGroup"]"
                                                    @onchange="e => OnOptionGroupChanged(b, e)">
                                                <option value="0">@AppLoc["selectPlaceholder"]</option>
                                                @foreach (var g in TaskChoiceGroups)
                                                {
                                                    <option value="@g.Id">@g.DisplayName</option>
                                                }
                                            </select>

                                            <select class="w-full border border-gray-300 rounded px-2 py-1 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:text-white dark:border-gray-600" @bind="b.ChoiceOptionId" aria-label="@AppLoc["choiceOption"]">
                                                <option value="0">@AppLoc["selectPlaceholder"]</option>
                                                @foreach (var o in TaskChoiceGroups.FirstOrDefault(x => x.Id == b.ChoiceGroupId)?.Options ?? Enumerable.Empty<QuestionOptionDefinition>())
                                                {
                                                    <option value="@o.Id">@o.DisplayName</option>
                                                }
                                            </select>
                                        </div>
                                        <div>
                                            <button class="px-2 py-1 border border-blue-600 text-blue-600 rounded transition hover:bg-blue-600 hover:text-white dark:border-blue-400 dark:text-blue-400 dark:hover:bg-blue-400 dark:hover:text-white" title="@AppLoc["saveBinding"]" @onclick="async () => await OnSaveOption(a.Id, b)">@AppLoc["save"]</button>
                                            <button class="px-2 py-1 border border-green-600 text-green-600 rounded transition hover:bg-green-600 hover:text-white dark:border-green-400 dark:text-green-400 dark:hover:bg-green-400 dark:hover:text-white" title="@AppLoc["addEquation"]" @onclick="() => AddOptionEq(b)">@AppLoc["addEquation"]</button>
                                            <button class="px-2 py-1 border border-red-600 text-red-600 rounded transition hover:bg-red-600 hover:text-white dark:border-red-400 dark:text-red-400 dark:hover:bg-red-400 dark:hover:text-white" title="@AppLoc["deleteBinding"]" @onclick="async () => await RemoveOptionBindingUIAsync(a.Id, b)">@ResourceApp.delete</button>
                                        </div>
                                    </div>

                                    @if (b.LastError is not null)
                                    {
                                        <div class="mt-1 text-xs text-rose-600">⚠ @b.LastError</div>
                                    }
                                    @if (b.SavedOk)
                                    {
                                        <div class="text-green-600 dark:text-green-400">✓ @AppLoc["saved"]</div>
                                    }

                                    @if (b.Formulas.Count == 0)
                                    {
                                        <div>@AppLoc["noFormulas"]</div>
                                    }
                                    else
                                    {
                                        <div class="grid grid-cols-1 md:grid-cols-3 gap-2">
                                            @for (int i = 0; i < b.Formulas.Count; i++)
                                            {
                                                var idx = i;
                                                <div class="flex items-center gap-1">
                                                    <input class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" placeholder="@AppLoc["equationExpressionPlaceholder"]" aria-label="@AppLoc["equation"]" @bind="b.Formulas[idx]" />
                                                    <button class="px-2 py-1 border border-gray-500 text-gray-500 rounded transition hover:bg-gray-500 hover:text-white dark:border-gray-400 dark:text-gray-400 dark:hover:bg-gray-400 dark:hover:text-white p-2"
                                                            title="@AppLoc["removeEquation"]"
                                                            @onclick="() => RemoveOptionEq(b, idx)">✕</button>
                                                </div>
                                            }
                                        </div>
                                    }
                                </section>
                            }
                        </div>
                    }

                    @if (NumBindsByRA.TryGetValue(a.Id, out var nbList) && nbList.Count > 0)
                    {
                        <div class="mt-4">
                            <div class="mb-2 flex items-center gap-1 font-semibold text-sm">
                                <div class="text-[12px] uppercase text-gray-600 dark:text-gray-300">@AppLoc["numericBindings"]</div>
                                <span class="inline-flex items-center rounded bg-gray-100 px-2 py-0.5 text-[11px] font-medium text-black dark:bg-gray-700 dark:text-white">@nbList.Count</span>
                            </div>

                            @foreach (var b in nbList)
                            {
                                <section class="mb-3 rounded-lg border border-gray-100 bg-white/70 p-3 shadow-sm dark:border-gray-800 dark:bg-gray-900/50">
                                    <div class="flex items-center gap-1 justify-between">
                                        <div class="inline-flex gap-2">
                                            <div>
                                                <select class="w-full border border-gray-300 rounded px-2 py-1 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:text-white dark:border-gray-600" @bind="b.NumericId" aria-label="@AppLoc["numericGroup"]">
                                                    <option value="0">@AppLoc["selectPlaceholder"]</option>
                                                    @foreach (var ng in TaskNumericGroups)
                                                    {
                                                        <option value="@ng.Id">@ng.DisplayName</option>
                                                    }
                                                </select>
                                            </div>
                                            <div>
                                                <input type="number" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" @bind="b.InputMinValue" placeholder="@AppControll.min" />
                                            </div>
                                            <div>
                                                <input type="number" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" @bind="b.InputMaxValue" placeholder="@AppControll.max" />
                                            </div>
                                        </div>
                                        <div>
                                            <button class="px-2 py-1 border border-blue-600 text-blue-600 rounded transition hover:bg-blue-600 hover:text-white dark:border-blue-400 dark:text-blue-400 dark:hover:bg-blue-400 dark:hover:text-white" title="@AppLoc["saveNumericBinding"]" @onclick="async () => await OnSaveNumeric(a.Id, b)">@AppLoc["save"]</button>
                                            <button class="px-2 py-1 border border-green-600 text-green-600 rounded transition hover:bg-green-600 hover:text-white dark:border-green-400 dark:text-green-400 dark:hover:bg-green-400 dark:hover:text-white" title="@AppLoc["addEquation"]" @onclick="() => AddNumericEq(b)">@AppLoc["addEquation"]</button>
                                            <button class="px-2 py-1 border border-red-600 text-red-600 rounded transition hover:bg-red-600 hover:text-white dark:border-red-400 dark:text-red-400 dark:hover:bg-red-400 dark:hover:text-white" title="@AppLoc["deleteNumericBinding"]" @onclick="async () => await RemoveNumericBindingUIAsync(a.Id, b)">@ResourceApp.delete</button>
                                        </div>
                                    </div>

                                    @if (b.Formulas.Count == 0)
                                    {
                                        <div>@AppLoc["none"]</div>
                                    }
                                    else
                                    {
                                        <div class="grid grid-cols-1 md:grid-cols-3 gap-2">
                                            @for (int i = 0; i < b.Formulas.Count; i++)
                                            {
                                                var idx = i;
                                                <div class="inline-flex gap-2">
                                                    <input class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" placeholder="@AppLoc["equationExpressionPlaceholder"]" aria-label="@AppLoc["equation"]" @bind="b.Formulas[idx]" />
                                                    <button class="px-2 py-1 border border-gray-500 text-gray-500 rounded transition hover:bg-gray-500 hover:text-white dark:border-gray-400 dark:text-gray-400 dark:hover:bg-gray-400 dark:hover:text-white p-2"
                                                            title="@AppLoc["removeEquation"]"
                                                            @onclick="() => RemoveNumericEq(b, idx)">✕</button>
                                                </div>
                                            }
                                        </div>
                                    }

                                    @if (b.LastError is not null)
                                    {
                                        <div class="mt-1 text-xs text-rose-600">⚠ @b.LastError</div>
                                    }
                                    @if (b.SavedOk)
                                    {
                                        <div class="text-green-600 dark:text-green-400">✓ @AppLoc["saved"]</div>
                                    }
                                </section>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>
