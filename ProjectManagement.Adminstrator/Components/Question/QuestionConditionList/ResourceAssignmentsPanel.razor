@using System
@using System.Collections.Generic
@using System.Linq
@using Microsoft.AspNetCore.Components
@using ProjectManagement.Adminstrator.Components
@using TaskResourceBlueprints.Entities
@using TaskResourceBlueprints.Entities.Questions.Assignments
@using TaskResourceBlueprints.Entities.Questions.Conditions
@using TaskResourceBlueprints.Entities.Questions.Groups
@using TaskResourceBlueprints.Services.QuestionConditions
@using ProjectManagement.Adminstrator.Components.Question.QuestionConditionList.Shared
@using ProjectManagement.Shared.Base.AppTenant
@using ProjectManagement.Shared.Base.Calculation
@using ProjectManagement.Shared.Enums
@inherits AppComponentBase

@code {
    [Parameter] public ConditionDefinition Condition { get; set; } = null!;

    [Parameter] public List<QuestionGroupDefinition> TaskChoiceGroups { get; set; } = new();
    [Parameter] public List<NumericQuestionDefinition> TaskNumericGroups { get; set; } = new();

    [Parameter] public Dictionary<int, List<OptionBindVM>> OptBindsByRA { get; set; } = new();
    [Parameter] public Dictionary<int, List<NumericBindVM>> NumBindsByRA { get; set; } = new();
    [Parameter] public Func<int, OptionBindVM, Task> OnSaveOption { get; set; } = (_, _) => Task.CompletedTask;
    [Parameter] public Func<int, NumericBindVM, Task> OnSaveNumeric { get; set; } = (_, _) => Task.CompletedTask;
    [Parameter] public Func<int, OptionBindVM, Task> OnDeleteOption { get; set; } = (_, _) => Task.CompletedTask;
    [Parameter] public Func<int, NumericBindVM, Task> OnDeleteNumeric { get; set; } = (_, _) => Task.CompletedTask;

    private bool CanAddBindingsFor(ConditionResourceAssignment a) => a.Id > 0;

    private void RemoveAssignment(ConditionResourceAssignment a)
    {
        Condition.Assignments.Remove(a);
        OptBindsByRA.Remove(a.Id);
        NumBindsByRA.Remove(a.Id);
    }

    private void ToggleAssignment(ResourceDefinition resource)
    {
        if (resource is null) return;

        var existing = Condition.Assignments.FirstOrDefault(x => x.ResourceId == resource.Id);
        if (existing is not null)
        {
            RemoveAssignment(existing);
            StateHasChanged();
            return;
        }

        var metadata = resource.Data;
        Condition.Assignments.Add(new ConditionResourceAssignment
        {
            ResourceId = resource.Id,
            ChangeFactor1 = metadata?.ChangeFactor1 ?? 0,
            ChangeFactor2 = metadata?.ChangeFactor2 ?? 0,
            CapWaste = metadata?.CapWaste ?? 0,
            BaseCost = metadata?.BaseCost ?? 0,
            IsActive = resource.IsActive,
            Resource = new ResourceDefinition
            {
                Id = resource.Id,
                Name = resource.Name,
                ResType = resource.ResType,
                Data = new ResourceMetadata
                {
                    Cost = metadata?.Cost ?? 0,
                    ChangeFactor1 = metadata?.ChangeFactor1 ?? 0,
                    ChangeFactor2 = metadata?.ChangeFactor2 ?? 0,
                    CapWaste = metadata?.CapWaste ?? 0,
                    BaseCost = metadata?.BaseCost ?? 0,
                    Unit = metadata?.Unit ?? string.Empty
                }
            },
            CapacityRoles = []
        });

        StateHasChanged();
    }

    private void AddOptionBindingUI(int raId)
    {
        if (!OptBindsByRA.TryGetValue(raId, out var list))
            OptBindsByRA[raId] = list = new();

        var firstGroup = TaskChoiceGroups.FirstOrDefault();
        var firstOpt = firstGroup?.Options.FirstOrDefault();
        list.Add(new OptionBindVM
        {
            Id = 0,
            ChoiceGroupId = firstGroup?.Id ?? 0,
            ChoiceOptionId = firstOpt?.Id ?? 0,
            Formulas = new()
        });
        StateHasChanged();
    }

    private async Task RemoveOptionBindingUIAsync(int raId, OptionBindVM vm)
    {
        if (vm.Id > 0)
            await OnDeleteOption(raId, vm);

        if (OptBindsByRA.TryGetValue(raId, out var list))
            list.Remove(vm);
    }

    private void OnOptionGroupChanged(OptionBindVM vm, ChangeEventArgs e)
    {
        if (int.TryParse(Convert.ToString(e.Value), out var gid))
        {
            vm.ChoiceGroupId = gid;
            vm.ChoiceOptionId = 0;
        }
    }

    private void AddOptionEq(OptionBindVM vm) => vm.Formulas.Add(string.Empty);

    private void RemoveOptionEq(OptionBindVM vm, int idx)
    {
        if (idx >= 0 && idx < vm.Formulas.Count)
            vm.Formulas.RemoveAt(idx);
    }

    private void AddNumericBindingUI(int raId)
    {
        if (!NumBindsByRA.TryGetValue(raId, out var list))
            NumBindsByRA[raId] = list = new();

        var firstNg = TaskNumericGroups.FirstOrDefault();
        list.Add(new NumericBindVM
        {
            Id = 0,
            NumericId = firstNg?.Id ?? 0,
            Formulas = new()
        });
        StateHasChanged();
    }

    private async Task RemoveNumericBindingUIAsync(int raId, NumericBindVM vm)
    {
        if (vm.Id > 0)
            await OnDeleteNumeric(raId, vm);

        if (NumBindsByRA.TryGetValue(raId, out var list))
            list.Remove(vm);
    }

    private void AddNumericEq(NumericBindVM vm) => vm.Formulas.Add(string.Empty);

    private void RemoveNumericEq(NumericBindVM vm, int idx)
    {
        if (idx >= 0 && idx < vm.Formulas.Count)
            vm.Formulas.RemoveAt(idx);
    }

    private void AddRole(ConditionResourceAssignment a)
    {
        a.CapacityRoles ??= new();
        if (a.CapacityRoles.Count != 0)
        {
            a.CapacityRoles.Add(new RoleDTO
            {
                Min = a.CapacityRoles.Last().Max,
                Max = a.CapacityRoles.Last().Max + 10,
                Value = a.CapacityRoles.Last().Value + 1
            });
        }
        else
        {
            a.CapacityRoles.Add(new RoleDTO
            {
                Min = 0,
                Max = 10,
                Value = 5
            });
        }

        StateHasChanged();
    }
}

<section class="pm-card-muted overflow-hidden">
    <div class="pm-card-header">
        <div>
            <h4 class="pm-title">@AppLoc["resourceAssignments"]</h4>
            <p class="pm-subtitle mt-1">Attach resources, formulas, and conditional bindings to the active condition.</p>
        </div>
        <div class="pm-toolbar">
            <span class="pm-chip">@Condition.Assignments.Count</span>
        </div>
    </div>

    <div class="pm-card-body space-y-4">
        <div class="pm-subcard">
            <FolderResourcesAddUI TaskId="Condition.TaskId"
                                  ResIds="Condition.Assignments.Select(x => x.ResourceId).ToList()"
                                  OnSave="ToggleAssignment" />
        </div>

        @if (Condition.Assignments.Count == 0)
        {
            <div class="pm-empty">@AppLoc["none"]</div>
        }
        else
        {
            <div class="space-y-4">
                @foreach (var a in Condition.Assignments)
                {
                    <section class="pm-card overflow-hidden">
                        <div class="pm-card-header">
                            <div>
                                <h5 class="pm-title">@(a.Resource?.Name ?? $"{AppLoc["resource"]} #{a.ResourceId}")</h5>
                                <p class="pm-subtitle mt-1">@(a.Resource?.ResType?.ToString() ?? "Resource")</p>
                            </div>

                            <div class="pm-toolbar">
                                <span class="@(a.IsActive ? "pm-status-on" : "pm-status-off")">@(a.IsActive ? "ON" : "OFF")</span>
                                <button class="pm-btn-outline-danger" @onclick="() => RemoveAssignment(a)">@AppLoc["remove"]</button>
                            </div>
                        </div>

                        <div class="pm-card-body space-y-4">
                            <div class="grid grid-cols-1 gap-3 md:grid-cols-12">
                                <div class="pm-field md:col-span-3">
                                    <label class="pm-label">@AppLoc["resource"]</label>
                                    <ResourceAutocomplete MinChars="2" PageSize="20"
                                                          Value="a.ResourceId"
                                                          ValueChanged="@(v => a.ResourceId = v ?? 0)"
                                                          InitialName="@(a.Resource?.Name)" />
                                </div>
                                <div class="pm-field">
                                    <label class="pm-label">@CalcResource.changeFactor1</label>
                                    <input type="number" class="pm-input" @bind="a.ChangeFactor1" />
                                </div>
                                <div class="pm-field">
                                    <label class="pm-label">@CalcResource.changeFactor2</label>
                                    <input type="number" class="pm-input" @bind="a.ChangeFactor2" />
                                </div>
                                <div class="pm-field">
                                    <label class="pm-label">
                                        @if (a.Resource?.ResType == ResourceTypesEnum.Materials)
                                        {
                                            <span>@CalcResource.waste</span>
                                        }
                                        else
                                        {
                                            <span>@CalcResource.cap</span>
                                        }
                                    </label>
                                    <input type="number" class="pm-input" @bind="a.CapWaste" />
                                </div>
                                <div class="pm-field">
                                    <label class="pm-label">@CalcResource.baseCost</label>
                                    <input type="number" class="pm-input" @bind="a.BaseCost" />
                                </div>
                                <div class="pm-field">
                                    <label class="pm-label">@AppLoc["menuId"]</label>
                                    <input type="number" class="pm-input" @bind="a.MenuId" />
                                </div>
                                <div class="pm-field md:col-span-2">
                                    <label class="pm-label">@CalcResource.active</label>
                                    <div class="flex h-[42px] items-center rounded-xl border border-slate-300 bg-white px-3 dark:border-slate-700 dark:bg-slate-900">
                                        <input type="checkbox" class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 dark:border-slate-600 dark:bg-slate-800" @bind="a.IsActive" />
                                    </div>
                                </div>
                            </div>

                            <div class="pm-toolbar">
                                @if (a.Resource?.ResType == ResourceTypesEnum.MachinesAndEquipments ||
                                     a.Resource?.ResType == ResourceTypesEnum.Worker)
                                {
                                    <button class="pm-btn-outline" @onclick="@(() => AddRole(a))">@($"{AppLoc["add"]} {AppControll.capRole}")</button>
                                }
                                <button class="pm-btn-outline" @onclick="@(() => (a.Expressions ??= new()).Add(string.Empty))">@AppLoc["addEquation"]</button>
                            </div>

                            @if (a.Resource?.ResType == ResourceTypesEnum.MachinesAndEquipments ||
                                 a.Resource?.ResType == ResourceTypesEnum.Worker)
                            {
                                <div class="pm-subcard space-y-3">
                                    <div class="flex items-center justify-between gap-2">
                                        <div>
                                            <div class="pm-title">@AppControll.capRole</div>
                                            <div class="pm-subtitle mt-1">Capacity breakpoints for workers and equipment.</div>
                                        </div>
                                        <span class="pm-chip">@(a.CapacityRoles?.Count ?? 0)</span>
                                    </div>

                                    @if (a.CapacityRoles is not null && a.CapacityRoles.Count > 0)
                                    {
                                        <div class="space-y-2">
                                            @for (int i = 0; i < a.CapacityRoles.Count; i++)
                                            {
                                                var index = i;
                                                var role = a.CapacityRoles[index];

                                                <div class="grid grid-cols-1 gap-2 rounded-xl border border-slate-200 bg-slate-50 p-3 md:grid-cols-[auto_repeat(3,minmax(0,1fr))_40px] dark:border-slate-700 dark:bg-slate-800/60">
                                                    <button type="button"
                                                            title="@AppLoc["remove"]"
                                                            class="pm-btn-outline-danger md:w-12"
                                                            @onclick="() => a.CapacityRoles.Remove(role)">
                                                        ✕
                                                    </button>

                                                    <div class="pm-field">
                                                        <label class="pm-label">@AppControll.min</label>
                                                        <input type="number" class="pm-input" @bind="role.Min" />
                                                    </div>

                                                    <div class="pm-field">
                                                        <label class="pm-label">@AppControll.max</label>
                                                        <input type="number" class="pm-input" @bind="role.Max" />
                                                    </div>

                                                    <div class="pm-field">
                                                        <label class="pm-label">@CalcResource.cap</label>
                                                        <input type="number" class="pm-input" @bind="role.Value" />
                                                    </div>

                                                    <div class="flex items-end justify-center pb-2 text-xs font-medium text-slate-500 dark:text-slate-400">#@(index + 1)</div>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="pm-empty">@AppLoc["none"]</div>
                                    }
                                </div>
                            }

                            @if (a.Expressions is not null && a.Expressions.Count > 0)
                            {
                                <div class="pm-subcard space-y-3">
                                    <div class="flex items-center justify-between gap-2">
                                        <div>
                                            <div class="pm-title">@CalcResource.Formulas</div>
                                            <div class="pm-subtitle mt-1">Expressions applied directly to this resource assignment.</div>
                                        </div>
                                        <span class="pm-chip">@a.Expressions.Count</span>
                                    </div>

                                    <div class="grid grid-cols-1 gap-2 md:grid-cols-2 xl:grid-cols-3">
                                        @for (int i = 0; i < a.Expressions.Count; i++)
                                        {
                                            var index = i;
                                            <div class="flex items-center gap-2">
                                                <button class="pm-btn-outline-danger" @onclick="() => a.Expressions.RemoveAt(index)">✕</button>
                                                <input type="text" class="pm-input" @bind="a.Expressions[index]" />
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <div class="pm-subcard space-y-4">
                                <div class="flex flex-wrap items-center justify-between gap-3">
                                    <div>
                                        <div class="pm-title">@AppLoc["bindingsEquations"]</div>
                                        <div class="pm-subtitle mt-1">Save the condition once to enable persisted bindings for this resource assignment.</div>
                                    </div>

                                    @if (CanAddBindingsFor(a))
                                    {
                                        <div class="pm-toolbar">
                                            <button class="pm-btn-outline" @onclick="() => AddOptionBindingUI(a.Id)">@AppLoc["addChoiceBinding"]</button>
                                            <button class="pm-btn-outline" @onclick="() => AddNumericBindingUI(a.Id)">@AppLoc["addNumericBinding"]</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="pm-chip-amber">@AppLoc["saveConditionFirstToEnableBindings"]</span>
                                    }
                                </div>

                                @if (OptBindsByRA.TryGetValue(a.Id, out var obList) && obList.Count > 0)
                                {
                                    <div class="space-y-3">
                                        @foreach (var b in obList)
                                        {
                                            <section class="pm-subcard space-y-3">
                                                <div class="flex flex-wrap items-start justify-between gap-3">
                                                    <div class="grid min-w-0 flex-1 grid-cols-1 gap-3 md:grid-cols-2">
                                                        <div class="pm-field">
                                                            <label class="pm-label">@AppLoc["choiceGroup"]</label>
                                                            <select class="pm-select"
                                                                    value="@b.ChoiceGroupId"
                                                                    aria-label="@AppLoc["choiceGroup"]"
                                                                    @onchange="e => OnOptionGroupChanged(b, e)">
                                                                <option value="0">@AppLoc["selectPlaceholder"]</option>
                                                                @foreach (var g in TaskChoiceGroups)
                                                                {
                                                                    <option value="@g.Id">@g.DisplayName</option>
                                                                }
                                                            </select>
                                                        </div>

                                                        <div class="pm-field">
                                                            <label class="pm-label">@AppLoc["choiceOption"]</label>
                                                            <select class="pm-select" @bind="b.ChoiceOptionId" aria-label="@AppLoc["choiceOption"]">
                                                                <option value="0">@AppLoc["selectPlaceholder"]</option>
                                                                @foreach (var o in TaskChoiceGroups.FirstOrDefault(x => x.Id == b.ChoiceGroupId)?.Options ?? Enumerable.Empty<QuestionOptionDefinition>())
                                                                {
                                                                    <option value="@o.Id">@o.DisplayName</option>
                                                                }
                                                            </select>
                                                        </div>
                                                    </div>

                                                    <div class="pm-toolbar">
                                                        <button class="pm-btn-success" title="@AppLoc["saveBinding"]" @onclick="async () => await OnSaveOption(a.Id, b)">@AppLoc["save"]</button>
                                                        <button class="pm-btn-outline" title="@AppLoc["addEquation"]" @onclick="() => AddOptionEq(b)">@AppLoc["addEquation"]</button>
                                                        <button class="pm-btn-outline-danger" title="@AppLoc["deleteBinding"]" @onclick="async () => await RemoveOptionBindingUIAsync(a.Id, b)">@ResourceApp.delete</button>
                                                    </div>
                                                </div>

                                                @if (b.LastError is not null)
                                                {
                                                    <div class="pm-alert-error">⚠ @b.LastError</div>
                                                }
                                                @if (b.SavedOk)
                                                {
                                                    <div class="pm-chip-blue">✓ @AppLoc["saved"]</div>
                                                }

                                                @if (b.Formulas.Count == 0)
                                                {
                                                    <div class="pm-empty">@AppLoc["noFormulas"]</div>
                                                }
                                                else
                                                {
                                                    <div class="grid grid-cols-1 gap-2 md:grid-cols-2 xl:grid-cols-3">
                                                        @for (int i = 0; i < b.Formulas.Count; i++)
                                                        {
                                                            var idx = i;
                                                            <div class="flex items-center gap-2">
                                                                <input class="pm-input" placeholder="@AppLoc["equationExpressionPlaceholder"]" aria-label="@AppLoc["equation"]" @bind="b.Formulas[idx]" />
                                                                <button class="pm-btn-outline-danger" title="@AppLoc["removeEquation"]" @onclick="() => RemoveOptionEq(b, idx)">✕</button>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </section>
                                        }
                                    </div>
                                }

                                @if (NumBindsByRA.TryGetValue(a.Id, out var nbList) && nbList.Count > 0)
                                {
                                    <div class="space-y-3 pt-2">
                                        <div class="flex items-center gap-2">
                                            <div class="pm-title">@AppLoc["numericBindings"]</div>
                                            <span class="pm-chip">@nbList.Count</span>
                                        </div>

                                        @foreach (var b in nbList)
                                        {
                                            <section class="pm-subcard space-y-3">
                                                <div class="flex flex-wrap items-start justify-between gap-3">
                                                    <div class="grid min-w-0 flex-1 grid-cols-1 gap-3 md:grid-cols-3">
                                                        <div class="pm-field">
                                                            <label class="pm-label">@AppLoc["numericGroup"]</label>
                                                            <select class="pm-select" @bind="b.NumericId" aria-label="@AppLoc["numericGroup"]">
                                                                <option value="0">@AppLoc["selectPlaceholder"]</option>
                                                                @foreach (var ng in TaskNumericGroups)
                                                                {
                                                                    <option value="@ng.Id">@ng.DisplayName</option>
                                                                }
                                                            </select>
                                                        </div>
                                                        <div class="pm-field">
                                                            <label class="pm-label">@AppControll.min</label>
                                                            <input type="number" class="pm-input" @bind="b.InputMinValue" placeholder="@AppControll.min" />
                                                        </div>
                                                        <div class="pm-field">
                                                            <label class="pm-label">@AppControll.max</label>
                                                            <input type="number" class="pm-input" @bind="b.InputMaxValue" placeholder="@AppControll.max" />
                                                        </div>
                                                    </div>

                                                    <div class="pm-toolbar">
                                                        <button class="pm-btn-success" title="@AppLoc["saveNumericBinding"]" @onclick="async () => await OnSaveNumeric(a.Id, b)">@AppLoc["save"]</button>
                                                        <button class="pm-btn-outline" title="@AppLoc["addEquation"]" @onclick="() => AddNumericEq(b)">@AppLoc["addEquation"]</button>
                                                        <button class="pm-btn-outline-danger" title="@AppLoc["deleteNumericBinding"]" @onclick="async () => await RemoveNumericBindingUIAsync(a.Id, b)">@ResourceApp.delete</button>
                                                    </div>
                                                </div>

                                                @if (b.Formulas.Count == 0)
                                                {
                                                    <div class="pm-empty">@AppLoc["none"]</div>
                                                }
                                                else
                                                {
                                                    <div class="grid grid-cols-1 gap-2 md:grid-cols-2 xl:grid-cols-3">
                                                        @for (int i = 0; i < b.Formulas.Count; i++)
                                                        {
                                                            var idx = i;
                                                            <div class="flex items-center gap-2">
                                                                <input class="pm-input" placeholder="@AppLoc["equationExpressionPlaceholder"]" aria-label="@AppLoc["equation"]" @bind="b.Formulas[idx]" />
                                                                <button class="pm-btn-outline-danger" title="@AppLoc["removeEquation"]" @onclick="() => RemoveNumericEq(b, idx)">✕</button>
                                                            </div>
                                                        }
                                                    </div>
                                                }

                                                @if (b.LastError is not null)
                                                {
                                                    <div class="pm-alert-error">⚠ @b.LastError</div>
                                                }
                                                @if (b.SavedOk)
                                                {
                                                    <div class="pm-chip-blue">✓ @AppLoc["saved"]</div>
                                                }
                                            </section>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </section>
                }
            </div>
        }
    </div>
</section>
