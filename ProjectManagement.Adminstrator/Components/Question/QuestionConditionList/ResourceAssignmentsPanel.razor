@using System
@using System.Collections.Generic
@using System.Linq
@using Microsoft.AspNetCore.Components
@using ProjectManagement.Adminstrator.Components
@using TaskResourceBlueprints.Entities
@using TaskResourceBlueprints.Entities.Questions.Assignments
@using TaskResourceBlueprints.Entities.Questions.Conditions
@using TaskResourceBlueprints.Entities.Questions.Groups
@using TaskResourceBlueprints.Services.QuestionConditions
@using ProjectManagement.Adminstrator.Components.Question.QuestionConditionList.Shared
@using ProjectManagement.Shared.Base.AppTenant
@using ProjectManagement.Shared.Base.Calculation
@using ProjectManagement.Shared.Enums
@inherits AppComponentBase

@code {
    [Parameter] public ConditionDefinition Condition { get; set; } = null!;

    [Parameter] public List<QuestionGroupDefinition> TaskChoiceGroups { get; set; } = new();
    [Parameter] public List<NumericQuestionDefinition> TaskNumericGroups { get; set; } = new();

    [Parameter] public Dictionary<int, List<OptionBindVM>> OptBindsByRA { get; set; } = new();
    [Parameter] public Dictionary<int, List<NumericBindVM>> NumBindsByRA { get; set; } = new();
    [Parameter] public Func<int, OptionBindVM, Task> OnSaveOption { get; set; } = (_, _) => Task.CompletedTask;
    [Parameter] public Func<int, NumericBindVM, Task> OnSaveNumeric { get; set; } = (_, _) => Task.CompletedTask;
    [Parameter] public Func<int, OptionBindVM, Task> OnDeleteOption { get; set; } = (_, _) => Task.CompletedTask;
    [Parameter] public Func<int, NumericBindVM, Task> OnDeleteNumeric { get; set; } = (_, _) => Task.CompletedTask;

    private bool CanAddBindingsFor(ConditionResourceAssignment a) => a.Id > 0;

    private void RemoveAssignment(ConditionResourceAssignment a)
    {
        Condition.Assignments.Remove(a);
        OptBindsByRA.Remove(a.Id);
        NumBindsByRA.Remove(a.Id);
    }

    private void ToggleAssignment(ResourceDefinition resource)
    {
        if (resource is null) return;

        var existing = Condition.Assignments.FirstOrDefault(x => x.ResourceId == resource.Id);
        if (existing is not null)
        {
            RemoveAssignment(existing);
            StateHasChanged();
            return;
        }

        var metadata = resource.Data;
        Condition.Assignments.Add(new ConditionResourceAssignment
        {
            ResourceId = resource.Id,
            ChangeFactor1 = metadata?.ChangeFactor1 ?? 0,
            ChangeFactor2 = metadata?.ChangeFactor2 ?? 0,
            CapWaste = metadata?.CapWaste ?? 0,
            BaseCost = metadata?.BaseCost ?? 0,
            IsActive = resource.IsActive,
            Resource = new ResourceDefinition
            {
                Id = resource.Id,
                Name = resource.Name,
                ResType = resource.ResType,
                Data = new ResourceMetadata
                {
                    Cost = metadata?.Cost ?? 0,
                    ChangeFactor1 = metadata?.ChangeFactor1 ?? 0,
                    ChangeFactor2 = metadata?.ChangeFactor2 ?? 0,
                    CapWaste = metadata?.CapWaste ?? 0,
                    BaseCost = metadata?.BaseCost ?? 0,
                    Unit = metadata?.Unit ?? string.Empty
                }
            },
            CapacityRoles = []
        });

        StateHasChanged();
    }

    private void AddOptionBindingUI(int raId)
    {
        if (!OptBindsByRA.TryGetValue(raId, out var list))
            OptBindsByRA[raId] = list = new();

        var firstGroup = TaskChoiceGroups.FirstOrDefault();
        var firstOpt = firstGroup?.Options.FirstOrDefault();
        list.Add(new OptionBindVM
        {
            Id = 0,
            ChoiceGroupId = firstGroup?.Id ?? 0,
            ChoiceOptionId = firstOpt?.Id ?? 0,
            Formulas = new()
        });
        StateHasChanged();
    }

    private async Task RemoveOptionBindingUIAsync(int raId, OptionBindVM vm)
    {
        if (vm.Id > 0)
            await OnDeleteOption(raId, vm);

        if (OptBindsByRA.TryGetValue(raId, out var list))
            list.Remove(vm);
    }

    private void OnOptionGroupChanged(OptionBindVM vm, ChangeEventArgs e)
    {
        if (int.TryParse(Convert.ToString(e.Value), out var gid))
        {
            vm.ChoiceGroupId = gid;
            vm.ChoiceOptionId = 0;
        }
    }

    private void AddOptionEq(OptionBindVM vm) => vm.Formulas.Add(string.Empty);

    private void RemoveOptionEq(OptionBindVM vm, int idx)
    {
        if (idx >= 0 && idx < vm.Formulas.Count)
            vm.Formulas.RemoveAt(idx);
    }

    private void AddNumericBindingUI(int raId)
    {
        if (!NumBindsByRA.TryGetValue(raId, out var list))
            NumBindsByRA[raId] = list = new();

        var firstNg = TaskNumericGroups.FirstOrDefault();
        list.Add(new NumericBindVM
        {
            Id = 0,
            NumericId = firstNg?.Id ?? 0,
            Formulas = new()
        });
        StateHasChanged();
    }

    private async Task RemoveNumericBindingUIAsync(int raId, NumericBindVM vm)
    {
        if (vm.Id > 0)
            await OnDeleteNumeric(raId, vm);

        if (NumBindsByRA.TryGetValue(raId, out var list))
            list.Remove(vm);
    }

    private void AddNumericEq(NumericBindVM vm) => vm.Formulas.Add(string.Empty);

    private void RemoveNumericEq(NumericBindVM vm, int idx)
    {
        if (idx >= 0 && idx < vm.Formulas.Count)
            vm.Formulas.RemoveAt(idx);
    }

    private void AddRole(ConditionResourceAssignment a)
    {
        a.CapacityRoles ??= new();
        if (a.CapacityRoles.Count != 0)
        {
            a.CapacityRoles.Add(new RoleDTO
            {
                Min = a.CapacityRoles.Last().Max,
                Max = a.CapacityRoles.Last().Max + 10,
                Value = a.CapacityRoles.Last().Value + 1
            });
        }
        else
        {
            a.CapacityRoles.Add(new RoleDTO
            {
                Min = 0,
                Max = 10,
                Value = 5
            });
        }

        StateHasChanged();
    }
}

<section class="rounded-xl border border-slate-200 bg-slate-50/70 dark:border-slate-800 dark:bg-slate-900/50 overflow-hidden">
    <div class="border-b border-slate-200 px-2.5 py-2 dark:border-slate-800">
        <div>
            <h4 class="text-sm font-semibold tracking-tight text-slate-900 dark:text-slate-100">@AppLoc["resourceAssignments"]</h4>
        </div>
        <div class="flex flex-wrap items-center gap-1.5">
            <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-2 py-0.5 text-[10px] font-semibold text-slate-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200">@Condition.Assignments.Count</span>
        </div>
    </div>

    <div class="px-2.5 py-2 space-y-2">
        <div class="rounded-xl border border-slate-200 bg-slate-50/80 p-2.5 dark:border-slate-800 dark:bg-slate-900/60">
            <FolderResourcesAddUI TaskId="Condition.TaskId"
                                  ResIds="Condition.Assignments.Select(x => x.ResourceId).ToList()"
                                  OnSave="ToggleAssignment" />
        </div>

        @if (Condition.Assignments.Count == 0)
        {
            <div class="flex min-h-[96px] flex-col items-center justify-center rounded-xl border border-dashed border-slate-300 bg-slate-50/70 px-3 py-4 text-center dark:border-slate-700 dark:bg-slate-900/40">@AppLoc["none"]</div>
        }
        else
        {
            <div class="space-y-2">
                @foreach (var a in Condition.Assignments)
                {
                    <section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-950/80 overflow-hidden">
                        <div class="border-b border-slate-200 px-2.5 py-2 dark:border-slate-800">
                            <div>
                                <h5 class="text-sm font-semibold tracking-tight text-slate-900 dark:text-slate-100">@(a.Resource?.Name ?? $"{AppLoc["resource"]} #{a.ResourceId}")</h5>
                                </div>
                            </div>

                            <div class="flex flex-wrap items-center gap-1.5">
                                <span class="@(a.IsActive ?"inline-flex items-center rounded-full border border-emerald-200 bg-emerald-50 px-2 py-0.5 text-[10px] font-semibold text-emerald-700 dark:border-emerald-900/60 dark:bg-emerald-950/40 dark:text-emerald-200" :"inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-2 py-0.5 text-[10px] font-semibold text-slate-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300")">@(a.IsActive ?"ON" :"OFF")</span>
                                <button class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-rose-300 bg-transparent px-2.5 py-1.5 text-[11px] font-medium text-rose-700 transition hover:bg-rose-50 focus:outline-none focus:ring-2 focus:ring-rose-500/20 disabled:cursor-not-allowed disabled:opacity-60 dark:border-rose-800 dark:text-rose-300 dark:hover:bg-rose-950/30" @onclick="() => RemoveAssignment(a)">@AppLoc["remove"]</button>
                            </div>

                        <div class="px-2.5 py-2 space-y-2">
                            <div class="overflow-x-auto">
                                <div class="grid min-w-[1280px] grid-cols-12 items-end gap-2">
                                <div class="space-y-1 col-span-3">
                                    <label class="block text-xs font-medium text-slate-700 dark:text-slate-300">@AppLoc["resource"]</label>
                                    <ResourceAutocomplete MinChars="2" PageSize="20"
                                                          Value="a.ResourceId"
                                                          ValueChanged="@(v => a.ResourceId = v ?? 0)"
                                                          InitialName="@(a.Resource?.Name)" />
                                </div>
                                <div class="space-y-1">
                                    <label class="block text-xs font-medium text-slate-700 dark:text-slate-300">@CalcResource.changeFactor1</label>
                                    <input type="number" class="block w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500" @bind="a.ChangeFactor1" />
                                </div>
                                <div class="space-y-1">
                                    <label class="block text-xs font-medium text-slate-700 dark:text-slate-300">@CalcResource.changeFactor2</label>
                                    <input type="number" class="block w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500" @bind="a.ChangeFactor2" />
                                </div>
                                <div class="space-y-1">
                                    <label class="block text-xs font-medium text-slate-700 dark:text-slate-300">
                                        @if (a.Resource?.ResType == ResourceTypesEnum.Materials)
                                        {
                                            <span>@CalcResource.waste</span>
                                        }
                                        else
                                        {
                                            <span>@CalcResource.cap</span>
                                        }
                                    </label>
                                    <input type="number" class="block w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500" @bind="a.CapWaste" />
                                </div>
                                <div class="space-y-1">
                                    <label class="block text-xs font-medium text-slate-700 dark:text-slate-300">@CalcResource.baseCost</label>
                                    <input type="number" class="block w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500" @bind="a.BaseCost" />
                                </div>
                                <div class="space-y-1">
                                    <label class="block text-xs font-medium text-slate-700 dark:text-slate-300">@AppLoc["menuId"]</label>
                                    <input type="number" class="block w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500" @bind="a.MenuId" />
                                </div>
                                <div class="space-y-1 col-span-2">
                                    <label class="block text-xs font-medium text-slate-700 dark:text-slate-300">@CalcResource.active</label>
                                    <div class="flex h-[34px] items-center rounded-lg border border-slate-300 bg-white px-2.5 dark:border-slate-700 dark:bg-slate-900">
                                        <input type="checkbox" class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 dark:border-slate-600 dark:bg-slate-800" @bind="a.IsActive" />
                                    </div>
                                </div>
                                </div>
                            </div>

                            <div class="flex flex-wrap items-center gap-1.5">
                                @if (a.Resource?.ResType == ResourceTypesEnum.MachinesAndEquipments ||
                                     a.Resource?.ResType == ResourceTypesEnum.Worker)
                                {
                                    <button class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-300 bg-transparent px-2.5 py-1.5 text-[11px] font-medium text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-400/20 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-900" @onclick="@(() => AddRole(a))">@($"{AppLoc["add"]} {AppControll.capRole}")</button>
                                }
                                <button class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-300 bg-transparent px-2.5 py-1.5 text-[11px] font-medium text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-400/20 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-900" @onclick="@(() => (a.Expressions ??= new()).Add(string.Empty))">@AppLoc["addEquation"]</button>
                            </div>

                            @if (a.Resource?.ResType == ResourceTypesEnum.MachinesAndEquipments ||
                                 a.Resource?.ResType == ResourceTypesEnum.Worker)
                            {
                                <div class="rounded-xl border border-slate-200 bg-slate-50/80 p-2.5 dark:border-slate-800 dark:bg-slate-900/60 space-y-2">
                                    <div class="flex items-center justify-between gap-1.5">
                                        <div>
                                            <div class="text-sm font-semibold tracking-tight text-slate-900 dark:text-slate-100">@AppControll.capRole</div>
                                        </div>
                                        <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-2 py-0.5 text-[10px] font-semibold text-slate-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200">@(a.CapacityRoles?.Count ?? 0)</span>
                                    </div>

                                    @if (a.CapacityRoles is not null && a.CapacityRoles.Count > 0)
                                    {
                                        <div class="space-y-2">
                                            @for (int i = 0; i < a.CapacityRoles.Count; i++)
                                            {
                                                var index = i;
                                                var role = a.CapacityRoles[index];

                                                <div class="grid min-w-[760px] grid-cols-[56px_repeat(3,minmax(0,1fr))] items-end gap-2 rounded-xl border border-slate-200 bg-slate-50 p-2.5 dark:border-slate-700 dark:bg-slate-800/60">
                                                    <button type="button"
                                                            title="@AppLoc["remove"]"
                                                            class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-rose-300 bg-transparent px-2.5 py-1.5 text-[11px] font-medium text-rose-700 transition hover:bg-rose-50 focus:outline-none focus:ring-2 focus:ring-rose-500/20 disabled:cursor-not-allowed disabled:opacity-60 dark:border-rose-800 dark:text-rose-300 dark:hover:bg-rose-950/30 w-12"
                                                            @onclick="() => a.CapacityRoles.Remove(role)">
                                                        ✕
                                                    </button>

                                                    <div class="space-y-1">
                                                        <label class="block text-xs font-medium text-slate-700 dark:text-slate-300">@AppControll.min</label>
                                                        <input type="number" class="block w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500" @bind="role.Min" />
                                                    </div>

                                                    <div class="space-y-1">
                                                        <label class="block text-xs font-medium text-slate-700 dark:text-slate-300">@AppControll.max</label>
                                                        <input type="number" class="block w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500" @bind="role.Max" />
                                                    </div>

                                                    <div class="space-y-1">
                                                        <label class="block text-xs font-medium text-slate-700 dark:text-slate-300">@CalcResource.cap</label>
                                                        <input type="number" class="block w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500" @bind="role.Value" />
                                                    </div>

                                                    <div class="flex items-end justify-center pb-2 text-xs font-medium text-slate-500 dark:text-slate-400">#@(index + 1)</div>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="flex min-h-[96px] flex-col items-center justify-center rounded-xl border border-dashed border-slate-300 bg-slate-50/70 px-3 py-4 text-center dark:border-slate-700 dark:bg-slate-900/40">@AppLoc["none"]</div>
                                    }
                                </div>
                            }

                            @if (a.Expressions is not null && a.Expressions.Count > 0)
                            {
                                <div class="rounded-xl border border-slate-200 bg-slate-50/80 p-2.5 dark:border-slate-800 dark:bg-slate-900/60 space-y-2">
                                    <div class="flex items-center justify-between gap-1.5">
                                        <div>
                                            <div class="text-sm font-semibold tracking-tight text-slate-900 dark:text-slate-100">@CalcResource.Formulas</div>
                                        </div>
                                        <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-2 py-0.5 text-[10px] font-semibold text-slate-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200">@a.Expressions.Count</span>
                                    </div>

                                    <div class="space-y-1.5">
                                        @for (int i = 0; i < a.Expressions.Count; i++)
                                        {
                                            var index = i;
                                            <div class="flex items-center gap-1.5">
                                                <button class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-rose-300 bg-transparent px-2.5 py-1.5 text-[11px] font-medium text-rose-700 transition hover:bg-rose-50 focus:outline-none focus:ring-2 focus:ring-rose-500/20 disabled:cursor-not-allowed disabled:opacity-60 dark:border-rose-800 dark:text-rose-300 dark:hover:bg-rose-950/30" @onclick="() => a.Expressions.RemoveAt(index)">✕</button>
                                                <input type="text" class="block w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500" @bind="a.Expressions[index]" />
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <div class="rounded-xl border border-slate-200 bg-slate-50/80 p-2.5 dark:border-slate-800 dark:bg-slate-900/60 space-y-2">
                                <div class="flex flex-wrap items-center justify-between gap-1.5">
                                    <div>
                                        <div class="text-sm font-semibold tracking-tight text-slate-900 dark:text-slate-100">@AppLoc["bindingsEquations"]</div>
                                    </div>

                                    @if (CanAddBindingsFor(a))
                                    {
                                        <div class="flex flex-wrap items-center gap-1.5">
                                            <button class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-300 bg-transparent px-2.5 py-1.5 text-[11px] font-medium text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-400/20 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-900" @onclick="() => AddOptionBindingUI(a.Id)">@AppLoc["addChoiceBinding"]</button>
                                            <button class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-300 bg-transparent px-2.5 py-1.5 text-[11px] font-medium text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-400/20 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-900" @onclick="() => AddNumericBindingUI(a.Id)">@AppLoc["addNumericBinding"]</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center rounded-full border border-amber-200 bg-amber-50 px-2.5 py-1 text-[11px] font-semibold text-amber-700 dark:border-amber-900/60 dark:bg-amber-950/40 dark:text-amber-200">@AppLoc["saveConditionFirstToEnableBindings"]</span>
                                    }
                                </div>

                                @if (OptBindsByRA.TryGetValue(a.Id, out var obList) && obList.Count > 0)
                                {
                                    <div class="space-y-2">
                                        @foreach (var b in obList)
                                        {
                                            <section class="rounded-xl border border-slate-200 bg-slate-50/80 p-2.5 dark:border-slate-800 dark:bg-slate-900/60 space-y-2">
                                                <div class="overflow-x-auto">
                                                    <div class="flex min-w-[980px] items-end justify-between gap-2">
                                                        <div class="grid min-w-[760px] flex-1 grid-cols-2 items-end gap-2">
                                                        <div class="space-y-1">
                                                            <label class="block text-xs font-medium text-slate-700 dark:text-slate-300">@AppLoc["choiceGroup"]</label>
                                                            <select class="block w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
                                                                    value="@b.ChoiceGroupId"
                                                                    aria-label="@AppLoc["choiceGroup"]"
                                                                    @onchange="e => OnOptionGroupChanged(b, e)">
                                                                <option value="0">@AppLoc["selectPlaceholder"]</option>
                                                                @foreach (var g in TaskChoiceGroups)
                                                                {
                                                                    <option value="@g.Id">@g.DisplayName</option>
                                                                }
                                                            </select>
                                                        </div>

                                                        <div class="space-y-1">
                                                            <label class="block text-xs font-medium text-slate-700 dark:text-slate-300">@AppLoc["choiceOption"]</label>
                                                            <select class="block w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100" @bind="b.ChoiceOptionId" aria-label="@AppLoc["choiceOption"]">
                                                                <option value="0">@AppLoc["selectPlaceholder"]</option>
                                                                @foreach (var o in TaskChoiceGroups.FirstOrDefault(x => x.Id == b.ChoiceGroupId)?.Options ?? Enumerable.Empty<QuestionOptionDefinition>())
                                                                {
                                                                    <option value="@o.Id">@o.DisplayName</option>
                                                                }
                                                            </select>
                                                        </div>
                                                    </div>

                                                        <div class="flex shrink-0 items-center gap-1.5">
                                                        <button class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-emerald-600 bg-emerald-600 px-2.5 py-1.5 text-[11px] font-medium text-white transition hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-500/30 disabled:cursor-not-allowed disabled:opacity-60 dark:border-emerald-500 dark:bg-emerald-500 dark:hover:bg-emerald-400" title="@AppLoc["saveBinding"]" @onclick="async () => await OnSaveOption(a.Id, b)">@AppLoc["save"]</button>
                                                        <button class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-300 bg-transparent px-2.5 py-1.5 text-[11px] font-medium text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-400/20 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-900" title="@AppLoc["addEquation"]" @onclick="() => AddOptionEq(b)">@AppLoc["addEquation"]</button>
                                                        <button class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-rose-300 bg-transparent px-2.5 py-1.5 text-[11px] font-medium text-rose-700 transition hover:bg-rose-50 focus:outline-none focus:ring-2 focus:ring-rose-500/20 disabled:cursor-not-allowed disabled:opacity-60 dark:border-rose-800 dark:text-rose-300 dark:hover:bg-rose-950/30" title="@AppLoc["deleteBinding"]" @onclick="async () => await RemoveOptionBindingUIAsync(a.Id, b)">@ResourceApp.delete</button>
                                                        </div>
                                                    </div>
                                                </div>

                                                @if (b.LastError is not null)
                                                {
                                                    <div class="rounded-xl border border-rose-200 bg-rose-50 px-3 py-2 text-sm text-rose-700 dark:border-rose-900/60 dark:bg-rose-950/40 dark:text-rose-300">⚠ @b.LastError</div>
                                                }
                                                @if (b.SavedOk)
                                                {
                                                    <div class="inline-flex items-center rounded-full border border-sky-200 bg-sky-50 px-2.5 py-1 text-[11px] font-semibold text-sky-700 dark:border-sky-900/60 dark:bg-sky-950/40 dark:text-sky-200">✓ @AppLoc["saved"]</div>
                                                }

                                                @if (b.Formulas.Count == 0)
                                                {
                                                    <div class="flex min-h-[96px] flex-col items-center justify-center rounded-xl border border-dashed border-slate-300 bg-slate-50/70 px-3 py-4 text-center dark:border-slate-700 dark:bg-slate-900/40">@AppLoc["noFormulas"]</div>
                                                }
                                                else
                                                {
                                                    <div class="space-y-1.5">
                                                        @for (int i = 0; i < b.Formulas.Count; i++)
                                                        {
                                                            var idx = i;
                                                            <div class="flex items-center gap-1.5">
                                                                <input class="block w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500" placeholder="@AppLoc["equationExpressionPlaceholder"]" aria-label="@AppLoc["equation"]" @bind="b.Formulas[idx]" />
                                                                <button class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-rose-300 bg-transparent px-2.5 py-1.5 text-[11px] font-medium text-rose-700 transition hover:bg-rose-50 focus:outline-none focus:ring-2 focus:ring-rose-500/20 disabled:cursor-not-allowed disabled:opacity-60 dark:border-rose-800 dark:text-rose-300 dark:hover:bg-rose-950/30" title="@AppLoc["removeEquation"]" @onclick="() => RemoveOptionEq(b, idx)">✕</button>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </section>
                                        }
                                    </div>
                                }

                                @if (NumBindsByRA.TryGetValue(a.Id, out var nbList) && nbList.Count > 0)
                                {
                                    <div class="space-y-2 pt-2">
                                        <div class="flex items-center gap-1.5">
                                            <div class="text-sm font-semibold tracking-tight text-slate-900 dark:text-slate-100">@AppLoc["numericBindings"]</div>
                                            <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-2 py-0.5 text-[10px] font-semibold text-slate-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200">@nbList.Count</span>
                                        </div>

                                        @foreach (var b in nbList)
                                        {
                                            <section class="rounded-xl border border-slate-200 bg-slate-50/80 p-2.5 dark:border-slate-800 dark:bg-slate-900/60 space-y-2">
                                                <div class="overflow-x-auto">
                                                    <div class="flex min-w-[1220px] items-end justify-between gap-2">
                                                        <div class="grid min-w-[980px] flex-1 grid-cols-3 items-end gap-2">
                                                        <div class="space-y-1">
                                                            <label class="block text-xs font-medium text-slate-700 dark:text-slate-300">@AppLoc["numericGroup"]</label>
                                                            <select class="block w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100" @bind="b.NumericId" aria-label="@AppLoc["numericGroup"]">
                                                                <option value="0">@AppLoc["selectPlaceholder"]</option>
                                                                @foreach (var ng in TaskNumericGroups)
                                                                {
                                                                    <option value="@ng.Id">@ng.DisplayName</option>
                                                                }
                                                            </select>
                                                        </div>
                                                        <div class="space-y-1">
                                                            <label class="block text-xs font-medium text-slate-700 dark:text-slate-300">@AppControll.min</label>
                                                            <input type="number" class="block w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500" @bind="b.InputMinValue" placeholder="@AppControll.min" />
                                                        </div>
                                                        <div class="space-y-1">
                                                            <label class="block text-xs font-medium text-slate-700 dark:text-slate-300">@AppControll.max</label>
                                                            <input type="number" class="block w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500" @bind="b.InputMaxValue" placeholder="@AppControll.max" />
                                                        </div>
                                                    </div>

                                                    <div class="flex flex-wrap items-center gap-1.5">
                                                        <button class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-emerald-600 bg-emerald-600 px-2.5 py-1.5 text-[11px] font-medium text-white transition hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-500/30 disabled:cursor-not-allowed disabled:opacity-60 dark:border-emerald-500 dark:bg-emerald-500 dark:hover:bg-emerald-400" title="@AppLoc["saveNumericBinding"]" @onclick="async () => await OnSaveNumeric(a.Id, b)">@AppLoc["save"]</button>
                                                        <button class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-300 bg-transparent px-2.5 py-1.5 text-[11px] font-medium text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-400/20 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-900" title="@AppLoc["addEquation"]" @onclick="() => AddNumericEq(b)">@AppLoc["addEquation"]</button>
                                                        <button class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-rose-300 bg-transparent px-2.5 py-1.5 text-[11px] font-medium text-rose-700 transition hover:bg-rose-50 focus:outline-none focus:ring-2 focus:ring-rose-500/20 disabled:cursor-not-allowed disabled:opacity-60 dark:border-rose-800 dark:text-rose-300 dark:hover:bg-rose-950/30" title="@AppLoc["deleteNumericBinding"]" @onclick="async () => await RemoveNumericBindingUIAsync(a.Id, b)">@ResourceApp.delete</button>
                                                        </div>
                                                    </div>
                                                </div>

                                                @if (b.Formulas.Count == 0)
                                                {
                                                    <div class="flex min-h-[96px] flex-col items-center justify-center rounded-xl border border-dashed border-slate-300 bg-slate-50/70 px-3 py-4 text-center dark:border-slate-700 dark:bg-slate-900/40">@AppLoc["none"]</div>
                                                }
                                                else
                                                {
                                                    <div class="space-y-1.5">
                                                        @for (int i = 0; i < b.Formulas.Count; i++)
                                                        {
                                                            var idx = i;
                                                            <div class="flex items-center gap-1.5">
                                                                <input class="block w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500" placeholder="@AppLoc["equationExpressionPlaceholder"]" aria-label="@AppLoc["equation"]" @bind="b.Formulas[idx]" />
                                                                <button class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-rose-300 bg-transparent px-2.5 py-1.5 text-[11px] font-medium text-rose-700 transition hover:bg-rose-50 focus:outline-none focus:ring-2 focus:ring-rose-500/20 disabled:cursor-not-allowed disabled:opacity-60 dark:border-rose-800 dark:text-rose-300 dark:hover:bg-rose-950/30" title="@AppLoc["removeEquation"]" @onclick="() => RemoveNumericEq(b, idx)">✕</button>
                                                            </div>
                                                        }
                                                    </div>
                                                }

                                                @if (b.LastError is not null)
                                                {
                                                    <div class="rounded-xl border border-rose-200 bg-rose-50 px-3 py-2 text-sm text-rose-700 dark:border-rose-900/60 dark:bg-rose-950/40 dark:text-rose-300">⚠ @b.LastError</div>
                                                }
                                                @if (b.SavedOk)
                                                {
                                                    <div class="inline-flex items-center rounded-full border border-sky-200 bg-sky-50 px-2.5 py-1 text-[11px] font-semibold text-sky-700 dark:border-sky-900/60 dark:bg-sky-950/40 dark:text-sky-200">✓ @AppLoc["saved"]</div>
                                                }
                                            </section>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </section>
                }
            </div>
        }
    </div>
</section>
