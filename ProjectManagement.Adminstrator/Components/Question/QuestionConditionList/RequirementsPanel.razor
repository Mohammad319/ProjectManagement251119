﻿@using System
@using System.Collections.Generic
@using System.Linq
@using Microsoft.AspNetCore.Components
@using TaskResourceBlueprints.Entities.Questions.Conditions
@using TaskResourceBlueprints.Entities.Questions.Groups
@using ProjectManagement.Shared.Helper.ProjectAppStorage

@code {
    [Parameter] public ConditionDefinition Condition { get; set; } = null!;
    [Parameter] public IEnumerable<QuestionGroupDefinition> ChoiceGroups { get; set; } = Enumerable.Empty<QuestionGroupDefinition>();// = (LocalChoiceGroups ?? Enumerable.Empty<ChoiceGroup>()).OrderBy(x => x.SortOrder);
    [Parameter] public IEnumerable<ResourceSelectorDefinition> ResourceGroups { get; set; } = Enumerable.Empty<ResourceSelectorDefinition>();
    [Parameter] public IEnumerable<NumericQuestionDefinition> NumericGroups { get; set; } = Enumerable.Empty<NumericQuestionDefinition>();

    private IEnumerable<QuestionOptionDefinition> GetLocalChoiceOptions(int groupId)
        => ChoiceGroups.FirstOrDefault(g => g.Id == groupId)?.Options ?? Enumerable.Empty<QuestionOptionDefinition>();
    private IEnumerable<ResourceOptionItem> GetResourceItems(int groupId)
    => ResourceGroups.FirstOrDefault(g => g.Id == groupId)?.Items ?? Enumerable.Empty<ResourceOptionItem>();


    private void AddChoiceReq() => Condition?.OptionRules.Add(new OptionConditionRule { ConditionId = Condition.Id, GroupKey = 1 });
    private void RemoveChoiceReq(OptionConditionRule r) => Condition?.OptionRules.Remove(r);
    private void AddResReq() => Condition?.ResourceRules.Add(new ResourceConditionRule { ConditionId = Condition.Id, GroupKey = 1 });
    private void RemoveResReq(ResourceConditionRule r) => Condition?.ResourceRules.Remove(r);
    private void AddNumReq() => Condition?.NumericRules.Add(new NumericConditionRule { ConditionId = Condition.Id, GroupKey = 1 });
    private void RemoveNumReq(NumericConditionRule r) => Condition?.NumericRules.Remove(r);

    private void OnChoiceGroupChanged(OptionConditionRule r, ChangeEventArgs e)
    { if (int.TryParse(Convert.ToString(e.Value), out var id)) { r.QuestionGroupId = id; r.OptionId = 0; } }
    private void OnResGroupChanged(ResourceConditionRule r, ChangeEventArgs e)
    {
        if (int.TryParse(Convert.ToString(e.Value), out var id))
        { r.SelectorId = id; r.SelectorItemId = 0; }
    }
    private void OnNumericGroupChanged(NumericConditionRule r, ChangeEventArgs e)
    { if (int.TryParse(Convert.ToString(e.Value), out var id)) r.NumericQuestionId = id; }

    // --- Variable requirements helpers ---
    private void AddVarReq()
        => Condition?.VariableRules.Add(new VariableConditionRule
        {
            ConditionId = Condition.Id,
            GroupKey = 1
        });

    private void RemoveVarReq(VariableConditionRule r)
        => Condition?.VariableRules.Remove(r);


    // تسمية لطيفة للعرض (اختياري)
    private static string GetVarLabel(ParamName v) => v switch
    {
        ParamName.Thickness => "Thickness (t)",
        ParamName.Width => "Width (w)",
        ParamName.Length => "Length (l)",
        ParamName.Density => "Density (ρ)",
        _ => v.ToString()
    };
}
<div class="">

    <!-- Choice -->
    <div class="rounded border border-gray-200 bg-white p-1 dark:border-gray-700 dark:bg-gray-900/60">
        <div class="flex items-center gap-1">
            <h5 class="font-medium text-gray-800 dark:text-gray-100">Choice Requirements</h5>
            <button class="px-2 py-1 border border-blue-600 text-blue-600 rounded transition hover:bg-blue-600 hover:text-white dark:border-blue-400 dark:text-blue-400 dark:hover:bg-blue-400 dark:hover:text-white ml-auto" @onclick="AddChoiceReq">Add</button>
        </div>

        @if (Condition?.OptionRules == null || Condition.OptionRules.Count == 0)
        {
            <div class="text-gray-600 dark:text-gray-300">None</div>
        }
        else
        {
            @foreach (var r in Condition.OptionRules)
            {
                <div class="grid grid-cols-1 md:grid-cols-12 gap-2 mb-2" @key="@(r.Id != 0 ? "dg" + r.Id : r)">
                    <div class="md:col-span-4">
                        <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">Group</label>
                        <select class="w-full border border-gray-300 rounded px-2 py-1 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:text-white dark:border-gray-600" value="@r.QuestionGroupId" @onchange="e => OnChoiceGroupChanged(r, e)">
                            <option value="0">-- select --</option>
                            @foreach (var g in ChoiceGroups)
                            {
                                <option value="@g.Id">@g.DisplayName</option>
                            }
                        </select>
                    </div>

                    <div class="md:col-span-5">
                        <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">Option</label>
                        <select class="w-full border border-gray-300 rounded px-2 py-1 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:text-white dark:border-gray-600" @bind="r.OptionId">
                            <option value="0">-- select --</option>
                            @foreach (var opt in GetLocalChoiceOptions(r.QuestionGroupId))
                            {
                                <option value="@opt.Id">@opt.DisplayName</option>
                            }
                        </select>
                    </div>

                    <div class="md:col-span-2">
                        <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">GroupKey</label>
                        <input type="number" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" @bind="r.GroupKey" />
                    </div>

                    <div class="place-self-end">
                        <button class="px-2 py-1 border border-red-600 text-red-600 rounded transition hover:bg-red-600 hover:text-white dark:border-red-400 dark:text-red-400 dark:hover:bg-red-400 dark:hover:text-white" title="Remove" @onclick="() => RemoveChoiceReq(r)">x</button>
                    </div>
                </div>
            }
        }
    </div>

    <!-- Resource -->
    <div class="rounded border border-gray-200 bg-white p-1 dark:border-gray-700 dark:bg-gray-900/60">
        <div class="flex items-center gap-1">
            <h5 class="font-medium text-gray-800 dark:text-gray-100">Resource Requirements</h5>
            <button class="px-2 py-1 border border-blue-600 text-blue-600 rounded transition hover:bg-blue-600 hover:text-white dark:border-blue-400 dark:text-blue-400 dark:hover:bg-blue-400 dark:hover:text-white ml-auto" @onclick="AddResReq">Add</button>
        </div>

        @if (Condition?.ResourceRules == null || Condition.ResourceRules.Count == 0)
        {
            <div class="text-gray-600 dark:text-gray-300">None</div>
        }
        else
        {
            @foreach (var r in Condition.ResourceRules)
            {
                <div class="grid grid-cols-1 md:grid-cols-12 gap-2 mb-2">
                    <div class="md:col-span-4">
                        <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">Group</label>
                        <select class="w-full border border-gray-300 rounded px-2 py-1 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:text-white dark:border-gray-600" value="@r.SelectorId" @onchange="e => OnResGroupChanged(r, e)">
                            <option value="0">-- select --</option>
                            @foreach (var g in ResourceGroups)
                            {
                                <option value="@g.Id">@g.DisplayName</option>
                            }
                        </select>
                    </div>

                    <div class="md:col-span-5">
                        <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">Item</label>
                        <select class="w-full border border-gray-300 rounded px-2 py-1 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:text-white dark:border-gray-600" @bind="r.SelectorItemId">
                            <option value="0">-- select --</option>
                            @foreach (var it in GetResourceItems(r.SelectorId))
                            {
                                <option value="@it.Id">@it?.Resource?.Name</option>
                            }
                        </select>
                    </div>

                    <div class="md:col-span-2">
                        <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">GroupKey</label>
                        <input type="number" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" @bind="r.GroupKey" />
                    </div>

                    <div class="place-self-end">
                        <button class="px-2 py-1 border border-red-600 text-red-600 rounded transition hover:bg-red-600 hover:text-white dark:border-red-400 dark:text-red-400 dark:hover:bg-red-400 dark:hover:text-white" title="Remove" @onclick="() => RemoveResReq(r)">x</button>
                    </div>
                </div>
            }
        }
    </div>

    <!-- Numeric -->
    <div class="rounded border border-gray-200 bg-white p-1 dark:border-gray-700 dark:bg-gray-900/60">
        <div class="flex items-center gap-1">
            <h5 class="font-medium text-gray-800 dark:text-gray-100">Numeric Requirements</h5>
            <button class="px-2 py-1 border border-blue-600 text-blue-600 rounded transition hover:bg-blue-600 hover:text-white dark:border-blue-400 dark:text-blue-400 dark:hover:bg-blue-400 dark:hover:text-white ml-auto" @onclick="AddNumReq">Add</button>
        </div>

        @if (Condition?.NumericRules == null || Condition.NumericRules.Count == 0)
        {
            <div class="text-gray-600 dark:text-gray-300">None</div>
        }
        else
        {
            @foreach (var r in Condition.NumericRules)
            {
                <div class="grid grid-cols-1 md:grid-cols-6 gap-2 mb-2">
                    <div class="md:col-span-2">
                        <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">Group</label>
                        <select class="w-full border border-gray-300 rounded px-2 py-1 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:text-white dark:border-gray-600" value="@r.NumericQuestionId" @onchange="e => OnNumericGroupChanged(r, e)">
                            <option value="0">-- select --</option>
                            @foreach (var g in NumericGroups)
                            {
                                <option value="@g.Id">@g.DisplayName (@g.Id)</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">Min</label>
                        <input type="number" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" @bind="r.MinAllowedValue" />
                    </div>

                    <div>
                        <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">Max</label>
                        <input type="number" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" @bind="r.MaxAllowedValue" />
                    </div>

                    <div>
                        <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">GroupKey</label>
                        <input type="number" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" @bind="r.GroupKey" />
                    </div>

                    <div class="place-self-end">
                        <button class="px-2 py-1 border border-red-600 text-red-600 rounded transition hover:bg-red-600 hover:text-white dark:border-red-400 dark:text-red-400 dark:hover:bg-red-400 dark:hover:text-white" title="Remove" @onclick="() => RemoveNumReq(r)">x</button>
                    </div>
                </div>
            }
        }
    </div>

    <!-- Variable -->
    <div class="rounded border border-gray-200 bg-white p-1 dark:border-gray-700 dark:bg-gray-900/60">
        <div class="flex items-center gap-1">
            <h5 class="font-medium text-gray-800 dark:text-gray-100">Variable Requirements</h5>
            <button class="px-2 py-1 border border-blue-600 text-blue-600 rounded transition hover:bg-blue-600 hover:text-white dark:border-blue-400 dark:text-blue-400 dark:hover:bg-blue-400 dark:hover:text-white ml-auto" @onclick="AddVarReq">Add</button>
        </div>

        @if (Condition?.VariableRules == null || Condition.VariableRules.Count == 0)
        {
            <div class="text-gray-600 dark:text-gray-300">None</div>
        }
        else
        {
            @foreach (var r in Condition.VariableRules)
            {
                <div class="grid grid-cols-1 md:grid-cols-6 gap-2 mb-2" @key="@(r.Id != 0 ? "vr" + r.Id : r)">
                    <div class="md:col-span-2">
                        <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">Variable</label>
                        <select class="w-full border border-gray-300 rounded px-2 py-1 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:text-white dark:border-gray-600" value="@r.VariableName"
                                @onchange="e => r.VariableName = Convert.ToString(e.Value) ?? string.Empty">
                            <option value="">-- select --</option>
                            <option value="Thickness">Thickness</option>
                            <option value="Width">Width</option>
                            <option value="Length">Length</option>
                            <option value="Density">Density</option>
                            <option value="quantity">Quantity</option>
                            <option value="cost">Cost</option>
                            <option value="basecost">@CalcResource.baseCost</option>
                        </select>
                    </div>

                    <div>
                        <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">Min</label>
                        <input type="number" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" @bind="r.MinAllowedValue" />
                    </div>

                    <div>
                        <label class="block mb-0 font-normal text-sm text-gray-700 dark:text-gray-300">Max</label>
                        <input type="number" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" @bind="r.MaxAllowedValue" />
                    </div>

                    <div>
                        <label>GroupKey</label>
                        <input type="number" class="w-full border border-gray-300 rounded px-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white" @bind="r.GroupKey" />
                    </div>

                    <div class="place-self-end">
                        <button class="px-2 py-1 border border-red-600 text-red-600 rounded transition hover:bg-red-600 hover:text-white dark:border-red-400 dark:text-red-400 dark:hover:bg-red-400 dark:hover:text-white" title="Remove" @onclick="() => RemoveVarReq(r)">x</button>
                    </div>
                </div>
            }
        }
    </div>

</div>