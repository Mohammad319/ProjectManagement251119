@using System
@using System.Collections.Generic
@using System.Linq
@using Microsoft.AspNetCore.Components
@using ProjectManagement.Adminstrator.Components
@using TaskResourceBlueprints.Entities.Questions.Conditions
@using TaskResourceBlueprints.Entities.Questions.Groups
@using ProjectManagement.Shared.Helper.ProjectAppStorage
@inherits AppComponentBase

@code {
    [Parameter] public ConditionDefinition Condition { get; set; } = null!;
    [Parameter] public IEnumerable<QuestionGroupDefinition> ChoiceGroups { get; set; } = Enumerable.Empty<QuestionGroupDefinition>();
    [Parameter] public IEnumerable<ResourceSelectorDefinition> ResourceGroups { get; set; } = Enumerable.Empty<ResourceSelectorDefinition>();
    [Parameter] public IEnumerable<NumericQuestionDefinition> NumericGroups { get; set; } = Enumerable.Empty<NumericQuestionDefinition>();

    private IEnumerable<QuestionOptionDefinition> GetLocalChoiceOptions(int groupId)
        => ChoiceGroups.FirstOrDefault(g => g.Id == groupId)?.Options ?? Enumerable.Empty<QuestionOptionDefinition>();

    private IEnumerable<ResourceOptionItem> GetResourceItems(int groupId)
        => ResourceGroups.FirstOrDefault(g => g.Id == groupId)?.Items ?? Enumerable.Empty<ResourceOptionItem>();

    private void AddChoiceReq() => Condition?.OptionRules.Add(new OptionConditionRule { ConditionId = Condition.Id, GroupKey = 1 });
    private void RemoveChoiceReq(OptionConditionRule r) => Condition?.OptionRules.Remove(r);

    private void AddResReq() => Condition?.ResourceRules.Add(new ResourceConditionRule { ConditionId = Condition.Id, GroupKey = 1 });
    private void RemoveResReq(ResourceConditionRule r) => Condition?.ResourceRules.Remove(r);

    private void AddNumReq() => Condition?.NumericRules.Add(new NumericConditionRule { ConditionId = Condition.Id, GroupKey = 1 });
    private void RemoveNumReq(NumericConditionRule r) => Condition?.NumericRules.Remove(r);

    private void OnChoiceGroupChanged(OptionConditionRule r, ChangeEventArgs e)
    {
        if (int.TryParse(Convert.ToString(e.Value), out var id))
        {
            r.QuestionGroupId = id;
            r.OptionId = 0;
        }
    }

    private void OnResGroupChanged(ResourceConditionRule r, ChangeEventArgs e)
    {
        if (int.TryParse(Convert.ToString(e.Value), out var id))
        {
            r.SelectorId = id;
            r.SelectorItemId = 0;
        }
    }

    private void OnNumericGroupChanged(NumericConditionRule r, ChangeEventArgs e)
    {
        if (int.TryParse(Convert.ToString(e.Value), out var id))
        {
            r.NumericQuestionId = id;
        }
    }

    private void AddVarReq()
        => Condition?.VariableRules.Add(new VariableConditionRule
        {
            ConditionId = Condition.Id,
            GroupKey = 1
        });

    private void RemoveVarReq(VariableConditionRule r)
        => Condition?.VariableRules.Remove(r);

    private string GetVarLabel(string variableName) => variableName switch
    {
        "Thickness" => AppLoc["thickness"],
        "Width" => AppLoc["width"],
        "Length" => AppLoc["length"],
        "Density" => AppLoc["density"],
        "quantity" => CalcResource.quantity,
        "cost" => CalcResource.cost,
        "basecost" => CalcResource.baseCost,
        _ => variableName
    };
}

<div class="space-y-0.5">

    <section class="overflow-hidden rounded-xl border border-slate-200 bg-slate-50/70 dark:border-slate-800 dark:bg-slate-900/50">
        <div class="flex items-center justify-between gap-1 border-b border-slate-200 px-1.5 py-0.5 dark:border-slate-800">
            <div>
                <h4 class="text-sm font-semibold tracking-tight text-slate-900 dark:text-slate-100">@AppLoc["choiceRequirements"]</h4>
            </div>

            <div class="flex items-center gap-0.5">
