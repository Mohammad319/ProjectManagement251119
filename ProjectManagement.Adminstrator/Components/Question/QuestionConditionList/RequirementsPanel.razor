                        @onclick="AddChoiceReq">
                    @AppLoc["add"]
                </button>
            </div>
        </div>

        <div class="px-1.5 py-0.5">
            @if (Condition?.OptionRules == null || Condition.OptionRules.Count == 0)
            {
                <div class="flex min-h-[72px] flex-col items-center justify-center rounded-xl border border-dashed border-slate-300 bg-slate-50/70 px-1.5 py-0.5 text-center dark:border-slate-700 dark:bg-slate-900/40">
                    @AppLoc["none"]
                </div>
            }
            else
            {
                <div class="space-y-0.5">
                    @foreach (var r in Condition.OptionRules)
                    {
                        <div class="overflow-x-auto rounded-xl border border-slate-200 bg-slate-50/80 p-1 dark:border-slate-800 dark:bg-slate-900/60" @key="@(r.Id != 0 ? "dg" + r.Id : r)">
                            <div class="flex min-w-[1080px] flex-nowrap items-end gap-1">
                                <div class="w-[260px] shrink-0 space-y-0.5">
                                    <label class="block text-xs font-medium text-slate-700 dark:text-slate-300">@AppLoc["group"]</label>
                                    <select class="block w-full rounded-lg border border-slate-300 bg-white px-1.5 py-0.5 text-xs text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
                                            value="@r.QuestionGroupId"
                                            @onchange="e => OnChoiceGroupChanged(r, e)">
                                        <option value="0">@AppLoc["selectPlaceholder"]</option>
                                        @foreach (var g in ChoiceGroups)
                                        {
                                            <option value="@g.Id">@g.DisplayName</option>
                                        }
                                    </select>
                                </div>

                                <div class="w-[320px] shrink-0 space-y-0.5">
                                    <label class="block text-xs font-medium text-slate-700 dark:text-slate-300">@AppLoc["choiceOption"]</label>
                                    <select class="block w-full rounded-lg border border-slate-300 bg-white px-1.5 py-0.5 text-xs text-slate-900 shadow-sm outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
                                            @bind="r.OptionId">
                                        <option value="0">@AppLoc["selectPlaceholder"]</option>
                                        @foreach (var opt in GetLocalChoiceOptions(r.QuestionGroupId))
                                        {
                                            <option value="@opt.Id">@opt.DisplayName</option>
                                        }
                                    </select>
                                </div>

                                <div class="w-[120px] shrink-0 space-y-0.5">
                                    <label class="block text-xs font-medium text-slate-700 dark:text-slate-300">@AppLoc["groupKey"]</label>
                                    <input type="number"
                                           class="block w-full rounded-lg border border-slate-300 bg-white px-1.5 py-0.5 text-xs text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500"
                                           @bind="r.GroupKey" />
                                </div>

                                <div class="shrink-0">
                                    <button class="inline-flex h-[28px] items-center justify-center gap-0.5 whitespace-nowrap rounded-lg border border-rose-300 bg-transparent px-1.5 text-[11px] font-medium text-rose-700 transition hover:bg-rose-50 focus:outline-none focus:ring-2 focus:ring-rose-500/20 disabled:cursor-not-allowed disabled:opacity-60 dark:border-rose-800 dark:text-rose-300 dark:hover:bg-rose-950/30"
                                            title="@AppLoc["remove"]"
                                            @onclick="() => RemoveChoiceReq(r)">
                                        @AppLoc["remove"]
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </section>

