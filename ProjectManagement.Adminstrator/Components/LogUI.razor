@using AuthPermissions.Entity
@using Domain.Repository.AuthPermissions
@using Microsoft.EntityFrameworkCore
@using ProjectManagement.Adminstrator.Services.Users
@using ProjectManagement.Adminstrator.Services.MHDBlazor
@using ProjectManagement.Shared.DTO.Tenant
@using ProjectManagement.Shared.DTO.Tenant.Logs
@attribute [Authorize(Roles = PMRolesConst.APP.AdminManger)]
@inherits AppComponentBase
@inject ApplicationDbContext context
@inject IUsersService TenantRepo

<div class="pm-page">
    <section class="pm-card">
        <div class="pm-card-header">
            <div>
                <h2 class="pm-title">System logs</h2>
                <p class="pm-subtitle mt-1">Filter, review, and clean operational log entries.</p>
            </div>

            <div class="pm-toolbar">
                <span class="pm-chip">Loaded: @Logs.Count</span>
                <span class="pm-chip">Page: @Filter.PageNr</span>
            </div>
        </div>

        <div class="pm-card-body">
            <EditForm id="versionForm" Model="@Filter" OnValidSubmit="async () => await GetTaskAsync(true)">
                <div class="grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-5">
                    <div class="pm-field">
                        <label class="pm-label">@ResourceApp.date 1</label>
                        <InputDate class="pm-input" @bind-Value="Filter.Date1" />
                    </div>

                    <div class="pm-field">
                        <label class="pm-label">@ResourceApp.date 2</label>
                        <InputDate class="pm-input" @bind-Value="Filter.Date2" />
                    </div>

                    <div class="pm-field">
                        <label class="pm-label">@AppControll.tenant</label>
                        <InputSelect class="pm-select" @bind-Value="Filter.TenantID">
                            <option></option>
                            @if (Tenants is not null)
                            {
                                foreach (var tenant in Tenants)
                                {
                                    <option value="@tenant.Id">@tenant.Name</option>
                                }
                            }
                        </InputSelect>
                    </div>

                    <div class="pm-field">
                        <label class="pm-label">Level</label>
                        <InputSelect class="pm-select" @bind-Value="Filter.Level">
                            <option></option>
                            <option value="Debug">Debug</option>
                            <option value="Information">Information</option>
                            <option value="Warning">Warning</option>
                            <option value="Error">Error</option>
                            <option value="Critical">Critical</option>
                        </InputSelect>
                    </div>

                    <div class="pm-field">
                        <label class="pm-label">@AppControll.Delete_older_from_Month_Day</label>
                        <div class="grid grid-cols-[1fr_1fr_auto] items-end gap-2">
                            <input type="number" placeholder="MM" class="pm-input" @bind="month" />
                            <input type="number" placeholder="DD" class="pm-input" @bind="day" />

                            <div class="pm-toolbar justify-end">
                                <button type="button"
                                        class="pm-btn-danger"
                                        title="Delete older"
                                        @onclick="DeleteAsync"
                                        disabled="@IsLoading">
                                    @Icons.Delete
                                </button>

                                <button type="submit"
                                        class="pm-btn-primary"
                                        form="versionForm"
                                        disabled="@IsLoading">
                                    @ResourceApp.send
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </EditForm>
        </div>
    </section>

    <section class="pm-card overflow-hidden">
        <div class="pm-card-header">
            <div>
                <h3 class="pm-title">Entries</h3>
                <p class="pm-subtitle mt-1">Newest log entries appear first.</p>
            </div>

            <div class="pm-toolbar">
                <button class="pm-btn-secondary"
                        disabled="@(NectBtnActive || IsLoading)"
                        @onclick="async () => { Filter.PageNr = Filter.PageNr + 1; await GetTaskAsync(); }">
                    @AppControll.more
                </button>
            </div>
        </div>

        <div class="pm-card-body-sm">
            <div class="pm-table-wrap">
                <table class="pm-table table-fixed">
                    <colgroup>
                        <col class="w-[220px]" />
                        <col class="w-[34%]" />
                        <col class="w-[46%]" />
                    </colgroup>

                    <thead>
                        <tr>
                            <th>Time / Level</th>
                            <th>Message</th>
                            <th>Properties</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (IsLoading)
                        {
                            <tr>
                                <td colspan="3">
                                    <div class="pm-alert-info">Loading…</div>
                                </td>
                            </tr>
                        }
                        else if (Logs is null || !Logs.Any())
                        {
                            <tr>
                                <td colspan="3">
                                    <div class="pm-empty">No log data for the current filter.</div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var log in Logs)
                            {
                                <tr>
                                    <td class="whitespace-nowrap">
                                        <div class="font-medium text-slate-900 dark:text-slate-100">@log.TimeStamp.ToString("dd.MM.yyyy HH:mm")</div>
                                        <div class="mt-1">
                                            <span class="@GetLevelBadgeClass(log.Level)">@log.Level</span>
                                        </div>
                                    </td>

                                    <td class="whitespace-normal break-words">
                                        @log.Message
                                    </td>

                                    <td class="whitespace-normal break-words">
                                        @log.Properties
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</div>

@code {
    LogsFilter Filter = new();
    List<LogEntity> Logs = [];

    bool IsLoading;
    bool NectBtnActive;
    List<GetTenantsDTO> Tenants = [];
    int day = 7;
    int month = 0;

    private string GetLevelBadgeClass(string? level)
        => level switch
        {
            "Error" or "Critical" => "pm-chip-rose",
            "Warning" => "pm-chip-amber",
            _ => "pm-chip-blue"
        };

    async Task DeleteAsync()
    {
        IsLoading = true;
        DateTime date = DateTime.Now.AddMonths(month * -1).AddDays(day * -1);

        await context.Logs
            .Where(x => x.TimeStamp < date)
            .ExecuteDeleteAsync();

        await GetTaskAsync(true);
        IsLoading = false;
    }

    async Task DeleteAsync(LogEntity log)
    {
        await context.Logs
            .Where(x => x.Id == log.Id)
            .ExecuteDeleteAsync();

        Logs.RemoveAll(x => x.Id == log.Id);
    }

    public async Task<List<LogEntity>> GetAsync(LogsFilter filter)
    {
        var query = context.Logs.AsNoTracking().AsQueryable();
        if (filter.Date1.HasValue)
            query = query.Where(x => x.TimeStamp > filter.Date1.Value);
        if (filter.Date2.HasValue)
            query = query.Where(x => x.TimeStamp < filter.Date2.Value.AddDays(1));
        if (!string.IsNullOrWhiteSpace(filter.Level))
            query = query.Where(x => x.Level == filter.Level);
        if (filter.TenantID.HasValue)
            query = query.Where(x => x.TenantID == filter.TenantID);

        return await query
            .OrderByDescending(x => x.TimeStamp)
            .ThenByDescending(x => x.Id)
            .Skip((Math.Max(filter.PageNr, 1) - 1) * filter.Count)
            .Take(filter.Count)
            .ToListAsync();
    }

    async Task GetTaskAsync(bool isNewRequest = false)
    {
        IsLoading = true;
        if (isNewRequest)
        {
            Filter.PageNr = 1;
            NectBtnActive = false;
        }

        var Logs2 = await GetAsync(Filter);

        NectBtnActive = Logs2.Count < Filter.Count;
        if (!isNewRequest)
            Logs.AddRange(Logs2);
        else
            Logs = Logs2;
        IsLoading = false;
    }

    async Task GetTenants()
    {
        IsLoading = true;
        Tenants = await ExHandlers.RunCheckTokenAsync(() => TenantRepo.GetAsync()) ?? [];
        IsLoading = false;
        StateHasChanged();
    }

    protected async override Task OnInitializedAsync()
    {
        await GetTaskAsync(true);
        await GetTenants();
    }
}
