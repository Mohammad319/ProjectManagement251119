@using AuthPermissions.Entity
@using Domain.Repository.AuthPermissions
@using Microsoft.EntityFrameworkCore
@using ProjectManagement.Adminstrator.Services.Users
@using ProjectManagement.Adminstrator.Services.MHDBlazor
@using ProjectManagement.Shared.DTO.Tenant
@using ProjectManagement.Shared.DTO.Tenant.Logs
@attribute [Authorize(Roles = PMRolesConst.APP.AdminManger)]
@inherits AppComponentBase
@inject ApplicationDbContext context
@inject IUsersService TenantRepo

<div class="pm-page">
    <section class="pm-page-header">
        <div class="pm-page-kicker">Operations</div>
        <h2 class="pm-page-title">Application logs</h2>
        <p class="pm-page-subtitle">Filter operational logs by time, tenant, and severity. Clean up older records without leaving the admin workspace.</p>
    </section>

    <EditForm id="versionForm" Model="@Filter" OnValidSubmit="async () => await GetTaskAsync(true)">
        <div class="pm-toolbar">
            <div class="grid flex-1 gap-3 md:grid-cols-2 xl:grid-cols-5">
                <div>
                    <label class="pm-label">@ResourceApp.date 1</label>
                    <InputDate class="pm-field" @bind-Value="Filter.Date1" />
                </div>

                <div>
                    <label class="pm-label">@ResourceApp.date 2</label>
                    <InputDate class="pm-field" @bind-Value="Filter.Date2" />
                </div>

                <div>
                    <label class="pm-label">@AppControll.tenant</label>
                    <InputSelect class="pm-field" @bind-Value="Filter.TenantID">
                        <option></option>
                        @if (Tenants is not null)
                        {
                            foreach (var tenant in Tenants)
                            {
                                <option value="@tenant.Id">@tenant.Name</option>
                            }
                        }
                    </InputSelect>
                </div>

                <div>
                    <label class="pm-label">Level</label>
                    <InputSelect class="pm-field" @bind-Value="Filter.Level">
                        <option></option>
                        <option value="Debug">Debug</option>
                        <option value="Information">Information</option>
                        <option value="Warning">Warning</option>
                        <option value="Error">Error</option>
                        <option value="Critical">Critical</option>
                    </InputSelect>
                </div>

                <div>
                    <label class="pm-label">@AppControll.Delete_older_from_Month_Day</label>
                    <div class="grid grid-cols-[1fr_1fr_auto] gap-2">
                        <input type="number" placeholder="MM" class="pm-field" @bind="month" />
                        <input type="number" placeholder="DD" class="pm-field" @bind="day" />
                        <button type="button"
                                class="pm-btn pm-btn-danger h-[42px] px-3"
                                title="Delete older"
                                @onclick="DeleteAsync"
                                disabled="@IsLoading">
                            @Icons.Delete
                        </button>
                    </div>
                    <div class="pm-help">Deletes records older than the selected month/day offset.</div>
                </div>
            </div>

            <div class="pm-toolbar-row">
                <button type="submit"
                        class="pm-btn pm-btn-primary"
                        form="versionForm"
                        disabled="@IsLoading">
                    @ResourceApp.send
                </button>
            </div>
        </div>
    </EditForm>

    <div class="pm-table-wrap">
        <div class="pm-table-scroll">
            <table class="pm-table table-fixed">
                <colgroup>
                    <col class="w-[220px]" />
                    <col class="w-[34%]" />
                    <col class="w-[46%]" />
                </colgroup>
                <thead>
                    <tr>
                        <th>Timestamp / Level</th>
                        <th>Message</th>
                        <th>Properties</th>
                    </tr>
                </thead>
                <tbody>
                    @if (IsLoading)
                    {
                        <tr>
                            <td colspan="3">
                                <div class="py-6 text-sm text-slate-500 dark:text-slate-400">Loading logs…</div>
                            </td>
                        </tr>
                    }
                    else if (Logs is null || !Logs.Any())
                    {
                        <tr>
                            <td colspan="3">
                                <div class="py-6 text-sm text-slate-500 dark:text-slate-400">No log records matched the current filter.</div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var log in Logs)
                        {
                            <tr>
                                <td>
                                    <div class="font-medium text-slate-900 dark:text-slate-100">@log.TimeStamp.ToString("dd.MM.yyyy HH:mm")</div>
                                    <div class="mt-1">
                                        <span class="@(GetLevelClass(log.Level))">@log.Level</span>
                                    </div>
                                </td>
                                <td class="whitespace-normal break-words">@log.Message</td>
                                <td class="whitespace-normal break-words text-slate-500 dark:text-slate-400">@log.Properties</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="flex items-center justify-between gap-3 rounded-2xl border border-slate-200/80 bg-white/80 px-4 py-3 dark:border-slate-800 dark:bg-slate-900/70">
        <div class="text-sm text-slate-500 dark:text-slate-400">
            Page <span class="font-semibold text-slate-800 dark:text-slate-200">@Filter.PageNr</span>
        </div>
        <button class="pm-btn pm-btn-secondary"
                disabled="@(NectBtnActive || IsLoading)"
                @onclick="async () => { Filter.PageNr = Filter.PageNr + 1; await GetTaskAsync(); }">
            @AppControll.more
        </button>
    </div>
</div>

@code {
    LogsFilter Filter = new();
    List<LogEntity> Logs = [];

    bool IsLoading;
    bool NectBtnActive;
    List<GetTenantsDTO> Tenants = [];
    int day = 7;
    int month = 0;

    string GetLevelClass(string? level) => level switch
    {
        "Error" => "pm-pill pm-pill-danger",
        "Critical" => "pm-pill pm-pill-danger",
        "Warning" => "pm-pill pm-pill-warning",
        "Information" => "pm-pill pm-pill-info",
        _ => "pm-pill pm-pill-muted"
    };

    async Task DeleteAsync()
    {
        IsLoading = true;
        DateTime date = DateTime.Now.AddMonths(month * -1).AddDays(day * -1);

        await context.Logs
            .Where(x => x.TimeStamp < date)
            .ExecuteDeleteAsync();

        await GetTaskAsync(true);
        IsLoading = false;
    }

    async Task DeleteAsync(LogEntity log)
    {
        await context.Logs
            .Where(x => x.Id == log.Id)
            .ExecuteDeleteAsync();

        Logs.RemoveAll(x => x.Id == log.Id);
    }

    public async Task<List<LogEntity>> GetAsync(LogsFilter filter)
    {
        var query = context.Logs.AsNoTracking().AsQueryable();
        if (filter.Date1.HasValue)
            query = query.Where(x => x.TimeStamp > filter.Date1.Value);
        if (filter.Date2.HasValue)
            query = query.Where(x => x.TimeStamp < filter.Date2.Value.AddDays(1));
        if (!string.IsNullOrWhiteSpace(filter.Level))
            query = query.Where(x => x.Level == filter.Level);
        if (filter.TenantID.HasValue)
            query = query.Where(x => x.TenantID == filter.TenantID);

        return await query
            .OrderByDescending(x => x.TimeStamp)
            .ThenByDescending(x => x.Id)
            .Skip((Math.Max(filter.PageNr, 1) - 1) * filter.Count)
            .Take(filter.Count)
            .ToListAsync();
    }

    async Task GetTaskAsync(bool isNewRequest = false)
    {
        IsLoading = true;
        if (isNewRequest)
        {
            Filter.PageNr = 1;
            NectBtnActive = false;
        }

        var Logs2 = await GetAsync(Filter);

        NectBtnActive = Logs2.Count < Filter.Count;
        if (!isNewRequest)
            Logs.AddRange(Logs2);
        else
            Logs = Logs2;
        IsLoading = false;
    }

    async Task GetTenants()
    {
        IsLoading = true;
        Tenants = await ExHandlers.RunCheckTokenAsync(() => TenantRepo.GetAsync()) ?? [];
        IsLoading = false;
        StateHasChanged();
    }

    protected async override Task OnInitializedAsync()
    {
        await GetTaskAsync(true);
        await GetTenants();
    }
}
