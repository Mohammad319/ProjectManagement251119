
@using ProjectImportHub.Entities
@using ProjectImportHub.Services
@using ProjectManagement.Adminstrator.Constants
@inherits AppComponentBase
@inject IEntityService<ProjectImportHub.Entities.ActionEntity> service
<div class="@CssClasses.Layout.FlexItemsCenter p-1">
    <button @onclick="UpdateForm" class="@CssClasses.Btn.Outline.Success">@((MarkupString)Icons.Plus)</button>
    <button @onclick="() => IsVisible = !IsVisible" class="@CssClasses.Btn.Outline.Secondary">@((MarkupString)Icons.GetVisibleIcon(IsVisible))</button>
</div>
<Grid TItem="ProjectImportHub.Entities.ActionEntity" Items="ActionsTasks?.Where(x => x.IsVisible == IsVisible)?.OrderByDescending(x => x.SortOrder)">

        <Column>
            <Template Context="status">
                <div class="@CssClasses.Layout.FlexItemsCenter">
                    <button @onclick="() => UpdateForm(status)" class="@CssClasses.Btn.Outline.Warning">@Icons.Edit</button>
                    <button @onclick="() => Remove(status)" class="@CssClasses.Btn.Outline.Danger">@Icons.Delete</button>
                </div>
            </Template>
        </Column>
        <Column Title="" ValueSelector="c => c.DisplayName"></Column>
</Grid>

@code {
    bool IsVisible = true;
    List<ProjectImportHub.Entities.ActionEntity>? ActionsTasks;
    void UpdateForm() => UpdateForm(new ProjectImportHub.Entities.ActionEntity(){ DisplayName = "name"});
    void UpdateForm(ProjectImportHub.Entities.ActionEntity model)
    {
            ProjectImportHub.Entities.ActionEntity up = new() { DisplayName = "" };
        PropertyCopier.CopyPropertiesTo(model, up);

        Modal.AddModal<ActionFormUI>(model.Id == 0 ? AppLoc[LocalizerConst.New, CalcResource.projectCompensation] :
            AppLoc[LocalizerConst.Update, model.DisplayName], new Dictionary<string, object>
                {
                    [nameof(ActionFormUI.Model)] = up,
                    [nameof(ActionFormUI.Callback)] = EventCallback.Factory.Create<bool>(this, BtnUpdate)
                }
            , SizeMHD.Medium);
    }
    void Remove(ProjectImportHub.Entities.ActionEntity model) =>
    MHD.DeleteMessage(model.DisplayName, () => ConfirmRemoveAsync(model));

    async Task ConfirmRemoveAsync(ProjectImportHub.Entities.ActionEntity model)
    {
        bool result = await ExHandlers.RunCheckTokenAsync(() => service.DeleteAsync(model.Id));
        if (result)
        {
            ActionsTasks.Remove(model);
        }
        MHD.Notifications(ToastType.Delete, result);

        StateHasChanged();
    }
    async Task BtnUpdate(bool IsSuccess)
    {
        Modal.ClearModal();
        if (IsSuccess)
        {
            ActionsTasks = await ExHandlers.RunCheckTokenAsync(() => service.GetAllAsync());
        }
        StateHasChanged();
    }

    protected async override Task OnInitializedAsync()
    {
        ActionsTasks = await service.GetAllAsync();
    }
}