
@using TaskResourceBlueprints.Entities
@using TaskResourceBlueprints.Entities.Lookups
@using TaskResourceBlueprints.Services
@using ProjectManagement.Adminstrator.Constants
@using TaskResourceBlueprints.Services.Common
@inherits AppComponentBase
@inject IEntityService<ActionEntity> service
<div class="@CssClasses.Layout.FlexItemsCenter p-1">
    <button @onclick="UpdateForm" class="@CssClasses.Btn.Outline.Success">@((MarkupString)Icons.Plus)</button>
    <button @onclick="() => IsVisible = !IsVisible" class="@CssClasses.Btn.Outline.Secondary">@((MarkupString)Icons.GetVisibleIcon(IsVisible))</button>
</div>
<MhdTable TItem="ActionEntity" Items="ActionsTasks?.Where(x => x.IsVisible == IsVisible)?.OrderByDescending(x => x.SortOrder)">

        <MhdTableColumn>
            <Template Context="status">
                <div class="@CssClasses.Layout.FlexItemsCenter">
                    <button @onclick="() => UpdateForm(status)" class="@CssClasses.Btn.Outline.Warning">@Icons.Edit</button>
                    <button @onclick="() => Remove(status)" class="@CssClasses.Btn.Outline.Danger">@Icons.Delete</button>
                </div>
            </Template>
        </MhdTableColumn>
        <MhdTableColumn Title="" ValueSelector="c => c.Name"></MhdTableColumn>
</MhdTable>

@code {
    bool IsVisible = true;
    List<ActionEntity>? ActionsTasks;
    void UpdateForm() => UpdateForm(new ActionEntity(){ Name = "name"});
    void UpdateForm(ActionEntity model)
    {
            ActionEntity up = new() { Name = "" };
        PropertyCopier.CopyPropertiesTo(model, up);

        Modal.ShowComponent<ActionFormUI>(model.Id == 0 ? AppLoc[LocalizerConst.New, CalcResource.projectCompensation] :
            AppLoc[LocalizerConst.Update, model.Name], new Dictionary<string, object>
                {
                    [nameof(ActionFormUI.Model)] = up,
                    [nameof(ActionFormUI.Callback)] = EventCallback.Factory.Create<bool>(this, BtnUpdate)
                }
            , DialogSize.Medium);
    }
    void Remove(ActionEntity model) =>
    MHD.DeleteMessage(model.Name, EventCallback.Factory.Create(this, () => ConfirmRemoveAsync(model)));

    async Task ConfirmRemoveAsync(ActionEntity model)
    {
        bool result = await ExHandlers.RunCheckTokenAsync(() => service.DeleteAsync(model.Id));
        if (result)
        {
            ActionsTasks?.Remove(model);
        }
        MHD.Notifications(ToastType.Delete, result);

        StateHasChanged();
    }
    async Task BtnUpdate(bool IsSuccess)
    {
        Modal.Close();
        if (IsSuccess)
        {
            ActionsTasks = await ExHandlers.RunCheckTokenAsync(() => service.GetAllAsync());
        }
        StateHasChanged();
    }

    protected async override Task OnInitializedAsync()
    {
        ActionsTasks = await service.GetAllAsync();
    }
}