@using TaskResourceBlueprints.Entities
@using TaskResourceBlueprints.Entities.Lookups
@using TaskResourceBlueprints.Services
@using TaskResourceBlueprints.Services.Common
@inherits AppComponentBase
@inject IEntityService<ActionTypeEntity> service

<EditForm id="actionTypeForm" Model="@Model" OnValidSubmit="HandleSubmitAsync">
    <DataAnnotationsValidator />

        <div class="mb-1">
            <div class="text-sm font-semibold text-slate-900 dark:text-slate-100">Action type settings</div>
        </div>

        <div class="grid grid-cols-1 gap-3">
            <div class="space-y-1.5 md:col-span-2">
                <label class="block text-xs font-medium text-slate-700 dark:text-slate-300">@CalcResource.name</label>
                <InputText class="block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500" @bind-Value="@Model.Name" />
                <ValidationMessage For="@(() => Model.Name)" class="space-y-1" />
            </div>

            <div class="space-y-1.5">
                <label class="block text-xs font-medium text-slate-700 dark:text-slate-300">@ResourceApp.order</label>
                <InputNumber class="block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500" @bind-Value="@Model.SortOrder" />
                <ValidationMessage For="@(() => Model.SortOrder)" class="space-y-1" />
            </div>

            <div class="flex items-center gap-2 rounded-xl border border-slate-200 bg-slate-50/70 px-3 py-2 dark:border-slate-800 dark:bg-slate-900/60 md:col-span-3">
                <InputCheckbox id="actionTypeVisible" class="h-4 w-4 rounded border-slate-300 text-sky-600 focus:ring-sky-500 dark:border-slate-600 dark:bg-slate-900" @bind-Value="@Model.IsVisible" />
                <label class="text-sm font-medium text-slate-700 dark:text-slate-200" for="actionTypeVisible">@ResourceApp.visible</label>
            </div>
        </div>
</EditForm>

<div class="flex flex-wrap items-center gap-2">
    <button type="submit" form="actionTypeForm" class="inline-flex items-center justify-center gap-2 rounded-xl border border-emerald-600 bg-emerald-600 px-3 py-2 text-xs font-medium text-white transition hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-500/30 disabled:cursor-not-allowed disabled:opacity-60 dark:border-emerald-500 dark:bg-emerald-500 dark:hover:bg-emerald-400" disabled="@IsLoading">
        @ResourceApp.save
    </button>

    <button type="button" class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-medium text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-400/30 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800" @onclick="async () => await Callback.InvokeAsync(false)">
        @ResourceApp.cancel
    </button>
</div>

@code {
    [Parameter] public ActionTypeEntity Model { get; set; } = new() { Name ="" };
    [Parameter] public EventCallback<bool> Callback { get; set; }

    bool IsLoading = false;

    private async Task HandleSubmitAsync()
    {
        IsLoading = true;
        bool result = false;

        if (Model.Id == 0)
        {
            var obj = await ExHandlers.RunCheckTokenAsync(() => service.AddAsync(Model));
            result = obj != null && obj.Id > 0;
        }
        else
        {
            result = await ExHandlers.RunCheckTokenAsync(() => service.UpdateAsync(Model));
        }

        MHD.Notifications(Model.Id == 0 ? ToastType.Add : ToastType.Update, result);
        await Callback.InvokeAsync(result);
    }
}
