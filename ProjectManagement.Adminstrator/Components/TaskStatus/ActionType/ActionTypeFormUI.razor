@using TaskResourceBlueprints.Entities
@using TaskResourceBlueprints.Entities.Lookups
@using TaskResourceBlueprints.Services
@using TaskResourceBlueprints.Services.Common
@inherits AppComponentBase
@inject IEntityService<ActionTypeEntity> service

<EditForm id="actionTypeForm" Model="@Model" OnValidSubmit="HandleSubmitAsync" class="pm-form">
    <DataAnnotationsValidator />

    <div class="pm-card-soft">
        <div class="mb-4">
            <div class="pm-section-title">Action type settings</div>
        </div>

        <div class="pm-form-grid">
            <div class="pm-field-wide">
                <label class="pm-label">@CalcResource.name</label>
                <InputText class="pm-input" @bind-Value="@Model.Name" />
                <ValidationMessage For="@(() => Model.Name)" class="pm-validation" />
            </div>

            <div class="pm-field">
                <label class="pm-label">@ResourceApp.order</label>
                <InputNumber class="pm-input" @bind-Value="@Model.SortOrder" />
                <ValidationMessage For="@(() => Model.SortOrder)" class="pm-validation" />
            </div>

            <div class="pm-checkbox-row md:col-span-3">
                <InputCheckbox id="actionTypeVisible" class="pm-checkbox" @bind-Value="@Model.IsVisible" />
                <label class="text-sm font-medium text-slate-700 dark:text-slate-200" for="actionTypeVisible">@ResourceApp.visible</label>
            </div>
        </div>
    </div>
</EditForm>

<div class="pm-actions">
    <button type="submit" form="actionTypeForm" class="pm-btn-success" disabled="@IsLoading">
        @ResourceApp.save
    </button>

    <button type="button" class="pm-btn-secondary" @onclick="async () => await Callback.InvokeAsync(false)">
        @ResourceApp.cancel
    </button>
</div>

@code {
    [Parameter] public ActionTypeEntity Model { get; set; } = new() { Name = "" };
    [Parameter] public EventCallback<bool> Callback { get; set; }

    bool IsLoading = false;

    private async Task HandleSubmitAsync()
    {
        IsLoading = true;
        bool result = false;

        if (Model.Id == 0)
        {
            var obj = await ExHandlers.RunCheckTokenAsync(() => service.AddAsync(Model));
            result = obj != null && obj.Id > 0;
        }
        else
        {
            result = await ExHandlers.RunCheckTokenAsync(() => service.UpdateAsync(Model));
        }

        MHD.Notifications(Model.Id == 0 ? ToastType.Add : ToastType.Update, result);
        await Callback.InvokeAsync(result);
    }
}
