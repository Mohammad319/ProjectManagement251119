@using BlazorMHD.UI.Components.Data.Table
@using ProjectManagement.Adminstrator.Constants
@using TaskResourceBlueprints.Entities
@using TaskResourceBlueprints.Entities.Lookups
@using TaskResourceBlueprints.Services
@using TaskResourceBlueprints.Services.Common
@inherits AppComponentBase
@inject IEntityService<ActionTypeEntity> service

<div class="pm-page">
    <div class="pm-card">
        <div class="pm-card-header">
            <div>
                <h3 class="pm-title">Action type</h3>
                <p class="pm-subtitle">@((ActionTypesList?.Count ?? 0)) items</p>
            </div>

            <div class="pm-toolbar">
                <button @onclick="UpdateForm"
                        class="pm-btn-icon-success"
                        title="@ResourceApp._new"
                        aria-label="@ResourceApp._new">
                    @((MarkupString)Icons.Plus)
                </button>

                <button @onclick="() => IsVisible = !IsVisible"
                        class="pm-btn-icon"
                        title="@ResourceApp.visible"
                        aria-label="@ResourceApp.visible">
                    @((MarkupString)Icons.GetVisibleIcon(IsVisible))
                </button>
            </div>
        </div>
    </div>

    @if (ActionTypesList?.Any(x => x.IsVisible == IsVisible) == true)
    {
        <div class="pm-card overflow-hidden">
            <div class="overflow-x-auto">
                <MhdTable TItem="ActionTypeEntity" Items="ActionTypesList.Where(x => x.IsVisible == IsVisible).OrderByDescending(x => x.SortOrder)" ShowFilter="false">
                    <HeaderTemplate>
                        <th class="w-36 p-2 text-left text-sm font-semibold text-slate-700 dark:text-slate-200"></th>
                        <th class="p-2 text-left text-sm font-semibold text-slate-700 dark:text-slate-200">@CalcResource.name</th>
                    </HeaderTemplate>
                    <ChildContent>
                        <MhdTableColumn>
                            <Template Context="status">
                                <div class="flex items-center gap-2">
                                    <button @onclick="() => UpdateForm(status)"
                                            class="pm-btn-icon-warning"
                                            title="@ResourceApp.update"
                                            aria-label="@ResourceApp.update">
                                        @Icons.Edit
                                    </button>

                                    <button @onclick="() => Remove(status)"
                                            class="pm-btn-icon-danger"
                                            title="@ResourceApp.delete"
                                            aria-label="@ResourceApp.delete">
                                        @Icons.Delete
                                    </button>
                                </div>
                            </Template>
                        </MhdTableColumn>

                        <MhdTableColumn>
                            <Template Context="status">
                                <div>
                                    <div class="font-medium text-slate-900 dark:text-slate-100">@status.Name</div>
                                    <div class="text-xs text-slate-500 dark:text-slate-400">Order: @status.SortOrder</div>
                                </div>
                            </Template>
                        </MhdTableColumn>
                    </ChildContent>
                </MhdTable>
            </div>
        </div>
    }
    else
    {
        <div class="pm-empty">@AppLoc[nameof(ResourceApp.ThereAreNoItemsToDisplay)]</div>
    }
</div>

@code {
    bool IsVisible = true;
    List<ActionTypeEntity>? ActionTypesList;

    void UpdateForm() => UpdateForm(new ActionTypeEntity() { Name = "" });

    void UpdateForm(ActionTypeEntity model)
    {
        ActionTypeEntity up = new() { Name = "" };
        PropertyCopier.CopyPropertiesTo(model, up);

        Modal.ShowComponent<ActionTypeFormUI>(model.Id == 0 ? AppLoc[LocalizerConst.New, CalcResource.projectCompensation] :
            AppLoc[LocalizerConst.Update, model.Name], new Dictionary<string, object>
            {
                [nameof(ActionTypeFormUI.Model)] = up,
                [nameof(ActionTypeFormUI.Callback)] = EventCallback.Factory.Create<bool>(this, BtnUpdate)
            },
            DialogSize.Medium);
    }

    void Remove(ActionTypeEntity model) =>
        MHD.DeleteMessage(model.Name, EventCallback.Factory.Create(this, () => ConfirmRemoveAsync(model)));

    async Task ConfirmRemoveAsync(ActionTypeEntity model)
    {
        bool result = await ExHandlers.RunCheckTokenAsync(() => service.DeleteAsync(model.Id));
        if (result)
        {
            ActionTypesList?.Remove(model);
        }

        MHD.Notifications(ToastType.Delete, result);
        StateHasChanged();
    }

    async Task BtnUpdate(bool IsSuccess)
    {
        Modal.Close();
        if (IsSuccess)
        {
            ActionTypesList = await ExHandlers.RunCheckTokenAsync(() => service.GetAllAsync());
        }

        StateHasChanged();
    }

    protected async override Task OnInitializedAsync()
    {
        ActionTypesList = await ExHandlers.RunCheckTokenAsync(() => service.GetAllAsync());
    }
}
