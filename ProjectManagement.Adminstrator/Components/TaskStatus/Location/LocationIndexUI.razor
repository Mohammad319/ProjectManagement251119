@using BlazorMHD.UI.Components.Data.Table
@using ProjectManagement.Adminstrator.Constants
@using TaskResourceBlueprints.Entities
@using TaskResourceBlueprints.Entities.Lookups
@using TaskResourceBlueprints.Services
@using TaskResourceBlueprints.Services.Common
@inherits AppComponentBase
@inject IEntityService<LocationEntity> service
<div class="flex flex-col gap-1 rounded-[12px] border border-slate-200/80 bg-white/90 px-3 py-1 shadow-sm dark:border-slate-800 dark:bg-slate-950/90 lg:flex-row lg:items-center lg:justify-between">
    <div>
        <p class="mt-1 text-sm leading-6 text-slate-500 dark:text-slate-400">Manage location values used by task status and reporting.</p>
        </div>

        <div class="flex flex-wrap items-center gap-1">
            <button @onclick="UpdateForm"
                    class="inline-flex items-center rounded-xl bg-blue-600 px-1.5 py-1 text-sm font-medium text-white shadow-sm transition hover:bg-blue-700 dark:bg-blue-500 dark:hover:bg-blue-400"
                    title="@ResourceApp._new">
                <span class="mr-2">@((MarkupString)Icons.Plus)</span> New
            </button>
            <button @onclick="() => IsVisible = !IsVisible"
                    class="inline-flex items-center rounded-xl border border-slate-200 bg-white px-3.5 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
                    title="@ResourceApp.visible">
                <span class="mr-2">@((MarkupString)Icons.GetVisibleIcon(IsVisible))</span> @(IsVisible ? "Visible items" : "Hidden items")
            </button>
        </div>
    </div>

    @if (LocationsList?.Any(x => x.IsVisible == IsVisible) == true)
    {
        <div class="overflow-hidden rounded-[12px] border border-slate-200/80 bg-white/95 shadow-sm dark:border-slate-800 dark:bg-slate-950/95">
            <div class="overflow-x-auto p-1.5">
                <table class="min-w-full overflow-hidden rounded-[12px] border border-slate-200/80 dark:border-slate-800">
                    <thead class="bg-slate-100/80 dark:bg-slate-900/90">
                        <tr>
                            <th class="w-32 px-1.5 py-1 text-left text-sm font-semibold text-slate-700 dark:text-slate-200">Actions</th>
                            <th class="px-1.5 py-1 text-left text-sm font-semibold text-slate-700 dark:text-slate-200">@CalcResource.name</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200/80 bg-white dark:divide-slate-800 dark:bg-slate-950">
                        @foreach (var status in LocationsList.Where(x => x.IsVisible == IsVisible).OrderByDescending(x => x.SortOrder))
                        {
                            <tr class="align-top transition hover:bg-slate-50 dark:hover:bg-slate-900/40">
                                <td class="px-1.5 py-1">
                                    <div class="flex items-center gap-1">
                                        <button @onclick="() => UpdateForm(status)"
                                                class="inline-flex h-9 w-9 items-center justify-center rounded-xl border border-amber-200 bg-amber-50 text-amber-700 transition hover:bg-amber-100 dark:border-amber-900/60 dark:bg-amber-950/40 dark:text-amber-300">
                                            @Icons.Edit
                                        </button>
                                        <button @onclick="() => Remove(status)"
                                                class="inline-flex h-9 w-9 items-center justify-center rounded-xl border border-rose-200 bg-rose-50 text-rose-700 transition hover:bg-rose-100 dark:border-rose-900/60 dark:bg-rose-950/40 dark:text-rose-300">
                                            @Icons.Delete
                                        </button>
                                    </div>
                                </td>
                                <td class="px-1.5 py-1">
                                    <div class="font-medium text-slate-900 dark:text-slate-100">@status.Name</div>
                                    <div class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">Order: @status.SortOrder</div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="rounded-[12px] border border-dashed border-slate-200/80 bg-white/95 px-1.5 py-8 text-center text-sm text-slate-500 shadow-sm dark:border-slate-700 dark:bg-slate-950/95 dark:text-slate-400">
            @AppLoc[nameof(ResourceApp.ThereAreNoItemsToDisplay)]
        </div>
    }


@code {
    bool IsVisible = true;
    List<LocationEntity> LocationsList = [];
    void UpdateForm() => UpdateForm(new LocationEntity() { Name ="name" });
    void UpdateForm(LocationEntity model)
    {
        LocationEntity up = new();
        PropertyCopier.CopyPropertiesTo(model, up);

        Modal.ShowComponent<LocationFormUI>(model.Id == 0 ? AppLoc[LocalizerConst.New, CalcResource.projectCompensation] :
            AppLoc[LocalizerConst.Update, model.Name], new Dictionary<string, object>
            {
                [nameof(LocationFormUI.Model)] = up,
                [nameof(LocationFormUI.Callback)] = EventCallback.Factory.Create<bool>(this, BtnUpdate)
            }, DialogSize.Medium);
    }
    void Remove(LocationEntity model) =>
    MHD.DeleteMessage(model.Name, EventCallback.Factory.Create(this, () => ConfirmRemoveAsync(model)));

    async Task ConfirmRemoveAsync(LocationEntity model)
    {
        bool result = await ExHandlers.RunCheckTokenAsync(() => service.DeleteAsync(model.Id));
        if (result)
        {
            LocationsList.Remove(model);
        }
        MHD.Notifications(ToastType.Delete, result);

        StateHasChanged();
    }
    async Task BtnUpdate(bool IsSuccess)
    {
        Modal.Close();
        if (IsSuccess)
        {
            LocationsList = await service.GetAllAsync() ?? [];
        }
        StateHasChanged();
    }

    protected async override Task OnInitializedAsync()
    {
        LocationsList = await service.GetAllAsync() ?? [];
        StateHasChanged();
    }
}
