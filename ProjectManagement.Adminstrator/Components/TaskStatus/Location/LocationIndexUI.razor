@using BlazorMHD.UI.Components.Data.Table
@using ProjectManagement.Adminstrator.Constants
@using TaskResourceBlueprints.Entities
@using TaskResourceBlueprints.Entities.Lookups
@using TaskResourceBlueprints.Services
@using TaskResourceBlueprints.Services.Common
@inherits AppComponentBase
@inject IEntityService<LocationEntity> service

<div class="space-y-4">
    <div class="flex flex-wrap items-center gap-2">
        <div>
            <div class="text-xs text-slate-500 dark:text-slate-400">Lookup list</div>
            <h3 class="mt-2 text-xl font-semibold text-slate-100">Location</h3>
            <p class="mt-2 text-sm text-slate-400">Manage location values used by task status and reporting.</p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
            <span class="inline-flex items-center rounded-full border px-2.5 py-1 text-[11px] font-medium">@(IsVisible ?"Visible" :"Hidden")</span>
            <button @onclick="() => UpdateForm()" class="inline-flex items-center justify-center gap-2 rounded-xl border border-sky-600 bg-sky-600 px-3 py-2 text-xs font-medium text-white transition hover:bg-sky-700 focus:outline-none focus:ring-2 focus:ring-sky-500/30 disabled:cursor-not-allowed disabled:opacity-60 dark:border-sky-500 dark:bg-sky-500 dark:hover:bg-sky-400">@((MarkupString)Icons.Plus)<span class="ml-2">@ResourceApp._new</span></button>
            <button @onclick="() => IsVisible = !IsVisible" class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-medium text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-400/30 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800">@((MarkupString)Icons.GetVisibleIcon(IsVisible))<span class="ml-2">Toggle</span></button>
        </div>
    </div>

    @if (LocationsList.Any(x => x.IsVisible == IsVisible))
    {
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-950/80">
            <div class="overflow-x-auto p-4">
                <MhdTable TItem="LocationEntity" Items="LocationsList.Where(x => x.IsVisible == IsVisible).OrderByDescending(x => x.SortOrder)" ShowFilter="false">
                    <HeaderTemplate>
                        <th class="w-40 px-3 py-2 text-left text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Actions</th>
                        <th class="px-3 py-2 text-left text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Entry</th>
                    </HeaderTemplate>
                    <ChildContent>
                        <MhdTableColumn>
                            <Template Context="status">
                                <div class="flex items-center gap-2">
                                    <button @onclick="() => UpdateForm(status)" class="inline-flex h-9 w-9 items-center justify-center rounded-xl border border-slate-300 bg-white text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-400/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800">@((MarkupString)Icons.Edit)</button>
                                    <button @onclick="() => Remove(status)" class="inline-flex h-9 w-9 items-center justify-center rounded-xl border border-rose-200 bg-rose-50 text-rose-700 transition hover:bg-rose-100 focus:outline-none focus:ring-2 focus:ring-rose-500/20 dark:border-rose-900/60 dark:bg-rose-950/40 dark:text-rose-300 dark:hover:bg-rose-950/60">@((MarkupString)Icons.Delete)</button>
                                </div>
                            </Template>
                        </MhdTableColumn>
                        <MhdTableColumn>
                            <Template Context="status">
                                <div class="flex items-center justify-between gap-4">
                                    <div>
                                        <div class="font-medium text-slate-100">@status.Name</div>
                                        <div class="mt-1 text-xs text-slate-500">Order: @status.SortOrder</div>
                                    </div>
                                    <span class="inline-flex items-center rounded-full border px-2.5 py-1 text-[11px] font-medium">@(status.IsVisible ?"Visible" :"Hidden")</span>
                                </div>
                            </Template>
                        </MhdTableColumn>
                    </ChildContent>
                </MhdTable>
            </div>
        </div>
    }
    else
    {
        <div class="flex min-h-[180px] flex-col items-center justify-center rounded-2xl border border-dashed border-slate-300 bg-slate-50/70 px-4 py-8 text-center dark:border-slate-700 dark:bg-slate-900/40">
            <div class="text-sm font-semibold text-slate-900 dark:text-slate-100">There are no items to display</div>
            <div class="mt-1 max-w-xl text-sm text-slate-600 dark:text-slate-400">Create a new location or switch the visibility filter.</div>
        </div>
    }
</div>

@code {
    bool IsVisible = true;
    List<LocationEntity> LocationsList = [];
    void UpdateForm() => UpdateForm(new LocationEntity() { Name ="name" });
    void UpdateForm(LocationEntity model)
    {
        LocationEntity up = new();
        PropertyCopier.CopyPropertiesTo(model, up);

        Modal.ShowComponent<LocationFormUI>(model.Id == 0 ? AppLoc[LocalizerConst.New, CalcResource.projectCompensation] :
            AppLoc[LocalizerConst.Update, model.Name], new Dictionary<string, object>
            {
                [nameof(LocationFormUI.Model)] = up,
                [nameof(LocationFormUI.Callback)] = EventCallback.Factory.Create<bool>(this, BtnUpdate)
            }, DialogSize.Medium);
    }
    void Remove(LocationEntity model) =>
    MHD.DeleteMessage(model.Name, EventCallback.Factory.Create(this, () => ConfirmRemoveAsync(model)));

    async Task ConfirmRemoveAsync(LocationEntity model)
    {
        bool result = await ExHandlers.RunCheckTokenAsync(() => service.DeleteAsync(model.Id));
        if (result)
        {
            LocationsList.Remove(model);
        }
        MHD.Notifications(ToastType.Delete, result);

        StateHasChanged();
    }
    async Task BtnUpdate(bool IsSuccess)
    {
        Modal.Close();
        if (IsSuccess)
        {
            LocationsList = await service.GetAllAsync() ?? [];
        }
        StateHasChanged();
    }

    protected async override Task OnInitializedAsync()
    {
        LocationsList = await service.GetAllAsync() ?? [];
    }
}
