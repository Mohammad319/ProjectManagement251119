@using BlazorMHD.UI.Components.Data.Table
@using ProjectManagement.Adminstrator.Constants
@using TaskResourceBlueprints.Entities
@using TaskResourceBlueprints.Entities.Lookups
@using TaskResourceBlueprints.Services
@using TaskResourceBlueprints.Services.Common
@inherits AppComponentBase
@inject IEntityService<LocationEntity> service

<div class="space-y-4">
    <div class="pm-toolbar">
        <div>
            <div class="pm-table-meta">Lookup list</div>
            <h3 class="mt-2 text-xl font-semibold text-slate-100">Location</h3>
            <p class="mt-2 text-sm text-slate-400">Manage location values used by task status and reporting.</p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
            <span class="pm-pill">@(IsVisible ? "Visible" : "Hidden")</span>
            <button @onclick="() => UpdateForm()" class="pm-btn-primary">@((MarkupString)Icons.Plus)<span class="ml-2">@ResourceApp._new</span></button>
            <button @onclick="() => IsVisible = !IsVisible" class="pm-btn-secondary">@((MarkupString)Icons.GetVisibleIcon(IsVisible))<span class="ml-2">Toggle</span></button>
        </div>
    </div>

    @if (LocationsList.Any(x => x.IsVisible == IsVisible))
    {
        <div class="pm-table-shell">
            <div class="overflow-x-auto p-5">
                <MhdTable TItem="LocationEntity" Items="LocationsList.Where(x => x.IsVisible == IsVisible).OrderByDescending(x => x.SortOrder)" ShowFilter="false">
                    <HeaderTemplate>
                        <th class="w-40 px-4 py-3 text-left text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Actions</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Entry</th>
                    </HeaderTemplate>
                    <ChildContent>
                        <MhdTableColumn>
                            <Template Context="status">
                                <div class="flex items-center gap-2">
                                    <button @onclick="() => UpdateForm(status)" class="pm-btn-icon">@((MarkupString)Icons.Edit)</button>
                                    <button @onclick="() => Remove(status)" class="pm-btn-icon-danger">@((MarkupString)Icons.Delete)</button>
                                </div>
                            </Template>
                        </MhdTableColumn>
                        <MhdTableColumn>
                            <Template Context="status">
                                <div class="flex items-center justify-between gap-4">
                                    <div>
                                        <div class="font-medium text-slate-100">@status.Name</div>
                                        <div class="mt-1 text-xs text-slate-500">Order: @status.SortOrder</div>
                                    </div>
                                    <span class="pm-pill">@(status.IsVisible ? "Visible" : "Hidden")</span>
                                </div>
                            </Template>
                        </MhdTableColumn>
                    </ChildContent>
                </MhdTable>
            </div>
        </div>
    }
    else
    {
        <div class="pm-empty">
            <div class="pm-empty-title">There are no items to display</div>
            <div class="pm-empty-text">Create a new location or switch the visibility filter.</div>
        </div>
    }
</div>

@code {
    bool IsVisible = true;
    List<LocationEntity> LocationsList = [];
    void UpdateForm() => UpdateForm(new LocationEntity() { Name = "name" });
    void UpdateForm(LocationEntity model)
    {
        LocationEntity up = new();
        PropertyCopier.CopyPropertiesTo(model, up);

        Modal.ShowComponent<LocationFormUI>(model.Id == 0 ? AppLoc[LocalizerConst.New, CalcResource.projectCompensation] :
            AppLoc[LocalizerConst.Update, model.Name], new Dictionary<string, object>
            {
                [nameof(LocationFormUI.Model)] = up,
                [nameof(LocationFormUI.Callback)] = EventCallback.Factory.Create<bool>(this, BtnUpdate)
            }, DialogSize.Medium);
    }
    void Remove(LocationEntity model) =>
    MHD.DeleteMessage(model.Name, EventCallback.Factory.Create(this, () => ConfirmRemoveAsync(model)));

    async Task ConfirmRemoveAsync(LocationEntity model)
    {
        bool result = await ExHandlers.RunCheckTokenAsync(() => service.DeleteAsync(model.Id));
        if (result)
        {
            LocationsList.Remove(model);
        }
        MHD.Notifications(ToastType.Delete, result);

        StateHasChanged();
    }
    async Task BtnUpdate(bool IsSuccess)
    {
        Modal.Close();
        if (IsSuccess)
        {
            LocationsList = await service.GetAllAsync() ?? [];
        }
        StateHasChanged();
    }

    protected async override Task OnInitializedAsync()
    {
        LocationsList = await service.GetAllAsync() ?? [];
    }
}
