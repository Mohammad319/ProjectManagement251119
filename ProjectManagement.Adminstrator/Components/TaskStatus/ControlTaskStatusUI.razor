@using ProjectManagement.Adminstrator.Components.TaskStatus.ActionTask
@using ProjectManagement.Adminstrator.Components.TaskStatus.ActionType
@using ProjectManagement.Adminstrator.Components.TaskStatus.Fall
@using ProjectManagement.Adminstrator.Components.TaskStatus.Location
@inherits AppComponentBase

<div class="space-y-4">
    <div class="rounded-[22px] border border-slate-200/80 bg-white/90 p-4 shadow-sm dark:border-slate-800 dark:bg-slate-950/90">
        <h2 class="text-[1.9rem] font-semibold tracking-tight text-slate-900 dark:text-slate-100">Task status</h2>
        <p class="mt-2 text-sm leading-6 text-slate-500 dark:text-slate-400">Manage lookup lists for actions, locations, falls, and action types.</p>

        <div class="mt-4 flex flex-wrap gap-2.5" role="tablist" aria-label="Task Status Tabs">
            @for (int i = 1; i <= 4; i++)
            {
                int u = i;
                <button class="@GetTabClass(u)" @onclick="() => page = u">@GetTabLabel(i)</button>
            }
        </div>
    </div>

    <div class="rounded-[22px] border border-slate-200/80 bg-white/95 p-4 shadow-sm dark:border-slate-800 dark:bg-slate-950/95">
        @switch (page)
        {
            case 1:
                <ActionIndexUI />
                break;
            case 2:
                <LocationIndexUI />
                break;
            case 3:
                <FallIndexUI />
                break;
            case 4:
                <ActionTypeIndexUI />
                break;
        }
    </div>
</div>

@code {
    private int page = 1;

    private string GetTabClass(int tabIndex)
    {
        return page == tabIndex
            ? "inline-flex items-center rounded-xl bg-blue-600 px-4 py-2.5 text-sm font-medium text-white shadow-sm transition hover:bg-blue-700 dark:bg-blue-500 dark:hover:bg-blue-400"
            : "inline-flex items-center rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800";
    }

    private string GetTabLabel(int index) => index switch
    {
        1 => "Action",
        2 => "Location",
        3 => "Fall",
        4 => "Action Type",
        _ => string.Empty
    };
}
