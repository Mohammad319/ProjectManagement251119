
@using ProjectManagement.Adminstrator.Components.TaskStatus.StateGroup
@attribute [Authorize(Roles = PMRolesConst.APP.AdminManger)]
@inherits AppComponentBase

<div class="">

    <div class="rounded-[14px] border border-slate-200/80 bg-white/95 p-1 shadow-sm dark:border-slate-800 dark:bg-slate-950/95">
        <StateGroupIndexUI />
    </div>
</div>

@code {
    private int page = 1;

    private string GetTabClass(int tabIndex)
    {
        return page == tabIndex
            ? "inline-flex items-center rounded-xl bg-blue-600 px-3.5 py-2 text-sm font-medium text-white shadow-sm transition hover:bg-blue-700 dark:bg-blue-500 dark:hover:bg-blue-400"
            : "inline-flex items-center rounded-xl border border-slate-200 bg-white px-3.5 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800";
    }

    private string GetTabLabel(int index) => index switch
    {
        5 => "State Groups",
        _ => string.Empty
    };
}
