@using ProjectManagement.Adminstrator.Components.TaskStatus.ActionTask
@using ProjectManagement.Adminstrator.Components.TaskStatus.ActionType
@using ProjectManagement.Adminstrator.Components.TaskStatus.Fall
@using ProjectManagement.Adminstrator.Components.TaskStatus.Location
@inherits AppComponentBase

<div class="pm-page">
    <div class="pm-card">
        <div class="pm-card-header">
            <div>
                <h2 class="pm-title">Task status</h2>
                <p class="pm-subtitle">Manage lookup lists for actions, locations, falls, and action types.</p>
            </div>
        </div>

        <div class="mt-4 flex flex-wrap gap-2" role="tablist" aria-label="Task Status Tabs">
            @for (int i = 1; i <= 4; i++)
            {
                int u = i;
                <button class="@GetTabClass(u)" @onclick="() => page = u">@GetTabLabel(i)</button>
            }
        </div>
    </div>

    <div class="pm-card">
        @switch (page)
        {
            case 1:
                <ActionIndexUI />
                break;
            case 2:
                <LocationIndexUI />
                break;
            case 3:
                <FallIndexUI />
                break;
            case 4:
                <ActionTypeIndexUI />
                break;
        }
    </div>
</div>

@code {
    private int page = 1;

    private string GetTabClass(int tabIndex)
        => page == tabIndex ? "pm-tab pm-tab-active" : "pm-tab";

    private string GetTabLabel(int index) => index switch
    {
        1 => "Action",
        2 => "Location",
        3 => "Fall",
        4 => "Action Type",
        _ => string.Empty
    };
}
