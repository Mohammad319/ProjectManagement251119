@using System.Linq
@using TaskResourceBlueprints.Entities
@inherits AppComponentBase
@using TaskResourceBlueprints.Services.UnitGroups
@using ProjectManagement.Shared.Helper.ProjectAppStorage

@inject ITaskUnitGroupService UnitGroupsService

<div class="space-y-3">
    <div>
        <h3 class="text-lg font-semibold tracking-tight text-slate-900 dark:text-slate-100">Unit group</h3>
        <p class="mt-1 text-sm leading-6 text-slate-500 dark:text-slate-400">Build reusable conversion groups by selecting source units that map to one target unit.</p>
    </div>

    <div class="grid gap-3.5 md:grid-cols-[minmax(0,1fr)_18rem]">
        <div>
            <label class="mb-2 block text-sm font-medium text-slate-700 dark:text-slate-200" for="group-name">@CalcResource.name</label>
            <input id="group-name"
                   class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
                   @bind="_model.DisplayName"
                   placeholder="Group 1" />
        </div>

        <div>
            <label class="mb-2 block text-sm font-medium text-slate-700 dark:text-slate-200" for="to-unit">Convert to</label>
            <select id="to-unit"
                    class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
                    @bind="_toUnit"
                    @bind:after="OnTargetChanged">
                @foreach (var t in _allTargets)
                {
                    <option value="@t">@t</option>
                }
            </select>
        </div>
    </div>

    <div class="rounded-[14px] border border-slate-200/80 bg-white/80 p-3.5 dark:border-slate-800 dark:bg-slate-950/60">
        <div class="mb-4 flex flex-wrap items-start justify-between gap-3">
            <div>
                <h4 class="text-sm font-semibold text-slate-900 dark:text-slate-100">Available units</h4>
                <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Choose which source units should belong to this group.</p>
            </div>
            <div class="text-sm font-medium text-slate-500 dark:text-slate-400">Target: <span class="text-slate-900 dark:text-slate-100">@_toUnit</span></div>
        </div>

        <div class="grid grid-cols-2 gap-3 md:grid-cols-3 xl:grid-cols-4">
            @foreach (var u in _fromUnits)
            {
                var selected = HasKey(u);

                <button type="button"
                        class="flex items-center justify-between rounded-xl border px-3.5 py-2 text-left transition @(selected
                            ? "border-blue-200 bg-blue-50 text-blue-700 dark:border-blue-900/70 dark:bg-blue-950/40 dark:text-blue-200"
                            : "border-slate-200 bg-white text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800")"
                        disabled="@_isSaving"
                        @onclick="() => Toggle(u)">
                    <span class="text-sm font-medium">@u</span>
                    <span class="text-lg leading-none">@(selected ? "×" : "+")</span>
                </button>
            }
        </div>
    </div>

    <div class="rounded-[14px] border border-slate-200/80 bg-white/80 p-3.5 dark:border-slate-800 dark:bg-slate-950/60">
        <h4 class="text-sm font-semibold text-slate-900 dark:text-slate-100">Selected keys</h4>
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">These keys will be saved with the unit group.</p>

        @if (_model.Keys.Count == 0)
        {
            <div class="mt-3 text-sm text-slate-500 dark:text-slate-400">There are no specific keys yet.</div>
        }
        else
        {
            <div class="mt-3 flex flex-wrap gap-2">
                @foreach (var k in _model.Keys)
                {
                    <span class="inline-flex items-center rounded-full border border-blue-200 bg-blue-50 px-3 py-1.5 text-xs font-medium text-blue-800 dark:border-blue-900/70 dark:bg-blue-950/40 dark:text-blue-200">
                        @k
                        <button class="ms-2 rounded-full px-1 transition hover:bg-blue-200 dark:hover:bg-blue-800/60"
                                title="Removal"
                                disabled="@_isSaving"
                                @onclick="() => RemoveKey(k)">
                            ×
                        </button>
                    </span>
                }
            </div>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="text-sm text-red-600 dark:text-red-400">
            @_error
        </div>
    }

    <div class="flex items-center justify-end gap-3 border-t border-slate-200 pt-4 dark:border-slate-800">
        <button type="button"
                class="rounded-xl bg-blue-600 px-3.5 py-2 text-sm font-medium text-white shadow-sm transition hover:bg-blue-700 disabled:cursor-not-allowed disabled:opacity-50 dark:bg-blue-500 dark:hover:bg-blue-400"
                disabled="@_isSaving"
                @onclick="SaveAsync">
            @ResourceApp.save
        </button>

        <button type="button"
                disabled="@_isSaving"
                @onclick="Close"
                class="rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800">
            @ResourceApp.cancel
        </button>
    </div>
</div>

@code {
    [Parameter] public EventCallback<bool> Callback { get; set; }
    [Parameter] public int? GroupId { get; set; }

    private TaskUnitGroup _model = new();
    private string _toUnit = "m3";
    private bool _isSaving;
    private string? _error;

    private readonly List<string> _allTargets = UnitRulesCatalog.Rules.Values
        .Select(r => r.ToUnit)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(s => s)
        .ToList();

    private IEnumerable<string> _fromUnits => UnitRulesCatalog.Rules.Values
        .Where(r => string.Equals(r.ToUnit, _toUnit, StringComparison.OrdinalIgnoreCase))
        .Select(r => r.FromUnit)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(s => s);

    protected override async Task OnInitializedAsync()
    {
        if (GroupId is int id)
        {
            var group = await UnitGroupsService.GetByIdAsync(id);
            if (group is not null)
            {
                _model = group;
            }
        }

        _model.Keys ??= new List<string>();

        if (!_allTargets.Contains(_toUnit, StringComparer.OrdinalIgnoreCase))
            _toUnit = _allTargets.FirstOrDefault() ?? "m3";
    }

    private void Close() => MHD.Modal.Close();
    private void OnTargetChanged() => StateHasChanged();

    private void Toggle(string fromUnit)
    {
        var key = UnitRulesCatalog.BuildKey(fromUnit);
        var idx = _model.Keys.FindIndex(k => string.Equals(k, key, StringComparison.OrdinalIgnoreCase));

        if (idx >= 0)
            _model.Keys.RemoveAt(idx);
        else
            _model.Keys.Add(key);
    }

    private bool HasKey(string fromUnit)
    {
        var key = UnitRulesCatalog.BuildKey(fromUnit);
        return _model.Keys.Any(k => string.Equals(k, key, StringComparison.OrdinalIgnoreCase));
    }

    private void RemoveKey(string key)
    {
        _model.Keys.RemoveAll(k => string.Equals(k, key, StringComparison.OrdinalIgnoreCase));
    }

    private async Task SaveAsync()
    {
        if (_isSaving)
            return;

        _isSaving = true;
        _error = null;

        try
        {
            if (string.IsNullOrWhiteSpace(_model.DisplayName))
                throw new ArgumentException("Name is required.");

            if (_model.Id == 0)
                await UnitGroupsService.AddAsync(_model);
            else
                await UnitGroupsService.UpdateAsync(_model);

            await Callback.InvokeAsync(true);
            Close();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            MHD.MessageOk("Error", ex.Message, MhdState.Danger);
        }
        finally
        {
            _isSaving = false;
        }
    }
}
