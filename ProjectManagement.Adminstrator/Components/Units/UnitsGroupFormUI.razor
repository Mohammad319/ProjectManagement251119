@using System.Globalization
@using System.Linq
@using TaskResourceBlueprints.Entities
@inherits AppComponentBase
@using TaskResourceBlueprints.Services.UnitGroups
@using ProjectManagement.Shared.Helper.ProjectAppStorage

@inject ITaskUnitGroupService UnitGroupsService

<div class="space-y-6 p-1">

    <!-- Form row -->
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
        <div>
            <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200" for="group-name">@CalcResource.name</label>
            <input id="group-name"
                   class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
                   @bind="_model.DisplayName"
                   placeholder="Group 1" />
        </div>

        <div>
            <label class="mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200" for="to-unit">Convert to</label>
            <select id="to-unit"
                    class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
                    @bind="_toUnit"
                    @bind:after="OnTargetChanged">
                @foreach (var t in _allTargets)
                {
                    <option value="@t">@t</option>
                }
            </select>
        </div>
    </div>

    <!-- From units -->
    <div class="mt-4">
        <div class="mb-2 flex items-center">
            <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">
                Available units
            </h3>
        </div>

        <div class="grid grid-cols-1 gap-3 md:grid-cols-3">
            @foreach (var u in _fromUnits)
            {
                var selected = HasKey(u);

                <div class="mb-1 flex items-center justify-between rounded-lg border border-gray-200 bg-gray-50 px-3 py-2 dark:border-gray-700 dark:bg-gray-900/60">
                    <span class="text-sm text-slate-700 dark:text-slate-300">@u</span>

                    @if (!selected)
                    {
                        <button class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-green-300 text-green-700 transition hover:bg-green-100 disabled:cursor-not-allowed disabled:opacity-50 dark:border-green-700 dark:text-green-300 dark:hover:bg-green-900/30"
                                disabled="@_isSaving"
                                @onclick="() => Toggle(u)">
                            @((MarkupString)Icons.Plus)
                        </button>
                    }
                    else
                    {
                        <button class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-red-300 text-red-700 transition hover:bg-red-100 disabled:cursor-not-allowed disabled:opacity-50 dark:border-red-700 dark:text-red-300 dark:hover:bg-red-900/30"
                                disabled="@_isSaving"
                                @onclick="() => Toggle(u)">
                            @Icons.Delete
                        </button>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Selected keys -->
    <div class="mt-4">
        <h3 class="mb-1 text-sm font-semibold text-slate-900 dark:text-slate-100">Selected pairs (Keys)</h3>

        @if (_model.Keys.Count == 0)
        {
            <div class="text-xs text-slate-500 dark:text-slate-400">There are no specific keys yet.</div>
        }
        else
        {
            <div class="flex flex-wrap">
                @foreach (var k in _model.Keys)
                {
                    <span class="mb-1 me-1 inline-flex items-center rounded-full bg-blue-100 px-2 py-1 text-xs font-medium text-blue-800 dark:bg-blue-900/40 dark:text-blue-200">
                        @k
                        <button class="ms-1 rounded-full px-1 transition hover:bg-blue-200 dark:hover:bg-blue-800/60"
                                title="Removal"
                                disabled="@_isSaving"
                                @onclick="() => RemoveKey(k)">
                            ×
                        </button>
                    </span>
                }
            </div>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="mt-2 text-sm text-red-600 dark:text-red-400">
            @_error
        </div>
    }

    <div class="mt-6 flex items-center justify-end gap-2 border-t border-slate-200 pt-4 dark:border-slate-700">
        <button type="button"
                class="rounded-lg border border-green-300 px-3 py-1.5 text-sm font-medium text-green-700 transition hover:bg-green-100 disabled:cursor-not-allowed disabled:opacity-50 dark:border-green-700 dark:text-green-300 dark:hover:bg-green-900/30"
                disabled="@_isSaving"
                @onclick="SaveAsync">
            @ResourceApp.save
        </button>

        <button type="button"
                disabled="@_isSaving"
                @onclick="Close"
                class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-700 transition hover:bg-slate-100 disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-600 dark:text-slate-300 dark:hover:bg-slate-800">
            @ResourceApp.cancel
        </button>
    </div>
</div>

@code {
    [Parameter] public EventCallback<bool> Callback { get; set; }

    /// <summary>
    /// إن مررت Id سنحمّل المجموعة للتحرير، وإلا فسيتم إنشاء مجموعة جديدة.
    /// </summary>
    [Parameter] public int? GroupId { get; set; }

    private TaskUnitGroup _model = new();
    private string _toUnit = "m3";
    private bool _isSaving;
    private string? _error;

    // كل الوحدات الهدف المتوفرة في الكتالوج
    private readonly List<string> _allTargets = UnitRulesCatalog.Rules.Values
        .Select(r => r.ToUnit)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(s => s)
        .ToList();

    private IEnumerable<string> _fromUnits => UnitRulesCatalog.Rules.Values
        .Where(r => string.Equals(r.ToUnit, _toUnit, StringComparison.OrdinalIgnoreCase))
        .Select(r => r.FromUnit)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(s => s);

    protected override async Task OnInitializedAsync()
    {
        // لو عندنا GroupId نحمّل المجموعة من الخدمة
        if (GroupId is int id)
        {
            var group = await UnitGroupsService.GetByIdAsync(id);
            if (group is not null)
            {
                _model = group;
            }
        }

        // تأكد دائماً أن Keys ليست null
        _model.Keys ??= new List<string>();

        // تأكد أن وحدة الهدف المختارة موجودة في القائمة
        if (!_allTargets.Contains(_toUnit, StringComparer.OrdinalIgnoreCase))
            _toUnit = _allTargets.FirstOrDefault() ?? "m3";
    }

    private void Close()
    {
        MHD.Modal.Close();
    }

    private void OnTargetChanged()
    {
        // لا نُفرغ المفاتيح؛ لأن المجموعة قد تحتوي أزواجًا لهدف آخر
        StateHasChanged();
    }

    private void Toggle(string fromUnit)
    {
        var key = UnitRulesCatalog.BuildKey(fromUnit);
        var idx = _model.Keys.FindIndex(k =>
            string.Equals(k, key, StringComparison.OrdinalIgnoreCase));

        if (idx >= 0)
            _model.Keys.RemoveAt(idx);
        else
            _model.Keys.Add(key);
    }

    private bool HasKey(string fromUnit)
    {
        var key = UnitRulesCatalog.BuildKey(fromUnit);
        return _model.Keys.Any(k => string.Equals(k, key, StringComparison.OrdinalIgnoreCase));
    }

    private void RemoveKey(string key)
    {
        _model.Keys.RemoveAll(k => string.Equals(k, key, StringComparison.OrdinalIgnoreCase));
    }

    private async Task SaveAsync()
    {
        if (_isSaving)
            return;

        _isSaving = true;
        _error = null;

        try
        {
            if (string.IsNullOrWhiteSpace(_model.DisplayName))
                throw new ArgumentException("Name is required.");

            if (_model.Id == 0)
                await UnitGroupsService.AddAsync(_model);
            else
                await UnitGroupsService.UpdateAsync(_model);


            // نبلغ الأب بنجاح الحفظ (مثلاً لتحديث القائمة)
            await Callback.InvokeAsync(true);

            // إغلاق المودال بعد نجاح العملية
            Close();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            MHD.MessageOk("Error", ex.Message, MhdState.Danger);
        }
        finally
        {
            _isSaving = false;
        }
    }
}
