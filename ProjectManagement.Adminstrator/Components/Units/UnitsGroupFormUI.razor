@using System.Globalization
@using System.Linq
@using TaskResourceBlueprints.Entities
@inherits AppComponentBase
@using TaskResourceBlueprints.Services.UnitGroups
@using ProjectManagement.Shared.Helper.ProjectAppStorage

@inject ITaskUnitGroupService UnitGroupsService

<div class="pm-form-shell">
    <section class="pm-form-section">
        <div>
            <h3 class="pm-form-section-title">Unit group</h3>
            <p class="pm-form-section-text">Build reusable conversion groups by selecting source units that map to one target unit.</p>
        </div>

        <div class="pm-form-grid-2">
            <div class="pm-field">
                <label class="pm-label" for="group-name">@CalcResource.name</label>
                <input id="group-name"
                       class="pm-input"
                       @bind="_model.DisplayName"
                       placeholder="Group 1" />
            </div>

            <div class="pm-field">
                <label class="pm-label" for="to-unit">Convert to</label>
                <select id="to-unit"
                        class="pm-select"
                        @bind="_toUnit"
                        @bind:after="OnTargetChanged">
                    @foreach (var t in _allTargets)
                    {
                        <option value="@t">@t</option>
                    }
                </select>
            </div>
        </div>
    </section>

    <section class="pm-form-section">
        <div class="flex items-center justify-between gap-3">
            <div>
                <h3 class="pm-form-section-title">Available units</h3>
                <p class="pm-form-section-text">Choose which source units should belong to this group.</p>
            </div>
            <span class="pm-badge">Target: @_toUnit</span>
        </div>

        <div class="mt-4 grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-3">
            @foreach (var u in _fromUnits)
            {
                var selected = HasKey(u);

                <div class="pm-selectable-card @(selected ? "ring-2 ring-blue-500/15 dark:ring-blue-400/20" : string.Empty)">
                    <span class="text-sm text-slate-700 dark:text-slate-300">@u</span>

                    @if (!selected)
                    {
                        <button class="pm-icon-btn border-green-300 text-green-700 hover:bg-green-50 dark:border-green-700 dark:text-green-300 dark:hover:bg-green-900/30"
                                disabled="@_isSaving"
                                @onclick="() => Toggle(u)">
                            @((MarkupString)Icons.Plus)
                        </button>
                    }
                    else
                    {
                        <button class="pm-icon-btn border-rose-300 text-rose-700 hover:bg-rose-50 dark:border-rose-700 dark:text-rose-300 dark:hover:bg-rose-950/30"
                                disabled="@_isSaving"
                                @onclick="() => Toggle(u)">
                            @Icons.Delete
                        </button>
                    }
                </div>
            }
        </div>
    </section>

    <section class="pm-form-section">
        <div>
            <h3 class="pm-form-section-title">Selected keys</h3>
            <p class="pm-form-section-text">These keys will be saved with the unit group.</p>
        </div>

        @if (_model.Keys.Count == 0)
        {
            <div class="pm-empty mt-4">There are no specific keys yet.</div>
        }
        else
        {
            <div class="mt-4 flex flex-wrap gap-2">
                @foreach (var k in _model.Keys)
                {
                    <span class="pm-badge">
                        @k
                        <button class="ms-2 rounded-full px-1 transition hover:bg-blue-200 dark:hover:bg-blue-800/60"
                                title="Removal"
                                disabled="@_isSaving"
                                @onclick="() => RemoveKey(k)">
                            ×
                        </button>
                    </span>
                }
            </div>
        }
    </section>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="pm-validation-summary">
            @_error
        </div>
    }

    <div class="pm-toolbar">
        <button type="button"
                class="pm-btn-success"
                disabled="@_isSaving"
                @onclick="SaveAsync">
            @ResourceApp.save
        </button>

        <button type="button"
                disabled="@_isSaving"
                @onclick="Close"
                class="pm-btn-secondary">
            @ResourceApp.cancel
        </button>
    </div>
</div>

@code {
    [Parameter] public EventCallback<bool> Callback { get; set; }

    /// <summary>
    /// إن مررت Id سنحمّل المجموعة للتحرير، وإلا فسيتم إنشاء مجموعة جديدة.
    /// </summary>
    [Parameter] public int? GroupId { get; set; }

    private TaskUnitGroup _model = new();
    private string _toUnit = "m3";
    private bool _isSaving;
    private string? _error;

    // كل الوحدات الهدف المتوفرة في الكتالوج
    private readonly List<string> _allTargets = UnitRulesCatalog.Rules.Values
        .Select(r => r.ToUnit)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(s => s)
        .ToList();

    private IEnumerable<string> _fromUnits => UnitRulesCatalog.Rules.Values
        .Where(r => string.Equals(r.ToUnit, _toUnit, StringComparison.OrdinalIgnoreCase))
        .Select(r => r.FromUnit)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(s => s);

    protected override async Task OnInitializedAsync()
    {
        // لو عندنا GroupId نحمّل المجموعة من الخدمة
        if (GroupId is int id)
        {
            var group = await UnitGroupsService.GetByIdAsync(id);
            if (group is not null)
            {
                _model = group;
            }
        }

        // تأكد دائماً أن Keys ليست null
        _model.Keys ??= new List<string>();

        // تأكد أن وحدة الهدف المختارة موجودة في القائمة
        if (!_allTargets.Contains(_toUnit, StringComparer.OrdinalIgnoreCase))
            _toUnit = _allTargets.FirstOrDefault() ?? "m3";
    }

    private void Close()
    {
        MHD.Modal.Close();
    }

    private void OnTargetChanged()
    {
        // لا نُفرغ المفاتيح؛ لأن المجموعة قد تحتوي أزواجًا لهدف آخر
        StateHasChanged();
    }

    private void Toggle(string fromUnit)
    {
        var key = UnitRulesCatalog.BuildKey(fromUnit);
        var idx = _model.Keys.FindIndex(k =>
            string.Equals(k, key, StringComparison.OrdinalIgnoreCase));

        if (idx >= 0)
            _model.Keys.RemoveAt(idx);
        else
            _model.Keys.Add(key);
    }

    private bool HasKey(string fromUnit)
    {
        var key = UnitRulesCatalog.BuildKey(fromUnit);
        return _model.Keys.Any(k => string.Equals(k, key, StringComparison.OrdinalIgnoreCase));
    }

    private void RemoveKey(string key)
    {
        _model.Keys.RemoveAll(k => string.Equals(k, key, StringComparison.OrdinalIgnoreCase));
    }

    private async Task SaveAsync()
    {
        if (_isSaving)
            return;

        _isSaving = true;
        _error = null;

        try
        {
            if (string.IsNullOrWhiteSpace(_model.DisplayName))
                throw new ArgumentException("Name is required.");

            if (_model.Id == 0)
                await UnitGroupsService.AddAsync(_model);
            else
                await UnitGroupsService.UpdateAsync(_model);


            // نبلغ الأب بنجاح الحفظ (مثلاً لتحديث القائمة)
            await Callback.InvokeAsync(true);

            // إغلاق المودال بعد نجاح العملية
            Close();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            MHD.MessageOk("Error", ex.Message, MhdState.Danger);
        }
        finally
        {
            _isSaving = false;
        }
    }
}
