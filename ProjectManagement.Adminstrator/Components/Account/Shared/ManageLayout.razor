@inherits LayoutComponentBase
@layout ProjectManagement.Adminstrator.Components.Layout.MainLayout

<div class="pm-page-shell">
    <div class="pm-manage-shell">
        <header class="pm-page-header">
            <h1 class="pm-page-title">Manage your account</h1>
            <p class="pm-page-subtitle">
                Update profile information, password, security settings, passkeys, and personal data from one place.
            </p>
        </header>

        <div class="pm-manage-grid">
            <aside class="pm-manage-sidebar">
                <ManageNavMenu />
            </aside>

            <section class="pm-manage-content">
                @Body
            </section>
        </div>
    </div>
</div>
