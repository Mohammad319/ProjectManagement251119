@page "/Account/ResetPasswordConfirmation"

<PageTitle>Reset password confirmation</PageTitle>

<main class="pm-auth-shell">
    <section class="pm-state-card">
        <div class="pm-state-icon pm-state-icon-success">✓</div>
        <h1 class="pm-state-title">Password updated</h1>
        <p class="pm-state-text">
            Your password has been reset successfully. You can now sign in with your new password.
        </p>
        <div class="pm-state-actions">
            <a href="Account/Login" class="pm-btn pm-btn-primary">Go to login</a>
        </div>
    </section>
</main>
