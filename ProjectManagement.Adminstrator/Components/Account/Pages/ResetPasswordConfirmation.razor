@page "/Account/ResetPasswordConfirmation"
<PageTitle>Reset password confirmation</PageTitle>

<h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mt-3">
    Reset password confirmation
</h1>

<p role="alert" class="mt-2 text-gray-700 dark:text-gray-300">
    Your password has been reset. Please
    <a href="Account/Login"
       class="text-blue-700 underline underline-offset-2 hover:no-underline dark:text-blue-400">
        click here to log in
    </a>.
</p>