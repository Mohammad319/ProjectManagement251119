@page "/Account/InvalidPasswordReset"

<PageTitle>Invalid password reset</PageTitle>

<main class="pm-auth-shell">
    <section class="pm-state-card">
        <div class="pm-state-icon pm-state-icon-warning">!</div>
        <h1 class="pm-state-title">Invalid password reset link</h1>
        <p class="pm-state-text">
            The password reset link is invalid or has expired. Request a new reset link to continue.
        </p>
        <div class="pm-state-actions">
            <a href="Account/ForgotPassword" class="pm-btn pm-btn-primary">Request a new link</a>
        </div>
    </section>
</main>
