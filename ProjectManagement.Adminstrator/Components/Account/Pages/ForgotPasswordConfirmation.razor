@page "/Account/ForgotPasswordConfirmation"

<PageTitle>Forgot password confirmation</PageTitle>

<main class="pm-auth-shell">
    <section class="pm-state-card">
        <div class="pm-state-icon pm-state-icon-success">✓</div>
        <h1 class="pm-state-title">Check your email</h1>
        <p class="pm-state-text">
            If an account exists for that email address, a password reset link has been sent.
        </p>
        <div class="pm-state-actions">
            <a href="Account/Login" class="pm-btn pm-btn-primary">Back to login</a>
        </div>
    </section>
</main>
