@page "/Account/AccessDenied"

<PageTitle>Access denied</PageTitle>

<main class="pm-auth-shell">
    <section class="pm-state-card">
        <div class="pm-state-icon pm-state-icon-danger">!</div>
        <h1 class="pm-state-title">Access denied</h1>
        <p class="pm-state-text">
            You do not have permission to access this resource.
        </p>
        <div class="pm-state-actions">
            <a href="/" class="pm-btn pm-btn-secondary">Back to dashboard</a>
        </div>
    </section>
</main>
