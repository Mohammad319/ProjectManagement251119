@page "/Account/Lockout"

<PageTitle>Locked out</PageTitle>

<main class="pm-auth-shell">
    <section class="pm-state-card">
        <div class="pm-state-icon pm-state-icon-danger">!</div>
        <h1 class="pm-state-title">Account locked</h1>
        <p class="pm-state-text">
            This account has been temporarily locked. Please try again later or contact support.
        </p>
        <div class="pm-state-actions">
            <a href="Account/Login" class="pm-btn pm-btn-secondary">Back to login</a>
        </div>
    </section>
</main>
