@using ProjectManagement.Adminstrator.Components.Account.Pages.Manage
@using ProjectManagement.Adminstrator.Shared.Culture
@using ProjectManagement.Adminstrator.Shared.Legal
@inherits AppComponentBase

<div class="grid min-h-0 gap-4 lg:grid-cols-[16rem_minmax(0,1fr)]">
    <aside class="pm-card overflow-hidden">
        <div class="pm-card-header">
            <div>
                <div class="pm-eyebrow">Settings</div>
                <div class="pm-card-title mt-1">Preferences</div>
                <p class="pm-card-subtitle">Profile, localization, legal details, and account controls.</p>
            </div>
        </div>

        <nav class="p-3" aria-label="Settings menu">
            <ul class="space-y-1">
                <li>
                    <button type="button" class="@GetItemClass(PageSetting.ChangePassword)" @onclick="() => SelectedPage = PageSetting.ChangePassword">@ResourceIdentity.changePassword</button>
                </li>
                <li>
                    <button type="button" class="@GetItemClass(PageSetting.Language)" @onclick="() => SelectedPage = PageSetting.Language">@ResourceApp.language</button>
                </li>
                <li>
                    <button type="button" class="@GetItemClass(PageSetting.Impressum)" @onclick="() => SelectedPage = PageSetting.Impressum">Impressum</button>
                </li>
                <li>
                    <button type="button" class="@GetItemClass(PageSetting.Privacy)" @onclick="() => SelectedPage = PageSetting.Privacy">@AppControll.TabPrivacy</button>
                </li>
                <li>
                    <button type="button" class="@GetItemClass(PageSetting.Terms)" @onclick="() => SelectedPage = PageSetting.Terms">@AppControll.TabTerms</button>
                </li>
                <li>
                    <button type="button" class="@GetItemClass(PageSetting.Licenses)" @onclick="() => SelectedPage = PageSetting.Licenses">@AppControll.TabLicenses</button>
                </li>
            </ul>
        </nav>
    </aside>

    <section class="pm-card min-w-0 overflow-hidden">
        <div class="pm-card-body min-h-[32rem] overflow-auto">
            @if (SelectedPage == PageSetting.ChangePassword)
            {
                <div class="pm-page-header">
                    <div class="pm-eyebrow">Security</div>
                    <h2 class="pm-title">@ResourceIdentity.changePassword</h2>
                    <p class="pm-subtitle">Update your password to keep the administrator account protected.</p>
                </div>

                <ChangePassword />
            }
            else if (SelectedPage == PageSetting.Language)
            {
                <div class="pm-page-header">
                    <div class="pm-eyebrow">Localization</div>
                    <h2 class="pm-title">@ResourceApp.language</h2>
                    <p class="pm-subtitle">Choose how the administration interface should be displayed.</p>
                </div>

                <CultureSelector />
            }
            else if (SelectedPage == PageSetting.Impressum)
            {
                <ImpressumUI />
            }
            else if (SelectedPage == PageSetting.Privacy)
            {
                <PrivacyPolicy />
            }
            else if (SelectedPage == PageSetting.Terms)
            {
                <TermsOfUse />
            }
            else if (SelectedPage == PageSetting.Licenses)
            {
                <ThirdPartyLicenses />
            }
        </div>
    </section>
</div>

@code {
    [Parameter] public EventCallback CallBack { get; set; }

    private PageSetting SelectedPage = PageSetting.ChangePassword;

    private string GetItemClass(PageSetting page)
        => $"pm-sidebar-link {(SelectedPage == page ? "pm-sidebar-link-active" : string.Empty)}";

    private enum PageSetting
    {
        ChangePassword,
        Language,
        Impressum,
        Privacy,
        Terms,
        Licenses
    }
}
