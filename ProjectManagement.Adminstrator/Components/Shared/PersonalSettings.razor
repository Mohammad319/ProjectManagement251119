@using ProjectManagement.Adminstrator.Components.Account.Pages.Manage
@using ProjectManagement.Adminstrator.Shared.Culture
@using ProjectManagement.Adminstrator.Shared.Legal
@inherits AppComponentBase

<div class="grid min-h-0 gap-4 lg:grid-cols-[16rem_minmax(0,1fr)]">
    <aside class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-950/80 overflow-hidden">
        <div class="border-b border-slate-200 px-4 py-3 dark:border-slate-800">
            <div>
                <div class="text-[10px] font-semibold uppercase tracking-[0.16em] text-slate-500 dark:text-slate-400">Settings</div>
                <div class="text-sm font-semibold text-slate-900 dark:text-slate-100 mt-1">Preferences</div>
                <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">Profile, localization, legal details, and account controls.</p>
            </div>
        </div>

        <nav class="p-3" aria-label="Settings menu">
            <ul class="space-y-1">
                <li>
                    <button type="button" class="@GetItemClass(PageSetting.ChangePassword)" @onclick="() => SelectedPage = PageSetting.ChangePassword">@ResourceIdentity.changePassword</button>
                </li>
                <li>
                    <button type="button" class="@GetItemClass(PageSetting.Language)" @onclick="() => SelectedPage = PageSetting.Language">@ResourceApp.language</button>
                </li>
                <li>
                    <button type="button" class="@GetItemClass(PageSetting.Impressum)" @onclick="() => SelectedPage = PageSetting.Impressum">Impressum</button>
                </li>
                <li>
                    <button type="button" class="@GetItemClass(PageSetting.Privacy)" @onclick="() => SelectedPage = PageSetting.Privacy">@AppControll.TabPrivacy</button>
                </li>
                <li>
                    <button type="button" class="@GetItemClass(PageSetting.Terms)" @onclick="() => SelectedPage = PageSetting.Terms">@AppControll.TabTerms</button>
                </li>
                <li>
                    <button type="button" class="@GetItemClass(PageSetting.Licenses)" @onclick="() => SelectedPage = PageSetting.Licenses">@AppControll.TabLicenses</button>
                </li>
            </ul>
        </nav>
    </aside>

    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-950/80 min-w-0 overflow-hidden">
        <div class="px-4 py-3 min-h-[32rem] overflow-auto">
            @if (SelectedPage == PageSetting.ChangePassword)
            {
                <div class="rounded-2xl border border-slate-200 bg-white px-4 py-3 shadow-sm dark:border-slate-800 dark:bg-slate-950/80">
                    <div class="text-[10px] font-semibold uppercase tracking-[0.16em] text-slate-500 dark:text-slate-400">Security</div>
                    <h2 class="text-lg font-semibold tracking-tight text-slate-900 dark:text-slate-100">@ResourceIdentity.changePassword</h2>
                    <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">Update your password to keep the administrator account protected.</p>
                </div>

                <ChangePassword />
            }
            else if (SelectedPage == PageSetting.Language)
            {
                <div class="rounded-2xl border border-slate-200 bg-white px-4 py-3 shadow-sm dark:border-slate-800 dark:bg-slate-950/80">
                    <div class="text-[10px] font-semibold uppercase tracking-[0.16em] text-slate-500 dark:text-slate-400">Localization</div>
                    <h2 class="text-lg font-semibold tracking-tight text-slate-900 dark:text-slate-100">@ResourceApp.language</h2>
                    <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">Choose how the administration interface should be displayed.</p>
                </div>

                <CultureSelector />
            }
            else if (SelectedPage == PageSetting.Impressum)
            {
                <ImpressumUI />
            }
            else if (SelectedPage == PageSetting.Privacy)
            {
                <PrivacyPolicy />
            }
            else if (SelectedPage == PageSetting.Terms)
            {
                <TermsOfUse />
            }
            else if (SelectedPage == PageSetting.Licenses)
            {
                <ThirdPartyLicenses />
            }
        </div>
    </section>
</div>

@code {
    [Parameter] public EventCallback CallBack { get; set; }

    private PageSetting SelectedPage = PageSetting.ChangePassword;

    private string GetItemClass(PageSetting page)
        => $"flex w-full items-center gap-2 rounded-xl border border-transparent px-3 py-2 text-sm font-medium text-slate-700 transition hover:border-slate-200 hover:bg-slate-50 dark:text-slate-200 dark:hover:border-slate-800 dark:hover:bg-slate-900/60 {(SelectedPage == page ?"border-sky-200 bg-sky-50 text-sky-700 dark:border-sky-900/60 dark:bg-sky-950/40 dark:text-sky-200" : string.Empty)}";

    private enum PageSetting
    {
        ChangePassword,
        Language,
        Impressum,
        Privacy,
        Terms,
        Licenses
    }
}
