@using AuthPermissions.Entity
@using Domain.Repository.AuthPermissions
@using Domain.Settings
@using Microsoft.EntityFrameworkCore
@using Persistence.Factory
@using ProjectManagement.Adminstrator.Services.Users
@using ProjectManagement.Shared.DTO.Tenant
@attribute [Authorize(Roles = PMRolesConst.APP.AdminSuperManger)]
@inherits AppComponentBase
@inject IUsersService sersService
@inject IDbContextFactory<ApplicationDbContext> ContextFactory

<div class="pm-form-shell">
    @if (Put != null)
    {
        <EditForm Model="@Put" OnValidSubmit="async () => await HandleSubmitAsync()" id="tenantForm" class="pm-form-shell">
            <DataAnnotationsValidator />
            <ValidationSummary class="pm-validation-summary" />

            <section class="pm-form-section">
                <div>
                    <h3 class="pm-form-section-title">General</h3>
                    <p class="pm-form-section-text">Main tenant identity, website, and expiration settings.</p>
                </div>

                <div class="pm-form-grid">
                    @if (Id == 0)
                    {
                        <div class="pm-field">
                            <label class="pm-label">@AppControll.Db</label>
                            <InputSelect @bind-Value="Put.TenantDBId" class="pm-select">
                                @if (Databases != null)
                                {
                                    foreach (var status in Databases)
                                    {
                                        <option value="@status.Id">@status.Name</option>
                                    }
                                }
                            </InputSelect>
                        </div>
                    }

                    <div class="pm-field">
                        <label class="pm-label">@CalcResource.name</label>
                        <InputText class="pm-input" @bind-Value="@Put.Name" />
                        <ValidationMessage For="@(() => Put.Name)" class="pm-validation-message" />
                    </div>

                    <div class="pm-field">
                        <label class="pm-label">Url</label>
                        <InputText class="pm-input" @bind-Value="@Put.Website" />
                        <ValidationMessage For="@(() => Put.Website)" class="pm-validation-message" />
                    </div>

                    <div class="pm-field">
                        <label class="pm-label">@AppControll.expire</label>
                        <InputDate class="pm-input" @bind-Value="@Put.DateExpire" />
                        <ValidationMessage For="@(() => Put.DateExpire)" class="pm-validation-message" />
                    </div>
                </div>
            </section>

            <section class="pm-form-section">
                <div>
                    <h3 class="pm-form-section-title">Limits</h3>
                    <p class="pm-form-section-text">Usage caps for users and calculations.</p>
                </div>

                <div class="pm-form-grid-2">
                    <div class="pm-field">
                        <label class="pm-label">@AppControll.maxUsers</label>
                        <InputNumber class="pm-input" @bind-Value="@Put.MaxUsers" />
                        <ValidationMessage For="@(() => Put.MaxUsers)" class="pm-validation-message" />
                    </div>

                    <div class="pm-field">
                        <label class="pm-label">@AppControll.maxCalculations</label>
                        <InputNumber class="pm-input" @bind-Value="@Put.MaxCalculations" />
                        <ValidationMessage For="@(() => Put.MaxCalculations)" class="pm-validation-message" />
                    </div>
                </div>
            </section>

            <section class="pm-form-section">
                <div>
                    <h3 class="pm-form-section-title">Contact details</h3>
                    <p class="pm-form-section-text">Communication and address information for the tenant.</p>
                </div>

                <div class="pm-form-grid">
                    <div class="pm-field">
                        <label class="pm-label">@ResourceIdentity.phone</label>
                        <InputText class="pm-input" @bind-Value="@Put.Phone" />
                        <ValidationMessage For="@(() => Put.Phone)" class="pm-validation-message" />
                    </div>

                    <div class="pm-field">
                        <label class="pm-label">@ResourceIdentity.mobile</label>
                        <InputText class="pm-input" @bind-Value="@Put.Mobile" />
                        <ValidationMessage For="@(() => Put.Mobile)" class="pm-validation-message" />
                    </div>

                    <div class="pm-field">
                        <label class="pm-label">@ResourceIdentity.fax</label>
                        <InputText class="pm-input" @bind-Value="@Put.Fax" />
                        <ValidationMessage For="@(() => Put.Fax)" class="pm-validation-message" />
                    </div>

                    <div class="pm-field">
                        <label class="pm-label">@ResourceIdentity.email</label>
                        <InputText class="pm-input" @bind-Value="@Put.Email" />
                        <ValidationMessage For="@(() => Put.Email)" class="pm-validation-message" />
                    </div>

                    <div class="pm-field">
                        <label class="pm-label">@ResourceIdentity.country</label>
                        <InputText class="pm-input" @bind-Value="@Put.Country" />
                        <ValidationMessage For="@(() => Put.Country)" class="pm-validation-message" />
                    </div>

                    <div class="pm-field">
                        <label class="pm-label">@ResourceIdentity.city</label>
                        <InputText class="pm-input" @bind-Value="@Put.City" />
                        <ValidationMessage For="@(() => Put.City)" class="pm-validation-message" />
                    </div>

                    <div class="pm-field">
                        <label class="pm-label">@ResourceIdentity.zipCode</label>
                        <InputText class="pm-input" @bind-Value="@Put.PostCode" />
                        <ValidationMessage For="@(() => Put.PostCode)" class="pm-validation-message" />
                    </div>

                    <div class="pm-field">
                        <label class="pm-label">@AppControll.street</label>
                        <InputText class="pm-input" @bind-Value="@Put.Street" />
                        <ValidationMessage For="@(() => Put.Street)" class="pm-validation-message" />
                    </div>

                    <div class="pm-field">
                        <label class="pm-label">@ResourceIdentity.build</label>
                        <InputText class="pm-input" @bind-Value="@Put.BuildNumber" />
                        <ValidationMessage For="@(() => Put.BuildNumber)" class="pm-validation-message" />
                    </div>

                    <div class="pm-field pm-field-wide">
                        <label class="pm-label">@CalcResource.note</label>
                        <InputTextArea class="pm-textarea" @bind-Value="@Put.Note" />
                        <ValidationMessage For="@(() => Put.Note)" class="pm-validation-message" />
                    </div>
                </div>
            </section>
        </EditForm>

        <div class="pm-toolbar">
            <button type="submit" form="tenantForm" class="pm-btn-success" disabled="@IsLoading">
                @ResourceApp.save
            </button>
            <button type="button" class="pm-btn-secondary" @onclick="async () => await Callback.InvokeAsync(false)">
                @ResourceApp.cancel
            </button>
        </div>
    }
</div>

@code{
    [Parameter] public int Id { get; set; }
    [Parameter] public EventCallback<bool> Callback { get; set; }
    bool IsLoading = false;
    public TenantEntity? Put;
    private async Task HandleSubmitAsync()
    {
        IsLoading = true;
        if (Id == 0)
        {
            TenantEntity post = new TenantEntity();
           PropertyCopier.CopyPropertiesTo(Put, post);
            await Callback.InvokeAsync(await ExHandlers.RunCheckTokenAsync(() => sersService.CreateAsync(post)) > 0);
        }
        else
            if (Put is not null)
            {
                await Callback.InvokeAsync(await ExHandlers.RunCheckTokenAsync(() => sersService.UpdateAsync(Put)));
            }
            else
            {
                await Callback.InvokeAsync(false);
            }
        IsLoading = false;
    }
    List<TenantDatabaseEntity>? Databases;
    protected async override Task OnInitializedAsync()
    {
        if (Id == 0)
        {
            Put = new TenantEntity();
            // Databases =   Shardingsettings.GetList();
           // if (Databases != null && Databases.Any())
           //     Put.DB = Databases?.FirstOrDefault()?.Key;
        }
        if (Id > 0)
            Put = await sersService.GetByIdAsync(Id);
        using var _appContext = ContextFactory.CreateDbContext();
        Databases = await _appContext.TenantDatabase.ToListAsync();
    }
    }
