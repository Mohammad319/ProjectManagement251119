@using AuthPermissions.Entity
@using Domain.Repository.AuthPermissions
@using Microsoft.EntityFrameworkCore
@using ProjectManagement.Shared.DTO.Tenant
@using ProjectManagement.Shared.Models.Account
@using ProjectManagement.Adminstrator.Services.Users
@attribute [Authorize(Roles = PMRolesConst.APP.AdminManger)]
@inherits AppComponentBase
@inject IUsersService UsersService
@inject IDbContextFactory<ApplicationDbContext> ContextFactory

<div class="pm-page">
    <div class="pm-toolbar">
        <button class="pm-btn-secondary" @onclick="async () => await Callback.InvokeAsync()">@ResourceApp.back</button>
    </div>

    @if (TenantPut is TenantEntity tenant)
    {
        <section class="pm-card overflow-hidden">
            <div class="pm-card-header">
                <div>
                    <h2 class="pm-title">@tenant.Name</h2>
                    <p class="pm-subtitle mt-1">Tenant overview, limits, contact information, and linked users.</p>
                </div>
                <div class="pm-toolbar">
                    @if (tenant.DateExpire.HasValue)
                    {
                        <span class="pm-chip-amber">@tenant.DateExpire.Value.ToString("dd.MM.yyyy")</span>
                    }
                    <span class="pm-chip">@tenant.MaxUsers @AppControll.maxUsers</span>
                </div>
            </div>

            <div class="pm-card-body">
                <table class="pm-kv-table">
                    <tbody>
                        <tr>
                            <th>@CalcResource.name</th>
                            <td>@tenant.Name</td>
                        </tr>
                        <tr>
                            <th>@AppControll.Db</th>
                            <td>@tenant.TenantDB?.Name</td>
                        </tr>
                        @if (tenant.DateExpire.HasValue)
                        {
                            <tr>
                                <th>@AppControll.expire</th>
                                <td>@tenant.DateExpire.Value.ToString("dd.MM.yyyy")</td>
                            </tr>
                        }
                        <tr>
                            <th>@AppControll.maxUsers</th>
                            <td>@tenant.MaxUsers</td>
                        </tr>
                        <tr>
                            <th>@AppControll.maxCalculations</th>
                            <td>@tenant.MaxCalculations</td>
                        </tr>
                        <tr>
                            <th>@ResourceIdentity.email</th>
                            <td>@tenant.Email</td>
                        </tr>
                        <tr>
                            <th>@ResourceIdentity.fax</th>
                            <td>@tenant.Fax</td>
                        </tr>
                        <tr>
                            <th>@ResourceIdentity.phone</th>
                            <td>@tenant.Phone</td>
                        </tr>
                        <tr>
                            <th>@ResourceIdentity.mobile</th>
                            <td>@tenant.Mobile @tenant.BuildNumber</td>
                        </tr>
                        <tr>
                            <th>@ResourceIdentity.country</th>
                            <td>@tenant.Country</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

        <section class="pm-card overflow-hidden">
            <div class="pm-card-header">
                <div>
                    <h3 class="pm-title">@ResourceIdentity.users</h3>
                    <p class="pm-subtitle mt-1">Users connected to this tenant, including lockout state and company bootstrap tools.</p>
                </div>
                <div class="pm-toolbar">
                    @if (CanManageTenantUsers)
                    {
                        <button class="pm-btn-success" @onclick="() => UserRoleDialog(new ApplicationUser() { Id = string.Empty })">New User</button>
                    }
                    @if (Users == null || !Users.Any())
                    {
                        <button class="pm-btn-secondary" @onclick="async () => await GetUsersAsync()">@ResourceIdentity.users</button>
                    }
                    else
                    {
                        <span class="pm-chip">@Users.Count</span>
                    }
                </div>
            </div>

            <div class="pm-card-body">
                @if (Users == null || !Users.Any())
                {
                    <div class="pm-empty">No users loaded yet.</div>
                }
                else
                {
                    <div class="pm-table-wrap">
                        <table class="pm-table">
                            <thead>
                                <tr>
                                    <th>@ResourceIdentity.email</th>
                                    <th>@CalcResource.code</th>
                                    <th>@CalcResource.name</th>
                                    <th>@ResourceIdentity.lockoutEnd</th>
                                    <th>@ResourceIdentity.lockoutStart</th>
                                    <th>@ResourceApp.department</th>
                                    <th>Tools</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in Users)
                                {
                                    <tr @oncontextmenu:preventDefault
                                        @oncontextmenu="() => Context(user)">
                                        <td>@user.Email</td>
                                        <td>@user.UserName</td>
                                        <td>
                                            <div class="font-medium text-slate-900 dark:text-slate-100">@user.Firstname @user.Lastname</div>
                                        </td>
                                        <td>
                                            <div class="flex items-center gap-2">
                                                <input type="checkbox" class="h-4 w-4 rounded border-slate-300 text-sky-600 focus:ring-sky-500 dark:border-slate-600 dark:bg-slate-800" disabled value="@user.LockoutEnabled" />
                                                <span>@(user.LockoutEnd.HasValue ? user.LockoutEnd.Value.ToString("dd.MM.yyyy") : string.Empty)</span>
                                            </div>
                                        </td>
                                        <td>@(user.LockoutStart.HasValue ? user.LockoutStart.Value.ToString("dd.MM.yyyy") : string.Empty)</td>
                                        <td>@user.DepartmentId</td>
                                        <td>
                                            @if (CanManageTenantUsers)
                                            {
                                                <button class="pm-btn-outline"
                                                        @onclick="() => AddBasicCompanyInfoAsync(user)"
                                                        disabled="@IsAddingCompanyInfoFor(user)">
                                                    @(IsAddingCompanyInfoFor(user) ? "Adding..." : "Add Basic Company Info")
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </section>
    }
</div>

@code{
    bool IsAddingCompanyInfoFor(ApplicationUser user) =>
        !string.IsNullOrWhiteSpace(AddingCompanyInfoForUserId) && AddingCompanyInfoForUserId == user.Id;

    string? AddingCompanyInfoForUserId;

    async Task AddBasicCompanyInfoAsync(ApplicationUser user)
    {
        if (!CanManageTenantUsers || Id <= 0 || user is null || string.IsNullOrWhiteSpace(user.Id) || IsAddingCompanyInfoFor(user)) return;

        if (!user.UserId.HasValue || user.UserId.Value <= 0)
        {
            MHD.MessageOk(ResourceApp.newItem, "Selected user does not have a linked tenant user id.", MhdState.Warning);
            return;
        }

        AddingCompanyInfoForUserId = user.Id;
        try
        {
            var result = await ExHandlers.RunCheckTokenAsync(() => UsersService.AddBasicCompanyInfoAsync(Id, user.UserId));
            MHD.MessageOk(ResourceApp.newItem, result ? "Basic company info added/updated successfully." : "No changes were required.", result ? MhdState.Success : MhdState.Info);
        }
        finally
        {
            AddingCompanyInfoForUserId = null;
            StateHasChanged();
        }
    }
}
