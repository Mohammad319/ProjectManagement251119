@using AuthPermissions.Entity
@using Domain.Repository.AuthPermissions
@using Microsoft.EntityFrameworkCore
@using ProjectManagement.Shared.DTO.Tenant
@using ProjectManagement.Shared.Models.Account
@using ProjectManagement.Adminstrator.Services.Users
@attribute [Authorize(Roles = PMRolesConst.APP.AdminManger)]
@inherits AppComponentBase
@inject IUsersService UsersService
@inject IDbContextFactory<ApplicationDbContext> ContextFactory

<div class="pm-page">
    <section class="pm-page-header">
        <div class="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
            <div>
                <div class="pm-page-kicker">Tenant details</div>
                <h2 class="pm-page-title">@(TenantPut?.Name ?? "Tenant")</h2>
                <p class="pm-page-subtitle">Inspect tenant metadata, limits, contact details, and linked users from one screen.</p>
            </div>
            <button class="pm-btn pm-btn-secondary" @onclick="async () => await Callback.InvokeAsync()">
                @ResourceApp.back
            </button>
        </div>
    </section>

    @if (TenantPut is TenantEntity tenant)
    {
        <div class="grid gap-5 xl:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
            <section class="pm-card p-5">
                <div class="pm-section-title">Tenant profile</div>
                <div class="pm-section-subtitle">Core identifiers, limits, and contact information.</div>

                <dl class="mt-5 grid gap-x-4 gap-y-4 sm:grid-cols-2">
                    <div class="pm-card-soft p-4">
                        <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-500 dark:text-slate-400">@CalcResource.name</dt>
                        <dd class="mt-2 text-sm font-medium text-slate-900 dark:text-slate-100">@tenant.Name</dd>
                    </div>
                    <div class="pm-card-soft p-4">
                        <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-500 dark:text-slate-400">@AppControll.Db</dt>
                        <dd class="mt-2 text-sm font-medium text-slate-900 dark:text-slate-100">@tenant.TenantDB?.Name</dd>
                    </div>
                    <div class="pm-card-soft p-4">
                        <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-500 dark:text-slate-400">@AppControll.expire</dt>
                        <dd class="mt-2 text-sm font-medium text-slate-900 dark:text-slate-100">@(tenant.DateExpire.HasValue ? tenant.DateExpire.Value.ToString("dd.MM.yyyy") : "—")</dd>
                    </div>
                    <div class="pm-card-soft p-4">
                        <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-500 dark:text-slate-400">Ownership</dt>
                        <dd class="mt-2 text-sm font-medium text-slate-900 dark:text-slate-100">
                            @if (tenant.TenantDBId.HasValue)
                            {
                                <span class="pm-pill pm-pill-success">Own database</span>
                            }
                            else
                            {
                                <span class="pm-pill pm-pill-muted">Shared database</span>
                            }
                        </dd>
                    </div>
                    <div class="pm-card-soft p-4">
                        <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-500 dark:text-slate-400">@AppControll.maxUsers</dt>
                        <dd class="mt-2 text-sm font-medium text-slate-900 dark:text-slate-100">@tenant.MaxUsers</dd>
                    </div>
                    <div class="pm-card-soft p-4">
                        <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-500 dark:text-slate-400">@AppControll.maxCalculations</dt>
                        <dd class="mt-2 text-sm font-medium text-slate-900 dark:text-slate-100">@tenant.MaxCalculations</dd>
                    </div>
                    <div class="pm-card-soft p-4 sm:col-span-2">
                        <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-500 dark:text-slate-400">Contact</dt>
                        <dd class="mt-2 grid gap-2 text-sm text-slate-700 dark:text-slate-200 sm:grid-cols-2">
                            <div><span class="font-medium">@ResourceIdentity.email:</span> @tenant.Email</div>
                            <div><span class="font-medium">@ResourceIdentity.phone:</span> @tenant.Phone</div>
                            <div><span class="font-medium">@ResourceIdentity.mobile:</span> @tenant.Mobile</div>
                            <div><span class="font-medium">@ResourceIdentity.fax:</span> @tenant.Fax</div>
                            <div><span class="font-medium">@ResourceIdentity.country:</span> @tenant.Country</div>
                            <div><span class="font-medium">@ResourceIdentity.build:</span> @tenant.BuildNumber</div>
                        </dd>
                    </div>
                </dl>
            </section>

            <section class="pm-card p-5">
                <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
                    <div>
                        <div class="pm-section-title">Tenant users</div>
                        <div class="pm-section-subtitle">View linked users and apply administrative actions.</div>
                    </div>
                    <div class="flex flex-wrap items-center gap-2">
                        @if (CanManageTenantUsers)
                        {
                            <button class="pm-btn pm-btn-primary" @onclick="() => UserRoleDialog(new ApplicationUser() { Id = string.Empty })">New user</button>
                        }

                        @if (Users == null || !Users.Any())
                        {
                            <button class="pm-btn pm-btn-secondary" @onclick="async () => await GetUsersAsync()">@ResourceIdentity.users</button>
                        }
                    </div>
                </div>

                @if (Users == null || !Users.Any())
                {
                    <div class="pm-empty mt-5 min-h-[220px]">
                        <div class="pm-empty-title">No users loaded</div>
                        <div class="pm-empty-copy">Load tenant users to inspect lockout status, department assignment, and add baseline company information.</div>
                    </div>
                }
                else
                {
                    <div class="pm-table-wrap mt-5">
                        <div class="pm-table-scroll">
                            <table class="pm-table">
                                <thead>
                                    <tr>
                                        <th>@ResourceIdentity.email</th>
                                        <th>@CalcResource.code</th>
                                        <th>@CalcResource.name</th>
                                        <th>@ResourceIdentity.lockoutEnd</th>
                                        <th>@ResourceIdentity.lockoutStart</th>
                                        <th>@ResourceApp.department</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var user in Users)
                                    {
                                        <tr @oncontextmenu:preventDefault @oncontextmenu="() => Context(user)">
                                            <td>@user.Email</td>
                                            <td>@user.UserName</td>
                                            <td>@user.Firstname @user.Lastname</td>
                                            <td>
                                                <div class="flex items-center gap-2">
                                                    @if (user.LockoutEnabled)
                                                    {
                                                        <span class="pm-pill pm-pill-warning">Locked</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="pm-pill pm-pill-muted">Open</span>
                                                    }
                                                </div>
                                                <div class="mt-1 text-xs text-slate-500 dark:text-slate-400">@(user.LockoutEnd.HasValue ? user.LockoutEnd.Value.ToString("dd.MM.yyyy") : "—")</div>
                                            </td>
                                            <td>@(user.LockoutStart.HasValue ? user.LockoutStart.Value.ToString("dd.MM.yyyy") : "—")</td>
                                            <td>@user.DepartmentId</td>
                                            <td>
                                                @if (CanManageTenantUsers)
                                                {
                                                    <button class="pm-btn pm-btn-secondary px-3 py-2 text-xs"
                                                            @onclick="() => AddBasicCompanyInfoAsync(user)"
                                                            disabled="@IsAddingCompanyInfoFor(user)">
                                                        @(IsAddingCompanyInfoFor(user) ? "Adding..." : "Add Basic Company Info")
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </section>
        </div>
    }
</div>

@code {
    bool IsAddingCompanyInfoFor(ApplicationUser user) =>
        !string.IsNullOrWhiteSpace(AddingCompanyInfoForUserId) && AddingCompanyInfoForUserId == user.Id;

    string? AddingCompanyInfoForUserId;

    async Task AddBasicCompanyInfoAsync(ApplicationUser user)
    {
        if (!CanManageTenantUsers || Id <= 0 || user is null || string.IsNullOrWhiteSpace(user.Id) || IsAddingCompanyInfoFor(user)) return;

        if (!user.UserId.HasValue || user.UserId.Value <= 0)
        {
            MHD.MessageOk(ResourceApp.newItem, "Selected user does not have a linked tenant user id.", MhdState.Warning);
            return;
        }

        AddingCompanyInfoForUserId = user.Id;
        try
        {
            var result = await ExHandlers.RunCheckTokenAsync(() => UsersService.AddBasicCompanyInfoAsync(Id, user.UserId));
            MHD.MessageOk(ResourceApp.newItem,
                result ? "Basic company info added/updated successfully." : "No changes were required.",
                result ? MhdState.Success : MhdState.Info);
        }
        finally
        {
            AddingCompanyInfoForUserId = null;
            StateHasChanged();
        }
    }
}
