@using AuthPermissions.Entity
@using Domain.Repository.AuthPermissions
@using Microsoft.EntityFrameworkCore
@using ProjectManagement.Shared.DTO.Tenant
@using ProjectManagement.Shared.Models.Account
@using ProjectManagement.Adminstrator.Services.Users
@attribute [Authorize(Roles = PMRolesConst.APP.AdminManger)]
@inherits AppComponentBase
@inject IUsersService UsersService
@inject IDbContextFactory<ApplicationDbContext> ContextFactory
@using CsS = ProjectManagement.Shared.Constant.CssClasses

<h3 class="CsS.Spacing.M.Bottom2">
    <button class="@CsS.Btn.Outline.Secondary" @onclick="async () => await Callback.InvokeAsync()">
        @ResourceApp.back
    </button>
</h3>

@if (TenantPut is TenantEntity tenant)
{
    <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-950 @CsS.Spacing.M.Bottom3">
        <table class="@CsS.Table.Tab">
            <tbody class="@CsS.Table.TBody">
                <tr class="@CsS.Table.Tr">
                    <td class="@CsS.Table.Td">@CalcResource.name</td>
                    <td class="@CsS.Table.Td">@tenant.Name</td>
                </tr>
                <tr class="@CsS.Table.Tr">
                    <td class="@CsS.Table.Td">@AppControll.Db</td>
                    <td class="@CsS.Table.Td">@tenant.TenantDB?.Name</td>
                </tr>
                @if (tenant.DateExpire.HasValue)
                {
                    <tr class="@CsS.Table.Tr">
                        <td class="@CsS.Table.Td">@AppControll.expire</td>
                        <td class="@CsS.Table.Td">@tenant.DateExpire.Value.ToString("dd.MM.yyyy")</td>
                    </tr>
                }
                <tr class="@CsS.Table.Tr">
                    <td class="@CsS.Table.Td">@AppControll.maxUsers</td>
                    <td class="@CsS.Table.Td">@tenant.MaxUsers</td>
                </tr>
                <tr class="@CsS.Table.Tr">
                    <td class="@CsS.Table.Td">@AppControll.maxCalculations</td>
                    <td class="@CsS.Table.Td">@tenant.MaxCalculations</td>
                </tr>
                <tr class="@CsS.Table.Tr">
                    <td class="@CsS.Table.Td">@ResourceIdentity.email</td>
                    <td class="@CsS.Table.Td">@tenant.Email</td>
                </tr>
                <tr class="@CsS.Table.Tr">
                    <td class="@CsS.Table.Td">@ResourceIdentity.fax</td>
                    <td class="@CsS.Table.Td">@tenant.Fax</td>
                </tr>
                <tr class="@CsS.Table.Tr">
                    <td class="@CsS.Table.Td">@ResourceIdentity.phone</td>
                    <td class="@CsS.Table.Td">@tenant.Phone</td>
                </tr>
                <tr class="@CsS.Table.Tr">
                    <td class="@CsS.Table.Td">@ResourceIdentity.mobile</td>
                    <td class="@CsS.Table.Td">@tenant.Mobile @tenant.BuildNumber</td>
                </tr>
                <tr class="@CsS.Table.Tr">
                    <td class="@CsS.Table.Td">@ResourceIdentity.country</td>
                    <td class="@CsS.Table.Td">@tenant.Country</td>
                </tr>
            </tbody>
        </table>
    </div>

    @if (CanManageTenantUsers)
    {
        <button class="@CsS.Btn.Outline.Success mb-3" @onclick="() => UserRoleDialog(new ApplicationUser() { Id = string.Empty })">
            New User
        </button>
    }

    @if (Users == null || !Users.Any())
    {
        <button class="@CsS.Btn.Outline.Secondary" @onclick="async () => await GetUsersAsync()">
            @ResourceIdentity.users
        </button>
    }
    else
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-950">
            <table class="@CsS.Table.Tab">
                <thead class="@CsS.Table.Thead">
                    <tr>
                        <th class="@CsS.Table.TH">@ResourceIdentity.email</th>
                        <th class="@CsS.Table.TH">@CalcResource.code</th>
                        <th class="@CsS.Table.TH">@CalcResource.name</th>
                        <th class="@CsS.Table.TH">@ResourceIdentity.lockoutEnd</th>
                        <th class="@CsS.Table.TH">@ResourceIdentity.lockoutStart</th>
                        <th class="@CsS.Table.TH">@ResourceApp.department</th>
                    </tr>
                </thead>
                <tbody class="@CsS.Table.TBody">
                    @foreach (var user in Users)
                    {
                        <tr class="@CsS.Table.Tr"
                            @oncontextmenu:preventDefault
                            @oncontextmenu="() => Context(user)">
                            <td class="@CsS.Table.Td">@user.Email</td>
                            <td class="@CsS.Table.Td">@user.UserName</td>
                            <td class="@CsS.Table.Td">@user.Firstname @user.Lastname</td>
                            <td class="@CsS.Table.Td">
                                <input type="checkbox" class="@CsS.Input.Check" disabled value="@user.LockoutEnabled" />
                                @(user.LockoutEnd.HasValue ? user.LockoutEnd.Value.ToString("dd.MM.yyyy") : string.Empty)
                            </td>
                            <td class="@CsS.Table.Td">
                                @(user.LockoutStart.HasValue ? user.LockoutStart.Value.ToString("dd.MM.yyyy") : string.Empty)
                            </td>
                            <td class="@CsS.Table.Td">@user.DepartmentId</td>
                            <td class="@CsS.Table.Td">
                                @if (CanManageTenantUsers)
                                {
                                    <button class="@CsS.Btn.Outline.Primary"
                                            @onclick="() => AddBasicCompanyInfoAsync(user)"
                                            disabled="@IsAddingCompanyInfoFor(user)">
                                        @(IsAddingCompanyInfoFor(user) ? "Adding..." : "Add Basic Company Info")
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code{
    bool IsAddingCompanyInfoFor(ApplicationUser user) =>
        !string.IsNullOrWhiteSpace(AddingCompanyInfoForUserId) && AddingCompanyInfoForUserId == user.Id;

    string? AddingCompanyInfoForUserId;

    async Task AddBasicCompanyInfoAsync(ApplicationUser user)
    {
        if (!CanManageTenantUsers || Id <= 0 || user is null || string.IsNullOrWhiteSpace(user.Id) || IsAddingCompanyInfoFor(user)) return;

        if (!user.UserId.HasValue || user.UserId.Value <= 0)
        {
            MHD.MessageOk(ResourceApp.newItem, "Selected user does not have a linked tenant user id.", MhdState.Warning);
            return;
        }

        AddingCompanyInfoForUserId = user.Id;
        try
        {
            var result = await ExHandlers.RunCheckTokenAsync(() => UsersService.AddBasicCompanyInfoAsync(Id, user.UserId));
            MHD.MessageOk(ResourceApp.newItem, result ? "Basic company info added/updated successfully." : "No changes were required.", result ? MhdState.Success : MhdState.Info);
        }
        finally
        {
            AddingCompanyInfoForUserId = null;
            StateHasChanged();
        }
    }
}
