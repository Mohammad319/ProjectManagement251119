@using AuthPermissions.Entity
@using Domain.Repository.AuthPermissions
@using Microsoft.EntityFrameworkCore
@using ProjectManagement.Shared.DTO.Tenant
@using ProjectManagement.Shared.Models.Account
@using ProjectManagement.Adminstrator.Services.Users
@attribute [Authorize(Roles = PMRolesConst.APP.AdminManger)]
@inherits AppComponentBase
@inject IUsersService UsersService
@inject IDbContextFactory<AuthPermissionDbContext> ContextFactory

<div class="space-y-1 text-slate-900 dark:text-slate-100">
    <section class="rounded-2xl border border-slate-200 bg-white px-4 py-1 shadow-sm dark:border-slate-800 dark:bg-slate-950/80">
        <div class="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
            <div>
                <h2 class="mt-1 text-lg font-semibold tracking-tight text-slate-900 dark:text-slate-100">@(TenantPut?.Name ??"Hyresgäst")</h2>
                <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">Granska hyresgästens uppgifter, gränser, kontaktinformation och kopplade användare på en skärm.</p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                @if (CanManageTenantUsers)
                {
                    <button class="inline-flex items-center justify-center gap-2 rounded-xl border border-sky-600 bg-sky-600 px-3 py-1 text-xs font-medium text-white transition hover:bg-sky-700 focus:outline-none focus:ring-2 focus:ring-sky-500/30 disabled:cursor-not-allowed disabled:opacity-60 dark:border-sky-500 dark:bg-sky-500 dark:hover:bg-sky-400"
                            disabled="@IsSeedingDefaults"
                            @onclick="AskInitializeDefaults">
                        @(IsSeedingDefaults ? "Initierar…" : "Initiera standardinställningar")
                    </button>
                    <button class="inline-flex items-center justify-center gap-2 rounded-xl border border-emerald-600 bg-emerald-600 px-3 py-1 text-xs font-medium text-white transition hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-500/30 disabled:cursor-not-allowed disabled:opacity-60 dark:border-emerald-500 dark:bg-emerald-500 dark:hover:bg-emerald-400"
                            disabled="@IsSeedingSampleData"
                            @onclick="AskGenerateSampleData">
                        @(IsSeedingSampleData ? "Genererar…" : "Generera exempeldata")
                    </button>
                }
                <button class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-3 py-1 text-xs font-medium text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-400/30 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800" @onclick="async () => await Callback.InvokeAsync()">
                    @ResourceApp.back
                </button>
            </div>
        </div>
    </section>

    @if (TenantPut is TenantEntity tenant)
    {
        <div class="grid gap-1 xl:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
            <section class=" overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-950/80 p-1">

                <dl class="space-y-1 mt-1 grid gap-x-1 gap-y-1 sm:grid-cols-2">
                    <div class="rounded-2xl border border-slate-200 bg-slate-50/80 shadow-sm dark:border-slate-800 dark:bg-slate-900/60 px-3 py-1">
                        <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-500 dark:text-slate-400">@CalcResource.name</dt>
                        <dd class="mt-1 text-sm font-medium text-slate-900 dark:text-slate-100">@tenant.Name</dd>
                    </div>
                    <div class="rounded-2xl border border-slate-200 bg-slate-50/80 shadow-sm dark:border-slate-800 dark:bg-slate-900/60 px-3 py-1">
                        <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-500 dark:text-slate-400">@AppControll.Db</dt>
                        <dd class="mt-1 text-sm font-medium text-slate-900 dark:text-slate-100">@tenant.TenantDB?.Name</dd>
                    </div>
                    <div class="rounded-2xl border border-slate-200 bg-slate-50/80 shadow-sm dark:border-slate-800 dark:bg-slate-900/60 px-3 py-1">
                        <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-500 dark:text-slate-400">@AppControll.expire</dt>
                        <dd class="mt-1 text-sm font-medium text-slate-900 dark:text-slate-100">@(tenant.DateExpire.HasValue ? tenant.DateExpire.Value.ToString("dd.MM.yyyy") :"—")</dd>
                    </div>
        
                    <div class="rounded-2xl border border-slate-200 bg-slate-50/80 shadow-sm dark:border-slate-800 dark:bg-slate-900/60 px-3 py-1">
                        <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-500 dark:text-slate-400">@AppControll.maxUsers</dt>
                        <dd class="mt-1 text-sm font-medium @(Users is not null && Users.Count > tenant.MaxUsers ? "text-rose-600 dark:text-rose-400" : "text-slate-900 dark:text-slate-100")">
                            @(Users?.Count ?? 0) / @tenant.MaxUsers
                        </dd>
                    </div>
                    <div class="rounded-2xl border border-slate-200 bg-slate-50/80 shadow-sm dark:border-slate-800 dark:bg-slate-900/60 px-3 py-1 sm:col-span-2">
                        <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-500 dark:text-slate-400">Kontakt</dt>
                        <dd class="mt-1 grid gap-1 text-sm text-slate-700 dark:text-slate-200 sm:grid-cols-2">
                            <div><span class="font-medium">@ResourceIdentity.email:</span> @tenant.Email</div>
                            <div><span class="font-medium">@ResourceIdentity.phone:</span> @tenant.Phone</div>
                            <div><span class="font-medium">@ResourceIdentity.mobile:</span> @tenant.Mobile</div>
                            <div><span class="font-medium">@ResourceIdentity.fax:</span> @tenant.Fax</div>
                            <div><span class="font-medium">@ResourceIdentity.country:</span> @tenant.Country</div>
                            <div><span class="font-medium">@ResourceIdentity.build:</span> @tenant.BuildNumber</div>
                        </dd>
                    </div>
                </dl>
            </section>

            <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-950/80 px-3 py-1">
                <div class="flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between">
                    <div>
                        <div class="flex flex-wrap items-center gap-2">
                            <div class="text-sm font-semibold text-slate-900 dark:text-slate-100">Hyresgästens användare</div>
                            @if (Users is not null && Users.Any())
                            {
                                <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-2 py-0.5 text-[11px] font-medium text-slate-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200">@Users.Count</span>
                                @if (LockedUsersCount > 0)
                                {
                                    <span class="inline-flex items-center rounded-full border border-amber-200 bg-amber-50 px-2 py-0.5 text-[11px] font-medium text-amber-700 dark:border-amber-900/60 dark:bg-amber-950/40 dark:text-amber-200">@LockedUsersCount Låsta</span>
                                }
                            }
                        </div>
                        <div class="mt-1 text-xs text-slate-600 dark:text-slate-400">Visa kopplade användare och utför administrativa åtgärder.</div>
                    </div>
                    <div class="flex flex-wrap items-center gap-2">
                        @if (CanManageTenantUsers)
                        {
                            <button class="inline-flex items-center justify-center gap-2 rounded-xl px-1 py-1 text-xs font-medium transition focus:outline-none focus:ring-2 disabled:cursor-not-allowed disabled:opacity-60 inline-flex items-center justify-center gap-2 rounded-xl border border-sky-600 bg-sky-600 px-1 py-1 text-xs font-medium text-white transition hover:bg-sky-700 focus:outline-none focus:ring-2 focus:ring-sky-500/30 disabled:cursor-not-allowed disabled:opacity-60 dark:border-sky-500 dark:bg-sky-500 dark:hover:bg-sky-400" @onclick="() => UserRoleDialog(new ApplicationUser() { Id = string.Empty })">Ny användare</button>
                        }

                        @if (Users == null || !Users.Any())
                        {
                            <button class="inline-flex items-center justify-center gap-2 rounded-xl px-1 py-1 text-xs font-medium transition focus:outline-none focus:ring-2 disabled:cursor-not-allowed disabled:opacity-60 inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-1 py-1 text-xs font-medium text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-400/30 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800" @onclick="async () => await GetUsersAsync()">@ResourceIdentity.users</button>
                        }
                    </div>
                </div>

                @if (Users == null || !Users.Any())
                {
                    <div class="flex min-h-[180px] flex-col items-center justify-center rounded-2xl border border-dashed border-slate-300 bg-slate-50/70 px-4 py-8 text-center dark:border-slate-700 dark:bg-slate-900/40 mt-4 min-h-[220px]">
                        <div class="text-sm font-semibold text-slate-900 dark:text-slate-100">Inga användare laddade</div>
                        <div class="mt-1 max-w-xl text-sm text-slate-600 dark:text-slate-400">Ladda hyresgästens användare för att se låsningsstatus, avdelningstillhörighet och lägga till grundläggande företagsinformation.</div>
                    </div>
                }
                else
                {
                    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-950/80 mt-1">
                        <div class="overflow-x-auto">
                            <table class="min-w-full divide-y divide-slate-200 text-sm dark:divide-slate-800">
                                <thead>
                                    <tr>
                                        <th class="px-1 py-1 text-left text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">@ResourceIdentity.email</th>
                                        <th class="px-1 py-1 text-left text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">@CalcResource.code</th>
                                        <th class="px-1 py-1 text-left text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">@CalcResource.name</th>
                                        <th class="px-1 py-1 text-left text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">@ResourceIdentity.lockoutEnd</th>
                                        <th class="px-1 py-1 text-left text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">@ResourceIdentity.lockoutStart</th>
                                        <th class="px-1 py-1 text-left text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">@ResourceApp.department</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var user in Users)
                                    {
                                        <tr @oncontextmenu:preventDefault @oncontextmenu="() => Context(user)">
                                            <td class="px-1 py-1 align-top text-sm text-slate-700 dark:text-slate-200">@user.Email</td>
                                            <td class="px-1 py-1 align-top text-sm text-slate-700 dark:text-slate-200">@user.UserName</td>
                                            <td class="px-1 py-1 align-top text-sm text-slate-700 dark:text-slate-200">@user.Firstname @user.Lastname</td>
                                            <td class="px-1 py-1 align-top text-sm text-slate-700 dark:text-slate-200">
                                                <div class="flex items-center gap-2">
                                                    @if (IsLocked(user))
                                                    {
                                                        <span class="inline-flex items-center rounded-full border border-amber-200 bg-amber-50 px-2.5 py-1 text-[11px] font-medium text-amber-700 dark:border-amber-900/60 dark:bg-amber-950/40 dark:text-amber-200">Låst</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[11px] font-medium text-slate-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200">Öppen</span>
                                                    }
                                                </div>
                                                <div class="mt-1 text-xs text-slate-500 dark:text-slate-400">@(user.LockoutEnd.HasValue ? user.LockoutEnd.Value.ToString("dd.MM.yyyy") :"—")</div>
                                            </td>
                                            <td class="px-1 py-1 align-top text-sm text-slate-700 dark:text-slate-200">@(user.LockoutStart.HasValue ? user.LockoutStart.Value.ToString("dd.MM.yyyy") :"—")</td>
                                            <td class="px-1 py-1 align-top text-sm text-slate-700 dark:text-slate-200">@DepartmentName(user.DepartmentId)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

            </section>
        </div>
    }
</div>

@code {
    bool IsSeedingDefaults;
    bool IsSeedingSampleData;

    const string SeedTitle = "Initiera standardinställningar";
    const string SampleTitle = "Generera exempeldata";

    void AskInitializeDefaults()
    {
        if (!CanManageTenantUsers || Id <= 0 || IsSeedingDefaults)
            return;

        MHD.MessageYesNo(
            SeedTitle,
            "Detta skapar saknade standardinställningar för hyresgästen (statusar, konton, avdelningar, projekt- och upphandlingslistor). Befintliga objekt lämnas oförändrade. Vill du fortsätta?",
            MhdState.Warning,
            EventCallback.Factory.Create(this, InitializeDefaultsAsync));
    }

    async Task InitializeDefaultsAsync()
    {
        if (IsSeedingDefaults || Id <= 0)
            return;

        IsSeedingDefaults = true;
        try
        {
            await Modal.CloseAsync();
            var result = await ExHandlers.RunCheckTokenAsync(() => UsersService.AddBasicCompanyInfoAsync(Id, null));

            if (result is null)
            {
                MHD.MessageOk(SeedTitle, "Åtgärden kunde inte slutföras.", MhdState.Danger);
                return;
            }

            var message = result.AnyChanges
                ? $"Klart. Skapade {result.Created}, uppdaterade {result.Updated} objekt."
                : "Allt är redan uppdaterat – inga ändringar behövdes.";

            MHD.MessageOk(SeedTitle, message, result.AnyChanges ? MhdState.Success : MhdState.Info);
        }
        finally
        {
            IsSeedingDefaults = false;
            StateHasChanged();
        }
    }

    void AskGenerateSampleData()
    {
        if (!CanManageTenantUsers || Id <= 0 || IsSeedingSampleData)
            return;

        // Sample records must be owned by a real tenant user, so guard before asking to proceed.
        if (Users is null || !Users.Any())
        {
            MHD.MessageOk(SampleTitle, "Lägg till minst en användare för hyresgästen innan du genererar exempeldata.", MhdState.Info);
            return;
        }

        MHD.MessageYesNo(
            SampleTitle,
            "Detta skapar en exempelmapp med projekt, kalkyler och några aktiviteter och resurser så att hyresgästen får demoinnehåll. Hoppas över om exempelmappen redan finns. Vill du fortsätta?",
            MhdState.Warning,
            EventCallback.Factory.Create(this, GenerateSampleDataAsync));
    }

    async Task GenerateSampleDataAsync()
    {
        if (IsSeedingSampleData || Id <= 0)
            return;

        IsSeedingSampleData = true;
        try
        {
            await Modal.CloseAsync();
            var result = await ExHandlers.RunCheckTokenAsync(() => UsersService.AddSampleProjectDataAsync(Id, null));

            if (result is null)
            {
                MHD.MessageOk(SampleTitle, "Åtgärden kunde inte slutföras.", MhdState.Danger);
                return;
            }

            var message = result.AnyChanges
                ? $"Klart. Skapade {result.Created}, uppdaterade {result.Updated} objekt."
                : "Exempeldata finns redan – inga ändringar behövdes.";

            MHD.MessageOk(SampleTitle, message, result.AnyChanges ? MhdState.Success : MhdState.Info);
        }
        finally
        {
            IsSeedingSampleData = false;
            StateHasChanged();
        }
    }
}
