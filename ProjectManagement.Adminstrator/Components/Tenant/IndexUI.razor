@using Domain.Repository.AuthPermissions
@using ProjectManagement.Adminstrator.Services.Users
@using ProjectManagement.Shared.DTO.Tenant
@attribute [Authorize(Roles = PMRolesConst.APP.AdminManger)]
@inherits AppComponentBase
@inject IUsersService sersService

@if (DetailsPage != null)
{
    <DetailsUI Id="@DetailsPage.Id" Callback="() => DetailsPage = null"></DetailsUI>
}
else
{
    <div class="pm-page">
        <section class="pm-card overflow-hidden">
            <div class="pm-card-header">
                <div>
                    <h2 class="pm-title">@AppControll.tenant</h2>
                    <p class="pm-subtitle mt-1">Manage tenant accounts, expiry dates, database mapping, and linked users.</p>
                </div>

                <div class="pm-toolbar">
                    <span class="pm-chip">@(Tenants?.Count ?? 0)</span>
                    @if (CanManageTenants)
                    {
                        <button class="pm-btn-success" @onclick="() => UpdateForm(new())">@ResourceApp.newItem</button>
                    }
                </div>
            </div>

            <div class="pm-card-body">
                @if (Tenants is null || Tenants.Count == 0)
                {
                    <div class="pm-empty">@AppLoc[nameof(ResourceApp.ThereAreNoItemsToDisplay)]</div>
                }
                else
                {
                    <div class="pm-table-wrap">
                        <table class="pm-table">
                            <thead>
                                <tr>
                                    <th>@CalcResource.name</th>
                                    <th>@AppControll.Db</th>
                                    <th>@AppControll.dateExpire</th>
                                    <th>@AppControll.hasOwnDb</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var tenant in Tenants)
                                {
                                    <tr class="cursor-pointer"
                                        @onclick="() => DetailsPage = tenant"
                                        @oncontextmenu:preventDefault
                                        @oncontextmenu="() => Context(tenant)">
                                        <td>
                                            <div class="font-medium text-slate-900 dark:text-slate-100">@tenant.Name</div>
                                        </td>
                                        <td>
                                            <div class="break-words">@tenant.DB @tenant.DatabaseInfoName</div>
                                        </td>
                                        <td>
                                            @(tenant.DateExpire.HasValue ? tenant.DateExpire.Value.ToString("dd.MM.yyyy") : string.Empty)
                                        </td>
                                        <td>
                                            @if (tenant.HasOwnDb)
                                            {
                                                <span class="pm-chip-blue">Yes</span>
                                            }
                                            else
                                            {
                                                <span class="pm-chip">No</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </section>
    </div>
}
