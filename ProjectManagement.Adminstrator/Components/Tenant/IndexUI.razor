@using Domain.Repository.AuthPermissions
@using ProjectManagement.Adminstrator.Services.Users
@using ProjectManagement.Shared.DTO.Tenant;
@attribute [Authorize(Roles = PMRolesConst.APP.AdminManger)]
@inherits AppComponentBase
@inject IUsersService sersService

@if (DetailsPage != null)
{
    <DetailsUI Id="@DetailsPage.Id" Callback="() => DetailsPage = null"></DetailsUI>
}
else
{
    <div class="space-y-1">
        <div class="flex flex-col gap-2 rounded-[14px] border border-slate-200/80 bg-white/90 px-3 py-1 shadow-sm dark:border-slate-800 dark:bg-slate-950/90 lg:flex-row lg:items-start lg:justify-between">
            <div class="max-w-3xl">
                <p class="mt-2 text-sm leading-6 text-slate-500 dark:text-slate-400">
                    Review tenant databases, expiry dates, and ownership model. Right-click rows for contextual actions and click any tenant to open details.
                </p>
            </div>

            @if (CanManageTenants)
            {
                <button class="inline-flex items-center rounded-xl bg-blue-600 px-3 py-1.5 text-sm font-medium text-white shadow-sm transition hover:bg-blue-700 dark:bg-blue-500 dark:hover:bg-blue-400" @onclick="() => UpdateForm(new())">
                    @ResourceApp.newItem
                </button>
            }
        </div>

        <!-- Summary stats -->
        <div class="grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-6">
            <div class="rounded-[14px] border border-slate-200/80 bg-white/95 px-3 py-2 shadow-sm dark:border-slate-800 dark:bg-slate-950/95">
                <div class="text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400">Total</div>
                <div class="mt-0.5 text-xl font-bold text-slate-900 dark:text-slate-100">@TotalCount</div>
            </div>
            <div class="rounded-[14px] border border-slate-200/80 bg-white/95 px-3 py-2 shadow-sm dark:border-slate-800 dark:bg-slate-950/95">
                <div class="text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400">Dedicated</div>
                <div class="mt-0.5 text-xl font-bold text-blue-700 dark:text-blue-300">@DedicatedCount</div>
            </div>
            <div class="rounded-[14px] border border-slate-200/80 bg-white/95 px-3 py-2 shadow-sm dark:border-slate-800 dark:bg-slate-950/95">
                <div class="text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400">Shared</div>
                <div class="mt-0.5 text-xl font-bold text-slate-700 dark:text-slate-300">@SharedCount</div>
            </div>
            <div class="rounded-[14px] border border-amber-200/80 bg-amber-50/70 px-3 py-2 shadow-sm dark:border-amber-900/60 dark:bg-amber-950/30">
                <div class="text-[11px] font-semibold uppercase tracking-[0.14em] text-amber-700 dark:text-amber-300">Expiring ≤30d</div>
                <div class="mt-0.5 text-xl font-bold text-amber-700 dark:text-amber-300">@ExpiringSoonCount</div>
            </div>
            <div class="rounded-[14px] border border-rose-200/80 bg-rose-50/70 px-3 py-2 shadow-sm dark:border-rose-900/60 dark:bg-rose-950/30">
                <div class="text-[11px] font-semibold uppercase tracking-[0.14em] text-rose-700 dark:text-rose-300">Expired</div>
                <div class="mt-0.5 text-xl font-bold text-rose-700 dark:text-rose-300">@ExpiredCount</div>
            </div>
            <div class="rounded-[14px] border border-slate-200/80 bg-white/95 px-3 py-2 shadow-sm dark:border-slate-800 dark:bg-slate-950/95">
                <div class="text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400">Blocked</div>
                <div class="mt-0.5 text-xl font-bold text-slate-700 dark:text-slate-300">@BlockedCount</div>
            </div>
        </div>

        <!-- Search -->
        <div class="flex items-center justify-between gap-3 rounded-[14px] border border-slate-200/80 bg-white/95 px-3 py-2 shadow-sm dark:border-slate-800 dark:bg-slate-950/95">
            <input type="search"
                   placeholder="Search by name or database…"
                   value="@Search"
                   @oninput="@(e => Search = e.Value?.ToString() ?? string.Empty)"
                   class="w-full max-w-sm rounded-xl border border-slate-300 bg-white px-3 py-1.5 text-sm text-slate-900 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" />
            <span class="shrink-0 rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-700 dark:bg-slate-800 dark:text-slate-200">
                @FilteredTenants.Count / @TotalCount
            </span>
        </div>

        <div class="overflow-hidden rounded-[14px] border border-slate-200/80 bg-white/95 shadow-sm dark:border-slate-800 dark:bg-slate-950/95">
            <div class="overflow-x-auto p-1">
                <table class="min-w-full overflow-hidden rounded-[14px] border border-slate-200/80 text-sm dark:border-slate-800">
                    <thead class="bg-slate-100/80 dark:bg-slate-900/90">
                        <tr>
                            <th class="px-0.5 py-0.5 text-start text-sm font-semibold text-slate-700 dark:text-slate-200">@CalcResource.name</th>
                            <th class="px-0.5 py-0.5 text-start text-sm font-semibold text-slate-700 dark:text-slate-200">@AppControll.Db</th>
                            <th class="px-0.5 py-0.5 text-start text-sm font-semibold text-slate-700 dark:text-slate-200">@ResourceIdentity.users</th>
                            <th class="px-0.5 py-0.5 text-start text-sm font-semibold text-slate-700 dark:text-slate-200">@AppControll.dateExpire</th>
                            <th class="px-0.5 py-0.5 text-start text-sm font-semibold text-slate-700 dark:text-slate-200">Model</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200/80 bg-white dark:divide-slate-800 dark:bg-slate-950">
                        @if (FilteredTenants.Any())
                        {
                            foreach (var tenant in FilteredTenants)
                            {
                                <tr class="cursor-pointer align-top transition hover:bg-slate-50 dark:hover:bg-slate-900/40"
                                    @onclick="() => DetailsPage = tenant"
                                    @oncontextmenu:preventDefault
                                    @oncontextmenu="() => Context(tenant)">
                                    <td class="px-0.5 py-0.5 text-[15px] font-medium text-slate-900 dark:text-slate-100">
                                        <div class="flex items-center gap-2">
                                            <span>@tenant.Name</span>
                                            @if (tenant.IsBlocked)
                                            {
                                                <span class="inline-flex items-center rounded-full border border-rose-200 bg-rose-50 px-2 py-0.5 text-[11px] font-semibold text-rose-700 dark:border-rose-900/60 dark:bg-rose-950/40 dark:text-rose-300">Blocked</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="px-0.5 py-0.5">
                                        <div class="font-medium text-slate-900 dark:text-slate-100">@tenant.DB</div>
                                    </td>
                                    <td class="px-0.5 py-0.5 text-[15px] text-slate-700 dark:text-slate-200">@tenant.UsersCount</td>
                                    <td class="px-0.5 py-0.5 text-[15px]">
                                        @if (IsExpired(tenant))
                                        {
                                            <span class="inline-flex items-center rounded-full border border-rose-200 bg-rose-50 px-2.5 py-0.5 text-xs font-semibold text-rose-700 dark:border-rose-900/60 dark:bg-rose-950/40 dark:text-rose-300">
                                                @tenant.DateExpire!.Value.ToString("dd.MM.yyyy")
                                            </span>
                                        }
                                        else if (IsExpiringSoon(tenant))
                                        {
                                            <span class="inline-flex items-center rounded-full border border-amber-200 bg-amber-50 px-2.5 py-0.5 text-xs font-semibold text-amber-700 dark:border-amber-900/60 dark:bg-amber-950/40 dark:text-amber-300">
                                                @tenant.DateExpire!.Value.ToString("dd.MM.yyyy")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-slate-700 dark:text-slate-200">@(tenant.DateExpire.HasValue ? tenant.DateExpire.Value.ToString("dd.MM.yyyy") : "—")</span>
                                        }
                                    </td>
                                    <td class="px-0.5 py-0.5">
                                        <span class="inline-flex rounded-full border px-3 py-1 text-xs font-medium @(tenant.HasOwnDb
                                            ? "border-blue-200 bg-blue-50 text-blue-700 dark:border-blue-900/70 dark:bg-blue-950/40 dark:text-blue-200"
                                            : "border-slate-200 bg-slate-50 text-slate-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300")">
                                            @(tenant.HasOwnDb ? "Dedicated" : "Shared")
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="px-3.5 py-8 text-center text-sm text-slate-500 dark:text-slate-400">
                                    @AppLoc[nameof(ResourceApp.ThereAreNoItemsToDisplay)]
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
