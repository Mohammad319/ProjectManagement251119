@using Domain.Repository.AuthPermissions
@using ProjectManagement.Adminstrator.Services.Users
@using ProjectManagement.Shared.DTO.Tenant;
@attribute [Authorize(Roles = PMRolesConst.APP.AdminManger)]
@inherits AppComponentBase
@inject IUsersService sersService

@if (DetailsPage != null)
{
    <DetailsUI Id="@DetailsPage.Id" Callback="() => DetailsPage = null"></DetailsUI>
}
else
{
    <div class="mb-3">
        @if (CanManageTenants)
        {
            <button class="inline-flex items-center rounded-lg border border-emerald-300 bg-emerald-50 px-4 py-2 text-sm font-medium text-emerald-700 transition hover:bg-emerald-100 dark:border-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-300 dark:hover:bg-emerald-900/50" @onclick="() => UpdateForm(new())">
                @ResourceApp.newItem
            </button>
        }
    </div>

    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-950">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-200 text-sm dark:divide-slate-800">
                <thead class="bg-slate-50 dark:bg-slate-900/60">
                    <tr>
                        <th class="px-4 py-3 text-start font-semibold text-slate-700 dark:text-slate-200">@CalcResource.name</th>
                        <th class="px-4 py-3 text-start font-semibold text-slate-700 dark:text-slate-200">@AppControll.Db</th>
                        <th class="px-4 py-3 text-start font-semibold text-slate-700 dark:text-slate-200">@AppControll.dateExpire</th>
                        <th class="px-4 py-3 text-start font-semibold text-slate-700 dark:text-slate-200">@AppControll.hasOwnDb</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 bg-white dark:divide-slate-800 dark:bg-slate-950">
                    @if (Tenants != null)
                    {
                        foreach (var tenant in Tenants)
                        {
                            <tr class="cursor-pointer transition hover:bg-slate-50 dark:hover:bg-slate-900/40"
                                @onclick="() => DetailsPage = tenant"
                                @oncontextmenu:preventDefault
                                @oncontextmenu="() => Context(tenant)">
                                <td class="px-4 py-3 text-slate-700 dark:text-slate-200">@tenant.Name</td>
                                <td class="px-4 py-3 text-slate-700 dark:text-slate-200">@tenant.DB @tenant.DatabaseInfoName</td>
                                <td class="px-4 py-3 text-slate-700 dark:text-slate-200">
                                    @(tenant.DateExpire.HasValue ? tenant.DateExpire.Value.ToString("dd.MM.yyyy") : string.Empty)
                                </td>
                                <td class="px-4 py-3 text-slate-700 dark:text-slate-200">
                                    <input type="checkbox" class="h-4 w-4 rounded border-slate-300 text-sky-600 focus:ring-sky-500 dark:border-slate-600 dark:bg-slate-800" checked="@tenant.HasOwnDb" disabled />
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}
