@using Microsoft.Extensions.Configuration
@attribute [Authorize(Roles = PMRolesConst.APP.AdminManger)]
@inherits AppComponentBase
@inject IConfiguration Configuration

<div class="flex h-[calc(100vh-120px)] flex-col gap-2 text-slate-900 dark:text-slate-100">

    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-base font-semibold text-slate-900 dark:text-slate-100">Seq – Log Analysis</h2>
            <p class="text-xs text-slate-500 dark:text-slate-400">Logs from both <strong>ProjectManagement.Server</strong> and <strong>ProjectManagement.Admin</strong></p>
        </div>
        <a href="@_seqUrl" target="_blank" rel="noopener noreferrer"
           class="inline-flex items-center gap-1.5 rounded-xl border border-sky-600 bg-sky-600 px-3 py-2 text-xs font-medium text-white transition hover:bg-sky-700 dark:border-sky-500 dark:bg-sky-500 dark:hover:bg-sky-400">
            Open in new tab ↗
        </a>
    </div>

    <div class="flex-1 overflow-hidden rounded-2xl border border-slate-200 shadow-sm dark:border-slate-800">
        <iframe src="@_seqUrl"
                class="h-full w-full border-0"
                title="Seq Log Viewer"
                sandbox="allow-same-origin allow-scripts allow-forms allow-popups allow-popups-to-escape-sandbox">
        </iframe>
    </div>

</div>

@code {
    private string _seqUrl = "http://localhost:5341";

    protected override void OnInitialized()
    {
        _seqUrl = Configuration["SeqUrl"] ?? "http://localhost:5341";
    }
}
