@using Microsoft.EntityFrameworkCore
@using TaskResourceBlueprints.Entities
@using TaskResourceBlueprints.Entities.Resources
@using TaskResourceBlueprints.Infrastructure
@using TaskResourceBlueprints.Services.ResourceProperties
@using TaskResourceBlueprints.Services.UnitGroups
@using ProjectManagement.Adminstrator.Components.Property.Properties
@using ProjectManagement.Adminstrator.Constants
@inherits AppComponentBase
@inject IResourceAttributeSetService GroupPropertiesService

<div class="space-y-3">
    <div class="flex items-center justify-between gap-1 rounded-xl border border-slate-200 bg-white p-1 shadow-sm dark:border-slate-800 dark:bg-slate-950">
        <button @onclick="UpdateForm"
                class="inline-flex shrink-0 items-center justify-center rounded-xl bg-emerald-600 px-1 py-1 text-sm font-medium text-white shadow-sm transition hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-500/40"
                title="@AppLoc[nameof(ResourceApp.newItem)]">
            <span>@ResourceApp.newItem</span>
        </button>

        <p class="m-0 text-sm leading-6 text-slate-500 dark:text-slate-400">
            Manage property groups and open the properties inside each group.
        </p>
    </div>

    @if (ActionsTasks.Any())
    {
        <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-950">
            <div class="overflow-x-auto p-1">
                <MhdTable TItem="ResourceAttributeSet" Items="ActionsTasks">
                    <HeaderTemplate>
                        <th style="width:220px;" class="px-1 py-1 text-left text-xs font-semibold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-300">Actions</th>
                        <th class="px-1 py-1 text-left text-xs font-semibold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-300">@CalcResource.name</th>
                    </HeaderTemplate>
                    <ChildContent>
                        <MhdTableColumn>
                            <Template Context="status">
                                <div class="flex flex-wrap items-center gap-1">
                                    <button @onclick="() => Properties(status)"
                                            class="inline-flex items-center rounded-xl bg-blue-600 px-3.5 py-2 text-xs font-medium text-white transition hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500/40"
                                            title="@AppLoc["properties"]" aria-label="@AppLoc["properties"]">
                                        @AppLoc["properties"]
                                    </button>
                                    <button @onclick="() => UpdateForm(status)"
                                            class="inline-flex items-center rounded-xl bg-amber-500 px-3.5 py-2 text-xs font-medium text-white transition hover:bg-amber-600 focus:outline-none focus:ring-2 focus:ring-amber-500/40"
                                            title="@ResourceApp.update" aria-label="@ResourceApp.update">
                                        @Icons.Edit
                                    </button>
                                    <button @onclick="() => Remove(status)"
                                            class="inline-flex items-center rounded-xl bg-rose-600 px-3.5 py-2 text-xs font-medium text-white transition hover:bg-rose-700 focus:outline-none focus:ring-2 focus:ring-rose-500/40"
                                            title="@ResourceApp.delete" aria-label="@ResourceApp.delete">
                                        @Icons.Delete
                                    </button>
                                </div>
                            </Template>
                        </MhdTableColumn>
                        <MhdTableColumn Title="" ValueSelector="c => c.DisplayName"></MhdTableColumn>
                    </ChildContent>
                </MhdTable>
            </div>
        </div>
    }
    else
    {
        <div class="rounded-xl border border-dashed border-slate-200 bg-white px-1 py-8 text-center shadow-sm dark:border-slate-700 dark:bg-slate-950">
            <div class="space-y-2">
                <div class="text-lg font-medium text-slate-900 dark:text-slate-100">No property groups yet</div>
                <div class="text-sm text-slate-500 dark:text-slate-400">Create the first group to organize resource properties.</div>
            </div>
        </div>
    }
</div>

@code {
    List<ResourceAttributeSet> ActionsTasks = [];
    void UpdateForm() => UpdateForm(new ResourceAttributeSet() { DisplayName = AppLoc["propertyGroupDefaultName"] });
    void UpdateForm(ResourceAttributeSet model)
    {
        ResourceAttributeSet up = new() { DisplayName = "" };
        PropertyCopier.CopyPropertiesTo(model, up);

        Modal.ShowComponent<PropertyGroupsFormUI>(model.Id == 0 ? AppLoc[LocalizerConst.New, AppLoc["properties"]] :
            AppLoc[LocalizerConst.Update, model.DisplayName], new Dictionary<string, object>
                {
                [nameof(PropertyGroupsFormUI.Model)] = up,
                [nameof(PropertyGroupsFormUI.Callback)] = EventCallback.Factory.Create<bool>(this, BtnUpdate)
                }
            , DialogSize.Medium);
    }
    void Properties(ResourceAttributeSet model)
    {
        Modal.ShowComponent<PropertyResourceIndexUI>(AppLoc["properties"], new Dictionary<string, object>
            {
            [nameof(PropertyResourceIndexUI.GroupId)] = model.Id,
            } , DialogSize.Large);
    }
    void Remove(ResourceAttributeSet model) =>
    MHD.DeleteMessage(model.DisplayName, EventCallback.Factory.Create(this, () => ConfirmRemoveAsync(model)));

    async Task ConfirmRemoveAsync(ResourceAttributeSet model)
    {
        bool result = await GroupPropertiesService.DeleteAsync(model.Id);
        if (result)
        {
            ActionsTasks.Remove(model);
        }
        MHD.Notifications(ToastType.Delete, result);
        StateHasChanged();
    }
    async Task BtnUpdate(bool IsSuccess)
    {
        Modal.Close();
        if (IsSuccess)
        {
            ActionsTasks = await GroupPropertiesService.GetAllAsync();
        }
        StateHasChanged();
    }

    protected async override Task OnInitializedAsync()
    {
        ActionsTasks = await GroupPropertiesService.GetAllAsync();
        StateHasChanged();
    }
}
