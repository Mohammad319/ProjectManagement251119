@using TaskResourceBlueprints.Entities
@using TaskResourceBlueprints.Entities.Resources
@inherits AppComponentBase
@inject IResourceAttributeSetService GroupPropertiesService
@using TaskResourceBlueprints.Services.ResourceProperties

<EditForm id="myForm" class="space-y-4 px-1 py-1" Model="@Model"
          OnValidSubmit="async () => await HandleSubmitAsync()">
    <DataAnnotationsValidator />

    <div>
        <div>
            <label class="mb-2 block text-sm font-medium text-slate-700 dark:text-slate-200" for="name-input">@CalcResource.name:</label>
            <InputText id="name-input" class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
                       @bind-Value="Model.DisplayName"
                       aria-invalid="@(EditContext?.GetValidationMessages(() => Model.DisplayName).Any() == true)" />

            <ValidationMessage For="() => Model.DisplayName" class="mt-1 text-sm text-rose-600 dark:text-rose-400" />
        </div>
    </div>
</EditForm>

<div class="mt-6 flex flex-wrap items-center justify-end gap-3 border-t border-slate-200 pt-4 dark:border-slate-800">
    <button type="submit"
            class="inline-flex items-center rounded-xl bg-emerald-600 px-4 py-2 text-sm font-medium text-white shadow-sm transition hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-500/40"
            form="myForm"
            disabled="@IsLoading"
            aria-busy="@IsLoading">
        @ResourceApp.save
    </button>

    <button type="button"
            class="inline-flex items-center rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
            @onclick="async () => await Callback.InvokeAsync(false)">
        @ResourceApp.cancel
    </button>
</div>

@code {
    [CascadingParameter] private EditContext? EditContext { get; set; }
    [Parameter] public ResourceAttributeSet Model { get; set; } = new () { DisplayName = "name" };
    [Parameter] public EventCallback<bool> Callback { get; set; }
    bool IsLoading = false;
    private async Task HandleSubmitAsync()
    {
        IsLoading = true;
        bool result = false;
        if (Model.Id == 0)
        {
            var id = await GroupPropertiesService.CreateAsync(Model);
            result = id > 0;
        }
        else result = await GroupPropertiesService.UpdateAsync(Model);

        MHD.Notifications(Model.Id == 0 ? ToastType.Add : ToastType.Update, result);
        await Callback.InvokeAsync(result);
    }
}
