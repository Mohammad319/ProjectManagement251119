@using TaskResourceBlueprints.Entities
@using TaskResourceBlueprints.Entities.Resources
@inherits AppComponentBase
@inject IResourceAttributeSetService GroupPropertiesService
@using TaskResourceBlueprints.Services.ResourceProperties

<section class="pm-page">
    <div class="pm-card">
        <div class="pm-card-header">
            <div>
                <h3 class="pm-card-title">Property group</h3>
                <p class="pm-card-subtitle">Create or rename the group that holds related resource attributes.</p>
            </div>
        </div>

        <div class="pm-card-body">
            <EditForm id="myForm" class="space-y-5 px-1 py-1" Model="@Model" OnValidSubmit="HandleSubmitAsync">
                <DataAnnotationsValidator />

                <div>
                    <label class="pm-label" for="name-input">@CalcResource.name</label>
                    <InputText id="name-input"
                               class="pm-input"
                               @bind-Value="Model.DisplayName"
                               aria-invalid="@(EditContext?.GetValidationMessages(() => Model.DisplayName).Any() == true)" />
                    <ValidationMessage For="() => Model.DisplayName" class="mt-1 text-sm text-rose-600 dark:text-rose-400" />
                </div>
            </EditForm>
        </div>
    </div>

    <div class="pm-divider pt-4">
        <div class="pm-toolbar justify-end">
            <button type="submit" class="pm-btn pm-btn-primary" form="myForm" disabled="@IsLoading" aria-busy="@IsLoading">
                @ResourceApp.save
            </button>
            <button type="button" class="pm-btn pm-btn-secondary" @onclick="async () => await Callback.InvokeAsync(false)">
                @ResourceApp.cancel
            </button>
        </div>
    </div>
</section>

@code {
    [CascadingParameter] private EditContext? EditContext { get; set; }
    [Parameter] public ResourceAttributeSet Model { get; set; } = new() { DisplayName = "name" };
    [Parameter] public EventCallback<bool> Callback { get; set; }

    private bool IsLoading = false;

    private async Task HandleSubmitAsync()
    {
        IsLoading = true;
        bool result = false;
        if (Model.Id == 0)
        {
            var id = await GroupPropertiesService.CreateAsync(Model);
            result = id > 0;
        }
        else
        {
            result = await GroupPropertiesService.UpdateAsync(Model);
        }

        MHD.Notifications(Model.Id == 0 ? ToastType.Add : ToastType.Update, result);
        await Callback.InvokeAsync(result);
    }
}
