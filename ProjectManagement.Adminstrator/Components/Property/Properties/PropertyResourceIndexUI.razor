@using Microsoft.EntityFrameworkCore
@using TaskResourceBlueprints.Entities
@using TaskResourceBlueprints.Entities.Resources
@using TaskResourceBlueprints.Infrastructure
@using TaskResourceBlueprints.Services.ResourceProperties
@using ProjectManagement.Adminstrator.Constants
@inherits AppComponentBase
@inject IResourceAttributeService ResourcePropertiesService

<button @onclick="() => UpdateForm()"
        class="inline-flex items-center justify-center rounded-xl bg-emerald-600 px-3 py-2 text-sm font-medium text-white shadow-sm transition hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-500/40"
        title="إضافة" aria-label="إضافة">
    @((MarkupString)Icons.Plus)
</button>
<MhdTable TItem="ResourceAttribute" Items="PropertiesList?.Where(x => SelectedGroupId == 0 || x.AttributeSetId == SelectedGroupId)">
    <HeaderTemplate>
        <th style="width:200px;" class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-300"></th>
        <th style="width:200px;" class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-300">@CalcResource.code</th>
        <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-300">@CalcResource.name</th>
    </HeaderTemplate>
    <ChildContent>
        <MhdTableColumn>
            <Template Context="status">
                <div class="flex items-center gap-2">
                    <button @onclick="() => UpdateForm(status)"
                            class="inline-flex items-center rounded-xl bg-amber-500 px-3 py-2 text-xs font-medium text-white transition hover:bg-amber-600 focus:outline-none focus:ring-2 focus:ring-amber-500/40"
                            title="@ResourceApp.update" aria-label="@ResourceApp.update">
                        @Icons.Edit
                    </button>

                    <button @onclick="() => Remove(status)"
                            class="inline-flex items-center rounded-xl bg-rose-600 px-3 py-2 text-xs font-medium text-white transition hover:bg-rose-700 focus:outline-none focus:ring-2 focus:ring-rose-500/40"
                            title="@ResourceApp.delete"
                            aria-label="@ResourceApp.delete">
                        @Icons.Delete 
                    </button>
                </div>
            </Template>
        </MhdTableColumn>
        <MhdTableColumn Title="" ValueSelector="@(c => "p" + c.Id)"></MhdTableColumn>
        <MhdTableColumn Title="" ValueSelector="c => c.DisplayName"></MhdTableColumn>
    </ChildContent>
</MhdTable>
@code {
    [Parameter] public int GroupId { get; set; } = new();
    List<ResourceAttribute> PropertiesList = new(); 

    void Remove(ResourceAttribute model) =>
MHD.DeleteMessage(model.DisplayName, EventCallback.Factory.Create(this, () => ConfirmRemoveAsync(model)));

    async Task ConfirmRemoveAsync(ResourceAttribute model)
    {
        if (await ResourcePropertiesService.DeleteAsync(model.Id))
        {
            PropertiesList.Remove(model);
            MHD.Notifications(ToastType.Delete, true);
            StateHasChanged();
        }
    }
    void UpdateForm() => UpdateForm(new ResourceAttribute() { DisplayName = "" });
    void UpdateForm(ResourceAttribute model)
    {
        ResourceAttribute up = new() { DisplayName = "" };
        PropertyCopier.CopyPropertiesTo(model, up);
        up.AttributeSetId = GroupId;
        Modal.ShowComponent<PropertyResourceFormUI>(model.Id == 0 ? 
            AppLoc[LocalizerConst.New, ""] :
                    AppLoc[LocalizerConst.Update,"(p" + model.Id + ") ," + model.DisplayName], new Dictionary<string, object>
                    {
                        [nameof(PropertyResourceFormUI.GroupId)] = GroupId,
                        [nameof(PropertyResourceFormUI.ResourceProp)] = up,
                        [nameof(PropertyResourceFormUI.Callback)] = EventCallback.Factory.Create<bool>(this, BtnUpdate)
                    } , DialogSize.Medium);
    }

    async Task BtnUpdate(bool IsSuccess)
    {
        if (IsSuccess)
        {
            PropertiesList = await ResourcePropertiesService.GetByAttributeSetIdAsync(GroupId);
        }
        Modal.Close();
        StateHasChanged();
    }
    List<ResourceAttributeSet> Groups = new();
    int SelectedGroupId = 0;
    protected async override Task OnInitializedAsync()
    {
        PropertiesList = await ResourcePropertiesService.GetByAttributeSetIdAsync(GroupId);
    }
}
