@using ProjectManagement.Shared.DTO.ProjectAppStorage
@using TaskResourceBlueprints.Entities
@using TaskResourceBlueprints.Entities.Resources
@using TaskResourceBlueprints.Services.ResourceProperties
@using System.Globalization
@inherits AppComponentBase
@inject IResourceAttributeService ResourcePropertiesService

<section class="space-y-1 text-slate-900 dark:text-slate-100">
    <div class="overflow-hidden rounded-xl border border-slate-200 shadow-sm dark:border-slate-800 ">
        <div class="flex flex-wrap items-start justify-between gap-3 border-b border-slate-200 px-2 py-1 dark:border-slate-800">
            <div class="min-w-0">
                <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">Property attribute</h3>
                <p class="mt-0.5 text-xs text-slate-600 dark:text-slate-400">
                    Define how this property behaves and which default values it should use.
                </p>
            </div>
        </div>

        <div class="px-2 py-1">
            <EditForm id="propertyResourceForm" Model="@ResourceProp" OnValidSubmit="HandleSubmitAsync" class="space-y-3">
                <DataAnnotationsValidator />
                @if (!string.IsNullOrWhiteSpace(FormErrorMessage))
                {
                    <div class="rounded-xl border border-rose-200 bg-rose-50 px-3 py-2 text-sm text-rose-700 shadow-sm dark:border-rose-900/60 dark:bg-rose-950/40 dark:text-rose-300">
                        @FormErrorMessage
                    </div>
                }

                <div class="grid grid-cols-2 gap-1">
                    <div class="col-span-2 min-w-0 space-y-1.5">
                        <label class="@LabelClass" for="rp-name">
                            @CalcResource.name
                        </label>
                        <InputText id="rp-name"
                                   class="@InputClass"
                                   @bind-Value="@ResourceProp.DisplayName"
                                   aria-invalid="@(EditContext?.GetValidationMessages(() => ResourceProp.DisplayName).Any() == true)" />
                        <ValidationMessage For="@(() => ResourceProp.DisplayName)" class="@ValidationClass" />
                    </div>

                    <div class="col-span-2 rounded-lg border border-slate-200 p-1 dark:border-slate-800">
                        <label class="inline-flex items-center gap-1 text-slate-800 dark:text-slate-100">
                            <InputCheckbox id="rp-editable"
                                           class="h-4 w-4 rounded border-slate-300 text-sky-600 focus:ring-2 focus:ring-sky-500/20 dark:border-slate-600 dark:text-sky-500 dark:[color-scheme:dark]"
                                           @bind-Value="ResourceProp.IsUserEditable" />
                            <span class="text-sm font-medium text-slate-700 dark:text-slate-200">
                                Is editable by user
                            </span>
                        </label>
                    </div>

                    <div class="min-w-0 space-y-1.5">
                        <label class="@LabelClass" for="rp-kind">
                            Kind
                        </label>
                        <InputSelect id="rp-kind"
                                     class="@InputClass"
                                     @bind-Value="@ResourceProp.DataType">
                            @foreach (var kind in Enum.GetValues<DataType>())
                            {
                                <option value="@kind">@kind</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => ResourceProp.DataType)" class="@ValidationClass" />
                    </div>

                    @if (ResourceProp.DataType == DataType.Number)
                    {
                        <div class="min-w-0 space-y-1.5">
                            <label class="@LabelClass" for="rp-numdef">
                                Default numeric value
                            </label>
                            <input id="rp-numdef"
                                   type="text"
                                   inputmode="decimal"
                                   class="@InputClass"
                                   value="@DefaultNumericValueText"
                                   @oninput="OnDefaultNumericValueInput" />
                            <ValidationMessage For="@(() => ResourceProp.DefaultNumericValue)" class="@ValidationClass" />
                        </div>

                        <div class="min-w-0 space-y-1.5">
                            <label class="@LabelClass" for="rp-min">
                                Min value
                            </label>
                            <input id="rp-min"
                                   type="text"
                                   inputmode="decimal"
                                   class="@InputClass"
                                   value="@StepValueText"
                                   @oninput="OnStepValueInput" />
                            <ValidationMessage For="@(() => ResourceProp.StepValue)" class="@ValidationClass" />
                        </div>

                        <div class="min-w-0 space-y-1.5">
                            <label class="@LabelClass" for="rp-max">
                                Max value
                            </label>
                            <input id="rp-max"
                                   type="text"
                                   inputmode="decimal"
                                   class="@InputClass"
                                   value="@MaxNumericValueText"
                                   @oninput="OnMaxNumericValueInput" />
                            <ValidationMessage For="@(() => ResourceProp.MaxNumericValue)" class="@ValidationClass" />
                        </div>
                    }
                    else
                    {
                        <div class="min-w-0 space-y-1.5">
                            <label class="@LabelClass" for="rp-textdef">
                                Default text value
                            </label>
                            <InputText id="rp-textdef"
                                       class="@InputClass"
                                       @bind-Value="@ResourceProp.DefaultTextValue" />
                            <ValidationMessage For="@(() => ResourceProp.DefaultTextValue)" class="@ValidationClass" />
                        </div>

                        <div></div>
                    }
                </div>
            </EditForm>
        </div>
    </div>

    <div class="border-t border-slate-200 pt-3 dark:border-slate-800">
        <div class="flex flex-wrap items-center justify-end gap-2">
            <button type="submit"
                    class="inline-flex items-center justify-center gap-2 rounded-lg border border-sky-600 bg-sky-600 px-2.5 py-1.5 text-xs font-medium text-white transition hover:bg-sky-700 focus:outline-none focus:ring-2 focus:ring-sky-500/30 disabled:cursor-not-allowed disabled:opacity-60 dark:border-sky-500 dark:bg-sky-500 dark:hover:bg-sky-400"
                    form="propertyResourceForm"
                    disabled="@IsLoading"
                    aria-busy="@IsLoading">
                @ResourceApp.save
            </button>

            <button type="button"
                    class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-300 px-2.5 py-1.5 text-xs font-medium text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-400/30 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
                    @onclick="async () => await Callback.InvokeAsync(false)">
                @ResourceApp.cancel
            </button>
        </div>
    </div>
</section>

@code {
    [CascadingParameter] private EditContext? EditContext { get; set; }
    [Parameter] public ResourceAttribute ResourceProp { get; set; } = new();
    [Parameter] public EventCallback<bool> Callback { get; set; }
    [Parameter] public int GroupId { get; set; } = new();

    private const string LabelClass = "block text-[11px] font-medium text-slate-700 dark:text-slate-300";
    private const string ValidationClass = "text-xs text-rose-600 dark:text-rose-400";
    private const string InputClass = "block w-full rounded-lg border border-slate-300 px-2.5 py-1.5 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500 dark:focus:border-sky-400 dark:focus:ring-sky-400/20 dark:[color-scheme:dark]";

    private bool IsLoading = false;
    private string DefaultNumericValueText { get; set; } = string.Empty;
    private string StepValueText { get; set; } = string.Empty;
    private string MaxNumericValueText { get; set; } = string.Empty;
    private string? FormErrorMessage { get; set; }

    protected override void OnInitialized()
    {
        SyncNumericInputs();
    }

    private async Task HandleSubmitAsync()
    {
        if (ResourceProp.DataType == DataType.Number)
        {
            if (!TryParseNullableDecimalInput(DefaultNumericValueText, out var defaultNumericValue) ||
                !TryParseNullableDecimalInput(StepValueText, out var stepValue) ||
                !TryParseNullableDecimalInput(MaxNumericValueText, out var maxNumericValue))
            {
                FormErrorMessage = "Numeric values must be valid numbers.";
                return;
            }

            ResourceProp.DefaultNumericValue = defaultNumericValue;
            ResourceProp.StepValue = stepValue;
            ResourceProp.MaxNumericValue = maxNumericValue;
        }

        FormErrorMessage = null;
        IsLoading = true;
        try
        {
            bool result;
            ResourceProp.AttributeSetId = GroupId;
            if (ResourceProp.Id == 0)
            {
                await ResourcePropertiesService.CreateAsync(ResourceProp);
                result = true;
            }
            else
            {
                await ResourcePropertiesService.UpdateAsync(ResourceProp);
                result = true;
            }

            MHD.Notifications(ResourceProp.Id == 0 ? ToastType.Add : ToastType.Update, result);
            await Callback.InvokeAsync(result);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void OnDefaultNumericValueInput(ChangeEventArgs e)
    {
        DefaultNumericValueText = e.Value?.ToString() ?? string.Empty;
        if (TryParseNullableDecimalInput(DefaultNumericValueText, out var value))
        {
            ResourceProp.DefaultNumericValue = value;
            FormErrorMessage = null;
        }
    }

    private void OnStepValueInput(ChangeEventArgs e)
    {
        StepValueText = e.Value?.ToString() ?? string.Empty;
        if (TryParseNullableDecimalInput(StepValueText, out var value))
        {
            ResourceProp.StepValue = value;
            FormErrorMessage = null;
        }
    }

    private void OnMaxNumericValueInput(ChangeEventArgs e)
    {
        MaxNumericValueText = e.Value?.ToString() ?? string.Empty;
        if (TryParseNullableDecimalInput(MaxNumericValueText, out var value))
        {
            ResourceProp.MaxNumericValue = value;
            FormErrorMessage = null;
        }
    }

    private void SyncNumericInputs()
    {
        DefaultNumericValueText = FormatNullableDecimal(ResourceProp.DefaultNumericValue);
        StepValueText = FormatNullableDecimal(ResourceProp.StepValue);
        MaxNumericValueText = FormatNullableDecimal(ResourceProp.MaxNumericValue);
    }

    private static string FormatNullableDecimal(decimal? value)
        => NumericDisplayHelper.Format(value);

    private static bool TryParseNullableDecimalInput(string? text, out decimal? value)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            value = null;
            return true;
        }

        if (decimal.TryParse(text, NumberStyles.Number, CultureInfo.CurrentCulture, out var parsed))
        {
            value = parsed;
            return true;
        }

        var normalized = text.Replace(',', '.');
        if (decimal.TryParse(normalized, NumberStyles.Number, CultureInfo.InvariantCulture, out parsed))
        {
            value = parsed;
            return true;
        }

        value = null;
        return false;
    }
}
