@page "/Error"
@using System.Diagnostics

<PageTitle>Error</PageTitle>

<div class="rounded-2xl border border-slate-200 bg-white px-4 py-3 shadow-sm dark:border-slate-800 dark:bg-slate-950/80">
    <div class="text-[10px] font-semibold uppercase tracking-[0.16em] text-slate-500 dark:text-slate-400">System status</div>
    <h1 class="text-lg font-semibold tracking-tight text-slate-900 dark:text-slate-100">An unexpected error occurred</h1>
    <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">The request could not be completed. Review the details below and then return to the previous page or the admin home page.</p>
</div>

<div class="grid gap-3 xl:grid-cols-[minmax(0,1fr)_22rem]">
    <section class="rounded-2xl border border-rose-200 bg-rose-50 p-4 text-rose-700 dark:border-rose-900/60 dark:bg-rose-950/40 dark:text-rose-300">
        <div class="text-base font-semibold">Request processing failed.</div>
        <p class="mt-2 text-sm leading-6">
            The application encountered an exception while processing this request. In production, keep detailed diagnostics disabled for end users.
        </p>

        @if (ShowRequestId)
        {
            <div class="mt-3 rounded-xl border border-rose-200/80 bg-white/70 px-3 py-2 text-sm text-rose-900 dark:border-rose-800 dark:bg-slate-950/40 dark:text-rose-100">
                <strong>Request ID:</strong>
                <code class="ml-2 break-all">@RequestId</code>
            </div>
        }
    </section>

    <aside class="rounded-2xl border border-sky-200 bg-sky-50 p-4 text-sky-700 dark:border-sky-900/60 dark:bg-sky-950/40 dark:text-sky-200">
        <div class="text-base font-semibold">Development mode note</div>
        <p class="mt-2 text-sm leading-6">
            Enable <strong>Development</strong> only for local debugging. On deployed systems it may reveal sensitive exception details to end users.
        </p>
        <p class="mt-2 text-sm leading-6">
            Use the <code>ASPNETCORE_ENVIRONMENT</code> variable and restart the application when switching environments.
        </p>
    </aside>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized()
        => RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
