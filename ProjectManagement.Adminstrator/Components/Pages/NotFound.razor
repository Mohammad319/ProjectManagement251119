@page "/not-found"
@layout MainLayout

<PageTitle>Not found</PageTitle>

<div class="pm-page-header">
    <div class="pm-eyebrow">Navigation</div>
    <h1 class="pm-title">Page not found</h1>
    <p class="pm-subtitle">The page you requested does not exist, was moved, or is no longer available.</p>
</div>

<div class="pm-empty min-h-[360px]">
    <div class="text-5xl">404</div>
    <div>
        <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Sorry, this content could not be found.</h2>
        <p class="mt-1 text-sm leading-6 text-slate-500 dark:text-slate-400">Return to the main administration dashboard and continue from there.</p>
    </div>

    <a href="/" class="pm-btn-primary">Back to dashboard</a>
</div>
