<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-ProjectManagement_Adminstrator-0220d739-c448-4463-be45-9d5f7a58a47d</UserSecretsId>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>
  <PropertyGroup>
    <SatelliteResourceLanguages>en;sv</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="**\node_modules\**" />
    <Compile Remove=".codex-build\**" />
    <Compile Remove="artifacts\**" />
    <Content Remove="**\node_modules\**" />
    <Content Remove=".codex-build\**" />
    <Content Remove="artifacts\**" />
    <EmbeddedResource Remove="**\node_modules\**" />
    <EmbeddedResource Remove=".codex-build\**" />
    <EmbeddedResource Remove="artifacts\**" />
    <None Remove="**\node_modules\**" />
    <None Remove=".codex-build\**" />
    <None Remove="artifacts\**" />
  </ItemGroup>

  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);**\node_modules\**;.codex-build\**;artifacts\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NCalcSync" Version="5.12.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.2" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.MSSqlServer" Version="9.0.3" />
    <PackageReference Include="Serilog.Sinks.Seq" Version="9.0.0" />

  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\..\..\Library\BlazorMHD\BlazorMHD.UI\BlazorMHD.UI.csproj" />
    <ProjectReference Include="..\AuthPermissions\AuthPermissions.csproj" />
    <ProjectReference Include="..\ProjectManagement\ProjectManagement\ProjectManagement.csproj" />
    <ProjectReference Include="..\TaskResourceBlueprints\TaskResourceBlueprints.csproj" />
    <ProjectReference Include="..\Persistence\Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="**\package.json" CopyToPublishDirectory="Never" />
    <Content Update="**\package-lock.json" CopyToPublishDirectory="Never" />
    <Content Update="**\tailwind.config.js" CopyToPublishDirectory="Never" />
    <Content Update="**\postcss.config.js" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <Target Name="BuildTailwindCss" BeforeTargets="PrepareForBuild" Condition="Exists('$(MSBuildProjectDirectory)\package.json')">
    <Exec Command="npm ci" WorkingDirectory="$(MSBuildProjectDirectory)" Condition="'$(Configuration)' == 'Release' Or (!Exists('$(MSBuildProjectDirectory)\node_modules\.bin\tailwindcss.cmd') And !Exists('$(MSBuildProjectDirectory)\node_modules\.bin\tailwindcss'))" />
    <Exec Command="npm run tw:build" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <Target Name="ValidatePublishedCssAssets" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">

    <PropertyGroup>
      <_EmptyFileSha256>E3B0C44298FC1C149AFBF4C8996FB92427AE41E4649B934CA495991B7852B855</_EmptyFileSha256>
    </PropertyGroup>

    <ItemGroup>
      <_RequiredPublishedCssAssets Include="$(PublishDir)wwwroot\css\app.css" />
      <_RequiredPublishedCssAssets Include="$(PublishDir)wwwroot\css\app.css.br" />
      <_RequiredPublishedCssAssets Include="$(PublishDir)wwwroot\css\app.css.gz" />
      <_RequiredPublishedCssAssets Include="$(PublishDir)wwwroot\css\custom.css" />
      <_RequiredPublishedCssAssets Include="$(PublishDir)wwwroot\css\custom.css.br" />
      <_RequiredPublishedCssAssets Include="$(PublishDir)wwwroot\css\custom.css.gz" />
      <_RequiredPublishedCssAssets Include="$(PublishDir)wwwroot\css\tailwind.css" />
      <_RequiredPublishedCssAssets Include="$(PublishDir)wwwroot\css\tailwind.css.br" />
      <_RequiredPublishedCssAssets Include="$(PublishDir)wwwroot\css\tailwind.css.gz" />
    </ItemGroup>

    <Error Condition="!Exists('%(_RequiredPublishedCssAssets.Identity)')" Text="Published CSS asset is missing: %(_RequiredPublishedCssAssets.Identity)" />

    <GetFileHash Files="@(_RequiredPublishedCssAssets)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_PublishedCssAssetHashes" />
    </GetFileHash>

    <Error Condition="'%(_PublishedCssAssetHashes.FileHash)' == '$(_EmptyFileSha256)'" Text="Published CSS asset is empty: %(_PublishedCssAssetHashes.Identity)" />

  </Target>

</Project>
