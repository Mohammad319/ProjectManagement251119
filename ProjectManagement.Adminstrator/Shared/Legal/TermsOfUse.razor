@using Microsoft.Extensions.Localization
@using ProjectManagement.Adminstrator.Shared.ResourceFiles.AppControll
@inject IStringLocalizer<AppControll> L

<section class="pm-card overflow-hidden">
    <div class="pm-card-header">
        <div>
            <div class="pm-eyebrow">Legal</div>
            <h2 class="pm-card-title mt-1">@L["TermsTitle"]</h2>
            <p class="pm-card-subtitle">Terms and conditions that govern the use of the platform.</p>
        </div>
    </div>

    <div class="pm-card-body pm-legal-prose">
        <p>@((MarkupString)L["TermsContent"].Value.Replace("\n", "<br />"))</p>
    </div>
</section>
