@page "/legal"
@using ProjectManagement.Adminstrator.Constants
.AppControll
@using ProjectManagement.Adminstrator.Shared.ResourceFiles.AppControll
@using ProjectManagement.Shared.Constant
@inject Microsoft.Extensions.Localization.IStringLocalizer<AppControll> L

<div class="@CssClasses.Layout.ButtonGroup mb-3" role="group" aria-label="Legal tabs">
    <button class="btn @(activeTab == "impressum" ? "btn-primary" : "btn-outline-primary")"
            @onclick="@(() => SelectTab("impressum"))">
        Impressum
    </button>
    <button class="btn @(activeTab == "privacy" ? "btn-primary" : "btn-outline-primary")"
            @onclick="@(() => SelectTab("privacy"))">
        @AppControll.TabPrivacy
    </button>
    <button class="btn @(activeTab == "terms" ? "btn-primary" : "btn-outline-primary")"
            @onclick="@(() => SelectTab("terms"))">
        @AppControll.TabTerms
    </button>
    <button class="btn @(activeTab == "licenses" ? "btn-primary" : "btn-outline-primary")"
            @onclick="@(() => SelectTab("licenses"))">
        @AppControll.TabLicenses
    </button>
</div>

<div>
    @if (activeTab == "impressum")
    {
        <div>
            <ImpressumUI></ImpressumUI>
        </div>
    }
    else if (activeTab == "privacy")
    {
        <div>
            <h2>@AppControll.TabPrivacy</h2>
            <p>@AppControll.PrivacyContent</p>
        </div>
    }
    else if (activeTab == "terms")
    {
        <div>
            <p>@((MarkupString)AppControll.TermsContent.Replace("\n", "<br />"))</p>
        </div>
    }
    else if (activeTab == "licenses")
    {
        <div>
            <ThirdPartyLicenses></ThirdPartyLicenses>
        </div>
    }
</div>

@code {
    private string activeTab = "impressum";

    void SelectTab(string tabName)
    {
        activeTab = tabName;
    }
}
