@using Microsoft.Extensions.Localization
@using ProjectManagement.Adminstrator.Constants
@inject IStringLocalizer<ResourceApp> appLocalizer

<div class="space-y-2">
    <label class="pm-label">Language</label>
    <div class="flex items-center gap-3">
        <select class="pm-field max-w-xs" @bind="Culture">
            @foreach (var culture in cultures)
            {
                <option value="@culture">@GetCultureLabel(culture)</option>
            }
        </select>
        <span class="rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-medium text-slate-600 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-300">
            @Culture.TwoLetterISOLanguageName.ToUpperInvariant()
        </span>
    </div>
</div>
